#lang beagle/clj

(ns clojure-to-beagle-vslice.converter)

(def REJECTION String "rejected: unsafe, malformed, or unsupported Clojure input")
(def READER-EOF Any (java.lang.Object.))

(defrecord SourceSpan
  [line Int
   column Int])

(defrecord ConstraintIR
  [path String
   subject String
   required-type String
   evidence String
   span SourceSpan])

(defrecord NamespaceIR [name String])

(defrecord BindingIR
  [name String
   operator String
   parameter String
   literal Int
   inferred-type String
   span SourceSpan])

(defrecord FunctionIR
  [name String
   string-parameter String
   integer-parameter String
   binding BindingIR
   result-operator String
   result-type String
   constraints (Vec ConstraintIR)])

(defrecord ModuleIR
  [namespace NamespaceIR
   function FunctionIR])

(defn reject! [] Any
  (throw (ex-info REJECTION {})))

(defn reject-tagged-reader!
  [_tag Any
   _value Any] Any
  (reject!))

(defn fail-diagnostic! [message String] Any
  (throw (ex-info message {:converter-diagnostic true})))

(defn safe-read-forms! [source String] Any
  (try
    (binding [*read-eval* false
              *data-readers* {}
              *default-data-reader-fn* reject-tagged-reader!]
      (let [reader (clojure.lang.LineNumberingPushbackReader.
                    (java.io.StringReader. source))]
        (loop [forms (Vec Any) []]
          (let [form (clojure.core/read {:eof READER-EOF} reader)]
            (if (identical? READER-EOF form)
              forms
              (recur (conj forms form)))))))
    (catch Throwable _
      (reject!))))

(defn source-span! [form Any] SourceSpan
  (let [form-meta (meta form)
        line (get form-meta :line)
        column (get form-meta :column)]
    (if (and (integer? line) (integer? column))
      (->SourceSpan line column)
      (reject!))))

(defn unresolved-call!
  [path String
   form Any] Any
  (let [span (source-span! form)]
    (fail-diagnostic!
     (str "clojure-to-beagle[E_TYPE_UNRESOLVED] <input>:"
          (sourcespan-line span) ":" (sourcespan-column span) " " path
          ": no declared contract for call " (str (first form))))))

(defn canonical-namespace! [form Any] NamespaceIR
  (if (and (seq? form)
           (= 2 (count form))
           (= "ns" (str (first form)))
           (symbol? (second form)))
    (->NamespaceIR (str (second form)))
    (reject!)))

(defn contains-value? [(values Any) (needle Any)] Boolean
  (if (empty? values)
    false
    (if (= (first values) needle)
      true
      (contains-value? (rest values) needle))))

(defn unique-values? [values Any] Boolean
  (if (empty? values)
    true
    (and (not (contains-value? (rest values) (first values)))
         (unique-values? (rest values)))))

(defn valid-arity? [arity Any] Boolean
  (and (seq? arity)
       (= 2 (count arity))
       (vector? (first arity))
       (every? symbol? (first arity))
       (unique-values? (first arity))
       (seq? (second arity))))

(defn infer-param-type [(parameter Any) (body Any)] String
  ;; Conservative, syntax-directed inference for the M3 surface.  Unknown
  ;; parameters remain String, which is the useful default for source code
  ;; conversion and still leaves unsupported calls to the checker.
  (if (and (seq? body)
           (= "+" (str (first body)))
           (contains-value? (rest body) parameter))
    "Int"
    "String"))

(declare render-params)

(defn render-arities [arities Any] String
  (if (empty? arities)
    ")\n"
    (let [arity (first arities)
          params (first arity)
          body (second arity)
          typed-params (render-params params body)
          return-type (if (and (seq? body)
                               (or (= "+" (str (first body)))
                                   (= "-" (str (first body)))
                                   (= "*" (str (first body)))
                                   (= "/" (str (first body)))))
                        "Int" "String")]
      (str "  ([" typed-params "] " return-type "\n    "
           (pr-str body) ")\n"
           (render-arities (rest arities))))))

(defn render-params [(params Any) (body Any)] String
  (if (empty? params)
    ""
    (str " " (first params) " " (infer-param-type (first params) body)
         (render-params (rest params) body))))

(defn canonical-multi! [form Any] FunctionIR
  (if (and (seq? form) (= "defn" (str (first form)))
           (symbol? (second form)) (> (count form) 2)
           (let [arities (rest (rest form))
                 arity-counts (map (fn [arity Any] Int (count (first arity))) arities)]
             (and (every? valid-arity? arities)
                  (unique-values? arity-counts))))
    (let [name (str (second form))
          arities (rest (rest form))
          rendered (str "(defn " name "\n" (render-arities arities))]
      (->FunctionIR name rendered "" (->BindingIR "" "" "" 0 "Any" (source-span! form))
                    "multi" "Any" []))
    (reject!)))

(defn canonical-function! [form Any] FunctionIR
  (if (and (seq? form) (> (count form) 2)
           (seq? (nth form 2)))
    (canonical-multi! form)
  (if (and (seq? form)
           (= 4 (count form))
           (= "defn" (str (first form)))
           (symbol? (second form))
           (vector? (nth form 2))
           (= 2 (count (nth form 2)))
           (symbol? (first (nth form 2)))
           (symbol? (second (nth form 2)))
           (not= (first (nth form 2)) (second (nth form 2)))
           (seq? (nth form 3))
           (= 3 (count (nth form 3)))
           (= "let" (str (first (nth form 3))))
           (vector? (second (nth form 3)))
           (= 2 (count (second (nth form 3))))
           (symbol? (first (second (nth form 3))))
           (seq? (second (second (nth form 3))))
           (= 3 (count (second (second (nth form 3)))))
           (symbol? (first (second (second (nth form 3)))))
           (seq? (nth (nth form 3) 2))
           (= 3 (count (nth (nth form 3) 2)))
           (symbol? (first (nth (nth form 3) 2))))
    (let [parameters (nth form 2)
          string-parameter (first parameters)
          integer-parameter (second parameters)
          let-form (nth form 3)
          bindings (second let-form)
          binding-name (first bindings)
          binding-value (second bindings)
          result (nth let-form 2)]
      (if (not= "+" (str (first binding-value)))
        (unresolved-call! "function/body/let/binding/value" binding-value)
        (if (not= "subs" (str (first result)))
          (unresolved-call! "function/body/let/result" result)
          (if (and (= integer-parameter (second binding-value))
                   (integer? (nth binding-value 2))
                   (= string-parameter (second result))
                   (= binding-name (nth result 2))
                   (not= binding-name string-parameter)
                   (not= binding-name integer-parameter))
            (let [binding-span SourceSpan (source-span! binding-value)
                  result-span SourceSpan (source-span! result)
                  constraints (Vec ConstraintIR) [(->ConstraintIR
                    "function/parameters/0"
                    (str string-parameter)
                    "String"
                    "builtin:subs/argument-0"
                    result-span)
                   (->ConstraintIR
                    "function/parameters/1"
                    (str integer-parameter)
                    "Int"
                    "builtin:+/argument-0"
                    binding-span)
                   (->ConstraintIR
                    "function/body/let/binding"
                    (str binding-name)
                    "Int"
                    "builtin:+/return"
                    binding-span)
                   (->ConstraintIR
                    "function/return"
                    (str (second form))
                    "String"
                    "builtin:subs/return"
                    result-span)]]
              (->FunctionIR
               (str (second form))
               (str string-parameter)
               (str integer-parameter)
               (->BindingIR
                (str binding-name)
                "+"
                (str integer-parameter)
                (nth binding-value 2)
                "Int"
                binding-span)
               "subs"
               "String"
               constraints))
            (reject!)))))
    (reject!))))

(defn canonicalize! [forms Any] ModuleIR
  (if (and (vector? forms) (= 2 (count forms)))
    (->ModuleIR (canonical-namespace! (first forms))
                (canonical-function! (second forms)))
    (reject!)))

(defn emit-beagle [module ModuleIR] String
  (let [namespace (moduleir-namespace module)
        function (moduleir-function module)
        binding (functionir-binding function)]
    (if (= "multi" (functionir-result-operator function))
      (str "#lang beagle/clj\n\n"
           "(ns " (namespaceir-name namespace) ")\n\n"
           (functionir-string-parameter function))
      (str "#lang beagle/clj\n\n"
           "(ns " (namespaceir-name namespace) ")\n\n"
           "(defn " (functionir-name function)
           " [" (functionir-string-parameter function) " String "
           (functionir-integer-parameter function) " Int] "
           (functionir-result-type function) "\n"
           "  (let [" (bindingir-name binding) " "
           (bindingir-inferred-type binding) " (" (bindingir-operator binding) " "
           (bindingir-parameter binding) " " (bindingir-literal binding) ")]\n"
           "    (" (functionir-result-operator function) " "
           (functionir-string-parameter function) " "
           (bindingir-name binding) ")))\n"))))

(defn diagnostic-message [error Any] String
  (if (= true (get (ex-data error) :converter-diagnostic))
    (ex-message error)
    REJECTION))

(defn -main [& args] Nil
  (try
    (if (= 1 (count args))
      (print (emit-beagle (canonicalize! (safe-read-forms! (slurp (first args))))))
      (throw (ex-info "usage" {})))
    (catch Throwable error
      (binding [*out* *err*]
        (println (diagnostic-message error)))
      (System/exit 2))))

(apply -main *command-line-args*)
