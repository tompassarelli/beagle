#lang beagle/clj
;; A branch ref names the sealed FRAMLOG segments a branch folds before its
;; tail; the tail is located by convention and is never listed in the ref.
(ns fram.branch
  (:require [clojure.string :as str])
  (:import [java.io ByteArrayOutputStream]
           [java.nio.charset StandardCharsets]
           [java.security MessageDigest]
           [java.util.zip CRC32]))


(def ref-format String "framref/v1")
(def fork-marker-format String "framfork/v1")
(def branch-revision-format String "frambranch-revision/v1")
;; The unnamed tail at <log> keeps this spelling in <log>.refs/.
(def default-branch String "main")
(def max-branch-name-length Int 64)
(def max-chain-length Int 64)

;; start-sequence and end-sequence are 0 together when the segment holds no
;; transaction; the ref is the only cheap record of where a sealed chain ends
;; once the branch tail beside it is empty.
(defrecord SegmentRecord
  [(sha256 String) (start-sequence Int) (end-sequence Int) (byte-count Int)])

(defrecord RefDocument [(space-id String) (segments (Vec SegmentRecord))])

;; A branch name is mutable routing and is deliberately absent. Equal history
;; on two refs has one identity; their first different tail prefix separates it.
(defrecord BranchRevision
  [(space-id String)
   (segments (Vec String))
   (tail-prefix-sha256 String)
   (tail-prefix-byte-count Int)
   (sequence Int)
   (identity String)])

;; What a folded chain member turned out to be on disk, as the caller read it.
(defrecord ChainMember
  [(start-sequence Int)
   (end-sequence Int)
   (byte-count Int)
   (continuation Bool)
   (space-id String)
   (torn Bool)])

(defrecord ForkPlan
  [(document RefDocument) (sealed SegmentRecord) (fork-sequence Int)])

;; A fork prepares every file it installs before it writes this marker, so the
;; marker's presence means the remaining renames may be replayed as they stand.
(defrecord ForkMarker [(parent String) (child String) (segment String)])

(defn- fail [(message String) (code Keyword)] Any
  (throw (ex-info message {:type code :fram/code code})))

(defn valid-segment-name? [(value String)] Bool
  (some? (re-matches #"[0-9a-f]{64}" value)))

(defn valid-branch-name? [(value String)] Bool
  (and (pos? (count value))
       (<= (count value) max-branch-name-length)
       (some? (re-matches #"[A-Za-z0-9][A-Za-z0-9._-]*" value))
       (not (str/includes? value ".."))))

(defn require-branch-name! [(value String)] String
  (if (valid-branch-name? value)
    value
    (fail (str "branch name is not a usable ref file name: " value)
          :invalid-branch-name)))

(defn segments-directory [(store-path String)] String
  (str store-path ".segments"))

(defn refs-directory [(store-path String)] String
  (str store-path ".refs"))

(defn branches-directory [(store-path String)] String
  (str store-path ".branches"))

(defn segment-path [(store-path String) (sha256 String)] String
  (if (valid-segment-name? sha256)
    (str (segments-directory store-path) "/" sha256)
    (fail (str "segment name is not a SHA-256 hex digest: " sha256)
          :invalid-segment-name)))

(defn ref-path! [(store-path String) (branch String)] String
  (str (refs-directory store-path) "/" (require-branch-name! branch)))

(defn branch-tail-path! [(store-path String) (branch String)] String
  (if (= (require-branch-name! branch) default-branch)
    store-path
    (str (branches-directory store-path) "/" branch)))

(defn snapshot-path [(tail-path String)] String
  (str tail-path ".snapshot"))

(defn- crc32-of [(text String)] Int
  (let [(digest Any) (CRC32.)]
    (.update digest (.getBytes text StandardCharsets/UTF_8))
    (long (.getValue digest))))

(defn- revision-write-u8! [(out Any) (value Int)] Nil
  (do (.write out (int (bit-and value 255))) nil))

(defn- revision-write-u32-le! [(out Any) (value Int)] Nil
  (do
    (doseq [position (range 4)]
      (revision-write-u8!
       out (unsigned-bit-shift-right value (* position 8))))
    nil))

(defn- revision-write-i64-le! [(out Any) (value Int)] Nil
  (do
    (doseq [position (range 8)]
      (revision-write-u8!
       out (unsigned-bit-shift-right value (* position 8))))
    nil))

(defn- revision-write-text! [(out Any) (value String)] Nil
  (let [(bytes Any) (.getBytes value StandardCharsets/UTF_8)]
    (revision-write-u32-le! out (alength bytes))
    (.write out bytes)
    nil))

(defn- sha256-hex [(bytes Any)] String
  (apply str
         (mapv (fn [(value Any)] String
                 (format "%02x" (bit-and (int value) 255)))
               (vec (.digest (MessageDigest/getInstance "SHA-256") bytes)))))

;; The preimage is domain text, SpaceId, segment count and ordered segment
;; identities, tail prefix byte count and digest, then sequence. Text values
;; carry u32 little-endian byte lengths; counts are u32 and positions are i64.
(defn- branch-revision-preimage!
  [(space-id String)
   (segments (Vec String))
   (tail-prefix-sha256 String)
   (tail-prefix-byte-count Int)
   (sequence Int)]
  Any
  (let [(out ByteArrayOutputStream) (ByteArrayOutputStream.)]
    (revision-write-text! out branch-revision-format)
    (revision-write-text! out space-id)
    (revision-write-u32-le! out (count segments))
    (doseq [segment segments]
      (revision-write-text! out segment))
    (revision-write-i64-le! out tail-prefix-byte-count)
    (revision-write-text! out tail-prefix-sha256)
    (revision-write-i64-le! out sequence)
    (.toByteArray out)))

(defn branch-revision!
  [(space-id String)
   (segments (Vec String))
   (tail-prefix-sha256 String)
   (tail-prefix-byte-count Int)
   (sequence Int)]
  BranchRevision
  (cond
    [(zero? (count space-id))
     (fail "branch revision SpaceId must be nonempty"
           :invalid-branch-revision)]
    [(> (count segments) max-chain-length)
     (fail "branch revision chain exceeds the supported segment count"
           :invalid-branch-revision)]
    [(not (every? valid-segment-name? segments))
     (fail "branch revision contains an invalid sealed segment identity"
           :invalid-branch-revision)]
    [(not= (count segments) (count (set segments)))
     (fail "branch revision lists the same sealed segment twice"
           :invalid-branch-revision)]
    [(not (valid-segment-name? tail-prefix-sha256))
     (fail "branch revision tail prefix is not a SHA-256 hex digest"
           :invalid-branch-revision)]
    [(neg? tail-prefix-byte-count)
     (fail "branch revision tail prefix byte count must not be negative"
           :invalid-branch-revision)]
    [(neg? sequence)
     (fail "branch revision sequence must not be negative"
           :invalid-branch-revision)]
    [:else
     (let [(identity String)
           (str "sha256:"
                (sha256-hex
                 (branch-revision-preimage!
                  space-id segments tail-prefix-sha256
                  tail-prefix-byte-count sequence)))]
       (->BranchRevision space-id segments tail-prefix-sha256
                         tail-prefix-byte-count sequence identity))]))

(defn- segment-line [(segment SegmentRecord)] String
  (str "segment " (segmentrecord-sha256 segment) " "
       (segmentrecord-start-sequence segment) " "
       (segmentrecord-end-sequence segment) " "
       (segmentrecord-byte-count segment) "\n"))

(defn print-ref [(document RefDocument)] String
  (let [(body String)
        (str ref-format "\n"
             "space " (refdocument-space-id document) "\n"
             (apply str
                    (mapv (fn [(segment SegmentRecord)] String
                            (segment-line segment))
                          (refdocument-segments document))))]
    (str body "crc " (format "%08x" (crc32-of body)) "\n")))

(defn- parse-count [(value String) (label String)] Int
  (if (some? (re-matches #"(?:0|[1-9][0-9]{0,17})" value))
    (Long/parseLong value)
    (fail (str "branch ref " label " is not a decimal count: " value)
          :invalid-branch-ref)))

(defn- parse-segment-line [(line String) (known Any)] SegmentRecord
  (let [(fields (Vec String)) (vec (str/split line #" "))]
    (if (not= 5 (count fields))
      (fail (str "branch ref segment line is malformed: " line)
            :invalid-branch-ref)
      (let [(sha256 String) (nth fields 1)]
        (cond
          [(not (valid-segment-name? sha256))
           (fail (str "branch ref segment name is not a SHA-256 hex digest: "
                      sha256)
                 :invalid-branch-ref)]
          [(contains? known sha256)
           (fail (str "branch ref lists the same segment twice: " sha256)
                 :invalid-branch-ref)]
          [:else
           (let [(start Int)
                 (parse-count (nth fields 2) "segment start sequence")
                 (end Int) (parse-count (nth fields 3) "segment end sequence")]
             (if (< end start)
               (fail (str "branch ref segment ends before it begins: " sha256)
                     :invalid-branch-ref)
               (->SegmentRecord sha256 start end
                                (parse-count (nth fields 4)
                                             "segment byte count"))))])))))

(defn parse-ref [(text String)] RefDocument
  (let [(lines (Vec String)) (vec (str/split-lines text))]
    (cond
      [(< (count lines) 3)
       (fail "branch ref is missing its format, space, or CRC line"
             :invalid-branch-ref)]
      [(not= ref-format (nth lines 0))
       (fail (str "branch ref format is unsupported: " (nth lines 0))
             :unsupported-branch-ref-version)]
      [(not (str/starts-with? (nth lines 1) "space "))
       (fail "branch ref does not name its SpaceId" :invalid-branch-ref)]
      [(not (str/starts-with? (nth lines (dec (count lines))) "crc "))
       (fail "branch ref does not end with its CRC line" :invalid-branch-ref)]
      [:else
       (let [(space-id String) (subs (nth lines 1) 6)
             (body String)
             (apply str
                    (mapv (fn [(line String)] String (str line "\n"))
                          (subvec lines 0 (dec (count lines)))))
             (stored String) (subs (nth lines (dec (count lines))) 4)]
         (cond
           [(zero? (count space-id))
            (fail "branch ref SpaceId must be nonempty" :invalid-branch-ref)]
           [(not= stored (format "%08x" (crc32-of body)))
            (fail "branch ref CRC does not match" :invalid-branch-ref)]
           [:else
            (let [(segments (Vec SegmentRecord))
                  (loop [(index Int) 2
                         (known Any) #{}
                         (acc (Vec SegmentRecord)) []]
                    (if (>= index (dec (count lines)))
                      acc
                      (let [(line String) (nth lines index)]
                        (if (not (str/starts-with? line "segment "))
                          (fail (str "branch ref contains an unknown line: "
                                     line)
                                :invalid-branch-ref)
                          (let [(segment SegmentRecord)
                                (parse-segment-line line known)]
                            (recur (inc index)
                                   (conj known (segmentrecord-sha256 segment))
                                   (conj acc segment)))))))]
              (if (> (count segments) max-chain-length)
                (fail "branch ref chain exceeds the supported segment count"
                      :invalid-branch-ref)
                (->RefDocument space-id segments)))]))])))

(defn empty-ref [(space-id String)] RefDocument
  (->RefDocument space-id []))

;; The last transaction the sealed chain names, or 0 when it names none.
(defn chain-end-sequence [(document RefDocument)] Int
  (let [(segments (Vec SegmentRecord)) (refdocument-segments document)]
    (loop [(index Int) (dec (count segments))]
      (if (neg? index)
        0
        (let [(end Int)
              (segmentrecord-end-sequence (nth segments index))]
          (if (pos? end) end (recur (dec index))))))))

(defn print-fork-marker [(marker ForkMarker)] String
  (let [(body String)
        (str fork-marker-format "\n"
             "parent " (forkmarker-parent marker) "\n"
             "child " (forkmarker-child marker) "\n"
             "segment " (forkmarker-segment marker) "\n")]
    (str body "crc " (format "%08x" (crc32-of body)) "\n")))

(defn parse-fork-marker [(text String)] ForkMarker
  (let [(lines (Vec String)) (vec (str/split-lines text))]
    (cond
      [(not= 5 (count lines))
       (fail "fork marker does not carry its three fields and CRC"
             :invalid-fork-marker)]
      [(not= fork-marker-format (nth lines 0))
       (fail (str "fork marker format is unsupported: " (nth lines 0))
             :unsupported-fork-marker-version)]
      [(not (and (str/starts-with? (nth lines 1) "parent ")
                 (str/starts-with? (nth lines 2) "child ")
                 (str/starts-with? (nth lines 3) "segment ")))
       (fail "fork marker does not name its parent, child, and segment"
             :invalid-fork-marker)]
      [:else
       (let [(body String)
             (apply str
                    (mapv (fn [(line String)] String (str line "\n"))
                          (subvec lines 0 4)))
             (parent String) (subs (nth lines 1) 7)
             (child String) (subs (nth lines 2) 6)
             (segment String) (subs (nth lines 3) 8)]
         (cond
           [(not= (nth lines 4) (str "crc " (format "%08x" (crc32-of body))))
            (fail "fork marker CRC does not match" :invalid-fork-marker)]
           [(not (and (valid-branch-name? parent)
                      (valid-branch-name? child)
                      (not= parent child)))
            (fail "fork marker does not name two usable branches"
                  :invalid-fork-marker)]
           [(not (valid-segment-name? segment))
            (fail "fork marker segment is not a SHA-256 hex digest"
                  :invalid-fork-marker)]
           [:else (->ForkMarker parent child segment)]))])))

;; Fork appends one sealed segment to the parent chain; parent and child then
;; name the identical chain and diverge only in their tails.
(defn fork-plan
  [(parent RefDocument) (sealed SegmentRecord) (fork-sequence Int)] ForkPlan
  (let [(segments (Vec SegmentRecord)) (refdocument-segments parent)]
    (cond
      [(not (valid-segment-name? (segmentrecord-sha256 sealed)))
       (fail "sealed segment name is not a SHA-256 hex digest"
             :invalid-segment-name)]
      [(some (fn [(segment SegmentRecord)] Bool
               (= (segmentrecord-sha256 segment)
                  (segmentrecord-sha256 sealed)))
             segments)
       (fail "sealed segment is already named by the parent chain"
             :segment-already-sealed)]
      [(>= (count segments) max-chain-length)
       (fail "branch chain exceeds the supported segment count"
             :chain-too-long)]
      [(neg? fork-sequence)
       (fail "fork sequence must not be negative" :invalid-fork-sequence)]
      [:else
       (->ForkPlan (->RefDocument (refdocument-space-id parent)
                                  (conj segments sealed))
                   sealed
                   fork-sequence)])))

(defn- member-fault
  [(document RefDocument)
   (index Int)
   (member ChainMember)
   (expected-next Int)]
  String?
  (let [(segment SegmentRecord) (nth (refdocument-segments document) index)]
    (cond
      [(not= (refdocument-space-id document) (chainmember-space-id member))
       "FRAMLOG segment belongs to a different SpaceId"]
      [(not= (segmentrecord-byte-count segment) (chainmember-byte-count member))
       "FRAMLOG segment size does not match its branch ref record"]
      [(not= (segmentrecord-start-sequence segment)
             (chainmember-start-sequence member))
       "FRAMLOG segment does not begin at its recorded transaction sequence"]
      [(not= (segmentrecord-end-sequence segment)
             (chainmember-end-sequence member))
       "FRAMLOG segment does not end at its recorded transaction sequence"]
      [(chainmember-torn member)
       "FRAMLOG segment ends inside a transaction frame"]
      [(and (pos? index) (not (chainmember-continuation member)))
       "FRAMLOG chain segment after the base segment must carry the continuation flag"]
      [(and (zero? index) (chainmember-continuation member))
       "FRAMLOG base chain segment must not carry the continuation flag"]
      [(and (pos? (chainmember-start-sequence member))
            (not= expected-next (chainmember-start-sequence member)))
       "FRAMLOG chain segment does not continue the previous transaction sequence"]
      [:else nil])))

(defn- next-after [(member ChainMember) (expected-next Int)] Int
  (if (pos? (chainmember-end-sequence member))
    (inc (chainmember-end-sequence member))
    expected-next))

;; nil means the chain folds; any other result is the first fault, by position.
(defn chain-fault
  [(document RefDocument)
   (members (Vec ChainMember))
   (tail ChainMember)]
  String?
  (if (not= (count (refdocument-segments document)) (count members))
    "FRAMLOG branch ref does not name the segments that were read"
    (loop [(index Int) 0 (expected-next Int) 1]
      (if (>= index (count members))
        (let [(continuation Bool) (chainmember-continuation tail)]
          (cond
            [(not= (refdocument-space-id document) (chainmember-space-id tail))
             "FRAMLOG tail belongs to a different SpaceId"]
            [(and (pos? (count members)) (not continuation))
             "FRAMLOG branch tail must carry the continuation flag"]
            [(and (zero? (count members)) continuation)
             "FRAMLOG version or flags are unsupported"]
            [(and (pos? (chainmember-start-sequence tail))
                  (not= expected-next (chainmember-start-sequence tail)))
             "FRAMLOG branch tail does not continue the sealed chain"]
            [:else nil]))
        (let [(member ChainMember) (nth members index)
              (fault String?) (member-fault document index member expected-next)]
          (if (some? fault)
            fault
            (recur (inc index) (next-after member expected-next))))))))
