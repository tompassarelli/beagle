#lang beagle

(ns fram.native-query-ops
  (:require [fram.datalog :as d]
            [fram.kernel :as kernel]
            [fram.native-wire-codec :as native-wire]
            [fram.query :as query]
            [fram.rpc-limits :as limits]
            [fram.rotation :as rot]
            [fram.schema :as schema]
            [fram.store :as store]
            [fram.types :as t]))


(def max-list-values Int 65536)

(def unpaged-occurrence-limit Int limits/rpc-v2-max-unpaged-rows)
(def default-query-timeout-ms Int 5000)
(def max-query-timeout-ms Int 60000)
(def query-step-limit Int 10000000)
(def result-cache-snapshot-limit Int 4)
(def result-cache-per-snapshot-limit Int 8)
(def result-cache-byte-limit Int 67108864)

(defrecord OptionValue [(present Bool) (value Any)])

(defrecord QueryCursor
  [(snapshot-version Int)
   (digest String)
   (next-page-ordinal Int)
   (after-row (Vec Any))])

(defrecord QueryHead [(relation String) (terms (Vec d/QueryTerm))])

(defrecord QueryView
  [(root (Atom t/TermStore))
   (rotation rot/Rotation)
   (version Int)
   (lower-exclusive Int)])

(defrecord QueryBounds [(version Int) (lower-exclusive Int)])

(defrecord PageResult [(payload t/Triple) (page t/RpcPageResponse?)])

(defrecord NativeReadResult [(handled Bool) (response t/RpcResponse?)])

(defrecord ReadError [(code Keyword) (message String)])

(defrecord ReadContext [(error (Atom ReadError?))])

(defrecord ResultCacheLookup
  [(found Bool) (query-rows (Vec (Vec Any))) (triple-rows (Vec t/Triple))])

(def retryable-error-codes (Set Keyword)
  #{:rpc/conflict :rpc/cancelled :query-cancelled :query-time-limit
    :query-work-limit :query/archive-unavailable :durability-ambiguous})

(def no-read-error ReadError? nil)
(def no-query-result-rows (Vec (Vec Any)) [])
(def no-triple-result-rows (Vec t/Triple) [])

(defn new-read-context [] ReadContext
  (->ReadContext (atom no-read-error)))

(defn record-read-error!
  [(context ReadContext) (code Keyword) (message String)] Nil
  (compare-and-set! (readcontext-error context)
                    no-read-error
                    (->ReadError code message))
  nil)

(defn read-context-error [(context ReadContext)] ReadError?
  (deref (readcontext-error context)))

(defn read-context-ok? [(context ReadContext)] Bool
  (nil? (read-context-error context)))

(defn result-snapshot-equal?
  [(left schema/OrderedResultSnapshot)
   (right schema/OrderedResultSnapshot)]
  Bool
  (and (= (schema/orderedresultsnapshot-space left)
          (schema/orderedresultsnapshot-space right))
       (and (= (schema/orderedresultsnapshot-version left)
               (schema/orderedresultsnapshot-version right))
            (= (schema/orderedresultsnapshot-lower-exclusive left)
               (schema/orderedresultsnapshot-lower-exclusive right)))))

(defn result-key-equal?
  [(left schema/OrderedResultKey) (right schema/OrderedResultKey)] Bool
  (and (result-snapshot-equal?
        (schema/orderedresultkey-snapshot left)
        (schema/orderedresultkey-snapshot right))
       (and (= (schema/orderedresultkey-operation left)
               (schema/orderedresultkey-operation right))
            (= (schema/orderedresultkey-digest left)
               (schema/orderedresultkey-digest right)))))

(defn remove-result-snapshot
  [(values (Vec schema/OrderedResultSnapshot))
   (target schema/OrderedResultSnapshot)]
  (Vec schema/OrderedResultSnapshot)
  (loop [(index Int) 0
         (retained (Vec schema/OrderedResultSnapshot)) []]
    (if (>= index (count values))
      retained
      (let [(value schema/OrderedResultSnapshot) (nth values index)]
        (recur (inc index)
               (if (result-snapshot-equal? value target)
                 retained
                 (conj retained value)))))))

(defn remove-result-entry-at
  [(values (Vec schema/OrderedResultEntry))
   (target-index Int)]
  (Vec schema/OrderedResultEntry)
  (loop [(index Int) 0
         (retained (Vec schema/OrderedResultEntry)) []]
    (if (>= index (count values))
      retained
      (recur (inc index)
             (if (= index target-index)
               retained
               (conj retained (nth values index)))))))

(defn result-snapshot-present?
  [(entries (Vec schema/OrderedResultEntry))
   (snapshot schema/OrderedResultSnapshot)]
  Bool
  (loop [index 0]
    (if (>= index (count entries))
      false
      (let [(entry schema/OrderedResultEntry) (nth entries index)]
        (if (result-snapshot-equal?
             snapshot
             (schema/orderedresultkey-snapshot
              (schema/orderedresultentry-key entry)))
          true
          (recur (inc index)))))))

(defn result-entry-index
  [(entries (Vec schema/OrderedResultEntry)) (key schema/OrderedResultKey)] Int
  (loop [index 0]
    (if (>= index (count entries))
      -1
      (if (result-key-equal?
           key (schema/orderedresultentry-key (nth entries index)))
        index
        (recur (inc index))))))

(defn snapshot-entry-count
  [(entries (Vec schema/OrderedResultEntry))
   (snapshot schema/OrderedResultSnapshot)]
  Int
  (loop [index 0 total 0]
    (if (>= index (count entries))
      total
      (let [(entry schema/OrderedResultEntry) (nth entries index)
            (matches Bool)
            (result-snapshot-equal?
             snapshot
             (schema/orderedresultkey-snapshot
              (schema/orderedresultentry-key entry)))]
        (recur (inc index) (if matches (inc total) total))))))

(defn first-snapshot-entry-index
  [(entries (Vec schema/OrderedResultEntry))
   (snapshot schema/OrderedResultSnapshot)]
  Int
  (loop [index 0]
    (if (>= index (count entries))
      -1
      (let [(entry schema/OrderedResultEntry) (nth entries index)]
        (if (result-snapshot-equal?
             snapshot
             (schema/orderedresultkey-snapshot
              (schema/orderedresultentry-key entry)))
          index
          (recur (inc index)))))))

(defn remove-result-entry
  [(state schema/OrderedResultCache) (index Int)] schema/OrderedResultCache
  (let [(entries (Vec schema/OrderedResultEntry)) (schema/orderedresultcache-entries state)
        (entry schema/OrderedResultEntry) (nth entries index)
        (remaining (Vec schema/OrderedResultEntry))
        (remove-result-entry-at entries index)
        (snapshot schema/OrderedResultSnapshot)
        (schema/orderedresultkey-snapshot
         (schema/orderedresultentry-key entry))
        (snapshots (Vec schema/OrderedResultSnapshot))
        (if (result-snapshot-present? remaining snapshot)
          (schema/orderedresultcache-snapshots state)
          (remove-result-snapshot
           (schema/orderedresultcache-snapshots state) snapshot))]
    (schema/->OrderedResultCache
     remaining snapshots
     (- (schema/orderedresultcache-bytes state)
        (schema/orderedresultentry-bytes entry))
     (schema/orderedresultcache-hits state)
     (schema/orderedresultcache-misses state)
     (inc (schema/orderedresultcache-evictions state)))))

(defn touch-result-entry
  [(state schema/OrderedResultCache) (index Int)] schema/OrderedResultCache
  (let [(entries (Vec schema/OrderedResultEntry)) (schema/orderedresultcache-entries state)
        (entry schema/OrderedResultEntry) (nth entries index)
        (key schema/OrderedResultKey) (schema/orderedresultentry-key entry)
        (snapshot schema/OrderedResultSnapshot) (schema/orderedresultkey-snapshot key)]
    (schema/->OrderedResultCache
     (conj (remove-result-entry-at entries index) entry)
     (conj (remove-result-snapshot
            (schema/orderedresultcache-snapshots state) snapshot)
           snapshot)
     (schema/orderedresultcache-bytes state)
     (schema/orderedresultcache-hits state)
     (schema/orderedresultcache-misses state)
     (schema/orderedresultcache-evictions state))))

(defn count-result-cache-hit
  [(state schema/OrderedResultCache)] schema/OrderedResultCache
  (schema/->OrderedResultCache
   (schema/orderedresultcache-entries state)
   (schema/orderedresultcache-snapshots state)
   (schema/orderedresultcache-bytes state)
   (inc (schema/orderedresultcache-hits state))
   (schema/orderedresultcache-misses state)
   (schema/orderedresultcache-evictions state)))

(defn count-result-cache-miss
  [(state schema/OrderedResultCache)] schema/OrderedResultCache
  (schema/->OrderedResultCache
   (schema/orderedresultcache-entries state)
   (schema/orderedresultcache-snapshots state)
   (schema/orderedresultcache-bytes state)
   (schema/orderedresultcache-hits state)
   (inc (schema/orderedresultcache-misses state))
   (schema/orderedresultcache-evictions state)))

(defn append-result-entry
  [(state schema/OrderedResultCache)
   (entry schema/OrderedResultEntry)]
  schema/OrderedResultCache
  (let [snapshot
        (schema/orderedresultkey-snapshot
         (schema/orderedresultentry-key entry))]
    (schema/->OrderedResultCache
     (conj (schema/orderedresultcache-entries state) entry)
     (conj (remove-result-snapshot
            (schema/orderedresultcache-snapshots state) snapshot)
           snapshot)
     (+ (schema/orderedresultcache-bytes state)
        (schema/orderedresultentry-bytes entry))
     (schema/orderedresultcache-hits state)
     (schema/orderedresultcache-misses state)
     (schema/orderedresultcache-evictions state))))

(defn enforce-result-entry-limit
  [(state schema/OrderedResultCache)
   (snapshot schema/OrderedResultSnapshot)]
  schema/OrderedResultCache
  (loop [bounded state]
    (if (> (snapshot-entry-count
            (schema/orderedresultcache-entries bounded) snapshot)
           result-cache-per-snapshot-limit)
      (recur
       (remove-result-entry
        bounded
        (first-snapshot-entry-index
         (schema/orderedresultcache-entries bounded) snapshot)))
      bounded)))

(defn without-result-snapshot
  [(state schema/OrderedResultCache)
   (snapshot schema/OrderedResultSnapshot)]
  schema/OrderedResultCache
  (schema/->OrderedResultCache
   (schema/orderedresultcache-entries state)
   (remove-result-snapshot
    (schema/orderedresultcache-snapshots state) snapshot)
   (schema/orderedresultcache-bytes state)
   (schema/orderedresultcache-hits state)
   (schema/orderedresultcache-misses state)
   (schema/orderedresultcache-evictions state)))

(defn enforce-result-snapshot-limit
  [(state schema/OrderedResultCache)] schema/OrderedResultCache
  (loop [bounded state]
    (if (> (count (schema/orderedresultcache-snapshots bounded))
           result-cache-snapshot-limit)
      (let [(snapshot schema/OrderedResultSnapshot)
            (first (schema/orderedresultcache-snapshots bounded))
            (index Int)
            (first-snapshot-entry-index
             (schema/orderedresultcache-entries bounded) snapshot)]
        (recur
         (if (>= index 0)
           (remove-result-entry bounded index)
           (without-result-snapshot bounded snapshot))))
      bounded)))

(defn enforce-result-byte-limit
  [(state schema/OrderedResultCache)] schema/OrderedResultCache
  (loop [bounded state]
    (if (and (> (schema/orderedresultcache-bytes bounded)
                result-cache-byte-limit)
             (not (empty? (schema/orderedresultcache-entries bounded))))
      (recur (remove-result-entry bounded 0))
      bounded)))

(defn result-cache-key
  [(session schema/Session)
   (version Int)
   (lower-exclusive Int)
   (operation Keyword)
   (digest String)]
  schema/OrderedResultKey
  (schema/->OrderedResultKey
   (schema/->OrderedResultSnapshot
    (store/space-id (schema/store-of session)) version lower-exclusive)
   operation digest))

;; Generated server dispatch is serialized. A concurrent host must add
;; single-flight before it may share this mutable Session cache.
(defn result-cache-lookup!
  [(session schema/Session) (key schema/OrderedResultKey)] ResultCacheLookup
  (let [cell (schema/ordered-results-of session)
        state (deref cell)
        index (result-entry-index
               (schema/orderedresultcache-entries state) key)]
    (if (< index 0)
      (do
        (reset! cell (count-result-cache-miss state))
        (schema/mark-derived-change! session)
        (->ResultCacheLookup false no-query-result-rows
                             no-triple-result-rows))
      (let [(entry schema/OrderedResultEntry)
            (nth (schema/orderedresultcache-entries state) index)]
        (do
          (reset! cell
                  (count-result-cache-hit
                   (touch-result-entry state index)))
          (schema/mark-derived-change! session)
          (->ResultCacheLookup
           true
           (schema/orderedresultentry-query-rows entry)
           (schema/orderedresultentry-triple-rows entry)))))))

(defn retain-result-entry!
  [(session schema/Session) (entry schema/OrderedResultEntry)] Nil
  (let [cell (schema/ordered-results-of session)
        snapshot
        (schema/orderedresultkey-snapshot
         (schema/orderedresultentry-key entry))
        bounded
        (enforce-result-byte-limit
         (enforce-result-snapshot-limit
          (enforce-result-entry-limit
           (append-result-entry (deref cell) entry) snapshot)))]
    (do
      (reset! cell bounded)
      (schema/mark-derived-change! session)
      nil)))

(defn result-cache-stats [(session schema/Session)] (Vec Int)
  (let [state (deref (schema/ordered-results-of session))]
    [(schema/orderedresultcache-hits state)
     (schema/orderedresultcache-misses state)
     (schema/orderedresultcache-bytes state)
     (schema/orderedresultcache-evictions state)]))

(defn field-value [(fields (Vec Any)) (position Int)] Any
  (if (and (>= position 0) (< position (count fields)))
    (nth fields position)
    nil))

(defn rpc-list [(values (Vec Any))] Any
  (reduce
   (fn [(tail Any) (value Any)] Any
     (t/triple :rpc/list value tail))
   :rpc/list-end
   (reverse values)))

(defn rpc-record [(tag Keyword) (fields (Vec Any))] t/Triple
  (t/triple tag (rpc-list fields) :rpc/record))

(defn rpc-query-row [(values (Vec Any))] t/Triple
  (rpc-record :query/row [(rpc-list values)]))

(defn rpc-query-rows [(rows (Vec d/Tuple))] t/Triple
  (rpc-record :query/rows
              [(rpc-list
                (mapv
                 (fn [(row d/Tuple)] Any (rpc-query-row row)) rows))]))

(defn rpc-occurrence [(value t/OperationOccurrence)] t/Triple
  (rpc-record
   :rpc/occurrence
   [(t/operationoccurrence-coordinate value)
    (t/operationoccurrence-action value)
    (t/operationoccurrence-proposition value)]))

(defn rpc-operation-occurrences
  [(values (Vec t/OperationOccurrence))] (Vec t/Triple)
  (mapv (fn [(value t/OperationOccurrence)] t/Triple
          (rpc-occurrence value))
        values))

(defn- rpc-nonempty-occurrence-list [(values (Vec t/Triple))] t/Triple
  (let [last-position (dec (count values))]
    (loop [(position Int) (dec last-position)
           (tail t/Triple)
           (t/triple :rpc/list (nth values last-position) :rpc/list-end)]
      (if (< position 0)
        tail
        (recur (dec position)
               (t/triple :rpc/list (nth values position) tail))))))

(defn rpc-occurrences [(values (Vec t/Triple))] t/Triple
  (t/triple :rpc/occurrences
            (if (empty? values)
              (t/triple :rpc/list :rpc/list-end :rpc/list-end)
              (t/triple :rpc/list
                        (rpc-nonempty-occurrence-list values)
                        :rpc/list-end))
            :rpc/record))

(defn query-result-weight! [(rows (Vec d/Tuple))] Int
  (loop [index 0 total (+ 32 (* 8 (count rows)))]
    (if (>= index (count rows))
      total
      (recur
       (inc index)
       (+ total
          (native-wire/canonical-term-byte-count!
           (rpc-query-row (nth rows index))))))))

(defn triple-result-weight! [(rows (Vec t/Triple))] Int
  (loop [index 0 total (+ 32 (* 8 (count rows)))]
    (if (>= index (count rows))
      total
      (recur
       (inc index)
       (+ total
          (native-wire/canonical-term-byte-count! (nth rows index)))))))

(defn retain-query-result!
  [(session schema/Session)
   (key schema/OrderedResultKey)
   (rows (Vec d/Tuple))]
  Nil
  (retain-result-entry!
   session
   (schema/->OrderedResultEntry
    key rows no-triple-result-rows (query-result-weight! rows))))

(defn retain-triple-result!
  [(session schema/Session)
   (key schema/OrderedResultKey)
   (rows (Vec t/Triple))]
  Nil
  (retain-result-entry!
   session
   (schema/->OrderedResultEntry
    key no-query-result-rows rows (triple-result-weight! rows))))

(defn rpc-violation [(code Keyword) (detail Any)] t/Triple
  (rpc-record :rpc/violation [code detail]))

(defn rpc-validation [(valid Bool) (violations (Vec Any))] t/Triple
  (rpc-record :rpc/validation [valid (rpc-list violations)]))

(defn response
  [(request t/RpcRequest)
   (served-version Int)
   (page t/RpcPageResponse?)
   (payload t/Triple)]
  t/RpcResponse
  (let [(payload-term t/Term) payload]
    (t/->RpcResponse (t/rpcrequest-space request)
                     (t/rpcrequest-op request)
                     served-version page nil payload-term)))

(defn error-response
  [(request t/RpcRequest)
   (served-version Int)
   (code Keyword)
   (message String)]
  t/RpcResponse
  (t/->RpcResponse
   (t/rpcrequest-space request)
   (t/rpcrequest-op request)
   served-version nil
   (t/->RpcError code (contains? retryable-error-codes code) message nil)
   nil))

(defn read-list! [(context ReadContext) (value Any)] (Vec Any)
  (loop [(cursor Any) value (values (Vec Any)) [] (count-value Int) 0]
    (cond
      [(= cursor :rpc/list-end) values]
      [(>= count-value max-list-values)
       (do
         (record-read-error!
          context :rpc-invalid-list "RPC list exceeds the Term node bound")
         values)]
      [(and (t/triple? cursor) (= :rpc/list (t/triple-t1 cursor)))
       (recur (t/triple-t3 cursor)
              (conj values (t/triple-t2 cursor))
              (inc count-value))]
      [:else
       (do
         (record-read-error!
          context :rpc-invalid-list
          "RPC list must end with :rpc/list-end")
         values)])))

(defn read-record!
  [(context ReadContext) (value Any) (tag Keyword) (field-count Int)] (Vec Any)
  (if (and (t/triple? value)
           (and (= tag (t/triple-t1 value))
                (= :rpc/record (t/triple-t3 value))))
    (let [(fields (Vec Any))
          (read-list! context (t/triple-t2 value))]
      (if (and (read-context-ok? context)
               (= field-count (count fields)))
        fields
        (do
          (if (read-context-ok? context)
            (record-read-error!
             context :rpc-invalid-record
             "RPC record contains the wrong number of fields")
            nil)
          [])))
    (do
      (record-read-error!
       context :rpc-invalid-record "RPC record tag or marker is invalid")
      [])))

(defn read-option! [(context ReadContext) (value Any)] OptionValue
  (cond
    [(= value :rpc/none) (->OptionValue false nil)]
    [(and (t/triple? value)
          (and (= :rpc/some (t/triple-t1 value))
               (= :rpc/option (t/triple-t3 value))))
     (->OptionValue true (t/triple-t2 value))]
    [:else
     (do
       (record-read-error!
        context :rpc-invalid-option
        "RPC option must be :rpc/none or a :rpc/some record")
       (->OptionValue false nil))]))

(defn require-term! [(context ReadContext) (value Any) (label String)] Any
  (if (t/term? value)
    value
    (do
      (record-read-error!
       context :rpc-invalid-payload (str label " must be a Term"))
      :rpc/unit)))

(defn require-string! [(context ReadContext) (value Any) (label String)] String
  (if (string? value)
    value
    (do
      (record-read-error!
       context :rpc-invalid-payload (str label " must be a String"))
      "")))

(defn require-int! [(context ReadContext) (value Any) (label String)] Int
  (if (integer? value)
    value
    (do
      (record-read-error!
       context :rpc-invalid-payload (str label " must be an Int"))
      0)))

(defn require-keyword!
  [(context ReadContext) (value Any) (label String)] Keyword
  (if (keyword? value)
    value
    (do
      (record-read-error!
       context :rpc-invalid-payload (str label " must be a Keyword"))
      :rpc/invalid)))

(defn require-bool! [(context ReadContext) (value Any) (label String)] Bool
  (if (boolean? value)
    value
    (do
      (record-read-error!
       context :rpc-invalid-payload (str label " must be a Bool"))
      false)))

(defn require-unit! [(context ReadContext) (value Any)] Nil
  (if (= value :rpc/unit)
    nil
    (record-read-error!
     context :rpc-invalid-payload
     "operation payload must be :rpc/unit")))

(defn query-record-tag [(value Any)] Keyword?
  (if (and (t/triple? value)
           (and (keyword? (t/triple-t1 value))
                (= :rpc/record (t/triple-t3 value))))
    (t/triple-t1 value)
    nil))

(defn fallback-query-term [] d/QueryTerm
  (d/constant :rpc/unit))

(defn fallback-query-literal [] d/Literal
  (d/relation-literal "__invalid__" []))

(defn fallback-find-spec [] query/FindSpec
  (query/relation-find "__invalid__"))

(defn parse-query-term! [(context ReadContext) (value Any)] d/QueryTerm
  (match (query-record-tag value)
    [:query/var
    (let [(fields (Vec Any)) (read-record! context value :query/var 1)
          (name String) (require-string!
                context (field-value fields 0) "query variable")]
      (if (and (read-context-ok? context) (pos? (count name)))
        (d/variable name)
        (do
          (if (read-context-ok? context)
            (record-read-error!
             context :invalid-query-variable
             "native read operation failed")
            nil)
          (fallback-query-term))))]

    [:query/const
    (let [(fields (Vec Any)) (read-record! context value :query/const 1)]
      (d/constant
       (require-term! context (field-value fields 0) "query constant")))]

    [_ (do
         (record-read-error!
          context :query-invalid-term
          "query term must be query/var or query/const")
         (fallback-query-term))]))

(defn parse-query-terms! [(context ReadContext) (value Any)] (Vec d/QueryTerm)
  (mapv
   (fn [(term Any)] d/QueryTerm (parse-query-term! context term))
   (read-list! context value)))

(defn parse-query-head! [(context ReadContext) (value Any)] QueryHead
  (let [(fields (Vec Any)) (read-record! context value :query/head 2)]
    (->QueryHead
     (require-string!
      context (field-value fields 0) "query head relation")
     (parse-query-terms! context (field-value fields 1)))))

(defn parse-query-clause! [(context ReadContext) (value Any)] d/Literal
  (match (query-record-tag value)
    [:query/relation
    (let [(fields (Vec Any))
          (read-record! context value :query/relation 3)
          (relation String)
          (require-string!
           context (field-value fields 0) "query relation")
          (terms (Vec d/QueryTerm))
          (parse-query-terms! context (field-value fields 1))
          (negated Bool)
          (require-bool!
           context (field-value fields 2) "query negation")]
      (if negated
        (d/negated-literal relation terms)
        (d/relation-literal relation terms)))]

    [:query/predicate
    (let [(fields (Vec Any))
          (read-record! context value :query/predicate 3)
          (operation Keyword)
          (require-keyword!
           context (field-value fields 0) "query predicate")]
      (if (contains? d/comparison-operators operation)
        (d/comparison-literal
         operation
         [(parse-query-term! context (field-value fields 1))
          (parse-query-term! context (field-value fields 2))])
        (do
          (record-read-error!
           context :query-invalid-predicate
           "query predicate operation is unsupported")
          (fallback-query-literal))))]

    [:query/function
    (let [(fields (Vec Any))
          (read-record! context value :query/function 3)
          (operation Keyword)
          (require-keyword!
           context (field-value fields 0) "query function")]
      (if (contains? d/builtin-operators operation)
        (d/builtin-literal
         operation
         (parse-query-terms! context (field-value fields 1))
         (require-string!
          context (field-value fields 2) "query function binding"))
        (do
          (record-read-error!
           context :query-invalid-function
           "query function operation is unsupported")
          (fallback-query-literal))))]

    [_ (do
         (record-read-error!
          context :query-invalid-clause
          "query clause record is unsupported")
         (fallback-query-literal))]))

(defn parse-query-rule! [(context ReadContext) (value Any)] d/Rule
  (let [(fields (Vec Any)) (read-record! context value :query/rule 2)
        (head QueryHead)
        (parse-query-head! context (field-value fields 0))]
    (d/rule
     (queryhead-relation head)
     (queryhead-terms head)
     (mapv
      (fn [(clause Any)] d/Literal
        (parse-query-clause! context clause))
      (read-list! context (field-value fields 1))))))

(defn parse-query-stratum! [(context ReadContext) (value Any)] (Vec d/Rule)
  (let [(fields (Vec Any)) (read-record! context value :query/stratum 1)]
    (mapv
     (fn [(rule Any)] d/Rule (parse-query-rule! context rule))
     (read-list! context (field-value fields 0)))))

(defn parse-query-aggregate!
  [(context ReadContext) (value Any)] query/AggregateSpec
  (let [(fields (Vec Any))
        (read-record! context value :query/aggregate 2)
        (operation Keyword)
        (require-keyword!
         context (field-value fields 0) "query aggregate")
        (argument OptionValue)
        (read-option! context (field-value fields 1))]
    (if (contains? query/aggregate-operators operation)
      (query/aggregate-spec
       operation
       (if (optionvalue-present argument)
         (require-int!
          context (optionvalue-value argument) "aggregate argument index")
         nil))
      (do
        (record-read-error!
         context :query-invalid-aggregate
         "query aggregate operation is unsupported")
        (query/aggregate-spec :count nil)))))

(defn parse-query-having! [(context ReadContext) (value Any)] query/HavingClause
  (let [(fields (Vec Any)) (read-record! context value :query/having 3)
        (comparison Keyword)
        (require-keyword!
         context (field-value fields 0) "having comparison")]
    (if (contains? d/comparison-operators comparison)
      (query/having-clause
       comparison
       (require-int!
        context (field-value fields 1) "having aggregate index")
       (require-term! context (field-value fields 2) "having value"))
      (do
        (record-read-error!
         context :query-invalid-having
         "having comparison operation is unsupported")
        (query/having-clause :eq 0 :rpc/unit)))))

(defn parse-query-find! [(context ReadContext) (value Any)] query/FindSpec
  (match (query-record-tag value)
    [:query/find-relation
    (let [(fields (Vec Any))
          (read-record! context value :query/find-relation 1)]
      (query/relation-find
       (require-string!
        context (field-value fields 0) "find relation")))]

    [:query/find-aggregate
    (let [(fields (Vec Any))
          (read-record! context value :query/find-aggregate 4)]
      (query/aggregate-find
       (require-string!
        context (field-value fields 0) "aggregate find relation")
       (mapv
        (fn [(position Any)] Int
          (require-int! context position "aggregate grouping index"))
        (read-list! context (field-value fields 1)))
       (mapv
        (fn [(aggregate Any)] query/AggregateSpec
          (parse-query-aggregate! context aggregate))
        (read-list! context (field-value fields 2)))
       (mapv
        (fn [(clause Any)] query/HavingClause
          (parse-query-having! context clause))
        (read-list! context (field-value fields 3)))))]

    [_ (do
         (record-read-error!
          context :query-invalid-find
          "query find record is unsupported")
         (fallback-find-spec))]))

(defn parse-query-order! [(context ReadContext) (value Any)] query/OrderClause
  (let [(fields (Vec Any)) (read-record! context value :query/order 2)]
    (query/order-clause
     (require-int! context (field-value fields 0) "query order column")
     (require-keyword!
      context (field-value fields 1) "query order direction"))))

(defn parse-query-plan! [(context ReadContext) (value Any)] query/QueryPlan
  (let [(fields (Vec Any)) (read-record! context value :query/plan 4)
        (limit-option OptionValue)
        (read-option! context (field-value fields 3))
        (plan query/QueryPlan)
        (query/ordered-query-plan
         (parse-query-find! context (field-value fields 0))
         (mapv
          (fn [(stratum Any)] (Vec d/Rule)
            (parse-query-stratum! context stratum))
          (read-list! context (field-value fields 1)))
         (mapv
          (fn [(clause Any)] query/OrderClause
            (parse-query-order! context clause))
          (read-list! context (field-value fields 2)))
         (if (optionvalue-present limit-option)
           (require-int!
            context (optionvalue-value limit-option) "query limit")
           nil))]
    (if (read-context-ok? context)
      (let [(errors (Vec query/QueryError)) (query/validate-plan! plan)]
        (if (empty? errors)
          plan
          (let [(error query/QueryError) (nth errors 0)]
            (do
              (record-read-error!
               context (query/error-code error) (query/error-message error))
              plan))))
      plan)))

(defn parse-query-row! [(context ReadContext) (value Any)] (Vec Any)
  (let [(fields (Vec Any)) (read-record! context value :query/row 1)]
    (mapv
     (fn [(entry Any)] Any
       (require-term! context entry "query row value"))
     (read-list! context (field-value fields 0)))))

(defn parse-query-cursor! [(context ReadContext) (value Any)] QueryCursor
  (let [(fields (Vec Any)) (read-record! context value :query/cursor 4)
        (snapshot-version Int)
        (require-int!
         context (field-value fields 0) "cursor snapshot version")
        (ordinal Int)
        (require-int! context (field-value fields 2) "cursor page ordinal")]
    (if (or (< snapshot-version 0) (< ordinal 0))
      (do
        (record-read-error!
         context :query-cursor-mismatch
         "query cursor coordinates must be non-negative")
        (->QueryCursor 0 "" 0 []))
      (->QueryCursor
       snapshot-version
       (require-string!
        context (field-value fields 1) "cursor query digest")
       ordinal
       (parse-query-row! context (field-value fields 3))))))

(defn request-cursor!
  [(context ReadContext) (request t/RpcRequest)] QueryCursor?
  (let [page (t/rpcrequest-page request)]
    (if (some? page)
      (let [cursor (t/rpc-page-request-cursor-value page)]
        (if (some? cursor) (parse-query-cursor! context cursor) nil))
      nil)))

(defn upper-snapshot-version!
  [(context ReadContext) (snapshot Any) (cursor QueryCursor?) (head Int)] Int
  (cond
    [(= snapshot :query/current)
     (if (some? cursor) (querycursor-snapshot-version cursor) head)]
    [(= :query/as-of (query-record-tag snapshot))
     (let [(fields (Vec Any))
           (read-record! context snapshot :query/as-of 1)]
       (require-int!
        context (field-value fields 0) "query snapshot version"))]
    [:else
     (do
       (record-read-error!
        context :query-invalid-snapshot
        "query upper snapshot must be current or as-of")
       head)]))

(defn snapshot-root!
  [(context ReadContext)
   (root (Atom t/TermStore))
   (version Int)]
  (Atom t/TermStore)
  (let [head (store/current-sequence root)]
    (if (or (< version 0) (> version head))
      (do
        (record-read-error!
         context :query-invalid-snapshot
         "query snapshot is outside available history")
        root)
      (if (= version head)
        root
        (let [(frames-result store/TransactionFramesResult)
              (store/transaction-frames-between-result
               (deref root) -1 version)
              (frames-code Keyword?) (store/transactionframesresult-code frames-result)]
          (if (not (store/transactionframesresult-ok frames-result))
            (do
              (record-read-error!
               context
               (if (some? frames-code)
                 frames-code :rpc/native-query-failed)
               "native read operation failed")
              root)
            (let [(copy (Atom t/TermStore)) (store/new-term-store (store/space-id root))
                  (frames (Vec t/TransactionFrame))
                  (store/transactionframesresult-frames frames-result)]
              (loop [remaining frames]
                (if (empty? remaining)
                  copy
                  (let [(replay-result store/TransactionReplayResult)
                        (store/replay-transaction-result!
                         copy (first remaining))
                        (replay-code Keyword?)
                        (store/transactionreplayresult-code replay-result)]
                    (if (store/transactionreplayresult-ok replay-result)
                      (recur (rest remaining))
                      (do
                        (record-read-error!
                         context
                         (if (some? replay-code)
                           replay-code :rpc/native-query-failed)
                         "native read operation failed")
                        root))))))))))))

(defn requested-query-bounds!
  [(context ReadContext)
   (root (Atom t/TermStore))
   (snapshot Any)
   (cursor QueryCursor?)]
  QueryBounds
  (let [head (store/current-sequence root)]
    (if (not (read-context-ok? context))
      (->QueryBounds head -1)
      (let [(lower-and-upper (Vec Int))
            (if (= :query/since (query-record-tag snapshot))
              (let [(fields (Vec Any))
                    (read-record! context snapshot :query/since 2)
                    (lower Int)
                    (require-int!
                     context (field-value fields 0)
                     "query since lower bound")]
                (if (< lower 0)
                  (do
                    (record-read-error!
                     context :query-invalid-snapshot
                     "query since lower bound must be non-negative")
                    [0 head])
                  [lower
                   (upper-snapshot-version!
                    context (field-value fields 1) cursor head)]))
              [-1 (upper-snapshot-version! context snapshot cursor head)])
            (lower Int) (nth lower-and-upper 0)
            (upper Int) (nth lower-and-upper 1)]
        (cond
          [(not (read-context-ok? context))
           (->QueryBounds head -1)]
          [(and (some? cursor)
                (not= (querycursor-snapshot-version cursor) upper))
           (do
             (record-read-error!
              context :query-cursor-mismatch
              "query cursor belongs to a different snapshot")
             (->QueryBounds head -1))]
          [(> lower upper)
           (do
             (record-read-error!
              context :query-invalid-snapshot
              "query since lower bound exceeds its upper snapshot")
             (->QueryBounds head -1))]
          [:else (->QueryBounds upper lower)])))))

(defn query-view!
  [(context ReadContext)
   (session schema/Session)
   (bounds QueryBounds)]
  QueryView
  (let [root (schema/store-of session)
        head (store/current-sequence root)
        selected-root
        (snapshot-root! context root (querybounds-version bounds))]
    (if (read-context-ok? context)
      (->QueryView selected-root
                   (if (= head (querybounds-version bounds))
                     (schema/view session)
                     (rot/project! selected-root))
                   (querybounds-version bounds)
                   (querybounds-lower-exclusive bounds))
      (->QueryView root (schema/view session) head -1))))

(defn- rule-uses-any-relation? [(rule d/Rule) (relations (Set String))] Bool
  (if (contains? relations (d/rule-head-relation rule))
    true
    (let [(body (Vec d/Literal)) (d/rule-body rule)]
      (loop [position 0]
        (if (>= position (count body))
          false
          (if (contains? relations
                         (d/literal-relation (nth body position)))
            true
            (recur (inc position))))))))

(defn- stratum-uses-any-relation?
  [(rules (Vec d/Rule)) (relations (Set String))] Bool
  (loop [position 0]
    (if (>= position (count rules))
      false
      (if (rule-uses-any-relation? (nth rules position) relations)
        true
        (recur (inc position))))))

(defn- plan-uses-any-relation?
  [(plan query/QueryPlan) (relations (Set String))] Bool
  (if (contains? relations
                 (query/findspec-relation (query/queryplan-find plan)))
    true
    (let [(strata (Vec (Vec d/Rule))) (query/queryplan-strata plan)]
      (loop [stratum-position 0]
        (if (>= stratum-position (count strata))
          false
          (if (stratum-uses-any-relation?
               (nth strata stratum-position) relations)
            true
            (recur (inc stratum-position))))))))

(defn query-rows!
  [(view QueryView)
   (plan query/QueryPlan)
   (timeout-ms Int)]
  query/QueryExecutionResult
  (let [(rotation rot/Rotation) (queryview-rotation view)
        (root t/TermStore) (deref (queryview-root view))
        (triple-candidate d/CandidateSource)
        (d/rotation-candidate-source
         rotation (queryview-lower-exclusive view))
        (occurrence-candidate d/CandidateSource?)
        (if (plan-uses-any-relation? plan #{d/occurrence-relation})
          (d/occurrence-candidate-source
           root (queryview-lower-exclusive view) (queryview-version view))
          nil)
        (withdrawal-candidate d/CandidateSource?)
        (if (plan-uses-any-relation? plan #{d/withdrawal-relation})
          (d/withdrawal-candidate-source
           root (queryview-lower-exclusive view) (queryview-version view))
          nil)
        (text-result d/CandidateSourcesResult)
        (if (plan-uses-any-relation? plan d/text-relations)
          (let [(propositions (Vec t/Triple))
                (rot/propositions
                 (d/events-after-sequence
                  (rot/all-occurrences rotation)
                  (queryview-lower-exclusive view)))
                (attributes query/TextAttributeScope)
                (query/plan-text-attribute-scope plan)]
            (if (some? attributes)
              (let [(scope (Set Any)) attributes]
                (d/build-text-candidates-for-attributes-result!
                 propositions scope))
              (d/build-text-candidates-result! propositions)))
          (d/->CandidateSourcesResult {} nil))
        (error-value d/QueryEvaluationError?) (d/candidatesourcesresult-error text-result)
        (control d/QueryControl) (d/query-control query-step-limit timeout-ms)]
    (if (some? error-value)
      (query/->QueryExecutionResult nil error-value)
      (let [(text-candidates d/CandidateSources)
            (d/candidatesourcesresult-sources text-result)
            (triple-candidates d/CandidateSources)
            (assoc text-candidates d/triple-relation triple-candidate)
            (with-occurrences d/CandidateSources)
            (if (some? occurrence-candidate)
              (assoc triple-candidates
                     d/occurrence-relation occurrence-candidate)
              triple-candidates)
            (candidates d/CandidateSources)
            (if (some? withdrawal-candidate)
              (assoc with-occurrences
                     d/withdrawal-relation withdrawal-candidate)
              with-occurrences)]
        (query/run-plan-projected-result!
         (query/project-with-candidates [] candidates) plan control)))))

(defn query-row-position!
  [(context ReadContext) (rows (Vec d/Tuple)) (after-row (Vec Any))] Int
  (loop [position 0]
    (if (>= position (count rows))
      (do
        (record-read-error!
         context :query-cursor-mismatch
         "query cursor row is absent from its snapshot")
        0)
      (if (= after-row (nth rows position))
        position
        (recur (inc position))))))

(defn occurrence-position!
  [(context ReadContext) (rows (Vec t/Triple)) (after-row (Vec Any))] Int
  (if (= 2 (count after-row))
    (let [position-value (nth after-row 0)
          expected (nth after-row 1)]
      (if (and (integer? position-value) (t/triple? expected))
        (let [(position Int) position-value
              (expected-value t/Triple) expected]
          (if (and (>= position 0)
                   (and (< position (count rows))
                        (= expected-value (nth rows position))))
            position
            (do
              (record-read-error!
               context :query-cursor-mismatch
               "page cursor row is absent from its snapshot")
              0)))
        (do
          (record-read-error!
           context :query-cursor-mismatch
           "page cursor row is absent from its snapshot")
          0)))
    (do
      (record-read-error!
       context :query-cursor-mismatch
       "page cursor row is absent from its snapshot")
      0)))

(defn page-request-limit! [(context ReadContext) (page t/RpcPageRequest)] Int
  (let [limit (t/rpcpagerequest-limit page)]
    (if (and (>= limit 1) (<= limit query/max-page-limit))
      limit
      (do
        (record-read-error!
         context :query-page-limit
         "query page limit must be from 1 through 4096")
        1))))

(defn rpc-query-cursor
  [(snapshot-version Int)
   (digest String)
   (next-page-ordinal Int)
   (after-row (Vec Any))]
  t/Triple
  (rpc-record
   :query/cursor
   [snapshot-version digest next-page-ordinal (rpc-query-row after-row)]))

(defn empty-query-page-result [] PageResult
  (->PageResult (rpc-query-rows []) nil))

(defn empty-occurrence-page-result [] PageResult
  (->PageResult (rpc-occurrences []) nil))

(defn slice-query-page!
  [(context ReadContext)
   (rows (Vec d/Tuple))
   (page t/RpcPageRequest?)
   (cursor QueryCursor?)
   (snapshot-version Int)
   (digest String)]
  PageResult
  (if (nil? page)
    ;; An unpaged answer nests one Term node per row, so it is bounded by the
    ;; same codec budget the occurrence path takes; say so here instead of
    ;; letting the encoder fail on the way out.
    (if (> (count rows) unpaged-occurrence-limit)
      (do
        (record-read-error!
         context :term-depth-exceeded
         "unpaged query result exceeds the TermCodecV1 depth bound")
        (empty-query-page-result))
      (->PageResult (rpc-query-rows rows) nil))
    (let [limit (page-request-limit! context page)]
      (cond
        [(not (read-context-ok? context)) (empty-query-page-result)]
        [(and (some? cursor) (not= digest (querycursor-digest cursor)))
         (do
           (record-read-error!
            context :query-cursor-mismatch
            "query cursor belongs to a different query")
           (empty-query-page-result))]
        [:else
        (let [ordinal (if (some? cursor)
                        (querycursor-next-page-ordinal cursor) 0)
              start (if (some? cursor)
                      (inc (query-row-position!
                            context rows (querycursor-after-row cursor))) 0)]
          (if (not (read-context-ok? context))
            (empty-query-page-result)
            (let [(selected (Vec d/Tuple))
                  (vec (take limit (drop start rows)))
                  (next-position Int) (+ start (count selected))
                  (done Bool) (>= next-position (count rows))
                  (next-cursor t/Term?)
                  (if done
                    nil
                    (let [(cursor-term t/Term)
                          (rpc-query-cursor
                           snapshot-version digest (inc ordinal)
                           (nth selected (dec (count selected))))]
                      cursor-term))]
              (->PageResult
               (rpc-query-rows selected)
               (t/->RpcPageResponse ordinal next-cursor done)))))]))))

(defn slice-occurrence-page!
  [(context ReadContext)
   (rows (Vec t/Triple))
   (page t/RpcPageRequest?)
   (cursor QueryCursor?)
   (snapshot-version Int)
   (digest String)]
  PageResult
  (if (nil? page)
    (->PageResult
     (rpc-occurrences (vec (take unpaged-occurrence-limit rows))) nil)
    (let [limit (page-request-limit! context page)]
      (cond
        [(not (read-context-ok? context)) (empty-occurrence-page-result)]
        [(and (some? cursor) (not= digest (querycursor-digest cursor)))
         (do
           (record-read-error!
            context :query-cursor-mismatch
            "query cursor belongs to a different query")
           (empty-occurrence-page-result))]
        [:else
        (let [ordinal (if (some? cursor)
                        (querycursor-next-page-ordinal cursor) 0)
              start (if (some? cursor)
                      (inc (occurrence-position!
                            context rows (querycursor-after-row cursor))) 0)]
          (if (not (read-context-ok? context))
            (empty-occurrence-page-result)
            (let [(selected (Vec t/Triple))
                  (vec (take limit (drop start rows)))
                  (next-position Int) (+ start (count selected))
                  (done Bool) (>= next-position (count rows))
                  (next-cursor t/Term?)
                  (if done
                    nil
                    (let [(cursor-term t/Term)
                          (rpc-query-cursor
                           snapshot-version digest (inc ordinal)
                           [(dec next-position)
                            (nth selected (dec (count selected)))])]
                      cursor-term))]
              (->PageResult
               (rpc-occurrences selected)
               (t/->RpcPageResponse ordinal next-cursor done)))))]))))

(defn read-digest! [(context ReadContext) (term Any)] String
  (let [(result native-wire/TermDigestResult)
        (native-wire/canonical-term-sha256-result! term)]
    (if (native-wire/termdigestresult-ok result)
      (native-wire/termdigestresult-digest result)
      (do
        (record-read-error!
         context
         (native-wire/termdigestresult-code result)
         (native-wire/termdigestresult-message result))
        ""))))

(defn placeholder-error-response
  [(request t/RpcRequest) (served-version Int)] t/RpcResponse
  (error-response request served-version
                  :rpc/native-query-failed
                  "native read operation failed"))

(defn query-evaluation-error-response!
  [(context ReadContext)
   (request t/RpcRequest)
   (served-version Int)
   (view-version Int)
   (error-value d/QueryEvaluationError)]
  t/RpcResponse
  (if (= :fram-query-abort
         (d/query-evaluation-error-type error-value))
    (error-response
     request view-version
     (d/query-evaluation-error-code error-value)
     (d/query-evaluation-error-message error-value))
    (do
      (record-read-error!
       context
       (d/query-evaluation-error-code error-value)
       "native read operation failed")
      (placeholder-error-response request served-version))))

(defn query-rows-response!
  [(context ReadContext)
   (request t/RpcRequest)
   (head Int)
   (version Int)
   (digest String)
   (cursor QueryCursor?)
   (rows (Vec d/Tuple))]
  t/RpcResponse
  (let [(page-result PageResult)
        (slice-query-page!
         context rows (t/rpcrequest-page request) cursor version digest)]
    (if (read-context-ok? context)
      (response request version
                (pageresult-page page-result)
                (pageresult-payload page-result))
      (placeholder-error-response request head))))

(defn query-response!
  [(context ReadContext)
   (session schema/Session)
   (request t/RpcRequest)]
  t/RpcResponse
  (let [(root (Atom t/TermStore)) (schema/store-of session)
        (head Int) (store/current-sequence root)
        (request-fields (Vec Any))
        (read-record!
         context (t/rpc-request-payload-value request) :query/request 2)
        (plan-term Any) (field-value request-fields 0)
        (plan query/QueryPlan) (parse-query-plan! context plan-term)
        (cursor QueryCursor?) (request-cursor! context request)
        (bounds QueryBounds)
        (requested-query-bounds!
         context root (field-value request-fields 1) cursor)]
    (if (not (read-context-ok? context))
      (placeholder-error-response request head)
      (let [digest
            (read-digest!
             context
             (t/triple plan-term
                       (querybounds-lower-exclusive bounds)
                       (querybounds-version bounds)))]
        (if (not (read-context-ok? context))
          (placeholder-error-response request head)
          (let [(requested-timeout Int?) (t/rpcrequest-timeout-ms request)
                (timeout-value Int)
                (if (some? requested-timeout)
                  (let [(present-timeout Int) requested-timeout]
                    present-timeout)
                  default-query-timeout-ms)
                (timeout-ms Int) (min max-query-timeout-ms timeout-value)]
            (if (< timeout-ms 0)
              (error-response request (querybounds-version bounds)
                              :rpc-invalid-payload
                              "query timeout-ms must be non-negative")
              (let [(key schema/OrderedResultKey)
                    (result-cache-key
                     session (querybounds-version bounds)
                     (querybounds-lower-exclusive bounds) :rpc/query digest)
                    (cached ResultCacheLookup)
                    (result-cache-lookup! session key)]
                (if (resultcachelookup-found cached)
                  (query-rows-response!
                   context request head (querybounds-version bounds) digest
                   cursor (resultcachelookup-query-rows cached))
                  (let [(view QueryView) (query-view! context session bounds)]
                    (if (not (read-context-ok? context))
                      (placeholder-error-response request head)
                      (let [(execution query/QueryExecutionResult)
                            (query-rows! view plan timeout-ms)
                            (error-value d/QueryEvaluationError?) (query/execution-error execution)
                            (result query/QueryResult?) (query/execution-query-result execution)]
                        (cond
                          [(some? error-value)
                           (query-evaluation-error-response!
                            context request head (queryview-version view)
                            error-value)]
                          [(nil? result)
                           (do
                             (record-read-error!
                              context :rpc/native-query-failed
                              "native read operation failed")
                             (placeholder-error-response request head))]
                          [:else
                           (let [(errors (Vec query/QueryError))
                                 (query/result-errors result)]
                             (if (not (empty? errors))
                               (let [(error query/QueryError) (nth errors 0)]
                                 (error-response
                                  request (queryview-version view)
                                  (query/error-code error)
                                  (query/error-message error)))
                               (let [(rows (Vec d/Tuple))
                                     (query/result-rows result)]
                                 (do
                                   (retain-query-result! session key rows)
                                   (query-rows-response!
                                    context request head
                                    (queryview-version view) digest cursor
                                    rows)))))])))))))))))))

(defn occurrence-rows-response!
  [(context ReadContext)
   (request t/RpcRequest)
   (head Int)
   (version Int)
   (digest String)
   (cursor QueryCursor?)
   (rows (Vec t/Triple))]
  t/RpcResponse
  (let [(page-result PageResult)
        (slice-occurrence-page!
         context rows (t/rpcrequest-page request) cursor version digest)]
    (if (read-context-ok? context)
      (response request version
                (pageresult-page page-result)
                (pageresult-payload page-result))
      (placeholder-error-response request head))))

(defn occurrences-response!
  [(context ReadContext)
   (session schema/Session)
   (request t/RpcRequest)]
  t/RpcResponse
  (let [root (schema/store-of session)
        head (store/current-sequence root)]
    (do
      (require-unit! context (t/rpc-request-payload-value request))
      (if (not (read-context-ok? context))
        (placeholder-error-response request head)
        (let [(cursor QueryCursor?) (request-cursor! context request)
              (version Int) (if (some? cursor)
                        (querycursor-snapshot-version cursor) head)
              (digest String) (read-digest! context :rpc/unit)]
          (if (not (read-context-ok? context))
            (placeholder-error-response request head)
            (let [page (t/rpcrequest-page request)]
              (if (some? page)
                (let [(key schema/OrderedResultKey)
                      (result-cache-key
                       session version -1 :rpc/occurrences digest)
                      (cached ResultCacheLookup)
                      (result-cache-lookup! session key)]
                  (if (resultcachelookup-found cached)
                    (occurrence-rows-response!
                     context request head version digest cursor
                     (resultcachelookup-triple-rows cached))
                    (let [snapshot (snapshot-root! context root version)]
                      (if (not (read-context-ok? context))
                        (placeholder-error-response request head)
                        (let [(rows (Vec t/Triple))
                              (rpc-operation-occurrences
                               (store/occurrences snapshot))]
                          (do
                            (retain-triple-result! session key rows)
                            (occurrence-rows-response!
                             context request head version digest cursor
                             rows)))))))
                (let [snapshot (snapshot-root! context root version)]
                  (if (not (read-context-ok? context))
                    (placeholder-error-response request head)
                    (occurrence-rows-response!
                     context request head version digest cursor
                     (rpc-operation-occurrences
                      (store/occurrences snapshot)))))))))))))

(defn validation-payload! [(root (Atom t/TermStore))] t/Triple
  (let [(snapshot t/TermStore) (deref root)
        (copy (Atom t/TermStore)) (atom snapshot)
        (loaded store/TermStoreLoadResult)
        (store/load-term-store-result! copy (store/dump-term-store copy))]
    (if (store/termstoreloadresult-ok loaded)
      (let [(space-id String) (store/space-id copy)
            (propositions (Vec t/Triple)) (store/live-propositions copy)
            (violations (Vec t/Triple))
            (kernel/lint-declared-profile propositions space-id)]
        (rpc-validation
         true
         (mapv
          (fn [(violation t/Triple)] Any
            (rpc-violation :rpc/profile-violation violation))
          violations)))
      (let [code-value (store/termstoreloadresult-code loaded)
            code (if code-value code-value :rpc/validation-failed)]
        (rpc-validation false [(rpc-violation code "validation failed")])))))

(defn validate-response!
  [(context ReadContext)
   (session schema/Session)
   (request t/RpcRequest)]
  t/RpcResponse
  (let [served-version (store/current-sequence (schema/store-of session))]
    (do
      (require-unit! context (t/rpc-request-payload-value request))
      (if (read-context-ok? context)
        (response request served-version nil
                  (validation-payload! (schema/store-of session)))
        (placeholder-error-response request served-version)))))

(defn dispatch-read!
  [(session schema/Session) (request t/RpcRequest)] NativeReadResult
  (let [(operation Keyword) (t/rpcrequest-op request)
        (served-version Int) (store/current-sequence (schema/store-of session))
        (context ReadContext) (new-read-context)]
    (if (contains? #{:rpc/query :rpc/occurrences :rpc/validate} operation)
      (let [(selected t/RpcResponse)
            (cond
              [(and (not= operation :rpc/query)
                    (some? (t/rpcrequest-timeout-ms request)))
               (error-response
                request served-version :rpc/unexpected-timeout
                "timeout-ms is supported only by rpc/query")]
              [(and (= operation :rpc/validate)
                    (some? (t/rpcrequest-page request)))
               (error-response
                request served-version :rpc/unexpected-page
                "paging is supported only by rpc/query, rpc/scan, and rpc/occurrences")]
              [(= operation :rpc/query)
               (query-response! context session request)]
              [(= operation :rpc/occurrences)
               (occurrences-response! context session request)]
              [:else (validate-response! context session request)])
            (read-error ReadError?) (read-context-error context)]
        (if read-error
          (->NativeReadResult
           true
           (error-response request served-version
                           (readerror-code read-error)
                           (readerror-message read-error)))
          (->NativeReadResult true selected)))
      (->NativeReadResult false nil))))
