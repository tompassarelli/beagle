#lang beagle
;; Typed Datalog over homogeneous rows of recursive Fram Terms. Relation names
;; are query-local; the kernel assigns no role to t1, t2, or t3.
(ns fram.datalog)
(require fram.rotation :as rot)
(require fram.store :as store)
(require fram.types :as t)
(require fram.text-index :as text-index)
(require fram.text-search :as text-search)

;; Query syntax adapters compile to this IR. QueryTerm.value stays Any because
;; Beagle cannot consume a recursive Dyn through generic equality; constant and
;; edb enforce Term at the boundary, so there is still one semantic value model.
(defrecord QueryTerm [(variable String?) (value Any)])
(defrecord Literal
  [(kind Keyword)
   (relation String)
   (arguments (Vec QueryTerm))
   (negated Bool)
   (operator Keyword)
   (binding String)])
(defrecord Rule
  [(head-relation String) (head-arguments (Vec QueryTerm)) (body (Vec Literal))])
(defrecord QueryEvaluationError
  [(error-type Keyword)
   (code Keyword)
   (message String)
   (reason Keyword?)
   (steps Int?)
   (max-steps Int?)
   (timeout-ms Int?)
   (bytes Int?)
   (maximum Int?)])
(defrecord QueryControl
  [(steps (Atom Int))
   (cancelled (Atom (U Keyword Nil)))
   (max-steps Int)
   (deadline-ns Int)
   (timeout-ms Int)])

(defalias Tuple (Vec Any))
(defalias Db (Map String (Set Tuple)))
(defalias Substitution (Map String Any))
(defalias HandleBucket (Map Any (Vec Int)))
(defalias PositionIndex (Map Int HandleBucket))
(defalias HandleTrieLeaf (Map Any (Vec Int)))
(defalias HandleTrieBranch (Map Any HandleTrieLeaf))
(defalias HandleTrie (Map Any HandleTrieBranch))

(defrecord QueryEvaluationContext
  [(control QueryControl?) (error (Atom QueryEvaluationError?))])
(defrecord QueryEvaluationResult [(db Db) (error QueryEvaluationError?)])

(defrecord BuiltinValueResult [(int-value Int?) (double-value Double?)])

(defrecord OccurrenceCandidateSource
  [(root t/TermStore)
   (lower-exclusive Int)
   (upper-inclusive Int)
   (postings (Map Int (Vec Int)))])

;; A projected rotation carries the upper snapshot only, so a since window's
;; lower bound has to ride alongside it.
(defrecord RotationCandidateSource
  [(rotation rot/Rotation) (lower-exclusive Int)])

;; Candidate handles are private positions in one immutable relation vector.
(defunion CandidateSourceValue
  (CandidateSource
   [(rows (Vec Tuple))
    (positions PositionIndex)
    (spo HandleTrie)
    (pos HandleTrie)
    (osp HandleTrie)
    (occurrence OccurrenceCandidateSource?)
    (rotation RotationCandidateSource?)])
  (VirtualCandidateSource
   [(relation String) (source text-search/TextSearchSource)]))
(defalias CandidateSources (Map String CandidateSourceValue))

(defrecord CandidateSourcesResult
  [(sources CandidateSources) (error QueryEvaluationError?)])

(def triple-relation String "triple")
(def occurrence-relation String "occurrence")
(def withdrawal-relation String "withdrawal")
(def text-match-relation String "text-match")
(def text-phrase-relation String "text-phrase")
(def text-substring-relation String "text-substring")
(def text-stem-relation String "text-stem")
(def text-search-relation String "text-search")
(def text-relations (Set String)
  #{text-match-relation text-phrase-relation text-substring-relation
    text-stem-relation text-search-relation})
(def base-relations (Set String)
  (conj text-relations
        triple-relation
        occurrence-relation
        withdrawal-relation))
(def comparison-operators (Set Keyword) #{:eq :ne :lt :le :gt :ge})
(def subtract-operator Keyword (keyword "-"))
(def builtin-operators (Set Keyword)
  #{:+ subtract-operator :* :/ :mod})

(def ^:dynamic *query-control* QueryControl? nil)

(defn- next-query-step [(steps Int)] Int
  (inc steps))

(defn- query-cancellation-cell [(reason (U Keyword Nil))] (Atom (U Keyword Nil))
  (atom reason))

(def no-query-evaluation-error QueryEvaluationError? nil)

(defn- query-evaluation-error-cell [] (Atom QueryEvaluationError?)
  (atom no-query-evaluation-error))

(defn preserve-first-query-evaluation-error
  [(current QueryEvaluationError?)
   (incoming QueryEvaluationError)]
  QueryEvaluationError?
  (if current current incoming))

(defn query-control [(max-steps Int) (timeout-ms Int)] QueryControl
  (if (and (> max-steps 0) (>= timeout-ms 0))
    (let [(steps (Atom Int)) (atom 0)
          (cancelled (Atom (U Keyword Nil))) (query-cancellation-cell nil)]
      (->QueryControl steps cancelled max-steps
                      (+ (monotonic-nanoseconds) (* timeout-ms 1000000))
                      timeout-ms))
    (throw (ex-info "fram: query limits must be positive steps and non-negative milliseconds"
                    {:type :invalid-query-control}))))

(defn cancel-query! [(control QueryControl) (reason Keyword)] Nil
  (reset! (querycontrol-cancelled control) reason)
  nil)

(defn query-steps [(control QueryControl)] Int
  (deref (querycontrol-steps control)))

(defn new-query-evaluation-context
  [(control QueryControl?)] QueryEvaluationContext
  (->QueryEvaluationContext control (query-evaluation-error-cell)))

(defn query-evaluation-error
  [(error-type Keyword) (code Keyword) (message String)] QueryEvaluationError
  (->QueryEvaluationError error-type code message
                          nil nil nil nil nil nil))

(defn query-evaluation-limit-error
  [(error-type Keyword)
   (code Keyword)
   (message String)
   (bytes Int)
   (maximum Int)]
  QueryEvaluationError
  (->QueryEvaluationError error-type code message
                          nil nil nil nil bytes maximum))

(defn query-evaluation-error-from-text-error
  [(error-value text-index/TextError)] QueryEvaluationError
  (if (text-index/texterror-limit-data error-value)
    (query-evaluation-limit-error
     (text-index/texterror-type error-value)
     (text-index/texterror-code error-value)
     (text-index/texterror-message error-value)
     (text-index/texterror-bytes error-value)
     (text-index/texterror-maximum error-value))
    (query-evaluation-error
     (text-index/texterror-type error-value)
     (text-index/texterror-code error-value)
     (text-index/texterror-message error-value))))

(defn record-query-evaluation-error!
  [(context QueryEvaluationContext) (error-value QueryEvaluationError)] Nil
  (compare-and-set! (queryevaluationcontext-error context)
                    no-query-evaluation-error error-value)
  nil)

(defn query-evaluation-context-error
  [(context QueryEvaluationContext)] QueryEvaluationError?
  (deref (queryevaluationcontext-error context)))

(defn query-evaluation-context-open? [(context QueryEvaluationContext)] Bool
  (nil? (query-evaluation-context-error context)))

(defn query-evaluation-ok? [(result QueryEvaluationResult)] Bool
  (nil? (queryevaluationresult-error result)))

(defn query-evaluation-db [(result QueryEvaluationResult)] Db
  (queryevaluationresult-db result))

(defn query-evaluation-result-error
  [(result QueryEvaluationResult)] QueryEvaluationError?
  (queryevaluationresult-error result))

(defn query-evaluation-error-code [(error-value QueryEvaluationError)] Keyword
  (queryevaluationerror-code error-value))

(defn query-evaluation-error-type [(error-value QueryEvaluationError)] Keyword
  (queryevaluationerror-error-type error-value))

(defn query-evaluation-error-message [(error-value QueryEvaluationError)] String
  (queryevaluationerror-message error-value))

(defn- query-evaluation-error-data [(error-value QueryEvaluationError)] Any
  (let [error-type (queryevaluationerror-error-type error-value)
        code (queryevaluationerror-code error-value)
        steps (queryevaluationerror-steps error-value)
        bytes (queryevaluationerror-bytes error-value)]
    (cond
      [(and (= error-type :fram-query-abort) (some? steps))
       {:type :fram-query-abort
        :code code
        :reason (queryevaluationerror-reason error-value)
        :steps steps
        :max-steps (queryevaluationerror-max-steps error-value)
        :timeout-ms (queryevaluationerror-timeout-ms error-value)}]
      [(= error-type :fram-query-abort)
       {:type :fram-query-abort :code code}]
      [(and (= error-type :query-text-index-limit) (some? bytes))
       {:type :query-text-index-limit
        :fram/code code
        :bytes bytes
        :maximum (queryevaluationerror-maximum error-value)}]
      [:else {:type error-type :fram/code code}])))

(defn raise-query-evaluation-error [(error-value QueryEvaluationError)] Any
  (throw (ex-info (queryevaluationerror-message error-value)
                  (query-evaluation-error-data error-value))))

(defn raise-query-evaluation-error! [(error-value QueryEvaluationError)] Any
  (raise-query-evaluation-error error-value))

(defn- query-evaluation-db-or-throw! [(result QueryEvaluationResult)] Db
  (let [error-value (queryevaluationresult-error result)]
    (if (some? error-value)
      (raise-query-evaluation-error error-value)
      (queryevaluationresult-db result))))

(defn- query-check! [(context QueryEvaluationContext)] Bool
  (if (not (query-evaluation-context-open? context))
    false
    (let [control (queryevaluationcontext-control context)]
      (if (nil? control)
        true
        (let [steps (swap! (querycontrol-steps control) next-query-step)
              now (monotonic-nanoseconds)
              cancelled (deref (querycontrol-cancelled control))
              code (cond
                     [(some? cancelled) :query-cancelled]
                     [(> steps (querycontrol-max-steps control)) :query-work-limit]
                     [(>= now (querycontrol-deadline-ns control)) :query-time-limit]
                     [:else nil])]
          (if (nil? code)
            true
            (let [message
                  (cond
                    [(= code :query-cancelled)
                     "query evaluation stopped: query-cancelled"]
                    [(= code :query-work-limit)
                     "query evaluation stopped: query-work-limit"]
                    [:else "query evaluation stopped: query-time-limit"])]
              (record-query-evaluation-error!
               context
               (->QueryEvaluationError
                :fram-query-abort code message cancelled steps
                (querycontrol-max-steps control)
                (querycontrol-timeout-ms control)
                nil nil))
              false)))))))

(defn variable [(name String)] QueryTerm
  (if (pos? (count name))
    (->QueryTerm name nil)
    (throw (ex-info "fram: query variable name must be non-empty"
                    {:type :invalid-query-variable}))))

(defn constant [(value Any)] QueryTerm
  (if (t/term? value)
    (->QueryTerm nil value)
    (throw (ex-info "fram: query constant must be a Term"
                    {:type :invalid-query-constant}))))

(defn query-term? [(value Any)] Bool
  (and (instance? QueryTerm value)
       (if (some? (queryterm-variable value))
         (and (pos? (count (queryterm-variable value)))
              (nil? (queryterm-value value)))
         (t/term? (queryterm-value value)))))

(defn relation-literal [(relation String) (arguments (Vec QueryTerm))] Literal
  (->Literal :relation relation arguments false :none ""))

(defn negated-literal [(relation String) (arguments (Vec QueryTerm))] Literal
  (->Literal :relation relation arguments true :none ""))

(defn comparison-literal
  [(operator Keyword) (arguments (Vec QueryTerm))] Literal
  (->Literal :comparison "" arguments false operator ""))

(defn builtin-literal
  [(operator Keyword) (arguments (Vec QueryTerm)) (binding String)] Literal
  (->Literal :builtin "" arguments false operator binding))

(defn rule
  [(head-relation String)
   (head-arguments (Vec QueryTerm))
   (body (Vec Literal))]
  Rule
  (->Rule head-relation head-arguments body))

(defn- triple-row [(value t/Triple)] Tuple
  [(t/triple-t1 value) (t/triple-t2 value) (t/triple-t3 value)])

(defn- rows [(triples (Vec t/Triple))] (Set Tuple)
  (reduce (fn [(acc (Set Tuple)) (value t/Triple)] (Set Tuple)
            (conj acc (triple-row value)))
          #{} triples))

(defn- occurrence-row [(value t/OperationOccurrence)] Tuple
  [(t/operationoccurrence-coordinate value)
   (t/operationoccurrence-action value)
   (t/operationoccurrence-proposition value)])

(defn- occurrence-rows [(occurrences (Vec t/OperationOccurrence))] (Set Tuple)
  (reduce
   (fn [(acc (Set Tuple)) (value t/OperationOccurrence)] (Set Tuple)
     (conj acc (occurrence-row value)))
   #{} occurrences))

(defn- withdrawal-row [(value t/Withdrawal)] Tuple
  [(t/operationoccurrence-coordinate (t/withdrawal-retraction value))
   (t/operationoccurrence-coordinate (t/withdrawal-assertion value))])

(defn- withdrawal-rows [(withdrawals (Vec t/Withdrawal))] (Set Tuple)
  (reduce
   (fn [(acc (Set Tuple)) (value t/Withdrawal)] (Set Tuple)
     (conj acc (withdrawal-row value)))
   #{} withdrawals))

;; Ordinary queries see live propositions only. History is explicit system
;; data: operation occurrences and their derived targeted withdrawals.
(defn edb [(propositions (Vec t/Triple))] Db
  {triple-relation (rows propositions)})

(defn edb-with-history
  [(propositions (Vec t/Triple))
   (occurrences (Vec t/OperationOccurrence))
   (withdrawals (Vec t/Withdrawal))]
  Db
  {triple-relation (rows propositions)
   occurrence-relation (occurrence-rows occurrences)
   withdrawal-relation (withdrawal-rows withdrawals)})

(defn- term-value [(term QueryTerm) (subst Substitution)] Any
  (let [name (queryterm-variable term)]
    (if (some? name) (get subst name) (queryterm-value term))))

(defn- unify
  [(term QueryTerm) (value Any) (subst Substitution)] (U Substitution Nil)
  (let [name (queryterm-variable term)]
    (if (some? name)
      (if (contains? subst name)
        (if (= (get subst name) value) subst nil)
        (assoc subst name value))
      (if (= (queryterm-value term) value) subst nil))))

(defn- unify-arguments-controlled!
  [(arguments (Vec QueryTerm))
   (tuple Tuple)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (U Substitution Nil)
  (if (not (query-check! context))
    nil
    (if (not (= (count arguments) (count tuple)))
      nil
      (loop [(position Int) 0 (current (U Substitution Nil)) subst]
        (if (or (nil? current) (>= position (count arguments)))
          current
          (recur (+ position 1)
                 (unify (nth arguments position)
                        (nth tuple position)
                        current)))))))

(defn- unify-arguments!
  [(arguments (Vec QueryTerm))
   (tuple Tuple)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (U Substitution Nil)
  (unify-arguments-controlled! arguments tuple subst context))

(defn- ground [(arguments (Vec QueryTerm)) (subst Substitution)] Tuple
  (mapv (fn [(term QueryTerm)] Any
          (let [value (term-value term subst)]
            (if (some? value)
              value
              (throw (ex-info "fram: unbound query variable reached evaluation"
                              {:type :unbound-query-variable})))))
        arguments))

(defn- integer-value [(value Any)] (U Int Nil)
  (cond
    [(integer? value) value]
    [(string? value) (parse-long value)]
    [:else nil]))

(defn- numeric-value [(value Any)] (U Double Nil)
  (cond
    [(integer? value) (double value)]
    [(number? value) (double value)]
    [(string? value)
     (let [integer-result (parse-long value)]
       (if (some? integer-result)
         (double integer-result)
         (parse-double value)))]
    [:else nil]))

(defn- comparison-result [(literal Literal) (subst Substitution)] Bool
  (let [arguments (literal-arguments literal)
        left (term-value (nth arguments 0) subst)
        right (term-value (nth arguments 1) subst)
        operator (literal-operator literal)]
    (if (or (nil? left) (nil? right))
      false
      (cond
        [(= operator :eq) (= left right)]
        [(= operator :ne) (not (= left right))]
        [:else
         (let [left-number (numeric-value left)
               right-number (numeric-value right)]
           (if (or (nil? left-number) (nil? right-number))
             false
             (cond
               [(= operator :lt) (< left-number right-number)]
               [(= operator :le) (<= left-number right-number)]
               [(= operator :gt) (> left-number right-number)]
               [(= operator :ge) (>= left-number right-number)]
               [:else false])))]))))

(defn- integer-builtin-value [(operator Keyword) (left Int) (right Int)] Int
  (cond
    [(= operator :mod) (mod left right)]
    [(= operator :+) (+ left right)]
    [(= operator subtract-operator) (- left right)]
    [:else (* left right)]))

(defn- double-builtin-value
  [(operator Keyword) (left Double) (right Double)] Double
  (cond
    [(= operator :/) (/ left right)]
    [(= operator :+) (+ left right)]
    [(= operator subtract-operator) (- left right)]
    [:else (* left right)]))

(defn- builtin-value
  [(operator Keyword) (left Any) (right Any)] BuiltinValueResult
  (let [(left-int (U Int Nil)) (integer-value left)
        (right-int (U Int Nil)) (integer-value right)
        (left-number (U Double Nil)) (numeric-value left)
        (right-number (U Double Nil)) (numeric-value right)
        (invalid BuiltinValueResult) (->BuiltinValueResult nil nil)]
    (cond
      [(= operator :mod)
       (if (nil? left-int)
         invalid
         (if (nil? right-int)
           invalid
           (if (= right-int 0)
             invalid
             (->BuiltinValueResult
              (integer-builtin-value operator left-int right-int) nil))))]
      [(= operator :/)
       (if (nil? left-number)
         invalid
         (if (nil? right-number)
           invalid
           (if (= right-number 0.0)
             invalid
             (->BuiltinValueResult
              nil (double-builtin-value operator left-number right-number)))))]
      [(or (= operator :+) (or (= operator subtract-operator) (= operator :*)))
       (if (nil? left-int)
         (if (nil? left-number)
           invalid
           (if (nil? right-number)
             invalid
             (cond
               [(= operator :+)
                (->BuiltinValueResult
                 nil (double-builtin-value operator left-number right-number))]
               [(= operator subtract-operator)
                (->BuiltinValueResult
                 nil (double-builtin-value operator left-number right-number))]
               [:else
                (->BuiltinValueResult
                 nil (double-builtin-value operator left-number right-number))])))
         (if (nil? right-int)
           (if (nil? left-number)
             invalid
             (if (nil? right-number)
               invalid
               (cond
                 [(= operator :+)
                  (->BuiltinValueResult
                   nil (double-builtin-value operator left-number right-number))]
                 [(= operator subtract-operator)
                  (->BuiltinValueResult
                   nil (double-builtin-value operator left-number right-number))]
                 [:else
                  (->BuiltinValueResult
                   nil (double-builtin-value operator left-number right-number))])))
           (cond
             [(= operator :+)
              (->BuiltinValueResult
               (integer-builtin-value operator left-int right-int) nil)]
             [(= operator subtract-operator)
              (->BuiltinValueResult
               (integer-builtin-value operator left-int right-int) nil)]
             [:else
              (->BuiltinValueResult
               (integer-builtin-value operator left-int right-int) nil)])))]
      [:else invalid])))

(defn- builtin-results
  [(literal Literal) (subst Substitution)] (Vec Substitution)
  (let [arguments (literal-arguments literal)
        left (term-value (nth arguments 0) subst)
        right (term-value (nth arguments 1) subst)]
    (if (or (nil? left) (nil? right))
      []
      (let [result (builtin-value (literal-operator literal) left right)]
        (let [int-value (builtinvalueresult-int-value result)
              double-value (builtinvalueresult-double-value result)]
          (cond
            [(some? int-value)
             [(assoc subst (literal-binding literal) int-value)]]
            [(some? double-value)
             [(assoc subst (literal-binding literal) double-value)]]
            [:else []]))))))

(defn- unify-tuples-controlled!
  [(arguments (Vec QueryTerm))
   (tuples (Vec Tuple))
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(remaining (Vec Tuple)) tuples (results (Vec Substitution)) []]
    (if (or (empty? remaining)
            (not (query-evaluation-context-open? context)))
      results
      (let [matched
            (unify-arguments-controlled!
             arguments (first remaining) subst context)]
        (if (query-evaluation-context-open? context)
          (recur (rest remaining)
                 (if (some? matched) (conj results matched) results))
          results)))))

(defn- unify-tuples!
  [(arguments (Vec QueryTerm))
   (tuples (Vec Tuple))
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (unify-tuples-controlled! arguments tuples subst context))

(defn- bound-term-value [(term QueryTerm) (subst Substitution)] Any
  (let [name (queryterm-variable term)]
    (if (some? name)
      (if (contains? subst name) (get subst name) nil)
      (queryterm-value term))))

(defn- missing-candidate-source-result
  [(relation String)] text-search/TextSearchRowsResult
  (text-search/query-text-rows-error
   :query-text-index-unavailable
   (str "candidate source is unavailable for relation '" relation "'")))

(defn- virtual-source-rows-result!
  [(candidate VirtualCandidateSource)
   (indexed Bool)
   (arguments (Vec QueryTerm))
   (subst Substitution)]
  text-search/TextSearchRowsResult
  (let [relation (virtualcandidatesource-relation candidate)
        source (virtualcandidatesource-source candidate)
        needle (bound-term-value (nth arguments 2) subst)]
    (cond
      [(= relation text-match-relation)
       (if indexed
         (text-search/exact-indexed-rows-result! source needle)
         (text-search/exact-scan-rows-result! source needle))]
      [(= relation text-phrase-relation)
       (if indexed
         (text-search/phrase-indexed-rows-result! source needle)
         (text-search/phrase-scan-rows-result! source needle))]
      [(= relation text-substring-relation)
       (if indexed
         (text-search/substring-indexed-rows-result! source needle)
         (text-search/substring-scan-rows-result! source needle))]
      [(= relation text-stem-relation)
       (if indexed
         (text-search/stem-indexed-rows-result! source needle)
         (text-search/stem-scan-rows-result! source needle))]
      [(= relation text-search-relation)
       (if indexed
         (text-search/ranked-indexed-rows-result! source needle)
         (text-search/ranked-scan-rows-result! source needle))]
      [:else (missing-candidate-source-result relation)])))

(defn- text-rows-or-record!
  [(result text-search/TextSearchRowsResult)
   (context QueryEvaluationContext)]
  (Vec Tuple)
  (if (text-search/rows-result-ok? result)
    (text-search/rows-result-rows result)
    (do
      (record-query-evaluation-error!
       context
       (query-evaluation-error-from-text-error
        (text-search/rows-result-error result)))
      [])))

(defn- virtual-source-rows!
  [(candidate VirtualCandidateSource)
   (indexed Bool)
   (arguments (Vec QueryTerm))
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Tuple)
  (text-rows-or-record!
   (virtual-source-rows-result! candidate indexed arguments subst)
   context))

(defn- relation-results!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (let [relation (literal-relation literal)
        arguments (literal-arguments literal)
        source (get sources relation)]
    (if (literal-negated literal)
      (if (contains? (get db relation #{}) (ground arguments subst)) [] [subst])
      (cond
        [(instance? VirtualCandidateSource source)
         (unify-tuples! arguments
                        (virtual-source-rows!
                         source false arguments subst context)
                        subst context)]
        [(and (contains? text-relations relation) (nil? source))
         (text-rows-or-record!
          (missing-candidate-source-result relation) context)]
        [:else
         (unify-tuples! arguments (vec (get db relation #{})) subst context)]))))

(defn- literal-results!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (if (query-check! context)
    (cond
      [(= :relation (literal-kind literal))
       (relation-results! db sources literal subst context)]
      [(= :comparison (literal-kind literal))
       (if (comparison-result literal subst) [subst] [])]
      [(= :builtin (literal-kind literal)) (builtin-results literal subst)]
      [:else []])
    []))

(defn- literal-substitutions!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (substitutions (Vec Substitution))
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(remaining (Vec Substitution)) substitutions (results (Vec Substitution)) []]
    (if (or (empty? remaining)
            (not (query-evaluation-context-open? context)))
      (if (query-evaluation-context-open? context) results [])
      (let [matches
            (literal-results!
             db sources literal (first remaining) context)]
        (if (query-evaluation-context-open? context)
          (recur (rest remaining) (into results matches))
          [])))))

(defn- body-results!
  [(db Db)
   (sources CandidateSources)
   (body (Vec Literal))
   (seed Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(remaining (Vec Literal)) body (substitutions (Vec Substitution)) [seed]]
    (cond
      [(not (query-evaluation-context-open? context)) []]
      [(empty? remaining) substitutions]
      [(empty? substitutions) []]
      [:else
       (recur
        (rest remaining)
        (literal-substitutions!
         db sources (first remaining) substitutions context))])))

(defn- derive-rule!
  [(db Db)
   (sources CandidateSources)
   (value Rule)
   (context QueryEvaluationContext)]
  (Set Tuple)
  (let [substitutions
        (body-results! db sources (rule-body value) {} context)]
    (if (query-evaluation-context-open? context)
      (reduce (fn [(acc (Set Tuple)) (subst Substitution)] (Set Tuple)
                (conj acc (ground (rule-head-arguments value) subst)))
              #{} substitutions)
      #{})))

(defn- rule-head-relations [(rules (Vec Rule))] (Vec String)
  (vec (reduce (fn [(acc (Set String)) (value Rule)] (Set String)
                 (conj acc (rule-head-relation value)))
               #{} rules)))

(defn- append-handle [(index HandleBucket) (key Any) (handle Int)] HandleBucket
  (update index key
          (fn [(current (U (Vec Int) Nil))] (Vec Int)
            (if (nil? current)
              [handle]
              (conj current handle)))))

(defn- add-position-handles
  [(index PositionIndex) (tuple Tuple) (handle Int)] PositionIndex
  (loop [position 0 current index]
    (if (>= position (count tuple))
      current
      (let [bucket (get current position {})]
        (recur (inc position)
               (assoc current position
                      (append-handle bucket (nth tuple position) handle)))))))

(defn- trie-add
  [(trie HandleTrie) (tuple Tuple) (order (Vec Int)) (handle Int)] HandleTrie
  (let [(first-key Any) (nth tuple (nth order 0))
        (second-key Any) (nth tuple (nth order 1))
        (third-key Any) (nth tuple (nth order 2))
        (first-node HandleTrieBranch) (get trie first-key {})
        (second-node HandleTrieLeaf) (get first-node second-key {})
        (leaf (Vec Int)) (get second-node third-key [])]
    (assoc trie first-key
           (assoc first-node second-key
                  (assoc second-node third-key (conj leaf handle))))))

(defn- add-handle-values [(handles (Set Int)) (values (Vec Int))] (Set Int)
  (reduce (fn [(current (Set Int)) (handle Int)] (Set Int)
            (conj current handle))
          handles values))

(defn- ordered-handles [(handles (Set Int))] (Vec Int)
  (sort (vec handles)))

(defn- trie-leaf-handles [(node HandleTrieLeaf)] (Vec Int)
  (ordered-handles
   (reduce-kv (fn [(handles (Set Int)) (key Any) (child (Vec Int))] (Set Int)
                (add-handle-values handles child))
              #{} node)))

(defn- trie-branch-handles [(node HandleTrieBranch)] (Vec Int)
  (ordered-handles
   (reduce-kv (fn
                [(handles (Set Int)) (key Any) (child HandleTrieLeaf)] (Set Int)
                (add-handle-values handles (trie-leaf-handles child)))
              #{} node)))

(defn- trie-node-handles [(node HandleTrie)] (Vec Int)
  (ordered-handles
   (reduce-kv (fn
                [(handles (Set Int))
                 (key Any)
                 (child HandleTrieBranch)]
                (Set Int)
                (add-handle-values handles (trie-branch-handles child)))
              #{} node)))

(defn- trie-probe [(trie HandleTrie) (prefix (Vec Any))] (Vec Int)
  (let [depth (count prefix)]
    (cond
      [(= 0 depth) (trie-node-handles trie)]
      [(> depth 3) []]
      [:else
       (let [(first-node (U HandleTrieBranch Nil))
             (get trie (nth prefix 0))]
         (if (nil? first-node)
           []
           (if (= 1 depth)
             (trie-branch-handles first-node)
             (let [(second-node (U HandleTrieLeaf Nil))
                   (get first-node (nth prefix 1))]
               (if (nil? second-node)
                 []
                 (if (= 2 depth)
                   (trie-leaf-handles second-node)
                   (get second-node (nth prefix 2) [])))))))])))

(defn- empty-candidate-source [] CandidateSource
  (->CandidateSource [] {} {} {} {} nil nil))

(defn occurrence-candidate-source
  [(root t/TermStore)
   (lower-exclusive Int)
   (upper-inclusive Int)]
  CandidateSource
  (->CandidateSource [] {} {} {} {}
    (->OccurrenceCandidateSource
      root lower-exclusive upper-inclusive (store/operation-postings root))
    nil))

(defn rotation-candidate-source
  [(rotation rot/Rotation) (lower-exclusive Int)] CandidateSource
  (->CandidateSource [] {} {} {} {} nil
    (->RotationCandidateSource rotation lower-exclusive)))

;; Exclusive lower bound, matching store/operation-range-bounds exactly.
(defn- event-after-sequence?
  [(event t/OperationOccurrence) (lower-exclusive Int)] Bool
  (if (< lower-exclusive 0)
    true
    (let [(occurrence t/Triple) (t/operationoccurrence-coordinate event)]
      (if (t/occurrence-coordinate? occurrence)
        (let [(transaction t/Triple) (t/triple-t1 occurrence)
              (sequence Int) (t/triple-t3 transaction)]
          (> sequence lower-exclusive))
        false))))

;; Public because every candidate source built from a projected rotation has to
;; apply the same window: the rotation carries the upper snapshot only.
(defn events-after-sequence
  [(events (Vec t/OperationOccurrence))
   (lower-exclusive Int)]
  (Vec t/OperationOccurrence)
  (if (< lower-exclusive 0)
    events
    (filterv (fn [(event t/OperationOccurrence)] Bool
               (event-after-sequence? event lower-exclusive))
      events)))

(defn- candidate-source-add
  [(relation String) (source CandidateSource) (tuple Tuple)] CandidateSource
  (let [(handle Int) (count (candidatesource-rows source))
        (with-row CandidateSource)
        (assoc source :rows (conj (candidatesource-rows source) tuple))]
    (if (and (= relation triple-relation) (= 3 (count tuple)))
      (assoc with-row
             :spo (trie-add (candidatesource-spo source) tuple [0 1 2] handle)
             :pos (trie-add (candidatesource-pos source) tuple [1 2 0] handle)
             :osp (trie-add (candidatesource-osp source) tuple [2 0 1] handle))
      (assoc with-row
             :positions (add-position-handles
                         (candidatesource-positions source) tuple handle)))))

(defn- candidate-source-add-rows
  [(relation String)
   (source CandidateSource)
   (tuples (Set Tuple))]
  CandidateSource
  (reduce (fn [(current CandidateSource) (tuple Tuple)] CandidateSource
            (candidate-source-add relation current tuple))
          source tuples))

(defn withdrawal-candidate-source
  [(root t/TermStore)
   (lower-exclusive Int)
   (upper-inclusive Int)]
  CandidateSource
  (candidate-source-add-rows
   withdrawal-relation
   (empty-candidate-source)
   (set (store/withdrawal-tuples-between
         root lower-exclusive upper-inclusive))))

(defn- build-candidate-sources
  [(db Db) (relations (Vec String)) (seed CandidateSources)] CandidateSources
  (reduce (fn [(sources CandidateSources) (relation String)] CandidateSources
            (if (contains? sources relation)
              sources
              (assoc sources relation
                     (candidate-source-add-rows
                      relation (empty-candidate-source) (get db relation #{})))))
          seed relations))

(defn- add-delta-sources
  [(sources CandidateSources)
   (delta Db)
   (relations (Vec String))]
  CandidateSources
  (reduce (fn [(current CandidateSources) (relation String)] CandidateSources
            (let [(tuples (Set Tuple)) (get delta relation #{})
                  (existing Any) (get current relation)
                  (base CandidateSource)
                  (if (instance? CandidateSource existing)
                    existing
                    (empty-candidate-source))]
              (if (empty? tuples)
                current
                (assoc current relation
                       (candidate-source-add-rows
                        relation base tuples)))))
          sources relations))

(defn text-relation-needle-valid?! [(relation String) (needle Any)] Bool
  (cond
    [(= relation text-match-relation)
     (text-index/text-needle-valid?! needle)]
    [(or (= relation text-phrase-relation)
         (= relation text-stem-relation))
     (text-search/word-needle-valid? needle)]
    [(or (= relation text-substring-relation)
         (= relation text-search-relation))
     (text-search/substring-needle-valid? needle)]
    [:else false]))

;; Virtual relations register independently so adjacent candidate sources can
;; append without changing the physical relation index.
(defn text-candidate-sources
  [(source text-search/TextSearchSource)] CandidateSources
  {text-match-relation
   (->VirtualCandidateSource text-match-relation source)
   text-phrase-relation
   (->VirtualCandidateSource text-phrase-relation source)
   text-substring-relation
   (->VirtualCandidateSource text-substring-relation source)
   text-stem-relation
   (->VirtualCandidateSource text-stem-relation source)
   text-search-relation
   (->VirtualCandidateSource text-search-relation source)})

(defn build-text-candidates-result!
  [(propositions (Vec t/Triple))] CandidateSourcesResult
  (let [(result text-search/TextSearchSourceResult)
        (text-search/build-source-result!
         propositions text-index/text-index-max-bytes)
        (source text-search/TextSearchSource?) (text-search/source-result-source result)]
    (if (some? source)
      (->CandidateSourcesResult (text-candidate-sources source) nil)
      (->CandidateSourcesResult
       {}
       (query-evaluation-error-from-text-error
        (text-search/source-result-error result))))))

(defn build-text-candidates-for-attributes-result!
  [(propositions (Vec t/Triple)) (attributes (Set Any))] CandidateSourcesResult
  (let [(result text-search/TextSearchSourceResult)
        (text-search/build-source-for-attributes-result!
         propositions attributes text-index/text-index-max-bytes)
        (source text-search/TextSearchSource?)
        (text-search/source-result-source result)]
    (if (some? source)
      (->CandidateSourcesResult (text-candidate-sources source) nil)
      (->CandidateSourcesResult
       {}
       (query-evaluation-error-from-text-error
        (text-search/source-result-error result))))))

(defn build-text-candidates! [(propositions (Vec t/Triple))] CandidateSources
  (text-candidate-sources
   (text-search/build-source! propositions text-index/text-index-max-bytes)))

(defn- bound-prefix
  [(arguments (Vec QueryTerm)) (order (Vec Int)) (subst Substitution)] (Vec Any)
  (loop [(remaining (Vec Int)) order (prefix (Vec Any)) []]
    (if (empty? remaining)
      prefix
      (let [value (bound-term-value (nth arguments (first remaining)) subst)]
        (if (nil? value)
          prefix
          (recur (rest remaining) (conj prefix value)))))))

(defn- triple-prefix-handles
  [(source CandidateSource)
   (arguments (Vec QueryTerm))
   (subst Substitution)]
  (U (Vec Int) Nil)
  (let [spo-key (bound-prefix arguments [0 1 2] subst)
        pos-key (bound-prefix arguments [1 2 0] subst)
        osp-key (bound-prefix arguments [2 0 1] subst)
        spo-count (count spo-key)
        pos-count (count pos-key)
        osp-count (count osp-key)]
    (cond
      [(and (= 0 spo-count) (and (= 0 pos-count) (= 0 osp-count))) nil]
      [(and (>= spo-count pos-count) (>= spo-count osp-count))
       (trie-probe (candidatesource-spo source) spo-key)]
      [(>= pos-count osp-count)
       (trie-probe (candidatesource-pos source) pos-key)]
      [:else (trie-probe (candidatesource-osp source) osp-key)])))

(defn- positional-handles
  [(source CandidateSource)
   (arguments (Vec QueryTerm))
   (subst Substitution)]
  (U (Vec Int) Nil)
  (loop [(position Int) 0 (best (Vec Int)) [] (found Bool) false]
    (if (>= position (count arguments))
      (if found best nil)
      (let [value (bound-term-value (nth arguments position) subst)]
        (if (nil? value)
          (recur (inc position) best found)
          (let [(bucket HandleBucket)
                (get (candidatesource-positions source) position {})
                (candidate (Vec Int)) (get bucket value [])]
            (recur (inc position)
                   (if (or (not found) (< (count candidate) (count best)))
                     candidate best)
                   true)))))))

(defn- source-handles
  [(source CandidateSource)
   (relation String)
   (arguments (Vec QueryTerm))
   (subst Substitution)]
  (U (Vec Int) Nil)
  (let [occurrence (candidatesource-occurrence source)]
    (if (some? occurrence)
      (store/operation-candidate-positions
        (occurrencecandidatesource-root occurrence)
        (occurrencecandidatesource-lower-exclusive occurrence)
        (occurrencecandidatesource-upper-inclusive occurrence)
        (bound-term-value (nth arguments 0) subst)
        (bound-term-value (nth arguments 2) subst)
        (occurrencecandidatesource-postings occurrence))
      (if (and (= relation triple-relation) (= 3 (count arguments)))
        (triple-prefix-handles source arguments subst)
        (positional-handles source arguments subst)))))

(defn- source-row [(source CandidateSource) (handle Int)] Tuple
  (let [occurrence (candidatesource-occurrence source)]
    (if (some? occurrence)
      (store/occurrence-tuple-at
        (occurrencecandidatesource-root occurrence) handle)
      (nth (candidatesource-rows source) handle))))

(defn- source-contains?
  [(source CandidateSource)
   (relation String)
   (arguments (Vec QueryTerm))
   (subst Substitution)]
  Bool
  (let [rotation (candidatesource-rotation source)]
    (if (some? rotation)
      (let [(wanted Tuple) (ground arguments subst)]
        (not
         (empty?
          (events-after-sequence
           (rot/matching (rotationcandidatesource-rotation rotation)
                         (nth wanted 0)
                         (nth wanted 1)
                         (nth wanted 2))
           (rotationcandidatesource-lower-exclusive rotation)))))
      (let [wanted (ground arguments subst)
            handles (source-handles source relation arguments subst)]
        (some? (some (fn [(handle Int)] Any
                       (when (= wanted (source-row source handle)) handle))
                     (or handles [])))))))

(defn- rotation-results-indexed!
  [(rotation RotationCandidateSource)
   (arguments (Vec QueryTerm))
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (let [(events (Vec t/OperationOccurrence))
        (events-after-sequence
         (rot/matching (rotationcandidatesource-rotation rotation)
                       (bound-term-value (nth arguments 0) subst)
                       (bound-term-value (nth arguments 1) subst)
                       (bound-term-value (nth arguments 2) subst))
         (rotationcandidatesource-lower-exclusive rotation))]
    (loop [(remaining (Vec t/OperationOccurrence)) events
           (seen (Set t/Triple)) #{}
           (results (Vec Substitution)) []]
      (if (or (empty? remaining)
              (not (query-evaluation-context-open? context)))
        results
        (let [(proposition t/Triple)
              (t/operationoccurrence-proposition (first remaining))]
          (if (contains? seen proposition)
            (recur (rest remaining) seen results)
            (let [matched
                  (unify-arguments-controlled!
                   arguments (triple-row proposition) subst context)]
              (if (query-evaluation-context-open? context)
                (recur (rest remaining)
                       (conj seen proposition)
                       (if (some? matched) (conj results matched) results))
                results))))))))

(defn- relation-results-indexed!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (let [(relation String) (literal-relation literal)
        (arguments (Vec QueryTerm)) (literal-arguments literal)
        (source (U CandidateSourceValue Nil))
        (get sources relation)]
    (if (literal-negated literal)
      (cond
        [(instance? CandidateSource source)
         (if (source-contains? source relation arguments subst) [] [subst])]
        [:else
         (if (contains? (get db relation #{}) (ground arguments subst))
           [] [subst])])
      (cond
        [(instance? VirtualCandidateSource source)
         (unify-tuples-controlled!
          arguments
          (virtual-source-rows! source true arguments subst context)
          subst context)]
        [(instance? CandidateSource source)
         (let [rotation (candidatesource-rotation source)]
           (if (some? rotation)
             (rotation-results-indexed! rotation arguments subst context)
             (let [rows-value (candidatesource-rows source)
                   handles (source-handles source relation arguments subst)]
               (if (nil? handles)
                 (unify-tuples-controlled! arguments rows-value subst context)
                 (loop [(remaining (Vec Int)) handles (results (Vec Substitution)) []]
                   (if (or (empty? remaining)
                           (not (query-evaluation-context-open? context)))
                     results
                     (let [tuple (source-row source (first remaining))
                           matched
                           (unify-arguments-controlled!
                            arguments tuple subst context)]
                       (if (query-evaluation-context-open? context)
                         (recur
                          (rest remaining)
                          (if (some? matched) (conj results matched) results))
                         results))))))))]
        [:else
         (if (contains? text-relations relation)
           (do
             (text-rows-or-record!
              (missing-candidate-source-result relation) context)
             (let [(missing (Vec Substitution)) []] missing))
           (unify-tuples-controlled!
            arguments (vec (get db relation #{})) subst context))]))))

(defn- literal-results-indexed!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (subst Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (if (query-check! context)
    (cond
      [(= :relation (literal-kind literal))
       (relation-results-indexed! db sources literal subst context)]
      [(= :comparison (literal-kind literal))
       (if (comparison-result literal subst) [subst] [])]
      [(= :builtin (literal-kind literal)) (builtin-results literal subst)]
      [:else []])
    []))

(defn- literal-substitutions-indexed!
  [(db Db)
   (sources CandidateSources)
   (literal Literal)
   (substitutions (Vec Substitution))
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(remaining (Vec Substitution)) substitutions (results (Vec Substitution)) []]
    (if (or (empty? remaining)
            (not (query-evaluation-context-open? context)))
      (if (query-evaluation-context-open? context) results [])
      (let [matches
            (literal-results-indexed!
             db sources literal (first remaining) context)]
        (if (query-evaluation-context-open? context)
          (recur (rest remaining) (into results matches))
          [])))))

(defn- body-results-indexed!
  [(db Db)
   (sources CandidateSources)
   (body (Vec Literal))
   (seed Substitution)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(remaining (Vec Literal)) body (substitutions (Vec Substitution)) [seed]]
    (cond
      [(not (query-evaluation-context-open? context)) []]
      [(empty? remaining) substitutions]
      [(empty? substitutions) []]
      [:else
       (recur
        (rest remaining)
        (literal-substitutions-indexed!
         db sources (first remaining) substitutions context))])))

(defn- derive-rule-indexed!
  [(db Db)
   (sources CandidateSources)
   (value Rule)
   (context QueryEvaluationContext)]
  (Set Tuple)
  (let [substitutions
        (body-results-indexed! db sources (rule-body value) {} context)]
    (if (query-evaluation-context-open? context)
      (reduce (fn [(acc (Set Tuple)) (subst Substitution)] (Set Tuple)
                (conj acc (ground (rule-head-arguments value) subst)))
              #{} substitutions)
      #{})))

(defn- delta-relation-positions
  [(body (Vec Literal)) (delta-relations (Set String))] (Vec Int)
  (loop [(position Int) 0 (remaining (Vec Literal)) body (positions (Vec Int)) []]
    (if (empty? remaining)
      positions
      (let [literal (first remaining)]
        (recur (inc position) (rest remaining)
               (if (and (= :relation (literal-kind literal))
                        (not (literal-negated literal))
                        (contains? delta-relations (literal-relation literal)))
                 (conj positions position)
                 positions))))))

(defn- positive-relation-names [(rules (Vec Rule))] (Vec String)
  (vec
   (sort
    (reduce
     (fn [(relations (Set String)) (value Rule)] (Set String)
       (reduce (fn [(current (Set String)) (literal Literal)] (Set String)
                 (if (and (= :relation (literal-kind literal))
                          (not (literal-negated literal)))
                   (conj current (literal-relation literal))
                   current))
               relations (rule-body value)))
     #{} rules))))

(defn- body-results-pinned!
  [(db Db)
   (sources CandidateSources)
   (delta Db)
   (delta-sources CandidateSources)
   (body (Vec Literal))
   (pin Int)
   (context QueryEvaluationContext)]
  (Vec Substitution)
  (loop [(position Int) 0 (remaining (Vec Literal)) body (substitutions (Vec Substitution)) [{}]]
    (if (or (empty? remaining)
            (not (query-evaluation-context-open? context)))
      (if (query-evaluation-context-open? context) substitutions [])
      (let [literal (first remaining)
            pinned (and (= position pin)
                        (= :relation (literal-kind literal))
                        (not (literal-negated literal)))
            read-db (if pinned delta db)
            read-sources (if pinned delta-sources sources)
            next-substitutions
            (literal-substitutions-indexed!
             read-db read-sources literal substitutions context)]
        (recur (inc position) (rest remaining) next-substitutions)))))

(defn- derive-rule-delta!
  [(db Db)
   (sources CandidateSources)
   (delta Db)
   (delta-sources CandidateSources)
   (delta-relations (Set String))
   (value Rule)
   (context QueryEvaluationContext)]
  (Set Tuple)
  (let [head (rule-head-arguments value)
        body (rule-body value)]
    (loop [(remaining (Vec Int)) (delta-relation-positions body delta-relations)
           (derived (Set Tuple)) #{}]
      (if (or (empty? remaining)
              (not (query-evaluation-context-open? context)))
        (if (query-evaluation-context-open? context) derived #{})
        (let [substitutions
              (body-results-pinned!
               db sources delta delta-sources body (first remaining) context)]
          (if (query-evaluation-context-open? context)
            (recur
             (rest remaining)
             (reduce (fn
                       [(current (Set Tuple)) (subst Substitution)] (Set Tuple)
                       (conj current (ground head subst)))
                     derived substitutions))
            #{}))))))

(defn- db-new-only [(candidate Db) (db Db) (relations (Vec String))] Db
  (reduce
   (fn [(delta Db) (relation String)] Db
     (let [new-tuples
           (reduce (fn [(rows-value (Set Tuple)) (tuple Tuple)] (Set Tuple)
                     (if (contains? (get db relation #{}) tuple)
                       rows-value
                       (conj rows-value tuple)))
                   #{} (get candidate relation #{}))]
       (if (empty? new-tuples) delta (assoc delta relation new-tuples))))
   {} relations))

(defn- db-merge-delta [(db Db) (delta Db) (relations (Vec String))] Db
  (reduce
   (fn [(current Db) (relation String)] Db
     (let [new-tuples (get delta relation #{})]
       (if (empty? new-tuples)
         current
         (update current relation
                 (fn [(known (U (Set Tuple) Nil))] (Set Tuple)
                   (reduce (fn
                             [(rows-value (Set Tuple))
                              (tuple Tuple)]
                             (Set Tuple)
                             (conj rows-value tuple))
                           (or known #{}) new-tuples))))))
   db relations))

(defn- delta-empty? [(delta Db) (relations (Vec String))] Bool
  (loop [remaining relations]
    (if (empty? remaining)
      true
      (if (empty? (get delta (first remaining) #{}))
        (recur (rest remaining))
        false))))

(defn- derive-delta!
  [(db Db)
   (sources CandidateSources)
   (delta Db)
   (rules (Vec Rule))
   (relations (Vec String))
   (delta-relations (Vec String))
   (context QueryEvaluationContext)]
  Db
  (let [delta-set (set delta-relations)
        delta-sources (build-candidate-sources delta delta-relations {})
        candidate
        (loop [(remaining (Vec Rule)) rules (current Db) {}]
          (if (or (empty? remaining)
                  (not (query-evaluation-context-open? context)))
            current
            (let [value (first remaining)
                  relation (rule-head-relation value)
                  derived
                  (derive-rule-delta!
                   db sources delta delta-sources delta-set value context)]
              (if (query-evaluation-context-open? context)
                (recur
                 (rest remaining)
                 (update current relation
                         (fn [(known (U (Set Tuple) Nil))] (Set Tuple)
                           (reduce (fn
                                     [(rows-value (Set Tuple))
                                      (tuple Tuple)]
                                     (Set Tuple)
                                     (conj rows-value tuple))
                                   (or known #{}) derived))))
                current))))]
    (if (query-evaluation-context-open? context)
      (db-new-only candidate db relations)
      {})))

(defn- fixpoint-with-candidates-context!
  [(db0 Db)
   (rules (Vec Rule))
   (candidates CandidateSources)
   (context QueryEvaluationContext)]
  Db
  (let [relations (rule-head-relations rules)
        read-relations (positive-relation-names rules)
        head-set (set relations)
        delta-relations
        (vec (filter (fn [(relation String)] Bool
                       (contains? head-set relation))
                     read-relations))
        initial-sources (build-candidate-sources db0 read-relations candidates)
        seeded
        (loop [remaining rules current db0]
          (if (or (empty? remaining)
                  (not (query-evaluation-context-open? context)))
            current
            (let [value (first remaining)
                  relation (rule-head-relation value)
                  derived
                  (derive-rule-indexed! db0 initial-sources value context)]
              (if (query-evaluation-context-open? context)
                (recur
                 (rest remaining)
                 (update current relation
                         (fn [(known (U (Set Tuple) Nil))] (Set Tuple)
                           (reduce (fn
                                     [(rows-value (Set Tuple))
                                      (tuple Tuple)]
                                     (Set Tuple)
                                     (conj rows-value tuple))
                                   (or known #{}) derived))))
                current))))]
    (if (not (query-evaluation-context-open? context))
      seeded
      (let [delta0 (db-new-only seeded db0 relations)
            seeded-sources
            (add-delta-sources initial-sources delta0 read-relations)]
        (loop [db seeded sources seeded-sources delta delta0]
          (cond
            [(not (query-evaluation-context-open? context)) db]
            [(delta-empty? delta delta-relations) db]
            [:else
             (let [next-delta
                   (derive-delta!
                    db sources delta rules relations delta-relations context)]
               (if (query-evaluation-context-open? context)
                 (recur (db-merge-delta db next-delta relations)
                        (add-delta-sources sources next-delta read-relations)
                        next-delta)
                 db))]))))))

(defn fixpoint-with-candidates-result!
  [(db0 Db)
   (rules (Vec Rule))
   (candidates CandidateSources)
   (control QueryControl?)]
  QueryEvaluationResult
  (let [context (new-query-evaluation-context control)
        db (fixpoint-with-candidates-context! db0 rules candidates context)]
    (->QueryEvaluationResult db (query-evaluation-context-error context))))

(defn fixpoint-with-candidates-controlled!
  [(db0 Db)
   (rules (Vec Rule))
   (candidates CandidateSources)
   (control QueryControl?)]
  Db
  (query-evaluation-db-or-throw!
   (fixpoint-with-candidates-result! db0 rules candidates control)))

(defn fixpoint-with-candidates!
  [(db0 Db) (rules (Vec Rule)) (candidates CandidateSources)] Db
  (fixpoint-with-candidates-controlled!
   db0 rules candidates *query-control*))

(defn fixpoint! [(db0 Db) (rules (Vec Rule))] Db
  (fixpoint-with-candidates! db0 rules {}))

(defn fixpoint-sourced!
  [(db0 Db) (registered CandidateSources) (rules (Vec Rule))] Db
  (fixpoint-with-candidates! db0 rules registered))

(defn run-rules! [(propositions (Vec t/Triple)) (rules (Vec Rule))] Db
  (fixpoint! (edb propositions) rules))

(defn run-strata-db-with-candidates-result!
  [(db0 Db)
   (strata (Vec (Vec Rule)))
   (candidates CandidateSources)
   (control QueryControl?)]
  QueryEvaluationResult
  (let [context (new-query-evaluation-context control)]
    (loop [remaining strata db db0]
      (if (or (empty? remaining)
              (not (query-evaluation-context-open? context)))
        (->QueryEvaluationResult
         db (query-evaluation-context-error context))
        (recur
         (rest remaining)
         (fixpoint-with-candidates-context!
          db (first remaining) candidates context))))))

(defn run-strata-db-with-candidates-controlled!
  [(db0 Db)
   (strata (Vec (Vec Rule)))
   (candidates CandidateSources)
   (control QueryControl?)]
  Db
  (query-evaluation-db-or-throw!
   (run-strata-db-with-candidates-result!
    db0 strata candidates control)))

(defn run-strata-db-with-candidates!
  [(db0 Db) (strata (Vec (Vec Rule))) (candidates CandidateSources)] Db
  (run-strata-db-with-candidates-controlled!
   db0 strata candidates *query-control*))

(defn run-strata-db! [(db0 Db) (strata (Vec (Vec Rule)))] Db
  (run-strata-db-with-candidates! db0 strata {}))

(defn run-strata-db-sourced!
  [(db0 Db) (sources CandidateSources) (strata (Vec (Vec Rule)))] Db
  (run-strata-db-with-candidates! db0 strata sources))

(defn run-strata! [(propositions (Vec t/Triple)) (strata (Vec (Vec Rule)))] Db
  (run-strata-db! (edb propositions) strata))

(defn- negated-relations [(stratum (Vec Rule))] (Vec String)
  (reduce
   (fn [(acc (Vec String)) (value Rule)] (Vec String)
     (reduce (fn [(relations (Vec String)) (literal Literal)] (Vec String)
               (if (and (= :relation (literal-kind literal))
                        (literal-negated literal))
                 (conj relations (literal-relation literal))
                 relations))
             acc (rule-body value)))
   [] stratum))

(defn strata-violations [(strata (Vec (Vec Rule)))] (Vec String)
  (loop [(index Int) 0 (lower (Set String)) base-relations (problems (Vec String)) []]
    (if (>= index (count strata))
      problems
      (let [stratum (nth strata index)
            heads
            (reduce (fn [(acc (Set String)) (value Rule)] (Set String)
                      (conj acc (rule-head-relation value)))
                    #{} stratum)
            problems2
            (reduce
             (fn [(acc (Vec String)) (relation String)] (Vec String)
               (cond
                 [(contains? heads relation)
                  (conj acc (str "stratum " index ": negated '" relation
                                 "' is also derived in the same stratum"))]
                 [(not (contains? lower relation))
                  (conj acc (str "stratum " index ": negated '" relation
                                 "' is not a base or lower-stratum relation"))]
                 [:else acc]))
             problems (negated-relations stratum))]
        (recur (+ index 1)
               (reduce (fn [(acc (Set String)) (relation String)] (Set String)
                         (conj acc relation))
                       lower heads)
               problems2)))))

(defn facts [(db Db) (relation String)] (Vec Tuple)
  (vec (get db relation #{})))
