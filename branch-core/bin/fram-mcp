#!/usr/bin/env bash
# Fram MCP server — the AI-facing edge of one instance. Speaks MCP (JSON-RPC 2.0
# over stdio) and advertises exactly five public data tools: tell, retract, show,
# ask, and validate. Public calls use FRAMRPC; graph authoring is a separate
# sealed-control surface and is refused here.
# Point a model's MCP client at this command.
#
#   FRAM_SPACE_ID selects the database identity. FRAM_SERVER_PORT selects its server.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -z "${FRAM_SPACE_ID:-}" ]]; then
  echo "fram-mcp: FRAM_SPACE_ID is required" >&2
  exit 2
fi
cd "$HERE" && exec bb -cp out tests/fram_mcp.clj
