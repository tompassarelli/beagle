#!/usr/bin/env bash
# Fram server — the sole-writer multi-agent service. Production
# launches require a completed Beagle native artifact. The JVM remains available
# only through the explicitly selected oracle or checkout-development routes.
#   fram-server [serve] [port] [framlog] [space-id]   (mode defaults to serve)
#   FRAM_SERVER_RUNTIME=native       production runtime (default)
#   FRAM_NATIVE_ARTIFACT_DIR=<path>  READY native-build artifact directory;
#                                    a checkout builds its own when unset
#   FRAM_SERVER_RUNTIME=graal        transitional self-contained server
#   FRAM_GRAAL_ARTIFACT=<path>       absolute Graal server executable
#   FRAM_SERVER_RUNTIME=jvm-oracle   sealed Java/classpath differential oracle
#   FRAM_SERVER_RUNTIME=jvm-dev      checkout-only Clojure development runtime
#   FRAM_BIND=0.0.0.0          bind all interfaces (default loopback)
#   FRAM_SERVER_XMX=4g         JVM fallback max heap; empty disables the flag
#   FRAM_SERVER_G1_REGION=32m  JVM fallback G1 region size; empty disables it
#   FRAM_SERVER_LOG=<path>     request log file (default stderr)
#   FRAM_SERVER_QUIET=1        log only slow requests
#   FRAM_SLOW_MS=1000          slow-request threshold, always logged
#   TLS termination belongs at the authenticated gateway until the sealed native
#   TLS listener is restored; these public data sockets are plaintext/private.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# A numeric first arg keeps the convenient `fram-server [port] [log]` shape.
if [[ "${1:-}" == "serve" ]]; then shift; fi

if [[ -n "${2:-}" ]]; then
  log_path="$2"
elif [[ -n "${FRAM_LOG:-}" ]]; then
  log_path="$FRAM_LOG"
elif [[ "${FRAM_PACKAGED:-0}" == "1" ]]; then
  if [[ -n "${FRAM_STATE_DIR:-}" ]]; then
    state_dir="$FRAM_STATE_DIR"
  elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
    state_dir="$XDG_STATE_HOME/fram"
  elif [[ -n "${HOME:-}" ]]; then
    state_dir="$HOME/.local/state/fram"
  else
    echo "fram-server: pass a log path, or set FRAM_LOG, FRAM_STATE_DIR, XDG_STATE_HOME, or HOME" >&2
    exit 2
  fi
  log_path="$state_dir/history.framlog"
else
  log_path="$HERE/history.framlog"
fi
space_id="${3:-${FRAM_SPACE_ID:-}}"
if [[ ! -e "$log_path" && -z "$space_id" ]]; then
  echo "fram-server: FRAM_SPACE_ID (or the fourth argument) is required to create a FRAMLOG" >&2
  exit 2
fi

runtime="${FRAM_SERVER_RUNTIME:-native}"
case "$runtime" in
  native)
    artifact_dir="${FRAM_NATIVE_ARTIFACT_DIR:-}"
    # A checkout resolves its own artifact through the release gate, which is
    # content-addressed and returns the cached directory when one already
    # matches; a packaged tree carries no gate and must be told the path.
    if [[ -z "$artifact_dir" && -x "$HERE/bin/fram-native-build" &&
      -r "$HERE/native/core_closure_sources.txt" ]]; then
      closure_sources=()
      while IFS= read -r closure_source || [[ -n "$closure_source" ]]; do
        [[ -n "$closure_source" ]] || continue
        closure_sources+=("$HERE/$closure_source")
      done <"$HERE/native/core_closure_sources.txt"
      artifact_dir="$("$HERE/bin/fram-native-build" --host server \
        "${closure_sources[@]}")" || exit 2
    fi
    if [[ -z "$artifact_dir" ]]; then
      echo "fram-server: FRAM_NATIVE_ARTIFACT_DIR is required for FRAM_SERVER_RUNTIME=native" >&2
      exit 2
    fi
    case "$artifact_dir" in
      /*) ;;
      *)
        echo "fram-server: FRAM_NATIVE_ARTIFACT_DIR must be absolute: $artifact_dir" >&2
        exit 2
        ;;
    esac
    ready="$artifact_dir/READY"
    native_server="$artifact_dir/bin/fram-server-native"
    if [[ ! -r "$ready" ]]; then
      echo "fram-server: native artifact is not ready: missing $ready" >&2
      exit 2
    fi
    ready_line="$(<"$ready")"
    if [[ ! "$ready_line" =~ ^fram-native-build/v1\ [0-9a-f]{64}$ ]]; then
      echo "fram-server: native artifact READY marker is invalid: $ready" >&2
      exit 2
    fi
    if [[ ! -x "$native_server" ]]; then
      echo "fram-server: native artifact executable is unavailable: $native_server" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$log_path")"
    export FRAM_SERVER_PORT="${1:-7977}"
    export FRAM_LOG="$log_path"
    if [[ -n "$space_id" ]]; then export FRAM_SPACE_ID="$space_id"; fi
    cd "$HERE"
    exec "$native_server"
    ;;
  graal)
    graal_artifact="${FRAM_GRAAL_ARTIFACT:-}"
    if [[ -z "$graal_artifact" ]]; then
      echo "fram-server: FRAM_GRAAL_ARTIFACT is required for FRAM_SERVER_RUNTIME=graal" >&2
      exit 2
    fi
    case "$graal_artifact" in
      /*) ;;
      *)
        echo "fram-server: FRAM_GRAAL_ARTIFACT must be absolute: $graal_artifact" >&2
        exit 2
        ;;
    esac
    if [[ ! -x "$graal_artifact" ]]; then
      echo "fram-server: Graal server executable is unavailable: $graal_artifact" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$log_path")"
    graal_args=(serve "${1:-7977}" "$log_path")
    if [[ -n "$space_id" ]]; then graal_args+=("$space_id"); fi
    cd "$HERE"
    exec "$graal_artifact" "${graal_args[@]}"
    ;;
  jvm-oracle|jvm-dev) ;;
  *)
    echo "fram-server: unsupported FRAM_SERVER_RUNTIME '$runtime'; expected native, graal, jvm-oracle, or jvm-dev" >&2
    exit 2
    ;;
esac

mkdir -p "$(dirname "$log_path")"
server_args=(server.clj serve "${1:-7977}" "$log_path")
if [[ -n "$space_id" ]]; then server_args+=("$space_id"); fi

# Heap and G1 region size are bound together: shrinking the heap also shrinks the
# ergonomic region, which LOWERS the humongous-allocation threshold.
heap_flags=()
xmx="${FRAM_SERVER_XMX-4g}"
if [[ -n "$xmx" ]]; then heap_flags+=("-Xmx$xmx"); fi
g1_region="${FRAM_SERVER_G1_REGION-32m}"
if [[ -n "$g1_region" ]]; then
  heap_flags+=(-XX:+UseG1GC "-XX:G1HeapRegionSize=$g1_region")
fi
# A capped heap must die loudly, not thrash: the supervisor restarts it and
# the dump names the culprit. FRAM_SERVER_NO_OOM_EXIT=1 opts out.
if [[ -z "${FRAM_SERVER_NO_OOM_EXIT:-}" && -n "$xmx" ]]; then
  oom_dump="${FRAM_SERVER_LOG:+$FRAM_SERVER_LOG.heap.hprof}"
  heap_flags+=(-XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError
    "-XX:HeapDumpPath=${oom_dump:-/tmp/fram-server-oom.hprof}")
fi

if [[ "$runtime" == "jvm-oracle" ]]; then
  if [[ -z "${FRAM_JAVA:-}" || -z "${FRAM_SERVER_CLASSPATH_FILE:-}" ]]; then
    echo "fram-server: FRAM_SERVER_RUNTIME=jvm-oracle requires FRAM_JAVA and FRAM_SERVER_CLASSPATH_FILE" >&2
    exit 2
  fi
  if [[ ! -x "$FRAM_JAVA" ]]; then
    echo "fram-server: FRAM_JAVA is not executable: $FRAM_JAVA" >&2
    exit 2
  fi
  if [[ ! -r "$FRAM_SERVER_CLASSPATH_FILE" ]]; then
    echo "fram-server: classpath file is not readable: $FRAM_SERVER_CLASSPATH_FILE" >&2
    exit 2
  fi
  server_classpath="$(<"$FRAM_SERVER_CLASSPATH_FILE")"
  if [[ -z "$server_classpath" ]]; then
    echo "fram-server: packaged classpath is empty" >&2
    exit 2
  fi
  cd "$HERE"
  jvm_args=("${heap_flags[@]}")
  if [[ -n "${FRAM_LISTEN_FD:-}" ]]; then
    jvm_args+=(
      --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
      --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
    )
  fi
  exec "$FRAM_JAVA" "${jvm_args[@]}" -cp "$server_classpath" clojure.main \
    "${server_args[@]}"
fi

if [[ "${FRAM_PACKAGED:-0}" == "1" ]]; then
  echo "fram-server: FRAM_SERVER_RUNTIME=jvm-dev is checkout-only" >&2
  exit 2
fi
if [[ -n "${FRAM_JAVA:-}" || -n "${FRAM_SERVER_CLASSPATH_FILE:-}" ]]; then
  echo "fram-server: FRAM_SERVER_RUNTIME=jvm-dev rejects packaged Java/classpath bindings" >&2
  exit 2
fi
if ! command -v clojure >/dev/null 2>&1; then
  echo "fram-server: FRAM_SERVER_RUNTIME=jvm-dev requires clojure on PATH" >&2
  exit 2
fi
cd "$HERE"
clojure_jvm_args=()
for flag in "${heap_flags[@]}"; do clojure_jvm_args+=("-J$flag"); done
if [[ -n "${FRAM_LISTEN_FD:-}" ]]; then
  clojure_jvm_args+=(
    -J--add-exports=java.base/sun.nio.ch=ALL-UNNAMED
    -J--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
  )
fi
exec clojure "${clojure_jvm_args[@]}" -M "${server_args[@]}"
