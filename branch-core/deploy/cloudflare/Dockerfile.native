# The Fram server deployment image. Its build context is one READY
# fram-native-build artifact directory, never the Fram checkout:
#   bin/fram-cloudflare-native-image --artifact /abs/<closure-hash> --tag fram-native

FROM alpine:3.22 AS verify

ARG FRAM_NATIVE_ARTIFACT_HASH
COPY READY /fram-artifact/READY
COPY bin/fram-server-native /fram-artifact/fram-server-native

RUN test "$FRAM_NATIVE_ARTIFACT_HASH" != "" \
    && test "$(cat /fram-artifact/READY)" = "fram-native-build/v1 $FRAM_NATIVE_ARTIFACT_HASH" \
    && test -x /fram-artifact/fram-server-native

# scratch has no passwd db, so /data ownership must be baked in from a stage that has `install`.
RUN install -d -o 65534 -g 65534 /fram-data-init

FROM scratch

ARG FRAM_NATIVE_ARTIFACT_HASH
LABEL org.fram.native-artifact="$FRAM_NATIVE_ARTIFACT_HASH"
COPY --from=verify /fram-artifact/READY /usr/local/share/fram/READY
COPY --from=verify /fram-artifact/fram-server-native /usr/local/bin/fram-server-native
COPY --from=verify --chown=65534:65534 /fram-data-init /data

# Loopback inside the container netns is unreachable through -p; docker
# networking owns publication.
ENV FRAM_SERVER_PORT=7977 \
    FRAM_LOG=/data/history.framlog \
    FRAM_SPACE_ID=cloudflare \
    FRAM_BIND=0.0.0.0

VOLUME /data
EXPOSE 7977
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/fram-server-native"]
CMD ["serve", "7977", "/data/history.framlog"]
