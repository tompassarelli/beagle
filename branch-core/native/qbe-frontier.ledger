# RATCHET — the QBE frontier. Shrink-only and two-sided: an unrecorded refusal
# fails, a recorded refusal that no longer reproduces fails until deleted. See
# bin/fram-native-build for the gate, the schema, and --regen-qbe-frontier.
#
# scope<TAB>class<TAB>detail. QBE reports one refusal per program, so a scope
# carries at most one line; resolving it reveals the next front.
#
fram.store/known-term-handle+fram.store/new-term-store+fram.store/term-count	unsupported-value-semantics	hash
fram.store/term-count	shape-outside-slice	-
fram-native-server	clock-extern	-
# The wasm32 line is the profile boundary itself, not a slice gap: QBE
# materializes lp64 only and refuses any other profile by name.
fram-native-server@wasm32	abi-profile	wasm32
