#lang beagle/clj

;; ============================================================================
;; Codegraph — code-as-facts on Fram.
;; ============================================================================
;; Loads a beagle source tree (already projected to CNF fact triples by
;; `beagle-facts`) into a Fram fact store, derives the NAMESPACE-CORRECT
;; function call graph, and runs two benchmarks that validate-or-kill the bet:
;;
;;   A. caller precision on name collisions   (graph resolves scope; bare-symbol can't)
;;   B. transitive leverage / blast radius     (one fixpoint; a one-hop tool can't)
;;
;; Run:  bb -cp ~/code/fram/out:~/code/fram/codegraph/src:~/code/fram -m codegraph build/gjoa.facts
;; ============================================================================
(ns codegraph)

(require fram.store :as c)

(require fram.datalog :as d)

(require fram.types :as t)

(require callgraph :as cg)

(require clojure.string :as str)

(defrecord Row
  [(name String)
   (file String)
   (graph-p Double)
   (incumbent-p Double)
   (gn Int)
   (in Int)])

;; ---- fact parsing + the scope-correct call graph: RENTED from callgraph.clj ----
;; parse-corpus! / derive-block / build-graph live there ONCE (the shared Layer-2
;; engine); this harness and beagle's CLI both rent it. build-graph returns
;; {:defns :by-name :edges} — untyped Clojure maps, hence the (Map Keyword Any)
;; boundary here. Below: the in-process closure that is the truth oracle for the
;; Fram Datalog closure.
(defn rev-adj [(edges (Vec (Vec (Vec Any))))] (Map (Vec Any) (Set (Vec Any)))
  (reduce (fn
            [(m (Map (Vec Any) (Set (Vec Any))))
             (e (Vec (Vec Any)))]
            (Map (Vec Any) (Set (Vec Any)))
            (let [a (nth e 0) b (nth e 1)] (assoc m b (conj (get m b #{}) a))))
    {}
    edges))

(defn fwd-adj [(edges (Vec (Vec (Vec Any))))] (Map (Vec Any) (Set (Vec Any)))
  (reduce (fn
            [(m (Map (Vec Any) (Set (Vec Any))))
             (e (Vec (Vec Any)))]
            (Map (Vec Any) (Set (Vec Any)))
            (let [a (nth e 0) b (nth e 1)] (assoc m a (conj (get m a #{}) b))))
    {}
    edges))

(defn transitive
  [(adj (Map (Vec Any) (Set (Vec Any)))) (n (Vec Any))] (Set (Vec Any))
  (loop [(seen (Set (Vec Any))) #{} (frontier (Vec (Vec Any))) (vec (get adj n #{}))]
    (if (empty? frontier)
      seen
      (let [x (peek frontier) fr (pop frontier)]
        (if (contains? seen x)
          (recur seen fr)
          (recur (conj seen x) (into fr (get adj x #{}))))))))

;; ---- stats helpers ----------------------------------------------------------
(defn avg-ranks [(v (Vec Double))] (Vec Double)
  (let [idx (vec (map-indexed (fn [(i Int) (x Double)] (Vec Any) [i x]) v)) sorted (vec (sort-by (fn
                                                                                                   [(p (Vec Any))]
                                                                                                   Any
                                                                                                   (nth p 1)) idx)) groups (vec (partition-by (fn
                                                                                                                                                [(p (Vec Any))]
                                                                                                                                                Any
                                                                                                                                                (nth p 1)) sorted)) acc (loop [(gs (Vec (Vec (Vec Any)))) groups (start Int) 1 (acc (Map Any Double)) {}] (if (empty? gs) acc (let [g (vec (nth gs 0)) n (count g) r (/ (+ (* 2.0 start) (dec n)) 2.0)] (recur (vec (rest gs)) (+ start n) (reduce (fn
                                                                                                                                                                                                                                                                                                                                                                                                     [(a (Map Any Double))
                                                                                                                                                                                                                                                                                                                                                                                                      (p (Vec Any))]
                                                                                                                                                                                                                                                                                                                                                                                                     (Map Any Double)
                                                                                                                                                                                                                                                                                                                                                                                                     (assoc a (nth p 0) r)) acc g)))))]
    (mapv (fn [(i Int)] Double (get acc i 0.0)) (vec (range (count v))))))

(defn pearson [(xs (Vec Double)) (ys (Vec Double))] Double
  (let [n (count xs) mx (/ (reduce + xs) n) my (/ (reduce + ys) n) cov (reduce + (mapv (fn
                                                                                         [(i Int)]
                                                                                         Double
                                                                                         (* (- (nth xs i) mx) (- (nth ys i) my))) (vec (range n)))) sx (Math/sqrt (reduce + (mapv (fn
                                                                                                                                                                                    [(x Double)]
                                                                                                                                                                                    Double
                                                                                                                                                                                    (let [dd (- x mx)] (* dd dd))) xs))) sy (Math/sqrt (reduce + (mapv (fn
                                                                                                                                                                                                                                                         [(y Double)]
                                                                                                                                                                                                                                                         Double
                                                                                                                                                                                                                                                         (let [dd (- y my)] (* dd dd))) ys)))]
    (if (or (zero? sx) (zero? sy)) 0.0 (/ cov (* sx sy)))))

(defn spearman [(xs (Vec Double)) (ys (Vec Double))] Double
  (pearson (avg-ranks xs) (avg-ranks ys)))

(defn fmt3 [(x Double)] String (format "%.3f" (double x)))

(defn short-file [(k (Vec Any))] String
  (str/replace (str (nth k 0)) (re-pattern ".*/gjoa/") ""))

(defn defn-keys-of [(defns (Vec (Map Keyword Any)))] (Vec (Vec Any))
  (mapv (fn [(dd (Map Keyword Any))] (Vec Any) (get dd :key)) defns))

(defn count-adj
  [(defn-keys (Vec (Vec Any)))
   (adj (Map (Vec Any) (Set (Vec Any))))]
  (Map (Vec Any) Int)
  (reduce (fn [(m (Map (Vec Any) Int)) (k (Vec Any))] (Map (Vec Any) Int) (assoc m k (count (get adj k #{}))))
    {}
    defn-keys))

(defn count-transitive
  [(defn-keys (Vec (Vec Any)))
   (adj (Map (Vec Any) (Set (Vec Any))))]
  (Map (Vec Any) Int)
  (reduce (fn [(m (Map (Vec Any) Int)) (k (Vec Any))] (Map (Vec Any) Int) (assoc m k (count (transitive adj k))))
    {}
    defn-keys))

(defn name-of [(defns (Vec (Map Keyword Any))) (k (Vec Any))] String
  (let [hits (filterv (fn [(dd (Map Keyword Any))] Boolean (= (get dd :key) k)) defns)]
    (if (empty? hits) "" (str (get (nth hits 0) :name)))))

(defn collision-names
  [(by-name (Map String (Vec (Map Keyword Any))))] (Vec String)
  (vec (filterv (fn [(nm String)] Boolean (> (count (distinct (mapv (fn
                                                                      [(dd (Map Keyword Any))]
                                                                      Any
                                                                      (nth (get dd :key) 0)) (get by-name nm)))) 1)) (vec (sort (set (keys by-name)))))))

;; per target defn D: graph callers = the direct callers of D (all same-file);
;; the incumbent (bare symbol N) returns the callers of ANY defn named N.
(defn scored-rows
  [(by-name (Map String (Vec (Map Keyword Any))))
   (collisions (Vec String))
   (radj (Map (Vec Any) (Set (Vec Any))))]
  (Vec Row)
  (filterv (fn [(r Row)] Boolean (pos? (:gn r)))
    (vec (mapcat (fn [(nm String)] (Vec Row) (let [ds (get by-name nm) incumbent (reduce (fn
                                                                                           [(acc (Set (Vec Any)))
                                                                                            (dd (Map Keyword Any))]
                                                                                           (Set (Vec Any))
                                                                                           (into acc (get radj (get dd :key) #{}))) #{} ds)] (if (pos? (count incumbent)) (mapv (fn
                                                                                                                                                                                  [(dd (Map Keyword Any))]
                                                                                                                                                                                  Row
                                                                                                                                                                                  (let [g (get radj (get dd :key) #{})] (Row. nm (short-file (get dd :key)) 1.0 (/ (count g) (double (count incumbent))) (count g) (count incumbent)))) ds) []))) collisions))))

;; A defn key is a [file leaf] pair; "<file>#<leaf>" is its Term spelling, so the
;; edge proposition names the node directly and nothing has to be interned. The
;; spelling is only injective because leaf is an integer.
(defn node-term [(k (Vec Any))] String (str (nth k 0) "#" (nth k 1)))

(defn closure-line!
  [(edges (Vec (Vec (Vec Any))))
   (defn-keys (Vec (Vec Any)))
   (fadj (Map (Vec Any) (Set (Vec Any))))]
  Nil
  (let [ctx (c/new-term-store "codegraph")
        edge-pred "calls-defn"
        operations (mapv (fn [(e (Vec (Vec Any)))] Any
                           (c/assert-operation
                             (t/triple (node-term (nth e 0)) edge-pred (node-term (nth e 1)))))
                     edges)
        _load (when (pos? (count operations)) (c/commit-transaction! ctx operations))
        t0 (System/currentTimeMillis)
        db (d/run-rules! (c/live-propositions ctx)
             [(d/rule "reaches"
                [(d/variable "x") (d/variable "y")]
                [(d/relation-literal d/triple-relation
                   [(d/variable "x") (d/constant edge-pred) (d/variable "y")])])
              (d/rule "reaches"
                [(d/variable "x") (d/variable "z")]
                [(d/relation-literal d/triple-relation
                   [(d/variable "x") (d/constant edge-pred) (d/variable "y")])
                 (d/relation-literal "reaches"
                   [(d/variable "y") (d/variable "z")])])])
        dl-reaches (set (d/facts db "reaches"))
        t1 (System/currentTimeMillis)
        truth (reduce + (mapv (fn [(k (Vec Any))] Int (count (transitive fadj k))) defn-keys))]
    (println (str "\nFram Datalog transitive closure: " (count dl-reaches) " reaches-pairs in " (- t1 t0) " ms" "  (in-process closure: " truth " pairs — " (if (= (count dl-reaches) truth) "MATCH" "DIVERGE") ")"))))

;; MACRO delta = mean of per-target precision deltas (each collision target weighted
;; equally; a 2-way split floors incumbent P at 0.5).
;; MICRO delta = pooled across all scored call-sites: sum(in-scope callers) /
;; sum(incumbent-returned callers) — the standard size-weighted summary, so a
;; higher-arity collision counts for more than a per-name average admits.
;; A delta below +0.20 fails.
(defn bench-a!
  [(by-name (Map String (Vec (Map Keyword Any))))
   (radj (Map (Vec Any) (Set (Vec Any))))]
  Nil
  (println "\n================ BENCHMARK A — caller precision on collisions ================")
  (println "(oracle = module-local scope: a call binds the defn in its own file)")
  (let [collisions (collision-names by-name) rows (scored-rows by-name collisions radj) mean-delta (if (empty? rows) 0.0 (/ (reduce + (mapv (fn
                                                                                                                                              [(r Row)]
                                                                                                                                              Double
                                                                                                                                              (- (:graph-p r) (:incumbent-p r))) rows)) (count rows))) tot-g (reduce + (mapv (fn
                                                                                                                                                                                                                               [(r Row)]
                                                                                                                                                                                                                               Int
                                                                                                                                                                                                                               (:gn r)) rows)) tot-in (reduce + (mapv (fn
                                                                                                                                                                                                                                                                        [(r Row)]
                                                                                                                                                                                                                                                                        Int
                                                                                                                                                                                                                                                                        (:in r)) rows)) micro-incumbent-p (if (pos? tot-in) (/ tot-g (double tot-in)) 1.0) micro-delta (- 1.0 micro-incumbent-p) wrong (count (filterv (fn
                                                                                                                                                                                                                                                                                                                                                                                                                         [(r Row)]
                                                                                                                                                                                                                                                                                                                                                                                                                         Boolean
                                                                                                                                                                                                                                                                                                                                                                                                                         (< (:incumbent-p r) 1.0)) rows))]
    (println "collision names:"
      (count collisions)
      " scored targets:"
      (count rows))
    (doseq [r (vec (take 12 (sort-by (fn [(r Row)] Double (:incumbent-p r)) rows)))]
      (println (format "  %-18s %-22s graph P=%.2f  incumbent P=%.2f  (%d of %d callers are in-scope)" (:name r) (:file r) (:graph-p r) (:incumbent-p r) (:gn r) (:in r))))
    (println (format "graph is PERFECT on %d/%d targets; the bare-symbol incumbent is WRONG (P<1) on %d (%.0f%%)" (count rows) (count rows) wrong (* 100.0 (/ wrong (max 1 (count rows))))))
    (println "MACRO mean precision delta (graph - incumbent):"
      (fmt3 mean-delta))
    (println (format "MICRO pooled delta: %s  (incumbent P=%.3f over %d in-scope / %d returned call-sites)" (fmt3 micro-delta) micro-incumbent-p tot-g tot-in))
    (println "  [PASS >= +0.20 (documented kill line)]"
      (if (>= mean-delta 0.2) "✅" "—"))))

;; ---- BENCHMARK B: transitive leverage / keystones -----------------------------
(defn bench-b!
  [(defns (Vec (Map Keyword Any)))
   (defn-keys (Vec (Vec Any)))
   (direct (Map (Vec Any) Int))
   (blast (Map (Vec Any) Int))]
  Nil
  (println "\n================ BENCHMARK B — transitive leverage (keystones) ================")
  (let [called (filterv (fn [(k (Vec Any))] Boolean (pos? (get blast k 0))) defn-keys) xs (mapv (fn
                                                                                                  [(k (Vec Any))]
                                                                                                  Double
                                                                                                  (double (get direct k 0))) called) ys (mapv (fn
                                                                                                                                                [(k (Vec Any))]
                                                                                                                                                Double
                                                                                                                                                (double (get blast k 0))) called) rho (spearman xs ys) top-direct (set (vec (take 10 (sort-by (fn
                                                                                                                                                                                                                                                [(k (Vec Any))]
                                                                                                                                                                                                                                                Int
                                                                                                                                                                                                                                                (get direct k 0)) > defn-keys)))) top-blast (vec (take 5 (sort-by (fn
                                                                                                                                                                                                                                                                                                                    [(k (Vec Any))]
                                                                                                                                                                                                                                                                                                                    Int
                                                                                                                                                                                                                                                                                                                    (get blast k 0)) > defn-keys))) hidden (filterv (fn
                                                                                                                                                                                                                                                                                                                                                                      [(k (Vec Any))]
                                                                                                                                                                                                                                                                                                                                                                      Boolean
                                                                                                                                                                                                                                                                                                                                                                      (not (contains? top-direct k))) top-blast) ratio-3x (filterv (fn
                                                                                                                                                                                                                                                                                                                                                                                                                                     [(k (Vec Any))]
                                                                                                                                                                                                                                                                                                                                                                                                                                     Boolean
                                                                                                                                                                                                                                                                                                                                                                                                                                     (and (pos? (get direct k 0)) (>= (/ (get blast k 0) (double (get direct k 0))) 3))) defn-keys)]
    (println "called defns:" (count called) " (ranked)")
    (println "\nTOP 8 by transitive blast radius (transitive callers):")
    (doseq [k (vec (take 8 (sort-by (fn [(k (Vec Any))] Int (get blast k 0)) > defn-keys)))]
      (println (format "  blast=%-4d direct=%-3d  %s   %s" (get blast k 0) (get direct k 0) (name-of defns k) (short-file k))))
    (println "\nSpearman rho (direct-rank vs blast-rank):"
      (fmt3 rho)
      "  [PASS < 0.80 => closure reorders]"
      (if (< rho 0.8) "✅" "—"))
    (println "defns with blast/direct >= 3x:"
      (count ratio-3x)
      "  [PASS >= 15]"
      (if (>= (count ratio-3x) 15) "✅" "—"))
    (when (not (empty? hidden))
      (let [k (nth hidden 0)]
        (println (format "KEYSTONE HIDDEN BY ONE-HOP: %s (blast=%d, direct=%d) is top-5 transitive but NOT top-10 direct ✅" (name-of defns k) (get blast k 0) (get direct k 0)))))))

(defn -main [& args] Nil
  (let [corpus-path (if (empty? (vec args)) "build/gjoa.facts" (str (nth (vec args) 0))) blocks (cg/parse-corpus! corpus-path) graph (cg/build-graph blocks) defns (get graph :defns) by-name (get graph :by-name) edges (get graph :edges) radj (rev-adj edges) fadj (fwd-adj edges) defn-keys (defn-keys-of defns) direct (count-adj defn-keys radj) blast (count-transitive defn-keys radj)]
    (println "================ CODEGRAPH — code-as-facts on Fram =================")
    (println "corpus:" corpus-path)
    (println "files:"
      (count blocks)
      " defns:"
      (count defns)
      " resolved internal call-edges:"
      (count edges))
    (closure-line! edges defn-keys fadj)
    (bench-a! by-name radj)
    (bench-b! defns defn-keys direct blast)
    (println "\n====================================================================")))
