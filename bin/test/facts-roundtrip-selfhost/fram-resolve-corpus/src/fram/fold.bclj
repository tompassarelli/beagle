#lang beagle/clj
;; Pure projection of ordered transaction frames through the authoritative
;; recursive TermStore history.
(ns fram.fold)
(define-mode strict)
(require fram.store :as store)
(require fram.types :as t)

(defrecord Fold
  [(space-id String)
   (history (Vec t/Triple))
   (live-occurrences (Vec t/Triple))
   (live-propositions (Vec t/Triple))
   (version Int)
   (dump t/TermStoreDump)])

(defn transaction-frame
  [(sequence Int)
   (operations (Vec t/CommitOperation))] t/TransactionFrame
  (store/transaction-frame sequence operations))

(defn max-sequence [(frames (Vec t/TransactionFrame))] Int
  (reduce
   (fn [(maximum Int) (frame t/TransactionFrame)] Int
     (let [sequence (t/transactionframe-sequence frame)]
       (if (> sequence maximum) sequence maximum)))
   0
   frames))

(defn- project [(ctx (Atom t/TermStore))] Fold
  (->Fold (store/space-id ctx)
          (store/semantic-history ctx)
          (store/live-occurrences ctx)
          (store/live-propositions ctx)
          (store/current-sequence ctx)
          (store/dump-term-store ctx)))

(defn fold! [(space-id String) (frames (Vec t/TransactionFrame))] Fold
  (let [ctx (store/new-term-store space-id)]
    (doseq [frame frames] (store/replay-transaction! ctx frame))
    (project ctx)))

(defn refold! [(space-id String) (dump Any)] Fold
  (let [ctx (store/new-term-store space-id)]
    (store/load-term-store! ctx dump)
    (project ctx)))
