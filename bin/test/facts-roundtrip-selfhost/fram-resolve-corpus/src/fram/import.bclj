#lang beagle/clj
(ns fram.import
  "Import thread Markdown into occurrence-history transaction frames. A file
  is a block of `@subject predicate object` lines, then `---`, then a prose
  body. Every line is a projected Triple; host IO lives behind fram.rt
  externs.")
(define-mode strict)

(require fram.types :as t)
(require fram.store :as store)
(require fram.fold :as fold)
(require clojure.string :as str)
(require fram.rt)

(declare-extern fram.rt/slurp [String -> String])
(declare-extern fram.rt/list-md [String -> (Vec String)])
(declare-extern fram.rt/split-on [String String -> (Vec String)])
(declare-extern fram.rt/split-kv [String -> (Vec String)])
(declare-extern fram.rt/edn-unquote [String -> String])

(defrecord Doc [head: String body: String])

(defrecord PredicateRegistry
  [by-name: (Map String String)
   canonical: (Map String String)])

(def ref-predicates: (Vec String)
  ["depends_on" "part_of" "relates_to" "clarifies" "amends"])

;; Triple fields are recursive Terms in the kernel ABI. This projection accepts
;; only its documented string vocabulary and rejects any wider Term explicitly.
(defn- string-term [value: Any] -> String
  (if (string? value)
    value
    (throw (ex-info "thread projection requires string Triple terms"
                    {:type :invalid-thread-triple}))))

(defn- triple-left [value: t/Triple] -> String
  (string-term (t/triple-t1 value)))

(defn- triple-predicate [value: t/Triple] -> String
  (string-term (t/triple-t2 value)))

(defn- triple-right [value: t/Triple] -> String
  (string-term (t/triple-t3 value)))

(defn- split-doc [content: String] -> Doc
  (let [lines (fram.rt/split-on content "\n")
        n (count lines)]
    (loop [i 0]
      (cond
        [(>= i n) (->Doc content "")]
        [(= "---" (str/trim (nth lines i)))
         (->Doc (str/join "\n" (subvec (vec lines) 0 i))
                (str/join "\n" (subvec (vec lines) (+ i 1) n)))]
        [:else (recur (+ i 1))]))))

(defn- parse-obj [token: String] -> String
  (cond
    [(str/starts-with? token "@") token]
    [(str/starts-with? token "\"") (fram.rt/edn-unquote token)]
    [:else token]))

(defn- identity-predicate? [predicate: String] -> Bool
  (or (= predicate "predicate_name") (= predicate "predicate_alias")))

(defn- identity-triple? [value: t/Triple] -> Bool
  (identity-predicate? (triple-predicate value)))

(defn- bind-predicate-spelling
  [spellings: (Map String String)
   spelling: String
   identity: String] -> (Map String String)
  (let [prior: String? (get spellings spelling)]
    (if (and (some? prior) (not (= prior identity)))
      (throw (ex-info (str "predicate spelling collision: " spelling
                           " resolves to both " prior " and " identity)
                      {:predicate spelling :left prior :right identity}))
      (assoc spellings spelling identity))))

(defn- predicate-registry [triples: (Vec t/Triple)] -> PredicateRegistry
  (let [registry-triples: (Vec t/Triple) (filterv identity-triple? triples)
        canonical: (Map String String)
        (reduce
         (fn [names: (Map String String) value: t/Triple] -> (Map String String)
           (if (= "predicate_name" (triple-predicate value))
             (assoc names (triple-left value) (triple-right value))
             names))
         {}
         registry-triples)
        by-name: (Map String String)
        (reduce
         (fn
           [spellings: (Map String String)
            value: t/Triple] -> (Map String String)
           (bind-predicate-spelling spellings
                                    (triple-right value)
                                    (triple-left value)))
         {}
         registry-triples)]
    (->PredicateRegistry by-name canonical)))

(defn- strip-at [spelling: String] -> String
  (if (str/starts-with? spelling "@") (subs spelling 1) spelling))

(defn- predicate-id [registry: PredicateRegistry spelling: String] -> String
  (if (str/starts-with? spelling "@")
    spelling
    (let [identity: String?
          (get (predicateregistry-by-name registry) spelling)]
      (if (some? identity) identity (str "@" spelling)))))

(defn- predicate-name [registry: PredicateRegistry spelling: String] -> String
  (let [identity (predicate-id registry spelling)
        canonical: String?
        (get (predicateregistry-canonical registry) identity)]
    (if (some? canonical) canonical (strip-at identity))))

(defn- predicate-property-value
  [registry: PredicateRegistry
   triples: (Vec t/Triple)
   predicate: String
   property: String] -> String?
  (let [identity (predicate-id registry predicate)
        property-id (predicate-id registry property)]
    (reduce
     (fn [found: String? value: t/Triple] -> String?
       (if (and (= identity (predicate-id registry (triple-left value)))
                (= property-id
                   (predicate-id registry (triple-predicate value))))
         (triple-right value)
         found))
     nil
     triples)))

(defn- fallback-ref? [registry: PredicateRegistry predicate: String] -> Bool
  (let [identity (predicate-id registry predicate)]
    (loop [remaining ref-predicates]
      (if (empty? remaining)
        false
        (if (= identity (predicate-id registry (first remaining)))
          true
          (recur (rest remaining)))))))

(defn- value-kind-of
  [registry: PredicateRegistry
   triples: (Vec t/Triple)
   predicate: String] -> String
  (let [explicit: String?
        (predicate-property-value registry triples predicate "value_kind")]
    (if (some? explicit)
      explicit
      (if (fallback-ref? registry predicate) "ref" "literal"))))

(defn- normalize-predicate-triples [triples: (Vec t/Triple)] -> (Vec t/Triple)
  (let [registry (predicate-registry triples)
        normalized: (Vec t/Triple)
        (mapv
         (fn [value: t/Triple] -> t/Triple
           (let [predicate (predicate-name registry (triple-predicate value))
                 right (triple-right value)
                 normalized-right
                 (if (and (= "ref" (value-kind-of registry triples predicate))
                          (not (str/starts-with? right "@")))
                   (str "@" right)
                   right)]
             (t/triple (triple-left value) predicate normalized-right)))
         triples)]
    ;; Streaming consumers must see identity declarations before aliases are
    ;; used, even though the occurrence fold itself accepts either order.
    (vec (concat (filterv identity-triple? normalized)
                 (filterv (fn [value: t/Triple] -> Bool
                            (not (identity-triple? value)))
                          normalized)))))

(defn- warn [message: String] -> Nil
  (binding [*out* *err*] (println (str "WARN import: " message))))

(defn- file->triples [path: String content: String] -> (Vec t/Triple)
  (let [doc (split-doc content)
        lines (fram.rt/split-on (doc-head doc) "\n")
        n (count lines)
        subject-index
        (loop [i 0]
          (cond
            [(>= i n) -1]
            [(str/starts-with? (str/trim (nth lines i)) "@") i]
            [:else (recur (+ i 1))]))]
    (if (< subject-index 0)
      (do
        (if (str/blank? (doc-head doc))
          nil
          (warn (str path " — no @subject line found in head; dropping " n
                     " head line(s)")))
        [])
      (let [subject (str/trim (nth lines subject-index))
            triples: (Vec t/Triple)
            (loop [i (+ subject-index 1) acc: (Vec t/Triple) []]
              (if (>= i n)
                acc
                (let [line (str/trim (nth lines i))]
                  (if (str/blank? line)
                    (recur (+ i 1) acc)
                    (let [pair (fram.rt/split-kv line)]
                      (recur (+ i 1)
                             (conj acc
                                   (t/triple subject
                                             (nth pair 0)
                                             (parse-obj (nth pair 1))))))))))
            body (doc-body doc)]
        (if (str/blank? body)
          triples
          (conj triples (t/triple subject "body" body)))))))

(defn- safe-file->triples [path: String] -> (Vec t/Triple)
  (try
    (file->triples path (fram.rt/slurp path))
    (catch Exception error
      (warn (str path " — skipped (could not parse): " (.getMessage error)))
      [])))

(defn- number-frames [triples: (Vec t/Triple)] -> (Vec t/TransactionFrame)
  (loop [position 0 frames: (Vec t/TransactionFrame) []]
    (if (>= position (count triples))
      frames
      (recur (+ position 1)
             (conj frames
                   (fold/transaction-frame
                    (+ position 1)
                    [(store/assert-operation (nth triples position))]))))))

(defn load-corpus [threads-dir: String] -> (Vec t/TransactionFrame)
  (let [files (fram.rt/list-md threads-dir)
        triples: (Vec t/Triple)
        (reduce
         (fn [acc: (Vec t/Triple) path: String] -> (Vec t/Triple)
           (vec (concat acc (safe-file->triples path))))
         []
         files)]
    (number-frames (normalize-predicate-triples triples))))
