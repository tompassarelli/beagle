#lang beagle
(ns native.entry-projection)

(define-mode strict)

(def seed: Int 2)

(defrecord Box [value: Int])

(defn box-value [box: Box] -> Int
  (:value box))

(defn helper [] -> Int
  (box-value (->Box seed)))

(defn entry [] -> Int
  (helper))

(defn second [] -> Int
  (+ (helper) 1))

(defn unreachable [] -> Int
  ((fn [value: Int] -> Int value) 0))

(defn bad-entry [] -> Int
  (unreachable))

(defn- hidden [] -> Int 0)
