#lang beagle
(ns native.threading-entry)


(defn append-value
  [values (Vec Int)
   value Int] (Vec Int)
  (conj values value))

(defn entry [] Int
  (let [values (Vec Int) (-> [1]
            (append-value 2)
            (append-value 3))
        scalar Int (->> 4 (+ 5) (* 2))]
    (if (and (= values [1 2 3]) (= scalar 18)) 0 1)))
