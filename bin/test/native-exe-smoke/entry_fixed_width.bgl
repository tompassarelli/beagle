#lang beagle
(ns native.fixed-width-entry)


(defrecord PackedValue
  [coordinate I32
   revision U32
   phi I16
   material U8])

(defn keep-i32 [value I32] I32 value)

(defn keep-u32 [value U32] U32 value)

(defn keep-i16 [value I16] I16 value)

(defn keep-u8 [value U8] U8 value)

(defn layout-entry [] Int
  (let [packed PackedValue (->PackedValue (keep-i32 -42000) (keep-u32 4000000000)
          (keep-i16 -1234) (keep-u8 255))]
    (if (and (= packed packed)
             (= (:coordinate packed) -42000)
             (= (:revision packed) 4000000000)
             (= (:phi packed) -1234)
             (= (:material packed) 255))
      0
      1)))

(defn qbe-entry [] Int
  (if (and (= (keep-i32 -42000) -42000)
           (= (keep-u32 4000000000) 4000000000)
           (= (keep-i16 -1234) -1234)
           (= (keep-u8 255) 255))
    0
    1))
