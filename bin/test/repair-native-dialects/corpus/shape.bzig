#lang beagle/zig
(ns shape.zig)

;; Deliberate type error: non-exhaustive match (missing Triangle case). The
;; checker's fix-plan (category "non-exhaustive-match") is auto-applicable —
;; beagle-repair's resolver must locate this .bzig file back to apply the
;; ready-to-insert clause skeletons.
(defunion Shape Circle Square Triangle)

(defn area-hint [s: Shape] -> String
  (match s
    (Circle "round")
    (Square "boxy")))
