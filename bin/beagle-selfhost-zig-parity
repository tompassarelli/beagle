#!/usr/bin/env bash
# beagle-selfhost-zig-parity: drift gate between the two Zig implementations.
#
#   bin/beagle-selfhost-zig-parity [--ledger PATH] [--exemptions PATH] [--lab DIR]
#
# The Racket emitter (beagle-lib/private/emit-zig.rkt) is the canonical Zig
# backend; the self-host compiler (self-host/src/selfhost/) has none yet. Two
# implementations may coexist only under a mechanical gate, so every fixture
# with a committed Zig golden — plus the pointed-rejection corpus — is emitted
# down BOTH paths and compared byte-for-byte into parity-ledger.tsv.
#
# Exit 0 iff no mismatch and every unported fixture is listed in the exemption
# file; exit 1 on a parity failure (mismatch, unexempted unported row, or a
# stale exemption the port forgot to delete); exit 2 when the harness itself
# cannot run (missing tool, or an oracle that no longer reproduces its golden).
#
# The exemption file starts holding EVERY row: the gate is green-by-exemption
# on day one, and each port slice's done-bar is deleting its lines.
set -uo pipefail

WT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$WT"

LAB=".lab/selfhost-zig-parity"
LEDGER=""
EXEMPT="self-host/selfhost-zig-exemptions.txt"
while [ $# -gt 0 ]; do
  case "$1" in
    --ledger)     LEDGER="$2"; shift 2 ;;
    --exemptions) EXEMPT="$2"; shift 2 ;;
    --lab)        LAB="$2"; shift 2 ;;
    -h|--help)    sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "beagle-selfhost-zig-parity: unknown option '$1'" >&2; exit 2 ;;
  esac
done
[ -n "$LEDGER" ] || LEDGER="$LAB/parity-ledger.tsv"

FIXTURES="beagle-test/tests/fixtures"
ORACLE_SRC="beagle-lib/private/zig-parity-oracle.rkt"

die2() { echo "beagle-selfhost-zig-parity: $1" >&2; exit 2; }

[ -f "$ORACLE_SRC" ] || die2 "missing oracle $ORACLE_SRC"
[ -f bin/_beagle-racket ] || die2 "missing bin/_beagle-racket (no Racket oracle)"
# shellcheck source=/dev/null
source bin/_beagle-racket >/dev/null 2>&1 || die2 "bin/_beagle-racket failed"
[ -x "${RACKET:-}" ] || die2 "no pinned racket ($RACKET)"

source self-host/native/stage0-select.sh
beagle_select_stage0 self-host/seed self-host/native/beagle-selfhost || exit 2
if [ "$STAGE0" != native ]; then
  command -v bb >/dev/null 2>&1 || die2 "bb (babashka) not on PATH and no usable stage0 native"
fi
sh_main() { # selfhost CLI: <subcommand> [args...]
  if [ "$STAGE0" = native ]; then "$NATIVE_BIN" "$@"; else bb -cp self-host/seed -m selfhost.main "$@"; fi
}

rm -rf "${LAB:?}"
mkdir -p "$LAB/oracle" "$LAB/self" "$(dirname "$LEDGER")"

# --- corpus ------------------------------------------------------------------
# EMIT rows: every committed .zig golden under the fixtures tree that has a
# same-named Beagle source beside it. DIAG rows: the pointed-rejection corpus
# plus every semantic-contract source the Zig checker refuses (no .zig golden).
emit_ids=(); emit_srcs=(); emit_goldens=()
while IFS= read -r golden; do
  base="${golden%.zig}"; src=""
  for ext in bgl bclj; do [ -f "$base.$ext" ] && src="$base.$ext"; done
  [ -n "$src" ] || continue
  emit_ids+=("${base#$FIXTURES/}"); emit_srcs+=("$src"); emit_goldens+=("$golden")
done < <(find "$FIXTURES" -name '*.zig' | sort)

diag_ids=(); diag_srcs=()
while IFS= read -r src; do
  base="${src%.*}"
  [ -f "$base.zig" ] && continue
  diag_ids+=("${base#$FIXTURES/}"); diag_srcs+=("$src")
done < <(find "$FIXTURES/zig-rejections" "$FIXTURES/semantic-contract" -name '*.bgl' 2>/dev/null | sort)

[ "${#emit_ids[@]}" -gt 0 ] || die2 "no Zig goldens found under $FIXTURES"
echo "corpus: ${#emit_ids[@]} emit rows, ${#diag_ids[@]} diag rows" >&2

key_of() { printf '%s' "$1" | tr '/' '.'; }

# --- oracle (one Racket process per mode) ------------------------------------
oracle_args=()
for i in "${!emit_ids[@]}"; do
  oracle_args+=("$(key_of "${emit_ids[$i]}")=${emit_srcs[$i]}")
done
"$RACKET" "$ORACLE_SRC" emit --out-dir "$LAB/oracle" "${oracle_args[@]}" \
  > "$LAB/oracle-emit.tsv" || die2 "oracle emit batch failed"

for i in "${!emit_ids[@]}"; do
  key="$(key_of "${emit_ids[$i]}")"
  if [ ! -f "$LAB/oracle/$key.out" ]; then
    echo "oracle failed on ${emit_srcs[$i]}:" >&2
    cat "$LAB/oracle/$key.err" >&2 2>/dev/null
    die2 "oracle cannot emit a corpus fixture — the gate has no truth to compare against"
  fi
  # Oracle integrity: this harness must invoke the canonical emitter exactly as
  # the golden suite does, or every parity verdict below is measuring the wrong
  # thing. A drift here is a harness bug, not a self-host gap.
  cmp -s "$LAB/oracle/$key.out" "${emit_goldens[$i]}" \
    || die2 "oracle output != committed golden ${emit_goldens[$i]} (harness invocation drifted from emit-zig.rkt)"
done

if [ "${#diag_ids[@]}" -gt 0 ]; then
  oracle_args=()
  for i in "${!diag_ids[@]}"; do
    oracle_args+=("$(key_of "${diag_ids[$i]}")=${diag_srcs[$i]}")
  done
  "$RACKET" "$ORACLE_SRC" diag --target zig --out-dir "$LAB/oracle" "${oracle_args[@]}" \
    > "$LAB/oracle-diag.tsv" || die2 "oracle diag batch failed"
  while IFS=$'\t' read -r key verdict; do
    [ "$verdict" = rejected ] \
      || die2 "oracle ACCEPTS diag corpus row $key — that fixture is not a pointed rejection"
  done < "$LAB/oracle-diag.tsv"
fi

# --- self-host ---------------------------------------------------------------
# Parse -> emit (never the full `emit` command): the self-host CHECKER has a
# known arithmetic divergence orthogonal to emission, same isolation
# self-host/verify-target.sh uses for js/nix.
self_emit() { # <src> <target> <out-prefix>; 0 on emitted bytes, 1 on failure
  local src="$1" target="$2" pfx="$3"
  if ! sh_main ast --target "$target" "$src" > "$pfx.ast.json" 2> "$pfx.ast.err"; then
    cp "$pfx.ast.err" "$pfx.err"; return 1
  fi
  if ! sh_main emit-from-ast --target "$target" < "$pfx.ast.json" > "$pfx.out" 2> "$pfx.emit.err"; then
    cp "$pfx.emit.err" "$pfx.err"; return 1
  fi
  return 0
}

# Driver framing differs between the two CLIs; the diagnostic BODY is what
# parity is about.
norm_diag() { sed -E 's/^(beagle \[check\]: |beagle: )+//; s/[[:space:]]+$//' "$1" 2>/dev/null; }

self_check() { # <src> <target> <out-prefix>; prints "exit<TAB>normalized-text"
  local src="$1" target="$2" pfx="$3" rc
  sh_main check --target "$target" "$src" > "$pfx.check.out" 2> "$pfx.check.err"
  rc=$?
  printf '%s\t%s\n' "$rc" "$(norm_diag "$pfx.check.err" | tr '\n' '|')"
}

first_diff_line() { # <a> <b>
  diff "$1" "$2" 2>/dev/null | sed -n '2p' | cut -c1-100 | tr '\t' ' '
}

# A CI log is not a terminal: the in-place progress line would become one
# unreadable mega-line there.
progress() { [ -t 2 ] && printf '  %-58s\r' "$1" >&2; return 0; }

printf 'fixture\tkind\tstatus\texempt\tsummary\n' > "$LEDGER"

n_match=0; n_mismatch=0; n_unported=0

# The exempt column is filled in the exemption pass below, so the raw rows stay
# a pure measurement of the two implementations.
ledger_row() { # <id> <kind> <status> <summary>
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$LEDGER.raw"
}
: > "$LEDGER.raw"

for i in "${!emit_ids[@]}"; do
  id="${emit_ids[$i]}"; src="${emit_srcs[$i]}"; key="$(key_of "$id")"
  pfx="$LAB/self/$key.zig"
  progress "emit $id"
  if self_emit "$src" zig "$pfx"; then
    if cmp -s "$pfx.out" "$LAB/oracle/$key.out"; then
      ledger_row "$id" emit match "byte-identical to racket emitter"
      n_match=$((n_match+1)); continue
    fi
  fi
  # Not matching: distinguish "no zig backend" from a real divergence by asking
  # whether the self-host's zig target behaves any differently from its clj
  # target. main.bclj's emit-for-target falls through to clj for an unknown
  # target, so identical output means the zig branch does not exist yet.
  cpfx="$LAB/self/$key.clj"
  self_emit "$src" clj "$cpfx"; clj_rc=$?
  if [ -f "$pfx.out" ] && [ "$clj_rc" -eq 0 ] && cmp -s "$pfx.out" "$cpfx.out"; then
    ledger_row "$id" emit unported "selfhost --target zig emits its clj output (no zig backend)"
    n_unported=$((n_unported+1))
  elif [ ! -f "$pfx.out" ] && [ "$clj_rc" -ne 0 ]; then
    ledger_row "$id" emit unported "selfhost fails on both targets: $(head -1 "$pfx.err" 2>/dev/null | cut -c1-100 | tr '\t' ' ')"
    n_unported=$((n_unported+1))
  elif [ ! -f "$pfx.out" ]; then
    ledger_row "$id" emit mismatch "selfhost --target zig failed: $(head -1 "$pfx.err" 2>/dev/null | cut -c1-100 | tr '\t' ' ')"
    n_mismatch=$((n_mismatch+1))
  else
    ledger_row "$id" emit mismatch "bytes differ ($(wc -c < "$LAB/oracle/$key.out") oracle vs $(wc -c < "$pfx.out") selfhost); first: $(first_diff_line "$LAB/oracle/$key.out" "$pfx.out")"
    n_mismatch=$((n_mismatch+1))
  fi
done

for i in "${!diag_ids[@]}"; do
  id="${diag_ids[$i]}"; src="${diag_srcs[$i]}"; key="$(key_of "$id")"
  progress "diag $id"
  oracle_text="$(norm_diag "$LAB/oracle/$key.err" | tr '\n' '|')"
  zig_result="$(self_check "$src" zig "$LAB/self/$key.zig")"
  IFS=$'\t' read -r zig_rc zig_text <<< "$zig_result"
  if [ "$zig_rc" -ne 0 ] && [ "$zig_text" = "$oracle_text" ]; then
    ledger_row "$id" diag match "same rejection text"
    n_match=$((n_match+1)); continue
  fi
  clj_result="$(self_check "$src" clj "$LAB/self/$key.clj")"
  if [ "$zig_result" = "$clj_result" ]; then
    if [ "$zig_rc" -eq 0 ]; then
      ledger_row "$id" diag unported "selfhost accepts on zig and clj alike (no zig rejection)"
    else
      ledger_row "$id" diag unported "selfhost rejects target-independently: ${zig_text:0:80}"
    fi
    n_unported=$((n_unported+1))
  else
    ledger_row "$id" diag mismatch "expected '${oracle_text:0:60}', got '${zig_text:0:60}' (exit $zig_rc)"
    n_mismatch=$((n_mismatch+1))
  fi
done

# --- exemptions --------------------------------------------------------------
declare -A EXEMPTED=()
if [ -f "$EXEMPT" ]; then
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [ -n "$line" ] && EXEMPTED["$line"]=1
  done < "$EXEMPT"
fi

fail=0
unexempted=(); stale=(); unknown=()
while IFS=$'\t' read -r id kind status summary; do
  entry="$kind:$id"
  ex=no
  if [ -n "${EXEMPTED[$entry]+x}" ]; then ex=yes; unset 'EXEMPTED[$entry]'; fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$status" "$ex" "$summary" >> "$LEDGER"
  case "$status:$ex" in
    unported:no) unexempted+=("$entry") ;;
    match:yes)   stale+=("$entry") ;;
  esac
done < "$LEDGER.raw"
rm -f "$LEDGER.raw"
for leftover in "${!EXEMPTED[@]}"; do unknown+=("$leftover"); done

echo "ledger: $LEDGER"
echo "match=$n_match mismatch=$n_mismatch unported=$n_unported (exempted=$(( n_unported - ${#unexempted[@]} )))"

if [ "$n_mismatch" -gt 0 ]; then
  echo "FAIL: $n_mismatch fixture(s) diverge from the Racket emitter:" >&2
  awk -F'\t' '$3=="mismatch" {print "  " $2 ":" $1 " — " $5}' "$LEDGER" >&2
  fail=1
fi
if [ "${#unexempted[@]}" -gt 0 ]; then
  echo "FAIL: ${#unexempted[@]} unported fixture(s) with no exemption:" >&2
  printf '  %s\n' "${unexempted[@]}" >&2
  fail=1
fi
if [ "${#stale[@]}" -gt 0 ]; then
  echo "FAIL: ${#stale[@]} stale exemption(s) — parity reached, delete these lines from $EXEMPT:" >&2
  printf '  %s\n' "${stale[@]}" >&2
  fail=1
fi
if [ "${#unknown[@]}" -gt 0 ]; then
  echo "FAIL: ${#unknown[@]} exemption(s) naming no corpus fixture in $EXEMPT:" >&2
  printf '  %s\n' "${unknown[@]}" >&2
  fail=1
fi

[ "$fail" -eq 0 ] && echo "PASS: zero mismatch, every unported fixture exempted"
exit "$fail"
