#!/usr/bin/env bash
# beagle-build: compile a beagle source file to target output.
#
# Usage:
#   bin/beagle-build [--target TARGET] SOURCE [output]   # `beagle langs` lists
#                                                        # every TARGET + ext
#   bin/beagle-build --target zig --exe OUTPUT [--zig-module PATH]... SOURCE...
#   bin/beagle-build --target zig --lib OUTDIR [--zig-module PATH]... SOURCE...
#   (--lib stages the set + beagle_rt.zig + support modules in OUTDIR for a
#   consumer's own build.zig to @import; no entry point is synthesized and
#   nothing is linked.)
#
# If the output path is omitted, it is derived from the namespace declared
# in the source via (ns ...) and dropped under .beagle-out/ (gitignored, so
# throwaway emit never pollutes the tracked tree). Override the output root
# with BEAGLE_OUT (e.g. BEAGLE_OUT=runtime/src to build into the runtime project).
# The output extension comes from the target table (`beagle langs --view table`).
#
# --target retargets a portable source through the production in-process
# reader → parser → checker → emitter path without rewriting the source file.

set -euo pipefail
source "$(dirname "$0")/_beagle-racket"
# Target validation and the extension map are DERIVED from
# beagle-lib/private/targets.rkt via the generated share/targets.sh — never
# hand-listed here. Regenerate with `bin/beagle doc-fill`.
source "$(cd "$(dirname "$0")/.." && pwd)/share/targets.sh"

target=""
if [[ "${1:-}" == "--target" ]]; then
    [[ $# -ge 3 ]] || {
        echo "usage: beagle-build [--target TARGET] SOURCE [OUTPUT]" >&2
        exit 2
    }
    target="$2"
    shift 2
    if ! beagle_known_target "$target"; then
        echo "beagle-build: unsupported --target '$target' (expected $BEAGLE_TARGET_IDS_LIST)" >&2
        exit 2
    fi
fi

if [[ "${1:-}" == "--exe" ]]; then
    if [[ "$target" != "zig" || $# -lt 3 ]]; then
        echo "usage: beagle-build --target zig --exe OUTPUT [--zig-module PATH]... SOURCE..." >&2
        exit 2
    fi
    out="$2"
    shift 2
    zig_modules=()
    zig_module_destinations=()
    declare -A zig_module_sources=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --zig-module)
                if [[ $# -lt 2 ]]; then
                    echo "beagle-build: --zig-module requires a Zig source path" >&2
                    exit 2
                fi
                zig_module="$2"
                if [[ ! -f "$zig_module" ]]; then
                    echo "beagle-build: Zig support module not found: $zig_module" >&2
                    exit 1
                fi
                zig_module_destination="$(basename "$zig_module")"
                if [[ "$zig_module_destination" != *.zig ]]; then
                    echo "beagle-build: Zig support module must end in .zig: $zig_module" >&2
                    exit 2
                fi
                if [[ "$zig_module_destination" == "beagle_rt.zig" ]]; then
                    echo "beagle-build: Zig support module destination 'beagle_rt.zig' collides with reserved destination 'beagle_rt.zig'" >&2
                    exit 2
                fi
                if [[ -n "${zig_module_sources[$zig_module_destination]+x}" ]]; then
                    echo "beagle-build: ambiguous Zig module destination '$zig_module_destination' from '${zig_module_sources[$zig_module_destination]}' and '$zig_module'" >&2
                    exit 2
                fi
                zig_module_sources["$zig_module_destination"]="$zig_module"
                zig_modules+=("$zig_module")
                zig_module_destinations+=("$zig_module_destination")
                shift 2
                ;;
            --)
                shift
                break
                ;;
            --*)
                echo "beagle-build: unknown Zig executable option: $1" >&2
                exit 2
                ;;
            *)
                break
                ;;
        esac
    done
    if [[ $# -lt 1 ]]; then
        echo "usage: beagle-build --target zig --exe OUTPUT [--zig-module PATH]... SOURCE..." >&2
        exit 2
    fi
    sources=("$@")
    for source in "${sources[@]}"; do
        if [[ ! -f "$source" ]]; then
            echo "beagle-build: source file not found: $source" >&2
            exit 1
        fi
    done
    if ! command -v zig >/dev/null 2>&1; then
        echo "beagle-build: multi-module Zig build requires zig on PATH" >&2
        exit 1
    fi
    beagle_root="$(cd "$(dirname "$0")/.." && pwd)"
    out_dir="$(dirname "$out")"
    mkdir -p "$out_dir"
    # Deterministic (hash-of-OUT) staging dir, not mktemp, and a persistent
    # Zig cache root outside it: stable file identities plus a cache Zig can
    # actually reuse across invocations, instead of throwing both away.
    zig_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/beagle/zig-cache"
    mkdir -p "$zig_cache_root/cache" "$zig_cache_root/global-cache"
    out_hash="$(printf '%s' "$(cd "$out_dir" && pwd)/$(basename "$out")" | cksum | cut -d' ' -f1)"
    emit_dir="$out_dir/.beagle-zig-build.$out_hash"
    mkdir -p "$emit_dir"
    # Reserved destinations are staged by this script below, not by
    # retarget-cli; clear any leftover from a prior build of this target so
    # the collision check only fires on a genuine module-set collision.
    rm -f "${emit_dir:?}/beagle_rt.zig"
    for zig_module_destination in "${zig_module_destinations[@]}"; do
        rm -f "${emit_dir:?}/$zig_module_destination"
    done
    generated="$(
        "$RACKET" "$beagle_root/beagle-lib/private/retarget-cli.rkt" \
            --module-dir "$emit_dir" zig "${sources[@]}"
    )"
    entry="$(tail -n 1 <<< "$generated")"
    if [[ -e "$emit_dir/beagle_rt.zig" ]]; then
        echo "beagle-build: generated Zig module collides with reserved destination 'beagle_rt.zig'" >&2
        exit 2
    fi
    # Copy-if-changed: preserve mtime (and Zig's cache hit) when the support
    # module content is unchanged from the prior build.
    if ! cmp -s "$beagle_root/beagle-lib/zig/beagle_rt.zig" "$emit_dir/beagle_rt.zig" 2>/dev/null; then
        cp "$beagle_root/beagle-lib/zig/beagle_rt.zig" "$emit_dir/beagle_rt.zig"
    fi
    for i in "${!zig_modules[@]}"; do
        zig_module_destination="${zig_module_destinations[$i]}"
        if [[ -e "$emit_dir/$zig_module_destination" ]]; then
            echo "beagle-build: Zig support module destination '$zig_module_destination' collides with generated build input" >&2
            exit 2
        fi
        if ! cmp -s "${zig_modules[$i]}" "$emit_dir/$zig_module_destination" 2>/dev/null; then
            cp "${zig_modules[$i]}" "$emit_dir/$zig_module_destination"
        fi
    done
    zig build-exe \
        --cache-dir "$zig_cache_root/cache" \
        --global-cache-dir "$zig_cache_root/global-cache" \
        "-femit-bin=$emit_dir/artifact" \
        "$entry"
    if [[ ! -s "$emit_dir/artifact" ]]; then
        echo "beagle-build: zig produced no executable artifact" >&2
        exit 1
    fi
    mv "$emit_dir/artifact" "$out"
    printf '%s -> %s\n' "${sources[*]}" "$out" >&2
    exit 0
fi

if [[ "${1:-}" == "--lib" ]]; then
    if [[ "$target" != "zig" || $# -lt 3 ]]; then
        echo "usage: beagle-build --target zig --lib OUTDIR [--zig-module PATH]... SOURCE..." >&2
        exit 2
    fi
    out_dir="$2"
    shift 2
    zig_modules=()
    zig_module_destinations=()
    declare -A zig_module_sources=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --zig-module)
                if [[ $# -lt 2 ]]; then
                    echo "beagle-build: --zig-module requires a Zig source path" >&2
                    exit 2
                fi
                zig_module="$2"
                if [[ ! -f "$zig_module" ]]; then
                    echo "beagle-build: Zig support module not found: $zig_module" >&2
                    exit 1
                fi
                zig_module_destination="$(basename "$zig_module")"
                if [[ "$zig_module_destination" != *.zig ]]; then
                    echo "beagle-build: Zig support module must end in .zig: $zig_module" >&2
                    exit 2
                fi
                if [[ "$zig_module_destination" == "beagle_rt.zig" ]]; then
                    echo "beagle-build: Zig support module destination 'beagle_rt.zig' collides with reserved destination 'beagle_rt.zig'" >&2
                    exit 2
                fi
                if [[ -n "${zig_module_sources[$zig_module_destination]+x}" ]]; then
                    echo "beagle-build: ambiguous Zig module destination '$zig_module_destination' from '${zig_module_sources[$zig_module_destination]}' and '$zig_module'" >&2
                    exit 2
                fi
                zig_module_sources["$zig_module_destination"]="$zig_module"
                zig_modules+=("$zig_module")
                zig_module_destinations+=("$zig_module_destination")
                shift 2
                ;;
            --)
                shift
                break
                ;;
            --*)
                echo "beagle-build: unknown Zig library option: $1" >&2
                exit 2
                ;;
            *)
                break
                ;;
        esac
    done
    if [[ $# -lt 1 ]]; then
        echo "usage: beagle-build --target zig --lib OUTDIR [--zig-module PATH]... SOURCE..." >&2
        exit 2
    fi
    sources=("$@")
    for source in "${sources[@]}"; do
        if [[ ! -f "$source" ]]; then
            echo "beagle-build: source file not found: $source" >&2
            exit 1
        fi
    done
    beagle_root="$(cd "$(dirname "$0")/.." && pwd)"
    out_parent="$(dirname "$out_dir")"
    mkdir -p "$out_parent"
    abs_out_dir="$(cd "$out_parent" && pwd)/$(basename "$out_dir")"
    # Scratch dir keyed on OUTDIR, wiped every run: retarget-cli emits fresh
    # here so a canonical-name collision with beagle_rt.zig or a
    # --zig-module destination shows up in its listing before OUTDIR is touched.
    out_hash="$(printf '%s' "$abs_out_dir" | cksum | cut -d' ' -f1)"
    scratch_dir="$(dirname "$abs_out_dir")/.beagle-zig-lib-build.$out_hash"
    rm -rf "${scratch_dir:?}"
    mkdir -p "$scratch_dir"
    generated="$(
        "$RACKET" "$beagle_root/beagle-lib/private/retarget-cli.rkt" \
            --module-dir "$scratch_dir" zig "${sources[@]}"
    )"
    while IFS= read -r generated_path; do
        [[ -z "$generated_path" ]] && continue
        generated_name="$(basename "$generated_path")"
        if [[ "$generated_name" == "beagle_rt.zig" ]]; then
            rm -rf "${scratch_dir:?}"
            echo "beagle-build: generated Zig module collides with reserved destination 'beagle_rt.zig'" >&2
            exit 2
        fi
        if [[ -n "${zig_module_sources[$generated_name]+x}" ]]; then
            rm -rf "${scratch_dir:?}"
            echo "beagle-build: generated Zig module collides with support module destination '$generated_name'" >&2
            exit 2
        fi
    done <<< "$generated"
    mkdir -p "$out_dir"
    staged=()
    while IFS= read -r generated_path; do
        [[ -z "$generated_path" ]] && continue
        generated_name="$(basename "$generated_path")"
        dest="$out_dir/$generated_name"
        if ! cmp -s "$generated_path" "$dest" 2>/dev/null; then
            cp "$generated_path" "$dest"
        fi
        staged+=("$dest")
    done <<< "$generated"
    if ! cmp -s "$beagle_root/beagle-lib/zig/beagle_rt.zig" "$out_dir/beagle_rt.zig" 2>/dev/null; then
        cp "$beagle_root/beagle-lib/zig/beagle_rt.zig" "$out_dir/beagle_rt.zig"
    fi
    staged+=("$out_dir/beagle_rt.zig")
    for i in "${!zig_modules[@]}"; do
        dest="$out_dir/${zig_module_destinations[$i]}"
        if ! cmp -s "${zig_modules[$i]}" "$dest" 2>/dev/null; then
            cp "${zig_modules[$i]}" "$dest"
        fi
        staged+=("$dest")
    done
    rm -rf "${scratch_dir:?}"
    for f in "${staged[@]}"; do
        printf '%s\n' "$f" >&2
    done
    exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "usage: beagle-build [--target TARGET] SOURCE [OUTPUT] | beagle-build --target zig --exe OUTPUT [--zig-module PATH]... SOURCE... | beagle-build --target zig --lib OUTDIR [--zig-module PATH]... SOURCE..." >&2
    exit 2
fi

src="$1"
beagle_root="$(cd "$(dirname "$0")/.." && pwd)"

if [[ ! -f "$src" ]]; then
    echo "beagle-build: source file not found: $src" >&2
    exit 1
fi

## detect target from file extension, then fall back to source content
ext="clj"
if [[ -n "$target" ]]; then
    ext="${BEAGLE_TARGET_OUT_EXT[$target]}"
else
    _matched=""
    for _t in "${BEAGLE_TARGET_IDS[@]}"; do
        if [[ "$src" == *".${BEAGLE_TARGET_SRC_EXT[$_t]}" ]]; then
            ext="${BEAGLE_TARGET_OUT_EXT[$_t]}"
            _matched="$_t"
            break
        fi
    done
    # Legacy .bgl/.rkt: detect from file content, same table, no second list.
    if [[ -z "$_matched" ]]; then
        for _t in "${BEAGLE_TARGET_IDS[@]}"; do
            if grep -qE "^\(define-target[[:space:]]+${_t}\)" "$src" 2>/dev/null || \
               grep -qE "^#lang ${BEAGLE_TARGET_LANG[$_t]}[[:space:]]*$" "$src" 2>/dev/null; then
                ext="${BEAGLE_TARGET_OUT_EXT[$_t]}"
                break
            fi
        done
    fi
fi

if [[ $# -eq 2 ]]; then
    out="$2"
else
    ns="$(grep -E '^\(ns' "$src" | head -1 | \
          sed -E 's/^\(ns[[:space:]]+([a-zA-Z0-9._-]+).*/\1/' | \
          tr -d '[:space:]')"
    [[ -z "$ns" ]] && ns="beagle.user"
    rel_path="$(echo "$ns" | tr '.-' '//_')"
    out="${BEAGLE_OUT:-$beagle_root/.beagle-out}/$rel_path.$ext"
fi

mkdir -p "$(dirname "$out")"
# Atomic write: emit to a temp file first, then mv on success. Without this,
# the `>` redirection truncates $out before racket runs — if racket fails
# mid-emit, the file is left empty/partial silently. The atomic rename
# guarantees $out either has the complete new contents or the old contents.
tmp="$(mktemp "${out}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
if [[ -n "$target" ]]; then
    "$RACKET" "$beagle_root/beagle-lib/private/retarget-cli.rkt" \
        "$target" "$src" > "$tmp"
else
    "$RACKET" "$src" > "$tmp"
fi
mv "$tmp" "$out"
trap - EXIT
echo "$src -> $out" >&2

# Optional Nix smoke test: confirm the emitted file parses as valid Nix.
# Set BEAGLE_NIX_EVAL_CHECK=1 to enable. Requires `nix` on PATH.
if [[ "$ext" == "nix" && "${BEAGLE_NIX_EVAL_CHECK:-0}" == "1" ]]; then
    if command -v nix-instantiate >/dev/null; then
        if ! nix-instantiate --parse "$out" >/dev/null 2>/tmp/beagle-nix-check.err; then
            echo "beagle-build: emitted $out failed nix-instantiate --parse:" >&2
            cat /tmp/beagle-nix-check.err >&2
            exit 1
        fi
    else
        echo "beagle-build: BEAGLE_NIX_EVAL_CHECK=1 set but nix-instantiate not on PATH" >&2
    fi
fi
