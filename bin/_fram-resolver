#!/usr/bin/env bash
# Source after setting FRAM_OUT and CHARTROOM, then call find_fram_resolver.

find_fram_resolver() {
    local fram_root candidate
    fram_root="$(dirname "$FRAM_OUT")"

    for candidate in \
        "$CHARTROOM/src/resolve.clj" \
        "$CHARTROOM/resolve.clj" \
        "$FRAM_OUT/resolve.clj" \
        "$fram_root/resolve.clj"
    do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    echo "Fram resolver not found; checked:" >&2
    echo "  $CHARTROOM/src/resolve.clj" >&2
    echo "  $CHARTROOM/resolve.clj" >&2
    echo "  $FRAM_OUT/resolve.clj" >&2
    echo "  $fram_root/resolve.clj" >&2
    return 1
}
