#!/usr/bin/env bash
# Opt-in development compiler route. This wrapper never participates in release
# or gate entrypoints: with the flag off, and for every non-hosted-build command,
# it delegates to the unchanged public dispatcher.
set -euo pipefail

BEAGLE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$BEAGLE_DIR/bin"

if [[ "${BEAGLE_SELFHOST_DEV:-0}" != "1" || "${1:-}" != "build" ]]; then
    exec "$BIN/beagle" "$@"
fi

original_args=("$@")
shift

# Core/materializer and batch builds remain on the public Racket-built route.
for arg in "$@"; do
    case "$arg" in
        --materializer|--materializer=*|--out|--out=*|--abi|--abi=*)
            exec "$BIN/beagle" "${original_args[@]}"
            ;;
    esac
done

source "$BEAGLE_DIR/share/targets.sh"
source "$BEAGLE_DIR/self-host/native/stage0-select.sh"

target=""
module_root_args=()
positionals=()
after_double_dash=false
while [[ $# -gt 0 ]]; do
    if $after_double_dash; then
        positionals+=("$1")
        shift
        continue
    fi
    case "$1" in
        --target)
            [[ $# -ge 2 ]] || exec "$BIN/beagle" "${original_args[@]}"
            [[ -z "$target" ]] || exec "$BIN/beagle" "${original_args[@]}"
            target="$2"
            shift 2
            ;;
        --target=*)
            [[ -z "$target" ]] || exec "$BIN/beagle" "${original_args[@]}"
            target="${1#*=}"
            shift
            ;;
        --module-root)
            [[ $# -ge 2 ]] || exec "$BIN/beagle" "${original_args[@]}"
            module_root_args+=(--module-root "$2")
            shift 2
            ;;
        --module-root=*)
            module_root_args+=(--module-root "${1#*=}")
            shift
            ;;
        --)
            after_double_dash=true
            shift
            ;;
        --*)
            exec "$BIN/beagle" "${original_args[@]}"
            ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

# The native stage0 adapter is intentionally narrow: one hosted source and an
# optional output. Public validation owns every other invocation shape.
if [[ ${#positionals[@]} -lt 1 || ${#positionals[@]} -gt 2 ]]; then
    exec "$BIN/beagle" "${original_args[@]}"
fi

src="${positionals[0]}"
[[ -f "$src" ]] || exec "$BIN/beagle" "${original_args[@]}"

source_profile=""
for candidate in "${BEAGLE_TARGET_IDS[@]}"; do
    if [[ "$src" == *".${BEAGLE_TARGET_SRC_EXT[$candidate]}" ]]; then
        source_profile="$candidate"
        break
    fi
done

if [[ -z "$source_profile" || "$source_profile" == "core" ]]; then
    exec "$BIN/beagle" "${original_args[@]}"
fi
if [[ -n "$target" ]] && ! beagle_known_hosted_target "$target"; then
    exec "$BIN/beagle" "${original_args[@]}"
fi

effective_target="${target:-$source_profile}"
ext="${BEAGLE_TARGET_OUT_EXT[$effective_target]}"
if [[ ${#positionals[@]} -eq 2 ]]; then
    out="${positionals[1]}"
else
    ns="$(grep -E '^\(ns' "$src" | head -1 | \
        sed -E 's/^\(ns[[:space:]]+([a-zA-Z0-9._-]+).*/\1/' | \
        tr -d '[:space:]')"
    [[ -n "$ns" ]] || ns="beagle.user"
    if [[ "$ext" == "clj" ]]; then
        rel_path="$(printf '%s\n' "$ns" | tr '.-' '/_')"
    else
        rel_path="${ns//./\/}"
    fi
    out="${BEAGLE_OUT:-$BEAGLE_DIR/.beagle-out}/$rel_path.$ext"
fi

default_native="$BEAGLE_DIR/self-host/native/beagle-selfhost"
if beagle_select_stage0 "$BEAGLE_DIR/self-host/seed" "$default_native"; then
    :
else
    exit $?
fi
if [[ "$STAGE0" != "native" ]]; then
    echo "beagle-dev: native stage0 is required: $STAGE0_REASON" >&2
    echo "beagle-dev: build it with 'nix build .#beagle-selfhost' and set BEAGLE_NATIVE_BIN to result/bin/beagle-selfhost" >&2
    exit 2
fi

shadow_percent="${BEAGLE_SELFHOST_SHADOW_PERCENT:-0}"
if [[ ! "$shadow_percent" =~ ^[0-9]+$ ]] ||
   (( 10#$shadow_percent > 100 )); then
    echo "beagle-dev: BEAGLE_SELFHOST_SHADOW_PERCENT must be an integer from 0 through 100" >&2
    exit 2
fi
shadow_percent=$((10#$shadow_percent))

src_abs="$(realpath "$src")"
input_hash="$({
    printf 'target\0%s\0source\0%s\0' "$effective_target" "$src_abs"
    printf '%s\0' "${module_root_args[@]}"
    cat "$src_abs"
} | sha256sum | awk '{print $1}')"
bucket=$((16#${input_hash:0:8} % 100))
shadow=false
if (( bucket < shadow_percent )); then
    shadow=true
fi

mkdir -p "$(dirname "$out")"
work="$(mktemp -d "${out}.selfhost.XXXXXX")"
trap 'rm -rf "${work:?}"' EXIT
selfhost_output="$work/selfhost.output"
selfhost_stderr="$work/selfhost.stderr"
racket_output="$work/racket.output"
racket_stderr="$work/racket.stderr"

set +e
"$NATIVE_BIN" emit --target "$effective_target" \
    "${module_root_args[@]}" "$src_abs" \
    > "$selfhost_output" 2> "$selfhost_stderr"
selfhost_status=$?
set -e

if $shadow; then
    : > "$racket_output"
    oracle_args=()
    [[ -z "$target" ]] || oracle_args+=(--target "$target")
    oracle_args+=("${module_root_args[@]}" "$src_abs" "$racket_output")
    set +e
    BEAGLE_EMIT_SRCLOC=0 "$BIN/beagle-build" "${oracle_args[@]}" \
        > /dev/null 2> "$racket_stderr"
    racket_status=$?
    set -e

    if [[ "$selfhost_status" -ne "$racket_status" ]] ||
       ! cmp -s "$selfhost_output" "$racket_output"; then
        inbox="${BEAGLE_SELFHOST_DIVERGENCE_DIR:-$BEAGLE_DIR/docs/private/selfhost-divergences}"
        mkdir -p "$inbox"
        pending="$(mktemp -d "$inbox/.pending.${input_hash:0:12}.XXXXXX")"
        cp "$selfhost_output" "$pending/selfhost.output"
        cp "$racket_output" "$pending/racket.output"
        cp "$selfhost_stderr" "$pending/selfhost.stderr"
        cp "$racket_stderr" "$pending/racket.stderr"
        cp "$src_abs" "$pending/input.source"
        selfhost_digest="$(sha256sum "$selfhost_output" | awk '{print $1}')"
        racket_digest="$(sha256sum "$racket_output" | awk '{print $1}')"
        {
            printf 'input-sha256 %s\n' "$input_hash"
            printf 'selfhost-output-sha256 %s\n' "$selfhost_digest"
            printf 'racket-output-sha256 %s\n' "$racket_digest"
            printf 'selfhost-status %s\n' "$selfhost_status"
            printf 'racket-status %s\n' "$racket_status"
            printf 'target %s\n' "$effective_target"
            printf 'source %s\n' "$src_abs"
        } > "$pending/manifest.txt"
        entry="$inbox/$(date -u +%Y%m%dT%H%M%SZ)-$$-${input_hash:0:12}"
        mv "$pending" "$entry"
        echo "beagle-dev: selfhost/Racket divergence appended to $entry" >&2
    fi
fi

cat "$selfhost_stderr" >&2
if [[ "$selfhost_status" -ne 0 ]]; then
    exit "$selfhost_status"
fi

mv "$selfhost_output" "$out"
echo "$src -> $out" >&2
