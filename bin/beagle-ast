#!/usr/bin/env bash
# beagle-ast: project a strictly checked program as versioned JSON.
#
# Usage:
#   beagle ast <source.bgl|.bclj|.bjs|.bnix>
#
# Parses and checks without executing or emitting the source program. Output is
# canonical JSON for deterministic external consumers.

set -euo pipefail
source "$(dirname "$0")/_beagle-racket"

if [[ $# -ne 1 ]]; then
    echo "usage: beagle ast <source>" >&2
    exit 2
fi

src="$1"

if [[ ! -f "$src" ]]; then
    echo "beagle ast: source file not found: $src" >&2
    exit 1
fi

# Require by file path (not collection) so the WORKTREE's beagle-lib — which
# carries ast-json.rkt — is what loads, instead of the canonical checkout's
# collection link (which lacks it).
BEAGLE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

src_abs="$(realpath "$src")"
source_root="$(git -C "$(dirname "$src_abs")" rev-parse --show-toplevel 2>/dev/null || true)"
source_id="$src_abs"
if [[ -n "$source_root" ]]; then
    source_root="$(realpath "$source_root")"
    case "$src_abs" in
        "$source_root"/*) source_id="${src_abs#"$source_root"/}" ;;
    esac
fi

"$RACKET" -e "
(require (file \"$BEAGLE_ROOT/beagle-lib/private/parse.rkt\")
         (file \"$BEAGLE_ROOT/beagle-lib/private/check.rkt\")
         (file \"$BEAGLE_ROOT/beagle-lib/private/ast-json.rkt\"))

(define src (vector-ref (current-command-line-arguments) 0))
(define prog (parse-program/file src))
(unless (eq? (program-mode prog) 'strict)
  (error 'beagle-ast
         \"checked-program projection requires (define-mode strict)\"))
(type-check-with-locs!
 prog
 (lambda (e _loc-stx) (raise e))
 #:capture-types? #t)
(define source-id (vector-ref (current-command-line-arguments) 1))
(define output (open-output-string))
(write-checked-program-json
 prog output
 #:source-id source-id)
(display (get-output-string output))
" -- "$src_abs" "$source_id"
