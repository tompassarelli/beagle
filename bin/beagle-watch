#!/usr/bin/env bash
set -euo pipefail

BEAGLE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$BEAGLE_DIR/bin/_beagle-racket"
source "$BEAGLE_DIR/bin/_beagle-source-id"

original_args=("$@")
module_roots=()
sources=()
remaining=("$@")
index=0
while (( index < ${#remaining[@]} )); do
    argument="${remaining[$index]}"
    case "$argument" in
        --module-root)
            (( index + 1 < ${#remaining[@]} )) || {
                echo "beagle watch: --module-root requires LOGICAL=PHYSICAL" >&2
                exit 2
            }
            module_roots+=("${remaining[$((index + 1))]}")
            index=$((index + 2))
            ;;
        --module-root=*)
            module_roots+=("${argument#*=}")
            index=$((index + 1))
            ;;
        --out|--abi|--materializer|--entry|--emit-workers)
            index=$((index + 2))
            ;;
        --)
            index=$((index + 1))
            while (( index < ${#remaining[@]} )); do
                sources+=("${remaining[$index]}")
                index=$((index + 1))
            done
            ;;
        --*) index=$((index + 1)) ;;
        *)
            sources+=("$argument")
            index=$((index + 1))
            ;;
    esac
done

(( ${#sources[@]} > 0 )) || {
    echo "beagle watch: provide at least one explicit .bgl source" >&2
    exit 2
}

closure_args=()
for root in "${module_roots[@]}"; do
    closure_args+=(--module-root "$root")
done
for source_path in "${sources[@]}"; do
    [[ -f "$source_path" && "$source_path" == *.bgl ]] || {
        echo "beagle watch: expected an existing .bgl source: $source_path" >&2
        exit 2
    }
    source_path="$(realpath "$source_path")"
    source_id="$(beagle_source_id "$source_path" "${module_roots[@]}")"
    closure_args+=(--source "$source_path" "$source_id")
done

exec "$RACKET" "$BEAGLE_DIR/beagle-lib/private/watch-cli.rkt" \
    "${closure_args[@]}" -- \
    "$BEAGLE_DIR/bin/beagle-build-core" "${original_args[@]}"
