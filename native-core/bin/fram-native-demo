#!/usr/bin/env bash
# This toolchain boundary composes managed execution, Beagle lowering, two C
# frontends, QBE, the assembler, and the system linker.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$script_dir/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/fram-native-demo.XXXXXX")"
trap 'rm -rf "${work:?}"' EXIT

die() {
  echo "fram-native-demo: $*" >&2
  exit 1
}

[[ -d /home/tom/code/fram/main/out ]] \
  || die "managed Fram output is required at /home/tom/code/fram/main/out"

mkdir -p "$work/types" "$work/kernel"
cp "$repo/native-core/validation/slice-bodies/main.c" "$work/types/main.c"

if ! NATIVE_SLICE_REPO="$repo" \
    NATIVE_SLICE_ARTIFACTS="$work/types" \
    "$repo/native-core/validation/slice-bodies/drive.sh" \
    >"$work/types.log" 2>&1; then
  sed -n '1,260p' "$work/types.log" >&2
  die "fram.types native path failed"
fi

types_report="$work/types/report.txt"
for line in \
  'stage typed-to-native COMPLETE' \
  'program-functions 31' \
  'program-abis 31' \
  'materialize OK module_0.h module_0.c'; do
  rg -Fx "$line" "$types_report" >/dev/null \
    || die "fram.types report is missing: $line"
done
[[ "$(rg -c '^obligation-projection PASS ' "$types_report")" -eq 10 ]] \
  || die "fram.types did not pass exactly ten obligations"
if rg -n '^pending ' "$types_report" >/dev/null; then
  die "fram.types reported pending lowering work"
fi
rg -F 'strict compile + run + trap ok' "$work/types.log" >/dev/null \
  || die "fram.types gcc execution evidence is absent"
rg -F 'clang ' "$work/types.log" | rg -F 'compile + run ok' >/dev/null \
  || die "fram.types clang execution evidence is absent"

if ! NATIVE_SLICE_REPO="$repo" \
    NATIVE_SLICE_ARTIFACTS="$work/kernel" \
    "$repo/native-core/validation/slice-kernel-classify/drive.sh" \
    >"$work/kernel.log" 2>&1; then
  sed -n '1,320p' "$work/kernel.log" >&2
  die "fram.kernel-classify dual native path failed"
fi

for line in \
  'stage typed-to-native COMPLETE' \
  'program-functions 19' \
  'program-abis 19' \
  'materialize OK module_0.h module_0.c' \
  'qbe-stage typed-to-native COMPLETE' \
  'qbe-selected-function delivery-trigger?' \
  'qbe-materialize OK module_1.ssa'; do
  rg -Fx "$line" "$work/kernel/report.txt" >/dev/null \
    || die "fram.kernel-classify report is missing: $line"
done
[[ "$(rg -c '^obligation-projection PASS ' "$work/kernel/report.txt")" -eq 10 ]] \
  || die "fram.kernel-classify C17 projection did not pass ten obligations"
[[ "$(rg -c '^qbe-obligation PASS ' "$work/kernel/report.txt")" -eq 10 ]] \
  || die "fram.kernel-classify QBE projection did not pass ten obligations"

echo 'Fram Native Core funding demo'
echo 'fram.types: COMPLETE, 31 functions, 10/10 obligations, strict C17 gcc+clang run PASS'
echo 'fram.kernel-classify: COMPLETE, 19 functions, 10/10 obligations, full managed/C17 parity PASS'
rg --no-line-number '^slice-kernel-classify: delivery-trigger\?' "$work/kernel.log"
echo 'QBE: delivery-trigger? from the same frozen native program, assemble+link+run PASS'
echo 'RESULT: PASS'
