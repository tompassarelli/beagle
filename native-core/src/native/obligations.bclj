#lang beagle/clj
(ns native.obligations (:require [native.core :as core]))


(defunion ObligationVerdictV0
  (ObligationPassV0 [(code core/ObligationCode)])
  (ValidSsaDiagnosticV0 [(function-id core/NativeId)])
  (ExhaustiveMatchesDiagnosticV0 [(function-id core/NativeId)])
  (ClosedLayoutsDiagnosticV0 [(type-id core/NativeId)])
  (CheckedArithmeticDiagnosticV0 [(function-id core/NativeId)])
  (LegalAbiDiagnosticV0 [(abi-id core/NativeId)])
  (DischargedTokensDiagnosticV0 [(function-id core/NativeId)])
  (BoundedEffectsDiagnosticV0 [(function-id core/NativeId)])
  (EpochSoundnessDiagnosticV0 [(function-id core/NativeId)])
  (LeakFreedomDiagnosticV0 [(region-id core/NativeId)])
  (DeterministicParallelismDiagnosticV0 [(function-id core/NativeId)]))

(defrecord DefSiteV0
  [(found Bool)
   (function-parameter Bool)
   (block-id core/NativeId)
   (position Int)
   (type-id core/NativeId)])

(defrecord SsaValidationIndexV0
  [(definitions (Map String DefSiteV0))
   (dominators (Map String String))])

(defrecord CheckedUseScanV0 [(handled Bool) (legal Bool)])

(defrecord TokenStateV0
  [(live (Vec core/NativeId))
   (seen (Vec core/NativeId))
   (valid Bool)])

(defn obligation-id [(name String)] core/NativeId
  (core/canonical-id "native-obligations-v0" [name]))

(defn dynamic-id= [(left Any) (right Any)] Bool
  (and (not (nil? left))
    (not (nil? right))
    (= (get left :value "left-missing") (get right :value "right-missing"))))

(defn obligation-passed? [(verdict ObligationVerdictV0)] Bool
  (match verdict
    [(ObligationPassV0 code) true]
    [(ValidSsaDiagnosticV0 function-id) false]
    [(ExhaustiveMatchesDiagnosticV0 function-id) false]
    [(ClosedLayoutsDiagnosticV0 type-id) false]
    [(CheckedArithmeticDiagnosticV0 function-id) false]
    [(LegalAbiDiagnosticV0 abi-id) false]
    [(DischargedTokensDiagnosticV0 function-id) false]
    [(BoundedEffectsDiagnosticV0 function-id) false]
    [(EpochSoundnessDiagnosticV0 function-id) false]
    [(LeakFreedomDiagnosticV0 region-id) false]
    [(DeterministicParallelismDiagnosticV0 function-id) false]))

;; Named tag per verdict variant, so a fixture can assert "failed with ITS
;; diagnostic" without repeating a ten-arm match at each call site.
(defn verdict-tag [(verdict ObligationVerdictV0)] String
  (match verdict
    [(ObligationPassV0 code) "pass"]
    [(ValidSsaDiagnosticV0 function-id) "valid-ssa"]
    [(ExhaustiveMatchesDiagnosticV0 function-id) "exhaustive-matches"]
    [(ClosedLayoutsDiagnosticV0 type-id) "closed-layouts"]
    [(CheckedArithmeticDiagnosticV0 function-id) "checked-arithmetic"]
    [(LegalAbiDiagnosticV0 abi-id) "legal-abi"]
    [(DischargedTokensDiagnosticV0 function-id) "discharged-tokens"]
    [(BoundedEffectsDiagnosticV0 function-id) "bounded-effects"]
    [(EpochSoundnessDiagnosticV0 function-id) "epoch-soundness"]
    [(LeakFreedomDiagnosticV0 region-id) "leak-freedom"]
    [(DeterministicParallelismDiagnosticV0 function-id)
     "deterministic-parallelism"]))

(defn find-block
  [(blocks (Vec core/BasicBlock))
   (block-id core/NativeId)] (U core/BasicBlock Nil)
  (loop [index Int 0]
    (cond
      (>= index (count blocks)) nil
      (core/native-id= (core/basicblock-id (nth blocks index)) block-id)
      (nth blocks index)
      :else (recur (+ index 1)))))

(defn missing-def-site [] DefSiteV0
  (->DefSiteV0 false false (obligation-id "missing-block") -1
    (obligation-id "missing-type")))

(defn native-id-key [(id core/NativeId)] String
  (core/nativeid-value id))

(defn index-parameter-sites
  [(definitions (Map String DefSiteV0))
   (parameters (Vec core/Parameter))
   (function-parameter Bool)
   (block-id core/NativeId)] (Map String DefSiteV0)
  (loop [index Int 0 current (Map String DefSiteV0) definitions]
    (if (>= index (count parameters))
      current
      (let [(parameter core/Parameter) (nth parameters index)]
        (recur (+ index 1)
          (assoc current
            (native-id-key (core/parameter-id parameter))
            (->DefSiteV0 true function-parameter block-id -1
              (core/parameter-type-id parameter))))))))

(defn index-instruction-sites
  [(definitions (Map String DefSiteV0))
   (block core/BasicBlock)] (Map String DefSiteV0)
  (let [(instructions (Vec core/Instruction)) (core/basicblock-instructions block)]
    (loop [index Int 0 current (Map String DefSiteV0) definitions]
      (if (>= index (count instructions))
        current
        (let [(result core/SsaValueV0) (get (nth instructions index) :result)]
          (recur (+ index 1)
            (assoc current
              (native-id-key (core/ssavaluev0-id result))
              (->DefSiteV0 true false (core/basicblock-id block) index
                (core/ssavaluev0-type-id result)))))))))

(defn definition-index [(function core/FunctionDef)] (Map String DefSiteV0)
  (let [(with-function-parameters (Map String DefSiteV0))
        (index-parameter-sites {}
          (core/functiondef-parameters function)
          true
          (obligation-id "function-parameter"))
        (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)]
    (loop [index Int 0 current (Map String DefSiteV0) with-function-parameters]
      (if (>= index (count blocks))
        current
        (let [(block core/BasicBlock) (nth blocks index)
              (with-block-parameters (Map String DefSiteV0))
              (index-parameter-sites current
                (core/basicblock-parameters block)
                false
                (core/basicblock-id block))]
          (recur (+ index 1)
            (index-instruction-sites with-block-parameters block)))))))

(defn block-index
  [(blocks (Vec core/BasicBlock))] (Map String core/BasicBlock)
  (loop [index Int 0 current (Map String core/BasicBlock) {}]
    (if (>= index (count blocks))
      current
      (let [(block core/BasicBlock) (nth blocks index)]
        (recur (+ index 1)
          (let [(key String) (native-id-key (core/basicblock-id block))]
            (if (nil? (get current key))
              (assoc current key block)
              current)))))))

(defn parameter-site
  [(parameters (Vec core/Parameter))
   (value-id core/NativeId)] DefSiteV0
  (loop [index Int 0]
    (if (>= index (count parameters))
      (->DefSiteV0 false false (obligation-id "missing-block") -1
        (obligation-id "missing-type"))
      (let [(parameter core/Parameter) (nth parameters index)]
        (if (core/native-id= (core/parameter-id parameter) value-id)
          (->DefSiteV0 true true (obligation-id "function-parameter") -1
            (core/parameter-type-id parameter))
          (recur (+ index 1)))))))

(defn block-parameter-site
  [(block core/BasicBlock)
   (value-id core/NativeId)] DefSiteV0
  (loop [index Int 0 parameters (Vec core/Parameter) (core/basicblock-parameters block)]
    (if (>= index (count parameters))
      (->DefSiteV0 false false (obligation-id "missing-block") -1
        (obligation-id "missing-type"))
      (let [(parameter core/Parameter) (nth parameters index)]
        (if (core/native-id= (core/parameter-id parameter) value-id)
          (->DefSiteV0 true false (core/basicblock-id block) -1
            (core/parameter-type-id parameter))
          (recur (+ index 1) parameters))))))

(defn block-instruction-site
  [(block core/BasicBlock)
   (value-id core/NativeId)] DefSiteV0
  (loop [index Int 0 instructions (Vec core/Instruction) (core/basicblock-instructions block)]
    (if (>= index (count instructions))
      (->DefSiteV0 false false (obligation-id "missing-block") -1
        (obligation-id "missing-type"))
      (let [(instruction core/Instruction) (nth instructions index)
            (result core/SsaValueV0) (get instruction :result)]
        (if (core/native-id= (core/ssavaluev0-id result) value-id)
          (->DefSiteV0 true false (core/basicblock-id block) index
            (core/ssavaluev0-type-id result))
          (recur (+ index 1) instructions))))))

(defn block-site
  [(block core/BasicBlock)
   (value-id core/NativeId)] DefSiteV0
  (let [(parameter-site-result DefSiteV0) (block-parameter-site block value-id)]
    (if (defsitev0-found parameter-site-result)
      parameter-site-result
      (block-instruction-site block value-id))))

(defn find-def-site
  [(function core/FunctionDef)
   (value-id core/NativeId)] DefSiteV0
  (let [(function-site DefSiteV0)
        (parameter-site (core/functiondef-parameters function) value-id)]
    (if (defsitev0-found function-site)
      function-site
      (loop [index Int 0 blocks (Vec core/BasicBlock) (core/functiondef-blocks function)]
        (if (>= index (count blocks))
          (->DefSiteV0 false false (obligation-id "missing-block") -1
            (obligation-id "missing-type"))
          (let [(site DefSiteV0) (block-site (nth blocks index) value-id)]
            (if (defsitev0-found site) site (recur (+ index 1) blocks))))))))

(defn terminator-successors
  [(terminator core/Terminator)] (Vec core/NativeId)
  (let [(jump-block Any) (get terminator :block-id nil)
        (true-block Any) (get terminator :true-block nil)
        (false-block Any) (get terminator :false-block nil)
        (cases Any) (get terminator :cases nil)]
    (cond
      (not (nil? jump-block)) [jump-block]
      (and (not (nil? true-block)) (not (nil? false-block)))
      [true-block false-block]
      (not (nil? cases))
      (mapv (fn [(switch-case core/SwitchCaseV0)] core/NativeId
              (core/switchcasev0-block-id switch-case))
        cases)
      :else [])))

(defn block-successors [(block core/BasicBlock)] (Vec core/NativeId)
  (if (= 1 (count (core/basicblock-terminators block)))
    (terminator-successors (nth (core/basicblock-terminators block) 0))
    []))

(defn predecessor-index
  [(blocks (Vec core/BasicBlock))] (Map String (Vec core/NativeId))
  (loop [block-position Int 0
         predecessors (Map String (Vec core/NativeId)) {}]
    (if (>= block-position (count blocks))
      predecessors
      (let [(block core/BasicBlock) (nth blocks block-position)
            (block-id core/NativeId) (core/basicblock-id block)
            (successors (Vec core/NativeId)) (block-successors block)
            (next-predecessors (Map String (Vec core/NativeId)))
            (loop [successor-position Int 0
                   current (Map String (Vec core/NativeId)) predecessors]
              (if (>= successor-position (count successors))
                current
                (let [(successor core/NativeId) (nth successors successor-position)
                      (successor-key String) (native-id-key successor)
                      (found (Vec core/NativeId)) (get current successor-key [])]
                  (recur (+ successor-position 1)
                    (assoc current successor-key (conj found block-id))))))]
        (recur (+ block-position 1) next-predecessors)))))

(defn reachable-block-order
  [(blocks (Map String core/BasicBlock))
   (entry core/NativeId)] (Vec core/NativeId)
  (loop [position Int 0
         pending (Vec core/NativeId) [entry]
         seen (Map String Bool) {}
         order (Vec core/NativeId) []]
    (if (>= position (count pending))
      order
      (let [(current core/NativeId) (nth pending position)
            (current-key String) (native-id-key current)
            (block (U core/BasicBlock Nil)) (get blocks current-key)]
        (cond
          (= true (get seen current-key))
          (recur (+ position 1) pending seen order)

          (nil? block)
          (recur (+ position 1) pending (assoc seen current-key true) order)

          :else
          (recur (+ position 1)
            (core/append-ids pending (block-successors block))
            (assoc seen current-key true)
            (conj order current)))))))

(defn block-order-index
  [(blocks (Vec core/NativeId))] (Map String Int)
  (loop [position Int 0 order (Map String Int) {}]
    (if (>= position (count blocks))
      order
      (recur (+ position 1)
        (assoc order (native-id-key (nth blocks position)) position)))))

(defn intersect-dominator-chains
  [(dominators (Map String String))
   (order (Map String Int))
   (left String)
   (right String)] String
  (loop [left-key String left right-key String right]
    (cond
      (= left-key right-key) left-key
      (> (get order left-key -1) (get order right-key -1))
      (recur (get dominators left-key "") right-key)
      :else
      (recur left-key (get dominators right-key "")))))

(defn common-predecessor-dominator
  [(predecessors (Vec core/NativeId))
   (dominators (Map String String))
   (order (Map String Int))] String
  (loop [position Int 0 candidate String ""]
    (if (>= position (count predecessors))
      candidate
      (let [(predecessor-key String)
            (native-id-key (nth predecessors position))]
        (if (contains? dominators predecessor-key)
          (recur (+ position 1)
            (if (= "" candidate)
              predecessor-key
              (intersect-dominator-chains dominators order
                predecessor-key candidate)))
          (recur (+ position 1) candidate))))))

(defn dominator-index [(function core/FunctionDef)] (Map String String)
  (let [(blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
        (blocks-by-id (Map String core/BasicBlock)) (block-index blocks)
        (entry core/NativeId) (core/functiondef-entry-block function)
        (reachable (Vec core/NativeId)) (reachable-block-order blocks-by-id entry)
        (order (Map String Int)) (block-order-index reachable)
        (predecessors (Map String (Vec core/NativeId))) (predecessor-index blocks)]
    (if (= 0 (count reachable))
      {}
      (let [(entry-key String) (native-id-key entry)]
        (loop [dominators (Map String String) {entry-key entry-key}]
          (let [(next-dominators (Map String String))
                (loop [position Int 1 current (Map String String) dominators]
                  (if (>= position (count reachable))
                    current
                    (let [(block-key String) (native-id-key (nth reachable position))
                          (block-predecessors (Vec core/NativeId))
                          (get predecessors block-key [])
                          (candidate String)
                          (common-predecessor-dominator block-predecessors current order)]
                      (recur (+ position 1)
                        (if (= "" candidate)
                          current
                          (assoc current block-key candidate))))))]
            (if (= dominators next-dominators)
              dominators
              (recur next-dominators))))))))

(defn block-dominates?
  [(dominators (Map String String))
   (definition-block core/NativeId)
   (use-block core/NativeId)] Bool
  (let [(definition-key String) (native-id-key definition-block)
        (use-key String) (native-id-key use-block)]
    (cond
      ;; The previous avoiding-path index found no path to an unreachable use,
      ;; so every other block was considered to dominate it.
      (not (contains? dominators use-key)) true
      (not (contains? dominators definition-key)) false
      :else
      (loop [current String use-key]
        (if (= current definition-key)
          true
          (let [(parent String) (get dominators current "")]
            (if (or (= "" parent) (= parent current))
              false
              (recur parent))))))))

(defn ssa-validation-index [(function core/FunctionDef)] SsaValidationIndexV0
  (->SsaValidationIndexV0
    (definition-index function)
    (dominator-index function)))

(defn indexed-def-site
  [(index SsaValidationIndexV0)
   (value-id core/NativeId)] DefSiteV0
  (let [(site (U DefSiteV0 Nil))
        (get (ssavalidationindexv0-definitions index) (native-id-key value-id))]
    (if (nil? site) (missing-def-site) site)))

(defn value-dominates-use?
  [(index SsaValidationIndexV0)
   (function core/FunctionDef)
   (use-block core/NativeId)
   (use-position Int)
   (value-id core/NativeId)] Bool
  (let [(site DefSiteV0) (indexed-def-site index value-id)]
    (cond
      (not (defsitev0-found site)) false
      (defsitev0-function-parameter site) true
      (core/native-id= (defsitev0-block-id site) use-block)
      (< (defsitev0-position site) use-position)
      (core/native-id= (defsitev0-block-id site)
        (core/functiondef-entry-block function)) true
      :else
      (block-dominates? (ssavalidationindexv0-dominators index)
        (defsitev0-block-id site) use-block))))

(defn refs-dominate?
  [(validation-index SsaValidationIndexV0)
   (function core/FunctionDef)
   (block-id core/NativeId)
   (position Int)
   (refs (Vec core/NativeId))] Bool
  (loop [ref-position Int 0]
    (if (>= ref-position (count refs))
      true
      (if (value-dominates-use? validation-index function block-id position
            (nth refs ref-position))
        (recur (+ ref-position 1))
        false))))

(defn block-uses-dominated?
  [(validation-index SsaValidationIndexV0)
   (function core/FunctionDef)
   (block core/BasicBlock)] Bool
  (let [(instructions (Vec core/Instruction)) (core/basicblock-instructions block)
        (block-id core/NativeId) (core/basicblock-id block)]
    (and
      (loop [instruction-position Int 0]
        (if (>= instruction-position (count instructions))
          true
          (if (refs-dominate? validation-index function block-id instruction-position
                (core/instruction-ssa-refs (nth instructions instruction-position)))
            (recur (+ instruction-position 1))
            false)))
      (every? (fn [(terminator core/Terminator)] Bool
                (refs-dominate? validation-index function block-id (count instructions)
                  (core/terminator-ssa-refs terminator)))
        (core/basicblock-terminators block)))))

(defn arguments-match-parameters?
  [(validation-index SsaValidationIndexV0)
   (function core/FunctionDef)
   (target-id core/NativeId)
   (arguments (Vec core/NativeId))] Bool
  (let [(target (U core/BasicBlock Nil))
        (find-block (core/functiondef-blocks function) target-id)]
    (if (nil? target)
      false
      (let [(parameters (Vec core/Parameter)) (core/basicblock-parameters target)]
        (and (= (count parameters) (count arguments))
          (loop [argument-position Int 0]
            (if (>= argument-position (count arguments))
              true
              (let [(site DefSiteV0)
                    (indexed-def-site validation-index
                      (nth arguments argument-position))]
                (if (and (defsitev0-found site)
                      (core/native-id= (defsitev0-type-id site)
                        (core/parameter-type-id
                          (nth parameters argument-position))))
                  (recur (+ argument-position 1))
                  false)))))))))

(defn terminator-arguments-valid?
  [(index SsaValidationIndexV0)
   (function core/FunctionDef)
   (terminator core/Terminator)] Bool
  (cond
    (instance? native.core.ReturnTerminator terminator) true
    (instance? native.core.JumpTerminator terminator)
    (arguments-match-parameters? index function
      (core/jumpterminator-block-id terminator)
      (core/jumpterminator-arguments terminator))
    (instance? native.core.BranchTerminator terminator)
    (and
      (arguments-match-parameters? index function
        (core/branchterminator-true-block terminator) [])
      (arguments-match-parameters? index function
        (core/branchterminator-false-block terminator) []))
    (instance? native.core.SwitchTerminator terminator)
    (every? (fn [(switch-case core/SwitchCaseV0)] Bool
              (arguments-match-parameters? index function
                (core/switchcasev0-block-id switch-case)
                (core/switchcasev0-arguments switch-case)))
      (core/switchterminator-cases terminator))
    :else true))

(defn function-valid-ssa? [(function core/FunctionDef)] Bool
  (if (not (core/unique-ids? (core/function-value-ids function)))
    false
    (let [(index SsaValidationIndexV0) (ssa-validation-index function)]
      (every? (fn [(block core/BasicBlock)] Bool
                (and (block-uses-dominated? index function block)
                  (every? (fn [(terminator core/Terminator)] Bool
                            (terminator-arguments-valid? index function terminator))
                    (core/basicblock-terminators block))))
        (core/functiondef-blocks function)))))

(defn valid-ssa [(program core/NativeCoreProgram)] ObligationVerdictV0
  (let [(functions (Vec core/FunctionDef))
        (core/nativecoreprogram-functions program)
        (types (Vec core/TypeDef)) (core/nativecoreprogram-types program)
        (regions (Vec core/RegionDef)) (core/nativecoreprogram-regions program)
        (capabilities (Vec core/CapabilityDef))
        (core/nativecoreprogram-capabilities program)]
    (loop [index Int 0]
      (if (>= index (count functions))
        (if (core/program-buffer-root-coherent? program)
          (->ObligationPassV0 (core/->ValidSsaObligation true))
          (->ValidSsaDiagnosticV0 (core/nativecoreprogram-id program)))
        (let [(function core/FunctionDef) (nth functions index)]
          (if (and (function-valid-ssa? function)
                (core/function-buffer-instructions-valid? types regions
                  capabilities function))
            (recur (+ index 1))
            (->ValidSsaDiagnosticV0 (core/functiondef-id function))))))))

(defn find-type
  [(types (Vec core/TypeDef))
   (type-id core/NativeId)] (U core/TypeDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count types)) nil
      (core/native-id= (core/typedef-id (nth types index)) type-id)
      (nth types index)
      :else (recur (+ index 1)))))

(defn unit-type? [(types (Vec core/TypeDef)) (type-id core/NativeId)] Bool
  (let [(type-def (U core/TypeDef Nil)) (find-type types type-id)]
    (if (nil? type-def)
      false
      (let [(shape core/TypeShape) (core/typedef-shape type-def)]
        (if (not (instance? native.core.UnionType shape))
          false
          (let [(variants (Vec core/TypeVariant))
                (core/uniontype-variants shape)]
            (and (= 1 (count variants))
              (nil? (core/typevariant-payload-type (nth variants 0))))))))))

(defn variant-ids-for-type
  [(types (Vec core/TypeDef))
   (type-id core/NativeId)] (Vec core/NativeId)
  (let [(type-def (U core/TypeDef Nil)) (find-type types type-id)]
    (if (nil? type-def)
      []
      (let [(shape Any) (core/typedef-shape type-def)
            (variants Any) (get shape :variants nil)
            (failure-type Any) (get shape :failure-type nil)]
        (cond
          (not (nil? variants))
          (mapv (fn [(variant core/TypeVariant)] core/NativeId
                  (core/typevariant-id variant)) variants)
          (not (nil? failure-type))
          (variant-ids-for-type types failure-type)
          :else [])))))

(defn switch-case-ids [(cases (Vec core/SwitchCaseV0))] (Vec core/NativeId)
  (mapv (fn [(switch-case core/SwitchCaseV0)] core/NativeId
          (core/switchcasev0-variant-id switch-case))
    cases))

(defn switch-exhaustive?
  [(types (Vec core/TypeDef))
   (function core/FunctionDef)
   (value-id core/NativeId)
   (cases (Vec core/SwitchCaseV0))] Bool
  (let [(site DefSiteV0) (find-def-site function value-id)
        (variant-ids (Vec core/NativeId))
        (variant-ids-for-type types (defsitev0-type-id site))]
    (if (or (not (defsitev0-found site)) (= 0 (count variant-ids)))
      false
      (let [(case-ids (Vec core/NativeId)) (switch-case-ids cases)]
        (and (= (count variant-ids) (count case-ids))
          (core/unique-ids? case-ids)
          (core/ids-in? variant-ids case-ids))))))

(defn terminator-exhaustive?
  [(types (Vec core/TypeDef))
   (function core/FunctionDef)
   (terminator core/Terminator)] Bool
  (if (instance? native.core.SwitchTerminator terminator)
    (switch-exhaustive? types function
      (core/switchterminator-value-id terminator)
      (core/switchterminator-cases terminator))
    true))

(defn function-exhaustive?
  [(types (Vec core/TypeDef))
   (function core/FunctionDef)] Bool
  (every? (fn [(block core/BasicBlock)] Bool
            (every? (fn [(terminator core/Terminator)] Bool
                      (terminator-exhaustive? types function terminator))
              (core/basicblock-terminators block)))
    (core/functiondef-blocks function)))

(defn exhaustive-matches
  [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->ExhaustiveMatchesObligation true))
      (let [(function core/FunctionDef) (nth functions index)]
        (if (function-exhaustive? (core/nativecoreprogram-types program) function)
          (recur (+ index 1) functions)
          (->ExhaustiveMatchesDiagnosticV0
            (core/functiondef-id function)))))))

(defn find-layout
  [(layouts (Vec core/LayoutDef))
   (type-id core/NativeId)] (U core/LayoutDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count layouts)) nil
      (core/native-id= (core/layoutdef-type-id (nth layouts index)) type-id)
      (nth layouts index)
      :else (recur (+ index 1)))))

(defn layout-count
  [(layouts (Vec core/LayoutDef))
   (type-id core/NativeId)] Int
  (loop [index Int 0 found Int 0]
    (if (>= index (count layouts))
      found
      (recur (+ index 1)
        (if (core/native-id= (core/layoutdef-type-id (nth layouts index)) type-id)
          (+ found 1)
          found)))))

(defn aligned? [(offset Int) (alignment Int)] Bool
  (and (> alignment 0) (= 0 (mod offset alignment))))

(defn field-layout-valid?
  [(layouts (Vec core/LayoutDef))
   (parent-size Int)
   (field core/FieldLayoutV0)] Bool
  (let [(field-type core/NativeId) (get field :type-id)
        (child (U core/LayoutDef Nil)) (find-layout layouts field-type)
        (offset Int) (get field :offset-bytes)
        (alignment Int) (get field :align-bytes)]
    (and (not (nil? child))
      (aligned? offset alignment)
      (= alignment (core/layoutdef-align-bytes child))
      (<= (+ offset (core/layoutdef-size-bytes child)) parent-size))))

(defn fields-nonoverlapping?
  [(layouts (Vec core/LayoutDef))
   (fields (Vec core/FieldLayoutV0))] Bool
  (loop [left-index Int 0]
    (if (>= left-index (count fields))
      true
      (let [(left core/FieldLayoutV0) (nth fields left-index)
            (left-layout (U core/LayoutDef Nil))
            (find-layout layouts (get left :type-id))]
        (if (nil? left-layout)
          false
          (let [(left-start Int) (get left :offset-bytes)
                (left-end Int) (+ left-start (core/layoutdef-size-bytes left-layout))]
            (if
              (loop [right-index Int (+ left-index 1)]
                (if (>= right-index (count fields))
                  true
                  (let [(right core/FieldLayoutV0) (nth fields right-index)
                        (right-layout (U core/LayoutDef Nil))
                        (find-layout layouts (get right :type-id))]
                    (if (nil? right-layout)
                      false
                      (let [(right-start Int) (get right :offset-bytes)
                            (right-end Int)
                            (+ right-start (core/layoutdef-size-bytes right-layout))]
                        (if (or (<= left-end right-start) (<= right-end left-start))
                          (recur (+ right-index 1))
                          false))))))
              (recur (+ left-index 1))
              false)))))))

(defn unique-ints? [(values (Vec Int))] Bool
  (loop [index Int 0 seen (Vec Int) []]
    (if (>= index (count values))
      true
      (let [(value Int) (nth values index)]
        (if (some? (some (fn [(prior Int)] Bool (= prior value)) seen))
          false
          (recur (+ index 1) (conj seen value)))))))

(defn record-layout-valid?
  [(type-shape Any)
   (layout-shape Any)
   (layouts (Vec core/LayoutDef))
   (parent-size Int)] Bool
  (let [(type-fields (Vec core/TypeField)) (get type-shape :fields [])
        (fields (Vec core/FieldLayoutV0)) (get layout-shape :fields [])
        (expected-ids (Vec core/NativeId))
        (mapv (fn [(field core/TypeField)] core/NativeId
                (core/typefield-id field)) type-fields)
        (field-ids (Vec core/NativeId))
        (mapv (fn [(field core/FieldLayoutV0)] core/NativeId
                (get field :field-id)) fields)]
    (and (= (count expected-ids) (count field-ids))
      (core/unique-ids? field-ids)
      (core/ids-in? expected-ids field-ids)
      (every? (fn [(field core/FieldLayoutV0)] Bool
                (field-layout-valid? layouts parent-size field)) fields)
      (fields-nonoverlapping? layouts fields))))

(defn union-payload-valid?
  [(layouts (Vec core/LayoutDef))
   (parent-size Int)
   (variant core/UnionVariantLayoutV0)] Bool
  (let [(payload-type (U core/NativeId Nil)) (get variant :payload-type)
        (offset Int) (get variant :payload-offset-bytes)]
    (if (nil? payload-type)
      (>= offset 0)
      (let [(payload-layout (U core/LayoutDef Nil))
            (find-layout layouts payload-type)]
        (and (not (nil? payload-layout))
          (aligned? offset (core/layoutdef-align-bytes payload-layout))
          (<= (+ offset (core/layoutdef-size-bytes payload-layout))
            parent-size))))))

(defn union-layout-valid?
  [(type-shape Any)
   (layout-shape Any)
   (layouts (Vec core/LayoutDef))
   (parent-size Int)] Bool
  (let [(type-variants (Vec core/TypeVariant)) (get type-shape :variants [])
        (variants (Vec core/UnionVariantLayoutV0))
        (get layout-shape :variants [])
        (expected-ids (Vec core/NativeId))
        (mapv (fn [(variant core/TypeVariant)] core/NativeId
                (core/typevariant-id variant)) type-variants)
        (variant-ids (Vec core/NativeId))
        (mapv (fn [(variant core/UnionVariantLayoutV0)] core/NativeId
                (get variant :variant-id)) variants)
        (tags (Vec Int))
        (mapv (fn [(variant core/UnionVariantLayoutV0)] Int
                (get variant :tag)) variants)
        (tag-type core/NativeId) (get layout-shape :tag-type)
        (tag-layout (U core/LayoutDef Nil)) (find-layout layouts tag-type)
        (tag-offset Int) (get layout-shape :tag-offset-bytes)]
    (and (not (nil? tag-layout))
      (aligned? tag-offset (core/layoutdef-align-bytes tag-layout))
      (<= (+ tag-offset (core/layoutdef-size-bytes tag-layout)) parent-size)
      (= (count expected-ids) (count variant-ids))
      (core/unique-ids? variant-ids)
      (core/ids-in? expected-ids variant-ids)
      (unique-ints? tags)
      (every? (fn [(variant core/UnionVariantLayoutV0)] Bool
                (union-payload-valid? layouts parent-size variant))
        variants))))

(defn collection-order-exact? [(type-order Any) (layout-order Any)] Bool
  (and (not (nil? type-order))
    (not (nil? layout-order))
    (= (get type-order :token false) (get layout-order :token false))))

(defn map-layout-valid?
  [(type-shape Any)
   (layout-shape Any)
   (layouts (Vec core/LayoutDef))
   (parent-size Int)] Bool
  (let [(key-type core/NativeId) (get type-shape :key-type)
        (value-type core/NativeId) (get type-shape :value-type)
        (key-layout (U core/LayoutDef Nil)) (find-layout layouts key-type)
        (value-layout (U core/LayoutDef Nil)) (find-layout layouts value-type)]
    (and (not (nil? key-layout))
      (not (nil? value-layout))
      (dynamic-id= key-type (get layout-shape :key-type nil))
      (dynamic-id= value-type (get layout-shape :value-type nil))
      (= (get layout-shape :key-stride-bytes 0)
        (core/layoutdef-size-bytes key-layout))
      (= (get layout-shape :key-align-bytes 0)
        (core/layoutdef-align-bytes key-layout))
      (= (get layout-shape :value-stride-bytes 0)
        (core/layoutdef-size-bytes value-layout))
      (= (get layout-shape :value-align-bytes 0)
        (core/layoutdef-align-bytes value-layout))
      (collection-order-exact? (get type-shape :iteration-order nil)
        (get layout-shape :iteration-order nil))
      (> parent-size 0))))

(defn set-layout-valid?
  [(type-shape Any)
   (layout-shape Any)
   (layouts (Vec core/LayoutDef))
   (parent-size Int)] Bool
  (let [(element-type core/NativeId) (get type-shape :element-type)
        (element-layout (U core/LayoutDef Nil))
        (find-layout layouts element-type)]
    (and (not (nil? element-layout))
      (dynamic-id= element-type (get layout-shape :element-type nil))
      (= (get layout-shape :stride-bytes 0)
        (core/layoutdef-size-bytes element-layout))
      (= (get layout-shape :align-bytes 0)
        (core/layoutdef-align-bytes element-layout))
      (collection-order-exact? (get type-shape :iteration-order nil)
        (get layout-shape :iteration-order nil))
      (> parent-size 0))))

(defn layout-shape-exact?
  [(types (Vec core/TypeDef))
   (type-shape Any)
   (layout-shape Any)
   (layouts (Vec core/LayoutDef))
   (parent-size Int)
   (abi core/AbiProfileV0)] Bool
  (cond
    (instance? native.core.FunctionType type-shape)
    (and (instance? native.core.ClosureShapeV0 layout-shape)
      (= parent-size (* 2 (core/abiprofilev0-pointer-bytes abi))))
    (some? (get type-shape :kind nil))
    (let [(kind Any) (get type-shape :kind nil)]
      (if (instance? native.core.BytesKind kind)
        (and (instance? native.core.BytesShapeV0 layout-shape)
          (= parent-size (core/abi-bytes-span-size abi)))
        (let [(representation Any) (get layout-shape :representation nil)
              (bit-width Int) (get representation :bit-width 0)]
          (and (not (nil? representation))
            (> bit-width 0)
            (= 0 (mod bit-width 8))
            (<= (quot bit-width 8) parent-size)))))
    (some? (get type-shape :fields nil))
    (and (some? (get layout-shape :fields nil))
      (record-layout-valid? type-shape layout-shape layouts parent-size))
    (some? (get type-shape :variants nil))
    (and (some? (get layout-shape :variants nil))
      (union-layout-valid? type-shape layout-shape layouts parent-size))
    (some? (get type-shape :key-type nil))
    (map-layout-valid? type-shape layout-shape layouts parent-size)
    (and (some? (get type-shape :element-type nil))
      (some? (get type-shape :iteration-order nil)))
    (set-layout-valid? type-shape layout-shape layouts parent-size)
    (instance? native.core.BufferTypeV0 type-shape)
    (let [(element-type core/NativeId) (get type-shape :element-type)
          (element-layout (U core/LayoutDef Nil))
          (find-layout layouts element-type)]
      (and (instance? native.core.BufferShapeV0 layout-shape)
        (not (nil? element-layout))
        (dynamic-id= element-type (get layout-shape :element-type nil))
        (= (get layout-shape :stride-bytes 0)
          (core/layoutdef-size-bytes element-layout))
        (= (get layout-shape :align-bytes 0)
          (core/layoutdef-align-bytes element-layout))
        (> parent-size 0)))
    (some? (get type-shape :element-type nil))
    (let [(stride Int) (get layout-shape :stride-bytes 0)
          (element-type core/NativeId) (get type-shape :element-type)
          (layout-element Any) (get layout-shape :element-type nil)
          (element-layout (U core/LayoutDef Nil))
          (find-layout layouts element-type)]
      (and (not (nil? element-layout))
        (dynamic-id= element-type layout-element)
        (> stride 0)
        (aligned? stride (core/layoutdef-align-bytes element-layout))
        (<= (core/layoutdef-size-bytes element-layout) stride)))
    (some? (get type-shape :target-type nil))
    (let [(target-type core/NativeId) (get type-shape :target-type)
          (layout-target Any) (get layout-shape :target-type nil)]
      (and (dynamic-id= target-type layout-target)
        (not (nil? (find-layout layouts target-type)))
        (> parent-size 0)))
    (some? (get type-shape :content-type nil))
    (let [(content-type core/NativeId) (get type-shape :content-type)
          (layout-content Any) (get layout-shape :content-type nil)]
      (and (dynamic-id= content-type layout-content)
        (not (nil? (find-layout layouts content-type)))
        (> parent-size 0)))
    (some? (get type-shape :value-type nil))
    (let [(failure-type core/NativeId) (get type-shape :failure-type)
          (failure-def (U core/TypeDef Nil)) (find-type types failure-type)]
      (and (not (nil? failure-def))
        (some? (get layout-shape :variants nil))
        (union-layout-valid? (core/typedef-shape failure-def)
          layout-shape layouts parent-size)))
    :else false))

;; Independent attestation of the DECLARED target ABI: every handle-shaped
;; layout is exactly one pointer, and an owned byte span is {pointer, size_t}.
;; Measurement derives these; this checker asserts them from the profile alone.
(defn abi-widths-declared?
  [(abi core/AbiProfileV0)
   (layout core/LayoutDef)] Bool
  (let [(shape core/LayoutShapeV0) (core/layoutdef-shape layout)
        (size Int) (core/layoutdef-size-bytes layout)
        (alignment Int) (core/layoutdef-align-bytes layout)]
    (cond
      (or (instance? native.core.ReferenceShapeV0 shape)
        (instance? native.core.AtomCellShapeV0 shape)
        (instance? native.core.VectorShapeV0 shape)
        (instance? native.core.BufferShapeV0 shape)
        (instance? native.core.MapShapeV0 shape)
        (instance? native.core.SetShapeV0 shape))
      (and (= size (core/abiprofilev0-pointer-bytes abi))
        (= alignment (core/abiprofilev0-pointer-align abi)))

      (instance? native.core.ClosureShapeV0 shape)
      (and (= size (* 2 (core/abiprofilev0-pointer-bytes abi)))
        (= alignment (core/abiprofilev0-pointer-align abi)))

      (instance? native.core.BytesShapeV0 shape)
      (and (= size (core/abi-bytes-span-size abi))
        (= alignment (core/abi-bytes-span-align abi)))

      :else true)))

(defn type-layout-closed?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (type-def core/TypeDef)
   (abi core/AbiProfileV0)] Bool
  (let [(type-id core/NativeId) (core/typedef-id type-def)
        (layout (U core/LayoutDef Nil)) (find-layout layouts type-id)]
    (and (= 1 (layout-count layouts type-id))
      (not (nil? layout))
      (> (core/layoutdef-size-bytes layout) 0)
      (> (core/layoutdef-align-bytes layout) 0)
      (= 0 (mod (core/layoutdef-size-bytes layout)
        (core/layoutdef-align-bytes layout)))
      (abi-widths-declared? abi layout)
      (layout-shape-exact? types (core/typedef-shape type-def)
        (core/layoutdef-shape layout)
        layouts
        (core/layoutdef-size-bytes layout)
        abi))))

(defn closed-layouts
  [(program core/NativeCoreProgram)
   (abi core/AbiProfileV0)] ObligationVerdictV0
  (loop [index Int 0 types (Vec core/TypeDef) (core/nativecoreprogram-types program)]
    (if (>= index (count types))
      (->ObligationPassV0 (core/->ClosedLayoutsObligation true))
      (let [(type-def core/TypeDef) (nth types index)]
        (if (type-layout-closed? types (core/nativecoreprogram-layouts program) type-def
              abi)
          (recur (+ index 1) types)
          (->ClosedLayoutsDiagnosticV0 (core/typedef-id type-def)))))))

(defn outcome-type?
  [(types (Vec core/TypeDef))
   (type-id core/NativeId)] Bool
  (let [(type-def (U core/TypeDef Nil)) (find-type types type-id)]
    (and (not (nil? type-def))
      (some? (get (core/typedef-shape type-def) :value-type nil))
      (some? (get (core/typedef-shape type-def) :failure-type nil)))))

(defn checked-terminator-use
  [(function core/FunctionDef)
   (result-id core/NativeId)
   (result-type core/NativeId)
   (terminator core/Terminator)] CheckedUseScanV0
  (let [(switch-value Any) (get terminator :value-id nil)
        (return-value Any) (get terminator :value nil)
        (refs (Vec core/NativeId)) (core/terminator-ssa-refs terminator)]
    (cond
      (dynamic-id= switch-value result-id) (->CheckedUseScanV0 true true)
      (dynamic-id= return-value result-id)
      (->CheckedUseScanV0
        (dynamic-id= (get function :return-type nil) result-type)
        (dynamic-id= (get function :return-type nil) result-type))
      (core/id-in? refs result-id) (->CheckedUseScanV0 false false)
      :else (->CheckedUseScanV0 false true))))

(defn checked-block-use-scan
  [(function core/FunctionDef)
   (result-id core/NativeId)
   (result-type core/NativeId)
   (block core/BasicBlock)] CheckedUseScanV0
  (if
    (some? (some (fn [(instruction core/Instruction)] Bool
                   (core/id-in? (core/instruction-ssa-refs instruction)
                     result-id))
             (core/basicblock-instructions block)))
    (->CheckedUseScanV0 false false)
    (loop [term-index Int 0 handled Bool false
           terminators (Vec core/Terminator)
           (core/basicblock-terminators block)]
      (if (>= term-index (count terminators))
        (->CheckedUseScanV0 handled true)
        (let [(scan CheckedUseScanV0)
              (checked-terminator-use function result-id result-type
                (nth terminators term-index))]
          (if (checkedusescanv0-legal scan)
            (recur (+ term-index 1)
              (or handled (checkedusescanv0-handled scan))
              terminators)
            (->CheckedUseScanV0 false false)))))))

(defn checked-result-handled?
  [(function core/FunctionDef)
   (result-id core/NativeId)
   (result-type core/NativeId)] Bool
  (loop [block-index Int 0 handled Bool false
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (if (>= block-index (count blocks))
      handled
      (let [(scan CheckedUseScanV0)
            (checked-block-use-scan function result-id result-type
              (nth blocks block-index))]
        (if (checkedusescanv0-legal scan)
          (recur (+ block-index 1)
            (or handled (checkedusescanv0-handled scan))
            blocks)
          false)))))

(defn checked-instruction-valid?
  [(types (Vec core/TypeDef))
   (function core/FunctionDef)
   (instruction core/Instruction)] Bool
  (if (not (instance? native.core.CheckedInstruction instruction))
    true
    (let [(result core/SsaValueV0) (core/checkedinstruction-result instruction)
          (result-id core/NativeId) (core/ssavaluev0-id result)
          (result-type core/NativeId) (core/ssavaluev0-type-id result)]
      (and (outcome-type? types result-type)
        (checked-result-handled? function result-id result-type)))))

(defn function-checked-arithmetic?
  [(types (Vec core/TypeDef))
   (function core/FunctionDef)] Bool
  (every? (fn [(block core/BasicBlock)] Bool
            (every? (fn [(instruction core/Instruction)] Bool
                      (checked-instruction-valid? types function instruction))
              (core/basicblock-instructions block)))
    (core/functiondef-blocks function)))

(defn checked-arithmetic
  [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->CheckedOperationsObligation true))
      (let [(function core/FunctionDef) (nth functions index)]
        (if (function-checked-arithmetic? (core/nativecoreprogram-types program) function)
          (recur (+ index 1) functions)
          (->CheckedArithmeticDiagnosticV0
            (core/functiondef-id function)))))))

(defn find-function
  [(functions (Vec core/FunctionDef))
   (function-id core/NativeId)] (U core/FunctionDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count functions)) nil
      (core/native-id= (core/functiondef-id (nth functions index)) function-id)
      (nth functions index)
      :else (recur (+ index 1)))))

(defn find-abi
  [(abis (Vec core/AbiDeclV0))
   (abi-id core/NativeId)] (U core/AbiDeclV0 Nil)
  (loop [index Int 0]
    (cond
      (>= index (count abis)) nil
      (core/native-id= (core/abideclv0-id (nth abis index)) abi-id)
      (nth abis index)
      :else (recur (+ index 1)))))

(defn abi-type-legal?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (type-id core/NativeId)] Bool
  (and (not (nil? (find-type types type-id)))
    (= 1 (layout-count layouts type-id))))

(defn abi-value-legal?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (function core/FunctionDef)
   (value core/AbiValueV0)] Bool
  (let [(type-id core/NativeId) (get value :type-id)
        (ownership Any) (get value :ownership)
        (arena-region Any) (get ownership :region nil)
        (lifetime Any) (get value :lifetime-region nil)]
    (and (> (count (get value :name "")) 0)
      (abi-type-legal? types layouts type-id)
      (or (nil? arena-region)
        (core/id-in? (core/functiondef-regions function) arena-region))
      (or (nil? lifetime)
        (core/id-in? (core/functiondef-regions function) lifetime)))))

(defn abi-parameters-match?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (function core/FunctionDef)
   (values (Vec core/AbiValueV0))] Bool
  (let [(parameters (Vec core/Parameter)) (core/functiondef-parameters function)]
    (and (= (count parameters) (count values))
      (loop [index Int 0]
        (if (>= index (count values))
          true
          (let [(value core/AbiValueV0) (nth values index)]
            (if (and (abi-value-legal? types layouts function value)
                  (core/native-id= (core/parameter-type-id (nth parameters index))
                    (get value :type-id)))
              (recur (+ index 1))
              false)))))))

(defn abi-result-matches?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (function core/FunctionDef)
   (result (U core/AbiValueV0 Nil))] Bool
  (let [(return-type Any) (get function :return-type nil)]
    (cond
      (and (nil? result) (nil? return-type)) true
      (or (nil? result) (nil? return-type)) false
      :else
      (and (abi-value-legal? types layouts function result)
        (dynamic-id= (get result :type-id) return-type)))))

(defn failure-type-legal?
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (failure-type core/NativeId)] Bool
  (and (abi-type-legal? types layouts failure-type)
    (> (count (variant-ids-for-type types failure-type)) 0)))

(defn import-abi-value-legal?
  [(program core/NativeCoreProgram)
   (types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (value core/AbiValueV0)] Bool
  (let [(ownership core/OwnershipRuleV0) (core/abivaluev0-ownership value)
        (arena-region Any) (get ownership :region nil)
        (lifetime (U core/NativeId Nil))
        (core/abivaluev0-lifetime-region value)]
    (and (> (count (core/abivaluev0-name value)) 0)
      (abi-type-legal? types layouts (core/abivaluev0-type-id value))
      (or (nil? arena-region)
        (core/id-in? (core/nativecoreprogram-allowed-regions program) arena-region))
      (or (nil? lifetime)
        (core/id-in? (core/nativecoreprogram-allowed-regions program) lifetime)))))

(defn named-variant
  [(variants (Vec core/TypeVariant))
   (name String)] (U core/TypeVariant Nil)
  (loop [index Int 0]
    (cond
      (>= index (count variants)) nil
      (= name (core/typevariant-name (nth variants index)))
      (nth variants index)
      :else (recur (+ index 1)))))

(defn i64-type? [(types (Vec core/TypeDef)) (type-id core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (find-type types type-id)]
    (if (nil? definition)
      false
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (and (instance? native.core.AtomType shape)
          (instance? native.core.I64Kind (core/atomtype-kind shape)))))))

(defn optional-i64-type?
  [(types (Vec core/TypeDef))
   (type-id (U core/NativeId Nil))] Bool
  (if (nil? type-id) false (i64-type? types type-id)))

(defn host-outcome-result-legal?
  [(types (Vec core/TypeDef))
   (result core/AbiValueV0)] Bool
  (let [(outcome (U core/TypeDef Nil))
        (find-type types (core/abivaluev0-type-id result))]
    (if (nil? outcome)
      false
      (let [(shape core/TypeShape) (core/typedef-shape outcome)]
        (if (not (instance? native.core.OutcomeType shape))
          false
          (let [(value-type core/NativeId) (core/outcometype-value-type shape)
                (failure (U core/TypeDef Nil))
                (find-type types (core/outcometype-failure-type shape))]
            (if (nil? failure)
              false
              (let [(failure-shape core/TypeShape) (core/typedef-shape failure)]
                (if (not (instance? native.core.UnionType failure-shape))
                  false
                  (let [(variants (Vec core/TypeVariant))
                        (core/uniontype-variants failure-shape)
                        (ok (U core/TypeVariant Nil))
                        (named-variant variants "ok")
                        (peer (U core/TypeVariant Nil))
                        (named-variant variants "peer-closed")
                        (error (U core/TypeVariant Nil))
                        (named-variant variants "error")]
                    (and (or (= 2 (count variants)) (= 3 (count variants)))
                      (not (nil? ok)) (not (nil? error))
                      (= (= 3 (count variants)) (not (nil? peer)))
                      (or (and (unit-type? types value-type)
                            (nil? (core/typevariant-payload-type ok)))
                        (dynamic-id= value-type
                          (core/typevariant-payload-type ok)))
                      (if (nil? peer)
                        true
                        (nil? (core/typevariant-payload-type peer)))
                      (optional-i64-type? types
                        (core/typevariant-payload-type error)))))))))))))

(defn abi-decl-legal?
  [(program core/NativeCoreProgram)
   (abi core/AbiDeclV0)] Bool
  (let [(function (U core/FunctionDef Nil))
        (find-function (core/nativecoreprogram-functions program) (get abi :function-id))
        (types (Vec core/TypeDef)) (core/nativecoreprogram-types program)
        (layouts (Vec core/LayoutDef)) (core/nativecoreprogram-layouts program)]
    (and (> (count (get abi :symbol "")) 0)
      (> (count (get abi :version "")) 0)
      (> (count (get abi :layout-digest "")) 0)
      (some? (get abi :direction nil))
      (some? (get abi :convention nil))
      (failure-type-legal? types layouts (get abi :failure-type))
      (if (instance? native.core.AbiImportV0 (core/abideclv0-direction abi))
        (let [(result (U core/AbiValueV0 Nil)) (core/abideclv0-result abi)]
          (and
          (or (instance? native.core.RestrictedCAbiV0
                (core/abideclv0-convention abi))
            (instance? native.core.RestrictedCOptionalOutAbiV0
              (core/abideclv0-convention abi))
            (instance? native.core.RestrictedCOutcomeOutAbiV0
              (core/abideclv0-convention abi)))
          (every? (fn [(value core/AbiValueV0)] Bool
                    (import-abi-value-legal? program types layouts value))
            (core/abideclv0-parameters abi))
          (cond
            (instance? native.core.RestrictedCOptionalOutAbiV0
              (core/abideclv0-convention abi))
            (and (not (nil? result))
              (instance? native.core.ArenaOwnedV0
                (core/abivaluev0-ownership result))
              (import-abi-value-legal? program types layouts result))

            (instance? native.core.RestrictedCOutcomeOutAbiV0
              (core/abideclv0-convention abi))
            (and (not (nil? result))
              (import-abi-value-legal? program types layouts result)
              (host-outcome-result-legal? types result))

            :else
            (or (nil? result)
              (import-abi-value-legal? program types layouts result)))
          (core/ids-in? (core/abideclv0-required-effects abi)
            (core/nativecoreprogram-allowed-effects program))
          (core/ids-in? (core/abideclv0-required-capabilities abi)
            (core/nativecoreprogram-allowed-capabilities program))))
        (and (not (nil? function))
          (abi-parameters-match? types layouts function
            (get abi :parameters []))
          (abi-result-matches? types layouts function (get abi :result nil))
          (core/ids-in? (get abi :required-effects [])
            (core/functiondef-effects function))
          (core/ids-in? (get abi :required-capabilities [])
            (core/functiondef-capabilities function)))))))

(defn extern-call-legal?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)
   (instruction core/Instruction)] Bool
  (if (not (instance? native.core.ExternCallInstruction instruction))
    true
    (let [(abi (U core/AbiDeclV0 Nil))
          (find-abi (core/nativecoreprogram-abis program)
            (core/externcallinstruction-abi-id instruction))]
      (if (nil? abi)
        false
        (let [(arguments (Vec core/NativeId))
              (core/externcallinstruction-arguments instruction)
              (parameters (Vec core/AbiValueV0))
              (core/abideclv0-parameters abi)
              (types (Vec core/TypeDef)) (core/nativecoreprogram-types program)
              (result (U core/AbiValueV0 Nil)) (core/abideclv0-result abi)
              (arena (U core/NativeId Nil))
              (core/externcallinstruction-arena-id instruction)]
          (and
            (instance? native.core.AbiImportV0
              (core/abideclv0-direction abi))
            (= (count arguments) (count parameters))
            (loop [index Int 0]
              (if (>= index (count arguments))
                true
                (let [(site DefSiteV0)
                      (find-def-site function (nth arguments index))]
                  (if (and (defsitev0-found site)
                        (core/native-id= (defsitev0-type-id site)
                          (core/abivaluev0-type-id (nth parameters index))))
                    (recur (+ index 1))
                    false))))
            (if (nil? result)
              (unit-type? types
                (core/ssavaluev0-type-id
                  (core/externcallinstruction-result instruction)))
              (core/native-id=
                (core/ssavaluev0-type-id
                  (core/externcallinstruction-result instruction))
                (core/abivaluev0-type-id result)))
            (if (nil? result)
              (nil? arena)
              (if (instance? native.core.ArenaOwnedV0
                    (core/abivaluev0-ownership result))
                (let [(region (U core/NativeId Nil))
                      (get (core/abivaluev0-ownership result) :region nil)]
                  (and (not (nil? region))
                    (core/id-in? (core/functiondef-regions function) region)
                    (not (nil? arena))
                    (defsitev0-found (find-def-site function arena))))
                (nil? arena)))
            (core/ids-in? (core/abideclv0-required-effects abi)
              (core/functiondef-effects function))
            (core/ids-in? (core/abideclv0-required-capabilities abi)
              (core/functiondef-capabilities function))))))))

(defn extern-calls-legal? [(program core/NativeCoreProgram)] Bool
  (every? (fn [(function core/FunctionDef)] Bool
            (every? (fn [(block core/BasicBlock)] Bool
                      (every? (fn [(instruction core/Instruction)] Bool
                                (extern-call-legal? program function instruction))
                        (core/basicblock-instructions block)))
              (core/functiondef-blocks function)))
    (core/nativecoreprogram-functions program)))

(defn legal-abi [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 abis (Vec core/AbiDeclV0)
         (core/nativecoreprogram-abis program)]
    (if (>= index (count abis))
      (if (extern-calls-legal? program)
        (->ObligationPassV0 (core/->LegalAbiObligation true))
        (->LegalAbiDiagnosticV0 (obligation-id "extern-call")))
      (let [(abi core/AbiDeclV0) (nth abis index)]
        (if (abi-decl-legal? program abi)
          (recur (+ index 1) abis)
          (->LegalAbiDiagnosticV0 (get abi :id)))))))

(defn remove-id
  [(ids (Vec core/NativeId))
   (target core/NativeId)] (Vec core/NativeId)
  (filterv (fn [(candidate core/NativeId)] Bool
             (not (core/native-id= candidate target))) ids))

(defn token-state-consume
  [(state TokenStateV0)
   (consumed (Vec core/NativeId))] TokenStateV0
  (if (or (not (tokenstatev0-valid state))
        (not (core/unique-ids? consumed))
        (not (core/ids-in? consumed (tokenstatev0-live state))))
    (->TokenStateV0 (tokenstatev0-live state) (tokenstatev0-seen state) false)
    (loop [index Int 0 live (Vec core/NativeId) (tokenstatev0-live state)]
      (if (>= index (count consumed))
        (->TokenStateV0 live (tokenstatev0-seen state) true)
        (recur (+ index 1) (remove-id live (nth consumed index)))))))

(defn produced-token-ids
  [(produced (Vec core/ResourceTokenV0))] (Vec core/NativeId)
  (mapv (fn [(token core/ResourceTokenV0)] core/NativeId
          (get token :id)) produced))

(defn token-state-produce
  [(state TokenStateV0)
   (produced (Vec core/ResourceTokenV0))] TokenStateV0
  (let [(produced-ids (Vec core/NativeId)) (produced-token-ids produced)]
    (if (or (not (tokenstatev0-valid state))
          (not (core/unique-ids? produced-ids))
          (some? (some (fn [(token-id core/NativeId)] Bool
                         (core/id-in? (tokenstatev0-seen state) token-id))
                   produced-ids)))
      (->TokenStateV0 (tokenstatev0-live state) (tokenstatev0-seen state) false)
      (->TokenStateV0
        (core/append-ids (tokenstatev0-live state) produced-ids)
        (core/append-ids (tokenstatev0-seen state) produced-ids)
        true))))

(defn apply-token-flow
  [(state TokenStateV0)
   (flow core/TokenFlowV0)] TokenStateV0
  (token-state-produce
    (token-state-consume state (get flow :consumed []))
    (get flow :produced [])))

(defn instruction-token-state
  [(state TokenStateV0)
   (instruction core/Instruction)] TokenStateV0
  (let [(flow Any) (get instruction :tokens nil)]
    (if (nil? flow) state (apply-token-flow state flow))))

(defn block-token-state
  [(state TokenStateV0)
   (block core/BasicBlock)] TokenStateV0
  (loop [index Int 0 current TokenStateV0 state
         instructions (Vec core/Instruction) (core/basicblock-instructions block)]
    (if (or (>= index (count instructions)) (not (tokenstatev0-valid current)))
      current
      (recur (+ index 1)
        (instruction-token-state current (nth instructions index))
        instructions))))

(defrecord TokenVisitV0
  [(block-id core/NativeId)
   (live (Vec core/NativeId))
   (seen (Vec core/NativeId))])

(defrecord TokenWorkV0
  [(block-id core/NativeId)
   (state TokenStateV0)
   (path (Vec TokenVisitV0))])

(defn token-visit
  [(visited (Vec TokenVisitV0))
   (block-id core/NativeId)] (U TokenVisitV0 Nil)
  (loop [index Int 0]
    (cond
      (>= index (count visited)) nil
      (core/native-id= (tokenvisitv0-block-id (nth visited index)) block-id)
      (nth visited index)
      :else (recur (+ index 1)))))

(defn token-sets-equal?
  [(left (Vec core/NativeId))
   (right (Vec core/NativeId))] Bool
  (and (= (count left) (count right)) (core/ids-in? left right)))

(defn token-visit-matches? [(visit TokenVisitV0) (state TokenStateV0)] Bool
  (and (token-sets-equal? (tokenvisitv0-live visit) (tokenstatev0-live state))
    (token-sets-equal? (tokenvisitv0-seen visit) (tokenstatev0-seen state))))

(defn token-state-visited?
  [(visited (Vec TokenVisitV0))
   (block-id core/NativeId)
   (state TokenStateV0)] Bool
  (loop [index Int 0]
    (cond
      (>= index (count visited)) false
      (and (core/native-id= (tokenvisitv0-block-id (nth visited index)) block-id)
        (token-visit-matches? (nth visited index) state)) true
      :else (recur (+ index 1)))))

(defn token-paths-valid?
  [(function core/FunctionDef)
   (block-id core/NativeId)
   (state TokenStateV0)
   (visited (Vec TokenVisitV0))] Bool
  ;; Memoized block states collapse diamonds; each work item retains the back-edge path.
  (loop [position Int 0
         work (Vec TokenWorkV0) [(->TokenWorkV0 block-id state visited)]
         memo (Vec TokenVisitV0) []]
    (if (>= position (count work))
      true
      (let [(item TokenWorkV0) (nth work position)
            (current-id core/NativeId) (tokenworkv0-block-id item)
            (current-state TokenStateV0) (tokenworkv0-state item)
            (path (Vec TokenVisitV0)) (tokenworkv0-path item)
            (entered (U TokenVisitV0 Nil)) (token-visit path current-id)]
        (if (some? entered)
          (if (token-sets-equal? (tokenvisitv0-live entered)
                (tokenstatev0-live current-state))
            (recur (+ position 1) work memo)
            false)
          (if (token-state-visited? memo current-id current-state)
            (recur (+ position 1) work memo)
            (let [(block (U core/BasicBlock Nil))
                  (find-block (core/functiondef-blocks function) current-id)]
              (if (nil? block)
                false
                (let [(next-state TokenStateV0)
                      (block-token-state current-state block)
                      (successors (Vec core/NativeId)) (block-successors block)
                      (visit TokenVisitV0)
                      (->TokenVisitV0 current-id
                        (tokenstatev0-live current-state)
                        (tokenstatev0-seen current-state))
                      (next-path (Vec TokenVisitV0)) (conj path visit)
                      (next-memo (Vec TokenVisitV0)) (conj memo visit)]
                  (cond
                    (not (tokenstatev0-valid next-state)) false
                    (= 0 (count successors))
                    (if (= 0 (count (tokenstatev0-live next-state)))
                      (recur (+ position 1) work next-memo)
                      false)
                    :else
                    (let [(next-work (Vec TokenWorkV0))
                          (mapv
                            (fn [(successor core/NativeId)] TokenWorkV0
                              (->TokenWorkV0 successor next-state next-path))
                            successors)]
                      (recur (+ position 1) (vec (concat work next-work))
                        next-memo))))))))))))

(defn find-capability
  [(capabilities (Vec core/CapabilityDef))
   (capability-id core/NativeId)] (U core/CapabilityDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count capabilities)) nil
      (core/native-id= (core/capabilitydef-id (nth capabilities index))
        capability-id)
      (nth capabilities index)
      :else (recur (+ index 1)))))

(defn affine-function-capabilities
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)] (Vec core/NativeId)
  (filterv (fn [(capability-id core/NativeId)] Bool
             (let [(capability (U core/CapabilityDef Nil))
                   (find-capability (core/nativecoreprogram-capabilities program)
                     capability-id)]
               (and (not (nil? capability))
                 (get capability :affine false))))
    (core/functiondef-capabilities function)))

(defn function-tokens-discharged?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)] Bool
  (let [(initial (Vec core/NativeId))
        (core/append-ids (core/functiondef-regions function)
          (affine-function-capabilities program function))]
    (and (core/unique-ids? initial)
      (token-paths-valid? function (core/functiondef-entry-block function)
        (->TokenStateV0 initial initial true) []))))

(defn discharged-tokens
  [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->DischargedTokensObligation true))
      (let [(function core/FunctionDef) (nth functions index)]
        (if (function-tokens-discharged? program function)
          (recur (+ index 1) functions)
          (->DischargedTokensDiagnosticV0
            (core/functiondef-id function)))))))

(defn find-effect
  [(effects (Vec core/EffectDef))
   (effect-id core/NativeId)] (U core/EffectDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count effects)) nil
      (core/native-id= (core/effectdef-id (nth effects index)) effect-id)
      (nth effects index)
      :else (recur (+ index 1)))))

(defn effect-covers-store?
  [(kind Any)
   (region core/NativeId)
   (capability core/NativeId)] Bool
  (or (= kind (core/->WriteEffect region))
    (= kind (core/->AtomicEffect region capability))))

(defn effect-covers-read? [(kind Any) (region core/NativeId)] Bool
  (= kind (core/->ReadEffect region)))

(defn effect-covers-allocation? [(kind Any) (region core/NativeId)] Bool
  (= kind (core/->AllocateEffect region)))

(defn effect-covers-atom-state?
  [(kind Any)
   (region core/NativeId)
   (capability core/NativeId)] Bool
  (= kind (core/->AtomicEffect region capability)))

(defn declared-effect-covers?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)
   (region core/NativeId)
   (capability core/NativeId)
   (allocation Bool)] Bool
  (some? (some (fn [(effect-id core/NativeId)] Bool
                 (let [(effect (U core/EffectDef Nil))
                       (find-effect (core/nativecoreprogram-effects program) effect-id)]
                   (and (not (nil? effect))
                     (if allocation
                       (effect-covers-allocation? (core/effectdef-kind effect) region)
                       (effect-covers-store? (core/effectdef-kind effect)
                         region capability)))))
           (core/functiondef-effects function))))

(defn declared-read-effect-covers?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)
   (region core/NativeId)]
  Bool
  (some?
    (some
      (fn [(effect-id core/NativeId)] Bool
        (let [(effect (U core/EffectDef Nil))
              (find-effect (core/nativecoreprogram-effects program) effect-id)]
          (and (not (nil? effect))
            (effect-covers-read? (core/effectdef-kind effect) region))))
      (core/functiondef-effects function))))

(defn capability-authorizes?
  [(program core/NativeCoreProgram)
   (capability-id core/NativeId)
   (region core/NativeId)
   (mode String)]
  Bool
  (let [(capability (U core/CapabilityDef Nil))
        (find-capability (core/nativecoreprogram-capabilities program)
          capability-id)]
    (and (not (nil? capability))
      (some? (core/capabilitydef-region capability))
      (dynamic-id= region (core/capabilitydef-region capability))
      (let [(kind core/CapabilityKind) (core/capabilitydef-kind capability)]
        (cond
          (= mode "read") (instance? native.core.ReadCapability kind)
          (= mode "write") (instance? native.core.WriteCapability kind)
          (= mode "allocate") (instance? native.core.AllocateCapability kind)
          :else false)))))

(defn buffer-root-region?
  [(program core/NativeCoreProgram) (region-id core/NativeId)] Bool
  (some?
    (some
      (fn [(region core/RegionDef)] Bool
        (and (core/native-id= (core/regiondef-id region) region-id)
          (nil? (core/regiondef-parent region))
          (instance? native.core.ArenaRegion (core/regiondef-kind region))))
      (core/nativecoreprogram-regions program))))

(defn store-resources [(store core/StoreOp)] (Vec core/NativeId)
  [(get store :region) (get store :capability)])

;; An epoch a callee opens closes before that callee returns — leak freedom
;; proves it on every path — so neither the region nor the effect naming it
;; crosses the call boundary. A caller is required to declare only what it can
;; observe, which is the callee's effects minus its epoch-local ones.
(defn epoch-local-region?
  [(regions (Vec core/RegionDef))
   (region-id Any)] Bool
  (and (some? region-id)
    (some?
      (some
        (fn [(region core/RegionDef)] Bool
          (and (= (get region-id :value "")
                 (get (core/regiondef-id region) :value ""))
            (instance? native.core.ArenaRegion (core/regiondef-kind region))
            (some? (core/regiondef-parent region))))
        regions))))

(defn callee-exported-effects
  [(program core/NativeCoreProgram)
   (callee core/FunctionDef)] (Vec core/NativeId)
  (filterv
    (fn [(effect-id core/NativeId)] Bool
      (let [(effect (U core/EffectDef Nil))
            (find-effect (core/nativecoreprogram-effects program) effect-id)]
        (or (nil? effect)
          (not (epoch-local-region? (core/nativecoreprogram-regions program)
                 (get (core/effectdef-kind effect) :region nil))))))
    (core/functiondef-effects callee)))

(defn instruction-effects-bounded?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)
   (instruction core/Instruction)] Bool
  (let [(store Any) (get instruction :store nil)
        (allocation-region Any) (get instruction :region nil)
        (allocation-capability Any) (get instruction :capability nil)
        (abi-id Any) (get instruction :abi-id nil)
        (callee-id Any) (get instruction :function-id nil)]
    (cond
      (instance? native.core.BufferAllocateInstructionV0 instruction)
      (and
        (buffer-root-region? program allocation-region)
        (core/id-in? (core/functiondef-regions function) allocation-region)
        (core/id-in? (core/functiondef-capabilities function)
          allocation-capability)
        (capability-authorizes? program allocation-capability
          allocation-region "allocate")
        (declared-effect-covers? program function allocation-region
          allocation-capability true))
      (or (instance? native.core.BufferLengthInstructionV0 instruction)
        (instance? native.core.BufferGetCheckedInstructionV0 instruction))
      (and
        (buffer-root-region? program allocation-region)
        (core/id-in? (core/functiondef-regions function) allocation-region)
        (core/id-in? (core/functiondef-capabilities function)
          allocation-capability)
        (capability-authorizes? program allocation-capability
          allocation-region "read")
        (declared-read-effect-covers? program function allocation-region))
      (instance? native.core.BufferSetCheckedInstructionV0 instruction)
      (and
        (buffer-root-region? program allocation-region)
        (core/id-in? (core/functiondef-regions function) allocation-region)
        (core/id-in? (core/functiondef-capabilities function)
          allocation-capability)
        (capability-authorizes? program allocation-capability
          allocation-region "write")
        (declared-effect-covers? program function allocation-region
          allocation-capability false))
      (instance? native.core.AtomStateInstruction instruction)
      (let [(region core/NativeId)
            (core/atomstateinstruction-region instruction)
            (capability core/NativeId)
            (core/atomstateinstruction-capability instruction)]
        (and (core/id-in? (core/functiondef-regions function) region)
          (core/id-in? (core/functiondef-capabilities function) capability)
          (some?
            (some
              (fn [(effect-id core/NativeId)] Bool
                (let [(effect (U core/EffectDef Nil))
                      (find-effect (core/nativecoreprogram-effects program) effect-id)]
                  (and (not (nil? effect))
                    (effect-covers-atom-state? (core/effectdef-kind effect)
                      region capability))))
              (core/functiondef-effects function)))))
      (instance? native.core.AtomSwapInstruction instruction)
      (let [(updater (U core/FunctionDef Nil))
            (find-function (core/nativecoreprogram-functions program)
              (core/atomswapinstruction-updater-id instruction))]
        (and (not (nil? updater))
          (= 0 (count (core/functiondef-regions updater)))
          (= 0 (count (core/functiondef-capabilities updater)))
          (every?
            (fn [(effect-id core/NativeId)] Bool
              (let [(effect (U core/EffectDef Nil))
                    (find-effect (core/nativecoreprogram-effects program) effect-id)]
                (and (not (nil? effect))
                  (instance? native.core.PureEffect
                    (core/effectdef-kind effect)))))
            (core/functiondef-effects updater))))
      (not (nil? store))
      (let [(resources (Vec core/NativeId)) (store-resources store)
            (region core/NativeId) (nth resources 0)
            (capability core/NativeId) (nth resources 1)]
        (and (core/id-in? (core/functiondef-regions function) region)
          (core/id-in? (core/functiondef-capabilities function) capability)
          (declared-effect-covers? program function region capability false)))
      ;; A non-allocating writer acquires the arena under the write capability,
      ;; so the acquire is covered by a write effect as well as an allocate one.
      (instance? native.core.ArenaInstruction instruction)
      (let [(region core/NativeId) (core/arenainstruction-region instruction)
            (capability core/NativeId)
            (core/arenainstruction-capability instruction)]
        (and (core/id-in? (core/functiondef-regions function) region)
          (core/id-in? (core/functiondef-capabilities function) capability)
          (or (declared-effect-covers? program function region capability true)
            (or (declared-effect-covers? program function region capability false)
              (declared-read-effect-covers? program function region)))))
      (and (not (nil? allocation-region)) (not (nil? allocation-capability)))
      (and (core/id-in? (core/functiondef-regions function) allocation-region)
        (core/id-in? (core/functiondef-capabilities function)
          allocation-capability)
        (declared-effect-covers? program function allocation-region
          allocation-capability true))
      (not (nil? abi-id))
      (let [(abi (U core/AbiDeclV0 Nil))
            (find-abi (core/nativecoreprogram-abis program) abi-id)]
        (and (not (nil? abi))
          (instance? native.core.AbiImportV0
            (core/abideclv0-direction abi))
          (core/ids-in? (core/abideclv0-required-effects abi)
            (core/functiondef-effects function))
          (core/ids-in? (core/abideclv0-required-capabilities abi)
            (core/functiondef-capabilities function))))
      (not (nil? callee-id))
      (let [(callee (U core/FunctionDef Nil))
            (find-function (core/nativecoreprogram-functions program) callee-id)]
        (and (not (nil? callee))
          (core/ids-in? (callee-exported-effects program callee)
            (core/functiondef-effects function))
          (core/ids-in? (core/functiondef-capabilities callee)
            (core/functiondef-capabilities function))))
      :else true)))

(defn function-effects-bounded?
  [(program core/NativeCoreProgram)
   (function core/FunctionDef)] Bool
  (every? (fn [(block core/BasicBlock)] Bool
            (every? (fn [(instruction core/Instruction)] Bool
                      (instruction-effects-bounded? program function instruction))
              (core/basicblock-instructions block)))
    (core/functiondef-blocks function)))

(defn bounded-effects [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->BoundedEffectsObligation true))
      (let [(function core/FunctionDef) (nth functions index)]
        (if (function-effects-bounded? program function)
          (recur (+ index 1) functions)
          (->BoundedEffectsDiagnosticV0
            (core/functiondef-id function)))))))

;; --- Obligation 8 (epoch soundness) and 9 (leak freedom) ---
;;
;; The region tree orders lifetimes: a parent region strictly outlives its
;; children. Epoch soundness forbids old-to-young references — every written
;; value's epoch must be an ancestor-or-equal of its destination's epoch.
;; Leak freedom requires every opened epoch (an ArenaRegion row with a parent)
;; to close via ArenaCloseInstructionV0 on all paths, LIFO in the region tree.
;; Root regions carry driver lifetime, so root-epoch values pass every write
;; and root regions never close. Epoch-free values (scalars and values whose
;; type carries no handle) pass every check.

(defn find-region
  [(regions (Vec core/RegionDef))
   (region-id core/NativeId)] (U core/RegionDef Nil)
  (loop [index Int 0]
    (cond
      (>= index (count regions)) nil
      (core/native-id= (core/regiondef-id (nth regions index)) region-id)
      (nth regions index)
      :else (recur (+ index 1)))))

(defn root-region?
  [(regions (Vec core/RegionDef))
   (region-id core/NativeId)] Bool
  (let [(region (U core/RegionDef Nil)) (find-region regions region-id)]
    (and (some? region) (nil? (core/regiondef-parent region)))))

(defn epoch-region?
  [(regions (Vec core/RegionDef))
   (region-id core/NativeId)] Bool
  (let [(region (U core/RegionDef Nil)) (find-region regions region-id)]
    (and (some? region)
      (instance? native.core.ArenaRegion (core/regiondef-kind region))
      (some? (core/regiondef-parent region)))))

(defn region-on-ancestor-chain?
  [(regions (Vec core/RegionDef))
   (target core/NativeId)
   (chain-start core/NativeId)] Bool
  (loop [current core/NativeId chain-start
         budget Int (+ 1 (count regions))]
    (if (core/native-id= current target)
      true
      (let [(region (U core/RegionDef Nil)) (find-region regions current)]
        (if (nil? region)
          false
          (let [(parent (U core/NativeId Nil)) (core/regiondef-parent region)]
            (if (or (nil? parent) (<= budget 0))
              false
              (recur parent (- budget 1)))))))))

;; A value with no epoch is a scalar or a caller-owned parameter — it always
;; outlives any destination the program can name. A root-epoch value carries
;; driver lifetime. Otherwise the value's epoch must sit on the destination's
;; parent chain; an unknown destination refuses conservatively.
(defn epoch-write-legal?
  [(regions (Vec core/RegionDef))
   (value-epoch (U core/NativeId Nil))
   (destination-epoch (U core/NativeId Nil))] Bool
  (cond
    (nil? value-epoch) true
    (root-region? regions value-epoch) true
    (nil? destination-epoch) false
    :else (region-on-ancestor-chain? regions value-epoch destination-epoch)))

(defn epoch-incomparable-id [] core/NativeId
  (obligation-id "epoch-incomparable"))

;; Whether a value of this type can reference region storage: Text, Bytes,
;; Keyword, and Ref atoms are handles; records and unions carry handles when
;; any field or payload does; collections, references, atom cells, functions,
;; and outcomes are treated as handle-carrying. Unknown types refuse
;; conservatively (treated as handles).
(defn type-carries-handles-with-budget?
  [(types (Vec core/TypeDef))
   (type-id core/NativeId)
   (budget Int)] Bool
  (if (<= budget 0)
    true
    (let [(definition (U core/TypeDef Nil)) (find-type types type-id)]
      (if (nil? definition)
        true
        (let [(shape core/TypeShape) (core/typedef-shape definition)]
          (cond
            (instance? native.core.AtomType shape)
            (let [(kind core/AtomKind) (core/atomtype-kind shape)]
              (or (instance? native.core.TextKind kind)
                (instance? native.core.BytesKind kind)
                (instance? native.core.KeywordKind kind)
                (instance? native.core.RefKind kind)))

            (instance? native.core.RecordType shape)
            (some?
              (some
                (fn [(field core/TypeField)] Bool
                  (type-carries-handles-with-budget? types
                    (core/typefield-type-id field) (- budget 1)))
                (core/recordtype-fields shape)))

            (instance? native.core.UnionType shape)
            (some?
              (some
                (fn [(variant core/TypeVariant)] Bool
                  (let [(payload (U core/NativeId Nil))
                        (core/typevariant-payload-type variant)]
                    (and (some? payload)
                      (type-carries-handles-with-budget? types payload
                        (- budget 1)))))
                (core/uniontype-variants shape)))

            :else true))))))

(defn type-carries-handles?
  [(types (Vec core/TypeDef))
   (type-id core/NativeId)] Bool
  (type-carries-handles-with-budget? types type-id (+ 1 (count types))))

;; The arena SSA operand an instruction allocates through, wherever the
;; instruction family keeps it (top level, text builtin, codec operation).
(defn instruction-arena-operand
  [(instruction core/Instruction)] (U core/NativeId Nil)
  (let [(top Any) (get instruction :arena-id nil)
        (operation Any) (get instruction :operation nil)
        (builtin Any) (get instruction :builtin nil)]
    (cond
      (some? top) top
      (some? operation) (get operation :arena-id nil)
      (some? builtin) (get builtin :arena-id nil)
      :else nil)))

(defn function-arena-region
  [(function core/FunctionDef)
   (arena-value-id core/NativeId)] (U core/NativeId Nil)
  (loop [block-position Int 0
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (if (>= block-position (count blocks))
      nil
      (let [(instructions (Vec core/Instruction))
            (core/basicblock-instructions (nth blocks block-position))
            (found (U core/NativeId Nil))
            (loop [position Int 0]
              (if (>= position (count instructions))
                nil
                (let [(instruction core/Instruction) (nth instructions position)]
                  (if (and (instance? native.core.ArenaInstruction instruction)
                        (core/native-id= arena-value-id
                          (core/instruction-result-id instruction)))
                    (core/arenainstruction-region instruction)
                    (recur (+ position 1))))))]
        (if (nil? found)
          (recur (+ block-position 1) blocks)
          found)))))

;; Every SSA value that NAMES a region rather than living in one: the arena
;; handle an ArenaInstruction acquires and the cell-table handle an
;; AtomStateInstruction acquires. Built once per function so the epoch walk
;; resolves a destination by lookup instead of rescanning the blocks.
(defn function-region-handles
  [(function core/FunctionDef)] (Map String core/NativeId)
  (loop [block-position Int 0
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)
         handles (Map String core/NativeId) {}]
    (if (>= block-position (count blocks))
      handles
      (let [(instructions (Vec core/Instruction))
            (core/basicblock-instructions (nth blocks block-position))]
        (recur (+ block-position 1) blocks
          (loop [position Int 0
                 inner (Map String core/NativeId) handles]
            (if (>= position (count instructions))
              inner
              (let [(instruction core/Instruction) (nth instructions position)]
                (recur (+ position 1)
                  (cond
                    (instance? native.core.ArenaInstruction instruction)
                    (assoc inner
                      (native-id-key (core/instruction-result-id instruction))
                      (core/arenainstruction-region instruction))

                    (instance? native.core.AtomStateInstruction instruction)
                    (assoc inner
                      (native-id-key (core/instruction-result-id instruction))
                      (core/atomstateinstruction-region instruction))

                    :else inner))))))))))

;; A region handle is a capability, not storage. It carries no value into the
;; region it names, so it contributes no epoch to anything built from it —
;; conflating the two is what made an atom deref (cell handle + state handle)
;; merge two unrelated roots into the incomparable sentinel.
(defn region-handle?
  [(handles (Map String core/NativeId))
   (value-id core/NativeId)] Bool
  (some? (get handles (native-id-key value-id))))

(defn handle-region
  [(handles (Map String core/NativeId))
   (value-id core/NativeId)] (U core/NativeId Nil)
  (get handles (native-id-key value-id)))

(defn epoch-of
  [(epochs (Map String core/NativeId))
   (value-id core/NativeId)] (U core/NativeId Nil)
  (get epochs (native-id-key value-id)))

;; Merge keeps the YOUNGER of two comparable epochs — the conservative
;; representative for both ancestor and closed-region checks — and collapses
;; incomparable epochs to a sentinel that fails every non-free check.
;; Distinct ROOTS are not incomparable: a root never closes and carries driver
;; lifetime, so every check below (write legality, closed-region escape,
;; root-or-free) answers the same for any of them.
(defn merge-epochs
  [(regions (Vec core/RegionDef))
   (left (U core/NativeId Nil))
   (right (U core/NativeId Nil))] (U core/NativeId Nil)
  (cond
    (nil? left) right
    (nil? right) left
    (core/native-id= left right) left
    (and (root-region? regions left) (root-region? regions right)) left
    (region-on-ancestor-chain? regions left right) right
    (region-on-ancestor-chain? regions right left) left
    :else (epoch-incomparable-id)))

(defn merge-epoch-into
  [(regions (Vec core/RegionDef))
   (epochs (Map String core/NativeId))
   (value-id core/NativeId)
   (epoch (U core/NativeId Nil))] (Map String core/NativeId)
  (if (nil? epoch)
    epochs
    (let [(key String) (native-id-key value-id)
          (merged (U core/NativeId Nil))
          (merge-epochs regions (get epochs key) epoch)]
      (if (nil? merged) epochs (assoc epochs key merged)))))

(defn instruction-epoch
  [(regions (Vec core/RegionDef))
   (types (Vec core/TypeDef))
   (handles (Map String core/NativeId))
   (epochs (Map String core/NativeId))
   (instruction core/Instruction)] (U core/NativeId Nil)
  (cond
    (instance? native.core.ArenaInstruction instruction)
    (core/arenainstruction-region instruction)

    (instance? native.core.AtomStateInstruction instruction)
    (core/atomstateinstruction-region instruction)

    (instance? native.core.ArenaCloseInstructionV0 instruction)
    nil

    (instance? native.core.AllocateInstruction instruction)
    (core/allocateinstruction-region instruction)

    (some? (instruction-arena-operand instruction))
    (let [(arena Any) (instruction-arena-operand instruction)
          (region (U core/NativeId Nil)) (handle-region handles arena)]
      (if (nil? region) (epoch-incomparable-id) region))

    :else
    (let [(result core/SsaValueV0) (get instruction :result)]
      (if (not (type-carries-handles? types (core/ssavaluev0-type-id result)))
        nil
        (loop [position Int 0
               refs (Vec core/NativeId)
               (core/instruction-ssa-refs instruction)
               merged (U core/NativeId Nil) nil]
          (if (>= position (count refs))
            merged
            (recur (+ position 1) refs
              (if (region-handle? handles (nth refs position))
                merged
                (merge-epochs regions merged
                  (epoch-of epochs (nth refs position)))))))))))

(defn block-parameter-epochs
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)
   (epochs (Map String core/NativeId))
   (target-id core/NativeId)
   (arguments (Vec core/NativeId))] (Map String core/NativeId)
  (let [(target (U core/BasicBlock Nil))
        (find-block (core/functiondef-blocks function) target-id)]
    (if (nil? target)
      epochs
      (let [(parameters (Vec core/Parameter))
            (core/basicblock-parameters target)]
        (loop [position Int 0 current (Map String core/NativeId) epochs]
          (if (or (>= position (count parameters))
                (>= position (count arguments)))
            current
            (recur (+ position 1)
              (merge-epoch-into regions current
                (core/parameter-id (nth parameters position))
                (epoch-of epochs (nth arguments position))))))))))

(defn terminator-epoch-flow
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)
   (epochs (Map String core/NativeId))
   (terminator core/Terminator)] (Map String core/NativeId)
  (cond
    (instance? native.core.JumpTerminator terminator)
    (block-parameter-epochs regions function epochs
      (core/jumpterminator-block-id terminator)
      (core/jumpterminator-arguments terminator))

    (instance? native.core.SwitchTerminator terminator)
    (loop [position Int 0
           cases (Vec core/SwitchCaseV0)
           (core/switchterminator-cases terminator)
           current (Map String core/NativeId) epochs]
      (if (>= position (count cases))
        current
        (let [(switch-case core/SwitchCaseV0) (nth cases position)]
          (recur (+ position 1) cases
            (block-parameter-epochs regions function current
              (core/switchcasev0-block-id switch-case)
              (core/switchcasev0-arguments switch-case))))))

    :else epochs))

(defn function-epoch-map-pass
  [(regions (Vec core/RegionDef))
   (types (Vec core/TypeDef))
   (handles (Map String core/NativeId))
   (function core/FunctionDef)
   (epochs (Map String core/NativeId))] (Map String core/NativeId)
  (loop [block-position Int 0
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)
         current (Map String core/NativeId) epochs]
    (if (>= block-position (count blocks))
      current
      (let [(block core/BasicBlock) (nth blocks block-position)
            (instructions (Vec core/Instruction))
            (core/basicblock-instructions block)
            (with-instructions (Map String core/NativeId))
            (loop [position Int 0
                   inner (Map String core/NativeId) current]
              (if (>= position (count instructions))
                inner
                (let [(instruction core/Instruction) (nth instructions position)
                      (result core/SsaValueV0) (get instruction :result)]
                  (recur (+ position 1)
                    (merge-epoch-into regions inner
                      (core/ssavaluev0-id result)
                      (instruction-epoch regions types handles inner
                        instruction))))))
            (with-terminators (Map String core/NativeId))
            (loop [position Int 0
                   terminators (Vec core/Terminator)
                   (core/basicblock-terminators block)
                   inner (Map String core/NativeId) with-instructions]
              (if (>= position (count terminators))
                inner
                (recur (+ position 1) terminators
                  (terminator-epoch-flow regions function inner
                    (nth terminators position)))))]
        (recur (+ block-position 1) blocks with-terminators)))))

(defrecord EpochMapResultV0
  [(epochs (Map String core/NativeId))
   (converged Bool)])

;; The epoch lattice is nil < region < incomparable, so the fixpoint is
;; monotone; the cap only guards against a defective walk, and hitting it
;; reads as non-convergence (the caller refuses).
(defn function-epoch-map
  [(regions (Vec core/RegionDef))
   (types (Vec core/TypeDef))
   (function core/FunctionDef)] EpochMapResultV0
  (let [(cap Int) (+ 4 (* 3 (count (core/function-value-ids function))))
        (handles (Map String core/NativeId)) (function-region-handles function)]
    (loop [round Int 0 epochs (Map String core/NativeId) {}]
      (let [(next (Map String core/NativeId))
            (function-epoch-map-pass regions types handles function epochs)]
        (cond
          (= next epochs) (->EpochMapResultV0 next true)
          (>= round cap) (->EpochMapResultV0 next false)
          :else (recur (+ round 1) next))))))

(defn function-closed-regions
  [(function core/FunctionDef)] (Vec core/NativeId)
  (loop [block-position Int 0
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)
         closed (Vec core/NativeId) []]
    (if (>= block-position (count blocks))
      closed
      (let [(instructions (Vec core/Instruction))
            (core/basicblock-instructions (nth blocks block-position))]
        (recur (+ block-position 1) blocks
          (loop [position Int 0 inner (Vec core/NativeId) closed]
            (if (>= position (count instructions))
              inner
              (let [(instruction core/Instruction) (nth instructions position)]
                (recur (+ position 1)
                  (if (instance? native.core.ArenaCloseInstructionV0 instruction)
                    (let [(region (U core/NativeId Nil))
                          (function-arena-region function
                            (core/arenacloseinstructionv0-source-id instruction))]
                      (if (nil? region) inner (conj inner region)))
                    inner))))))))))

;; True when no region closed inside this function is an ancestor-or-equal of
;; the value's epoch — a closed epoch's values may not leave the function.
(defn value-outlives-closed-regions?
  [(regions (Vec core/RegionDef))
   (closed (Vec core/NativeId))
   (epochs (Map String core/NativeId))
   (value-id core/NativeId)] Bool
  (let [(epoch (U core/NativeId Nil)) (epoch-of epochs value-id)]
    (if (nil? epoch)
      true
      (every?
        (fn [(closed-region core/NativeId)] Bool
          (not (region-on-ancestor-chain? regions closed-region epoch)))
        closed))))

(defn root-or-free-epoch?
  [(regions (Vec core/RegionDef))
   (epochs (Map String core/NativeId))
   (value-id core/NativeId)] Bool
  (let [(epoch (U core/NativeId Nil)) (epoch-of epochs value-id)]
    (or (nil? epoch) (root-region? regions epoch))))

;; The epochs a call would hand a summary-less callee: every argument the
;; root-or-free rule refuses, by epoch. Empty means the plain rule already
;; admits the call.
(defn call-retained-epochs
  [(regions (Vec core/RegionDef))
   (epochs (Map String core/NativeId))
   (arguments (Vec core/NativeId))] (Vec core/NativeId)
  (loop [position Int 0 retained (Vec core/NativeId) []]
    (if (>= position (count arguments))
      retained
      (recur (+ position 1)
        (if (root-or-free-epoch? regions epochs (nth arguments position))
          retained
          (let [(epoch (U core/NativeId Nil))
                (epoch-of epochs (nth arguments position))]
            (if (nil? epoch) retained (conj retained epoch))))))))

;; A use of the call result qualifies for E3 only as the SOURCE of a promote
;; whose destination arena is an ancestor-or-equal of every retained epoch:
;; the copy must land where it outlives the epoch the call ran in. An
;; unresolved destination or an incomparable retained epoch refuses.
(defn promote-out-of-epochs?
  [(regions (Vec core/RegionDef))
   (handles (Map String core/NativeId))
   (retained (Vec core/NativeId))
   (result-id core/NativeId)
   (instruction core/Instruction)] Bool
  (and (instance? native.core.PromoteInstructionV0 instruction)
    (core/native-id= (core/promoteinstructionv0-source-id instruction)
      result-id)
    (let [(destination (U core/NativeId Nil))
          (handle-region handles
            (core/promoteinstructionv0-arena-id instruction))]
      (and (some? destination)
        (every?
          (fn [(epoch core/NativeId)] Bool
            (region-on-ancestor-chain? regions destination epoch))
          retained)))))

(defn call-result-only-promoted?
  [(regions (Vec core/RegionDef))
   (handles (Map String core/NativeId))
   (function core/FunctionDef)
   (retained (Vec core/NativeId))
   (result-id core/NativeId)] Bool
  (every?
    (fn [(block core/BasicBlock)] Bool
      (and
        (every?
          (fn [(instruction core/Instruction)] Bool
            (or (not (core/id-in? (core/instruction-ssa-refs instruction)
                       result-id))
              (promote-out-of-epochs? regions handles retained result-id
                instruction)))
          (core/basicblock-instructions block))
        (every?
          (fn [(terminator core/Terminator)] Bool
            (not (core/id-in? (core/terminator-ssa-refs terminator)
                   result-id)))
          (core/basicblock-terminators block))))
    (core/functiondef-blocks function)))

(defn call-result-promoted-somewhere?
  [(function core/FunctionDef)
   (result-id core/NativeId)] Bool
  (loop [block-position Int 0
         blocks (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (if (>= block-position (count blocks))
      false
      (let [(instructions (Vec core/Instruction))
            (core/basicblock-instructions (nth blocks block-position))
            (found Bool)
            (loop [position Int 0]
              (if (>= position (count instructions))
                false
                (let [(instruction core/Instruction)
                      (nth instructions position)]
                  (if (and
                        (instance? native.core.PromoteInstructionV0
                          instruction)
                        (core/native-id=
                          (core/promoteinstructionv0-source-id instruction)
                          result-id))
                    true
                    (recur (+ position 1))))))]
        (if found true (recur (+ block-position 1) blocks))))))

;; E3 promote admission. A call whose arguments the root-or-free rule refuses
;; is still epoch-safe when its result's ONLY use anywhere in the function is
;; promotion to an older-or-equal arena: the result is copied out before the
;; epoch closes and nothing else escapes. Any other use — a terminator, a
;; store, another call, even a use that stays inside the epoch — refuses, and
;; a result no promote consumes proves nothing, so it refuses too.
(defn call-epoch-legal?
  [(regions (Vec core/RegionDef))
   (handles (Map String core/NativeId))
   (epochs (Map String core/NativeId))
   (function core/FunctionDef)
   (arguments (Vec core/NativeId))
   (result-id core/NativeId)] Bool
  (let [(retained (Vec core/NativeId))
        (call-retained-epochs regions epochs arguments)]
    (or (= 0 (count retained))
      (and (call-result-only-promoted? regions handles function retained
             result-id)
        (call-result-promoted-somewhere? function result-id)))))

(defn instruction-epoch-writes-legal?
  [(regions (Vec core/RegionDef))
   (handles (Map String core/NativeId))
   (epochs (Map String core/NativeId))
   (function core/FunctionDef)
   (instruction core/Instruction)] Bool
  (let [(store Any) (get instruction :store nil)]
    (cond
      (some? store)
      (epoch-write-legal? regions
        (epoch-of epochs (get store :value))
        (get store :region))

      ;; The one legal young-to-old edge: promote COPIES its source into the
      ;; destination arena, so the source's epoch is irrelevant to the write.
      (instance? native.core.PromoteInstructionV0 instruction)
      true

      ;; A store into a cell is sound when the stored value's epoch is an
      ;; ancestor-of-or-equal of the CELL's epoch: the value must outlive the
      ;; cell, never the reverse. The value's SHAPE is not the question — a
      ;; root-allocated record owning arena storage is as legal in a root cell
      ;; as a scalar. Cells stay root-pinned in v0, which is the separate
      ;; conjunct below.
      (instance? native.core.AtomCreateInstruction instruction)
      (let [(cell-region (U core/NativeId Nil))
            (handle-region handles
              (core/atomcreateinstruction-arena-id instruction))]
        (and (epoch-write-legal? regions
               (epoch-of epochs
                 (core/atomcreateinstruction-initial-id instruction))
               cell-region)
          (or (nil? cell-region) (root-region? regions cell-region))))

      (instance? native.core.AtomResetInstruction instruction)
      (epoch-write-legal? regions
        (epoch-of epochs (core/atomresetinstruction-value-id instruction))
        (epoch-of epochs (core/atomresetinstruction-cell-id instruction)))

      (instance? native.core.AtomCompareExchangeInstruction instruction)
      (epoch-write-legal? regions
        (epoch-of epochs
          (core/atomcompareexchangeinstruction-replacement-id instruction))
        (epoch-of epochs
          (core/atomcompareexchangeinstruction-cell-id instruction)))

      (instance? native.core.AtomSwapInstruction instruction)
      (let [(cell-epoch (U core/NativeId Nil))
            (epoch-of epochs (core/atomswapinstruction-cell-id instruction))]
        (every?
          (fn [(argument core/NativeId)] Bool
            (epoch-write-legal? regions (epoch-of epochs argument) cell-epoch))
          (core/atomswapinstruction-arguments instruction)))

      ;; A missing callee summary means retained (the v2 lesson): arguments
      ;; handed across a call must carry driver lifetime — except under the
      ;; E3 promote admission, where the only surviving copy of anything the
      ;; callee could hand back is promoted out before the epoch closes.
      (instance? native.core.CallInstruction instruction)
      (call-epoch-legal? regions handles epochs function
        (core/callinstruction-arguments instruction)
        (core/instruction-result-id instruction))

      (instance? native.core.ExternCallInstruction instruction)
      (call-epoch-legal? regions handles epochs function
        (core/externcallinstruction-arguments instruction)
        (core/instruction-result-id instruction))

      ;; Arena-destination operations copy or reference every non-handle
      ;; operand from storage in the destination region.
      (some? (instruction-arena-operand instruction))
      (let [(arena Any) (instruction-arena-operand instruction)
            (destination (U core/NativeId Nil)) (handle-region handles arena)]
        (every?
          (fn [(operand core/NativeId)] Bool
            (or (region-handle? handles operand)
              (epoch-write-legal? regions
                (epoch-of epochs operand) destination)))
          (core/instruction-ssa-refs instruction)))

      :else true)))

(defn terminator-epoch-legal?
  [(regions (Vec core/RegionDef))
   (closed (Vec core/NativeId))
   (epochs (Map String core/NativeId))
   (terminator core/Terminator)] Bool
  (cond
    (instance? native.core.ReturnTerminator terminator)
    (let [(value (U core/NativeId Nil))
          (core/returnterminator-value terminator)]
      (or (nil? value)
        (value-outlives-closed-regions? regions closed epochs value)))

    (instance? native.core.TrapTerminator terminator)
    (value-outlives-closed-regions? regions closed epochs
      (core/trapterminator-failure-id terminator))

    :else true))

(defn function-epoch-sound?
  [(regions (Vec core/RegionDef))
   (types (Vec core/TypeDef))
   (function core/FunctionDef)] Bool
  (let [(result EpochMapResultV0) (function-epoch-map regions types function)]
    (if (not (epochmapresultv0-converged result))
      false
      (let [(epochs (Map String core/NativeId))
            (epochmapresultv0-epochs result)
            (handles (Map String core/NativeId))
            (function-region-handles function)
            (closed (Vec core/NativeId)) (function-closed-regions function)]
        (every?
          (fn [(block core/BasicBlock)] Bool
            (and
              (every?
                (fn [(instruction core/Instruction)] Bool
                  (instruction-epoch-writes-legal? regions handles epochs
                    function instruction))
                (core/basicblock-instructions block))
              (every?
                (fn [(terminator core/Terminator)] Bool
                  (terminator-epoch-legal? regions closed epochs terminator))
                (core/basicblock-terminators block))))
          (core/functiondef-blocks function))))))

(defn epoch-soundness [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->EpochSoundnessObligation true))
      (let [(function core/FunctionDef) (nth functions index)]
        (if (function-epoch-sound? (core/nativecoreprogram-regions program)
              (core/nativecoreprogram-types program) function)
          (recur (+ index 1) functions)
          (->EpochSoundnessDiagnosticV0 (core/functiondef-id function)))))))

;; --- Obligation 9: leak freedom. A path-sensitive walk mirroring
;; token-paths-valid?, carrying the stack of open epochs instead of a token
;; multiset: opens push (parent must be a root or already open), closes pop
;; the top exactly (LIFO in the region tree), every exit requires an empty
;; stack, and a loop header re-entered with a different stack refuses.

(defrecord EpochStackVisitV0
  [(block-id core/NativeId)
   (stack (Vec core/NativeId))])

(defrecord EpochStackWorkV0
  [(block-id core/NativeId)
   (stack (Vec core/NativeId))
   (path (Vec EpochStackVisitV0))])

(defrecord EpochBlockStepV0
  [(stack (Vec core/NativeId))
   (violation (U core/NativeId Nil))])

(defn epoch-stacks-equal?
  [(left (Vec core/NativeId))
   (right (Vec core/NativeId))] Bool
  (and (= (count left) (count right))
    (loop [index Int 0]
      (if (>= index (count left))
        true
        (if (core/native-id= (nth left index) (nth right index))
          (recur (+ index 1))
          false)))))

(defn epoch-stack-top [(stack (Vec core/NativeId))] (U core/NativeId Nil)
  (if (= 0 (count stack)) nil (nth stack (- (count stack) 1))))

(defn epoch-stack-pop [(stack (Vec core/NativeId))] (Vec core/NativeId)
  (loop [index Int 0 popped (Vec core/NativeId) []]
    (if (>= index (- (count stack) 1))
      popped
      (recur (+ index 1) (conj popped (nth stack index))))))

(defn epoch-stack-visit
  [(visited (Vec EpochStackVisitV0))
   (block-id core/NativeId)] (U EpochStackVisitV0 Nil)
  (loop [index Int 0]
    (cond
      (>= index (count visited)) nil
      (core/native-id= (epochstackvisitv0-block-id (nth visited index)) block-id)
      (nth visited index)
      :else (recur (+ index 1)))))

(defn epoch-stack-visited?
  [(memo (Vec EpochStackVisitV0))
   (block-id core/NativeId)
   (stack (Vec core/NativeId))] Bool
  (loop [index Int 0]
    (cond
      (>= index (count memo)) false
      (and (core/native-id= (epochstackvisitv0-block-id (nth memo index))
             block-id)
        (epoch-stacks-equal? (epochstackvisitv0-stack (nth memo index)) stack))
      true
      :else (recur (+ index 1)))))

(defn epoch-block-step
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)
   (block core/BasicBlock)
   (stack (Vec core/NativeId))] EpochBlockStepV0
  (loop [position Int 0
         instructions (Vec core/Instruction)
         (core/basicblock-instructions block)
         current (Vec core/NativeId) stack]
    (if (>= position (count instructions))
      (->EpochBlockStepV0 current nil)
      (let [(instruction core/Instruction) (nth instructions position)]
        (cond
          (and (instance? native.core.ArenaInstruction instruction)
            (epoch-region? regions
              (core/arenainstruction-region instruction)))
          (let [(region core/NativeId)
                (core/arenainstruction-region instruction)
                (definition (U core/RegionDef Nil))
                (find-region regions region)
                (parent Any)
                (if (nil? definition) nil (core/regiondef-parent definition))]
            (cond
              (core/id-in? current region)
              (->EpochBlockStepV0 current region)
              (nil? parent)
              (->EpochBlockStepV0 current region)
              (not (or (root-region? regions parent)
                    (core/id-in? current parent)))
              (->EpochBlockStepV0 current region)
              :else (recur (+ position 1) instructions (conj current region))))

          (instance? native.core.ArenaCloseInstructionV0 instruction)
          (let [(region (U core/NativeId Nil))
                (function-arena-region function
                  (core/arenacloseinstructionv0-source-id instruction))]
            (cond
              (nil? region)
              (->EpochBlockStepV0 current (obligation-id "epoch-close-unresolved"))
              (not (epoch-region? regions region))
              (->EpochBlockStepV0 current region)
              (= 0 (count current))
              (->EpochBlockStepV0 current region)
              (not (dynamic-id= (epoch-stack-top current) region))
              (->EpochBlockStepV0 current region)
              :else (recur (+ position 1) instructions
                      (epoch-stack-pop current))))

          :else (recur (+ position 1) instructions current))))))

(defn function-leak-violation
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)] (U core/NativeId Nil)
  (loop [position Int 0
         work (Vec EpochStackWorkV0)
         [(->EpochStackWorkV0 (core/functiondef-entry-block function) [] [])]
         memo (Vec EpochStackVisitV0) []]
    (if (>= position (count work))
      nil
      (let [(item EpochStackWorkV0) (nth work position)
            (current-id core/NativeId) (epochstackworkv0-block-id item)
            (current-stack (Vec core/NativeId)) (epochstackworkv0-stack item)
            (path (Vec EpochStackVisitV0)) (epochstackworkv0-path item)
            (entered (U EpochStackVisitV0 Nil))
            (epoch-stack-visit path current-id)]
        (if (some? entered)
          (if (epoch-stacks-equal? (epochstackvisitv0-stack entered)
                current-stack)
            (recur (+ position 1) work memo)
            (let [(top (U core/NativeId Nil)) (epoch-stack-top current-stack)]
              (if (nil? top)
                (epoch-stack-top (epochstackvisitv0-stack entered))
                top)))
          (if (epoch-stack-visited? memo current-id current-stack)
            (recur (+ position 1) work memo)
            (let [(block (U core/BasicBlock Nil))
                  (find-block (core/functiondef-blocks function) current-id)]
              (if (nil? block)
                (obligation-id "epoch-missing-block")
                (let [(step EpochBlockStepV0)
                      (epoch-block-step regions function block current-stack)
                      (violation (U core/NativeId Nil))
                      (epochblockstepv0-violation step)]
                  (if (some? violation)
                    violation
                    (let [(next-stack (Vec core/NativeId))
                          (epochblockstepv0-stack step)
                          (successors (Vec core/NativeId))
                          (block-successors block)
                          (visit EpochStackVisitV0)
                          (->EpochStackVisitV0 current-id current-stack)
                          (next-path (Vec EpochStackVisitV0)) (conj path visit)
                          (next-memo (Vec EpochStackVisitV0)) (conj memo visit)]
                      (if (= 0 (count successors))
                        (if (= 0 (count next-stack))
                          (recur (+ position 1) work next-memo)
                          (epoch-stack-top next-stack))
                        (let [(next-work (Vec EpochStackWorkV0))
                              (mapv
                                (fn
                                  [(successor core/NativeId)] EpochStackWorkV0
                                  (->EpochStackWorkV0 successor next-stack
                                    next-path))
                                successors)]
                          (recur (+ position 1)
                            (vec (concat work next-work))
                            next-memo))))))))))))))

(defn leak-freedom [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [index Int 0 functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= index (count functions))
      (->ObligationPassV0 (core/->LeakFreedomObligation true))
      (let [(violation (U core/NativeId Nil))
            (function-leak-violation (core/nativecoreprogram-regions program)
              (nth functions index))]
        (if (nil? violation)
          (recur (+ index 1) functions)
          (->LeakFreedomDiagnosticV0 violation))))))

(defn find-function-by-id
  [(functions (Vec core/FunctionDef))
   (target core/NativeId)]
  (U core/FunctionDef Nil)
  (loop [position Int 0]
    (if (>= position (count functions))
      nil
      (let [(function core/FunctionDef) (nth functions position)]
        (if (core/native-id= (core/functiondef-id function) target)
          function
          (recur (+ position 1)))))))

(defn f64-buffer-type-id?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(element (U core/NativeId Nil))
        (core/buffer-element-type types target)]
    (and (some? element) (core/type-id-is-f64? types element))))

(defn tile-kernel-signature-valid?
  [(types (Vec core/TypeDef)) (kernel core/FunctionDef)] Bool
  (let [(parameters (Vec core/Parameter))
        (core/functiondef-parameters kernel)
        (result (U core/NativeId Nil)) (core/functiondef-return-type kernel)]
    (and (= 5 (count parameters))
      (f64-buffer-type-id? types
        (core/parameter-type-id (nth parameters 0)))
      (f64-buffer-type-id? types
        (core/parameter-type-id (nth parameters 1)))
      (core/type-id-is-i64? types
        (core/parameter-type-id (nth parameters 2)))
      (core/type-id-is-i64? types
        (core/parameter-type-id (nth parameters 3)))
      (core/type-id-is-i64? types
        (core/parameter-type-id (nth parameters 4)))
      (some? result)
      (if (nil? result)
        false
        (let [(definition (U core/TypeDef Nil))
              (core/type-definition-with-id types result)]
          (and (some? definition)
            (= "Unit" (core/typedef-name definition))))))))

(defn tile-kernel-instruction-valid?
  [(types (Vec core/TypeDef))
   (kernel core/FunctionDef)
   (instruction core/Instruction)]
  Bool
  (let [(parameters (Vec core/Parameter))
        (core/functiondef-parameters kernel)
        (current core/NativeId) (core/parameter-id (nth parameters 0))
        (next core/NativeId) (core/parameter-id (nth parameters 1))]
    (cond
      (instance? native.core.AtomInstruction instruction)
      (not (instance? native.core.RefAtom
             (core/atominstruction-atom instruction)))
      (instance? native.core.ArenaInstruction instruction) true
      (instance? native.core.CopyInstruction instruction) true
      (instance? native.core.AddF64Instruction instruction) true
      (instance? native.core.SubF64InstructionV0 instruction) true
      (instance? native.core.MulF64InstructionV0 instruction) true
      (instance? native.core.DivF64InstructionV0 instruction) true
      (instance? native.core.I64ToF64InstructionV0 instruction) true
      (instance? native.core.F64ToI64InstructionV0 instruction) true
      (instance? native.core.CheckedInstruction instruction) true
      (instance? native.core.BitwiseInstructionV0 instruction) true
      (instance? native.core.CompareInstruction instruction) true
      ;; Checked integer arithmetic lowers to an outcome followed by its
      ;; statically known success projection. Kernel parameters cannot carry an
      ;; arbitrary union, so this remains confined to scalar checked results.
      (instance? native.core.VariantValueInstruction instruction) true
      ;; Nil is represented by the payload-free Unit variant.
      (instance? native.core.UnionConstructInstruction instruction)
      (let [(definition (U core/TypeDef Nil))
            (core/type-definition-with-id types
              (core/ssavaluev0-type-id
                (core/unionconstructinstruction-result instruction)))]
        (and (nil? (core/unionconstructinstruction-payload-id instruction))
          (some? definition)
          (if (nil? definition)
            false
            (= "Unit" (core/typedef-name definition)))))
      (instance? native.core.BufferLengthInstructionV0 instruction)
      (let [(source core/NativeId)
            (core/bufferlengthinstructionv0-source-id instruction)]
        (or (core/native-id= source current) (core/native-id= source next)))
      (instance? native.core.BufferGetCheckedInstructionV0 instruction)
      (core/native-id=
        (core/buffergetcheckedinstructionv0-source-id instruction) current)
      (instance? native.core.BufferSetCheckedInstructionV0 instruction)
      (core/native-id=
        (core/buffersetcheckedinstructionv0-source-id instruction) next)
      :else false)))

(defn tile-kernel-leaf-valid?
  [(types (Vec core/TypeDef)) (kernel core/FunctionDef)] Bool
  (every?
    (fn [(block core/BasicBlock)] Bool
      (every?
        (fn [(instruction core/Instruction)] Bool
          (tile-kernel-instruction-valid? types kernel instruction))
        (core/basicblock-instructions block)))
    (core/functiondef-blocks kernel)))

(defn function-id-abi-visible?
  [(abis (Vec core/AbiDeclV0)) (target core/NativeId)] Bool
  (some?
    (some
      (fn [(abi core/AbiDeclV0)] Bool
        (core/native-id= (core/abideclv0-function-id abi) target))
      abis)))

(defn function-id-ordinary-reachable?
  [(functions (Vec core/FunctionDef)) (target core/NativeId)] Bool
  (some?
    (some
      (fn [(function core/FunctionDef)] Bool
        (some?
          (some
            (fn [(block core/BasicBlock)] Bool
              (some?
                (some
                  (fn [(instruction core/Instruction)] Bool
                    (or
                      (and (instance? native.core.CallInstruction instruction)
                        (core/native-id=
                          (core/callinstruction-function-id instruction)
                          target))
                      (and (instance? native.core.AtomSwapInstruction instruction)
                        (core/native-id=
                          (core/atomswapinstruction-updater-id instruction)
                          target))))
                  (core/basicblock-instructions block))))
            (core/functiondef-blocks function))))
      functions)))

(defn parallel-instruction-valid?
  [(program core/NativeCoreProgram)
   (owner core/FunctionDef)
   (instruction core/Instruction)]
  Bool
  (cond
    (instance? native.core.TiledStepF64InstructionV0 instruction)
    (let [(kernel (U core/FunctionDef Nil))
          (find-function-by-id (core/nativecoreprogram-functions program)
            (core/tiledstepf64instructionv0-kernel-id instruction))]
      (and (core/buffer-instruction-valid?
             (core/nativecoreprogram-types program)
             (core/nativecoreprogram-regions program)
             (core/nativecoreprogram-capabilities program)
             owner instruction)
        (some? kernel)
        (if (nil? kernel)
          false
          (and
            (tile-kernel-signature-valid?
              (core/nativecoreprogram-types program) kernel)
            (tile-kernel-leaf-valid?
              (core/nativecoreprogram-types program) kernel)
            (not (function-id-abi-visible?
                   (core/nativecoreprogram-abis program)
                   (core/functiondef-id kernel)))
            (not (function-id-ordinary-reachable?
                   (core/nativecoreprogram-functions program)
                   (core/functiondef-id kernel)))))))

    (instance? native.core.F64BufferSumInstructionV0 instruction)
    (and (instance? native.core.F64AdjacentPairwiseV0
           (core/f64buffersuminstructionv0-policy instruction))
      (core/buffer-instruction-valid?
        (core/nativecoreprogram-types program)
        (core/nativecoreprogram-regions program)
        (core/nativecoreprogram-capabilities program)
        owner instruction))

    :else true))

(defn deterministic-parallelism
  [(program core/NativeCoreProgram)] ObligationVerdictV0
  (loop [position Int 0
         functions (Vec core/FunctionDef)
         (core/nativecoreprogram-functions program)]
    (if (>= position (count functions))
      (->ObligationPassV0
        (core/->DeterministicParallelismObligationV0 true))
      (let [(function core/FunctionDef) (nth functions position)
            (valid Bool)
            (every?
              (fn [(block core/BasicBlock)] Bool
                (every?
                  (fn [(instruction core/Instruction)] Bool
                    (parallel-instruction-valid? program function instruction))
                  (core/basicblock-instructions block)))
              (core/functiondef-blocks function))]
        (if valid
          (recur (+ position 1) functions)
          (->DeterministicParallelismDiagnosticV0
            (core/functiondef-id function)))))))

(def fixture-i64-type core/TypeDef
  (core/->TypeDef (obligation-id "type-i64") "I64"
    (core/->AtomType (core/->I64Kind true))))

(def fixture-i64-layout core/LayoutDef
  (core/->LayoutDef (obligation-id "layout-i64") (obligation-id "type-i64")
    8 8 (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(def fixture-left-variant core/TypeVariant
  (core/->TypeVariant (obligation-id "variant-left") "left" nil))

(def fixture-right-variant core/TypeVariant
  (core/->TypeVariant (obligation-id "variant-right") "right" nil))

(def fixture-union-type core/TypeDef
  (core/->TypeDef (obligation-id "type-choice") "Choice"
    (core/->UnionType [fixture-left-variant fixture-right-variant])))

(def fixture-union-layout core/LayoutDef
  (core/->LayoutDef (obligation-id "layout-choice")
    (obligation-id "type-choice") 8 8
    (core/->UnionShapeV0 (obligation-id "type-i64") 0
      [(core/->UnionVariantLayoutV0 (obligation-id "variant-left") 0 nil 8)
       (core/->UnionVariantLayoutV0 (obligation-id "variant-right") 1 nil 8)])))

(def fixture-outcome-type core/TypeDef
  (core/->TypeDef (obligation-id "type-checked-i64") "CheckedI64"
    (core/->OutcomeType (obligation-id "type-i64")
      (obligation-id "type-choice"))))

(def fixture-outcome-layout core/LayoutDef
  (core/->LayoutDef (obligation-id "layout-checked-i64")
    (obligation-id "type-checked-i64") 16 8
    (core/->UnionShapeV0 (obligation-id "type-i64") 0
      [(core/->UnionVariantLayoutV0 (obligation-id "variant-left") 0 nil 8)
       (core/->UnionVariantLayoutV0 (obligation-id "variant-right") 1 nil 8)])))

(def fixture-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-copy") "copy"
    [(core/->Parameter (obligation-id "ssa-input") (obligation-id "type-i64"))
     (core/->Parameter (obligation-id "ssa-choice") (obligation-id "type-choice"))]
    [(core/->BasicBlock (obligation-id "block-entry") []
       [(core/->CheckedInstruction
          (core/->SsaValueV0 (obligation-id "ssa-result")
            (obligation-id "type-checked-i64"))
          (core/->CheckedAddI64V0 (obligation-id "ssa-input")
            (obligation-id "ssa-input")))]
       [(core/->SwitchTerminator (obligation-id "ssa-choice")
          [(core/->SwitchCaseV0 (obligation-id "variant-left")
             (obligation-id "block-left") [])
           (core/->SwitchCaseV0 (obligation-id "variant-right")
             (obligation-id "block-right") [])])])
     (core/->BasicBlock (obligation-id "block-left") [] []
       [(core/->ReturnTerminator (obligation-id "ssa-result"))])
     (core/->BasicBlock (obligation-id "block-right") [] []
       [(core/->ReturnTerminator (obligation-id "ssa-result"))])]
    (obligation-id "block-entry")
    (obligation-id "type-checked-i64")
    [] [] []))

(def fixture-abi core/AbiDeclV0
  (core/->AbiDeclV0 (obligation-id "abi-checked-add")
    (obligation-id "function-copy") "native_checked_add"
    (core/->AbiExportV0 true) (core/->RestrictedCAbiV0 true)
    [(core/->AbiValueV0 "input" (obligation-id "type-i64")
       (core/->BorrowedV0 true) nil)
     (core/->AbiValueV0 "choice" (obligation-id "type-choice")
       (core/->BorrowedV0 true) nil)]
    (core/->AbiValueV0 "result" (obligation-id "type-checked-i64")
      (core/->OwnedV0 true) nil)
    (obligation-id "type-choice") [] [] "v0"
    "sha256:fixture-layout"))

(def fixture-region core/RegionDef
  (core/->RegionDef (obligation-id "region-fixture")
    (core/->ArenaRegion true) nil))

(def fixture-capability core/CapabilityDef
  (core/->CapabilityDef (obligation-id "capability-write")
    (core/->WriteCapability true) (obligation-id "region-fixture") true))

(def fixture-write-effect core/EffectDef
  (core/->EffectDef (obligation-id "effect-write")
    (core/->WriteEffect (obligation-id "region-fixture"))))

(def fixture-token-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-store") "store"
    [(core/->Parameter (obligation-id "ssa-address") (obligation-id "type-i64"))
     (core/->Parameter (obligation-id "ssa-value") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-store") []
       [(core/->StoreInstruction
          (core/->SsaValueV0 (obligation-id "ssa-store")
            (obligation-id "type-i64"))
          (core/->StoreI64 (obligation-id "ssa-address")
            (obligation-id "ssa-value")
            (obligation-id "region-fixture")
            (obligation-id "capability-write"))
          (core/->TokenFlowV0
            [(obligation-id "region-fixture")
             (obligation-id "capability-write")]
            []))]
       [(core/->ReturnTerminator nil)])]
    (obligation-id "block-store") nil
    [(obligation-id "effect-write")]
    [(obligation-id "region-fixture")]
    [(obligation-id "capability-write")]))

(def valid-program core/NativeCoreProgram
  (apply core/->NativeCoreProgram
    [(obligation-id "program-valid") nil "obligations-v0"
     [fixture-i64-type fixture-union-type fixture-outcome-type]
     [fixture-write-effect] [fixture-region] [fixture-capability]
     [fixture-i64-layout fixture-union-layout fixture-outcome-layout]
     [fixture-function fixture-token-function]
     [(obligation-id "effect-write")]
     [(obligation-id "region-fixture")]
     [(obligation-id "capability-write")]
     [fixture-abi] []]))

(def invalid-ssa-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CopyInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-i64"))
           (obligation-id "ssa-later"))
         (core/->AtomInstruction
           (core/->SsaValueV0 (obligation-id "ssa-later")
             (obligation-id "type-i64"))
           (core/->I64Atom 1))]
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])]]))

(def invalid-ssa-program core/NativeCoreProgram
  (with valid-program [:functions [invalid-ssa-function]]))

(def nonexhaustive-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-checked-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))]
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])])])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])]]))

(def nonexhaustive-program core/NativeCoreProgram
  (with valid-program [:functions [nonexhaustive-function]]))

(def undersized-i64-layout core/LayoutDef
  (with fixture-i64-layout [:size-bytes 4]))

(def open-layout-program core/NativeCoreProgram
  (with valid-program
    [:layouts [undersized-i64-layout fixture-union-layout fixture-outcome-layout]]))

(def unchecked-result-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-checked-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))]
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])
            (core/->SwitchCaseV0 (obligation-id "variant-right")
              (obligation-id "block-right") [])])])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator nil)])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator nil)])]]))

(def unchecked-arithmetic-program core/NativeCoreProgram
  (with valid-program [:functions [unchecked-result-function]]))

(def invalid-abi core/AbiDeclV0
  (with fixture-abi
    [:parameters
     [(core/->AbiValueV0 "input" (obligation-id "type-missing")
        (core/->BorrowedV0 true) nil)
      (core/->AbiValueV0 "choice" (obligation-id "type-choice")
        (core/->BorrowedV0 true) nil)]]))

(def illegal-abi-program core/NativeCoreProgram
  (with valid-program [:abis [invalid-abi]]))

(def double-consume-token-function core/FunctionDef
  (with fixture-token-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-store") []
        [(core/->StoreInstruction
           (core/->SsaValueV0 (obligation-id "ssa-store")
             (obligation-id "type-i64"))
           (core/->StoreI64 (obligation-id "ssa-address")
             (obligation-id "ssa-value")
             (obligation-id "region-fixture")
             (obligation-id "capability-write"))
           (core/->TokenFlowV0
             [(obligation-id "region-fixture")
              (obligation-id "capability-write")
              (obligation-id "capability-write")]
             []))]
        [(core/->ReturnTerminator nil)])]]))

(def undischarged-token-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function double-consume-token-function]]))

(def unbounded-effect-function core/FunctionDef
  (with fixture-token-function [:effects []]))

(def unbounded-effect-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function unbounded-effect-function]]))

(def valid-ssa-positive Bool
  (obligation-passed? (valid-ssa valid-program)))

(def valid-ssa-negative Bool
  (= "valid-ssa" (verdict-tag (valid-ssa invalid-ssa-program))))

(def exhaustive-matches-positive Bool
  (obligation-passed? (exhaustive-matches valid-program)))

(def exhaustive-matches-negative Bool
  (= "exhaustive-matches" (verdict-tag (exhaustive-matches nonexhaustive-program))))

(def closed-layouts-positive Bool
  (obligation-passed? (closed-layouts valid-program (core/abi-profile-lp64))))

(def closed-layouts-negative Bool
  (= "closed-layouts"
    (verdict-tag (closed-layouts open-layout-program (core/abi-profile-lp64)))))

(def checked-arithmetic-positive Bool
  (obligation-passed? (checked-arithmetic valid-program)))

(def checked-arithmetic-negative Bool
  (= "checked-arithmetic"
    (verdict-tag (checked-arithmetic unchecked-arithmetic-program))))

(def legal-abi-positive Bool
  (obligation-passed? (legal-abi valid-program)))

(def legal-abi-negative Bool
  (= "legal-abi" (verdict-tag (legal-abi illegal-abi-program))))

(def discharged-tokens-positive Bool
  (obligation-passed? (discharged-tokens valid-program)))

(def discharged-tokens-negative Bool
  (= "discharged-tokens"
    (verdict-tag (discharged-tokens undischarged-token-program))))

(def bounded-effects-positive Bool
  (obligation-passed? (bounded-effects valid-program)))

(def bounded-effects-negative Bool
  (= "bounded-effects" (verdict-tag (bounded-effects unbounded-effect-program))))

;; --- Epoch fixture vocabulary: a child epoch region under the root fixture
;; region, an inner grandchild for LIFO fixtures, an arena-handle type, and a
;; Text type so young values are handle-carrying.

(def fixture-epoch-region core/RegionDef
  (core/->RegionDef (obligation-id "region-epoch")
    (core/->ArenaRegion true) (obligation-id "region-fixture")))

(def fixture-epoch-inner-region core/RegionDef
  (core/->RegionDef (obligation-id "region-epoch-inner")
    (core/->ArenaRegion true) (obligation-id "region-epoch")))

(def fixture-text-type core/TypeDef
  (core/->TypeDef (obligation-id "type-text") "Text"
    (core/->AtomType (core/->TextKind true))))

(def fixture-arena-type core/TypeDef
  (core/->TypeDef (obligation-id "type-arena") "ArenaHandle"
    (core/->ReferenceType (obligation-id "type-arena"))))

(defn epoch-open-instruction [] core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (obligation-id "ssa-epoch-arena")
      (obligation-id "type-arena"))
    (obligation-id "region-epoch")
    (obligation-id "capability-write")
    (core/->TokenFlowV0 [(obligation-id "region-epoch")]
      [(core/->ResourceTokenV0 (obligation-id "token-epoch")
         (core/->RegionTokenV0 (obligation-id "region-epoch")))])))

(defn epoch-young-text-instruction [] core/Instruction
  (core/->TextConcatInstruction
    (core/->SsaValueV0 (obligation-id "ssa-young-text")
      (obligation-id "type-text"))
    (obligation-id "ssa-epoch-arena")
    []))

(defn epoch-close-instruction [(label String)] core/Instruction
  (core/->ArenaCloseInstructionV0
    (core/->SsaValueV0 (obligation-id (str "ssa-epoch-close-" label))
      (obligation-id "type-i64"))
    (obligation-id "ssa-epoch-arena")
    (core/->TokenFlowV0 [(obligation-id "token-epoch")] [])))

;; Epoch-soundness positive: a young Text lives and dies inside its epoch.
(def epoch-sound-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-epoch-sound") "epoch-sound"
    [(core/->Parameter (obligation-id "ssa-input") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-epoch-entry") []
       [(epoch-open-instruction)
        (epoch-young-text-instruction)
        (epoch-close-instruction "sound")]
       [(core/->ReturnTerminator (obligation-id "ssa-input"))])]
    (obligation-id "block-epoch-entry")
    (obligation-id "type-i64")
    [] [(obligation-id "region-epoch")] [(obligation-id "capability-write")]))

(def epoch-sound-program core/NativeCoreProgram
  (with valid-program
    [:types [fixture-i64-type fixture-union-type fixture-outcome-type
             fixture-text-type fixture-arena-type]]
    [:regions [fixture-region fixture-epoch-region fixture-epoch-inner-region]]
    [:functions [epoch-sound-function]]))

;; Epoch-soundness negative: a young-epoch Text stored into root-region
;; storage — the old-to-young reference obligation 8 exists to refuse.
(def old-young-store-function core/FunctionDef
  (with epoch-sound-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(epoch-open-instruction)
         (epoch-young-text-instruction)
         (core/->StoreInstruction
           (core/->SsaValueV0 (obligation-id "ssa-store-young")
             (obligation-id "type-i64"))
           (core/->StoreText (obligation-id "ssa-input")
             (obligation-id "ssa-young-text")
             (obligation-id "region-fixture")
             (obligation-id "capability-write"))
           (core/->TokenFlowV0 [] []))
         (epoch-close-instruction "store")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]))

(def old-young-store-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [old-young-store-function]]))

;; Leak-freedom positive: the epoch opened in the entry block closes on both
;; branch exits.
(def epoch-close-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-epoch-close") "epoch-close"
    [(core/->Parameter (obligation-id "ssa-input") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-close-entry") []
       [(epoch-open-instruction)]
       [(core/->BranchTerminator (obligation-id "ssa-input")
          (obligation-id "block-close-left")
          (obligation-id "block-close-right"))])
     (core/->BasicBlock (obligation-id "block-close-left") []
       [(epoch-close-instruction "left")]
       [(core/->ReturnTerminator nil)])
     (core/->BasicBlock (obligation-id "block-close-right") []
       [(epoch-close-instruction "right")]
       [(core/->ReturnTerminator nil)])]
    (obligation-id "block-close-entry")
    nil
    [] [(obligation-id "region-epoch")] [(obligation-id "capability-write")]))

(def epoch-close-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [epoch-close-function]]))

;; Leak-freedom negative: opened on one branch, closed on the other — no path
;; both opens and closes the epoch (patterned on leak-token-function).
(def branch-close-function core/FunctionDef
  (with epoch-close-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-leak-entry") []
        []
        [(core/->BranchTerminator (obligation-id "ssa-input")
           (obligation-id "block-leak-open")
           (obligation-id "block-leak-close"))])
      (core/->BasicBlock (obligation-id "block-leak-open") []
        [(epoch-open-instruction)]
        [(core/->ReturnTerminator nil)])
      (core/->BasicBlock (obligation-id "block-leak-close") []
        [(epoch-close-instruction "leak")]
        [(core/->ReturnTerminator nil)])]]
    [:entry-block (obligation-id "block-leak-entry")]))

(def branch-close-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [branch-close-function]]))

;; --- Atom-cell epoch fixtures. Cells are root-pinned in v0, so the question
;; a store into one asks is the epoch RELATION — is the stored value's epoch an
;; ancestor-of-or-equal of the cell's? — and never the stored value's shape. The
;; trio below pins all three answers: a root value owning arena storage is
;; legal, the same store from a minted epoch is not, and `promote` is what
;; makes the second one legal.

(def fixture-atom-state-region core/RegionDef
  (core/->RegionDef (obligation-id "region-atom-state")
    (core/->ExternalRegion true) nil))

(def fixture-cell-type core/TypeDef
  (core/->TypeDef (obligation-id "type-cell") "AtomCell"
    (core/->AtomCellTypeV0 (obligation-id "type-text"))))

(defn root-arena-instruction [] core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (obligation-id "ssa-root-arena")
      (obligation-id "type-arena"))
    (obligation-id "region-fixture")
    (obligation-id "capability-write")
    (core/->TokenFlowV0 [(obligation-id "region-fixture")] [])))

(defn atom-state-instruction [] core/Instruction
  (core/->AtomStateInstruction
    (core/->SsaValueV0 (obligation-id "ssa-atom-state")
      (obligation-id "type-arena"))
    (obligation-id "region-atom-state")
    (obligation-id "capability-write")
    (core/->TokenFlowV0 [(obligation-id "region-atom-state")] [])))

(defn root-text-instruction [(label String)] core/Instruction
  (core/->TextConcatInstruction
    (core/->SsaValueV0 (obligation-id (str "ssa-root-text-" label))
      (obligation-id "type-text"))
    (obligation-id "ssa-root-arena")
    []))

(defn atom-create-instruction [] core/Instruction
  (core/->AtomCreateInstruction
    (core/->SsaValueV0 (obligation-id "ssa-cell")
      (obligation-id "type-cell"))
    (obligation-id "ssa-root-text-initial")
    (obligation-id "ssa-root-arena")
    (obligation-id "ssa-atom-state")))

(defn atom-reset-instruction [(value-id core/NativeId)] core/Instruction
  (core/->AtomResetInstruction
    (core/->SsaValueV0 (obligation-id "ssa-cell-reset")
      (obligation-id "type-text"))
    (obligation-id "ssa-cell")
    (obligation-id "ssa-atom-state")
    value-id))

;; Epoch-soundness positive #2: a handle-carrying value allocated in the ROOT
;; arena, stored into a root-pinned cell. No epoch is minted anywhere in this
;; function — the program is epoch-0 throughout — so there is no old-to-young
;; edge to refuse, and the store's legality may not turn on the value owning
;; arena storage. This is the repro trio's `a-vec-loop` at IR level.
(def atom-root-store-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-atom-root-store")
    "atom-root-store"
    [(core/->Parameter (obligation-id "ssa-input") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-atom-root") []
       [(root-arena-instruction)
        (atom-state-instruction)
        (root-text-instruction "initial")
        (atom-create-instruction)
        (root-text-instruction "next")
        (atom-reset-instruction (obligation-id "ssa-root-text-next"))]
       [(core/->ReturnTerminator (obligation-id "ssa-input"))])]
    (obligation-id "block-atom-root")
    (obligation-id "type-i64")
    [] [(obligation-id "region-fixture") (obligation-id "region-atom-state")]
    [(obligation-id "capability-write")]))

(def atom-epoch-program core/NativeCoreProgram
  (with valid-program
    [:types [fixture-i64-type fixture-union-type fixture-outcome-type
             fixture-text-type fixture-arena-type fixture-cell-type]]
    [:regions [fixture-region fixture-epoch-region fixture-epoch-inner-region
               fixture-atom-state-region]]
    [:functions [atom-root-store-function]]))

;; Epoch-soundness negative #4: the true old-to-young store into a cell — the
;; value is allocated in a MINTED epoch that closes inside the function, and
;; the root-pinned cell would outlive it.
(def atom-young-store-function core/FunctionDef
  (with atom-root-store-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-atom-young") []
        [(root-arena-instruction)
         (atom-state-instruction)
         (root-text-instruction "initial")
         (atom-create-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (atom-reset-instruction (obligation-id "ssa-young-text"))
         (epoch-close-instruction "atom")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]
    [:entry-block (obligation-id "block-atom-young")]
    [:regions [(obligation-id "region-fixture")
               (obligation-id "region-atom-state")
               (obligation-id "region-epoch")]]))

(def atom-young-store-program core/NativeCoreProgram
  (with atom-epoch-program [:functions [atom-young-store-function]]))

;; Epoch-soundness positive #3: the same store, with the young value copied
;; into the root arena first. `promote` is the admission the negative above is
;; missing, and nothing else about the program changes.
(defn promote-instruction [] core/Instruction
  (core/->PromoteInstructionV0
    (core/->SsaValueV0 (obligation-id "ssa-promoted-text")
      (obligation-id "type-text"))
    (obligation-id "ssa-young-text")
    (obligation-id "type-text")
    (obligation-id "ssa-root-arena")))

(def atom-promoted-store-function core/FunctionDef
  (with atom-young-store-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-atom-promoted") []
        [(root-arena-instruction)
         (atom-state-instruction)
         (root-text-instruction "initial")
         (atom-create-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (promote-instruction)
         (atom-reset-instruction (obligation-id "ssa-promoted-text"))
         (epoch-close-instruction "atom")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]
    [:entry-block (obligation-id "block-atom-promoted")]))

(def atom-promoted-store-program core/NativeCoreProgram
  (with atom-epoch-program [:functions [atom-promoted-store-function]]))

(def epoch-soundness-positive Bool
  (obligation-passed? (epoch-soundness epoch-sound-program)))

(def epoch-soundness-positive-atom-root-store Bool
  (obligation-passed? (epoch-soundness atom-epoch-program)))

(def epoch-soundness-positive-atom-promoted-store Bool
  (obligation-passed? (epoch-soundness atom-promoted-store-program)))

(def epoch-soundness-negative Bool
  (= "epoch-soundness" (verdict-tag (epoch-soundness old-young-store-program))))

(def leak-freedom-positive Bool
  (obligation-passed? (leak-freedom epoch-close-program)))

(def leak-freedom-negative Bool
  (= "leak-freedom" (verdict-tag (leak-freedom branch-close-program))))

;; --- Rejection-depth corpus: two additional corrupt-program fixtures per
;; obligation beyond the one landed above, each a distinct corruption vector.

;; valid-ssa #2: a value defined only in one switch arm, used from the
;; sibling arm — no path from entry to the use avoids the def block's
;; sibling, so the def never dominates the use.
(def sibling-block-use-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        []
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])
            (core/->SwitchCaseV0 (obligation-id "variant-right")
              (obligation-id "block-right") [])])])
      (core/->BasicBlock (obligation-id "block-left") []
        [(core/->CopyInstruction
           (core/->SsaValueV0 (obligation-id "ssa-sibling-only")
             (obligation-id "type-i64"))
           (obligation-id "ssa-input"))]
        [(core/->ReturnTerminator (obligation-id "ssa-sibling-only"))])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-sibling-only"))])]]))

(def sibling-block-use-program core/NativeCoreProgram
  (with valid-program [:functions [sibling-block-use-function]]))

;; valid-ssa #3: a jump terminator passes a different number of arguments
;; than the target block declares parameters.
(def jump-mismatch-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-jump-mismatch") "jump-mismatch"
    [(core/->Parameter (obligation-id "ssa-input") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-jump-entry") []
       []
       [(core/->JumpTerminator (obligation-id "block-jump-target")
          [(obligation-id "ssa-input")])])
     (core/->BasicBlock (obligation-id "block-jump-target") [] []
       [(core/->ReturnTerminator nil)])]
    (obligation-id "block-jump-entry")
    nil
    [] [] []))

(def jump-mismatch-program core/NativeCoreProgram
  (with valid-program [:functions [jump-mismatch-function]]))

;; exhaustive-matches #2: a switch that cases the same variant twice
;; instead of covering the union's two distinct variants.
(def duplicate-case-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-checked-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))]
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])
            (core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])])])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])]]))

(def duplicate-case-program core/NativeCoreProgram
  (with valid-program [:functions [duplicate-case-function]]))

;; exhaustive-matches #3: a switch that cases an unknown variant id in
;; place of one of the union's real variants.
(def unknown-variant-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-checked-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))]
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])
            (core/->SwitchCaseV0 (obligation-id "variant-unknown")
              (obligation-id "block-right") [])])])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])]]))

(def unknown-variant-program core/NativeCoreProgram
  (with valid-program [:functions [unknown-variant-function]]))

;; closed-layouts #2: a layout whose size is zero (missing size).
(def zero-size-i64-layout core/LayoutDef
  (with fixture-i64-layout [:size-bytes 0]))

(def zero-size-layout-program core/NativeCoreProgram
  (with valid-program
    [:layouts [zero-size-i64-layout fixture-union-layout fixture-outcome-layout]]))

;; closed-layouts #3: a union layout whose tag offset is not aligned to
;; the tag type's own alignment (misaligned offset).
(def misaligned-union-layout core/LayoutDef
  (with fixture-union-layout
    [:shape (core/->UnionShapeV0 (obligation-id "type-i64") 3
              [(core/->UnionVariantLayoutV0 (obligation-id "variant-left") 0 nil 8)
               (core/->UnionVariantLayoutV0 (obligation-id "variant-right") 1 nil 8)])]))

(def misaligned-offset-program core/NativeCoreProgram
  (with valid-program
    [:layouts [fixture-i64-layout misaligned-union-layout fixture-outcome-layout]]))

;; checked-arithmetic #2: a checked result consumed directly by an
;; ordinary instruction instead of being dispatched through a switch.
(def raw-consume-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-checked-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))
         (core/->CopyInstruction
           (core/->SsaValueV0 (obligation-id "ssa-raw-copy")
             (obligation-id "type-checked-i64"))
           (obligation-id "ssa-result"))]
        [(core/->ReturnTerminator (obligation-id "ssa-raw-copy"))])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator nil)])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator nil)])]]))

(def raw-consume-program core/NativeCoreProgram
  (with valid-program [:functions [raw-consume-function]]))

;; checked-arithmetic #3: a checked operation whose result is typed as a
;; plain value instead of an Outcome type.
(def non-outcome-result-function core/FunctionDef
  (with fixture-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-entry") []
        [(core/->CheckedInstruction
           (core/->SsaValueV0 (obligation-id "ssa-result")
             (obligation-id "type-i64"))
           (core/->CheckedAddI64V0 (obligation-id "ssa-input")
             (obligation-id "ssa-input")))]
        [(core/->SwitchTerminator (obligation-id "ssa-choice")
           [(core/->SwitchCaseV0 (obligation-id "variant-left")
              (obligation-id "block-left") [])
            (core/->SwitchCaseV0 (obligation-id "variant-right")
              (obligation-id "block-right") [])])])
      (core/->BasicBlock (obligation-id "block-left") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])
      (core/->BasicBlock (obligation-id "block-right") [] []
        [(core/->ReturnTerminator (obligation-id "ssa-result"))])]]))

(def non-outcome-result-program core/NativeCoreProgram
  (with valid-program [:functions [non-outcome-result-function]]))

;; legal-abi #2: the ABI result type does not match the function's own
;; declared return type.
(def result-type-mismatch-abi core/AbiDeclV0
  (with fixture-abi
    [:result (core/->AbiValueV0 "result" (obligation-id "type-i64")
               (core/->OwnedV0 true) nil)]))

(def result-type-mismatch-program core/NativeCoreProgram
  (with valid-program [:abis [result-type-mismatch-abi]]))

;; legal-abi #3: the ABI requires a capability the function never declares.
(def missing-capability-abi core/AbiDeclV0
  (with fixture-abi
    [:required-capabilities [(obligation-id "capability-write")]]))

(def missing-capability-abi-program core/NativeCoreProgram
  (with valid-program [:abis [missing-capability-abi]]))

;; discharged-tokens #2: one branch of a two-way split never consumes the
;; tokens live at entry, so they leak on that path.
(def leak-token-function core/FunctionDef
  (with fixture-token-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-token-entry") []
        []
        [(core/->BranchTerminator (obligation-id "ssa-address")
           (obligation-id "block-token-consumed")
           (obligation-id "block-token-leak"))])
      (core/->BasicBlock (obligation-id "block-token-consumed") []
        [(core/->StoreInstruction
           (core/->SsaValueV0 (obligation-id "ssa-store")
             (obligation-id "type-i64"))
           (core/->StoreI64 (obligation-id "ssa-address")
             (obligation-id "ssa-value")
             (obligation-id "region-fixture")
             (obligation-id "capability-write"))
           (core/->TokenFlowV0
             [(obligation-id "region-fixture")
              (obligation-id "capability-write")]
             []))]
        [(core/->ReturnTerminator nil)])
      (core/->BasicBlock (obligation-id "block-token-leak") [] []
        [(core/->ReturnTerminator nil)])]]
    [:entry-block (obligation-id "block-token-entry")]))

(def leak-token-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function leak-token-function]]))

;; discharged-tokens #3: a consume names a token id that was never
;; produced or live (a phantom consume, distinct from double-consuming a
;; live one).
(def phantom-consume-token-function core/FunctionDef
  (with fixture-token-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-store") []
        [(core/->StoreInstruction
           (core/->SsaValueV0 (obligation-id "ssa-store")
             (obligation-id "type-i64"))
           (core/->StoreI64 (obligation-id "ssa-address")
             (obligation-id "ssa-value")
             (obligation-id "region-fixture")
             (obligation-id "capability-write"))
           (core/->TokenFlowV0
             [(obligation-id "region-fixture")
              (obligation-id "capability-write")
              (obligation-id "capability-phantom")]
             []))]
        [(core/->ReturnTerminator nil)])]]))

(def phantom-consume-token-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function phantom-consume-token-function]]))

;; bounded-effects #2: a store references a region absent from the
;; function's own declared regions (undeclared resource use, not merely
;; an uncovering effect).
(def undeclared-region-function core/FunctionDef
  (with fixture-token-function [:regions []]))

(def undeclared-region-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function undeclared-region-function]]))

;; bounded-effects #3: a call to a callee whose declared effects and
;; capabilities are not a subset of the caller's (effect widening
;; through a call).
(def unbounded-call-function core/FunctionDef
  (core/->FunctionDef (obligation-id "function-caller") "caller"
    [(core/->Parameter (obligation-id "ssa-address") (obligation-id "type-i64"))
     (core/->Parameter (obligation-id "ssa-value") (obligation-id "type-i64"))]
    [(core/->BasicBlock (obligation-id "block-caller") []
       [(core/->CallInstruction
          (core/->SsaValueV0 (obligation-id "ssa-call-result")
            (obligation-id "type-i64"))
          (obligation-id "function-store")
          [(obligation-id "ssa-address") (obligation-id "ssa-value")]
          nil
          (core/->TokenFlowV0 [] []))]
       [(core/->ReturnTerminator nil)])]
    (obligation-id "block-caller")
    nil
    [] [] []))

(def unbounded-call-program core/NativeCoreProgram
  (with valid-program
    [:functions [fixture-function fixture-token-function unbounded-call-function]]))

;; epoch-soundness #2: a young-epoch value RETURNED from the function that
;; closes its epoch (escape through the crossing set of a dead region).
(def return-young-function core/FunctionDef
  (with epoch-sound-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(epoch-open-instruction)
         (epoch-young-text-instruction)
         (epoch-close-instruction "return")]
        [(core/->ReturnTerminator (obligation-id "ssa-young-text"))])]]))

(def return-young-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [return-young-function]]))

;; epoch-soundness #3: a young-epoch value passed as a call argument — a
;; missing callee summary means retained, so the argument must carry driver
;; lifetime.
(def call-young-function core/FunctionDef
  (with epoch-sound-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(epoch-open-instruction)
         (epoch-young-text-instruction)
         (core/->CallInstruction
           (core/->SsaValueV0 (obligation-id "ssa-young-call")
             (obligation-id "type-i64"))
           (obligation-id "function-store")
           [(obligation-id "ssa-young-text") (obligation-id "ssa-input")]
           nil
           (core/->TokenFlowV0 [] []))
         (epoch-close-instruction "call")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]))

(def call-young-program core/NativeCoreProgram
  (with epoch-sound-program
    [:functions [fixture-token-function call-young-function]]))

;; --- E3 promote-admission fixtures. The admitted pair hands the young Text
;; across a call and promotes the call RESULT into the root arena as the
;; result's only use; each negative keeps the promote and adds exactly one
;; more use of the raw result.

(defn young-call-instruction [] core/Instruction
  (core/->CallInstruction
    (core/->SsaValueV0 (obligation-id "ssa-e3-call")
      (obligation-id "type-text"))
    (obligation-id "function-store")
    [(obligation-id "ssa-young-text") (obligation-id "ssa-input")]
    nil
    (core/->TokenFlowV0 [] [])))

(defn young-extern-call-instruction [] core/Instruction
  (core/->ExternCallInstruction
    (core/->SsaValueV0 (obligation-id "ssa-e3-extern")
      (obligation-id "type-text"))
    (obligation-id "abi-checked-add")
    [(obligation-id "ssa-young-text") (obligation-id "ssa-input")]
    nil
    (core/->TokenFlowV0 [] [])))

(defn promote-result-instruction
  [(label String)
   (source core/NativeId)] core/Instruction
  (core/->PromoteInstructionV0
    (core/->SsaValueV0 (obligation-id (str "ssa-e3-promoted-" label))
      (obligation-id "type-text"))
    source
    (obligation-id "type-text")
    (obligation-id "ssa-root-arena")))

;; E3 positive: young argument, result promoted to the root arena, no other
;; use — admitted.
(def call-promote-function core/FunctionDef
  (with epoch-sound-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(root-arena-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (young-call-instruction)
         (promote-result-instruction "call" (obligation-id "ssa-e3-call"))
         (epoch-close-instruction "e3-call")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]
    [:regions [(obligation-id "region-fixture")
               (obligation-id "region-epoch")]]))

(def call-promote-program core/NativeCoreProgram
  (with epoch-sound-program
    [:functions [fixture-token-function call-promote-function]]))

;; E3 negative #1: the promoted result ALSO resets a root-pinned cell raw —
;; a second escaping use, so the admission may not fire.
(def call-promote-atom-escape-function core/FunctionDef
  (with call-promote-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(root-arena-instruction)
         (atom-state-instruction)
         (root-text-instruction "initial")
         (atom-create-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (young-call-instruction)
         (promote-result-instruction "atom-escape"
           (obligation-id "ssa-e3-call"))
         (atom-reset-instruction (obligation-id "ssa-e3-call"))
         (epoch-close-instruction "e3-atom")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]
    [:regions [(obligation-id "region-fixture")
               (obligation-id "region-atom-state")
               (obligation-id "region-epoch")]]))

(def call-promote-atom-escape-program core/NativeCoreProgram
  (with atom-epoch-program
    [:functions [fixture-token-function call-promote-atom-escape-function]]))

;; E3 negative #2: the raw result also feeds a Text build in the YOUNG arena.
;; That write is legal on its own (young into young), so this is the one
;; corruption only the escape walk itself refuses.
(def call-promote-young-use-function core/FunctionDef
  (with call-promote-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(root-arena-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (young-call-instruction)
         (promote-result-instruction "young-use"
           (obligation-id "ssa-e3-call"))
         (core/->TextConcatInstruction
           (core/->SsaValueV0 (obligation-id "ssa-e3-young-use")
             (obligation-id "type-text"))
           (obligation-id "ssa-epoch-arena")
           [(obligation-id "ssa-e3-call")])
         (epoch-close-instruction "e3-young-use")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]))

(def call-promote-young-use-program core/NativeCoreProgram
  (with epoch-sound-program
    [:functions [fixture-token-function call-promote-young-use-function]]))

;; E3 extern positive: the same admitted shape through an extern call.
(def extern-promote-function core/FunctionDef
  (with call-promote-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(root-arena-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (young-extern-call-instruction)
         (promote-result-instruction "extern"
           (obligation-id "ssa-e3-extern"))
         (epoch-close-instruction "e3-extern")]
        [(core/->ReturnTerminator (obligation-id "ssa-input"))])]]))

(def extern-promote-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [extern-promote-function]]))

;; E3 extern negative: the promoted extern result is ALSO returned raw.
(def extern-promote-return-function core/FunctionDef
  (with extern-promote-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-epoch-entry") []
        [(root-arena-instruction)
         (epoch-open-instruction)
         (epoch-young-text-instruction)
         (young-extern-call-instruction)
         (promote-result-instruction "extern-return"
           (obligation-id "ssa-e3-extern"))
         (epoch-close-instruction "e3-extern-return")]
        [(core/->ReturnTerminator (obligation-id "ssa-e3-extern"))])]]))

(def extern-promote-return-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [extern-promote-return-function]]))

;; leak-freedom #2: LIFO violation — the outer epoch closes while its child
;; is still open (closes must run in reverse tree order).
(def lifo-violation-function core/FunctionDef
  (with epoch-close-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-lifo-entry") []
        [(epoch-open-instruction)
         (core/->ArenaInstruction
           (core/->SsaValueV0 (obligation-id "ssa-epoch-inner-arena")
             (obligation-id "type-arena"))
           (obligation-id "region-epoch-inner")
           (obligation-id "capability-write")
           (core/->TokenFlowV0 []
             [(core/->ResourceTokenV0 (obligation-id "token-epoch-inner")
                (core/->RegionTokenV0 (obligation-id "region-epoch-inner")))]))
         (epoch-close-instruction "lifo")]
        [(core/->ReturnTerminator nil)])]]
    [:entry-block (obligation-id "block-lifo-entry")]))

(def lifo-violation-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [lifo-violation-function]]))

;; leak-freedom #3: a double close — the second close finds its epoch already
;; popped (distinct from never closing at all).
(def double-close-function core/FunctionDef
  (with epoch-close-function
    [:blocks
     [(core/->BasicBlock (obligation-id "block-double-entry") []
        [(epoch-open-instruction)
         (epoch-close-instruction "first")
         (epoch-close-instruction "second")]
        [(core/->ReturnTerminator nil)])]]
    [:entry-block (obligation-id "block-double-entry")]))

(def double-close-program core/NativeCoreProgram
  (with epoch-sound-program [:functions [double-close-function]]))

(def valid-ssa-negative-sibling Bool
  (= "valid-ssa" (verdict-tag (valid-ssa sibling-block-use-program))))

(def valid-ssa-negative-jump-mismatch Bool
  (= "valid-ssa" (verdict-tag (valid-ssa jump-mismatch-program))))

(def exhaustive-matches-negative-duplicate Bool
  (= "exhaustive-matches" (verdict-tag (exhaustive-matches duplicate-case-program))))

(def exhaustive-matches-negative-unknown-variant Bool
  (= "exhaustive-matches" (verdict-tag (exhaustive-matches unknown-variant-program))))

(def closed-layouts-negative-zero-size Bool
  (= "closed-layouts"
    (verdict-tag (closed-layouts zero-size-layout-program (core/abi-profile-lp64)))))

(def closed-layouts-negative-misaligned-offset Bool
  (= "closed-layouts"
    (verdict-tag
      (closed-layouts misaligned-offset-program (core/abi-profile-lp64)))))

(def checked-arithmetic-negative-raw-consume Bool
  (= "checked-arithmetic" (verdict-tag (checked-arithmetic raw-consume-program))))

(def checked-arithmetic-negative-non-outcome Bool
  (= "checked-arithmetic" (verdict-tag (checked-arithmetic non-outcome-result-program))))

(def legal-abi-negative-result-mismatch Bool
  (= "legal-abi" (verdict-tag (legal-abi result-type-mismatch-program))))

(def legal-abi-negative-missing-capability Bool
  (= "legal-abi" (verdict-tag (legal-abi missing-capability-abi-program))))

(def discharged-tokens-negative-leak Bool
  (= "discharged-tokens" (verdict-tag (discharged-tokens leak-token-program))))

(def discharged-tokens-negative-phantom-consume Bool
  (= "discharged-tokens" (verdict-tag (discharged-tokens phantom-consume-token-program))))

(def bounded-effects-negative-undeclared-region Bool
  (= "bounded-effects" (verdict-tag (bounded-effects undeclared-region-program))))

(def bounded-effects-negative-unbounded-call Bool
  (= "bounded-effects" (verdict-tag (bounded-effects unbounded-call-program))))

(def epoch-soundness-negative-return-young Bool
  (= "epoch-soundness" (verdict-tag (epoch-soundness return-young-program))))

(def epoch-soundness-negative-call-young Bool
  (= "epoch-soundness" (verdict-tag (epoch-soundness call-young-program))))

(def epoch-soundness-negative-atom-young-store Bool
  (= "epoch-soundness" (verdict-tag (epoch-soundness atom-young-store-program))))

(def epoch-soundness-positive-call-promoted-result Bool
  (obligation-passed? (epoch-soundness call-promote-program)))

(def epoch-soundness-negative-call-promote-atom-escape Bool
  (= "epoch-soundness"
    (verdict-tag (epoch-soundness call-promote-atom-escape-program))))

(def epoch-soundness-negative-call-promote-young-use Bool
  (= "epoch-soundness"
    (verdict-tag (epoch-soundness call-promote-young-use-program))))

(def epoch-soundness-positive-extern-promoted-result Bool
  (obligation-passed? (epoch-soundness extern-promote-program)))

(def epoch-soundness-negative-extern-promote-return Bool
  (= "epoch-soundness"
    (verdict-tag (epoch-soundness extern-promote-return-program))))

(def leak-freedom-negative-lifo Bool
  (= "leak-freedom" (verdict-tag (leak-freedom lifo-violation-program))))

(def leak-freedom-negative-double-close Bool
  (= "leak-freedom" (verdict-tag (leak-freedom double-close-program))))

(def rejection-depth-results (Vec Bool)
  [valid-ssa-negative-sibling
   valid-ssa-negative-jump-mismatch
   exhaustive-matches-negative-duplicate
   exhaustive-matches-negative-unknown-variant
   closed-layouts-negative-zero-size
   closed-layouts-negative-misaligned-offset
   checked-arithmetic-negative-raw-consume
   checked-arithmetic-negative-non-outcome
   legal-abi-negative-result-mismatch
   legal-abi-negative-missing-capability
   discharged-tokens-negative-leak
   discharged-tokens-negative-phantom-consume
   bounded-effects-negative-undeclared-region
   bounded-effects-negative-unbounded-call
   epoch-soundness-negative-return-young
   epoch-soundness-negative-call-young
   epoch-soundness-negative-atom-young-store
   epoch-soundness-negative-call-promote-atom-escape
   epoch-soundness-negative-call-promote-young-use
   epoch-soundness-negative-extern-promote-return
   leak-freedom-negative-lifo
   leak-freedom-negative-double-close])

(def twenty-two-rejection-depth-fixtures-named? Bool
  (every? (fn [(passed Bool)] Bool passed) rejection-depth-results))

(defn validate-native-core-program
  [(program core/NativeCoreProgram)
   (abi core/AbiProfileV0)] (Vec ObligationVerdictV0)
  [(valid-ssa program)
   (exhaustive-matches program)
   (closed-layouts program abi)
   (checked-arithmetic program)
   (legal-abi program)
   (discharged-tokens program)
   (bounded-effects program)
   (epoch-soundness program)
   (leak-freedom program)
   (deterministic-parallelism program)])

(def valid-fixture-results (Vec Bool)
  (mapv (fn [(verdict ObligationVerdictV0)] Bool
          (obligation-passed? verdict))
    (validate-native-core-program valid-program (core/abi-profile-lp64))))

(def negative-fixture-results (Vec Bool)
  [valid-ssa-negative
   exhaustive-matches-negative
   closed-layouts-negative
   checked-arithmetic-negative
   legal-abi-negative
   discharged-tokens-negative
   bounded-effects-negative
   epoch-soundness-negative
   leak-freedom-negative
   true])

(def nine-valid-passes? Bool
  (and (every? (fn [(passed Bool)] Bool passed) valid-fixture-results)
    epoch-soundness-positive
    epoch-soundness-positive-atom-root-store
    epoch-soundness-positive-atom-promoted-store
    epoch-soundness-positive-call-promoted-result
    epoch-soundness-positive-extern-promoted-result
    leak-freedom-positive))

(def nine-negatives-named? Bool
  (every? (fn [(passed Bool)] Bool passed) negative-fixture-results))
