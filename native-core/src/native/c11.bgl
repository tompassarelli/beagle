;; @upstream:graph — operator-authorized text arm; re-ingest after landing.
(ns native.c11)

(define-mode strict)

(require native.core :as core)

(defrecord C11Artifact [header-name: String header-text: String source-name: String source-text: String])

(defunion C11Materialization
  (C11Success [artifact: C11Artifact])
  (C11Failure [detail: String]))

(defn join-lines [lines: (Vec String)] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count lines))
      result
      (recur (+ index 1) (str result (nth lines index) "\n")))))

(defn id-before? [left: core/NativeId right: core/NativeId] -> Bool
  (< (compare (core/nativeid-value left) (core/nativeid-value right)) 0))

(defn insert-type [item: core/TypeDef sorted: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/TypeDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/TypeDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/typedef-id item) (core/typedef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-types [types: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [index: Int 0 result: (Vec core/TypeDef) []]
    (if (>= index (count types))
      result
      (recur (+ index 1) (insert-type (nth types index) result)))))

(defn insert-layout [item: core/LayoutDef sorted: (Vec core/LayoutDef)] -> (Vec core/LayoutDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/LayoutDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/LayoutDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/layoutdef-id item) (core/layoutdef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-layouts [layouts: (Vec core/LayoutDef)] -> (Vec core/LayoutDef)
  (loop [index: Int 0 result: (Vec core/LayoutDef) []]
    (if (>= index (count layouts))
      result
      (recur (+ index 1) (insert-layout (nth layouts index) result)))))

(defn insert-function [item: core/FunctionDef sorted: (Vec core/FunctionDef)] -> (Vec core/FunctionDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/FunctionDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/FunctionDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/functiondef-id item) (core/functiondef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-functions [functions: (Vec core/FunctionDef)] -> (Vec core/FunctionDef)
  (loop [index: Int 0 result: (Vec core/FunctionDef) []]
    (if (>= index (count functions))
      result
      (recur (+ index 1) (insert-function (nth functions index) result)))))

(defn insert-field-layout [item: core/FieldLayout sorted: (Vec core/FieldLayout)] -> (Vec core/FieldLayout)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/FieldLayout) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/FieldLayout (nth sorted index)]
        (if (and (not inserted) (< (core/fieldlayout-offset item) (core/fieldlayout-offset current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-field-layouts [fields: (Vec core/FieldLayout)] -> (Vec core/FieldLayout)
  (loop [index: Int 0 result: (Vec core/FieldLayout) []]
    (if (>= index (count fields))
      result
      (recur (+ index 1) (insert-field-layout (nth fields index) result)))))

(defn type-index [types: (Vec core/TypeDef) type-id: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count types))
      -1
      (if (core/native-id= (core/typedef-id (nth types index)) type-id)
        index
        (recur (+ index 1))))))

(defn layout-for-type [layouts: (Vec core/LayoutDef) type-id: core/NativeId] -> (U core/LayoutDef Nil)
  (loop [index: Int 0]
    (if (>= index (count layouts))
      nil
      (let [layout: core/LayoutDef (nth layouts index)]
        (if (core/native-id= (core/layoutdef-type-id layout) type-id)
          layout
          (recur (+ index 1)))))))

(defn atom-kind-supported? [kind: core/AtomKind] -> Bool
  (match kind
    [(BoolKind token) true]
    [(I64Kind token) true]
    [(F64Kind token) true]
    [(TextKind token) false]
    [(RefKind target) false]))

(defn type-supported? [type-def: core/TypeDef layouts: (Vec core/LayoutDef)] -> Bool
  (let [shape: core/TypeShape (core/typedef-shape type-def)]
    (match shape
      [(AtomType value) (atom-kind-supported? (core/atomtype-kind shape))]
      [(RecordType value) (some? (layout-for-type layouts (core/typedef-id type-def)))]
      [(UnionType value) false]
      [(VectorType value) false]
      [(ReferenceType value) false])))

(defn atom-supported? [atom: core/NativeAtom] -> Bool
  (match atom
    [(BoolAtom value) true]
    [(I64Atom value) true]
    [(F64Atom value) true]
    [(TextAtom value) false]
    [(RefAtom target) false]))

(defn instruction-supported? [instruction: core/Instruction] -> Bool
  (match instruction
    [(AtomInstruction value) (atom-supported? (core/atominstruction-atom instruction))]
    [(CopyInstruction value) false]
    [(AddI64Instruction value) true]
    [(AddF64Instruction value) true]
    [(StoreInstruction value) false]
    [(CallInstruction value) false]))

(defn terminator-supported? [terminator: core/Terminator] -> Bool
  (match terminator
    [(ReturnTerminator value) true]
    [(JumpTerminator value) false]
    [(BranchTerminator value) false]))

(defn block-supported? [block: core/BasicBlock] -> Bool
  (and (every? instruction-supported? (core/basicblock-instructions block))
    (every? terminator-supported? (core/basicblock-terminators block))))

(defn function-supported? [function: core/FunctionDef] -> Bool
  (and (= 1 (count (core/functiondef-blocks function)))
    (every? block-supported? (core/functiondef-blocks function))))

(defn world-supported? [world: core/NativeWorld] -> Bool
  (let [layouts: (Vec core/LayoutDef) (core/nativeworld-layouts world)]
    (and (every? (fn [type-def: core/TypeDef] -> Bool (type-supported? type-def layouts))
           (core/nativeworld-types world))
      (every? function-supported? (core/nativeworld-functions world)))))

(defn module-prefix [module-index: Int] -> String
  (str "native_m" module-index))

(defn type-name [module-index: Int type-index-value: Int] -> String
  (str (module-prefix module-index) "_type_" type-index-value))

(defn c-type [types: (Vec core/TypeDef) module-index: Int type-id: core/NativeId] -> String
  (let [index: Int (type-index types type-id)]
    (if (< index 0)
      "void"
      (type-name module-index index))))

(defn emit-layout-assertions [type-name-value: String layout: core/LayoutDef fields: (Vec core/FieldLayout)] -> String
  (let [base: (Vec String)
        [(str "_Static_assert(sizeof(" type-name-value ") == " (core/layoutdef-size layout) ", \"layout size\");")
         (str "_Static_assert(_Alignof(" type-name-value ") == " (core/layoutdef-align layout) ", \"layout alignment\");")]]
    (loop [index: Int 0 lines: (Vec String) base]
      (if (>= index (count fields))
        (join-lines lines)
        (let [field: core/FieldLayout (nth fields index)]
          (recur (+ index 1)
            (conj lines
              (str "_Static_assert(offsetof(" type-name-value ", field_" index ") == "
                (core/fieldlayout-offset field) ", \"field offset\");"))))))))

(defn emit-atom-type [type-name-value: String kind: core/AtomKind layout: core/LayoutDef] -> String
  (let [backing: String
        (match kind
          [(BoolKind token) "bool"]
          [(I64Kind token) "int64_t"]
          [(F64Kind token) "double"]
          [(TextKind token) "native_bytes"]
          [(RefKind target) "void *"])]
    (str "typedef " backing " " type-name-value ";\n"
      (emit-layout-assertions type-name-value layout []))) )

(defn emit-record-fields [types: (Vec core/TypeDef) module-index: Int fields: (Vec core/FieldLayout)] -> String
  (loop [index: Int 0 lines: (Vec String) []]
    (if (>= index (count fields))
      (join-lines lines)
      (let [field: core/FieldLayout (nth fields index)]
        (recur (+ index 1)
          (conj lines
            (str "  " (c-type types module-index (core/fieldlayout-type-id field)) " field_" index ";")))))))

(defn emit-type [types: (Vec core/TypeDef) layouts: (Vec core/LayoutDef) module-index: Int type-def: core/TypeDef] -> String
  (let [index: Int (type-index types (core/typedef-id type-def))
        type-name-value: String (type-name module-index index)
        layout-value: (U core/LayoutDef Nil) (layout-for-type layouts (core/typedef-id type-def))
        shape: core/TypeShape (core/typedef-shape type-def)]
    (if (nil? layout-value)
      ""
      (match shape
        [(AtomType value) (emit-atom-type type-name-value (core/atomtype-kind shape) layout-value)]
        [(RecordType value)
         (let [fields: (Vec core/FieldLayout) (ordered-field-layouts (core/layoutdef-fields layout-value))]
           (str "typedef struct " type-name-value " {\n"
             (emit-record-fields types module-index fields)
             "} " type-name-value ";\n"
             (emit-layout-assertions type-name-value layout-value fields)))]
        [(UnionType value) ""]
        [(VectorType value) ""]
        [(ReferenceType value) ""]))))

(defn emit-types [types: (Vec core/TypeDef) layouts: (Vec core/LayoutDef) module-index: Int] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count types))
      result
      (recur (+ index 1)
        (str result (emit-type types layouts module-index (nth types index)) "\n")))))

(defn parameter-index [parameters: (Vec core/Parameter) target: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count parameters))
      -1
      (if (core/native-id= (core/parameter-id (nth parameters index)) target)
        index
        (recur (+ index 1))))))

(defn instruction-index [instructions: (Vec core/Instruction) target: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count instructions))
      -1
      (if (core/native-id= (core/instruction-result-id (nth instructions index)) target)
        index
        (recur (+ index 1))))))

(defn value-name [function: core/FunctionDef block: core/BasicBlock target: core/NativeId] -> String
  (let [parameters: (Vec core/Parameter) (core/functiondef-parameters function)
        parameter-position: Int (parameter-index parameters target)]
    (if (>= parameter-position 0)
      (str "native_v_" parameter-position)
      (let [position: Int (instruction-index (core/basicblock-instructions block) target)]
        (str "native_v_" (+ (count parameters) position))))))

(defn function-return-type [types: (Vec core/TypeDef) module-index: Int function: core/FunctionDef] -> String
  (let [return-type: (U core/NativeId Nil) (core/functiondef-return-type function)]
    (if (nil? return-type) "void" (c-type types module-index return-type))))

(defn emit-parameter-list [types: (Vec core/TypeDef) module-index: Int function: core/FunctionDef] -> String
  (let [parameters: (Vec core/Parameter) (core/functiondef-parameters function)
        arena: Bool (> (count (core/functiondef-regions function)) 0)
        capability: Bool (> (count (core/functiondef-capabilities function)) 0)
        initial: (Vec String) (if arena ["native_arena *arena"] [])
        with-capability: (Vec String) (if capability (conj initial "const native_capability *capability") initial)]
    (loop [index: Int 0 result: String ""]
      (if (>= index (count parameters))
        (if (and (= (count with-capability) 0) (= (count result) 0))
          "void"
          (loop [extra-index: Int 0 text: String ""]
            (if (>= extra-index (count with-capability))
              (if (= (count result) 0) text (str text (if (= (count text) 0) "" ", ") result))
              (recur (+ extra-index 1)
                (str text (if (= extra-index 0) "" ", ") (nth with-capability extra-index))))))
        (let [parameter: core/Parameter (nth parameters index)
              fragment: String (str (c-type types module-index (core/parameter-type-id parameter)) " native_v_" index)]
          (recur (+ index 1) (str result (if (= index 0) "" ", ") fragment)))))))

(defn emit-function-prototype [types: (Vec core/TypeDef) module-index: Int function-index: Int function: core/FunctionDef] -> String
  (str (function-return-type types module-index function) " " (module-prefix module-index) "_fn_" function-index
    "(" (emit-parameter-list types module-index function) ");"))

(defn emit-function-prototypes [types: (Vec core/TypeDef) module-index: Int functions: (Vec core/FunctionDef)] -> String
  (loop [index: Int 0 lines: (Vec String) []]
    (if (>= index (count functions))
      (join-lines lines)
      (recur (+ index 1)
        (conj lines (emit-function-prototype types module-index index (nth functions index)))))))

(defn emit-atom-expression [atom: core/NativeAtom] -> String
  (match atom
    [(BoolAtom value) (if (core/boolatom-value atom) "true" "false")]
    [(I64Atom value) (str "INT64_C(" (core/i64atom-value atom) ")")]
    [(F64Atom value) (str (core/f64atom-value atom))]
    [(TextAtom value) ""]
    [(RefAtom target) ""]))

(defn atom-c-type [types: (Vec core/TypeDef) module-index: Int atom: core/NativeAtom] -> String
  (match atom
    [(BoolAtom value) "bool"]
    [(I64Atom value) "int64_t"]
    [(F64Atom value) "double"]
    [(TextAtom value) "native_bytes"]
    [(RefAtom target) "void *"]))

(defn emit-instruction [types: (Vec core/TypeDef) module-index: Int function: core/FunctionDef block: core/BasicBlock instruction-position: Int instruction: core/Instruction] -> String
  (let [result-name: String (str "native_v_" (+ (count (core/functiondef-parameters function)) instruction-position))]
    (match instruction
      [(AtomInstruction value)
       (let [atom-value: core/NativeAtom (core/atominstruction-atom instruction)]
         (str "  " (atom-c-type types module-index atom-value) " " result-name " = " (emit-atom-expression atom-value) ";\n"
           "  (void)" result-name ";\n"))]
      [(CopyInstruction value) ""]
      [(AddI64Instruction value)
       (let [left: String (value-name function block (core/addi64instruction-left-id instruction))
             right: String (value-name function block (core/addi64instruction-right-id instruction))]
         (str "  int64_t " result-name ";\n"
           "  if (((" right " > INT64_C(0)) && (" left " > (INT64_MAX - " right "))) ||\n"
           "      ((" right " < INT64_C(0)) && (" left " < (INT64_MIN - " right ")))) {\n"
           "    native_trap(NATIVE_TRAP_OVERFLOW);\n"
           "  }\n"
           "  " result-name " = " left " + " right ";\n"
           "  (void)" result-name ";\n"))]
      [(AddF64Instruction value)
       (str "  double " result-name " = " (value-name function block (core/addf64instruction-left-id instruction)) " + "
         (value-name function block (core/addf64instruction-right-id instruction)) ";\n  (void)" result-name ";\n")]
      [(StoreInstruction value) ""]
      [(CallInstruction value) ""])))

(defn emit-instructions [types: (Vec core/TypeDef) module-index: Int function: core/FunctionDef block: core/BasicBlock] -> String
  (let [instructions: (Vec core/Instruction) (core/basicblock-instructions block)]
    (loop [index: Int 0 result: String ""]
      (if (>= index (count instructions))
        result
        (recur (+ index 1)
          (str result (emit-instruction types module-index function block index (nth instructions index))))))))

(defn emit-return [function: core/FunctionDef block: core/BasicBlock terminator: core/Terminator] -> String
  (match terminator
    [(ReturnTerminator value)
     (let [return-value: (U core/NativeId Nil) (core/returnterminator-value terminator)]
       (if (nil? return-value) "  return;\n" (str "  return " (value-name function block return-value) ";\n")))]
    [(JumpTerminator value) ""]
    [(BranchTerminator value) ""]))

(defn emit-unused-resources [function: core/FunctionDef] -> String
  (str (if (> (count (core/functiondef-regions function)) 0) "  (void)arena;\n" "")
    (if (> (count (core/functiondef-capabilities function)) 0) "  (void)capability;\n" "")))

(defn emit-function [types: (Vec core/TypeDef) module-index: Int function-index: Int function: core/FunctionDef] -> String
  (let [block: core/BasicBlock (nth (core/functiondef-blocks function) 0)
        terminator: core/Terminator (nth (core/basicblock-terminators block) 0)]
    (str (function-return-type types module-index function) " " (module-prefix module-index) "_fn_" function-index
      "(" (emit-parameter-list types module-index function) ") {\n"
      (emit-unused-resources function)
      (emit-instructions types module-index function block)
      (emit-return function block terminator)
      "}\n")))

(defn emit-functions [types: (Vec core/TypeDef) module-index: Int functions: (Vec core/FunctionDef)] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count functions))
      result
      (recur (+ index 1)
        (str result (emit-function types module-index index (nth functions index)))))))

(defn emit-header [types: (Vec core/TypeDef) layouts: (Vec core/LayoutDef) functions: (Vec core/FunctionDef) module-index: Int] -> String
  (let [guard: String (str "NATIVE_MODULE_" module-index "_ABI_H")]
    (str "/* Generated by native.c11; do not edit. */\n"
      "#ifndef " guard "\n#define " guard "\n\n"
      "#include \"native_shim.h\"\n\n"
      (emit-types types layouts module-index)
      (emit-function-prototypes types module-index functions)
      "\n#endif\n")))

(defn emit-source [functions: (Vec core/FunctionDef) types: (Vec core/TypeDef) module-index: Int header-name: String] -> String
  (str "/* Generated by native.c11; do not edit. */\n"
    "#include \"" header-name "\"\n\n"
    (emit-functions types module-index functions)))

(defn materialize-world [world: core/NativeWorld module-index: Int] -> C11Materialization
  (let [validation: core/ValidationReport (core/validate-world world)]
    (cond
      (< module-index 0)
      (->C11Failure "module index must be nonnegative")
      (not (core/validationreport-passed validation))
      (->C11Failure "native world is not sealed: validation obligations failed")
      (not (world-supported? world))
      (->C11Failure "native world uses a shape outside the restricted C17 reference slice")
      :else
      (let [types: (Vec core/TypeDef) (ordered-types (core/nativeworld-types world))
            layouts: (Vec core/LayoutDef) (ordered-layouts (core/nativeworld-layouts world))
            functions: (Vec core/FunctionDef) (ordered-functions (core/nativeworld-functions world))
            header-name: String (str "module_" module-index ".h")
            source-name: String (str "module_" module-index ".c")
            header-text: String (emit-header types layouts functions module-index)
            source-text: String (emit-source functions types module-index header-name)]
        (->C11Success (->C11Artifact header-name header-text source-name source-text))))))
