#lang beagle/clj
(ns native.stages (:require [native.core :as core]))


;; Recursive terms refer to one another by stable identity so every stage kind
;; shares the same finite, canonical graph representation.
(defunion TermV0
  (NilTermV0 [token Bool])
  (BoolTermV0 [value Bool])
  (I64TermV0 [value Int])
  (F64TermV0 [canonical-value String])
  (TextTermV0 [value String])
  (RefTermV0 [target core/NativeId])
  (TripleTermV0
    [subject core/NativeId
     predicate core/NativeId
     object core/NativeId]))

(defrecord TermNodeV0
  [identity core/NativeId
   term TermV0])

(defrecord TermGraphV0
  [root core/NativeId
   nodes (Vec TermNodeV0)])

(defrecord SourceLocationV0
  [module-id core/NativeId
   relative-path String
   line Int
   column Int])

(defrecord SourceModuleV1
  [id core/NativeId
   name String
   relative-path String
   source-digest String
   projection-digest String
   interface-digest String
   root-term core/NativeId])

(defrecord SourceUnitV0
  [id core/NativeId
   module-id core/NativeId
   kind String
   name String
   semantic-digest String
   root-term core/NativeId
   read-set (Vec core/NativeId)])

(defrecord SourceStageV1
  [terms TermGraphV0
   modules (Vec SourceModuleV1)
   units (Vec SourceUnitV0)
   imports (Vec core/NativeId)
   locations (Vec SourceLocationV0)])

(defrecord TypedStageV0
  [terms TermGraphV0
   source-digest String
   type-roots (Vec core/NativeId)
   function-roots (Vec core/NativeId)
   effect-roots (Vec core/NativeId)
   region-roots (Vec core/NativeId)
   capability-token-roots (Vec core/NativeId)
   refinement-roots (Vec core/NativeId)])

;; Core NativeCoreProgram is the typed view; the canonical term graph owns its
;; content identity.
(defrecord NativeStageV0
  [terms TermGraphV0
   typed-digest String
   program core/NativeCoreProgram
   obligation-roots (Vec core/NativeId)])

(defrecord FrozenSourceStageV1
  [stage SourceStageV1
   encoding String
   digest String])

(defrecord FrozenTypedStageV0
  [stage TypedStageV0
   encoding String
   digest String])

(defrecord FrozenNativeStageV0
  [stage NativeStageV0
   encoding String
   digest String])

(defrecord BuildManifestV0
  [receipts (Vec core/ArtifactHashV0)
   artifacts (Vec core/ArtifactHashV0)])

(defn canonical-record
  [tag String
   fields (Vec String)] String
  (str (count tag) ":" tag ":" (core/canonical-parts fields)))

(defn canonical-set
  [tag String
   items (Vec String)] String
  (canonical-record tag (sort items)))

(defn encode-bool [value Bool] String
  (if value "1" "0"))

(defn encode-optional-string [value (U String Nil)] String
  (if (nil? value) (canonical-record "none" []) (canonical-record "some" [value])))

(defn encode-id [id core/NativeId] String
  (canonical-record "id" [(core/nativeid-value id)]))

;; stdlib utf8-encode has no hosted clj lowering, so the digest encodes its own
;; bytes; a surrogate pair recombines into one code point first.
(defn utf8-bytes [text String] (Vec Int)
  (let [units (Vec Any) (vec text)
        size Int (count units)
        empty-bytes (Vec Int) []]
    (loop [index Int 0
           bytes Any (transient empty-bytes)]
      (if (>= index size)
        (persistent! bytes)
        (let [unit Int (int (nth units index))
              paired Bool (and (>= unit 55296) (< unit 56320) (< (+ index 1) size))
              point Int (if paired
                (+ 65536
                  (+ (* (- unit 55296) 1024)
                    (- (int (nth units (+ index 1))) 56320)))
                unit)
              next-index Int (+ index (if paired 2 1))]
          (cond
            (< point 128)
            (recur next-index (conj! bytes point))
            (< point 2048)
            (recur next-index
              (conj! (conj! bytes (+ 192 (quot point 64)))
                (+ 128 (mod point 64))))
            (< point 65536)
            (recur next-index
              (conj! (conj! (conj! bytes (+ 224 (quot point 4096)))
                      (+ 128 (mod (quot point 64) 64)))
                (+ 128 (mod point 64))))
            :else
            (recur next-index
              (conj! (conj! (conj! (conj! bytes
                          (+ 240 (quot point 262144)))
                        (+ 128 (mod (quot point 4096) 64)))
                    (+ 128 (mod (quot point 64) 64)))
                (+ 128 (mod point 64))))))))))

;; Every encoding handed here is already tagged by its own canonical record, so
;; the digest needs no separate domain prefix.
(defn content-digest [encoding String] String
  (str "sha256:" (sha256-bytes (utf8-bytes encoding))))

(defn lowercase-hex-digit? [character Any] Bool
  (some? (some (fn [allowed Any] Bool (= allowed character))
           (vec "0123456789abcdef"))))

(defn sha256-digest? [digest String] Bool
  (and (= 71 (count digest))
       (= "sha256:" (subs digest 0 7))
       (every? lowercase-hex-digit? (vec (subs digest 7 71)))))

(defn canonical-vector
  [tag String
   items (Vec String)] String
  (canonical-record tag items))

(defn encode-int [value Int] String
  (canonical-record "int" [(str value)]))

(defn encode-string [value String] String
  (canonical-record "string" [value]))

(defn encode-optional-id [value (U core/NativeId Nil)] String
  (if (nil? value)
    (canonical-record "none" [])
    (canonical-record "some" [(encode-id value)])))

(defn encode-ids
  [tag String
   ids (Vec core/NativeId)] String
  (canonical-set tag (mapv (fn [id core/NativeId] String (encode-id id)) ids)))

(defn encode-term [term TermV0] String
  (match term
    [(NilTermV0 token) (canonical-record "term-nil-v0" [(encode-bool token)])]
    [(BoolTermV0 value) (canonical-record "term-bool-v0" [(encode-bool value)])]
    [(I64TermV0 value) (canonical-record "term-i64-v0" [(encode-int value)])]
    [(F64TermV0 canonical-value) (canonical-record "term-f64-v0" [canonical-value])]
    [(TextTermV0 value) (canonical-record "term-text-v0" [value])]
    [(RefTermV0 target) (canonical-record "term-ref-v0" [(encode-id target)])]
    [(TripleTermV0 subject predicate object)
     (canonical-record "term-triple-v0"
       [(encode-id subject) (encode-id predicate) (encode-id object)])]))

(defn encode-term-node [node TermNodeV0] String
  (canonical-record "term-node-v0"
    [(encode-id (termnodev0-identity node)) (encode-term (termnodev0-term node))]))

(defn encode-term-graph [graph TermGraphV0] String
  (canonical-record "term-graph-v0"
    [(encode-id (termgraphv0-root graph))
     (canonical-set "nodes"
       (mapv (fn [node TermNodeV0] String (encode-term-node node))
         (termgraphv0-nodes graph)))]))

(defn encode-source-location [location SourceLocationV0] String
  (canonical-record "source-location-v0"
    [(encode-id (sourcelocationv0-module-id location))
     (encode-string (sourcelocationv0-relative-path location))
     (encode-int (sourcelocationv0-line location))
     (encode-int (sourcelocationv0-column location))]))

(defn encode-source-module [module SourceModuleV1] String
  (canonical-record "source-module-v1"
    [(encode-id (sourcemodulev1-id module))
     (encode-string (sourcemodulev1-name module))
     (encode-string (sourcemodulev1-relative-path module))
     (encode-string (sourcemodulev1-source-digest module))
     (encode-string (sourcemodulev1-projection-digest module))
     (encode-string (sourcemodulev1-interface-digest module))
     (encode-id (sourcemodulev1-root-term module))]))

(defn encode-source-unit [unit SourceUnitV0] String
  (canonical-record "source-unit-v0"
    [(encode-id (sourceunitv0-id unit))
     (encode-id (sourceunitv0-module-id unit))
     (encode-string (sourceunitv0-kind unit))
     (encode-string (sourceunitv0-name unit))
     (encode-string (sourceunitv0-semantic-digest unit))
     (encode-id (sourceunitv0-root-term unit))
     (encode-ids "read-set" (sourceunitv0-read-set unit))]))

(defn encode-source-stage [stage SourceStageV1] String
  (canonical-record "source-stage-v1"
    [(encode-term-graph (sourcestagev1-terms stage))
     (canonical-set "modules"
       (mapv (fn [module SourceModuleV1] String (encode-source-module module))
         (sourcestagev1-modules stage)))
     (canonical-set "units"
       (mapv (fn [unit SourceUnitV0] String (encode-source-unit unit))
         (sourcestagev1-units stage)))
     (encode-ids "imports" (sourcestagev1-imports stage))
     (canonical-set "locations"
       (mapv (fn [location SourceLocationV0] String (encode-source-location location))
         (sourcestagev1-locations stage)))]))

(defn encode-typed-stage [stage TypedStageV0] String
  (canonical-record "typed-stage-v0"
    [(encode-term-graph (typedstagev0-terms stage))
     (encode-string (typedstagev0-source-digest stage))
     (encode-ids "type-roots" (typedstagev0-type-roots stage))
     (encode-ids "function-roots" (typedstagev0-function-roots stage))
     (encode-ids "effect-roots" (typedstagev0-effect-roots stage))
     (encode-ids "region-roots" (typedstagev0-region-roots stage))
     (encode-ids "capability-token-roots" (typedstagev0-capability-token-roots stage))
     (encode-ids "refinement-roots" (typedstagev0-refinement-roots stage))]))

(defn encode-region-kind [kind core/RegionKind] String
  (cond
    (instance? native.core.StackRegion kind)
    (canonical-record "region-stack-v0" [(encode-bool (core/stackregion-token kind))])
    (instance? native.core.ArenaRegion kind)
    (canonical-record "region-arena-v0" [(encode-bool (core/arenaregion-token kind))])
    :else
    (canonical-record "region-external-v0" [])))

(defn encode-region [region core/RegionDef] String
  (canonical-record "region-def-v0"
    [(encode-id (core/regiondef-id region))
     (encode-region-kind (core/regiondef-kind region))
     (encode-optional-id (core/regiondef-parent region))]))

(defn encode-observation [observation core/ExternalObservation] String
  (if (instance? native.core.Fri2Observation observation)
    (canonical-record "observation-fri2-v0"
      [(encode-id (core/fri2observation-artifact-id observation))
       (encode-string (core/fri2observation-digest observation))
       (encode-int (core/fri2observation-byte-count observation))])
    (canonical-record "observation-unknown-v0" [])))

(defn encode-native-core-program [program core/NativeCoreProgram] String
  (canonical-record "native-core-program-v0"
    [(encode-id (core/nativecoreprogram-id program))
     (encode-optional-id (core/nativecoreprogram-parent program))
     (encode-string (core/nativecoreprogram-compiler-pass program))
     (encode-ids "allowed-effects" (core/nativecoreprogram-allowed-effects program))
     (encode-ids "allowed-regions" (core/nativecoreprogram-allowed-regions program))
     (encode-ids "allowed-capabilities"
       (core/nativecoreprogram-allowed-capabilities program))
     (canonical-set "regions"
       (mapv (fn [region core/RegionDef] String (encode-region region))
         (core/nativecoreprogram-regions program)))
     (canonical-set "observations"
       (mapv (fn [observation core/ExternalObservation] String
               (encode-observation observation))
         (core/nativecoreprogram-observations program)))]))

(defn encode-native-stage [stage NativeStageV0] String
  (canonical-record "native-stage-v0"
    [(encode-term-graph (nativestagev0-terms stage))
     (encode-string (nativestagev0-typed-digest stage))
     (encode-native-core-program (nativestagev0-program stage))
     (encode-ids "obligation-roots" (nativestagev0-obligation-roots stage))]))

(defn configuration-digest [configuration (Vec String)] String
  (content-digest
    (canonical-set "configuration-v0"
      (mapv (fn [entry String] String (encode-string entry))
        configuration))))

(defn encode-obligation-code [code core/ObligationCode] String
  (cond
    (instance? native.core.ValidSsaObligation code) "valid-ssa"
    (instance? native.core.ExhaustiveMatchesObligation code) "exhaustive-matches"
    (instance? native.core.ClosedLayoutsObligation code) "closed-layouts"
    (instance? native.core.CheckedOperationsObligation code) "checked-operations"
    (instance? native.core.LegalAbiObligation code) "legal-abi"
    (instance? native.core.DischargedTokensObligation code) "discharged-tokens"
    (instance? native.core.BoundedEffectsObligation code) "bounded-effects"
    (instance? native.core.EpochSoundnessObligation code) "epoch-soundness"
    :else "leak-freedom"))

(defn encode-diagnostic [diagnostic core/DiagnosticV0] String
  (canonical-record "diagnostic-v0"
    [(encode-string (core/diagnosticv0-code diagnostic))
     (encode-string (core/diagnosticv0-detail diagnostic))]))

(defn encode-receipt-obligation [obligation core/ReceiptObligationV0] String
  (canonical-record "receipt-obligation-v0"
    [(encode-string (encode-obligation-code
                      (core/receiptobligationv0-code obligation)))
     (encode-string (core/receiptobligationv0-version obligation))
     (encode-string (core/receiptobligationv0-subject-digest obligation))
     (encode-bool (core/receiptobligationv0-passed obligation))
     (encode-string (core/receiptobligationv0-detail obligation))]))

(defn encode-artifact-hash [artifact core/ArtifactHashV0] String
  (canonical-record "artifact-hash-v0"
    [(encode-string (core/artifacthashv0-name artifact))
     (encode-string (core/artifacthashv0-digest artifact))]))

(defn artifact-set-digest [artifacts (Vec core/ArtifactHashV0)] String
  (content-digest
    (canonical-set "artifact-set-v0"
      (mapv (fn [artifact core/ArtifactHashV0] String
              (encode-artifact-hash artifact))
        artifacts))))

(defn encode-pass-receipt [receipt core/PassReceiptV0] String
  (canonical-record "pass-receipt-v0"
    [(encode-id (core/passreceiptv0-id receipt))
     (encode-string (core/passreceiptv0-input-digest receipt))
     (encode-string (core/passreceiptv0-compiler-commit receipt))
     (encode-string (core/passreceiptv0-pass-id receipt))
     (encode-string (core/passreceiptv0-pass-version receipt))
     (canonical-set "configuration-v0"
       (mapv (fn [entry String] String (encode-string entry))
         (core/passreceiptv0-configuration receipt)))
     (encode-string (core/passreceiptv0-configuration-digest receipt))
     (canonical-vector "diagnostics-v0"
       (mapv (fn [diagnostic core/DiagnosticV0] String
               (encode-diagnostic diagnostic))
         (core/passreceiptv0-diagnostics receipt)))
     (canonical-vector "obligations-v0"
       (mapv (fn [obligation core/ReceiptObligationV0] String
               (encode-receipt-obligation obligation))
         (core/passreceiptv0-obligations receipt)))
     (encode-string (core/passreceiptv0-output-digest receipt))
     (encode-string (core/passreceiptv0-backend receipt))
     (encode-string (core/passreceiptv0-backend-version receipt))
     (canonical-set "artifacts-v0"
       (mapv (fn [artifact core/ArtifactHashV0] String
               (encode-artifact-hash artifact))
         (core/passreceiptv0-artifacts receipt)))]))

(defn encode-pass-receipts [receipts (Vec core/PassReceiptV0)] String
  (canonical-vector "pass-receipts-v0"
    (mapv (fn [receipt core/PassReceiptV0] String
            (encode-pass-receipt receipt))
      receipts)))

(defn make-artifact-receipt
  [input-digest String
   compiler-commit String
   pass-id String
   configuration (Vec String)
   backend String
   backend-version String
   artifacts (Vec core/ArtifactHashV0)] core/PassReceiptV0
  (let [output-digest String (artifact-set-digest artifacts)]
    (core/->PassReceiptV0
      (core/->NativeId
        (content-digest
          (canonical-record "artifact-receipt-id-v0"
            [pass-id input-digest output-digest])))
      input-digest
      compiler-commit
      pass-id
      "v0"
      configuration
      (configuration-digest configuration)
      []
      []
      output-digest
      backend
      backend-version
      artifacts)))

(defn encode-build-manifest [manifest BuildManifestV0] String
  (canonical-record "build-manifest-v0"
    [(canonical-set "receipts-v0"
       (mapv (fn [receipt core/ArtifactHashV0] String
               (encode-artifact-hash receipt))
         (buildmanifestv0-receipts manifest)))
     (canonical-set "managed-artifacts-v0"
       (mapv (fn [artifact core/ArtifactHashV0] String
               (encode-artifact-hash artifact))
         (buildmanifestv0-artifacts manifest)))]))


;; The legacy native-stage-v0 encoding above is a content identity.  It omits
;; program fields that materializers consume, so it must not be used as a
;; persistence format.  This separate wire contract preserves the complete
;; generated record graph while retaining the legacy encoding and digest.
(defrecord NativeWirePartV1
  [value String
   next-offset Int])

(defrecord NativeWireRecordV1
  [tag String
   fields (Vec String)])

(defrecord F64AtomBitsWireV1
  [key String
   bits Int])

(defn native-wire-decimal-digit? [character String] Bool
  (or (= character "0") (= character "1") (= character "2")
    (= character "3") (= character "4") (= character "5")
    (= character "6") (= character "7") (= character "8")
    (= character "9")))

(defn native-wire-unsigned-decimal? [value String] Bool
  (and (> (count value) 0)
    (or (= (count value) 1) (not= "0" (subs value 0 1)))
    (every?
      (fn [character Any] Bool
        (native-wire-decimal-digit? (str character)))
      (vec value))))

(defn native-wire-signed-decimal? [value String] Bool
  (if (and (> (count value) 0) (= "-" (subs value 0 1)))
    (and (> (count value) 1)
      (not= "0" (subs value 1 (count value)))
      (native-wire-unsigned-decimal? (subs value 1 (count value))))
    (native-wire-unsigned-decimal? value)))

(defn native-wire-colon-offset
  [text String
   offset Int] Int
  (loop [position Int offset]
    (cond
      (>= position (count text)) -1
      (= ":" (subs text position (+ position 1))) position
      :else (recur (+ position 1)))))

(defn read-native-wire-part
  [text String
   offset Int] (U NativeWirePartV1 Nil)
  (let [colon Int (native-wire-colon-offset text offset)]
    (if (< colon offset)
      nil
      (let [length-text String (subs text offset colon)
            size (U Int Nil) (if (native-wire-unsigned-decimal? length-text)
              (parse-long length-text) nil)
            start Int (+ colon 1)]
        (if (or (nil? size) (> size (- (count text) start)))
          nil
          (->NativeWirePartV1
            (subs text start (+ start size)) (+ start size)))))))

(defn parse-native-wire-record [text String] (U NativeWireRecordV1 Nil)
  (let [tag-part (U NativeWirePartV1 Nil) (read-native-wire-part text 0)]
    (if (nil? tag-part)
      nil
      (let [separator Int (nativewirepartv1-next-offset tag-part)]
        (if (or (>= separator (count text))
              (not= ":" (subs text separator (+ separator 1))))
          nil
          (loop [offset Int (+ separator 1)
                 fields (Vec String) []]
            (cond
              (= offset (count text))
              (->NativeWireRecordV1
                (nativewirepartv1-value tag-part) fields)

              (> offset (count text)) nil

              :else
              (let [field (U NativeWirePartV1 Nil) (read-native-wire-part text offset)]
                (if (nil? field)
                  nil
                  (recur (nativewirepartv1-next-offset field)
                    (conj fields (nativewirepartv1-value field))))))))))))

(defn required-native-wire-record
  [text String
   tag String
   field-count Int] (U NativeWireRecordV1 Nil)
  (let [record (U NativeWireRecordV1 Nil) (parse-native-wire-record text)]
    (if (and (some? record)
          (= tag (nativewirerecordv1-tag record))
          (= field-count (count (nativewirerecordv1-fields record))))
      record nil)))

(defn native-wire-prefix-at?
  [text String
   offset Int
   prefix String] Bool
  (and (<= (+ offset (count prefix)) (count text))
    (= prefix (subs text offset (+ offset (count prefix))))))

;; read-string is used only for generated records and never with reader eval.
;; Reject every dispatch macro except generated record tags and printed IEEE
;; special values before the reader sees the cache payload.
(defn native-wire-edn-safe? [text String] Bool
  (let [units (Vec Any) (vec text)
        size Int (count units)]
    (loop [index Int 0
           in-string Bool false
           escaped Bool false]
      (if (>= index size)
        (and (not in-string) (not escaped))
        (let [character String (str (nth units index))]
          (cond
            in-string
            (cond
              escaped (recur (+ index 1) true false)
              (= character "\\") (recur (+ index 1) true true)
              (= character "\"") (recur (+ index 1) false false)
              :else (recur (+ index 1) true false))

            (= character "\"")
            (recur (+ index 1) true false)

            (= character "#")
            (cond
              (native-wire-prefix-at? text index "#native.core.")
              (recur (+ index 13) false false)

              (native-wire-prefix-at? text index "#native.stages.")
              (recur (+ index 15) false false)

              (native-wire-prefix-at? text index "##NaN")
              (recur (+ index 5) false false)

              (native-wire-prefix-at? text index "##Inf")
              (recur (+ index 5) false false)

              (native-wire-prefix-at? text index "##-Inf")
              (recur (+ index 6) false false)

              :else false)

            :else (recur (+ index 1) false false)))))))

;; Record construction and record reading can expose different persistent-map
;; iteration orders.  Normalize once through the non-evaluating reader so wire
;; bytes never depend on which route produced an otherwise equal record.
(defn native-wire-pr-str [value Any] String
  (pr-str
    (binding [*read-eval* false]
      (read-string (pr-str value)))))

(defn f64-atom-wire-key
  [function-id core/NativeId
   block-id core/NativeId
   result-id core/NativeId] String
  (canonical-record "f64-atom-key-v1"
    [(encode-id function-id) (encode-id block-id) (encode-id result-id)]))

(defn block-f64-atom-bit-rows
  [function-id core/NativeId
   block core/BasicBlock] (Vec String)
  (loop [position Int 0
         rows (Vec String) []]
    (if (>= position (count (core/basicblock-instructions block)))
      rows
      (let [instruction core/Instruction (nth (core/basicblock-instructions block) position)]
        (if (instance? native.core.AtomInstruction instruction)
          (let [atom core/NativeAtom (core/atominstruction-atom instruction)]
            (if (instance? native.core.F64Atom atom)
              (recur (+ position 1)
                (conj rows
                  (canonical-record "f64-atom-bits-v1"
                    [(f64-atom-wire-key function-id
                       (core/basicblock-id block)
                       (core/ssavaluev0-id
                         (core/atominstruction-result instruction)))
                     (encode-int
                       (Double/doubleToRawLongBits
                         (core/f64atom-value atom)))])))
              (recur (+ position 1) rows)))
          (recur (+ position 1) rows))))))

(defn function-f64-atom-bit-rows [function core/FunctionDef] (Vec String)
  (loop [position Int 0
         rows (Vec String) []]
    (if (>= position (count (core/functiondef-blocks function)))
      rows
      (recur (+ position 1)
        (vec (concat rows
          (block-f64-atom-bit-rows (core/functiondef-id function)
            (nth (core/functiondef-blocks function) position))))))))

(defn native-program-f64-atom-bit-rows [program core/NativeCoreProgram] (Vec String)
  (loop [position Int 0
         rows (Vec String) []]
    (if (>= position (count (core/nativecoreprogram-functions program)))
      rows
      (recur (+ position 1)
        (vec (concat rows
          (function-f64-atom-bit-rows
            (nth (core/nativecoreprogram-functions program) position))))))))

(defn encode-native-program-f64-atoms [program core/NativeCoreProgram] String
  (canonical-vector "native-program-f64-atoms-v1"
    (native-program-f64-atom-bit-rows program)))

(defn decode-f64-atom-bits-wire-v1 [encoding String] (U F64AtomBitsWireV1 Nil)
  (let [record (U NativeWireRecordV1 Nil) (required-native-wire-record encoding "f64-atom-bits-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (nativewirerecordv1-fields record)
            integer-record (U NativeWireRecordV1 Nil) (required-native-wire-record (nth fields 1) "int" 1)]
        (if (nil? integer-record)
          nil
          (let [value String (nth (nativewirerecordv1-fields integer-record) 0)
                bits (U Int Nil) (if (native-wire-signed-decimal? value)
                  (parse-long value) nil)]
            (if (nil? bits)
              nil
              (->F64AtomBitsWireV1 (nth fields 0) bits))))))))

(defn decode-native-program-f64-atoms [encoding String] (U (Map String Int) Nil)
  (let [record (U NativeWireRecordV1 Nil) (parse-native-wire-record encoding)]
    (if (or (nil? record)
          (not= "native-program-f64-atoms-v1"
            (nativewirerecordv1-tag record)))
      nil
      (loop [position Int 0
             fields (Vec String) (nativewirerecordv1-fields record)
             bits (Map String Int) {}]
        (if (>= position (count fields))
          bits
          (let [entry (U F64AtomBitsWireV1 Nil) (decode-f64-atom-bits-wire-v1 (nth fields position))]
            (if (or (nil? entry)
                  (contains? bits (f64atombitswirev1-key entry)))
              nil
              (recur (+ position 1) fields
                (assoc bits (f64atombitswirev1-key entry)
                  (f64atombitswirev1-bits entry))))))))))

(defn restore-instruction-f64-atom
  [function-id core/NativeId
   block-id core/NativeId
   bits (Map String Int)
   instruction core/Instruction] core/Instruction
  (if (instance? native.core.AtomInstruction instruction)
    (let [atom core/NativeAtom (core/atominstruction-atom instruction)]
      (if (instance? native.core.F64Atom atom)
        (let [key String (f64-atom-wire-key function-id block-id
                (core/ssavaluev0-id
                  (core/atominstruction-result instruction)))
              raw (U Int Nil) (get bits key nil)]
          (if (nil? raw)
            instruction
            (core/->AtomInstruction
              (core/atominstruction-result instruction)
              (core/->F64Atom (Double/longBitsToDouble raw)))))
        instruction))
    instruction))

(defn restore-block-f64-atoms
  [function-id core/NativeId
   bits (Map String Int)
   block core/BasicBlock] core/BasicBlock
  (with block
    [:instructions
     (mapv
       (fn [instruction core/Instruction] core/Instruction
         (restore-instruction-f64-atom function-id
           (core/basicblock-id block) bits instruction))
       (core/basicblock-instructions block))]))

(defn restore-function-f64-atoms
  [bits (Map String Int)
   function core/FunctionDef] core/FunctionDef
  (with function
    [:blocks
     (mapv
       (fn [block core/BasicBlock] core/BasicBlock
         (restore-block-f64-atoms (core/functiondef-id function) bits block))
       (core/functiondef-blocks function))]))

(defn restore-native-program-f64-atoms
  [bits (Map String Int)
   program core/NativeCoreProgram] core/NativeCoreProgram
  (with program
    [:functions
     (mapv
       (fn [function core/FunctionDef] core/FunctionDef
         (restore-function-f64-atoms bits function))
       (core/nativecoreprogram-functions program))]))

(defn encode-native-core-program-wire-v1 [program core/NativeCoreProgram] String
  (canonical-record "native-core-program-wire-v1"
    [(native-wire-pr-str program) (encode-native-program-f64-atoms program)]))

(defn decode-native-core-program-wire-v1*
  [encoding String
   canonical-check? Bool] (U core/NativeCoreProgram Nil)
  (let [record (U NativeWireRecordV1 Nil) (required-native-wire-record encoding "native-core-program-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (nativewirerecordv1-fields record)
            printed String (nth fields 0)
            bits (U (Map String Int) Nil) (decode-native-program-f64-atoms (nth fields 1))]
        (if (or (nil? bits) (not (native-wire-edn-safe? printed)))
          nil
          (let [decoded Any (binding [*read-eval* false] (read-string printed))]
            (if (instance? native.core.NativeCoreProgram decoded)
              (let [program core/NativeCoreProgram (restore-native-program-f64-atoms bits decoded)]
                (if (or (not canonical-check?)
                      (= encoding (encode-native-core-program-wire-v1 program)))
                  program nil))
              nil)))))))

(defn decode-native-core-program-wire-v1 [encoding String] (U core/NativeCoreProgram Nil)
  (decode-native-core-program-wire-v1* encoding true))

;; The canonicality re-encode is only sound to skip when the caller can name the
;; producer.  The one caller that can is an emission worker: its coordinator
;; encoded this wire from the in-memory program moments earlier, in the same
;; build, from the same compiler, into a private per-run directory that no cache
;; reads or writes.  Structural admission — record shape, arity, EDN safety and
;; `*read-eval*` false — still runs; only the whole-program re-encode is elided.
(defn decode-trusted-native-core-program-wire-v1 [encoding String] (U core/NativeCoreProgram Nil)
  (decode-native-core-program-wire-v1* encoding false))

(defn encode-frozen-native-stage-wire-v1 [frozen FrozenNativeStageV0] String
  (let [program core/NativeCoreProgram (nativestagev0-program (frozennativestagev0-stage frozen))]
    (canonical-record "frozen-native-stage-wire-v1"
      [(native-wire-pr-str frozen) (encode-native-program-f64-atoms program)])))

(defn restore-frozen-native-stage-f64-atoms
  [bits (Map String Int)
   frozen FrozenNativeStageV0] FrozenNativeStageV0
  (let [stage NativeStageV0 (frozennativestagev0-stage frozen)
        program core/NativeCoreProgram (restore-native-program-f64-atoms bits (nativestagev0-program stage))]
    (with frozen [:stage (with stage [:program program])])))

(defn decode-frozen-native-stage-wire-v1*
  [encoding String
   canonical-check? Bool] (U FrozenNativeStageV0 Nil)
  (let [record (U NativeWireRecordV1 Nil) (required-native-wire-record encoding "frozen-native-stage-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (nativewirerecordv1-fields record)
            printed String (nth fields 0)
            bits (U (Map String Int) Nil) (decode-native-program-f64-atoms (nth fields 1))]
        (if (or (nil? bits) (not (native-wire-edn-safe? printed)))
          nil
          (let [decoded Any (binding [*read-eval* false] (read-string printed))]
            (if (instance? native.stages.FrozenNativeStageV0 decoded)
              (let [frozen FrozenNativeStageV0 (restore-frozen-native-stage-f64-atoms bits decoded)
                    stage NativeStageV0 (frozennativestagev0-stage frozen)
                    legacy-encoding String (encode-native-stage stage)]
                (if (and
                      (= legacy-encoding
                        (frozennativestagev0-encoding frozen))
                      (= (content-digest legacy-encoding)
                        (frozennativestagev0-digest frozen))
                      (or (not canonical-check?)
                        (= encoding (encode-frozen-native-stage-wire-v1 frozen))))
                  frozen nil))
              nil)))))))

(defn decode-frozen-native-stage-wire-v1 [encoding String] (U FrozenNativeStageV0 Nil)
  (decode-frozen-native-stage-wire-v1* encoding true))

(defn decode-attested-frozen-native-stage-wire-v1 [encoding String] (U FrozenNativeStageV0 Nil)
  (decode-frozen-native-stage-wire-v1* encoding false))
