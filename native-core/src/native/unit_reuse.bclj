      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/UnionVariantLayoutV0) []]
        (if (>= position (count fields))
          values
          (let [value (U core/UnionVariantLayoutV0 Nil) (decode-union-variant-layout-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-layout-shape-wire-v1 [encoding String] (U core/LayoutShapeV0 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            tag String (wirerecordv1-tag record)]
        (cond
          (and (= tag "scalar-layout-shape-wire-v1") (= 1 (count fields)))
          (let [representation (U core/ScalarReprV0 Nil) (decode-scalar-representation-wire-v1 (nth fields 0))]
            (if (some? representation)
              (core/->ScalarShapeV0 representation) nil))

          (and (= tag "union-layout-shape-wire-v1") (= 3 (count fields)))
          (let [tag-type (U core/NativeId Nil) (decode-wire-id (nth fields 0))
                tag-offset (U Int Nil) (decode-wire-int (nth fields 1))
                variants (U (Vec core/UnionVariantLayoutV0) Nil) (decode-union-variant-layouts-wire-v1 (nth fields 2))]
            (if (and (some? tag-type) (some? tag-offset)
                  (some? variants) (>= tag-offset 0))
              (core/->UnionShapeV0 tag-type tag-offset variants) nil))

          :else nil)))))

(defn decode-layout-def-wire-v1 [encoding String] (U core/LayoutDef Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "layout-def-wire-v1" 5)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            type-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
            size (U Int Nil) (decode-wire-int (nth fields 2))
            alignment (U Int Nil) (decode-wire-int (nth fields 3))
            shape (U core/LayoutShapeV0 Nil) (decode-layout-shape-wire-v1 (nth fields 4))]
        (if (and (some? identity) (some? type-id) (some? size)
              (some? alignment) (some? shape) (>= size 0) (> alignment 0))
          (core/->LayoutDef identity type-id size alignment shape) nil)))))

(defn decode-layout-defs-wire-v1 [encoding String] (U (Vec core/LayoutDef) Nil)
  (let [record (U WireRecordV1 Nil) (canonical-set-wire-record encoding "native-unit-layouts-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/LayoutDef) []]
        (if (>= position (count fields))
          values
          (let [value (U core/LayoutDef Nil) (decode-layout-def-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-ownership-wire-v1 [encoding String] (U core/OwnershipRuleV0 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (or (nil? record) (not= 1 (count (wirerecordv1-fields record))))
      nil
      (let [token (U Bool Nil) (decode-wire-bool (nth (wirerecordv1-fields record) 0))]
        (if (nil? token)
          nil
          (cond
            (= "borrowed-ownership-wire-v1" (wirerecordv1-tag record))
            (core/->BorrowedV0 token)
            (= "owned-ownership-wire-v1" (wirerecordv1-tag record))
            (core/->OwnedV0 token)
            :else nil))))))

(defn decode-abi-value-wire-v1 [encoding String] (U core/AbiValueV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "abi-value-wire-v1" 4)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            name (U String Nil) (decode-wire-string (nth fields 0))
            type-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
            ownership (U core/OwnershipRuleV0 Nil) (decode-ownership-wire-v1 (nth fields 2))
            lifetime (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 3))]
        (if (and (some? name) (some? type-id) (some? ownership)
              (some? lifetime))
          (core/->AbiValueV0 name type-id ownership
            (optional-wire-id-value lifetime))
          nil)))))

(defn decode-abi-values-wire-v1 [encoding String] (U (Vec core/AbiValueV0) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "abi-parameters-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/AbiValueV0) []]
        (if (>= position (count fields))
          values
          (let [value (U core/AbiValueV0 Nil) (decode-abi-value-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-optional-abi-value-wire-v1 [encoding String] (U (Vec core/AbiValueV0) Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (cond
      (nil? record) nil
      (and (= "none" (wirerecordv1-tag record))
        (= 0 (count (wirerecordv1-fields record)))) []
      (and (= "some" (wirerecordv1-tag record))
        (= 1 (count (wirerecordv1-fields record))))
      (let [value (U core/AbiValueV0 Nil) (decode-abi-value-wire-v1 (nth (wirerecordv1-fields record) 0))]
        (if (nil? value) nil [value]))
      :else nil)))

(defn optional-abi-value [decoded (Vec core/AbiValueV0)] (U core/AbiValueV0 Nil)
  (if (= 0 (count decoded)) nil (nth decoded 0)))

(defn decode-abi-direction-wire-v1 [encoding String] (U core/AbiDirectionV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "abi-export-wire-v1" 1)]
    (if (nil? record)
      nil
      (let [token (U Bool Nil) (decode-wire-bool (nth (wirerecordv1-fields record) 0))]
        (if (some? token) (core/->AbiExportV0 token) nil)))))

(defn decode-abi-convention-wire-v1 [encoding String] (U core/AbiConventionV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "restricted-c-abi-wire-v1" 1)]
    (if (nil? record)
      nil
      (let [token (U Bool Nil) (decode-wire-bool (nth (wirerecordv1-fields record) 0))]
        (if (some? token) (core/->RestrictedCAbiV0 token) nil)))))

(defn decode-abi-wire-v1 [encoding String] (U core/AbiDeclV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "abi-declaration-wire-v1" 12)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            function-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
            symbol (U String Nil) (decode-wire-string (nth fields 2))
            direction (U core/AbiDirectionV0 Nil) (decode-abi-direction-wire-v1 (nth fields 3))
            convention (U core/AbiConventionV0 Nil) (decode-abi-convention-wire-v1 (nth fields 4))
            parameters (U (Vec core/AbiValueV0) Nil) (decode-abi-values-wire-v1 (nth fields 5))
            result (U (Vec core/AbiValueV0) Nil) (decode-optional-abi-value-wire-v1 (nth fields 6))
            failure-type (U core/NativeId Nil) (decode-wire-id (nth fields 7))
            effects (U (Vec core/NativeId) Nil) (decode-wire-id-vector (nth fields 8) "abi-effects-wire-v1")
            capabilities (U (Vec core/NativeId) Nil) (decode-wire-id-vector (nth fields 9) "abi-capabilities-wire-v1")
            version (U String Nil) (decode-wire-string (nth fields 10))
            layout-digest (U String Nil) (decode-wire-string (nth fields 11))]
        (if (and (some? identity) (some? function-id) (some? symbol)
              (some? direction) (some? convention) (some? parameters)
              (some? result) (some? failure-type) (some? effects)
              (some? capabilities) (some? version) (some? layout-digest)
              (stages/sha256-digest? layout-digest))
          (core/->AbiDeclV0 identity function-id symbol direction convention
            parameters (optional-abi-value result) failure-type effects
            capabilities version layout-digest)
          nil)))))

(defn decode-abis-wire-v1 [encoding String] (U (Vec core/AbiDeclV0) Nil)
  (let [record (U WireRecordV1 Nil) (canonical-set-wire-record encoding "native-unit-abis-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/AbiDeclV0) []]
        (if (>= position (count fields))
          values
          (let [value (U core/AbiDeclV0 Nil) (decode-abi-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-native-function-wire-v1 [encoding String] (U core/FunctionDef Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "native-function-wire-v1" 9)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            name (U String Nil) (decode-wire-string (nth fields 1))
            parameters (U (Vec core/Parameter) Nil) (decode-parameters-wire-v1 (nth fields 2))
            blocks (U (Vec core/BasicBlock) Nil) (decode-blocks-wire-v1 (nth fields 3))
            entry-block (U core/NativeId Nil) (decode-wire-id (nth fields 4))
            return-type (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 5))
            effects (U (Vec core/NativeId) Nil) (decode-wire-id-vector
              (nth fields 6) "native-function-effects-wire-v1")
            regions (U (Vec core/NativeId) Nil) (decode-wire-id-vector
              (nth fields 7) "native-function-regions-wire-v1")
            capabilities (U (Vec core/NativeId) Nil) (decode-wire-id-vector
              (nth fields 8) "native-function-capabilities-wire-v1")]
        (if (and (some? identity) (some? name) (some? parameters)
              (some? blocks) (some? entry-block) (some? return-type)
              (some? effects) (some? regions) (some? capabilities))
          (core/->FunctionDef identity name parameters blocks entry-block
            (optional-wire-id-value return-type) effects regions capabilities)
          nil)))))

(defn decode-empty-regions-wire-v1 [encoding String] Bool
  (let [record (U WireRecordV1 Nil) (canonical-set-wire-record encoding "native-unit-regions-wire-v1")]
    (and (some? record) (= 0 (count (wirerecordv1-fields record))))))

(defn encode-typed-unit-wire-v1
  [unit-id core/NativeId
   function lower/TypedFunctionV0
   types (Vec core/TypeDef)
   effects (Vec core/EffectDef)
   capabilities (Vec core/CapabilityDef)] String
  (stages/canonical-record "typed-unit-wire-v1"
    [(stages/encode-id unit-id)
     (encode-typed-function-wire-v1 function)
     (stages/canonical-set "typed-unit-types-wire-v1"
       (mapv encode-type-def-wire-v1 types))
     (stages/canonical-set "typed-unit-effects-wire-v1"
       (mapv encode-effect-wire-v1 effects))
     (stages/canonical-set "typed-unit-capabilities-wire-v1"
       (mapv encode-capability capabilities))]))

(defn insert-type-by-wire
  [item core/TypeDef
   sorted (Vec core/TypeDef)] (Vec core/TypeDef)
  (loop [position Int 0
         inserted Bool false
         result (Vec core/TypeDef) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current core/TypeDef (nth sorted position)]
        (if (and (not inserted)
              (< (compare (encode-type-def-wire-v1 item)
                   (encode-type-def-wire-v1 current)) 0))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn types-by-wire [values (Vec core/TypeDef)] (Vec core/TypeDef)
  (loop [position Int 0
         result (Vec core/TypeDef) []]
    (if (>= position (count values)) result
      (recur (+ position 1)
        (insert-type-by-wire (nth values position) result)))))

(defn insert-effect-by-wire
  [item core/EffectDef
   sorted (Vec core/EffectDef)] (Vec core/EffectDef)
  (loop [position Int 0
         inserted Bool false
         result (Vec core/EffectDef) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current core/EffectDef (nth sorted position)]
        (if (and (not inserted)
              (< (compare (encode-effect-wire-v1 item)
                   (encode-effect-wire-v1 current)) 0))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn effects-by-wire [values (Vec core/EffectDef)] (Vec core/EffectDef)
  (loop [position Int 0
         result (Vec core/EffectDef) []]
    (if (>= position (count values)) result
      (recur (+ position 1)
        (insert-effect-by-wire (nth values position) result)))))

(defn make-typed-unit
  [unit-id core/NativeId
   function lower/TypedFunctionV0
   types (Vec core/TypeDef)
   effects (Vec core/EffectDef)
   capabilities (Vec core/CapabilityDef)] TypedUnitV0
  (let [ordered-types (Vec core/TypeDef) (types-by-wire types)
        ordered-effects (Vec core/EffectDef) (effects-by-wire effects)
        encoding String (encode-typed-unit-wire-v1 unit-id function ordered-types
          ordered-effects capabilities)]
    (->TypedUnitV0 unit-id function ordered-types ordered-effects capabilities encoding
      (stages/content-digest encoding))))

(defn encode-native-unit-wire-v1
  [unit-id core/NativeId
   function core/FunctionDef
   layouts (Vec core/LayoutDef)
   abis (Vec core/AbiDeclV0)
   regions (Vec core/RegionDef)] String
  (stages/canonical-record "native-unit-wire-v1"
    [(stages/encode-id unit-id)
     (encode-native-function-wire-v1 function)
     (stages/canonical-set "native-unit-layouts-wire-v1"
       (mapv encode-layout-def-wire-v1 layouts))
     (stages/canonical-set "native-unit-abis-wire-v1"
       (mapv encode-abi-wire-v1 abis))
     (stages/canonical-set "native-unit-regions-wire-v1"
       (mapv (fn [region core/RegionDef] String
               (stages/encode-region region))
         regions))]))

(defn insert-layout-by-wire
  [item core/LayoutDef
   sorted (Vec core/LayoutDef)] (Vec core/LayoutDef)
  (loop [position Int 0
         inserted Bool false
         result (Vec core/LayoutDef) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current core/LayoutDef (nth sorted position)]
        (if (and (not inserted)
              (< (compare (encode-layout-def-wire-v1 item)
                   (encode-layout-def-wire-v1 current)) 0))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn layouts-by-wire [values (Vec core/LayoutDef)] (Vec core/LayoutDef)
  (loop [position Int 0
         result (Vec core/LayoutDef) []]
    (if (>= position (count values)) result
      (recur (+ position 1)
        (insert-layout-by-wire (nth values position) result)))))

(defn insert-abi-by-wire
  [item core/AbiDeclV0
   sorted (Vec core/AbiDeclV0)] (Vec core/AbiDeclV0)
  (loop [position Int 0
         inserted Bool false
         result (Vec core/AbiDeclV0) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current core/AbiDeclV0 (nth sorted position)]
        (if (and (not inserted)
              (< (compare (encode-abi-wire-v1 item)
                   (encode-abi-wire-v1 current)) 0))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn abis-by-wire [values (Vec core/AbiDeclV0)] (Vec core/AbiDeclV0)
  (loop [position Int 0
         result (Vec core/AbiDeclV0) []]
    (if (>= position (count values)) result
      (recur (+ position 1)
        (insert-abi-by-wire (nth values position) result)))))

(defn make-native-unit
  [unit-id core/NativeId
   function core/FunctionDef
   layouts (Vec core/LayoutDef)
   abis (Vec core/AbiDeclV0)
   regions (Vec core/RegionDef)] NativeUnitV0
  (let [ordered-layouts (Vec core/LayoutDef) (layouts-by-wire layouts)
        ordered-abis (Vec core/AbiDeclV0) (abis-by-wire abis)
        encoding String (encode-native-unit-wire-v1 unit-id function ordered-layouts
          ordered-abis regions)]
    (->NativeUnitV0 unit-id function ordered-layouts ordered-abis regions encoding
      (stages/content-digest encoding))))

(defn dependency-context-digest
  [unit stages/SourceUnitV0
   contracts (Vec UnitContractV0)] String
  (let [rows (Vec String) (mapv
          (fn [read-id core/NativeId] String
            (let [contract (U UnitContractV0 Nil) (some
                    (fn [candidate UnitContractV0] (U UnitContractV0 Nil)
                      (if (core/native-id= read-id
                            (unitcontractv0-unit-id candidate))
                        candidate nil))
                    contracts)]
              (if (nil? contract)
                (stages/canonical-record "missing-unit-contract-v0"
                  [(id-value read-id)])
                (stages/canonical-record "dependency-contract-v0"
                  [(id-value read-id) (unitcontractv0-digest contract)]))))
          (stages/sourceunitv0-read-set unit))]
    (stages/content-digest
      (stages/canonical-set "dependency-context-v0" rows))))

(defn canonical-contract-hashes [contracts (Vec SemanticFormContractV1)] (Vec String)
  (vec
    (sort
      (distinct
        (mapv
          (fn [contract SemanticFormContractV1] String
            (semanticformcontractv1-contract-id contract))
          contracts)))))

(defn form-contract-set-digest [hashes (Vec String)] String
  (stages/content-digest
    (stages/canonical-set "semantic-form-contract-set-v1" hashes)))

(defn encode-unit-derivation-receipt
  [profile-identity ProfileIdentityV1
   unit-id core/NativeId
   unit-semantic-digest String
   dependency-digest String
   typing-environment-hash String
   form-contract-hashes (Vec String)
   form-contract-set-digest-value String
   compiler-rule-epoch String
   materialization-receipt-id String
   result-fact-hashes (Vec String)] String
  (stages/canonical-record "unit-derivation-receipt-v1"
    [(profileidentityv1-encoding profile-identity)
     (stages/encode-id unit-id)
     unit-semantic-digest
     dependency-digest
     typing-environment-hash
     (stages/canonical-set "form-contract-hashes" form-contract-hashes)
     form-contract-set-digest-value
     compiler-rule-epoch
     materialization-receipt-id
     (stages/canonical-set "result-fact-hashes" result-fact-hashes)]))

(defn make-unit-derivation-receipt
  [profile-identity ProfileIdentityV1
   unit stages/SourceUnitV0
   unit-contracts (Vec UnitContractV0)
   form-contracts (Vec SemanticFormContractV1)
   typing-environment-hash String
   compiler-rule-epoch String
   materialization-receipt-id String
   result-fact-hashes (Vec String)] UnitDerivationReceiptV1
  (let [contract-hashes (Vec String) (canonical-contract-hashes form-contracts)
        contract-set-digest String (form-contract-set-digest contract-hashes)
        dependency-digest String (dependency-context-digest unit unit-contracts)
        encoding String (encode-unit-derivation-receipt
          profile-identity
          (stages/sourceunitv0-id unit)
          (stages/sourceunitv0-semantic-digest unit)
          dependency-digest
          typing-environment-hash
          contract-hashes
          contract-set-digest
          compiler-rule-epoch
          materialization-receipt-id
          result-fact-hashes)]
    (->UnitDerivationReceiptV1
      (stages/content-digest encoding)
      profile-identity
      (stages/sourceunitv0-id unit)
      (stages/sourceunitv0-semantic-digest unit)
      dependency-digest
      typing-environment-hash
      contract-hashes
      contract-set-digest
      compiler-rule-epoch
      materialization-receipt-id
      (vec (sort result-fact-hashes))
      encoding)))

(defn semantic-contract-for-hash
  [contracts (Vec SemanticFormContractV1)
   contract-hash String] (U SemanticFormContractV1 Nil)
  (some
    (fn [contract SemanticFormContractV1] (U SemanticFormContractV1 Nil)
      (if (= contract-hash (semanticformcontractv1-contract-id contract))
        contract nil))
    contracts))

(defn receipt-contract-hashes-valid?
  [profile-identity ProfileIdentityV1
   contract-hashes (Vec String)
   contracts (Vec SemanticFormContractV1)] Bool
  (every?
    (fn [contract-hash String] Bool
      (let [contract (U SemanticFormContractV1 Nil) (semantic-contract-for-hash contracts contract-hash)]
        (and (some? contract)
          (= (profileidentityv1-digest profile-identity)
            (profileidentityv1-digest
              (semanticformcontractv1-profile-identity contract)))
          (= contract-hash
            (stages/content-digest
              (semanticformcontractv1-encoding contract))))))
    contract-hashes))

(defn unit-derivation-receipt-valid-for?
  [receipt UnitDerivationReceiptV1
   unit stages/SourceUnitV0
   unit-contracts (Vec UnitContractV0)
   form-contracts (Vec SemanticFormContractV1)] Bool
  (let [contract-hashes (Vec String) (unitderivationreceiptv1-form-contract-hashes receipt)]
    (and
      (= (unitderivationreceiptv1-receipt-id receipt)
        (stages/content-digest
          (unitderivationreceiptv1-encoding receipt)))
      (= (profileidentityv1-digest
           (unitderivationreceiptv1-profile-identity receipt))
        (stages/content-digest
          (profileidentityv1-encoding
            (unitderivationreceiptv1-profile-identity receipt))))
      (core/native-id= (unitderivationreceiptv1-unit-id receipt)
        (stages/sourceunitv0-id unit))
      (= (unitderivationreceiptv1-unit-semantic-digest receipt)
        (stages/sourceunitv0-semantic-digest unit))
      (= (unitderivationreceiptv1-dependency-context-digest receipt)
        (dependency-context-digest unit unit-contracts))
      (= contract-hashes (vec (sort (distinct contract-hashes))))
      (= (unitderivationreceiptv1-form-contract-set-digest receipt)
        (form-contract-set-digest contract-hashes))
      (receipt-contract-hashes-valid?
        (unitderivationreceiptv1-profile-identity receipt)
        contract-hashes form-contracts))))

(defn unit-result-key [receipt UnitDerivationReceiptV1] String
  (stages/content-digest
    (stages/canonical-record "beagle-unit-result-v1"
      [(profileidentityv1-digest
         (unitderivationreceiptv1-profile-identity receipt))
       (id-value (unitderivationreceiptv1-unit-id receipt))
       (unitderivationreceiptv1-unit-semantic-digest receipt)
       (unitderivationreceiptv1-dependency-context-digest receipt)
       (unitderivationreceiptv1-typing-environment-hash receipt)
       (unitderivationreceiptv1-form-contract-set-digest receipt)
       (unitderivationreceiptv1-compiler-rule-epoch receipt)])))

(defn conj-id
  [identities (Vec core/NativeId)
   candidate core/NativeId] (Vec core/NativeId)
  (if (core/id-in? identities candidate) identities (conj identities candidate)))

(defn type-references [definition core/TypeDef] (Vec core/NativeId)
  (let [shape core/TypeShape (core/typedef-shape definition)]
    (cond
      (instance? native.core.RecordType shape)
      (mapv (fn [field core/TypeField] core/NativeId
              (core/typefield-type-id field))
        (core/recordtype-fields shape))

      (instance? native.core.UnionType shape)
      (loop [position Int 0
             variants (Vec core/TypeVariant) (core/uniontype-variants shape)
             collected (Vec core/NativeId) [(lower/type-id "UnionTag")]]
        (if (>= position (count variants))
          collected
          (let [payload (U core/NativeId Nil) (core/typevariant-payload-type (nth variants position))]
            (recur (+ position 1) variants
              (if (nil? payload) collected (conj-id collected payload))))))

      (instance? native.core.VectorType shape)
      [(core/vectortype-element-type shape)]

      (instance? native.core.BufferTypeV0 shape)
      [(core/buffertypev0-element-type shape)]

      (instance? native.core.MapTypeV0 shape)
      [(core/maptypev0-key-type shape) (core/maptypev0-value-type shape)]

      (instance? native.core.SetTypeV0 shape)
      [(core/settypev0-element-type shape)]

      (instance? native.core.ReferenceType shape)
      [(core/referencetype-target-type shape)]

      (instance? native.core.AtomCellTypeV0 shape)
      [(core/atomcelltypev0-content-type shape)]

      (instance? native.core.FunctionType shape)
      (let [rest-type (U core/NativeId Nil) (core/functiontype-rest-type shape)]
        (vec (concat
               (core/functiontype-parameter-types shape)
               (if (nil? rest-type) [] [rest-type])
               [(core/functiontype-return-type shape)])))

      (instance? native.core.OutcomeType shape)
      [(core/outcometype-value-type shape)
       (core/outcometype-failure-type shape)
       (lower/type-id "UnionTag")]

      :else [])))

(defn instruction-type [instruction core/Instruction] core/NativeId
  (core/ssavaluev0-type-id (get instruction :result)))

(defn typed-function-type-seeds [function lower/TypedFunctionV0] (Vec core/NativeId)
  (let [with-parameters (Vec core/NativeId) (mapv (fn [parameter core/Parameter] core/NativeId
                (core/parameter-type-id parameter))
          (lower/typedfunctionv0-parameters function))
        initial (Vec core/NativeId) (conj-id
          (conj-id with-parameters (lower/typedfunctionv0-return-type function))
          (lower/typedfunctionv0-failure-type function))
        blocks (Vec core/BasicBlock) (lower/readiness-blocks (lower/typedfunctionv0-readiness function))]
    (loop [position Int 0
           collected (Vec core/NativeId) initial]
      (if (>= position (count blocks))
        collected
        (let [block core/BasicBlock (nth blocks position)
              with-block-parameters (Vec core/NativeId) (loop [inner Int 0
                                                               current (Vec core/NativeId) collected]
                                                          (if (>= inner (count (core/basicblock-parameters block)))
                  current
                  (recur (+ inner 1)
                    (conj-id current
                      (core/parameter-type-id
                        (nth (core/basicblock-parameters block) inner))))))]
          (recur (+ position 1)
            (loop [inner Int 0
                   current (Vec core/NativeId) with-block-parameters]
              (if (>= inner (count (core/basicblock-instructions block)))
                current
                (recur (+ inner 1)
                  (conj-id current
                    (instruction-type
                      (nth (core/basicblock-instructions block) inner))))))))))))

(defn find-type
  [types (Vec core/TypeDef)
   target core/NativeId] (U core/TypeDef Nil)
  (some
    (fn [definition core/TypeDef] (U core/TypeDef Nil)
      (if (core/native-id= target (core/typedef-id definition))
        definition nil))
    types))

(defn reachable-type-ids
  [types (Vec core/TypeDef)
   seeds (Vec core/NativeId)] (Vec core/NativeId)
  (loop [round Int 0
         current (Vec core/NativeId) seeds]
    (let [grown (Vec core/NativeId) (loop [position Int 0
                                           collected (Vec core/NativeId) current]
                                      (if (>= position (count current))
              collected
              (let [definition (U core/TypeDef Nil) (find-type types (nth current position))
                    references (Vec core/NativeId) (if (nil? definition) [] (type-references definition))]
                (recur (+ position 1)
                  (loop [inner Int 0
                         next (Vec core/NativeId) collected]
                    (if (>= inner (count references))
                      next
                      (recur (+ inner 1)
                        (conj-id next (nth references inner)))))))))]
      (if (or (= (count grown) (count current)) (> round (count types)))
        grown
        (recur (+ round 1) grown)))))

;; The ordinary body pass publishes the checked arithmetic family as
;; one generated support root whenever any checked operation appears.
;; Keep that compiler-owned family with the unit that requested it so
;; dense assembly reproduces the authoritative typed stage exactly.
(defn selected-types
  [types (Vec core/TypeDef)
   function lower/TypedFunctionV0] (Vec core/TypeDef)
  (let [function-seeds (Vec core/NativeId) (typed-function-type-seeds function)
        seeds (Vec core/NativeId) (if (lower/readiness-uses-checked?
              (lower/typedfunctionv0-readiness function))
          (vec (concat function-seeds
                 (mapv (fn [definition core/TypeDef] core/NativeId
                         (core/typedef-id definition))
                   (lower/checked-arithmetic-types))))
          function-seeds)
        reachable (Vec core/NativeId) (reachable-type-ids types seeds)]
    (filterv (fn [definition core/TypeDef] Bool
               (core/id-in? reachable (core/typedef-id definition)))
      types)))

(defn selected-effects
  [effects (Vec core/EffectDef)
   function lower/TypedFunctionV0] (Vec core/EffectDef)
  (filterv (fn [effect core/EffectDef] Bool
             (core/id-in? (lower/typedfunctionv0-effects function)
               (core/effectdef-id effect)))
    effects))

(defn selected-capabilities
  [capabilities (Vec core/CapabilityDef)
   function lower/TypedFunctionV0] (Vec core/CapabilityDef)
  (let [required (Vec core/NativeId) (lower/function-capabilities function)]
    (filterv (fn [capability core/CapabilityDef] Bool
               (core/id-in? required (core/capabilitydef-id capability)))
      capabilities)))

(defn source-module-for
  [modules (Vec stages/SourceModuleV1)
   target core/NativeId] (U stages/SourceModuleV1 Nil)
  (some
    (fn [module stages/SourceModuleV1] (U stages/SourceModuleV1 Nil)
      (if (core/native-id= target (stages/sourcemodulev1-id module))
        module nil))
    modules))

(defn typed-function-for
  [functions (Vec lower/TypedFunctionV0)
   target core/NativeId] (U lower/TypedFunctionV0 Nil)
  (some
    (fn [function lower/TypedFunctionV0] (U lower/TypedFunctionV0 Nil)
      (if (core/native-id= target (lower/typedfunctionv0-id function))
        function nil))
    functions))

(defn native-function-for
  [functions (Vec core/FunctionDef)
   target core/NativeId] (U core/FunctionDef Nil)
  (some
    (fn [function core/FunctionDef] (U core/FunctionDef Nil)
      (if (core/native-id= target (core/functiondef-id function))
        function nil))
    functions))

(defn selected-layouts
  [layouts (Vec core/LayoutDef)
   types (Vec core/TypeDef)] (Vec core/LayoutDef)
  (let [type-ids (Vec core/NativeId) (mapv (fn [definition core/TypeDef] core/NativeId
                (core/typedef-id definition))
          types)]
    (filterv (fn [layout core/LayoutDef] Bool
               (core/id-in? type-ids (core/layoutdef-type-id layout)))
      layouts)))

(defn selected-abis
  [abis (Vec core/AbiDeclV0)
   typed-function lower/TypedFunctionV0
   native-function core/FunctionDef] (Vec core/AbiDeclV0)
  (filterv
    (fn [abi core/AbiDeclV0] Bool
      (or (core/native-id= (core/functiondef-id native-function)
            (core/abideclv0-function-id abi))
          (lower/function-calls-abi? typed-function
            (core/abideclv0-id abi))))
    abis))

(defn selected-regions
  [regions (Vec core/RegionDef)
   function core/FunctionDef] (Vec core/RegionDef)
  (filterv (fn [region core/RegionDef] Bool
             (core/id-in? (core/functiondef-regions function)
               (core/regiondef-id region)))
    regions))

(declare source-units-supported? typed-unit-record-valid? native-unit-record-valid?)

(defn extract-unit-payloads
  [source stages/SourceStageV1
   typed-slice lower/TypedSliceV0
   native-frozen stages/FrozenNativeStageV0] UnitExtractionResultV0
  (let [units (Vec stages/SourceUnitV0) (stages/sourcestagev1-units source)
        modules (Vec stages/SourceModuleV1) (stages/sourcestagev1-modules source)
        index lower/SourceIndexV0 (lower/build-source-index (stages/sourcestagev1-terms source) modules)
        typed-functions (Vec lower/TypedFunctionV0) (lower/typedslicev0-functions typed-slice)
        native-program core/NativeCoreProgram (stages/nativestagev0-program
          (stages/frozennativestagev0-stage native-frozen))]
    (if (not (source-units-supported? units))
      (->UnitExtractionRejectedV0 "UNIT-CORPUS-UNSUPPORTED"
        "unit extraction requires a nonempty closure of unique defn units")
      (loop [position Int 0
             contracts (Vec UnitContractV0) []
             typed-units (Vec TypedUnitV0) []
             native-units (Vec NativeUnitV0) []]
        (if (>= position (count units))
          (->UnitExtractionAcceptedV0 contracts typed-units native-units)
          (let [unit stages/SourceUnitV0 (nth units position)
                unit-id core/NativeId (stages/sourceunitv0-id unit)
                function-id core/NativeId (lower/function-id unit-id (stages/sourceunitv0-name unit))
                module (U stages/SourceModuleV1 Nil) (source-module-for modules (stages/sourceunitv0-module-id unit))
                typed-function (U lower/TypedFunctionV0 Nil) (typed-function-for typed-functions function-id)
                native-function (U core/FunctionDef Nil) (native-function-for
                  (core/nativecoreprogram-functions native-program) function-id)
                private-text String (lower/fact-text index unit-id "private")]
            (cond
              (not= "defn" (stages/sourceunitv0-kind unit))
              (->UnitExtractionRejectedV0 "UNIT-CORPUS-KIND"
                (str "unsupported source unit kind "
                  (stages/sourceunitv0-kind unit) " for "
                  (stages/sourceunitv0-name unit)))

              (nil? module)
              (->UnitExtractionRejectedV0 "UNIT-MODULE-MISSING"
                (id-value (stages/sourceunitv0-module-id unit)))

              (nil? typed-function)
              (->UnitExtractionRejectedV0 "UNIT-TYPED-FUNCTION-MISSING"
                (id-value function-id))

              (nil? native-function)
              (->UnitExtractionRejectedV0 "UNIT-NATIVE-FUNCTION-MISSING"
                (id-value function-id))

              (not (or (= "true" private-text) (= "false" private-text)))
              (->UnitExtractionRejectedV0 "UNIT-VISIBILITY-MISSING"
                (id-value unit-id))

              :else
              (let [qualified-name String (str (stages/sourcemodulev1-name module) "/"
                      (stages/sourceunitv0-name unit))
                    visibility String (if (= "true" private-text) "private" "public")
                    types (Vec core/TypeDef) (selected-types (lower/typedslicev0-types typed-slice)
                      typed-function)
                    contract UnitContractV0 (make-unit-contract unit-id qualified-name visibility
                      typed-function)
                    typed-unit TypedUnitV0 (make-typed-unit unit-id typed-function types
                      (selected-effects (lower/typedslicev0-effects typed-slice)
                        typed-function)
                      (selected-capabilities
                        (lower/typedslicev0-capabilities typed-slice)
                        typed-function))
                    native-unit NativeUnitV0 (make-native-unit unit-id native-function
                      (selected-layouts
                        (core/nativecoreprogram-layouts native-program) types)
                      (selected-abis (core/nativecoreprogram-abis native-program)
                        typed-function native-function)
                      (selected-regions
                        (core/nativecoreprogram-regions native-program)
                        native-function))]
                (cond
                  (not (typed-unit-record-valid? typed-unit))
                  (->UnitExtractionRejectedV0 "UNIT-WIRE-CORPUS-UNSUPPORTED"
                    (str qualified-name
                      " has a typed record outside unit wire v1"))

                  (not (native-unit-record-valid? native-unit))
                  (->UnitExtractionRejectedV0 "UNIT-WIRE-CORPUS-UNSUPPORTED"
                    (str qualified-name
                      " has a native record outside unit wire v1"))

                  :else
                  (recur (+ position 1)
                    (conj contracts contract)
                    (conj typed-units typed-unit)
                    (conj native-units native-unit)))))))))))

(defn claim-key [claim PayloadClaimV0] String
  (stages/canonical-record "unit-payload-claim-v0"
    [(payloadclaimv0-category claim)
     (id-value (payloadclaimv0-identity claim))]))

(defn check-payload-claims [claims (Vec PayloadClaimV0)] ClaimCheckV0
  (loop [position Int 0
         encodings (Map String String) {}
         valid Bool true
         detail String ""]
    (if (or (>= position (count claims)) (not valid))
      (->ClaimCheckV0 encodings valid detail)
      (let [claim PayloadClaimV0 (nth claims position)
            key String (claim-key claim)
            prior (U String Nil) (get encodings key)
            encoding String (payloadclaimv0-encoding claim)]
        (if (or (nil? prior) (= prior encoding))
          (recur (+ position 1) (assoc encodings key encoding) true "")
          (recur (+ position 1) encodings false
            (str (payloadclaimv0-category claim) " "
              (id-value (payloadclaimv0-identity claim))
              " has unequal canonical payloads")))))))

(defn contract-claims [contracts (Vec UnitContractV0)] (Vec PayloadClaimV0)
  (mapv (fn [contract UnitContractV0] PayloadClaimV0
          (->PayloadClaimV0 "unit-contract"
            (unitcontractv0-unit-id contract)
            (unitcontractv0-encoding contract)))
    contracts))

(defn typed-unit-claims [units (Vec TypedUnitV0)] (Vec PayloadClaimV0)
  (loop [position Int 0
         claims (Vec PayloadClaimV0) []]
    (if (>= position (count units))
      claims
      (let [unit TypedUnitV0 (nth units position)
            function lower/TypedFunctionV0 (typedunitv0-function unit)]
        (recur (+ position 1)
          (vec (concat claims
            [(->PayloadClaimV0 "typed-unit" (typedunitv0-unit-id unit)
               (typedunitv0-encoding unit))
             (->PayloadClaimV0 "typed-function"
               (lower/typedfunctionv0-id function)
               (encode-typed-function-wire-v1 function))]
            (mapv (fn [definition core/TypeDef] PayloadClaimV0
                    (->PayloadClaimV0 "type" (core/typedef-id definition)
                      (encode-type-def-wire-v1 definition)))
              (typedunitv0-types unit))
            (mapv (fn [effect core/EffectDef] PayloadClaimV0
                    (->PayloadClaimV0 "effect" (core/effectdef-id effect)
                      (encode-effect-wire-v1 effect)))
              (typedunitv0-effects unit))
            (mapv (fn [capability core/CapabilityDef] PayloadClaimV0
                    (->PayloadClaimV0 "capability"
                      (core/capabilitydef-id capability)
                      (encode-capability capability)))
              (typedunitv0-capabilities unit)))))))))

(defn native-unit-claims [units (Vec NativeUnitV0)] (Vec PayloadClaimV0)
  (loop [position Int 0
         claims (Vec PayloadClaimV0) []]
    (if (>= position (count units))
      claims
      (let [unit NativeUnitV0 (nth units position)
            function core/FunctionDef (nativeunitv0-function unit)]
        (recur (+ position 1)
          (vec (concat claims
            [(->PayloadClaimV0 "native-unit" (nativeunitv0-unit-id unit)
               (nativeunitv0-encoding unit))
             (->PayloadClaimV0 "native-function"
               (core/functiondef-id function)
               (encode-native-function-wire-v1 function))]
            (mapv (fn [layout core/LayoutDef] PayloadClaimV0
                    (->PayloadClaimV0 "layout" (core/layoutdef-id layout)
                      (encode-layout-def-wire-v1 layout)))
              (nativeunitv0-layouts unit))
            (mapv (fn [abi core/AbiDeclV0] PayloadClaimV0
                    (->PayloadClaimV0 "abi" (core/abideclv0-id abi)
                      (encode-abi-wire-v1 abi)))
              (nativeunitv0-abis unit))
            (mapv (fn [region core/RegionDef] PayloadClaimV0
                    (->PayloadClaimV0 "region" (core/regiondef-id region)
                      (stages/encode-region region)))
              (nativeunitv0-regions unit)))))))))

(defn support-claims
  [types (Vec core/TypeDef)
   effects (Vec core/EffectDef)
   capabilities (Vec core/CapabilityDef)
   regions (Vec core/RegionDef)
   layouts (Vec core/LayoutDef)] (Vec PayloadClaimV0)
  (vec (concat
    (mapv (fn [definition core/TypeDef] PayloadClaimV0
            (->PayloadClaimV0 "type" (core/typedef-id definition)
              (encode-type-def-wire-v1 definition)))
      types)
    (mapv (fn [effect core/EffectDef] PayloadClaimV0
            (->PayloadClaimV0 "effect" (core/effectdef-id effect)
              (encode-effect-wire-v1 effect)))
      effects)
    (mapv (fn [capability core/CapabilityDef] PayloadClaimV0
            (->PayloadClaimV0 "capability"
              (core/capabilitydef-id capability)
              (encode-capability capability)))
      capabilities)
    (mapv (fn [region core/RegionDef] PayloadClaimV0
            (->PayloadClaimV0 "region" (core/regiondef-id region)
              (stages/encode-region region)))
      regions)
    (mapv (fn [layout core/LayoutDef] PayloadClaimV0
            (->PayloadClaimV0 "layout" (core/layoutdef-id layout)
              (encode-layout-def-wire-v1 layout)))
      layouts))))

(defn id-before?
  [left core/NativeId
   right core/NativeId] Bool
  (< (compare (id-value left) (id-value right)) 0))

(defn insert-type
  [item core/TypeDef
   sorted (Vec core/TypeDef)] (Vec core/TypeDef)
  (loop [position Int 0
         inserted Bool false
         result (Vec core/TypeDef) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current core/TypeDef (nth sorted position)]
        (if (and (not inserted)
              (id-before? (core/typedef-id item) (core/typedef-id current)))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn ordered-types [values (Vec core/TypeDef)] (Vec core/TypeDef)
  (loop [position Int 0
         result (Vec core/TypeDef) []]
    (if (>= position (count values)) result
      (recur (+ position 1) (insert-type (nth values position) result)))))

(defn insert-typed-function
  [item lower/TypedFunctionV0
   sorted (Vec lower/TypedFunctionV0)] (Vec lower/TypedFunctionV0)
  (loop [position Int 0
         inserted Bool false
         result (Vec lower/TypedFunctionV0) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [current lower/TypedFunctionV0 (nth sorted position)]
        (if (and (not inserted)
              (id-before? (lower/typedfunctionv0-id item)
                (lower/typedfunctionv0-id current)))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn ordered-typed-functions [values (Vec lower/TypedFunctionV0)] (Vec lower/TypedFunctionV0)
  (loop [position Int 0
         result (Vec lower/TypedFunctionV0) []]
    (if (>= position (count values)) result
