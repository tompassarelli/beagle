            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-empty-capabilities-wire-v1 [encoding String] Bool
  (let [record (U WireRecordV1 Nil) (canonical-set-wire-record encoding "typed-unit-capabilities-wire-v1")]
    (and (some? record) (= 0 (count (wirerecordv1-fields record))))))

(defn decode-scalar-representation-wire-v1 [encoding String] (U core/ScalarReprV0 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)]
        (if (not= 1 (count fields))
          nil
          (let [bit-width (U Int Nil) (decode-wire-int (nth fields 0))]
            (if (or (nil? bit-width) (<= bit-width 0))
              nil
              (cond
                (= "signed-int-representation-wire-v1"
                  (wirerecordv1-tag record))
                (core/->SignedIntReprV0 bit-width)

                (= "unsigned-int-representation-wire-v1"
                  (wirerecordv1-tag record))
                (core/->UnsignedIntReprV0 bit-width)

                :else nil))))))))

(defn decode-union-variant-layout-wire-v1 [encoding String] (U core/UnionVariantLayoutV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "union-variant-layout-wire-v1" 4)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            variant-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            tag (U Int Nil) (decode-wire-int (nth fields 1))
            payload (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 2))
            offset (U Int Nil) (decode-wire-int (nth fields 3))]
        (if (and (some? variant-id) (some? tag) (some? payload)
              (some? offset) (>= tag 0) (>= offset 0))
          (core/->UnionVariantLayoutV0 variant-id tag
            (optional-wire-id-value payload) offset)
          nil)))))

(defn decode-union-variant-layouts-wire-v1 [encoding String] (U (Vec core/UnionVariantLayoutV0) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "union-variant-layouts-wire-v1")]
    (if (nil? record)
