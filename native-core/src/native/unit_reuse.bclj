  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "type-def-wire-v1" 3)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            name (U String Nil) (decode-wire-string (nth fields 1))
            shape (U core/TypeShape Nil) (decode-type-shape-wire-v1 (nth fields 2))]
        (if (and (some? identity) (some? name) (some? shape))
          (core/->TypeDef identity name shape) nil)))))

(defn decode-type-defs-wire-v1 [encoding String] (U (Vec core/TypeDef) Nil)
