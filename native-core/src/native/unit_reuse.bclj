#lang beagle/clj
;; Corpus-bounded unit payloads for the Phase-D branch-reuse experiment.  The
;; ordinary whole-program passes remain authoritative; this module only splits
;; their accepted output and deterministically composes those exact values.
(ns native.unit-reuse
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.obligations :as obligations]))


(defrecord UnitContractV0
  [(unit-id core/NativeId)
   (qualified-name String)
   (visibility String)
   (parameter-types (Vec core/NativeId))
   (return-type core/NativeId)
   (failure-type core/NativeId)
   (generated-bindings (Vec String))
   (encoding String)
   (digest String)])

(defrecord TypedUnitV0
  [(unit-id core/NativeId)
   (function lower/TypedFunctionV0)
   (types (Vec core/TypeDef))
   (effects (Vec core/EffectDef))
   (capabilities (Vec core/CapabilityDef))
   (encoding String)
   (digest String)])

(defrecord NativeUnitV0
  [(unit-id core/NativeId)
   (function core/FunctionDef)
   (layouts (Vec core/LayoutDef))
   (abis (Vec core/AbiDeclV0))
   (regions (Vec core/RegionDef))
   (encoding String)
   (digest String)])

(defunion UnitExtractionResultV0
  (UnitExtractionAcceptedV0
    [(contracts (Vec UnitContractV0))
     (typed-units (Vec TypedUnitV0))
     (native-units (Vec NativeUnitV0))])
  (UnitExtractionRejectedV0 [(code String) (detail String)]))

(defrecord UnitAssemblyV0
  [(typed stages/FrozenTypedStageV0)
   (typed-slice lower/TypedSliceV0)
   (native stages/FrozenNativeStageV0)
   (epoch stages/FrozenNativeStageV0)
   (verdicts (Vec obligations/ObligationVerdictV0))])

(defunion UnitAssemblyResultV0
  (UnitAssemblyAcceptedV0 [(assembly UnitAssemblyV0)])
  (UnitAssemblyRejectedV0 [(code String) (detail String)]))

(defrecord PayloadClaimV0
  [(category String) (identity core/NativeId) (encoding String)])

(defrecord ClaimCheckV0
  [(encodings (Map String String)) (valid Bool) (detail String)])

(defn id-value [(identity core/NativeId)] String
  (core/nativeid-value identity))

(defn encode-id-vector
  [(tag String) (identities (Vec core/NativeId))] String
  (stages/canonical-record tag
    (mapv (fn [(identity core/NativeId)] String (id-value identity))
      identities)))

(defn encode-capability-kind [(kind core/CapabilityKind)] String
  (cond
    (instance? native.core.ReadCapability kind) "read"
    (instance? native.core.WriteCapability kind) "write"
    (instance? native.core.AllocateCapability kind) "allocate"
    :else "host"))

(defn encode-capability [(capability core/CapabilityDef)] String
  (let [(region (U core/NativeId Nil)) (core/capabilitydef-region capability)]
    (stages/canonical-record "capability-def-v0"
      [(id-value (core/capabilitydef-id capability))
       (encode-capability-kind (core/capabilitydef-kind capability))
       (if (nil? region) "no-region" (id-value region))
       (if (core/capabilitydef-affine capability) "affine" "shared")])))

(defn encode-readiness [(readiness lower/NativeReadinessV0)] String
  (match readiness
    [(lower/NativeReadyV0 operation)
     (stages/canonical-record "typed-ready-v0" [operation])]
    [(lower/NativeLoweredV0 entry-block blocks)
     (stages/canonical-record "typed-lowered-v0"
       [(id-value entry-block)
        (stages/canonical-record "blocks"
          (mapv (fn [(block core/BasicBlock)] String
                  (lower/encode-basic-block block))
            blocks))])]
    [(lower/NativeTodoV0 code detail)
     (stages/canonical-record "typed-pending-v0" [code detail])]))

(defn encode-typed-function-payload
  [(function lower/TypedFunctionV0)] String
  (stages/canonical-record "typed-unit-function-v0"
    [(lower/encode-typed-function
       (lower/typedfunctionv0-id function)
       (lower/typedfunctionv0-name function)
       (lower/typedfunctionv0-abi-symbol function)
       (lower/typedfunctionv0-parameters function)
       (lower/typedfunctionv0-return-type function)
       (lower/typedfunctionv0-failure-type function)
       (lower/typedfunctionv0-effects function)
       (lower/readiness-code (lower/typedfunctionv0-readiness function)))
     (encode-readiness (lower/typedfunctionv0-readiness function))]))

(defn encode-unit-contract-value
  [(unit-id core/NativeId)
   (qualified-name String)
   (visibility String)
   (parameter-types (Vec core/NativeId))
   (return-type core/NativeId)
   (failure-type core/NativeId)
   (generated-bindings (Vec String))]
  String
  (stages/canonical-record "unit-contract-v0"
    [(id-value unit-id)
     qualified-name
     visibility
     (encode-id-vector "parameter-types" parameter-types)
     (id-value return-type)
     (id-value failure-type)
     (stages/canonical-set "generated-bindings" generated-bindings)]))

(defn make-unit-contract
  [(unit-id core/NativeId)
   (qualified-name String)
   (visibility String)
   (function lower/TypedFunctionV0)]
  UnitContractV0
  (let [(parameter-types (Vec core/NativeId))
        (mapv (fn [(parameter core/Parameter)] core/NativeId
                (core/parameter-type-id parameter))
          (lower/typedfunctionv0-parameters function))
        (generated-bindings (Vec String)) []
        (encoding String)
        (encode-unit-contract-value unit-id qualified-name visibility
          parameter-types
          (lower/typedfunctionv0-return-type function)
          (lower/typedfunctionv0-failure-type function)
          generated-bindings)]
    (->UnitContractV0 unit-id qualified-name visibility parameter-types
      (lower/typedfunctionv0-return-type function)
      (lower/typedfunctionv0-failure-type function)
      generated-bindings encoding (stages/content-digest encoding))))

(defn encode-typed-unit-value
  [(unit-id core/NativeId)
   (function lower/TypedFunctionV0)
   (types (Vec core/TypeDef))
   (effects (Vec core/EffectDef))
   (capabilities (Vec core/CapabilityDef))]
  String
  (stages/canonical-record "typed-unit-v0"
    [(id-value unit-id)
     (encode-typed-function-payload function)
     (stages/canonical-set "types"
       (mapv (fn [(definition core/TypeDef)] String
               (lower/encode-type-def definition))
         types))
     (stages/canonical-set "effects"
       (mapv (fn [(effect core/EffectDef)] String
               (lower/encode-effect effect))
         effects))
     (stages/canonical-set "capabilities"
       (mapv (fn [(capability core/CapabilityDef)] String
               (encode-capability capability))
         capabilities))]))

(defn make-typed-unit
  [(unit-id core/NativeId)
   (function lower/TypedFunctionV0)
   (types (Vec core/TypeDef))
   (effects (Vec core/EffectDef))
   (capabilities (Vec core/CapabilityDef))]
  TypedUnitV0
  (let [(encoding String)
        (encode-typed-unit-value unit-id function types effects capabilities)]
    (->TypedUnitV0 unit-id function types effects capabilities encoding
      (stages/content-digest encoding))))

(defn encode-native-unit-value
  [(unit-id core/NativeId)
   (function core/FunctionDef)
   (layouts (Vec core/LayoutDef))
   (abis (Vec core/AbiDeclV0))
   (regions (Vec core/RegionDef))]
  String
  (stages/canonical-record "native-unit-v0"
    [(id-value unit-id)
     (lower/encode-native-function function)
     (stages/canonical-set "layouts"
       (mapv (fn [(layout core/LayoutDef)] String
               (lower/encode-layout-def layout))
         layouts))
     (stages/canonical-set "abis"
       (mapv (fn [(abi core/AbiDeclV0)] String (lower/encode-abi abi))
         abis))
     (stages/canonical-set "regions"
       (mapv (fn [(region core/RegionDef)] String (stages/encode-region region))
         regions))]))

(defn make-native-unit
  [(unit-id core/NativeId)
   (function core/FunctionDef)
   (layouts (Vec core/LayoutDef))
   (abis (Vec core/AbiDeclV0))
   (regions (Vec core/RegionDef))]
  NativeUnitV0
  (let [(encoding String)
        (encode-native-unit-value unit-id function layouts abis regions)]
    (->NativeUnitV0 unit-id function layouts abis regions encoding
      (stages/content-digest encoding))))

(defn dependency-context-digest
  [(unit stages/SourceUnitV0)
   (contracts (Vec UnitContractV0))]
  String
  (let [(rows (Vec String))
        (mapv
          (fn [(read-id core/NativeId)] String
            (let [(contract (U UnitContractV0 Nil))
                  (some
                    (fn [(candidate UnitContractV0)] (U UnitContractV0 Nil)
                      (if (core/native-id= read-id
                            (unitcontractv0-unit-id candidate))
                        candidate nil))
                    contracts)]
              (if (nil? contract)
                (stages/canonical-record "missing-unit-contract-v0"
                  [(id-value read-id)])
                (stages/canonical-record "dependency-contract-v0"
                  [(id-value read-id) (unitcontractv0-digest contract)]))))
          (stages/sourceunitv0-read-set unit))]
    (stages/content-digest
      (stages/canonical-set "dependency-context-v0" rows))))

(defn unit-result-key
  [(compiler-context-digest String)
   (unit stages/SourceUnitV0)
   (contracts (Vec UnitContractV0))]
  String
  (stages/content-digest
    (stages/canonical-record "beagle-unit-result-v0"
      [compiler-context-digest
       (id-value (stages/sourceunitv0-id unit))
       (stages/sourceunitv0-semantic-digest unit)
       (dependency-context-digest unit contracts)])))

(defn conj-id
  [(identities (Vec core/NativeId))
   (candidate core/NativeId)]
  (Vec core/NativeId)
  (if (core/id-in? identities candidate) identities (conj identities candidate)))

(defn type-references [(definition core/TypeDef)] (Vec core/NativeId)
  (let [(shape core/TypeShape) (core/typedef-shape definition)]
    (cond
      (instance? native.core.RecordType shape)
      (mapv (fn [(field core/TypeField)] core/NativeId
              (core/typefield-type-id field))
        (core/recordtype-fields shape))

      (instance? native.core.UnionType shape)
      (loop [(position Int) 0
             (variants (Vec core/TypeVariant)) (core/uniontype-variants shape)
             (collected (Vec core/NativeId)) [(lower/type-id "UnionTag")]]
        (if (>= position (count variants))
          collected
          (let [(payload (U core/NativeId Nil))
                (core/typevariant-payload-type (nth variants position))]
            (recur (+ position 1) variants
              (if (nil? payload) collected (conj-id collected payload))))))

      (instance? native.core.VectorType shape)
      [(core/vectortype-element-type shape)]

      (instance? native.core.BufferTypeV0 shape)
      [(core/buffertypev0-element-type shape)]

      (instance? native.core.MapTypeV0 shape)
      [(core/maptypev0-key-type shape) (core/maptypev0-value-type shape)]

      (instance? native.core.SetTypeV0 shape)
      [(core/settypev0-element-type shape)]

      (instance? native.core.ReferenceType shape)
      [(core/referencetype-target-type shape)]

      (instance? native.core.AtomCellTypeV0 shape)
      [(core/atomcelltypev0-content-type shape)]

      (instance? native.core.FunctionType shape)
      (let [(rest-type (U core/NativeId Nil))
            (core/functiontype-rest-type shape)]
        (vec (concat
               (core/functiontype-parameter-types shape)
               (if (nil? rest-type) [] [rest-type])
               [(core/functiontype-return-type shape)])))

      (instance? native.core.OutcomeType shape)
      [(core/outcometype-value-type shape)
       (core/outcometype-failure-type shape)
       (lower/type-id "UnionTag")]

      :else [])))

(defn instruction-type [(instruction core/Instruction)] core/NativeId
  (core/ssavaluev0-type-id (get instruction :result)))

(defn typed-function-type-seeds
  [(function lower/TypedFunctionV0)] (Vec core/NativeId)
  (let [(with-parameters (Vec core/NativeId))
        (mapv (fn [(parameter core/Parameter)] core/NativeId
                (core/parameter-type-id parameter))
          (lower/typedfunctionv0-parameters function))
        (initial (Vec core/NativeId))
        (conj-id
          (conj-id with-parameters (lower/typedfunctionv0-return-type function))
          (lower/typedfunctionv0-failure-type function))
        (blocks (Vec core/BasicBlock))
        (lower/readiness-blocks (lower/typedfunctionv0-readiness function))]
    (loop [(position Int) 0 (collected (Vec core/NativeId)) initial]
      (if (>= position (count blocks))
        collected
        (let [(block core/BasicBlock) (nth blocks position)
              (with-block-parameters (Vec core/NativeId))
              (loop [(inner Int) 0 (current (Vec core/NativeId)) collected]
                (if (>= inner (count (core/basicblock-parameters block)))
                  current
                  (recur (+ inner 1)
                    (conj-id current
                      (core/parameter-type-id
                        (nth (core/basicblock-parameters block) inner))))))]
          (recur (+ position 1)
            (loop [(inner Int) 0
                   (current (Vec core/NativeId)) with-block-parameters]
              (if (>= inner (count (core/basicblock-instructions block)))
                current
                (recur (+ inner 1)
                  (conj-id current
                    (instruction-type
                      (nth (core/basicblock-instructions block) inner))))))))))))

(defn find-type
  [(types (Vec core/TypeDef))
   (target core/NativeId)]
  (U core/TypeDef Nil)
  (some
    (fn [(definition core/TypeDef)] (U core/TypeDef Nil)
      (if (core/native-id= target (core/typedef-id definition))
        definition nil))
    types))

(defn reachable-type-ids
  [(types (Vec core/TypeDef))
   (seeds (Vec core/NativeId))]
  (Vec core/NativeId)
  (loop [(round Int) 0 (current (Vec core/NativeId)) seeds]
    (let [(grown (Vec core/NativeId))
          (loop [(position Int) 0 (collected (Vec core/NativeId)) current]
            (if (>= position (count current))
              collected
              (let [(definition (U core/TypeDef Nil))
                    (find-type types (nth current position))
                    (references (Vec core/NativeId))
                    (if (nil? definition) [] (type-references definition))]
                (recur (+ position 1)
                  (loop [(inner Int) 0 (next (Vec core/NativeId)) collected]
                    (if (>= inner (count references))
                      next
                      (recur (+ inner 1)
                        (conj-id next (nth references inner)))))))))]
      (if (or (= (count grown) (count current)) (> round (count types)))
        grown
        (recur (+ round 1) grown)))))

(defn selected-types
  [(types (Vec core/TypeDef))
   (function lower/TypedFunctionV0)]
  (Vec core/TypeDef)
  (let [(function-seeds (Vec core/NativeId))
        (typed-function-type-seeds function)
        ;; The ordinary body pass publishes the checked arithmetic family as
        ;; one generated support root whenever any checked operation appears.
        ;; Keep that compiler-owned family with the unit that requested it so
        ;; dense assembly reproduces the authoritative typed stage exactly.
        (seeds (Vec core/NativeId))
        (if (lower/readiness-uses-checked?
              (lower/typedfunctionv0-readiness function))
          (vec (concat function-seeds
                 (mapv (fn [(definition core/TypeDef)] core/NativeId
                         (core/typedef-id definition))
                   (lower/checked-arithmetic-types))))
          function-seeds)
        (reachable (Vec core/NativeId))
        (reachable-type-ids types seeds)]
    (filterv (fn [(definition core/TypeDef)] Bool
               (core/id-in? reachable (core/typedef-id definition)))
      types)))

(defn selected-effects
  [(effects (Vec core/EffectDef))
   (function lower/TypedFunctionV0)]
  (Vec core/EffectDef)
  (filterv (fn [(effect core/EffectDef)] Bool
             (core/id-in? (lower/typedfunctionv0-effects function)
               (core/effectdef-id effect)))
    effects))

(defn selected-capabilities
  [(capabilities (Vec core/CapabilityDef))
   (function lower/TypedFunctionV0)]
  (Vec core/CapabilityDef)
  (let [(required (Vec core/NativeId)) (lower/function-capabilities function)]
    (filterv (fn [(capability core/CapabilityDef)] Bool
               (core/id-in? required (core/capabilitydef-id capability)))
      capabilities)))

(defn source-module-for
  [(modules (Vec stages/SourceModuleV1))
   (target core/NativeId)]
  (U stages/SourceModuleV1 Nil)
  (some
    (fn [(module stages/SourceModuleV1)] (U stages/SourceModuleV1 Nil)
      (if (core/native-id= target (stages/sourcemodulev1-id module))
        module nil))
    modules))

(defn typed-function-for
  [(functions (Vec lower/TypedFunctionV0))
   (target core/NativeId)]
  (U lower/TypedFunctionV0 Nil)
  (some
    (fn [(function lower/TypedFunctionV0)] (U lower/TypedFunctionV0 Nil)
      (if (core/native-id= target (lower/typedfunctionv0-id function))
        function nil))
    functions))

(defn native-function-for
  [(functions (Vec core/FunctionDef))
   (target core/NativeId)]
  (U core/FunctionDef Nil)
  (some
    (fn [(function core/FunctionDef)] (U core/FunctionDef Nil)
      (if (core/native-id= target (core/functiondef-id function))
        function nil))
    functions))

(defn selected-layouts
  [(layouts (Vec core/LayoutDef))
   (types (Vec core/TypeDef))]
  (Vec core/LayoutDef)
  (let [(type-ids (Vec core/NativeId))
        (mapv (fn [(definition core/TypeDef)] core/NativeId
                (core/typedef-id definition))
          types)]
    (filterv (fn [(layout core/LayoutDef)] Bool
               (core/id-in? type-ids (core/layoutdef-type-id layout)))
      layouts)))

(defn selected-abis
  [(abis (Vec core/AbiDeclV0))
   (typed-function lower/TypedFunctionV0)
   (native-function core/FunctionDef)]
  (Vec core/AbiDeclV0)
  (filterv
    (fn [(abi core/AbiDeclV0)] Bool
      (or (core/native-id= (core/functiondef-id native-function)
            (core/abideclv0-function-id abi))
          (lower/function-calls-abi? typed-function
            (core/abideclv0-id abi))))
    abis))

(defn selected-regions
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)]
  (Vec core/RegionDef)
  (filterv (fn [(region core/RegionDef)] Bool
             (core/id-in? (core/functiondef-regions function)
               (core/regiondef-id region)))
    regions))

(defn extract-unit-payloads
  [(source stages/SourceStageV1)
   (typed-slice lower/TypedSliceV0)
   (native-frozen stages/FrozenNativeStageV0)]
  UnitExtractionResultV0
  (let [(units (Vec stages/SourceUnitV0)) (stages/sourcestagev1-units source)
        (modules (Vec stages/SourceModuleV1))
        (stages/sourcestagev1-modules source)
        (index lower/SourceIndexV0)
        (lower/build-source-index (stages/sourcestagev1-terms source) modules)
        (typed-functions (Vec lower/TypedFunctionV0))
        (lower/typedslicev0-functions typed-slice)
        (native-program core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage native-frozen))]
    (if (not= 9 (count units))
      (->UnitExtractionRejectedV0 "UNIT-CORPUS-SIZE"
        (str "expected exactly nine source units, found " (count units)))
      (loop [(position Int) 0
             (contracts (Vec UnitContractV0)) []
             (typed-units (Vec TypedUnitV0)) []
             (native-units (Vec NativeUnitV0)) []]
        (if (>= position (count units))
          (->UnitExtractionAcceptedV0 contracts typed-units native-units)
          (let [(unit stages/SourceUnitV0) (nth units position)
                (unit-id core/NativeId) (stages/sourceunitv0-id unit)
                (function-id core/NativeId)
                (lower/function-id unit-id (stages/sourceunitv0-name unit))
                (module (U stages/SourceModuleV1 Nil))
                (source-module-for modules (stages/sourceunitv0-module-id unit))
                (typed-function (U lower/TypedFunctionV0 Nil))
                (typed-function-for typed-functions function-id)
                (native-function (U core/FunctionDef Nil))
                (native-function-for
                  (core/nativecoreprogram-functions native-program) function-id)
                (private-text String) (lower/fact-text index unit-id "private")]
            (cond
              (not= "defn" (stages/sourceunitv0-kind unit))
              (->UnitExtractionRejectedV0 "UNIT-CORPUS-KIND"
                (str "unsupported source unit kind "
                  (stages/sourceunitv0-kind unit) " for "
                  (stages/sourceunitv0-name unit)))

              (nil? module)
              (->UnitExtractionRejectedV0 "UNIT-MODULE-MISSING"
                (id-value (stages/sourceunitv0-module-id unit)))

              (nil? typed-function)
              (->UnitExtractionRejectedV0 "UNIT-TYPED-FUNCTION-MISSING"
                (id-value function-id))

              (nil? native-function)
              (->UnitExtractionRejectedV0 "UNIT-NATIVE-FUNCTION-MISSING"
                (id-value function-id))

              (not (or (= "true" private-text) (= "false" private-text)))
              (->UnitExtractionRejectedV0 "UNIT-VISIBILITY-MISSING"
                (id-value unit-id))

              :else
              (let [(qualified-name String)
                    (str (stages/sourcemodulev1-name module) "/"
                      (stages/sourceunitv0-name unit))
                    (visibility String)
                    (if (= "true" private-text) "private" "public")
                    (types (Vec core/TypeDef))
                    (selected-types (lower/typedslicev0-types typed-slice)
                      typed-function)
                    (contract UnitContractV0)
                    (make-unit-contract unit-id qualified-name visibility
                      typed-function)
                    (typed-unit TypedUnitV0)
                    (make-typed-unit unit-id typed-function types
                      (selected-effects (lower/typedslicev0-effects typed-slice)
                        typed-function)
                      (selected-capabilities
                        (lower/typedslicev0-capabilities typed-slice)
                        typed-function))
                    (native-unit NativeUnitV0)
                    (make-native-unit unit-id native-function
                      (selected-layouts
                        (core/nativecoreprogram-layouts native-program) types)
                      (selected-abis (core/nativecoreprogram-abis native-program)
                        typed-function native-function)
                      (selected-regions
                        (core/nativecoreprogram-regions native-program)
                        native-function))]
                (recur (+ position 1)
                  (conj contracts contract)
                  (conj typed-units typed-unit)
                  (conj native-units native-unit))))))))))

(defn claim-key [(claim PayloadClaimV0)] String
  (stages/canonical-record "unit-payload-claim-v0"
    [(payloadclaimv0-category claim)
     (id-value (payloadclaimv0-identity claim))]))

(defn check-payload-claims
  [(claims (Vec PayloadClaimV0))] ClaimCheckV0
  (loop [(position Int) 0
         (encodings (Map String String)) {}
         (valid Bool) true
         (detail String) ""]
    (if (or (>= position (count claims)) (not valid))
      (->ClaimCheckV0 encodings valid detail)
      (let [(claim PayloadClaimV0) (nth claims position)
            (key String) (claim-key claim)
            (prior (U String Nil)) (get encodings key)
            (encoding String) (payloadclaimv0-encoding claim)]
        (if (or (nil? prior) (= prior encoding))
          (recur (+ position 1) (assoc encodings key encoding) true "")
          (recur (+ position 1) encodings false
            (str (payloadclaimv0-category claim) " "
              (id-value (payloadclaimv0-identity claim))
              " has unequal canonical payloads")))))))

(defn contract-claims
  [(contracts (Vec UnitContractV0))] (Vec PayloadClaimV0)
  (mapv (fn [(contract UnitContractV0)] PayloadClaimV0
          (->PayloadClaimV0 "unit-contract"
            (unitcontractv0-unit-id contract)
            (unitcontractv0-encoding contract)))
    contracts))

(defn typed-unit-claims
  [(units (Vec TypedUnitV0))] (Vec PayloadClaimV0)
  (loop [(position Int) 0 (claims (Vec PayloadClaimV0)) []]
    (if (>= position (count units))
      claims
      (let [(unit TypedUnitV0) (nth units position)
            (function lower/TypedFunctionV0) (typedunitv0-function unit)]
        (recur (+ position 1)
          (vec (concat claims
            [(->PayloadClaimV0 "typed-unit" (typedunitv0-unit-id unit)
               (typedunitv0-encoding unit))
             (->PayloadClaimV0 "typed-function"
               (lower/typedfunctionv0-id function)
               (encode-typed-function-payload function))]
            (mapv (fn [(definition core/TypeDef)] PayloadClaimV0
                    (->PayloadClaimV0 "type" (core/typedef-id definition)
                      (lower/encode-type-def definition)))
              (typedunitv0-types unit))
            (mapv (fn [(effect core/EffectDef)] PayloadClaimV0
                    (->PayloadClaimV0 "effect" (core/effectdef-id effect)
                      (lower/encode-effect effect)))
              (typedunitv0-effects unit))
            (mapv (fn [(capability core/CapabilityDef)] PayloadClaimV0
                    (->PayloadClaimV0 "capability"
                      (core/capabilitydef-id capability)
                      (encode-capability capability)))
              (typedunitv0-capabilities unit)))))))))

(defn native-unit-claims
  [(units (Vec NativeUnitV0))] (Vec PayloadClaimV0)
  (loop [(position Int) 0 (claims (Vec PayloadClaimV0)) []]
    (if (>= position (count units))
      claims
      (let [(unit NativeUnitV0) (nth units position)
            (function core/FunctionDef) (nativeunitv0-function unit)]
        (recur (+ position 1)
          (vec (concat claims
            [(->PayloadClaimV0 "native-unit" (nativeunitv0-unit-id unit)
               (nativeunitv0-encoding unit))
             (->PayloadClaimV0 "native-function"
               (core/functiondef-id function)
               (lower/encode-native-function function))]
            (mapv (fn [(layout core/LayoutDef)] PayloadClaimV0
                    (->PayloadClaimV0 "layout" (core/layoutdef-id layout)
                      (lower/encode-layout-def layout)))
              (nativeunitv0-layouts unit))
            (mapv (fn [(abi core/AbiDeclV0)] PayloadClaimV0
                    (->PayloadClaimV0 "abi" (core/abideclv0-id abi)
                      (lower/encode-abi abi)))
              (nativeunitv0-abis unit))
            (mapv (fn [(region core/RegionDef)] PayloadClaimV0
                    (->PayloadClaimV0 "region" (core/regiondef-id region)
                      (stages/encode-region region)))
              (nativeunitv0-regions unit)))))))))

(defn support-claims
  [(types (Vec core/TypeDef))
   (effects (Vec core/EffectDef))
   (capabilities (Vec core/CapabilityDef))
   (regions (Vec core/RegionDef))
   (layouts (Vec core/LayoutDef))]
  (Vec PayloadClaimV0)
  (vec (concat
    (mapv (fn [(definition core/TypeDef)] PayloadClaimV0
            (->PayloadClaimV0 "type" (core/typedef-id definition)
              (lower/encode-type-def definition)))
      types)
    (mapv (fn [(effect core/EffectDef)] PayloadClaimV0
            (->PayloadClaimV0 "effect" (core/effectdef-id effect)
              (lower/encode-effect effect)))
      effects)
    (mapv (fn [(capability core/CapabilityDef)] PayloadClaimV0
            (->PayloadClaimV0 "capability"
              (core/capabilitydef-id capability)
              (encode-capability capability)))
      capabilities)
    (mapv (fn [(region core/RegionDef)] PayloadClaimV0
            (->PayloadClaimV0 "region" (core/regiondef-id region)
              (stages/encode-region region)))
      regions)
    (mapv (fn [(layout core/LayoutDef)] PayloadClaimV0
            (->PayloadClaimV0 "layout" (core/layoutdef-id layout)
              (lower/encode-layout-def layout)))
      layouts))))

(defn id-before? [(left core/NativeId) (right core/NativeId)] Bool
  (< (compare (id-value left) (id-value right)) 0))

(defn insert-type
  [(item core/TypeDef) (sorted (Vec core/TypeDef))] (Vec core/TypeDef)
  (loop [(position Int) 0 (inserted Bool) false
         (result (Vec core/TypeDef)) []]
    (if (>= position (count sorted))
      (if inserted result (conj result item))
      (let [(current core/TypeDef) (nth sorted position)]
        (if (and (not inserted)
              (id-before? (core/typedef-id item) (core/typedef-id current)))
          (recur (+ position 1) true (conj (conj result item) current))
          (recur (+ position 1) inserted (conj result current)))))))

(defn ordered-types [(values (Vec core/TypeDef))] (Vec core/TypeDef)
  (loop [(position Int) 0 (result (Vec core/TypeDef)) []]
    (if (>= position (count values)) result
      (recur (+ position 1) (insert-type (nth values position) result)))))

(defn insert-typed-function
