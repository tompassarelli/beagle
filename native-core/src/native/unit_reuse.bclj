(defn source-unit-ids [units (Vec stages/SourceUnitV0)] (Vec core/NativeId)
  (mapv (fn [unit stages/SourceUnitV0] core/NativeId
          (stages/sourceunitv0-id unit))
    units))

(defn contract-ids [contracts (Vec UnitContractV0)] (Vec core/NativeId)
  (mapv (fn [contract UnitContractV0] core/NativeId
          (unitcontractv0-unit-id contract))
    contracts))

(defn typed-unit-ids [units (Vec TypedUnitV0)] (Vec core/NativeId)
  (mapv (fn [unit TypedUnitV0] core/NativeId (typedunitv0-unit-id unit))
    units))

(defn native-unit-ids [units (Vec NativeUnitV0)] (Vec core/NativeId)
  (mapv (fn [unit NativeUnitV0] core/NativeId (nativeunitv0-unit-id unit))
    units))

(defn exact-id-set?
  [expected (Vec core/NativeId)
   actual (Vec core/NativeId)] Bool
  (and (= (count expected) (count actual))
    (core/unique-ids? actual)
    (core/ids-in? expected actual)
    (core/ids-in? actual expected)))

(defn unique-parameter-ids? [parameters (Vec core/Parameter)] Bool
  (core/unique-ids?
    (mapv (fn [parameter core/Parameter] core/NativeId
            (core/parameter-id parameter))
      parameters)))

(defn resource-token-kind-wire-v1-supported? [kind core/ResourceTokenKindV0] Bool
  (or (instance? native.core.RegionTokenV0 kind)
    (instance? native.core.CapabilityTokenV0 kind)))

(defn token-flow-wire-v1-supported? [flow core/TokenFlowV0] Bool
  (let [produced (Vec core/ResourceTokenV0) (core/tokenflowv0-produced flow)]
    (and (core/unique-ids? (core/tokenflowv0-consumed flow))
      (core/unique-ids?
        (mapv (fn [token core/ResourceTokenV0] core/NativeId
                (core/resourcetokenv0-id token))
          produced))
      (every?
        (fn [token core/ResourceTokenV0] Bool
          (resource-token-kind-wire-v1-supported?
            (core/resourcetokenv0-kind token)))
        produced))))

(defn instruction-wire-v1-supported? [instruction core/Instruction] Bool
  (cond
    (instance? native.core.AtomInstruction instruction)
    (instance? native.core.I64Atom (core/atominstruction-atom instruction))

    (instance? native.core.CallInstruction instruction)
    (token-flow-wire-v1-supported? (core/callinstruction-tokens instruction))

    (instance? native.core.CheckedInstruction instruction)
    (let [operation core/CheckedOperationV0 (core/checkedinstruction-operation instruction)]
      (or (instance? native.core.CheckedAddI64V0 operation)
        (instance? native.core.CheckedMulI64V0 operation)))

    (instance? native.core.VariantValueInstruction instruction) true
    :else false))

(defn switch-cases-wire-v1-supported? [cases (Vec core/SwitchCaseV0)] Bool
  (and (> (count cases) 0)
    (core/unique-ids?
      (mapv (fn [switch-case core/SwitchCaseV0] core/NativeId
              (core/switchcasev0-variant-id switch-case))
        cases))))

(defn terminator-wire-v1-supported? [terminator core/Terminator] Bool
  (cond
    (instance? native.core.ReturnTerminator terminator) true
    (instance? native.core.SwitchTerminator terminator)
    (switch-cases-wire-v1-supported? (core/switchterminator-cases terminator))
    (instance? native.core.TrapTerminator terminator) true
    :else false))

(defn block-wire-v1-supported? [block core/BasicBlock] Bool
  (and (unique-parameter-ids? (core/basicblock-parameters block))
    (every? instruction-wire-v1-supported?
      (core/basicblock-instructions block))
    (every? terminator-wire-v1-supported?
      (core/basicblock-terminators block))))

(defn blocks-wire-v1-supported?
  [entry-block core/NativeId
   blocks (Vec core/BasicBlock)] Bool
  (let [block-ids (Vec core/NativeId) (mapv (fn [block core/BasicBlock] core/NativeId
                (core/basicblock-id block))
          blocks)]
    (and (> (count blocks) 0)
      (core/unique-ids? block-ids)
      (core/id-in? block-ids entry-block)
      (every? block-wire-v1-supported? blocks))))

(defn readiness-wire-v1-supported? [readiness lower/NativeReadinessV0] Bool
  (and (instance? native.lower.NativeLoweredV0 readiness)
    (blocks-wire-v1-supported?
      (lower/nativeloweredv0-entry-block readiness)
      (lower/nativeloweredv0-blocks readiness))))

(defn typed-function-wire-v1-supported? [function lower/TypedFunctionV0] Bool
  (let [effects (Vec core/NativeId) (lower/typedfunctionv0-effects function)
        readiness lower/NativeReadinessV0 (lower/typedfunctionv0-readiness function)]
    (and (unique-parameter-ids? (lower/typedfunctionv0-parameters function))
      (= 1 (count effects))
      (core/native-id= (lower/pure-effect-id) (nth effects 0))
      (readiness-wire-v1-supported? readiness)
      (= (lower/typedfunctionv0-encoding function)
        (lower/encode-typed-function
          (lower/typedfunctionv0-id function)
          (lower/typedfunctionv0-name function)
          (lower/typedfunctionv0-abi-symbol function)
          (lower/typedfunctionv0-parameters function)
          (lower/typedfunctionv0-return-type function)
          (lower/typedfunctionv0-failure-type function)
          effects (lower/readiness-code readiness))))))

(defn type-variant-ids-unique? [variants (Vec core/TypeVariant)] Bool
  (core/unique-ids?
    (mapv (fn [variant core/TypeVariant] core/NativeId
            (core/typevariant-id variant))
      variants)))

(defn type-wire-v1-supported? [definition core/TypeDef] Bool
  (let [shape core/TypeShape (core/typedef-shape definition)]
    (cond
      (instance? native.core.AtomType shape)
      (instance? native.core.I64Kind (core/atomtype-kind shape))
      (instance? native.core.UnionType shape)
      (type-variant-ids-unique? (core/uniontype-variants shape))
      (instance? native.core.OutcomeType shape) true
      :else false)))

(defn effect-wire-v1-supported? [effect core/EffectDef] Bool
  (instance? native.core.PureEffect (core/effectdef-kind effect)))

(defn distinct-native-ids [values (Vec core/NativeId)] (Vec core/NativeId)
  (loop [position Int 0
         result (Vec core/NativeId) []]
    (if (>= position (count values)) result
      (recur (+ position 1) (conj-id result (nth values position))))))

(defn required-typed-unit-type-ids
  [function lower/TypedFunctionV0
   types (Vec core/TypeDef)] (Vec core/NativeId)
  (let [function-seeds (Vec core/NativeId) (typed-function-type-seeds function)
        checked-seeds (Vec core/NativeId) (if (lower/readiness-uses-checked?
              (lower/typedfunctionv0-readiness function))
          (mapv (fn [definition core/TypeDef] core/NativeId
                  (core/typedef-id definition))
            (lower/checked-arithmetic-types))
          [])
        seeds (Vec core/NativeId) (distinct-native-ids (vec (concat function-seeds checked-seeds)))]
    (filterv
      (fn [identity core/NativeId] Bool
        (not (core/native-id= identity (lower/type-id "UnionTag"))))
      (distinct-native-ids (reachable-type-ids types seeds)))))

(defn typed-unit-wire-v1-supported? [unit TypedUnitV0] Bool
  (let [function lower/TypedFunctionV0 (typedunitv0-function unit)
        types (Vec core/TypeDef) (typedunitv0-types unit)
        effects (Vec core/EffectDef) (typedunitv0-effects unit)]
    (and (core/native-id= (lower/typedfunctionv0-id function)
           (lower/function-id (typedunitv0-unit-id unit)
             (lower/typedfunctionv0-name function)))
      (typed-function-wire-v1-supported? function)
      (core/unique-ids? (core/type-ids types))
      (exact-id-set? (required-typed-unit-type-ids function types)
        (core/type-ids types))
      (core/unique-ids? (core/effect-ids effects))
      (every? type-wire-v1-supported? types)
      (= 1 (count effects))
      (every? effect-wire-v1-supported? effects)
      (exact-id-set? (lower/typedfunctionv0-effects function)
        (core/effect-ids effects))
      (= 0 (count (typedunitv0-capabilities unit))))))

(defn scalar-wire-v1-supported? [representation core/ScalarReprV0] Bool
  (or (instance? native.core.SignedIntReprV0 representation)
    (instance? native.core.UnsignedIntReprV0 representation)))

(defn layout-wire-v1-supported? [layout core/LayoutDef] Bool
  (let [shape core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (and (core/native-id= (core/layoutdef-id layout)
           (lower/lower-id "layout" [(id-value (core/layoutdef-type-id layout))]))
      (cond
        (instance? native.core.ScalarShapeV0 shape)
        (scalar-wire-v1-supported? (core/scalarshapev0-representation shape))
        (instance? native.core.UnionShapeV0 shape)
        (core/unique-ids?
          (mapv
            (fn [variant core/UnionVariantLayoutV0] core/NativeId
              (core/unionvariantlayoutv0-variant-id variant))
            (core/unionshapev0-variants shape)))
        :else false))))

(defn ownership-wire-v1-supported? [ownership core/OwnershipRuleV0] Bool
  (or (instance? native.core.BorrowedV0 ownership)
    (instance? native.core.OwnedV0 ownership)))

(defn abi-value-wire-v1-supported? [value core/AbiValueV0] Bool
  (and (> (count (core/abivaluev0-name value)) 0)
    (ownership-wire-v1-supported? (core/abivaluev0-ownership value))
    (nil? (core/abivaluev0-lifetime-region value))))

(defn id-vectors-equal?
  [left (Vec core/NativeId)
   right (Vec core/NativeId)] Bool
  (and (= (count left) (count right))
    (loop [position Int 0]
      (if (>= position (count left)) true
        (if (core/native-id= (nth left position) (nth right position))
          (recur (+ position 1)) false)))))

(defn abi-parameters-match-function?
  [function core/FunctionDef
   values (Vec core/AbiValueV0)] Bool
  (let [parameters (Vec core/Parameter) (core/functiondef-parameters function)]
    (and (= (count parameters) (count values))
      (loop [position Int 0]
        (if (>= position (count parameters)) true
          (let [parameter core/Parameter (nth parameters position)
                value core/AbiValueV0 (nth values position)]
            (if (and
                  (core/native-id= (core/parameter-type-id parameter)
                    (core/abivaluev0-type-id value))
                  (instance? native.core.BorrowedV0
                    (core/abivaluev0-ownership value)))
              (recur (+ position 1)) false)))))))

(defn abi-result-matches-function?
  [function core/FunctionDef
   result (U core/AbiValueV0 Nil)] Bool
  (let [return-type (U core/NativeId Nil) (core/functiondef-return-type function)]
    (cond
      (and (nil? return-type) (nil? result)) true
      (or (nil? return-type) (nil? result)) false
      :else
      (and (core/native-id= return-type (core/abivaluev0-type-id result))
        (instance? native.core.OwnedV0
          (core/abivaluev0-ownership result))))))

(defn abi-wire-v1-supported?
  [function core/FunctionDef
   abi core/AbiDeclV0] Bool
  (let [result (U core/AbiValueV0 Nil) (core/abideclv0-result abi)]
    (and (core/native-id= (core/functiondef-id function)
           (core/abideclv0-function-id abi))
      (core/native-id= (core/abideclv0-id abi)
        (lower/lower-id "abi" [(id-value (core/functiondef-id function))]))
      (> (count (core/abideclv0-symbol abi)) 0)
      (> (count (core/abideclv0-version abi)) 0)
      (instance? native.core.AbiExportV0 (core/abideclv0-direction abi))
      (instance? native.core.RestrictedCAbiV0 (core/abideclv0-convention abi))
      (every? abi-value-wire-v1-supported? (core/abideclv0-parameters abi))
      (or (nil? result) (abi-value-wire-v1-supported? result))
      (abi-parameters-match-function? function
        (core/abideclv0-parameters abi))
      (abi-result-matches-function? function result)
      (id-vectors-equal? (core/functiondef-effects function)
        (core/abideclv0-required-effects abi))
      (id-vectors-equal? (core/functiondef-capabilities function)
        (core/abideclv0-required-capabilities abi))
      (stages/sha256-digest? (core/abideclv0-layout-digest abi)))))

(defn native-function-wire-v1-supported? [function core/FunctionDef] Bool
  (let [effects (Vec core/NativeId) (core/functiondef-effects function)]
    (and (unique-parameter-ids? (core/functiondef-parameters function))
      (= 1 (count effects))
      (core/native-id= (lower/pure-effect-id) (nth effects 0))
      (= 0 (count (core/functiondef-regions function)))
      (= 0 (count (core/functiondef-capabilities function)))
      (blocks-wire-v1-supported?
        (core/functiondef-entry-block function)
        (core/functiondef-blocks function)))))

(defn native-unit-wire-v1-supported? [unit NativeUnitV0] Bool
  (let [function core/FunctionDef (nativeunitv0-function unit)
        layouts (Vec core/LayoutDef) (nativeunitv0-layouts unit)
        abis (Vec core/AbiDeclV0) (nativeunitv0-abis unit)]
    (and (core/native-id= (core/functiondef-id function)
           (lower/function-id (nativeunitv0-unit-id unit)
             (core/functiondef-name function)))
      (native-function-wire-v1-supported? function)
      (core/unique-ids? (core/layout-ids layouts))
      (core/unique-ids?
        (mapv (fn [layout core/LayoutDef] core/NativeId
                (core/layoutdef-type-id layout))
          layouts))
      (every? layout-wire-v1-supported? layouts)
      (= 1 (count abis))
      (core/unique-ids? (core/abi-ids abis))
      (every? (fn [abi core/AbiDeclV0] Bool
                (abi-wire-v1-supported? function abi))
        abis)
      (= 0 (count (nativeunitv0-regions unit))))))

(defn contract-record-valid? [contract UnitContractV0] Bool
  (and (= (unitcontractv0-digest contract)
         (stages/content-digest (unitcontractv0-encoding contract)))
    (= (unitcontractv0-encoding contract)
      (encode-unit-contract-value
        (unitcontractv0-unit-id contract)
        (unitcontractv0-qualified-name contract)
        (unitcontractv0-visibility contract)
        (unitcontractv0-parameter-types contract)
        (unitcontractv0-return-type contract)
        (unitcontractv0-failure-type contract)
        (unitcontractv0-generated-bindings contract)))))

(defn typed-unit-record-valid? [unit TypedUnitV0] Bool
  (and (typed-unit-wire-v1-supported? unit)
    (= (typedunitv0-digest unit)
         (stages/content-digest (typedunitv0-encoding unit)))
    (= (typedunitv0-encoding unit)
      (encode-typed-unit-wire-v1
        (typedunitv0-unit-id unit)
        (typedunitv0-function unit)
        (typedunitv0-types unit)
        (typedunitv0-effects unit)
        (typedunitv0-capabilities unit)))))

(defn native-unit-record-valid? [unit NativeUnitV0] Bool
  (and (native-unit-wire-v1-supported? unit)
    (= (nativeunitv0-digest unit)
         (stages/content-digest (nativeunitv0-encoding unit)))
    (= (nativeunitv0-encoding unit)
      (encode-native-unit-wire-v1
        (nativeunitv0-unit-id unit)
        (nativeunitv0-function unit)
        (nativeunitv0-layouts unit)
        (nativeunitv0-abis unit)
        (nativeunitv0-regions unit)))))

(defn unit-wire-byte-count [encoding String] Int
  (count (stages/utf8-bytes encoding)))

(defn old-unit-wire-tag? [tag String] Bool
  (or (= tag "typed-unit-v0") (= tag "native-unit-v0")))

(defn typed-unit-wire-rejection
  [code String
   detail String
   offset Int] TypedUnitWireDecodeResultV1
  (->TypedUnitWireRejectedV1 code detail offset))

(defn native-unit-wire-rejection
  [code String
   detail String
   offset Int] NativeUnitWireDecodeResultV1
  (->NativeUnitWireRejectedV1 code detail offset))

(defn decode-typed-unit-wire-v1
  [encoding String
   expected-byte-count Int
   expected-digest String
   expected-unit-id core/NativeId] TypedUnitWireDecodeResultV1
  (cond
    (or (< expected-byte-count 0)
      (not= expected-byte-count (unit-wire-byte-count encoding)))
    (typed-unit-wire-rejection "UNIT-WIRE-BYTE-COUNT"
      "typed unit raw UTF-8 byte count differs from projection metadata" -1)

    (or (not (stages/sha256-digest? expected-digest))
      (not= expected-digest (stages/content-digest encoding)))
    (typed-unit-wire-rejection "UNIT-WIRE-DIGEST"
      "typed unit SHA-256 differs from projection metadata" -1)

    :else
    (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
      (cond
        (nil? record)
        (typed-unit-wire-rejection "UNIT-WIRE-MALFORMED"
          "typed unit is not one complete canonical record" -1)

        (old-unit-wire-tag? (wirerecordv1-tag record))
        (typed-unit-wire-rejection "UNIT-WIRE-V0-NONINVERTIBLE"
          "old unit payloads omit semantic fields and cannot be decoded" 0)

        (or (not= "typed-unit-wire-v1" (wirerecordv1-tag record))
          (not= 5 (count (wirerecordv1-fields record))))
        (typed-unit-wire-rejection "UNIT-WIRE-TAG"
          "typed unit has an unknown outer tag or field count" 0)

        :else
        (let [fields (Vec String) (wirerecordv1-fields record)
              unit-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))
              function (U lower/TypedFunctionV0 Nil) (decode-typed-function-wire-v1 (nth fields 1))
              types (U (Vec core/TypeDef) Nil) (decode-type-defs-wire-v1 (nth fields 2))
              effects (U (Vec core/EffectDef) Nil) (decode-effects-wire-v1 (nth fields 3))
              capabilities-valid Bool (decode-empty-capabilities-wire-v1 (nth fields 4))]
          (if (or (nil? unit-id) (nil? function) (nil? types)
                (nil? effects) (not capabilities-valid))
            (typed-unit-wire-rejection "UNIT-WIRE-SCHEMA"
              "typed unit nested grammar or bounded variant is invalid" -1)
            (if (not (core/native-id= unit-id expected-unit-id))
              (typed-unit-wire-rejection "UNIT-WIRE-ID-MISMATCH"
                "typed unit identity differs from the requested source unit" -1)
              (let [unit TypedUnitV0 (->TypedUnitV0 unit-id function types effects [] encoding
                      expected-digest)]
                (if (typed-unit-record-valid? unit)
                  (->TypedUnitWireDecodedV1 unit)
                  (typed-unit-wire-rejection "UNIT-WIRE-REENCODE"
                    "typed unit failed identity, support, or exact re-encode validation"
                    -1))))))))))

(defn decode-native-unit-wire-v1
  [encoding String
   expected-byte-count Int
   expected-digest String
   expected-unit-id core/NativeId] NativeUnitWireDecodeResultV1
  (cond
    (or (< expected-byte-count 0)
      (not= expected-byte-count (unit-wire-byte-count encoding)))
    (native-unit-wire-rejection "UNIT-WIRE-BYTE-COUNT"
      "native unit raw UTF-8 byte count differs from projection metadata" -1)

    (or (not (stages/sha256-digest? expected-digest))
      (not= expected-digest (stages/content-digest encoding)))
    (native-unit-wire-rejection "UNIT-WIRE-DIGEST"
      "native unit SHA-256 differs from projection metadata" -1)

    :else
    (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
      (cond
        (nil? record)
        (native-unit-wire-rejection "UNIT-WIRE-MALFORMED"
          "native unit is not one complete canonical record" -1)

        (old-unit-wire-tag? (wirerecordv1-tag record))
        (native-unit-wire-rejection "UNIT-WIRE-V0-NONINVERTIBLE"
          "old unit payloads omit semantic fields and cannot be decoded" 0)

        (or (not= "native-unit-wire-v1" (wirerecordv1-tag record))
          (not= 5 (count (wirerecordv1-fields record))))
        (native-unit-wire-rejection "UNIT-WIRE-TAG"
          "native unit has an unknown outer tag or field count" 0)

        :else
        (let [fields (Vec String) (wirerecordv1-fields record)
              unit-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))
              function (U core/FunctionDef Nil) (decode-native-function-wire-v1 (nth fields 1))
              layouts (U (Vec core/LayoutDef) Nil) (decode-layout-defs-wire-v1 (nth fields 2))
              abis (U (Vec core/AbiDeclV0) Nil) (decode-abis-wire-v1 (nth fields 3))
              regions-valid Bool (decode-empty-regions-wire-v1 (nth fields 4))]
          (if (or (nil? unit-id) (nil? function) (nil? layouts)
                (nil? abis) (not regions-valid))
            (native-unit-wire-rejection "UNIT-WIRE-SCHEMA"
              "native unit nested grammar or bounded variant is invalid" -1)
            (if (not (core/native-id= unit-id expected-unit-id))
              (native-unit-wire-rejection "UNIT-WIRE-ID-MISMATCH"
                "native unit identity differs from the requested source unit" -1)
              (let [unit NativeUnitV0 (->NativeUnitV0 unit-id function layouts abis [] encoding
                      expected-digest)]
                (if (native-unit-record-valid? unit)
                  (->NativeUnitWireDecodedV1 unit)
                  (native-unit-wire-rejection "UNIT-WIRE-REENCODE"
                    "native unit failed identity, support, or exact re-encode validation"
                    -1))))))))))

(defn source-unit-for
  [units (Vec stages/SourceUnitV0)
   target core/NativeId] (U stages/SourceUnitV0 Nil)
  (some
    (fn [unit stages/SourceUnitV0] (U stages/SourceUnitV0 Nil)
      (if (core/native-id= target (stages/sourceunitv0-id unit)) unit nil))
    units))

(defn typed-unit-function-valid?
  [source-units (Vec stages/SourceUnitV0)
   unit TypedUnitV0] Bool
  (let [source (U stages/SourceUnitV0 Nil) (source-unit-for source-units (typedunitv0-unit-id unit))]
    (and (some? source)
      (core/native-id=
        (lower/typedfunctionv0-id (typedunitv0-function unit))
        (lower/function-id (typedunitv0-unit-id unit)
          (stages/sourceunitv0-name source))))))

(defn native-unit-function-valid?
  [source-units (Vec stages/SourceUnitV0)
   unit NativeUnitV0] Bool
  (let [source (U stages/SourceUnitV0 Nil) (source-unit-for source-units (nativeunitv0-unit-id unit))]
    (and (some? source)
      (core/native-id=
        (core/functiondef-id (nativeunitv0-function unit))
        (lower/function-id (nativeunitv0-unit-id unit)
          (stages/sourceunitv0-name source))))))

(defn native-unit-for-id
  [units (Vec NativeUnitV0)
   target core/NativeId] (U NativeUnitV0 Nil)
  (some
    (fn [unit NativeUnitV0] (U NativeUnitV0 Nil)
      (if (core/native-id= target (nativeunitv0-unit-id unit)) unit nil))
    units))

(defn typed-native-unit-pair-valid?
  [typed-unit TypedUnitV0
   native-unit NativeUnitV0] Bool
  (let [typed-function lower/TypedFunctionV0 (typedunitv0-function typed-unit)
        readiness lower/NativeReadinessV0 (lower/typedfunctionv0-readiness typed-function)
        native-function core/FunctionDef (nativeunitv0-function native-unit)
        abis (Vec core/AbiDeclV0) (nativeunitv0-abis native-unit)]
    (and (core/native-id= (typedunitv0-unit-id typed-unit)
           (nativeunitv0-unit-id native-unit))
      (instance? native.lower.NativeLoweredV0 readiness)
      (core/native-id= (lower/typedfunctionv0-id typed-function)
        (core/functiondef-id native-function))
      (= (lower/typedfunctionv0-name typed-function)
        (core/functiondef-name native-function))
      (= (lower/typedfunctionv0-parameters typed-function)
        (core/functiondef-parameters native-function))
      (= (lower/nativeloweredv0-blocks readiness)
        (core/functiondef-blocks native-function))
      (core/native-id= (lower/nativeloweredv0-entry-block readiness)
        (core/functiondef-entry-block native-function))
      (let [return-type (U core/NativeId Nil) (core/functiondef-return-type native-function)]
        (and (some? return-type)
          (core/native-id= (lower/typedfunctionv0-return-type typed-function)
            return-type)))
      (id-vectors-equal? (lower/typedfunctionv0-effects typed-function)
        (core/functiondef-effects native-function))
      (= 0 (count (core/functiondef-regions native-function)))
      (= 0 (count (core/functiondef-capabilities native-function)))
      (exact-id-set? (core/type-ids (typedunitv0-types typed-unit))
        (mapv (fn [layout core/LayoutDef] core/NativeId
                (core/layoutdef-type-id layout))
          (nativeunitv0-layouts native-unit)))
      (= 1 (count abis))
      (= (nth abis 0)
        (lower/function-abi typed-function
          (core/abideclv0-layout-digest (nth abis 0)))))))

(defn unit-pairs-valid?
  [typed-units (Vec TypedUnitV0)
   native-units (Vec NativeUnitV0)] Bool
  (every?
    (fn [typed-unit TypedUnitV0] Bool
      (let [native-unit (U NativeUnitV0 Nil) (native-unit-for-id native-units (typedunitv0-unit-id typed-unit))]
        (and (some? native-unit)
          (typed-native-unit-pair-valid? typed-unit native-unit))))
    typed-units))

(defn unit-records-valid?
  [source-units (Vec stages/SourceUnitV0)
   contracts (Vec UnitContractV0)
   typed-units (Vec TypedUnitV0)
   native-units (Vec NativeUnitV0)] Bool
  (and (every? contract-record-valid? contracts)
    (every? (fn [unit TypedUnitV0] Bool
              (and (typed-unit-record-valid? unit)
                (typed-unit-function-valid? source-units unit)))
      typed-units)
    (every? (fn [unit NativeUnitV0] Bool
              (and (native-unit-record-valid? unit)
                (native-unit-function-valid? source-units unit)))
      native-units)
    (unit-pairs-valid? typed-units native-units)))

(defn append-effect
  [values (Vec core/EffectDef)
   item core/EffectDef] (Vec core/EffectDef)
  (if (core/id-in? (core/effect-ids values) (core/effectdef-id item))
    values (conj values item)))

(defn append-capability
  [values (Vec core/CapabilityDef)
   item core/CapabilityDef] (Vec core/CapabilityDef)
  (if (core/id-in? (core/capability-ids values) (core/capabilitydef-id item))
    values (conj values item)))

(defn append-region
  [values (Vec core/RegionDef)
   item core/RegionDef] (Vec core/RegionDef)
  (if (core/id-in? (core/region-ids values) (core/regiondef-id item))
    values (conj values item)))

(defn append-layout
  [values (Vec core/LayoutDef)
   item core/LayoutDef] (Vec core/LayoutDef)
  (if (core/id-in? (core/layout-ids values) (core/layoutdef-id item))
    values (conj values item)))

(defn append-abi
  [values (Vec core/AbiDeclV0)
   item core/AbiDeclV0] (Vec core/AbiDeclV0)
  (if (core/id-in? (core/abi-ids values) (core/abideclv0-id item))
    values (conj values item)))

(defn append-typed-function
  [values (Vec lower/TypedFunctionV0)
   item lower/TypedFunctionV0] (Vec lower/TypedFunctionV0)
  (if (some?
        (some (fn [current lower/TypedFunctionV0] Bool
                (core/native-id= (lower/typedfunctionv0-id current)
                  (lower/typedfunctionv0-id item)))
          values))
    values (conj values item)))

(defn append-native-function
  [values (Vec core/FunctionDef)
   item core/FunctionDef] (Vec core/FunctionDef)
  (if (core/id-in? (core/function-ids values) (core/functiondef-id item))
    values (conj values item)))

(defn collect-types [units (Vec TypedUnitV0)] (Vec core/TypeDef)
  (loop [position Int 0
         values (Vec core/TypeDef) (lower/builtin-types [])]
    (if (>= position (count units)) values
      (recur (+ position 1)
        (lower/append-type-defs values (typedunitv0-types (nth units position)))))))

(defn collect-effects [units (Vec TypedUnitV0)] (Vec core/EffectDef)
  (loop [position Int 0
         values (Vec core/EffectDef) (lower/slice-effects false false false false false false false false)]
    (if (>= position (count units)) values
      (let [additions (Vec core/EffectDef) (typedunitv0-effects (nth units position))]
        (recur (+ position 1)
          (loop [inner Int 0
                 current (Vec core/EffectDef) values]
            (if (>= inner (count additions)) current
              (recur (+ inner 1) (append-effect current (nth additions inner))))))))))

(defn collect-capabilities [units (Vec TypedUnitV0)] (Vec core/CapabilityDef)
  (loop [position Int 0
         values (Vec core/CapabilityDef) (lower/slice-capabilities false false false false false false false false)]
    (if (>= position (count units)) values
      (let [additions (Vec core/CapabilityDef) (typedunitv0-capabilities (nth units position))]
        (recur (+ position 1)
          (loop [inner Int 0
                 current (Vec core/CapabilityDef) values]
            (if (>= inner (count additions)) current
              (recur (+ inner 1)
                (append-capability current (nth additions inner))))))))))

(defn collect-regions [units (Vec NativeUnitV0)] (Vec core/RegionDef)
  (loop [position Int 0
         values (Vec core/RegionDef) (lower/slice-regions)]
    (if (>= position (count units)) values
      (let [additions (Vec core/RegionDef) (nativeunitv0-regions (nth units position))]
        (recur (+ position 1)
          (loop [inner Int 0
                 current (Vec core/RegionDef) values]
            (if (>= inner (count additions)) current
              (recur (+ inner 1) (append-region current (nth additions inner))))))))))

(defn collect-typed-functions [units (Vec TypedUnitV0)] (Vec lower/TypedFunctionV0)
  (loop [position Int 0
         values (Vec lower/TypedFunctionV0) []]
    (if (>= position (count units)) values
      (recur (+ position 1)
        (append-typed-function values (typedunitv0-function (nth units position)))))))

(defn collect-native-functions [units (Vec NativeUnitV0)] (Vec core/FunctionDef)
  (loop [position Int 0
         values (Vec core/FunctionDef) []]
    (if (>= position (count units)) values
      (recur (+ position 1)
        (append-native-function values
          (nativeunitv0-function (nth units position)))))))

(defn collect-layouts [units (Vec NativeUnitV0)] (Vec core/LayoutDef)
  (loop [position Int 0
         values (Vec core/LayoutDef) []]
    (if (>= position (count units)) values
      (let [additions (Vec core/LayoutDef) (nativeunitv0-layouts (nth units position))]
        (recur (+ position 1)
          (loop [inner Int 0
                 current (Vec core/LayoutDef) values]
            (if (>= inner (count additions)) current
              (recur (+ inner 1) (append-layout current (nth additions inner))))))))))

(defn collect-abis [units (Vec NativeUnitV0)] (Vec core/AbiDeclV0)
  (loop [position Int 0
         values (Vec core/AbiDeclV0) []]
    (if (>= position (count units)) values
      (let [additions (Vec core/AbiDeclV0) (nativeunitv0-abis (nth units position))]
        (recur (+ position 1)
          (loop [inner Int 0
                 current (Vec core/AbiDeclV0) values]
            (if (>= inner (count additions)) current
              (recur (+ inner 1) (append-abi current (nth additions inner))))))))))

(defn layout-for-type?
  [layouts (Vec core/LayoutDef)
   type-id core/NativeId] Bool
  (some? (some (fn [layout core/LayoutDef] Bool
                 (core/native-id= type-id (core/layoutdef-type-id layout)))
           layouts)))

(defn complete-layouts
  [types (Vec core/TypeDef)
   provided (Vec core/LayoutDef)
   abi core/AbiProfileV0] (Vec core/LayoutDef)
  (loop [position Int 0
         layouts (Vec core/LayoutDef) provided]
    (if (>= position (count types)) layouts
      (let [definition core/TypeDef (nth types position)]
        (if (layout-for-type? layouts (core/typedef-id definition))
          (recur (+ position 1) layouts)
          (recur (+ position 1)
            (append-layout layouts
              (lower/layoutresolutionv0-layout
                (lower/resolve-layout types definition abi)))))))))

(defn bounded-functions?
  [typed-functions (Vec lower/TypedFunctionV0)
   native-functions (Vec core/FunctionDef)
   abis (Vec core/AbiDeclV0)] Bool
  (and (> (count typed-functions) 0)
    (= (count typed-functions) (count native-functions))
    (= (count typed-functions) (count abis))
    (every?
      (fn [function lower/TypedFunctionV0] Bool
        (and (= 1 (count (lower/typedfunctionv0-effects function)))
          (core/native-id= (lower/pure-effect-id)
            (nth (lower/typedfunctionv0-effects function) 0))
          (= 0 (count (lower/function-capabilities function)))
          (= 0 (count (lower/function-regions function)))))
      typed-functions)
    (every?
      (fn [abi core/AbiDeclV0] Bool
        (instance? native.core.AbiExportV0 (core/abideclv0-direction abi)))
      abis)))

(defn abi-layout-digests-match?
  [abis (Vec core/AbiDeclV0)
   layouts (Vec core/LayoutDef)] Bool
  (let [expected String (lower/layout-digest layouts)]
    (every? (fn [abi core/AbiDeclV0] Bool
              (= expected (core/abideclv0-layout-digest abi)))
      abis)))

(defn source-units-supported? [units (Vec stages/SourceUnitV0)] Bool
  (let [unit-ids (Vec core/NativeId) (source-unit-ids units)]
    (and (> (count units) 0)
    (core/unique-ids? unit-ids)
    (every? (fn [unit stages/SourceUnitV0] Bool
              (= "defn" (stages/sourceunitv0-kind unit)))
      units)
    (every? (fn [unit stages/SourceUnitV0] Bool
              (core/ids-in? (stages/sourceunitv0-read-set unit) unit-ids))
      units))))

(defn make-frozen-typed
  [source-digest String
   types (Vec core/TypeDef)
   functions (Vec lower/TypedFunctionV0)
   effects (Vec core/EffectDef)
   regions (Vec core/RegionDef)
   capabilities (Vec core/CapabilityDef)] stages/FrozenTypedStageV0
  (let [root core/NativeId (lower/lower-id "typed-stage" [source-digest])
        nodes (Vec stages/TermNodeV0) (lower/typed-term-nodes types functions effects
          false false false false false false false false)
        terms stages/TermGraphV0 (stages/->TermGraphV0 root
          (conj nodes
            (stages/->TermNodeV0 root
              (stages/->TextTermV0 "typed-stage-v0"))))
        stage stages/TypedStageV0 (stages/->TypedStageV0
          terms
          source-digest
          (core/type-ids types)
          (mapv (fn [function lower/TypedFunctionV0] core/NativeId
                  (lower/typedfunctionv0-id function))
            functions)
          (core/effect-ids effects)
          (core/region-ids regions)
          (core/capability-ids capabilities)
          [(lower/type-id "LowerFailure")])
        encoding String (stages/encode-typed-stage stage)]
    (stages/->FrozenTypedStageV0 stage encoding
      (stages/content-digest encoding))))

(defn make-native-program
  [typed-digest String
   types (Vec core/TypeDef)
   effects (Vec core/EffectDef)
   regions (Vec core/RegionDef)
   capabilities (Vec core/CapabilityDef)
   layouts (Vec core/LayoutDef)
   functions (Vec core/FunctionDef)
   abis (Vec core/AbiDeclV0)] core/NativeCoreProgram
  (core/->NativeCoreProgram
    (lower/lower-id "native-program" [typed-digest])
    (lower/lower-id "typed-stage" [typed-digest])
    "typed-to-native-v0"
    types
    effects
    regions
    capabilities
    layouts
    functions
    (core/effect-ids effects)
    (core/region-ids regions)
    (core/capability-ids capabilities)
    abis
    []))

(defn verdict-results [verdicts (Vec obligations/ObligationVerdictV0)] (Vec core/ObligationResult)
  (lower/native-obligation-results
    (obligations/obligation-passed? (nth verdicts 0))
    (obligations/obligation-passed? (nth verdicts 1))
    (obligations/obligation-passed? (nth verdicts 2))
    (obligations/obligation-passed? (nth verdicts 3))
    (obligations/obligation-passed? (nth verdicts 4))
    (obligations/obligation-passed? (nth verdicts 5))
    (obligations/obligation-passed? (nth verdicts 6))
    (obligations/obligation-passed? (nth verdicts 7))
    (obligations/obligation-passed? (nth verdicts 8))
    (obligations/obligation-passed? (nth verdicts 9))))

(defn make-frozen-native
  [typed-digest String
   program core/NativeCoreProgram
   verdicts (Vec obligations/ObligationVerdictV0)] stages/FrozenNativeStageV0
  (let [obligation-results (Vec core/ObligationResult) (verdict-results verdicts)
        root core/NativeId (lower/lower-id "native-terms" [typed-digest])
        obligation-roots (Vec core/NativeId) (mapv
          (fn [result core/ObligationResult] core/NativeId
            (lower/lower-id "obligation"
              [(core/obligationresult-detail result)]))
          obligation-results)
        nodes (Vec stages/TermNodeV0) (lower/native-term-nodes
          (core/nativecoreprogram-types program)
          (core/nativecoreprogram-effects program)
          (core/nativecoreprogram-capabilities program)
          (core/nativecoreprogram-layouts program)
          (core/nativecoreprogram-functions program)
          (core/nativecoreprogram-abis program)
          obligation-results)
        terms stages/TermGraphV0 (stages/->TermGraphV0 root
          (conj nodes
            (stages/->TermNodeV0 root
              (stages/->TextTermV0 "native-stage-v0"))))
        stage stages/NativeStageV0 (stages/->NativeStageV0 terms typed-digest program obligation-roots)
        encoding String (stages/encode-native-stage stage)]
    (stages/->FrozenNativeStageV0 stage encoding
      (stages/content-digest encoding))))

(defn unit-sets-exact?
  [source-units (Vec stages/SourceUnitV0)
   contracts (Vec UnitContractV0)
   typed-units (Vec TypedUnitV0)
   native-units (Vec NativeUnitV0)] Bool
  (let [expected (Vec core/NativeId) (source-unit-ids source-units)]
    (and (exact-id-set? expected (contract-ids contracts))
      (exact-id-set? expected (typed-unit-ids typed-units))
      (exact-id-set? expected (native-unit-ids native-units)))))

(defn assemble-unit-payloads
  [frozen-source stages/FrozenSourceStageV1
   contracts (Vec UnitContractV0)
   typed-units (Vec TypedUnitV0)
   native-units (Vec NativeUnitV0)
   compiler-commit String
   configuration (Vec String)
   abi core/AbiProfileV0] UnitAssemblyResultV0
  (let [source stages/SourceStageV1 (stages/frozensourcestagev1-stage frozen-source)
        source-units (Vec stages/SourceUnitV0) (stages/sourcestagev1-units source)]
    (cond
      (not (source-units-supported? source-units))
      (->UnitAssemblyRejectedV0 "UNIT-CORPUS-UNSUPPORTED"
        "assembly requires a nonempty closure of unique defn units")

      (not (unit-sets-exact? source-units contracts typed-units native-units))
      (->UnitAssemblyRejectedV0 "UNIT-SET-MISMATCH"
        "source, contract, typed, and native unit identities differ")

      (not (unit-records-valid? source-units contracts typed-units native-units))
      (->UnitAssemblyRejectedV0 "UNIT-PAYLOAD-CORRUPT"
        "a unit encoding, digest, or function identity is inconsistent")

      :else
      (let [types (Vec core/TypeDef) (ordered-types (collect-types typed-units))
            typed-functions (Vec lower/TypedFunctionV0) (ordered-typed-functions (collect-typed-functions typed-units))
            effects (Vec core/EffectDef) (ordered-effects (collect-effects typed-units))
            capabilities (Vec core/CapabilityDef) (ordered-capabilities (collect-capabilities typed-units))
            regions (Vec core/RegionDef) (ordered-regions (collect-regions native-units))
            native-types (Vec core/TypeDef) (ordered-types (lower/append-type-def types (lower/union-tag-type)))
            native-functions (Vec core/FunctionDef) (ordered-native-functions (collect-native-functions native-units))
            layouts (Vec core/LayoutDef) (ordered-layouts
              (complete-layouts native-types (collect-layouts native-units) abi))
            abis (Vec core/AbiDeclV0) (ordered-abis (collect-abis native-units))
            claims (Vec PayloadClaimV0) (vec (concat
              (contract-claims contracts)
              (typed-unit-claims typed-units)
              (native-unit-claims native-units)
              (support-claims native-types effects capabilities regions layouts)))
            claim-check ClaimCheckV0 (check-payload-claims claims)]
        (cond
          (not (claimcheckv0-valid claim-check))
          (->UnitAssemblyRejectedV0 "UNIT-PAYLOAD-COLLISION"
            (claimcheckv0-detail claim-check))

          (not (bounded-functions? typed-functions native-functions abis))
          (->UnitAssemblyRejectedV0 "UNIT-CORPUS-UNSUPPORTED"
            "the closure requires one pure definition and export per source unit")

          (not (abi-layout-digests-match? abis layouts))
          (->UnitAssemblyRejectedV0 "UNIT-ABI-LAYOUT-DIGEST"
            "an export ABI does not bind the complete candidate layout set")

          :else
          (let [frozen-typed stages/FrozenTypedStageV0 (make-frozen-typed
                  (stages/frozensourcestagev1-digest frozen-source)
                  types typed-functions effects regions capabilities)
                typed-slice lower/TypedSliceV0 (lower/->TypedSliceV0 types typed-functions effects regions
                  capabilities [(lower/type-id "LowerFailure")])
                program core/NativeCoreProgram (make-native-program
                  (stages/frozentypedstagev0-digest frozen-typed)
                  native-types effects regions capabilities layouts
                  native-functions abis)
                verdicts (Vec obligations/ObligationVerdictV0) (obligations/validate-native-core-program program abi)
                obligations-pass Bool (and (= 10 (count verdicts))
                  (every? obligations/obligation-passed? verdicts))]
            (if (not obligations-pass)
              (->UnitAssemblyRejectedV0 "UNIT-OBLIGATION-FAILED"
                "the assembled Native Core program failed an obligation")
              (let [frozen-native stages/FrozenNativeStageV0 (make-frozen-native
                      (stages/frozentypedstagev0-digest frozen-typed)
                      program verdicts)
                    epoch-result lower/EpochLoweringResultV0 (lower/epoch-derived-stage frozen-native compiler-commit
                      configuration abi)]
                (if (not (lower/epoch-result-complete? epoch-result))
                  (->UnitAssemblyRejectedV0 "UNIT-EPOCH-PENDING"
                    "derived epoch lowering left an explicit obligation")
                  (->UnitAssemblyAcceptedV0
                    (->UnitAssemblyV0 frozen-typed typed-slice frozen-native
                      (lower/epoch-result-frozen epoch-result)
                      verdicts)))))))))))
