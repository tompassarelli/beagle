#lang beagle/clj
;; Corpus-bounded unit payloads for the Phase-D branch-reuse experiment.  The
;; ordinary whole-program passes remain authoritative; this module only splits
;; their accepted output and deterministically composes those exact values.
(ns native.unit-reuse
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.obligations :as obligations]))


(defrecord ProfileIdentityV1
  [source-profile-id String
   profile-schema-version Int
   semantic-environment-id String
   target-abi-profile String
   encoding String
   digest String])

(defrecord SemanticEvaluationOrderV1
  [operator-order String
   argument-order String
   element-traversal-order String
   callback-invocation-order String])

(defrecord SemanticStrictnessV1
  [input-demand String
   element-demand String
   result-demand String
   realization-boundary String])

(defrecord SemanticAllocationBehaviorV1
  [result-representation String
   allocation-destination String
   freshness String
   aliasing String
   allocation-bound String])

(defrecord SemanticValueIdentityV1
  [identity-bearing Bool
   equality-rule String
   hashing-rule String
   identity-preservation String])

(defrecord SemanticMutationPersistenceV1
  [input-mutation String
   result-mutability String
   persistence-rule String
   update-visibility String])

(defrecord SemanticEffectsV1
  [effect-set (Vec String)
   effect-order String
   required-capabilities (Vec String)
   atomicity String])

(defrecord SemanticFailureBehaviorV1
  [static-rejections String
   runtime-failure-mode String
   failure-type String
   partial-result-rule String])

(defrecord SemanticOwnershipLifetimeV1
  [input-ownership String
   result-ownership String
   borrow-rule String
   escape-rule String
   lifetime-region String])

(defrecord SemanticProfileAvailabilityV1
  [availability String
   required-profile-features (Vec String)])

(defrecord SemanticPortabilityConditionsV1
  [compatible-profile-ids (Vec String)
   required-obligations (Vec String)
   discharge-evidence-kinds (Vec String)
   portability-diagnostic-id String])

(defrecord SemanticComplexityV1
  [time-class String
   space-class String
   order-sensitivity String])

(defrecord SemanticFormContractV1
  [contract-id String
   contract-schema-id String
   form-id String
   profile-identity ProfileIdentityV1
   contract-version Int
   classification String
   evaluation-order SemanticEvaluationOrderV1
   strictness SemanticStrictnessV1
   allocation-behavior SemanticAllocationBehaviorV1
   value-identity SemanticValueIdentityV1
   mutation-and-persistence SemanticMutationPersistenceV1
   effects SemanticEffectsV1
   failure-behavior SemanticFailureBehaviorV1
   ownership-and-lifetime SemanticOwnershipLifetimeV1
   profile-availability SemanticProfileAvailabilityV1
   portability-conditions SemanticPortabilityConditionsV1
   contractual-complexity SemanticComplexityV1
   decision-evidence-ids (Vec String)
   encoding String])

(defrecord UnitDerivationReceiptV1
  [receipt-id String
   profile-identity ProfileIdentityV1
   unit-id core/NativeId
   unit-semantic-digest String
   dependency-context-digest String
   typing-environment-hash String
   form-contract-hashes (Vec String)
   form-contract-set-digest String
   compiler-rule-epoch String
   materialization-receipt-id String
   result-fact-hashes (Vec String)
   encoding String])

(defrecord UnitContractV0
  [unit-id core/NativeId
   qualified-name String
   visibility String
   parameter-types (Vec core/NativeId)
   return-type core/NativeId
   failure-type core/NativeId
   generated-bindings (Vec String)
   encoding String
   digest String])

(defrecord TypedUnitV0
  [unit-id core/NativeId
   function lower/TypedFunctionV0
   types (Vec core/TypeDef)
   effects (Vec core/EffectDef)
   capabilities (Vec core/CapabilityDef)
   encoding String
   digest String])

(defrecord NativeUnitV0
  [unit-id core/NativeId
   function core/FunctionDef
   layouts (Vec core/LayoutDef)
   abis (Vec core/AbiDeclV0)
   regions (Vec core/RegionDef)
   encoding String
   digest String])

(defunion UnitExtractionResultV0
  (UnitExtractionAcceptedV0
    [contracts (Vec UnitContractV0)
     typed-units (Vec TypedUnitV0)
     native-units (Vec NativeUnitV0)])
  (UnitExtractionRejectedV0
    [code String
     detail String]))

(defrecord UnitAssemblyV0
  [typed stages/FrozenTypedStageV0
   typed-slice lower/TypedSliceV0
   native stages/FrozenNativeStageV0
   epoch stages/FrozenNativeStageV0
   verdicts (Vec obligations/ObligationVerdictV0)])

(defunion UnitAssemblyResultV0
  (UnitAssemblyAcceptedV0 [assembly UnitAssemblyV0])
  (UnitAssemblyRejectedV0
    [code String
     detail String]))

(defrecord PayloadClaimV0
  [category String
   identity core/NativeId
   encoding String])

(defrecord ClaimCheckV0
  [encodings (Map String String)
   valid Bool
   detail String])

(defrecord WirePartV1
  [value String
   next-offset Int])

(defrecord WireRecordV1
  [tag String
   fields (Vec String)])

(defunion TypedUnitWireDecodeResultV1
  (TypedUnitWireDecodedV1 [unit TypedUnitV0])
  (TypedUnitWireRejectedV1
    [code String
     detail String
     offset Int]))

(defunion NativeUnitWireDecodeResultV1
  (NativeUnitWireDecodedV1 [unit NativeUnitV0])
  (NativeUnitWireRejectedV1
    [code String
     detail String
     offset Int]))

(defn id-value [identity core/NativeId] String
  (core/nativeid-value identity))

(defn encode-string-set
  [tag String
   values (Vec String)] String
  (stages/canonical-set tag values))

(defn make-profile-identity-v1
  [source-profile-id String
   profile-schema-version Int
   semantic-environment-id String
   target-abi-profile String] ProfileIdentityV1
  (let [encoding String (stages/canonical-record "profile-identity-v1"
          [source-profile-id
           (str profile-schema-version)
           semantic-environment-id
           target-abi-profile])]
    (->ProfileIdentityV1 source-profile-id profile-schema-version
      semantic-environment-id target-abi-profile encoding
      (stages/content-digest encoding))))

(defn core-profile-identity-v1 [] ProfileIdentityV1
  (make-profile-identity-v1
    "core" 1
    (stages/content-digest
      (stages/canonical-record "core-semantic-environment-v1"
        ["semantic-contract-slice-v1"]))
    "NONE"))

(defn encode-semantic-evaluation-order [value SemanticEvaluationOrderV1] String
  (stages/canonical-record "semantic-evaluation-order-v1"
    [(semanticevaluationorderv1-operator-order value)
     (semanticevaluationorderv1-argument-order value)
     (semanticevaluationorderv1-element-traversal-order value)
     (semanticevaluationorderv1-callback-invocation-order value)]))

(defn encode-semantic-strictness [value SemanticStrictnessV1] String
  (stages/canonical-record "semantic-strictness-v1"
    [(semanticstrictnessv1-input-demand value)
     (semanticstrictnessv1-element-demand value)
     (semanticstrictnessv1-result-demand value)
     (semanticstrictnessv1-realization-boundary value)]))

(defn encode-semantic-allocation [value SemanticAllocationBehaviorV1] String
  (stages/canonical-record "semantic-allocation-behavior-v1"
    [(semanticallocationbehaviorv1-result-representation value)
     (semanticallocationbehaviorv1-allocation-destination value)
     (semanticallocationbehaviorv1-freshness value)
     (semanticallocationbehaviorv1-aliasing value)
     (semanticallocationbehaviorv1-allocation-bound value)]))

(defn encode-semantic-value-identity [value SemanticValueIdentityV1] String
  (stages/canonical-record "semantic-value-identity-v1"
    [(stages/encode-bool
       (semanticvalueidentityv1-identity-bearing value))
     (semanticvalueidentityv1-equality-rule value)
     (semanticvalueidentityv1-hashing-rule value)
     (semanticvalueidentityv1-identity-preservation value)]))

(defn encode-semantic-mutation-persistence [value SemanticMutationPersistenceV1] String
  (stages/canonical-record "semantic-mutation-persistence-v1"
    [(semanticmutationpersistencev1-input-mutation value)
     (semanticmutationpersistencev1-result-mutability value)
     (semanticmutationpersistencev1-persistence-rule value)
     (semanticmutationpersistencev1-update-visibility value)]))

(defn encode-semantic-effects [value SemanticEffectsV1] String
  (stages/canonical-record "semantic-effects-v1"
    [(encode-string-set "effect-set"
       (semanticeffectsv1-effect-set value))
     (semanticeffectsv1-effect-order value)
     (encode-string-set "required-capabilities"
       (semanticeffectsv1-required-capabilities value))
     (semanticeffectsv1-atomicity value)]))

(defn encode-semantic-failure [value SemanticFailureBehaviorV1] String
  (stages/canonical-record "semantic-failure-behavior-v1"
    [(semanticfailurebehaviorv1-static-rejections value)
     (semanticfailurebehaviorv1-runtime-failure-mode value)
     (semanticfailurebehaviorv1-failure-type value)
     (semanticfailurebehaviorv1-partial-result-rule value)]))

(defn encode-semantic-ownership [value SemanticOwnershipLifetimeV1] String
  (stages/canonical-record "semantic-ownership-lifetime-v1"
    [(semanticownershiplifetimev1-input-ownership value)
     (semanticownershiplifetimev1-result-ownership value)
     (semanticownershiplifetimev1-borrow-rule value)
     (semanticownershiplifetimev1-escape-rule value)
     (semanticownershiplifetimev1-lifetime-region value)]))

(defn encode-semantic-profile-availability [value SemanticProfileAvailabilityV1] String
  (stages/canonical-record "semantic-profile-availability-v1"
    [(semanticprofileavailabilityv1-availability value)
     (encode-string-set "required-profile-features"
       (semanticprofileavailabilityv1-required-profile-features value))]))

(defn encode-semantic-portability [value SemanticPortabilityConditionsV1] String
  (stages/canonical-record "semantic-portability-conditions-v1"
    [(encode-string-set "compatible-profile-ids"
       (semanticportabilityconditionsv1-compatible-profile-ids value))
     (encode-string-set "required-obligations"
       (semanticportabilityconditionsv1-required-obligations value))
     (encode-string-set "discharge-evidence-kinds"
       (semanticportabilityconditionsv1-discharge-evidence-kinds value))
     (semanticportabilityconditionsv1-portability-diagnostic-id value)]))

(defn encode-semantic-complexity [value SemanticComplexityV1] String
  (stages/canonical-record "semantic-complexity-v1"
    [(semanticcomplexityv1-time-class value)
     (semanticcomplexityv1-space-class value)
     (semanticcomplexityv1-order-sensitivity value)]))

(defn make-semantic-form-contract-v1
  [contract-schema-id String
   form-id String
   profile-identity ProfileIdentityV1
   contract-version Int
   classification String
   evaluation-order SemanticEvaluationOrderV1
   strictness SemanticStrictnessV1
   allocation-behavior SemanticAllocationBehaviorV1
   value-identity SemanticValueIdentityV1
   mutation-and-persistence SemanticMutationPersistenceV1
   effects SemanticEffectsV1
   failure-behavior SemanticFailureBehaviorV1
   ownership-and-lifetime SemanticOwnershipLifetimeV1
   profile-availability SemanticProfileAvailabilityV1
   portability-conditions SemanticPortabilityConditionsV1
   contractual-complexity SemanticComplexityV1
   decision-evidence-ids (Vec String)] SemanticFormContractV1
  (let [encoding String (stages/canonical-record "semantic-form-contract-v1"
          [contract-schema-id
           form-id
           (profileidentityv1-encoding profile-identity)
           (str contract-version)
           classification
           (encode-semantic-evaluation-order evaluation-order)
           (encode-semantic-strictness strictness)
           (encode-semantic-allocation allocation-behavior)
           (encode-semantic-value-identity value-identity)
           (encode-semantic-mutation-persistence mutation-and-persistence)
           (encode-semantic-effects effects)
           (encode-semantic-failure failure-behavior)
           (encode-semantic-ownership ownership-and-lifetime)
           (encode-semantic-profile-availability profile-availability)
           (encode-semantic-portability portability-conditions)
           (encode-semantic-complexity contractual-complexity)
           (encode-string-set "decision-evidence-ids"
             decision-evidence-ids)])]
    (->SemanticFormContractV1
      (stages/content-digest encoding)
      contract-schema-id form-id profile-identity contract-version
      classification evaluation-order strictness allocation-behavior
      value-identity mutation-and-persistence effects failure-behavior
      ownership-and-lifetime profile-availability portability-conditions
      contractual-complexity decision-evidence-ids encoding)))

(defn rebuild-semantic-form-contract
  [contract SemanticFormContractV1
   profile-identity ProfileIdentityV1
   contract-version Int] SemanticFormContractV1
  (make-semantic-form-contract-v1
    (semanticformcontractv1-contract-schema-id contract)
    (semanticformcontractv1-form-id contract)
    profile-identity contract-version
    (semanticformcontractv1-classification contract)
    (semanticformcontractv1-evaluation-order contract)
    (semanticformcontractv1-strictness contract)
    (semanticformcontractv1-allocation-behavior contract)
    (semanticformcontractv1-value-identity contract)
    (semanticformcontractv1-mutation-and-persistence contract)
    (semanticformcontractv1-effects contract)
    (semanticformcontractv1-failure-behavior contract)
    (semanticformcontractv1-ownership-and-lifetime contract)
    (semanticformcontractv1-profile-availability contract)
    (semanticformcontractv1-portability-conditions contract)
    (semanticformcontractv1-contractual-complexity contract)
    (semanticformcontractv1-decision-evidence-ids contract)))

(defn semantic-form-contract-with-version
  [contract SemanticFormContractV1
   contract-version Int] SemanticFormContractV1
  (rebuild-semantic-form-contract contract
    (semanticformcontractv1-profile-identity contract) contract-version))

(defn semantic-form-contract-with-profile
  [contract SemanticFormContractV1
   profile-identity ProfileIdentityV1] SemanticFormContractV1
  (rebuild-semantic-form-contract contract profile-identity
    (semanticformcontractv1-contract-version contract)))

(defn five-form-semantic-contracts [profile-identity ProfileIdentityV1] (Vec SemanticFormContractV1)
  (let [schema String "beagle.semantic-form-contract/v1"
        evidence (Vec String) ["SEMANTIC-CONTRACTS-DESIGN#narrow-post-flip-migration-slice"]]
    [(make-semantic-form-contract-v1
       schema "let" profile-identity 1 "common"
       (->SemanticEvaluationOrderV1
         "special-form" "left-to-right" "none" "none")
       (->SemanticStrictnessV1
         "strict-initializers" "not-applicable" "strict-body-result"
         "binding-complete")
       (->SemanticAllocationBehaviorV1
         "body-result" "none" "preserved" "preserved"
         "no-intrinsic-allocation")
       (->SemanticValueIdentityV1
         false "value-defined" "value-defined" "preserved")
       (->SemanticMutationPersistenceV1
         "none" "value-defined" "lexical-bindings-immutable"
         "after-each-initializer")
       (->SemanticEffectsV1
         [] "initializers-left-to-right-then-body" [] "not-atomic")
       (->SemanticFailureBehaviorV1
         "binding-shape-and-type-rules" "propagate-initializer-or-body"
         "propagated" "failed-binding-not-installed")
       (->SemanticOwnershipLifetimeV1
         "preserved" "body-result" "lexical" "body-result-may-escape"
         "implementation-chosen")
       (->SemanticProfileAvailabilityV1 "available" ["lexical-binding"])
       (->SemanticPortabilityConditionsV1
         ["clj" "js" "nix" "core"] [] [] "NONE")
       (->SemanticComplexityV1
         "linear-in-bindings" "constant-per-binding" "order-sensitive")
       evidence)
     (make-semantic-form-contract-v1
       schema "map" profile-identity 1 "similar-but-semantically-different"
       (->SemanticEvaluationOrderV1
         "callback-first" "left-to-right" "left-to-right"
         "left-to-right")
       (->SemanticStrictnessV1
         "strict-input" "eager-all-elements" "strict-result" "call-return")
       (->SemanticAllocationBehaviorV1
         "eager-vector" "current-arena" "fresh-result"
         "elements-preserved" "linear-in-input")
       (->SemanticValueIdentityV1
         false "structural" "structural" "new-container")
       (->SemanticMutationPersistenceV1
         "none" "persistent-value" "input-preserved" "result-only")
       (->SemanticEffectsV1
         [] "callback-left-to-right" ["allocate"] "not-atomic")
       (->SemanticFailureBehaviorV1
         "typed-unary-callback-and-supported-input" "first-callback-failure"
         "propagated" "no-result")
       (->SemanticOwnershipLifetimeV1
         "borrowed-input" "arena-owned" "elements-borrowed-during-callback"
         "result-follows-arena" "current-arena")
       (->SemanticProfileAvailabilityV1
         "available" ["native-eager-higher-order"])
       (->SemanticPortabilityConditionsV1
         ["core"] [] [] "SEM-CONTRACT-MAP-CROSS-PROFILE")
       (->SemanticComplexityV1 "linear" "linear" "order-sensitive")
       evidence)
     (make-semantic-form-contract-v1
       schema "store/transact" profile-identity 1 "native-only"
       (->SemanticEvaluationOrderV1
         "transaction-first" "left-to-right" "store-defined"
         "transaction-body-once")
       (->SemanticStrictnessV1
         "strict" "strict" "commit-visible" "transaction-commit")
       (->SemanticAllocationBehaviorV1
         "durable-revision" "store" "fresh-revision"
         "structural-identity" "transaction-bounded")
       (->SemanticValueIdentityV1
         true "structural-term" "canonical-term-hash" "durable-identity")
       (->SemanticMutationPersistenceV1
         "store-only" "durable" "append-only-revision" "commit-atomic")
       (->SemanticEffectsV1
         ["store-write"] "transaction-order" ["store-write"] "atomic")
       (->SemanticFailureBehaviorV1
         "transaction-and-capability-rules" "abort-transaction"
         "store-transaction-failure" "no-partial-commit")
       (->SemanticOwnershipLifetimeV1
         "borrowed-transaction-input" "store-owned" "transaction-scoped"
         "durable-result-may-escape" "store")
       (->SemanticProfileAvailabilityV1 "available" ["beagle-store"])
       (->SemanticPortabilityConditionsV1
         ["core"] ["store-write-capability"] ["capability-proof"]
         "SEM-CONTRACT-STORE-OP")
       (->SemanticComplexityV1
         "transaction-dependent" "durable-delta" "order-sensitive")
       evidence)
     (make-semantic-form-contract-v1
       schema "bgl/promote" profile-identity 1
       "similar-but-semantically-different"
       (->SemanticEvaluationOrderV1
         "value-first" "left-to-right" "reachable-layout-order" "none")
       (->SemanticStrictnessV1
         "strict" "deep-copy-when-crossing" "strict-result" "copy-complete")
       (->SemanticAllocationBehaviorV1
         "same-typed-value" "parent-arena" "fresh-copy-when-crossing"
         "aliasing-not-preserved" "reachable-value-bounded")
       (->SemanticValueIdentityV1
         false "structural" "structural" "value-preserved-address-changed")
       (->SemanticMutationPersistenceV1
         "none" "value-defined" "source-preserved" "new-parent-copy")
       (->SemanticEffectsV1
         ["allocate"] "descriptor-copy-order" ["allocate"] "not-atomic")
       (->SemanticFailureBehaviorV1
         "provable-lifetime-crossing" "allocation-failure"
         "lower-failure" "no-result")
       (->SemanticOwnershipLifetimeV1
         "borrowed-source" "parent-arena-owned" "source-valid-during-copy"
         "result-may-outlive-child" "parent-arena")
       (->SemanticProfileAvailabilityV1
         "available" ["arena-promotion"])
       (->SemanticPortabilityConditionsV1
         ["core"] ["epoch-soundness"] ["lifetime-proof"]
         "SEM-CONTRACT-ARENA-ALLOC")
       (->SemanticComplexityV1
         "linear-in-reachable-value" "linear-copy" "layout-order-sensitive")
       evidence)
     (make-semantic-form-contract-v1
       schema "println" profile-identity 1 "portable-with-obligations"
       (->SemanticEvaluationOrderV1
         "callee-first" "left-to-right" "left-to-right" "none")
       (->SemanticStrictnessV1
         "strict-arguments" "strict-rendering" "strict-nil" "write-complete")
       (->SemanticAllocationBehaviorV1
         "nil" "implementation-chosen" "not-applicable"
         "not-applicable" "rendered-text-bounded")
       (->SemanticValueIdentityV1
         false "nil" "nil" "not-applicable")
       (->SemanticMutationPersistenceV1
         "none" "immutable-nil" "external-output-only" "ordered-write")
       (->SemanticEffectsV1
         ["stdout-write"] "arguments-then-single-line-write"
         ["stdout-write"] "single-write")
       (->SemanticFailureBehaviorV1
         "printable-arguments" "host-output-failure" "lower-failure"
         "no-result-guarantee-after-failure")
       (->SemanticOwnershipLifetimeV1
         "borrowed-arguments" "owned-nil" "call-scoped"
         "no-borrow-escapes" "call")
       (->SemanticProfileAvailabilityV1 "available" ["stdout"])
       (->SemanticPortabilityConditionsV1
         ["clj" "js" "nix" "core"] ["stdout-write-capability"]
         ["capability-proof"] "SEM-CONTRACT-EFFECT")
       (->SemanticComplexityV1
         "linear-in-rendered-output" "render-buffer-dependent"
         "order-sensitive")
       evidence)]))

(defn decimal-digit? [character String] Bool
  (or (= character "0") (= character "1") (= character "2")
    (= character "3") (= character "4") (= character "5")
    (= character "6") (= character "7") (= character "8")
    (= character "9")))

(defn canonical-unsigned-decimal? [value String] Bool
  (and (> (count value) 0)
    (or (= (count value) 1) (not= "0" (subs value 0 1)))
    (every?
      (fn [character Any] Bool (decimal-digit? (str character)))
      (vec value))))

(defn canonical-signed-decimal? [value String] Bool
  (if (and (> (count value) 0) (= "-" (subs value 0 1)))
    (and (> (count value) 1)
      (not= "0" (subs value 1 (count value)))
      (canonical-unsigned-decimal? (subs value 1 (count value))))
    (canonical-unsigned-decimal? value)))

(defn decimal-value [value String] (U Int Nil)
  (if (canonical-signed-decimal? value) (parse-long value) nil))

(defn colon-offset
  [text String
   offset Int] Int
  (loop [position Int offset]
    (cond
      (>= position (count text)) -1
      (= ":" (subs text position (+ position 1))) position
      :else (recur (+ position 1)))))

(defn read-wire-part
  [text String
   offset Int] (U WirePartV1 Nil)
  (let [colon Int (colon-offset text offset)]
    (if (< colon offset)
      nil
      (let [length-text String (subs text offset colon)
            size (U Int Nil) (if (canonical-unsigned-decimal? length-text)
              (parse-long length-text) nil)
            start Int (+ colon 1)]
        (if (or (nil? size) (> size (- (count text) start)))
          nil
          (->WirePartV1 (subs text start (+ start size)) (+ start size)))))))

(defn parse-wire-record [text String] (U WireRecordV1 Nil)
  (let [tag-part (U WirePartV1 Nil) (read-wire-part text 0)]
    (if (nil? tag-part)
      nil
      (let [separator Int (wirepartv1-next-offset tag-part)]
        (if (or (>= separator (count text))
              (not= ":" (subs text separator (+ separator 1))))
          nil
          (loop [offset Int (+ separator 1)
                 fields (Vec String) []]
            (cond
              (= offset (count text))
              (->WireRecordV1 (wirepartv1-value tag-part) fields)

              (> offset (count text)) nil

              :else
              (let [field (U WirePartV1 Nil) (read-wire-part text offset)]
                (if (nil? field)
                  nil
                  (recur (wirepartv1-next-offset field)
                    (conj fields (wirepartv1-value field))))))))))))

(defn required-wire-record
  [text String
   tag String
   field-count Int] (U WireRecordV1 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record text)]
    (if (and (some? record)
          (= tag (wirerecordv1-tag record))
          (= field-count (count (wirerecordv1-fields record))))
      record nil)))

(defn wire-record-with-tag
  [text String
   tag String] (U WireRecordV1 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record text)]
    (if (and (some? record) (= tag (wirerecordv1-tag record))) record nil)))

(defn sorted-distinct-fields? [fields (Vec String)] Bool
  (and (= fields (vec (sort fields)))
    (= (count fields) (count (vec (distinct fields))))))

(defn encode-wire-bool [value Bool] String
  (stages/canonical-record "bool-wire-v1" [(stages/encode-bool value)]))

(defn decode-wire-bool [encoding String] (U Bool Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "bool-wire-v1" 1)]
    (if (nil? record)
      nil
      (let [value String (nth (wirerecordv1-fields record) 0)]
        (cond (= value "1") true (= value "0") false :else nil)))))

(defn decode-wire-id [encoding String] (U core/NativeId Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "id" 1)]
    (if (nil? record)
      nil
      (let [value String (nth (wirerecordv1-fields record) 0)]
        (if (> (count value) 0) (core/->NativeId value) nil)))))

(defn decode-wire-string [encoding String] (U String Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "string" 1)]
    (if (nil? record) nil (nth (wirerecordv1-fields record) 0))))

(defn decode-wire-int [encoding String] (U Int Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "int" 1)]
    (if (nil? record)
      nil
      (decimal-value (nth (wirerecordv1-fields record) 0)))))

(defn encode-wire-optional-id [value (U core/NativeId Nil)] String
  (if (nil? value)
    (stages/canonical-record "none" [])
    (stages/canonical-record "some" [(stages/encode-id value)])))

(defn decode-wire-optional-id [encoding String] (U (Vec core/NativeId) Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (cond
      (nil? record) nil
      (and (= "none" (wirerecordv1-tag record))
        (= 0 (count (wirerecordv1-fields record)))) []
      (and (= "some" (wirerecordv1-tag record))
        (= 1 (count (wirerecordv1-fields record))))
      (let [value (U core/NativeId Nil) (decode-wire-id (nth (wirerecordv1-fields record) 0))]
        (if (nil? value) nil [value]))
      :else nil)))

(defn optional-wire-id-value [decoded (Vec core/NativeId)] (U core/NativeId Nil)
  (if (= 0 (count decoded)) nil (nth decoded 0)))

(defn encode-wire-id-vector
  [tag String
   values (Vec core/NativeId)] String
  (stages/canonical-record tag
    (mapv (fn [value core/NativeId] String (stages/encode-id value)) values)))

(defn decode-wire-id-vector
  [encoding String
   tag String] (U (Vec core/NativeId) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding tag)]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/NativeId) []]
        (if (>= position (count fields))
          values
          (let [value (U core/NativeId Nil) (decode-wire-id (nth fields position))]
            (if (nil? value)
              nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn encode-id-vector
  [tag String
   identities (Vec core/NativeId)] String
  (stages/canonical-record tag
    (mapv (fn [identity core/NativeId] String (id-value identity))
      identities)))

(defn encode-capability-kind [kind core/CapabilityKind] String
  (cond
    (instance? native.core.ReadCapability kind) "read"
    (instance? native.core.WriteCapability kind) "write"
    (instance? native.core.AllocateCapability kind) "allocate"
    :else "host"))

(defn encode-capability [capability core/CapabilityDef] String
  (let [region (U core/NativeId Nil) (core/capabilitydef-region capability)]
    (stages/canonical-record "capability-def-v0"
      [(id-value (core/capabilitydef-id capability))
       (encode-capability-kind (core/capabilitydef-kind capability))
       (if (nil? region) "no-region" (id-value region))
       (if (core/capabilitydef-affine capability) "affine" "shared")])))

(defn encode-readiness [readiness lower/NativeReadinessV0] String
  (match readiness
    [(lower/NativeReadyV0 operation)
     (stages/canonical-record "typed-ready-v0" [operation])]
    [(lower/NativeLoweredV0 entry-block blocks)
     (stages/canonical-record "typed-lowered-v0"
       [(id-value entry-block)
        (stages/canonical-record "blocks"
          (mapv (fn [block core/BasicBlock] String
                  (lower/encode-basic-block block))
            blocks))])]
    [(lower/NativeTodoV0 code detail)
     (stages/canonical-record "typed-pending-v0" [code detail])]))

(defn encode-typed-function-payload [function lower/TypedFunctionV0] String
  (stages/canonical-record "typed-unit-function-v0"
    [(lower/encode-typed-function
       (lower/typedfunctionv0-id function)
       (lower/typedfunctionv0-name function)
       (lower/typedfunctionv0-abi-symbol function)
       (lower/typedfunctionv0-parameters function)
       (lower/typedfunctionv0-return-type function)
       (lower/typedfunctionv0-failure-type function)
       (lower/typedfunctionv0-effects function)
       (lower/readiness-code (lower/typedfunctionv0-readiness function)))
     (encode-readiness (lower/typedfunctionv0-readiness function))]))

(defn encode-unit-contract-value
  [unit-id core/NativeId
   qualified-name String
   visibility String
   parameter-types (Vec core/NativeId)
   return-type core/NativeId
   failure-type core/NativeId
   generated-bindings (Vec String)] String
  (stages/canonical-record "unit-contract-v0"
    [(id-value unit-id)
     qualified-name
     visibility
     (encode-id-vector "parameter-types" parameter-types)
     (id-value return-type)
     (id-value failure-type)
     (stages/canonical-set "generated-bindings" generated-bindings)]))

(defn make-unit-contract
  [unit-id core/NativeId
   qualified-name String
   visibility String
   function lower/TypedFunctionV0] UnitContractV0
  (let [parameter-types (Vec core/NativeId) (mapv (fn [parameter core/Parameter] core/NativeId
                (core/parameter-type-id parameter))
          (lower/typedfunctionv0-parameters function))
        generated-bindings (Vec String) []
        encoding String (encode-unit-contract-value unit-id qualified-name visibility
          parameter-types
          (lower/typedfunctionv0-return-type function)
          (lower/typedfunctionv0-failure-type function)
          generated-bindings)]
    (->UnitContractV0 unit-id qualified-name visibility parameter-types
      (lower/typedfunctionv0-return-type function)
      (lower/typedfunctionv0-failure-type function)
      generated-bindings encoding (stages/content-digest encoding))))

(defn encode-parameter-wire-v1 [parameter core/Parameter] String
  (stages/canonical-record "parameter-wire-v1"
    [(stages/encode-id (core/parameter-id parameter))
     (stages/encode-id (core/parameter-type-id parameter))]))

(defn encode-parameters-wire-v1 [parameters (Vec core/Parameter)] String
  (stages/canonical-record "parameters-wire-v1"
    (mapv encode-parameter-wire-v1 parameters)))

(defn encode-ssa-value-wire-v1 [value core/SsaValueV0] String
  (stages/canonical-record "ssa-value-wire-v1"
    [(stages/encode-id (core/ssavaluev0-id value))
     (stages/encode-id (core/ssavaluev0-type-id value))]))

(defn encode-native-atom-wire-v1 [atom core/NativeAtom] String
  (if (instance? native.core.I64Atom atom)
    (stages/canonical-record "i64-atom-wire-v1"
      [(stages/encode-int (core/i64atom-value atom))])
    (stages/canonical-record "unsupported-atom-wire-v1" [])))

(defn encode-resource-token-kind-wire-v1 [kind core/ResourceTokenKindV0] String
  (cond
    (instance? native.core.RegionTokenV0 kind)
    (stages/canonical-record "region-token-kind-wire-v1"
      [(stages/encode-id (core/regiontokenv0-region kind))])

    (instance? native.core.CapabilityTokenV0 kind)
    (stages/canonical-record "capability-token-kind-wire-v1"
      [(stages/encode-id (core/capabilitytokenv0-capability kind))])

    :else (stages/canonical-record "unsupported-token-kind-wire-v1" [])))

(defn encode-resource-token-wire-v1 [token core/ResourceTokenV0] String
  (stages/canonical-record "resource-token-wire-v1"
    [(stages/encode-id (core/resourcetokenv0-id token))
     (encode-resource-token-kind-wire-v1
       (core/resourcetokenv0-kind token))]))

(defn encode-token-flow-wire-v1 [flow core/TokenFlowV0] String
  (stages/canonical-record "token-flow-wire-v1"
    [(encode-wire-id-vector "consumed-token-ids-wire-v1"
       (core/tokenflowv0-consumed flow))
     (stages/canonical-record "produced-tokens-wire-v1"
       (mapv encode-resource-token-wire-v1
         (core/tokenflowv0-produced flow)))]))

(defn encode-switch-case-wire-v1 [switch-case core/SwitchCaseV0] String
  (stages/canonical-record "switch-case-wire-v1"
    [(stages/encode-id (core/switchcasev0-variant-id switch-case))
     (stages/encode-id (core/switchcasev0-block-id switch-case))
     (encode-wire-id-vector "switch-arguments-wire-v1"
       (core/switchcasev0-arguments switch-case))]))

(defn encode-instruction-wire-v1 [instruction core/Instruction] String
  (cond
    (instance? native.core.AtomInstruction instruction)
    (stages/canonical-record "atom-instruction-wire-v1"
      [(encode-ssa-value-wire-v1 (core/atominstruction-result instruction))
       (encode-native-atom-wire-v1 (core/atominstruction-atom instruction))])

    (instance? native.core.CallInstruction instruction)
    (stages/canonical-record "call-instruction-wire-v1"
      [(encode-ssa-value-wire-v1 (core/callinstruction-result instruction))
       (stages/encode-id (core/callinstruction-function-id instruction))
       (encode-wire-id-vector "call-arguments-wire-v1"
         (core/callinstruction-arguments instruction))
       (encode-wire-optional-id (core/callinstruction-arena-id instruction))
       (encode-token-flow-wire-v1 (core/callinstruction-tokens instruction))])

    (instance? native.core.CheckedInstruction instruction)
    (let [operation core/CheckedOperationV0 (core/checkedinstruction-operation instruction)
          result String (encode-ssa-value-wire-v1 (core/checkedinstruction-result instruction))]
      (cond
        (instance? native.core.CheckedAddI64V0 operation)
        (stages/canonical-record "checked-add-i64-instruction-wire-v1"
          [result
           (stages/encode-id (core/checkedaddi64v0-left-id operation))
           (stages/encode-id (core/checkedaddi64v0-right-id operation))])

        (instance? native.core.CheckedMulI64V0 operation)
        (stages/canonical-record "checked-mul-i64-instruction-wire-v1"
          [result
           (stages/encode-id (core/checkedmuli64v0-left-id operation))
           (stages/encode-id (core/checkedmuli64v0-right-id operation))])

        :else
        (stages/canonical-record "unsupported-checked-instruction-wire-v1" [])))

    (instance? native.core.VariantValueInstruction instruction)
    (stages/canonical-record "variant-value-instruction-wire-v1"
      [(encode-ssa-value-wire-v1
         (core/variantvalueinstruction-result instruction))
       (stages/encode-id (core/variantvalueinstruction-source-id instruction))
       (stages/encode-id (core/variantvalueinstruction-variant-id instruction))])

    :else (stages/canonical-record "unsupported-instruction-wire-v1" [])))

(defn encode-terminator-wire-v1 [terminator core/Terminator] String
  (cond
    (instance? native.core.ReturnTerminator terminator)
    (stages/canonical-record "return-terminator-wire-v1"
      [(encode-wire-optional-id (core/returnterminator-value terminator))])

    (instance? native.core.SwitchTerminator terminator)
    (stages/canonical-record "switch-terminator-wire-v1"
      [(stages/encode-id (core/switchterminator-value-id terminator))
       (stages/canonical-record "switch-cases-wire-v1"
         (mapv encode-switch-case-wire-v1
           (core/switchterminator-cases terminator)))])

    (instance? native.core.TrapTerminator terminator)
    (stages/canonical-record "trap-terminator-wire-v1"
      [(stages/encode-id (core/trapterminator-failure-id terminator))])

    :else (stages/canonical-record "unsupported-terminator-wire-v1" [])))

(defn encode-basic-block-wire-v1 [block core/BasicBlock] String
  (stages/canonical-record "basic-block-wire-v1"
    [(stages/encode-id (core/basicblock-id block))
     (encode-parameters-wire-v1 (core/basicblock-parameters block))
     (stages/canonical-record "instructions-wire-v1"
       (mapv encode-instruction-wire-v1
         (core/basicblock-instructions block)))
     (stages/canonical-record "terminators-wire-v1"
       (mapv encode-terminator-wire-v1
         (core/basicblock-terminators block)))]))

(defn encode-readiness-wire-v1 [readiness lower/NativeReadinessV0] String
  (if (instance? native.lower.NativeLoweredV0 readiness)
    (stages/canonical-record "lowered-readiness-wire-v1"
      [(stages/encode-id (lower/nativeloweredv0-entry-block readiness))
       (stages/canonical-record "blocks-wire-v1"
         (mapv encode-basic-block-wire-v1
           (lower/nativeloweredv0-blocks readiness)))])
    (stages/canonical-record "unsupported-readiness-wire-v1" [])))

(defn encode-typed-function-wire-v1 [function lower/TypedFunctionV0] String
  (stages/canonical-record "typed-function-wire-v1"
    [(stages/encode-id (lower/typedfunctionv0-id function))
     (stages/encode-string (lower/typedfunctionv0-name function))
     (stages/encode-string (lower/typedfunctionv0-abi-symbol function))
     (encode-parameters-wire-v1 (lower/typedfunctionv0-parameters function))
     (stages/encode-id (lower/typedfunctionv0-return-type function))
     (stages/encode-id (lower/typedfunctionv0-failure-type function))
     (encode-wire-id-vector "typed-function-effects-wire-v1"
       (lower/typedfunctionv0-effects function))
     (encode-readiness-wire-v1 (lower/typedfunctionv0-readiness function))]))

(defn encode-type-variant-wire-v1 [variant core/TypeVariant] String
  (stages/canonical-record "type-variant-wire-v1"
    [(stages/encode-id (core/typevariant-id variant))
     (stages/encode-string (core/typevariant-name variant))
     (encode-wire-optional-id (core/typevariant-payload-type variant))]))

(defn encode-type-shape-wire-v1 [shape core/TypeShape] String
  (cond
    (instance? native.core.AtomType shape)
    (let [kind core/AtomKind (core/atomtype-kind shape)]
      (if (instance? native.core.I64Kind kind)
        (stages/canonical-record "i64-atom-type-wire-v1"
          [(encode-wire-bool (core/i64kind-token kind))])
        (stages/canonical-record "unsupported-type-shape-wire-v1" [])))

    (instance? native.core.UnionType shape)
    (stages/canonical-record "closed-union-type-wire-v1"
      (mapv encode-type-variant-wire-v1 (core/uniontype-variants shape)))

    (instance? native.core.OutcomeType shape)
    (stages/canonical-record "outcome-type-wire-v1"
      [(stages/encode-id (core/outcometype-value-type shape))
       (stages/encode-id (core/outcometype-failure-type shape))])

    :else (stages/canonical-record "unsupported-type-shape-wire-v1" [])))

(defn encode-type-def-wire-v1 [definition core/TypeDef] String
  (stages/canonical-record "type-def-wire-v1"
    [(stages/encode-id (core/typedef-id definition))
     (stages/encode-string (core/typedef-name definition))
     (encode-type-shape-wire-v1 (core/typedef-shape definition))]))

(defn encode-effect-wire-v1 [effect core/EffectDef] String
  (let [kind core/EffectKind (core/effectdef-kind effect)]
    (if (instance? native.core.PureEffect kind)
      (stages/canonical-record "pure-effect-wire-v1"
        [(stages/encode-id (core/effectdef-id effect))
         (encode-wire-bool (core/pureeffect-token kind))])
      (stages/canonical-record "unsupported-effect-wire-v1" []))))

(defn encode-scalar-representation-wire-v1 [representation core/ScalarReprV0] String
  (cond
    (instance? native.core.SignedIntReprV0 representation)
    (stages/canonical-record "signed-int-representation-wire-v1"
      [(stages/encode-int
         (core/signedintreprv0-bit-width representation))])

    (instance? native.core.UnsignedIntReprV0 representation)
    (stages/canonical-record "unsigned-int-representation-wire-v1"
      [(stages/encode-int
         (core/unsignedintreprv0-bit-width representation))])

    :else (stages/canonical-record "unsupported-scalar-wire-v1" [])))

(defn encode-union-variant-layout-wire-v1 [variant core/UnionVariantLayoutV0] String
  (stages/canonical-record "union-variant-layout-wire-v1"
    [(stages/encode-id (core/unionvariantlayoutv0-variant-id variant))
     (stages/encode-int (core/unionvariantlayoutv0-tag variant))
     (encode-wire-optional-id
       (core/unionvariantlayoutv0-payload-type variant))
     (stages/encode-int
       (core/unionvariantlayoutv0-payload-offset-bytes variant))]))

(defn encode-layout-shape-wire-v1 [shape core/LayoutShapeV0] String
  (cond
    (instance? native.core.ScalarShapeV0 shape)
    (stages/canonical-record "scalar-layout-shape-wire-v1"
      [(encode-scalar-representation-wire-v1
         (core/scalarshapev0-representation shape))])

    (instance? native.core.UnionShapeV0 shape)
    (stages/canonical-record "union-layout-shape-wire-v1"
      [(stages/encode-id (core/unionshapev0-tag-type shape))
       (stages/encode-int (core/unionshapev0-tag-offset-bytes shape))
       (stages/canonical-record "union-variant-layouts-wire-v1"
         (mapv encode-union-variant-layout-wire-v1
           (core/unionshapev0-variants shape)))])

    :else (stages/canonical-record "unsupported-layout-shape-wire-v1" [])))

(defn encode-layout-def-wire-v1 [layout core/LayoutDef] String
  (stages/canonical-record "layout-def-wire-v1"
    [(stages/encode-id (core/layoutdef-id layout))
     (stages/encode-id (core/layoutdef-type-id layout))
     (stages/encode-int (core/layoutdef-size-bytes layout))
     (stages/encode-int (core/layoutdef-align-bytes layout))
     (encode-layout-shape-wire-v1 (core/layoutdef-shape layout))]))

(defn encode-ownership-wire-v1 [ownership core/OwnershipRuleV0] String
  (cond
    (instance? native.core.BorrowedV0 ownership)
    (stages/canonical-record "borrowed-ownership-wire-v1"
      [(encode-wire-bool (core/borrowedv0-token ownership))])

    (instance? native.core.OwnedV0 ownership)
    (stages/canonical-record "owned-ownership-wire-v1"
      [(encode-wire-bool (core/ownedv0-token ownership))])

    :else (stages/canonical-record "unsupported-ownership-wire-v1" [])))

(defn encode-abi-value-wire-v1 [value core/AbiValueV0] String
  (stages/canonical-record "abi-value-wire-v1"
    [(stages/encode-string (core/abivaluev0-name value))
     (stages/encode-id (core/abivaluev0-type-id value))
     (encode-ownership-wire-v1 (core/abivaluev0-ownership value))
     (encode-wire-optional-id (core/abivaluev0-lifetime-region value))]))

(defn encode-optional-abi-value-wire-v1 [value (U core/AbiValueV0 Nil)] String
  (if (nil? value)
    (stages/canonical-record "none" [])
    (stages/canonical-record "some" [(encode-abi-value-wire-v1 value)])))

(defn encode-abi-wire-v1 [abi core/AbiDeclV0] String
  (let [direction core/AbiDirectionV0 (core/abideclv0-direction abi)
        convention core/AbiConventionV0 (core/abideclv0-convention abi)]
    (stages/canonical-record "abi-declaration-wire-v1"
      [(stages/encode-id (core/abideclv0-id abi))
       (stages/encode-id (core/abideclv0-function-id abi))
       (stages/encode-string (core/abideclv0-symbol abi))
       (if (instance? native.core.AbiExportV0 direction)
         (stages/canonical-record "abi-export-wire-v1"
           [(encode-wire-bool (core/abiexportv0-token direction))])
         (stages/canonical-record "unsupported-abi-direction-wire-v1" []))
       (if (instance? native.core.RestrictedCAbiV0 convention)
         (stages/canonical-record "restricted-c-abi-wire-v1"
           [(encode-wire-bool (core/restrictedcabiv0-token convention))])
         (stages/canonical-record "unsupported-abi-convention-wire-v1" []))
       (stages/canonical-record "abi-parameters-wire-v1"
         (mapv encode-abi-value-wire-v1 (core/abideclv0-parameters abi)))
       (encode-optional-abi-value-wire-v1 (core/abideclv0-result abi))
       (stages/encode-id (core/abideclv0-failure-type abi))
       (encode-wire-id-vector "abi-effects-wire-v1"
         (core/abideclv0-required-effects abi))
       (encode-wire-id-vector "abi-capabilities-wire-v1"
         (core/abideclv0-required-capabilities abi))
       (stages/encode-string (core/abideclv0-version abi))
       (stages/encode-string (core/abideclv0-layout-digest abi))])))

(defn encode-native-function-wire-v1 [function core/FunctionDef] String
  (stages/canonical-record "native-function-wire-v1"
    [(stages/encode-id (core/functiondef-id function))
     (stages/encode-string (core/functiondef-name function))
     (encode-parameters-wire-v1 (core/functiondef-parameters function))
     (stages/canonical-record "blocks-wire-v1"
       (mapv encode-basic-block-wire-v1 (core/functiondef-blocks function)))
     (stages/encode-id (core/functiondef-entry-block function))
     (encode-wire-optional-id (core/functiondef-return-type function))
     (encode-wire-id-vector "native-function-effects-wire-v1"
       (core/functiondef-effects function))
     (encode-wire-id-vector "native-function-regions-wire-v1"
       (core/functiondef-regions function))
     (encode-wire-id-vector "native-function-capabilities-wire-v1"
       (core/functiondef-capabilities function))]))

(defn decode-parameter-wire-v1 [encoding String] (U core/Parameter Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "parameter-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            type-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))]
        (if (and (some? identity) (some? type-id))
          (core/->Parameter identity type-id) nil)))))

(defn decode-parameters-wire-v1 [encoding String] (U (Vec core/Parameter) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "parameters-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/Parameter) []]
        (if (>= position (count fields))
          values
          (let [value (U core/Parameter Nil) (decode-parameter-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-ssa-value-wire-v1 [encoding String] (U core/SsaValueV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "ssa-value-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            type-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))]
        (if (and (some? identity) (some? type-id))
          (core/->SsaValueV0 identity type-id) nil)))))

(defn decode-native-atom-wire-v1 [encoding String] (U core/NativeAtom Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "i64-atom-wire-v1" 1)]
    (if (nil? record)
      nil
      (let [value (U Int Nil) (decode-wire-int (nth (wirerecordv1-fields record) 0))]
        (if (some? value) (core/->I64Atom value) nil)))))

(defn decode-resource-token-kind-wire-v1 [encoding String] (U core/ResourceTokenKindV0 Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)]
        (cond
          (and (= "region-token-kind-wire-v1" (wirerecordv1-tag record))
            (= 1 (count fields)))
          (let [identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))]
            (if (some? identity) (core/->RegionTokenV0 identity) nil))

          (and (= "capability-token-kind-wire-v1" (wirerecordv1-tag record))
            (= 1 (count fields)))
          (let [identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))]
            (if (some? identity) (core/->CapabilityTokenV0 identity) nil))

          :else nil)))))

(defn decode-resource-token-wire-v1 [encoding String] (U core/ResourceTokenV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "resource-token-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            kind (U core/ResourceTokenKindV0 Nil) (decode-resource-token-kind-wire-v1 (nth fields 1))]
        (if (and (some? identity) (some? kind))
          (core/->ResourceTokenV0 identity kind) nil)))))

(defn decode-resource-tokens-wire-v1 [encoding String] (U (Vec core/ResourceTokenV0) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "produced-tokens-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/ResourceTokenV0) []]
        (if (>= position (count fields))
          values
          (let [value (U core/ResourceTokenV0 Nil) (decode-resource-token-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-token-flow-wire-v1 [encoding String] (U core/TokenFlowV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "token-flow-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            consumed (U (Vec core/NativeId) Nil) (decode-wire-id-vector (nth fields 0) "consumed-token-ids-wire-v1")
            produced (U (Vec core/ResourceTokenV0) Nil) (decode-resource-tokens-wire-v1 (nth fields 1))]
        (if (and (some? consumed) (some? produced))
          (core/->TokenFlowV0 consumed produced) nil)))))

(defn decode-switch-case-wire-v1 [encoding String] (U core/SwitchCaseV0 Nil)
