            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-readiness-wire-v1 [encoding String] (U lower/NativeReadinessV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "lowered-readiness-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            entry-block (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            blocks (U (Vec core/BasicBlock) Nil) (decode-blocks-wire-v1 (nth fields 1))]
        (if (and (some? entry-block) (some? blocks))
          (lower/->NativeLoweredV0 entry-block blocks) nil)))))

(defn decode-typed-function-wire-v1 [encoding String] (U lower/TypedFunctionV0 Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "typed-function-wire-v1" 8)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            name (U String Nil) (decode-wire-string (nth fields 1))
            abi-symbol (U String Nil) (decode-wire-string (nth fields 2))
            parameters (U (Vec core/Parameter) Nil) (decode-parameters-wire-v1 (nth fields 3))
            return-type (U core/NativeId Nil) (decode-wire-id (nth fields 4))
            failure-type (U core/NativeId Nil) (decode-wire-id (nth fields 5))
            effects (U (Vec core/NativeId) Nil) (decode-wire-id-vector
              (nth fields 6) "typed-function-effects-wire-v1")
            readiness (U lower/NativeReadinessV0 Nil) (decode-readiness-wire-v1 (nth fields 7))]
        (if (and (some? identity) (some? name) (some? abi-symbol)
              (some? parameters) (some? return-type) (some? failure-type)
              (some? effects) (some? readiness))
          (lower/->TypedFunctionV0 identity name abi-symbol parameters
            return-type failure-type effects readiness
            (lower/encode-typed-function identity name abi-symbol parameters
              return-type failure-type effects
              (lower/readiness-code readiness)))
          nil)))))

(defn canonical-set-wire-record
  [encoding String
   tag String] (U WireRecordV1 Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding tag)]
    (if (and (some? record)
          (sorted-distinct-fields? (wirerecordv1-fields record)))
      record nil)))

(defn decode-type-variant-wire-v1 [encoding String] (U core/TypeVariant Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "type-variant-wire-v1" 3)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            name (U String Nil) (decode-wire-string (nth fields 1))
            payload (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 2))]
        (if (and (some? identity) (some? name) (some? payload))
          (core/->TypeVariant identity name (optional-wire-id-value payload))
          nil)))))

(defn decode-type-variants-wire-v1 [fields (Vec String)] (U (Vec core/TypeVariant) Nil)
  (loop [position Int 0
         values (Vec core/TypeVariant) []]
    (if (>= position (count fields))
      values
      (let [value (U core/TypeVariant Nil) (decode-type-variant-wire-v1 (nth fields position))]
        (if (nil? value) nil
          (recur (+ position 1) (conj values value)))))))

(defn decode-type-shape-wire-v1 [encoding String] (U core/TypeShape Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            tag String (wirerecordv1-tag record)]
        (cond
          (and (= tag "i64-atom-type-wire-v1") (= 1 (count fields)))
          (let [token (U Bool Nil) (decode-wire-bool (nth fields 0))]
            (if (some? token)
              (core/->AtomType (core/->I64Kind token)) nil))

          (= tag "closed-union-type-wire-v1")
          (let [variants (U (Vec core/TypeVariant) Nil) (decode-type-variants-wire-v1 fields)]
            (if (some? variants) (core/->UnionType variants) nil))

          (and (= tag "outcome-type-wire-v1") (= 2 (count fields)))
          (let [value-type (U core/NativeId Nil) (decode-wire-id (nth fields 0))
                failure-type (U core/NativeId Nil) (decode-wire-id (nth fields 1))]
            (if (and (some? value-type) (some? failure-type))
              (core/->OutcomeType value-type failure-type) nil))

          :else nil)))))

