    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            variant-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            block-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
            arguments (U (Vec core/NativeId) Nil) (decode-wire-id-vector (nth fields 2) "switch-arguments-wire-v1")]
        (if (and (some? variant-id) (some? block-id) (some? arguments))
          (core/->SwitchCaseV0 variant-id block-id arguments) nil)))))

(defn decode-switch-cases-wire-v1 [encoding String] (U (Vec core/SwitchCaseV0) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "switch-cases-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/SwitchCaseV0) []]
        (if (>= position (count fields))
          values
          (let [value (U core/SwitchCaseV0 Nil) (decode-switch-case-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-terminator-wire-v1 [encoding String] (U core/Terminator Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)]
        (cond
          (and (= "return-terminator-wire-v1" (wirerecordv1-tag record))
            (= 1 (count fields)))
          (let [value (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 0))]
            (if (nil? value) nil
              (core/->ReturnTerminator (optional-wire-id-value value))))

          (and (= "switch-terminator-wire-v1" (wirerecordv1-tag record))
            (= 2 (count fields)))
          (let [value-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))
                cases (U (Vec core/SwitchCaseV0) Nil) (decode-switch-cases-wire-v1 (nth fields 1))]
            (if (and (some? value-id) (some? cases))
              (core/->SwitchTerminator value-id cases) nil))

          (and (= "trap-terminator-wire-v1" (wirerecordv1-tag record))
            (= 1 (count fields)))
          (let [failure-id (U core/NativeId Nil) (decode-wire-id (nth fields 0))]
            (if (some? failure-id) (core/->TrapTerminator failure-id) nil))

          :else nil)))))

(defn decode-instruction-wire-v1 [encoding String] (U core/Instruction Nil)
  (let [record (U WireRecordV1 Nil) (parse-wire-record encoding)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            tag String (wirerecordv1-tag record)]
        (cond
          (and (= tag "atom-instruction-wire-v1") (= 2 (count fields)))
          (let [result (U core/SsaValueV0 Nil) (decode-ssa-value-wire-v1 (nth fields 0))
                atom (U core/NativeAtom Nil) (decode-native-atom-wire-v1 (nth fields 1))]
            (if (and (some? result) (some? atom))
              (core/->AtomInstruction result atom) nil))

          (and (= tag "call-instruction-wire-v1") (= 5 (count fields)))
          (let [result (U core/SsaValueV0 Nil) (decode-ssa-value-wire-v1 (nth fields 0))
                function-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
                arguments (U (Vec core/NativeId) Nil) (decode-wire-id-vector (nth fields 2) "call-arguments-wire-v1")
                arena (U (Vec core/NativeId) Nil) (decode-wire-optional-id (nth fields 3))
                tokens (U core/TokenFlowV0 Nil) (decode-token-flow-wire-v1 (nth fields 4))]
            (if (and (some? result) (some? function-id) (some? arguments)
                  (some? arena) (some? tokens))
              (core/->CallInstruction result function-id arguments
                (optional-wire-id-value arena) tokens)
              nil))

          (and (= tag "checked-add-i64-instruction-wire-v1")
            (= 3 (count fields)))
          (let [result (U core/SsaValueV0 Nil) (decode-ssa-value-wire-v1 (nth fields 0))
                left-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
                right-id (U core/NativeId Nil) (decode-wire-id (nth fields 2))]
            (if (and (some? result) (some? left-id) (some? right-id))
              (core/->CheckedInstruction result
                (core/->CheckedAddI64V0 left-id right-id)) nil))

          (and (= tag "checked-mul-i64-instruction-wire-v1")
            (= 3 (count fields)))
          (let [result (U core/SsaValueV0 Nil) (decode-ssa-value-wire-v1 (nth fields 0))
                left-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
                right-id (U core/NativeId Nil) (decode-wire-id (nth fields 2))]
            (if (and (some? result) (some? left-id) (some? right-id))
              (core/->CheckedInstruction result
                (core/->CheckedMulI64V0 left-id right-id)) nil))

          (and (= tag "variant-value-instruction-wire-v1")
            (= 3 (count fields)))
          (let [result (U core/SsaValueV0 Nil) (decode-ssa-value-wire-v1 (nth fields 0))
                source-id (U core/NativeId Nil) (decode-wire-id (nth fields 1))
                variant-id (U core/NativeId Nil) (decode-wire-id (nth fields 2))]
            (if (and (some? result) (some? source-id) (some? variant-id))
              (core/->VariantValueInstruction result source-id variant-id) nil))

          :else nil)))))

(defn decode-instructions-wire-v1 [encoding String] (U (Vec core/Instruction) Nil)
  (let [record (U WireRecordV1 Nil) (wire-record-with-tag encoding "instructions-wire-v1")]
    (if (nil? record)
      nil
      (loop [position Int 0
             fields (Vec String) (wirerecordv1-fields record)
             values (Vec core/Instruction) []]
        (if (>= position (count fields))
          values
          (let [value (U core/Instruction Nil) (decode-instruction-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-terminators-wire-v1 [encoding String] (U (Vec core/Terminator) Nil)
