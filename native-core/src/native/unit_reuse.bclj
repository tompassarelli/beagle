    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            parameters (U (Vec core/Parameter) Nil) (decode-parameters-wire-v1 (nth fields 1))
            instructions (U (Vec core/Instruction) Nil) (decode-instructions-wire-v1 (nth fields 2))
            terminators (U (Vec core/Terminator) Nil) (decode-terminators-wire-v1 (nth fields 3))]
        (if (and (some? identity) (some? parameters)
              (some? instructions) (some? terminators))
          (core/->BasicBlock identity parameters instructions terminators) nil)))))

(defn decode-blocks-wire-v1 [encoding String] (U (Vec core/BasicBlock) Nil)
