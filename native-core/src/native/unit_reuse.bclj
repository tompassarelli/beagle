          (let [value (U core/TypeDef Nil) (decode-type-def-wire-v1 (nth fields position))]
            (if (nil? value) nil
              (recur (+ position 1) fields (conj values value)))))))))

(defn decode-effect-wire-v1 [encoding String] (U core/EffectDef Nil)
  (let [record (U WireRecordV1 Nil) (required-wire-record encoding "pure-effect-wire-v1" 2)]
    (if (nil? record)
      nil
      (let [fields (Vec String) (wirerecordv1-fields record)
            identity (U core/NativeId Nil) (decode-wire-id (nth fields 0))
            token (U Bool Nil) (decode-wire-bool (nth fields 1))]
        (if (and (some? identity) (some? token))
          (core/->EffectDef identity (core/->PureEffect token)) nil)))))

(defn decode-effects-wire-v1 [encoding String] (U (Vec core/EffectDef) Nil)
