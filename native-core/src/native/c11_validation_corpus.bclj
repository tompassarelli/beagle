#lang beagle/clj
(ns native.c11-validation-corpus)


(require native.core :as core)
(require native.c11 :as c11)
(require native.lower :as lower)
(require native.obligations :as obligations)
(require native.stages :as stages)

(defn fixture-id [name String] core/NativeId
  (core/canonical-id "native-c11-fixture-v0" [name]))

(def fixture-i64-type core/TypeDef
  (core/->TypeDef (fixture-id "type-00-i64") "I64"
    (core/atom-type-shape (core/i64-kind))))

(def fixture-left-field core/TypeField
  (core/->TypeField (fixture-id "field-00-left") "left" (fixture-id "type-00-i64")))

(def fixture-right-field core/TypeField
  (core/->TypeField (fixture-id "field-01-right") "right" (fixture-id "type-00-i64")))

(def fixture-pair-type core/TypeDef
  (core/->TypeDef (fixture-id "type-01-pair") "Pair"
    (core/->RecordType [fixture-left-field fixture-right-field])))

(def fixture-region core/RegionDef
  (core/->RegionDef (fixture-id "region-arena") (core/arena-region-kind) nil))

(def fixture-capability core/CapabilityDef
  (core/->CapabilityDef (fixture-id "capability-allocate")
    (core/->AllocateCapability true)
    (fixture-id "region-arena")
    true))

(def fixture-effect core/EffectDef
  (core/->EffectDef (fixture-id "effect-allocate")
    (core/->AllocateEffect (fixture-id "region-arena"))))

(def fixture-i64-layout core/LayoutDef
  (core/->LayoutDef (fixture-id "layout-00-i64") (fixture-id "type-00-i64") 8 8
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(def fixture-pair-layout core/LayoutDef
  (core/->LayoutDef (fixture-id "layout-01-pair") (fixture-id "type-01-pair") 16 8
    (core/->RecordShapeV0
      [(core/->FieldLayoutV0 (fixture-id "field-00-left") (fixture-id "type-00-i64") 0 8)
       (core/->FieldLayoutV0 (fixture-id "field-01-right") (fixture-id "type-00-i64") 8 8)])))

(def fixture-block core/BasicBlock
  (core/->BasicBlock (fixture-id "block-entry")
    []
    [(core/->CheckedInstruction
       (core/->SsaValueV0 (fixture-id "ssa-sum") (fixture-id "type-00-i64"))
       (core/->CheckedAddI64V0 (fixture-id "ssa-left") (fixture-id "ssa-right")))]
    [(core/return-terminator (fixture-id "ssa-sum"))]))

(def fixture-function core/FunctionDef
  (core/->FunctionDef (fixture-id "function-add") "add"
    [(core/->Parameter (fixture-id "ssa-left") (fixture-id "type-00-i64"))
     (core/->Parameter (fixture-id "ssa-right") (fixture-id "type-00-i64"))]
    [fixture-block]
    (fixture-id "block-entry")
    (fixture-id "type-00-i64")
    [(fixture-id "effect-allocate")]
    [(fixture-id "region-arena")]
    [(fixture-id "capability-allocate")]))

(def fixture-program core/NativeCoreProgram
  (core/->NativeCoreProgram (fixture-id "program") nil "native-c11-fixture-v0"
    [fixture-pair-type fixture-i64-type]
    [fixture-effect]
    [fixture-region]
    [fixture-capability]
    [fixture-pair-layout fixture-i64-layout]
    [fixture-function]
    [(fixture-id "effect-allocate")]
    [(fixture-id "region-arena")]
    [(fixture-id "capability-allocate")]
    []
    []))

(def fixture-program-permuted core/NativeCoreProgram
  (with fixture-program
    [:types [fixture-i64-type fixture-pair-type]
     :layouts [fixture-i64-layout fixture-pair-layout]]))

(defn require-artifact [result c11/C11Materialization] c11/C11Artifact
  (match result
    [(C11Success value) (c11/c11success-artifact result)]
    [(C11Failure value) (throw (ex-info (c11/c11failure-detail result) {}))]))

(def fixture-artifact c11/C11Artifact
  (require-artifact (c11/materialize-program fixture-program 0)))

(def fixture-permuted-artifact c11/C11Artifact
  (require-artifact (c11/materialize-program fixture-program-permuted 0)))

(def fixture-deterministic? Bool
  (and (= (c11/c11artifact-header-text fixture-artifact)
         (c11/c11artifact-header-text fixture-permuted-artifact))
    (= (c11/c11artifact-source-text fixture-artifact)
      (c11/c11artifact-source-text fixture-permuted-artifact))))

(def fixture-main-text String
  (str "/* Generated by native.c11-validation-corpus; do not edit. */\n"
    "#include \"module_0.h\"\n\n"
    "int main(void) {\n"
    "  uint8_t storage[64];\n"
    "  native_arena arena;\n"
    "  native_capability capability = { UINT64_C(1) };\n"
    "  native_arena_init(&arena, storage, sizeof(storage));\n"
    "  if (native_m0_fn_0(&arena, &capability, INT64_C(20), INT64_C(22)) != INT64_C(42)) {\n"
    "    return 1;\n"
    "  }\n"
    "  int64_t *slot = native_arena_alloc(&arena, sizeof(*slot), _Alignof(int64_t));\n"
    "  *slot = INT64_C(42);\n"
    "  if (*slot != INT64_C(42)) {\n"
    "    return 2;\n"
    "  }\n"
    "  FILE *stream = tmpfile();\n"
    "  if (stream == NULL) {\n"
    "    return 3;\n"
    "  }\n"
    "  uint8_t written[3] = { UINT8_C(1), UINT8_C(2), UINT8_C(3) };\n"
    "  uint8_t read_back[3] = { UINT8_C(0), UINT8_C(0), UINT8_C(0) };\n"
    "  if (!native_byte_write(stream, written, sizeof(written))) {\n"
    "    return 4;\n"
    "  }\n"
    "  rewind(stream);\n"
    "  if (!native_byte_read(stream, read_back, sizeof(read_back))) {\n"
    "    return 5;\n"
    "  }\n"
    "  if (fclose(stream) != 0) {\n"
    "    return 6;\n"
    "  }\n"
    "  if ((read_back[0] != written[0]) || (read_back[1] != written[1]) || (read_back[2] != written[2])) {\n"
    "    return 7;\n"
    "  }\n"
    "  native_arena_reset(&arena);\n"
    "  return 0;\n"
    "}\n"))

(defn emit-fixture! [directory String] Nil
  (if fixture-deterministic?
    (do
      (spit (str directory "/" (c11/c11artifact-header-name fixture-artifact))
        (c11/c11artifact-header-text fixture-artifact))
      (spit (str directory "/" (c11/c11artifact-source-name fixture-artifact))
        (c11/c11artifact-source-text fixture-artifact))
      (spit (str directory "/main.c") fixture-main-text))
    (throw (ex-info "permuted fixture program changed materialization" {}))))

(defn require-fold-lowered-program [result lower/FixturePipelineResultV0] core/NativeCoreProgram
  (if (instance? native.lower.FixturePipelineCompleteV0 result)
    (lower/epoch-identity-program
      (lower/fixturepipelinecompletev0-frozen result)
      "c11-validation-corpus-v0" ["profile=3"] (core/abi-profile-lp64))
    (throw (ex-info "fold empty-input specialization did not lower" {}))))

(def fold-lowered-program core/NativeCoreProgram
  (require-fold-lowered-program lower/fold-empty-result))

(defn fold-reachable-type? [definition core/TypeDef] Bool
  (or (= "I64" (core/typedef-name definition))
    (= "Unit" (core/typedef-name definition))
    (= "UnionTag" (core/typedef-name definition))
    (= "LowerFailure" (core/typedef-name definition))))

(def fold-types (Vec core/TypeDef)
  (filterv fold-reachable-type? (core/nativecoreprogram-types fold-lowered-program)))

(def fold-layouts (Vec core/LayoutDef)
  (filterv
    (fn [layout core/LayoutDef] Bool
      (some?
        (some
          (fn [definition core/TypeDef] Bool
            (core/native-id=
              (core/layoutdef-type-id layout)
              (core/typedef-id definition)))
          fold-types)))
    (core/nativecoreprogram-layouts fold-lowered-program)))

(def fold-function core/FunctionDef
  (nth (core/nativecoreprogram-functions fold-lowered-program) 0))

(def fold-effects (Vec core/EffectDef)
  (filterv
    (fn [effect core/EffectDef] Bool
      (core/id-in? (core/functiondef-effects fold-function)
        (core/effectdef-id effect)))
    (core/nativecoreprogram-effects fold-lowered-program)))

(def fold-program core/NativeCoreProgram
  (core/->NativeCoreProgram
    (fixture-id "fold-program-reachable")
    nil
    "fold-reachable-fast-path-v0"
    fold-types
    fold-effects
    []
    []
    fold-layouts
    [fold-function]
    (core/functiondef-effects fold-function)
    []
    []
    (core/nativecoreprogram-abis fold-lowered-program)
    []))

(def fold-obligation-verdicts (Vec obligations/ObligationVerdictV0)
  [(obligations/valid-ssa fold-program)
   (obligations/exhaustive-matches fold-program)
   (obligations/closed-layouts fold-program (core/abi-profile-lp64))
   (obligations/checked-arithmetic fold-program)
   (obligations/legal-abi fold-program)
   (obligations/discharged-tokens fold-program)
   (obligations/bounded-effects fold-program)
   (obligations/epoch-soundness fold-program)
   (obligations/leak-freedom fold-program)])

(def fold-obligations-pass? Bool
  (every? obligations/obligation-passed? fold-obligation-verdicts))

(def fold-artifact c11/C11Artifact
  (require-artifact (c11/materialize-program fold-program 7)))

(def fold-main-text String
  (str "/* Generated by native.c11-validation-corpus; do not edit. */\n"
    "#include \"module_7.h\"\n\n"
    "int main(void) {\n"
    "  if (native_m7_fn_0() != INT64_C(0)) {\n"
    "    return 1;\n"
    "  }\n"
    "  return 0;\n"
    "}\n"))

(def fold-obligations-text String
  (c11/join-lines
    ["valid-ssa PASS"
     "exhaustive-matches PASS"
     "closed-layouts PASS"
     "checked-arithmetic PASS"
     "legal-abi PASS"
     "discharged-tokens PASS"
     "bounded-effects PASS"]))

(def fold-pipeline-text String
  (c11/join-lines
    ["module store.fold"
     "source store/src/store/fold.bclj"
     "source-sha256 0c94f11f109b471808f2011ac6209a4709896c601852d79e394d1c323030a6c2"
     "source-freeze PASS"
     "typed-program PASS"
     "native-program PASS"
     "fold-fast-path max-sequence-empty"
     "semantic-differential DEFERRED-STAGE-6"
     "c17-materialization PASS"]))

(defn emit-fold-fixture! [directory String] Nil
  (if (and lower/fold-empty-passes? fold-obligations-pass?)
    (do
      (spit (str directory "/" (c11/c11artifact-header-name fold-artifact))
        (c11/c11artifact-header-text fold-artifact))
      (spit (str directory "/" (c11/c11artifact-source-name fold-artifact))
        (c11/c11artifact-source-text fold-artifact))
      (spit (str directory "/main.c") fold-main-text)
      (spit (str directory "/obligations.txt") fold-obligations-text)
      (spit (str directory "/pipeline.txt") fold-pipeline-text))
    (throw (ex-info "fold obligations did not all pass" {}))))
