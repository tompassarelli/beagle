#lang beagle/clj
(ns native.epoch-validation-corpus)

;; The S4 epoch fixtures: programs whose C the emitters must open, close and
;; promote through, and the negative the epoch-soundness obligation must
;; refuse. Programs are built at the IR level because `promote` has no surface
;; form yet (that is S5) — the types, layouts and ids are the compiler's own,
;; taken from native.lower, so nothing here is a private notion of the IR.
;;
;; Six modules are emitted, and main.c drives all six:
;;   0  probe under DERIVED assignment  — the epoch the stage infers
;;   1  probe under IDENTITY assignment — the same program at epoch-0
;;   2  promote — a young Text copied into the root arena before the close
;;   3  nested — two nested epochs closing LIFO
;;   4  caller/callee under DERIVED assignment — the call rides in the epoch
;;      arena the caller passes (rule E3); the callee's interior trim dies in
;;      the callee's own minted epoch
;;   5  the same pair at epoch-0

(define-mode strict)

(require native.body-c17 :as body)
(require native.core :as core)
(require native.lower :as lower)
(require native.obligations :as obligations)
(require native.stages :as stages)

(defn epoch-id [label: String] -> core/NativeId
  (core/canonical-id "native-epoch-fixture-v0" [label]))

(defn epoch-types [] -> (Vec core/TypeDef)
  [(lower/i64-type) (lower/text-type) (lower/bool-type)
   (lower/arena-handle-type)])

(defn epoch-region-id [] -> core/NativeId (epoch-id "region-epoch-0"))

(defn epoch-inner-region-id [] -> core/NativeId (epoch-id "region-epoch-1"))

(defn epoch-effect-id [] -> core/NativeId (epoch-id "effect-epoch-0"))

(defn epoch-inner-effect-id [] -> core/NativeId (epoch-id "effect-epoch-1"))

(defn root-effect [] -> core/EffectDef
  (core/->EffectDef (lower/allocate-effect-id)
    (core/->AllocateEffect (lower/arena-region-id))))

(defn root-capability [] -> core/CapabilityDef
  (core/->CapabilityDef (lower/allocate-capability-id)
    (core/->AllocateCapability true)
    (lower/arena-region-id)
    true))

(defn root-arena-instruction [label: String] -> core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (epoch-id (str label "-arena"))
      (lower/arena-handle-type-id))
    (lower/arena-region-id)
    (lower/allocate-capability-id)
    (core/->TokenFlowV0
      [(lower/arena-region-id) (lower/allocate-capability-id)] [])))

;; A hand-built epoch open: the shape lower/epoch-rewrite-function mints, so
;; the emitter sees no difference between an inferred and a written epoch.
(defn epoch-open-instruction
  [label: String
   region: core/NativeId
   token: core/NativeId] -> core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (epoch-id label) (lower/arena-handle-type-id))
    region
    (lower/allocate-capability-id)
    (core/->TokenFlowV0 [region]
      [(core/->ResourceTokenV0 token (core/->RegionTokenV0 region))])))

(defn epoch-close-instruction
  [label: String
   arena: core/NativeId
   token: core/NativeId] -> core/Instruction
  (core/->ArenaCloseInstructionV0
    (core/->SsaValueV0 (epoch-id label) (lower/arena-handle-type-id))
    arena
    (core/->TokenFlowV0 [token] [])))

(defn text-literal-instruction [label: String] -> core/Instruction
  (core/->AtomInstruction
    (core/->SsaValueV0 (epoch-id label) (lower/text-type-id))
    (core/->TextAtom "epoch")))

(defn i64-literal-instruction [label: String value: Int] -> core/Instruction
  (core/->AtomInstruction
    (core/->SsaValueV0 (epoch-id label) (lower/int-type-id))
    (core/->I64Atom value)))

;; "epoch" twice: ten bytes, so a copy that shared the source's storage would
;; read freed memory the moment the epoch closes.
(defn concat-instruction
  [label: String
   arena: core/NativeId
   literal: core/NativeId] -> core/Instruction
  (core/->TextConcatInstruction
    (core/->SsaValueV0 (epoch-id label) (lower/text-type-id))
    arena
    [literal literal]))

;; --- Module 0/1: the probe whose allocation the stage proves interior. The
;; concatenated Text reaches only a length read and a branch condition, and a
;; branch condition is not an escape sink, so E1 assigns it a local epoch.

(def probe-function: core/FunctionDef
  (core/->FunctionDef
    (epoch-id "function-probe") "epoch-probe"
    [(core/->Parameter (epoch-id "probe-n") (lower/int-type-id))]
    [(core/->BasicBlock (epoch-id "probe-entry") []
       [(root-arena-instruction "probe")
        (text-literal-instruction "probe-lit")
        (concat-instruction "probe-text" (epoch-id "probe-arena")
          (epoch-id "probe-lit"))
        (core/->TextLengthInstruction
          (core/->SsaValueV0 (epoch-id "probe-len") (lower/int-type-id))
          (epoch-id "probe-text"))
        (i64-literal-instruction "probe-ten" 10)
        (core/->CompareInstruction
          (core/->SsaValueV0 (epoch-id "probe-same") (lower/bool-type-id))
          (core/->CompareEqI64V0 true)
          (epoch-id "probe-len")
          (epoch-id "probe-ten"))]
       [(core/->BranchTerminator (epoch-id "probe-same")
          (epoch-id "probe-ok") (epoch-id "probe-bad"))])
     (core/->BasicBlock (epoch-id "probe-ok") [] []
       [(core/->ReturnTerminator (epoch-id "probe-n"))])
     (core/->BasicBlock (epoch-id "probe-bad") []
       [(i64-literal-instruction "probe-fail" -1)]
       [(core/->ReturnTerminator (epoch-id "probe-fail"))])]
    (epoch-id "probe-entry")
    (lower/int-type-id)
    [(lower/allocate-effect-id)]
    [(lower/arena-region-id)]
    [(lower/allocate-capability-id)]))

;; --- Module 4/5: caller ownership (rule E3). `callee` allocates through a
;; text builtin whose arena is nested inside the operation record; nothing it
;; allocates escapes it, which makes it epoch-safe. Under derived assignment
;; the callee's interior trim is retargeted into a callee-minted epoch (the
;; stage resolves nested arena operands), so the pair mints TWO epochs: the
;; callee's own, and the caller's, which holds the CALL — redirectable only
;; because the callee's summary says so. The call's reclamation still rides
;; on the arena being a per-call operand.

(defn trim-instruction
  [label: String
   arena: core/NativeId
   source: core/NativeId] -> core/Instruction
  (core/->TextBuiltinInstruction
    (core/->SsaValueV0 (epoch-id label) (lower/text-type-id))
    (core/->TextTrimV0 arena source)))

(def callee-function: core/FunctionDef
  (core/->FunctionDef
    (epoch-id "function-callee") "epoch-callee"
    [(core/->Parameter (epoch-id "callee-source") (lower/text-type-id))
     (core/->Parameter (epoch-id "callee-n") (lower/int-type-id))]
    [(core/->BasicBlock (epoch-id "callee-entry") []
       [(root-arena-instruction "callee")
        (trim-instruction "callee-trimmed" (epoch-id "callee-arena")
          (epoch-id "callee-source"))
        (core/->TextLengthInstruction
          (core/->SsaValueV0 (epoch-id "callee-len") (lower/int-type-id))
          (epoch-id "callee-trimmed"))
        (i64-literal-instruction "callee-five" 5)
        (core/->CompareInstruction
          (core/->SsaValueV0 (epoch-id "callee-same") (lower/bool-type-id))
          (core/->CompareEqI64V0 true)
          (epoch-id "callee-len")
          (epoch-id "callee-five"))]
       [(core/->BranchTerminator (epoch-id "callee-same")
          (epoch-id "callee-ok") (epoch-id "callee-bad"))])
     (core/->BasicBlock (epoch-id "callee-ok") [] []
       [(core/->ReturnTerminator (epoch-id "callee-n"))])
     (core/->BasicBlock (epoch-id "callee-bad") []
       [(i64-literal-instruction "callee-fail" -1)]
       [(core/->ReturnTerminator (epoch-id "callee-fail"))])]
    (epoch-id "callee-entry")
    (lower/int-type-id)
    [(lower/allocate-effect-id)]
    [(lower/arena-region-id)]
    [(lower/allocate-capability-id)]))

(def caller-function: core/FunctionDef
  (core/->FunctionDef
    (epoch-id "function-caller") "epoch-caller"
    [(core/->Parameter (epoch-id "caller-n") (lower/int-type-id))]
    [(core/->BasicBlock (epoch-id "caller-entry") []
       [(root-arena-instruction "caller")
        (core/->AtomInstruction
          (core/->SsaValueV0 (epoch-id "caller-lit") (lower/text-type-id))
          (core/->TextAtom "  epoch  "))
        (core/->CallInstruction
          (core/->SsaValueV0 (epoch-id "caller-len") (lower/int-type-id))
          (epoch-id "function-callee")
          [(epoch-id "caller-lit") (epoch-id "caller-n")]
          (epoch-id "caller-arena")
          (core/->TokenFlowV0 [] []))
        (core/->CompareInstruction
          (core/->SsaValueV0 (epoch-id "caller-same") (lower/bool-type-id))
          (core/->CompareEqI64V0 true)
          (epoch-id "caller-len")
          (epoch-id "caller-n"))]
       [(core/->BranchTerminator (epoch-id "caller-same")
          (epoch-id "caller-ok") (epoch-id "caller-bad"))])
     (core/->BasicBlock (epoch-id "caller-ok") [] []
       [(core/->ReturnTerminator (epoch-id "caller-n"))])
     (core/->BasicBlock (epoch-id "caller-bad") []
       [(i64-literal-instruction "caller-fail" -1)]
       [(core/->ReturnTerminator (epoch-id "caller-fail"))])]
    (epoch-id "caller-entry")
    (lower/int-type-id)
    [(lower/allocate-effect-id)]
    [(lower/arena-region-id)]
    [(lower/allocate-capability-id)]))

;; --- Module 2: promote. The young Text is allocated in the epoch, copied
;; into the root arena, and only then is the epoch destroyed; the returned
;; handle must point at the copy.

(def promote-function: core/FunctionDef
  (core/->FunctionDef
    (epoch-id "function-promote") "epoch-promote"
    []
    [(core/->BasicBlock (epoch-id "promote-entry") []
       [(root-arena-instruction "promote")
        (epoch-open-instruction "promote-epoch" (epoch-region-id)
          (epoch-id "promote-token"))
        (text-literal-instruction "promote-lit")
        (concat-instruction "promote-young" (epoch-id "promote-epoch")
          (epoch-id "promote-lit"))
        (core/->PromoteInstructionV0
          (core/->SsaValueV0 (epoch-id "promote-old") (lower/text-type-id))
          (epoch-id "promote-young")
          (lower/text-type-id)
          (epoch-id "promote-arena"))
        (epoch-close-instruction "promote-close" (epoch-id "promote-epoch")
          (epoch-id "promote-token"))]
       [(core/->ReturnTerminator (epoch-id "promote-old"))])]
    (epoch-id "promote-entry")
    (lower/text-type-id)
    [(lower/allocate-effect-id) (epoch-effect-id)]
    [(lower/arena-region-id) (epoch-region-id)]
    [(lower/allocate-capability-id)]))

;; The obligation-8 negative: the SAME function returning the young Text
;; instead of the promoted copy — a reference out of a region this function
;; closed, which is exactly the old-to-young edge obligation 8 exists to
;; refuse.
(def old-young-function: core/FunctionDef
  (with promote-function
    [:id (epoch-id "function-old-young")]
    [:name "epoch-old-young"]
    [:blocks
     [(core/->BasicBlock (epoch-id "promote-entry") []
        [(root-arena-instruction "promote")
         (epoch-open-instruction "promote-epoch" (epoch-region-id)
           (epoch-id "promote-token"))
         (text-literal-instruction "promote-lit")
         (concat-instruction "promote-young" (epoch-id "promote-epoch")
           (epoch-id "promote-lit"))
         (epoch-close-instruction "promote-close" (epoch-id "promote-epoch")
           (epoch-id "promote-token"))]
        [(core/->ReturnTerminator (epoch-id "promote-young"))])]]))

;; --- Module 3: nested epochs. The inner epoch is a child of the outer one,
;; and the closes are LIFO, which is what leak freedom requires and what the
;; emitter must lay out as two independent stack-local arenas.

(def nested-function: core/FunctionDef
  (core/->FunctionDef
    (epoch-id "function-nested") "epoch-nested"
    [(core/->Parameter (epoch-id "nested-n") (lower/int-type-id))]
    [(core/->BasicBlock (epoch-id "nested-entry") []
       [(root-arena-instruction "nested")
        (epoch-open-instruction "nested-outer" (epoch-region-id)
          (epoch-id "nested-outer-token"))
        (epoch-open-instruction "nested-inner" (epoch-inner-region-id)
          (epoch-id "nested-inner-token"))
        (text-literal-instruction "nested-lit")
        (concat-instruction "nested-outer-text" (epoch-id "nested-outer")
          (epoch-id "nested-lit"))
        (concat-instruction "nested-inner-text" (epoch-id "nested-inner")
          (epoch-id "nested-lit"))
        (epoch-close-instruction "nested-inner-close" (epoch-id "nested-inner")
          (epoch-id "nested-inner-token"))
        (epoch-close-instruction "nested-outer-close" (epoch-id "nested-outer")
          (epoch-id "nested-outer-token"))]
       [(core/->ReturnTerminator (epoch-id "nested-n"))])]
    (epoch-id "nested-entry")
    (lower/int-type-id)
    [(lower/allocate-effect-id) (epoch-effect-id) (epoch-inner-effect-id)]
    [(lower/arena-region-id) (epoch-region-id) (epoch-inner-region-id)]
    [(lower/allocate-capability-id)]))

;; --- Programs

(defn epoch-program
  [label: String
   functions: (Vec core/FunctionDef)
   regions: (Vec core/RegionDef)
   effects: (Vec core/EffectDef)] -> core/NativeCoreProgram
  (let [types: (Vec core/TypeDef) (epoch-types)]
    (core/->NativeCoreProgram
      (epoch-id label)
      nil
      "typed-to-native-v0"
      types
      effects
      regions
      [(root-capability)]
      (lower/collect-layouts
        (lower/resolve-layouts types (core/abi-profile-lp64)))
      functions
      (mapv (fn [effect: core/EffectDef] -> core/NativeId
              (core/effectdef-id effect))
        effects)
      (mapv (fn [region: core/RegionDef] -> core/NativeId
              (core/regiondef-id region))
        regions)
      [(lower/allocate-capability-id)]
      []
      [])))

(defn epoch-child-region [region: core/NativeId] -> core/RegionDef
  (core/->RegionDef region (core/->ArenaRegion true) (lower/arena-region-id)))

(def probe-program: core/NativeCoreProgram
  (epoch-program "program-probe" [probe-function] (lower/slice-regions)
    [(root-effect)]))

;; c11/ordered-functions sorts by id, so the caller/callee pair is materialized
;; as a pair and main.c calls whichever index the emitted header gives it; the
;; driver resolves the entry point out of the report rather than guessing.
(def caller-program: core/NativeCoreProgram
  (epoch-program "program-caller" [caller-function callee-function]
    (lower/slice-regions) [(root-effect)]))

(def promote-program: core/NativeCoreProgram
  (epoch-program "program-promote" [promote-function]
    (conj (lower/slice-regions) (epoch-child-region (epoch-region-id)))
    [(root-effect)
     (core/->EffectDef (epoch-effect-id)
       (core/->AllocateEffect (epoch-region-id)))]))

(def old-young-program: core/NativeCoreProgram
  (with promote-program [:functions [old-young-function]]))

(def nested-program: core/NativeCoreProgram
  (epoch-program "program-nested" [nested-function]
    (conj (conj (lower/slice-regions) (epoch-child-region (epoch-region-id)))
      (core/->RegionDef (epoch-inner-region-id) (core/->ArenaRegion true)
        (epoch-region-id)))
    [(root-effect)
     (core/->EffectDef (epoch-effect-id)
       (core/->AllocateEffect (epoch-region-id)))
     (core/->EffectDef (epoch-inner-effect-id)
       (core/->AllocateEffect (epoch-inner-region-id)))]))

;; --- The probe through the stage, under both assignments

(defn frozen-of
  [label: String
   program: core/NativeCoreProgram] -> stages/FrozenNativeStageV0
  (let [root: core/NativeId (epoch-id (str label "-terms"))
        stage: stages/NativeStageV0
        (stages/->NativeStageV0
          (stages/->TermGraphV0 root
            [(stages/->TermNodeV0 root
               (stages/->TextTermV0 "native-stage-v0"))])
          (str "sha256:" label)
          program
          [])
        encoding: String (stages/encode-native-stage stage)]
    (stages/->FrozenNativeStageV0 stage encoding
      (stages/content-digest encoding))))

(defn staged-program
  [result: lower/EpochLoweringResultV0] -> core/NativeCoreProgram
  (stages/nativestagev0-program
    (stages/frozennativestagev0-stage (lower/epoch-result-frozen result))))

(def probe-frozen: stages/FrozenNativeStageV0
  (frozen-of "probe" probe-program))

(def probe-derived-result: lower/EpochLoweringResultV0
  (lower/epoch-derived-stage probe-frozen "epoch-fixture-v0" ["profile=3"]
    (core/abi-profile-lp64)))

(def probe-derived-program: core/NativeCoreProgram
  (staged-program probe-derived-result))

(def probe-identity-program: core/NativeCoreProgram
  (staged-program
    (lower/epoch-identity-stage probe-frozen "epoch-fixture-v0" ["profile=3"]
      (core/abi-profile-lp64))))

(def caller-frozen: stages/FrozenNativeStageV0
  (frozen-of "caller" caller-program))

(def caller-derived-program: core/NativeCoreProgram
  (staged-program
    (lower/epoch-derived-stage caller-frozen "epoch-fixture-v0" ["profile=3"]
      (core/abi-profile-lp64))))

(def caller-identity-program: core/NativeCoreProgram
  (staged-program
    (lower/epoch-identity-stage caller-frozen "epoch-fixture-v0" ["profile=3"]
      (core/abi-profile-lp64))))

;; --- Obligation verdicts

(defn nine-pass? [program: core/NativeCoreProgram] -> Bool
  (every? obligations/obligation-passed?
    (obligations/validate-native-core-program program (core/abi-profile-lp64))))

(defn epoch-sound? [program: core/NativeCoreProgram] -> Bool
  (obligations/obligation-passed? (obligations/epoch-soundness program)))

(def probe-derived-minted: Int
  (lower/program-minted-epoch-count probe-derived-program))

(def probe-identity-minted: Int
  (lower/program-minted-epoch-count probe-identity-program))

(def probe-derived-closes: Int
  (lower/program-close-count probe-derived-program))

(def caller-derived-minted: Int
  (lower/program-minted-epoch-count caller-derived-program))

;; --- Materialization

(defn require-artifact
  [result: body/BodyMaterializationV0] -> body/BodyArtifactV0
  (if (body/materialization-ok? result)
    (body/materialization-artifact result)
    (throw (ex-info (body/materialization-detail result) {}))))

(def probe-derived-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program probe-derived-program 0)))

(def probe-identity-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program probe-identity-program 1)))

(def promote-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program promote-program 2)))

(def nested-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program nested-program 3)))

(def caller-derived-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program caller-derived-program 4)))

(def caller-identity-artifact: body/BodyArtifactV0
  (require-artifact (body/materialize-program caller-identity-program 5)))

(defn write-artifact! [directory: String artifact: body/BodyArtifactV0] -> Nil
  (do
    (spit (str directory "/" (body/bodyartifactv0-header-name artifact))
      (body/bodyartifactv0-header-text artifact))
    (spit (str directory "/" (body/bodyartifactv0-source-name artifact))
      (body/bodyartifactv0-source-text artifact))))

(defn verdict-line [label: String passed: Bool] -> String
  (str label " " (if passed "PASS" "FAIL") "\n"))

(def report-text: String
  (str
    "epoch-fixture probe-derived-minted-epochs " probe-derived-minted "\n"
    "epoch-fixture probe-derived-closes " probe-derived-closes "\n"
    "epoch-fixture probe-identity-minted-epochs " probe-identity-minted "\n"
    "epoch-fixture caller-derived-minted-epochs " caller-derived-minted "\n"
    (verdict-line "obligation probe-derived-nine" (nine-pass? probe-derived-program))
    (verdict-line "obligation probe-identity-nine"
      (nine-pass? probe-identity-program))
    (verdict-line "obligation promote-nine" (nine-pass? promote-program))
    (verdict-line "obligation nested-nine" (nine-pass? nested-program))
    ;; The negative: the same program without the promote must NOT be sound.
    (verdict-line "obligation old-young-rejected"
      (not (epoch-sound? old-young-program)))
    (verdict-line "obligation promote-accepted" (epoch-sound? promote-program))
    (verdict-line "obligation caller-derived-nine"
      (nine-pass? caller-derived-program))
    (verdict-line "obligation caller-identity-nine"
      (nine-pass? caller-identity-program))
    ;; E3's summary is the whole reason the caller may put the CALL in an
    ;; epoch, so the summary itself is asserted, not just its consequence.
    (verdict-line "summary callee-epoch-safe"
      (= true
        (get (lower/epoch-safe-functions
               (core/nativecoreprogram-functions caller-program))
          (get (epoch-id "function-callee") :value ""))))))

(def gate-passes?: Bool
  (and (= 1 probe-derived-minted)
    (= 0 probe-identity-minted)
    (> probe-derived-closes 0)
    (nine-pass? probe-derived-program)
    (nine-pass? probe-identity-program)
    (nine-pass? promote-program)
    (nine-pass? nested-program)
    (not (epoch-sound? old-young-program))
    (epoch-sound? promote-program)
    (= 2 caller-derived-minted)
    (nine-pass? caller-derived-program)
    (nine-pass? caller-identity-program)))

(defn emit-fixtures! [directory: String] -> Nil
  (do
    (write-artifact! directory probe-derived-artifact)
    (write-artifact! directory probe-identity-artifact)
    (write-artifact! directory promote-artifact)
    (write-artifact! directory nested-artifact)
    (write-artifact! directory caller-derived-artifact)
    (write-artifact! directory caller-identity-artifact)
    (spit (str directory "/report.txt") report-text)))
