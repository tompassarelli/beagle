(ns native.core)

(define-mode strict)

(defrecord NativeId [value :- String])

;; TextKind and KeywordKind are 64-bit handles. BytesKind is an owned byte span;
;; it remains distinct because bounded socket reads need not end on UTF-8 edges.
(defunion AtomKind
  (BoolKind [token :- Bool])
  (I64Kind [token :- Bool])
  (F64Kind [token :- Bool])
  (TextKind [token :- Bool])
  (BytesKind [token: Bool])
  (KeywordKind [token :- Bool])
  (RefKind [target :- NativeId]))

(defunion NativeAtom
  (BoolAtom [value :- Bool])
  (I64Atom [value :- Int])
  (F64Atom [value :- Float])
  (TextAtom [value :- String])
  (KeywordAtom [value :- String])
  (RefAtom [target :- NativeId]))

(defrecord TypeField
  [id :- NativeId
   name :- String
   type-id :- NativeId])

(defrecord TypeVariant
  [id :- NativeId
   name :- String
   payload-type :- (U NativeId Nil)])

(defunion CollectionOrderV0
  (InsertionOrderV0 [token: Bool]))

;; Collection lookup equality is closed over concrete native scalars. Dyn/Any
;; descriptors extend this vocabulary elsewhere; ordinary Map/Set ops never
;; smuggle a host hash or equality callback through the runtime ABI.
(defunion ConcreteEqualityV0
  (BoolEqualityV0 [token: Bool])
  (I64EqualityV0 [token: Bool])
  (F64EqualityV0 [token: Bool])
  (TextEqualityV0 [token: Bool])
  (KeywordEqualityV0 [token: Bool]))

(defunion TypeShape
  (AtomType [kind :- AtomKind])
  (RecordType [fields :- (Vec TypeField)])
  (UnionType [variants :- (Vec TypeVariant)])
  (VectorType [element-type :- NativeId])
  (MapTypeV0
    [key-type: NativeId
     value-type: NativeId
     iteration-order: CollectionOrderV0])
  (SetTypeV0
    [element-type: NativeId
     iteration-order: CollectionOrderV0])
  (ReferenceType [target-type :- NativeId])
  ;; An Atom is an opaque identity-bearing cell, never a general reference.
  ;; Its content type fixes the byte layout copied under the state token.
  (AtomCellTypeV0 [content-type :- NativeId])
  ;; A closed callable signature is semantic type information only. Physical
  ;; closure layout and indirect-call ABI remain separate, explicit obligations.
  (FunctionType
    [parameter-types: (Vec NativeId)
     rest-type: (U NativeId Nil)
     return-type: NativeId])
  (OutcomeType
    [value-type: NativeId
     failure-type: NativeId]))

(defrecord TypeDef
  [id :- NativeId
   name :- String
   shape :- TypeShape])

(defunion EffectKind
  (PureEffect [token :- Bool])
  (AllocateEffect [region :- NativeId])
  (ReadEffect [region :- NativeId])
  (WriteEffect [region :- NativeId])
  (CapabilityEffect [capability :- NativeId])
  (IoEffect [capability: NativeId])
  (SocketEffect [capability: NativeId])
  (ClockEffect [capability: NativeId])
  (AtomicEffect
    [region: NativeId
     capability: NativeId]))

(defrecord EffectDef
  [id :- NativeId
   kind :- EffectKind])

(defunion RegionKind
  (StackRegion [token :- Bool])
  (ArenaRegion [token :- Bool])
  (ExternalRegion [token :- Bool]))

(defrecord RegionDef
  [id :- NativeId
   kind :- RegionKind
   parent :- (U NativeId Nil)])

(defunion CapabilityKind
  (ReadCapability [token :- Bool])
  (WriteCapability [token :- Bool])
  (AllocateCapability [token :- Bool])
  (HostCapability [token :- Bool]))

(defrecord CapabilityDef
  [id :- NativeId
   kind :- CapabilityKind
   region :- (U NativeId Nil)
   affine :- Bool])

(defunion ScalarReprV0
  (BoolReprV0 [bit-width: Int])
  (SignedIntReprV0 [bit-width: Int])
  (UnsignedIntReprV0 [bit-width: Int])
  (FloatReprV0 [bit-width: Int]))

(defrecord FieldLayoutV0
  [field-id: NativeId
   type-id: NativeId
   offset-bytes: Int
   align-bytes: Int])

(defrecord UnionVariantLayoutV0
  [variant-id: NativeId
   tag: Int
   payload-type: (U NativeId Nil)
   payload-offset-bytes: Int])

(defunion LayoutShapeV0
  (ScalarShapeV0 [representation: ScalarReprV0])
  (BytesShapeV0 [token: Bool])
  (RecordShapeV0 [fields: (Vec FieldLayoutV0)])
  (UnionShapeV0
    [tag-type: NativeId
     tag-offset-bytes: Int
     variants: (Vec UnionVariantLayoutV0)])
  ;; Describes the ELEMENT storage; the vector value itself is a reference-sized
  ;; handle on the header, so a (Vec T) record field is 8 bytes for every T.
  ;; Region-lifetime law applies: that handle may not outlive the header's region.
  (VectorShapeV0
    [element-type: NativeId
     stride-bytes: Int])
  ;; Map and Set values are arena-owned header handles. Their exact element
  ;; storage ABI and deterministic iteration policy stay in the Native World.
  (MapShapeV0
    [key-type: NativeId
     key-stride-bytes: Int
     key-align-bytes: Int
     value-type: NativeId
     value-stride-bytes: Int
     value-align-bytes: Int
     iteration-order: CollectionOrderV0])
  (SetShapeV0
    [element-type: NativeId
     stride-bytes: Int
     align-bytes: Int
     iteration-order: CollectionOrderV0])
  (ReferenceShapeV0 [target-type: NativeId])
  (AtomCellShapeV0 [content-type: NativeId]))

(defrecord LayoutDef
  [id: NativeId
   type-id: NativeId
   size-bytes: Int
   align-bytes: Int
   shape: LayoutShapeV0])

(defrecord Parameter
  [id :- NativeId
   type-id :- NativeId])

(defrecord SsaValueV0
  [id: NativeId
   type-id: NativeId])

(defunion CheckedOperationV0
  (CheckedAddI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedSubI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedMulI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedQuotI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedRemI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedModI64V0
    [left-id: NativeId
     right-id: NativeId])
  (CheckedBoundsV0
    [index-id: NativeId
     length-id: NativeId]))

;; I64 bit operations are total over their bit patterns. Shift distance follows
;; the portable/Clojure contract by using its low six bits.
(defunion BitwiseOperationV0
  (BitAndI64V0
    [left-id: NativeId
     right-id: NativeId])
  (BitXorI64V0
    [left-id: NativeId
     right-id: NativeId])
  (BitShiftLeftI64V0
    [value-id: NativeId
     distance-id: NativeId]))

;; Total comparisons: every operand pair is defined, so a comparison is never a
;; CheckedOperationV0 and never carries an Outcome result.
;; CompareEqTextV0 is byte equality over two handles, never handle equality: two
;; distinct handles onto equal bytes are equal Text.
(defunion CompareOpV0
  (CompareEqI64V0 [token: Bool])
  (CompareLtI64V0 [token: Bool])
  (CompareLeI64V0 [token: Bool])
  (CompareEqBoolV0 [token: Bool])
  (CompareEqTextV0 [token: Bool]))

;; Text library operations share one closed instruction family. Allocation is
;; explicit in each operation through its arena SSA value; pure comparisons do
;; not acquire one.
(defunion TextBuiltinOpV0
  (TextCompareV0
    [left-id: NativeId
     right-id: NativeId])
  (TextTrimV0
    [arena-id: NativeId
     source-id: NativeId])
  (TextLowerV0
    [arena-id: NativeId
     source-id: NativeId])
  (TextRegexReplaceV0
    [arena-id: NativeId
     source-id: NativeId
     pattern-id: NativeId
     replacement-id: NativeId])
  (TextRegexMatchesV0
    [source-id: NativeId
     pattern-id: NativeId])
  (TextRegexFindV0
    [arena-id: NativeId
     source-id: NativeId
     pattern-id: NativeId])
  (TextSplitV0
    [arena-id: NativeId
     source-id: NativeId
     pattern-id: NativeId])
  (TextVectorTrimV0
    [arena-id: NativeId
     source-id: NativeId])
  (TextVectorRemoveBlankV0
    [arena-id: NativeId
     source-id: NativeId])
  (TextJoinV0
    [arena-id: NativeId
     separator-id: NativeId
     source-id: NativeId])
  (TextRepeatV0
    [arena-id: NativeId
     source-id: NativeId
     count-id: NativeId]))

;; Value semantics are closed over one sealed TypeDef/LayoutDef graph. The
;; domain is explicit so materializers never infer dynamic behavior from bytes.
;; Hash is deterministic structural content; compare is a three-way total order
;; over the same recursive domain, with records, unions, and vectors ordered by
;; their declared fields, tags, and elements.
(defunion ValueSemanticsOpV0
  (ValueEqualV0
    [domain-type: NativeId
     left-id: NativeId
     right-id: NativeId])
  (ValueHashV0
    [domain-type: NativeId
     value-id: NativeId])
  (ValueCompareV0
    [domain-type: NativeId
     left-id: NativeId
     right-id: NativeId]))

(defunion ValueTextModeV0
  (ValueStrV0 [token: Bool])
  (ValuePrStrV0 [token: Bool]))

;; Pure target-neutral codec semantics. UTF-8 operations allocate only their
;; returned value in the caller's arena; binary64 conversions are bit-level.
(defunion CodecPrimitiveOpV0
  (Utf8EncodeV0
    [arena-id: NativeId
     source-id: NativeId])
  (Utf8DecodeV0
    [arena-id: NativeId
     source-id: NativeId])
  (Sha256BytesV0
    [arena-id: NativeId
     source-id: NativeId])
  (FloatToBitsV0 [source-id: NativeId])
  (FloatFromBitsV0 [source-id: NativeId]))

(defunion ResourceTokenKindV0
  (RegionTokenV0 [region: NativeId])
  (CapabilityTokenV0 [capability: NativeId]))

(defrecord ResourceTokenV0
  [id: NativeId
   kind: ResourceTokenKindV0])

(defrecord TokenFlowV0
  [consumed: (Vec NativeId)
   produced: (Vec ResourceTokenV0)])

(defunion StoreOp
  (StoreBool
    [address :- NativeId
     value :- NativeId
     region :- NativeId
     capability :- NativeId])
  (StoreI64
    [address :- NativeId
     value :- NativeId
     region :- NativeId
     capability :- NativeId])
  (StoreF64
    [address :- NativeId
     value :- NativeId
     region :- NativeId
     capability :- NativeId])
  (StoreText
    [address :- NativeId
     value :- NativeId
     region :- NativeId
     capability :- NativeId])
  (StoreRef
    [address :- NativeId
     value :- NativeId
     region :- NativeId
     capability :- NativeId]))

(defunion Instruction
  (AtomInstruction
    [result: SsaValueV0
     atom: NativeAtom])
  (CopyInstruction
    [result: SsaValueV0
     source-id: NativeId])
  (AddF64Instruction
    [result: SsaValueV0
     left-id: NativeId
     right-id: NativeId])
  (CheckedInstruction
    [result: SsaValueV0
     operation: CheckedOperationV0])
  (BitwiseInstructionV0
    [result: SsaValueV0
     operation: BitwiseOperationV0])
  (StoreInstruction
    [result: SsaValueV0
     store: StoreOp
     tokens: TokenFlowV0])
  (AllocateInstruction
    [result: SsaValueV0
     region: NativeId
     capability: NativeId
     byte-count-id: NativeId
     tokens: TokenFlowV0])
  (CallInstruction
    [result: SsaValueV0
     function-id: NativeId
     arguments: (Vec NativeId)
     tokens: TokenFlowV0])
  ;; The ABI declaration, rather than a source-language callee name, owns the
  ;; physical symbol, effects, capabilities, ownership, and failure contract.
  (ExternCallInstruction
    [result: SsaValueV0
     abi-id: NativeId
     arguments: (Vec NativeId)
     arena-id: (U NativeId Nil)
     tokens: TokenFlowV0])
  (CompareInstruction
    [result: SsaValueV0
     comparison: CompareOpV0
     left-id: NativeId
     right-id: NativeId])
  ;; Record values are held by value, so a field read is an extract and a record
  ;; construct is a value form; neither touches a region or a capability.
  (FieldInstruction
    [result: SsaValueV0
     source-id: NativeId
     field-id: NativeId])
  ;; Read one alternative's payload out of a tagged value. Sound only where the
  ;; tag is already proved, which is why it is reachable from a switch arm alone.
  (VariantValueInstruction
    [result: SsaValueV0
     source-id: NativeId
     variant-id: NativeId])
  (RecordInstruction
    [result: SsaValueV0
     field-ids: (Vec NativeId)])
  ;; Immutable record update copies the source into fresh arena storage before
  ;; replacing one statically identified field; the result keeps the by-value
  ;; record ABI while the allocation remains explicit in the world.
  (RecordAssocInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     field-id: NativeId
     value-id: NativeId
     arena-id: NativeId])
  ;; Records enter recursive unions through an arena-owned reference, so the
  ;; reference edge that closes their layout is represented in the world.
  (BoxRecordInstruction
    [result: SsaValueV0
     source-id: NativeId
     arena-id: NativeId])
  ;; Crossing back from a recursive union's reference payload into a direct
  ;; record ABI performs an explicit checked shallow copy.
  (RecordMaterializeInstructionV0
    [result: SsaValueV0
     source-id: NativeId])
  ;; Widening into a closed union is a tag inject: the payload is already the
  ;; variant's declared type, so no check can fail and none is emitted.
  (UnionConstructInstruction
    [result: SsaValueV0
     variant-id: NativeId
     payload-id: (U NativeId Nil)])
  ;; The checked companion to SwitchTerminator: a Switch asks which variant a
  ;; value carries, an extract asserts one. A tag mismatch traps rather than
  ;; reinterpreting the payload bytes as the expected variant.
  (UnionExtractInstruction
    [result: SsaValueV0
     source-id: NativeId
     variant-id: NativeId])
  ;; A vector value is a reference to a {elements, length, capacity} header in a
  ;; region: length is a header read and VecGet traps outside [0, length).
  (VecLengthInstruction
    [result: SsaValueV0
     source-id: NativeId])
  (VecGetInstruction
    [result: SsaValueV0
     source-id: NativeId
     index-id: NativeId])
  ;; Push is LINEAR once storage exists and doubles capacity; a reusable empty
  ;; value yields a fresh header so independent [] seeds never alias.
  (VecPushInstruction
    [result: SsaValueV0
     source-id: NativeId
     value-id: NativeId
     arena-id: NativeId])
  (VecEmptyInstruction
    [result: SsaValueV0
     capacity-id: NativeId
     arena-id: NativeId])
  ;; Concat borrows both inputs and copies their elements into a fresh header;
  ;; neither source is moved because source-level concat preserves both values.
  (VecConcatInstruction
    [result: SsaValueV0
     left-id: NativeId
     right-id: NativeId
     arena-id: NativeId])
  ;; Both transforms allocate a fresh header and storage. Source vectors stay
  ;; immutable and may be reused after the operation.
  (VecSliceInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     start-id: NativeId
     end-id: NativeId
     arena-id: NativeId])
  (VecReverseInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     arena-id: NativeId])
  (MapLiteralInstructionV0
    [result: SsaValueV0
     key-ids: (Vec NativeId)
     value-ids: (Vec NativeId)
     arena-id: NativeId
     key-equality: ConcreteEqualityV0])
  (SetLiteralInstructionV0
    [result: SsaValueV0
     value-ids: (Vec NativeId)
     arena-id: NativeId
     element-equality: ConcreteEqualityV0])
  (MapCountInstructionV0
    [result: SsaValueV0
     source-id: NativeId])
  ;; With a default, result is the map value type. Without one it is either an
  ;; existing nullable value union or a closed value-or-nil union.
  (MapGetInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     key-id: NativeId
     default-id: (U NativeId Nil)
     key-equality: ConcreteEqualityV0])
  (MapContainsInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     key-id: NativeId
     key-equality: ConcreteEqualityV0])
  ;; Assoc/dissoc are persistent linear updates. Replacement keeps its original
  ;; iteration position; deletion compacts without reordering survivors.
  (MapAssocInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     key-id: NativeId
     value-id: NativeId
     arena-id: NativeId
     key-equality: ConcreteEqualityV0])
  (MapDissocInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     key-id: NativeId
     arena-id: NativeId
     key-equality: ConcreteEqualityV0])
  (MapKeysInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     arena-id: NativeId])
  (MapValuesInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     arena-id: NativeId])
  (SetCountInstructionV0
    [result: SsaValueV0
     source-id: NativeId])
  (SetContainsInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     value-id: NativeId
     element-equality: ConcreteEqualityV0])
  (SetConjInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     value-id: NativeId
     arena-id: NativeId
     element-equality: ConcreteEqualityV0])
  (SetDisjInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     value-id: NativeId
     arena-id: NativeId
     element-equality: ConcreteEqualityV0])
  (SetVectorInstructionV0
    [result: SsaValueV0
     source-id: NativeId
     arena-id: NativeId])
  ;; Acquires the arena once in the entry block, consuming the region and
  ;; capability tokens; no other instruction can allocate without its result.
  (ArenaInstruction
    [result: SsaValueV0
     region: NativeId
     capability: NativeId
     tokens: TokenFlowV0])
  ;; Acquires the dedicated Atom-state token once at function entry. Atom
  ;; operations must carry this SSA handle, so state cannot be implicit.
  (AtomStateInstruction
    [result: SsaValueV0
     region: NativeId
     capability: NativeId
     tokens: TokenFlowV0])
  (AtomCreateInstruction
    [result: SsaValueV0
     initial-id: NativeId
     arena-id: NativeId
     state-id: NativeId])
  (AtomDerefInstruction
    [result: SsaValueV0
     cell-id: NativeId
     state-id: NativeId])
  ;; swap! is deliberately not a general higher-order call: updater-id names a
  ;; statically sealed pure function and arguments excludes the current value.
  (AtomSwapInstruction
    [result: SsaValueV0
     cell-id: NativeId
     state-id: NativeId
     updater-id: NativeId
     arguments: (Vec NativeId)])
  (TextLengthInstruction
    [result: SsaValueV0
     source-id: NativeId])
  ;; Search reports a byte offset, or -1 when the needle is absent. Text and
  ;; slicing share byte coordinates, so non-ASCII prefixes remain coherent.
  (TextIndexOfInstruction
    [result: SsaValueV0
     source-id: NativeId
     needle-id: NativeId])
  (TextBlankInstruction
    [result: SsaValueV0
     source-id: NativeId])
  ;; The result is a closed Int-or-unit union: malformed or overflowing input
  ;; is absence, not a trap and not a reserved integer sentinel.
  (TextParseI64Instruction
    [result: SsaValueV0
     source-id: NativeId])
  ;; v0 subs copies into the arena: no interior borrow, so the source blob's
  ;; lifetime never constrains the slice.
  (TextSliceInstruction
    [result: SsaValueV0
     arena-id: NativeId
     source-id: NativeId
     start-id: NativeId
     end-id: NativeId
     failure-code: Int])
  (TextConcatInstruction
    [result: SsaValueV0
     arena-id: NativeId
     operand-ids: (Vec NativeId)])
  (TextBuiltinInstruction
    [result: SsaValueV0
     builtin: TextBuiltinOpV0])
  (ValueSemanticsInstruction
    [result: SsaValueV0
     operation: ValueSemanticsOpV0])
  ;; Stringification stays separate from TextConcat's statically tagged operands.
  (ValueToTextInstructionV0
    [result: SsaValueV0
     mode: ValueTextModeV0
     domain-type: NativeId
     value-id: NativeId
     arena-id: NativeId])
  (CodecPrimitiveInstructionV0
    [result: SsaValueV0
     operation: CodecPrimitiveOpV0]))

(defrecord SwitchCaseV0
  [variant-id: NativeId
   block-id: NativeId
   arguments: (Vec NativeId)])

(defunion Terminator
  (ReturnTerminator [value: (U NativeId Nil)])
  (JumpTerminator
    [block-id: NativeId
     arguments: (Vec NativeId)])
  (BranchTerminator
    [condition: NativeId
     true-block: NativeId
     false-block: NativeId])
  (SwitchTerminator
    [value-id: NativeId
     cases: (Vec SwitchCaseV0)])
  (TrapTerminator [failure-id: NativeId]))

(defrecord BasicBlock
  [id :- NativeId
   parameters :- (Vec Parameter)
   instructions :- (Vec Instruction)
   terminators :- (Vec Terminator)])

(defrecord FunctionDef
  [id :- NativeId
   name :- String
   parameters :- (Vec Parameter)
   blocks :- (Vec BasicBlock)
   entry-block :- NativeId
   return-type :- (U NativeId Nil)
   effects :- (Vec NativeId)
   regions :- (Vec NativeId)
   capabilities :- (Vec NativeId)])

(defunion ObligationCode
  (ValidSsaObligation [token: Bool])
  (ExhaustiveMatchesObligation [token: Bool])
  (ClosedLayoutsObligation [token: Bool])
  (CheckedOperationsObligation [token: Bool])
  (LegalAbiObligation [token: Bool])
  (DischargedTokensObligation [token: Bool])
  (BoundedEffectsObligation [token: Bool]))

(defrecord ObligationResult
  [code :- ObligationCode
   passed :- Bool
   detail :- String])

(defrecord ValidationReport
  [passed :- Bool
   obligations :- (Vec ObligationResult)])

(defunion ExternalObservation
  (Fri2Observation
    [artifact-id :- NativeId
     digest :- String
     byte-count :- Int]))

(defrecord DiagnosticV0
  [code: String
   detail: String])

(defrecord ReceiptObligationV0
  [code: ObligationCode
   version: String
   subject-digest: String
   passed: Bool
   detail: String])

(defrecord ArtifactHashV0
  [name: String
   digest: String])

(defrecord PassReceiptV0
  [id: NativeId
   input-digest: String
   compiler-commit: String
   pass-id: String
   pass-version: String
   configuration: (Vec String)
   configuration-digest: String
   diagnostics: (Vec DiagnosticV0)
   obligations: (Vec ReceiptObligationV0)
   output-digest: String
   backend: String
   backend-version: String
   artifacts: (Vec ArtifactHashV0)])

(defunion AbiDirectionV0
  (AbiImportV0 [token: Bool])
  (AbiExportV0 [token: Bool]))

(defunion AbiConventionV0
  (RestrictedCAbiV0 [token: Bool])
  ;; A restricted C import returns presence and writes the one non-unit union
  ;; payload through a trailing pointer; the world result stays a closed union.
  (RestrictedCOptionalOutAbiV0 [token: Bool])
  ;; Zero means success, -1 means peer-closed, and a positive return is copied
  ;; into `error` as errno; a non-unit `ok` payload is a trailing out pointer.
  (RestrictedCOutcomeOutAbiV0 [token: Bool]))

(defunion OwnershipRuleV0
  (BorrowedV0 [token: Bool])
  (OwnedV0 [token: Bool])
  (ArenaOwnedV0 [region: NativeId]))

(defrecord AbiValueV0
  [name: String
   type-id: NativeId
   ownership: OwnershipRuleV0
   lifetime-region: (U NativeId Nil)])

(defrecord AbiDeclV0
  [id: NativeId
   function-id: NativeId
   symbol: String
   direction: AbiDirectionV0
   convention: AbiConventionV0
   parameters: (Vec AbiValueV0)
   result: (U AbiValueV0 Nil)
   failure-type: NativeId
   required-effects: (Vec NativeId)
   required-capabilities: (Vec NativeId)
   version: String
   layout-digest: String])

(defrecord NativeWorld
  [id :- NativeId
   parent :- (U NativeId Nil)
   compiler-pass :- String
   types :- (Vec TypeDef)
   effects :- (Vec EffectDef)
   regions :- (Vec RegionDef)
   capabilities :- (Vec CapabilityDef)
   layouts :- (Vec LayoutDef)
   functions :- (Vec FunctionDef)
   allowed-effects :- (Vec NativeId)
   allowed-regions :- (Vec NativeId)
   allowed-capabilities :- (Vec NativeId)
   abis: (Vec AbiDeclV0)
   observations :- (Vec ExternalObservation)])

(defn native-id=
  [left :- NativeId
   right :- NativeId] :- Bool
  (= (nativeid-value left) (nativeid-value right)))

(defn id-in?
  [ids :- (Vec NativeId)
   target :- NativeId] :- Bool
  (loop [index :- Int 0]
    (cond
      (>= index (count ids))
      false
      (native-id= (nth ids index) target)
      true
      :else
      (recur (+ index 1)))))

(defn ids-in?
  [ids :- (Vec NativeId)
   allowed :- (Vec NativeId)] :- Bool
  (loop [index :- Int 0]
    (if (>= index (count ids))
      true
      (if (id-in? allowed (nth ids index)) (recur (+ index 1)) false))))

(defn unique-ids? [ids :- (Vec NativeId)] :- Bool
  (loop [index :- Int 0 seen :- (Vec NativeId) []]
    (if (>= index (count ids))
      true
      (let [current :- NativeId (nth ids index)]
        (if (id-in? seen current) false (recur (+ index 1) (conj seen current)))))))

(defn canonical-parts [parts :- (Vec String)] :- String
  (loop [index :- Int 0 encoded :- String ""]
    (if (>= index (count parts))
      encoded
      (let [part :- String (nth parts index)]
        (recur (+ index 1) (str encoded (count part) ":" part))))))

(defn canonical-id
  [domain :- String
   parts :- (Vec String)] :- NativeId
  (->NativeId (str "native-id-v0:" (count domain) ":" domain ":" (canonical-parts parts))))

;; An Outcome's tag namespace is exactly its failure union's variant set, so the
;; success alternative has to be an alternative of that union. Lowering, layout
;; and every materializer mint the checked-i64 ids here so they cannot disagree.
(defn checked-id [parts :- (Vec String)] :- NativeId
  (canonical-id "native-core-v0/checked" parts))

(defn checked-i64-result-type-id [] :- NativeId
  (checked-id ["CheckedI64Result"]))

(defn checked-i64-type-id [] :- NativeId (checked-id ["CheckedI64"]))

(defn checked-ok-variant-id [] :- NativeId
  (checked-id ["CheckedI64Result" "ok"]))

(defn checked-overflow-variant-id [] :- NativeId
  (checked-id ["CheckedI64Result" "overflow"]))

(defn checked-division-i64-result-type-id [] -> NativeId
  (checked-id ["CheckedDivisionI64Result"]))

(defn checked-division-i64-type-id [] -> NativeId
  (checked-id ["CheckedDivisionI64"]))

(defn checked-division-ok-variant-id [] -> NativeId
  (checked-id ["CheckedDivisionI64Result" "ok"]))

(defn checked-division-zero-variant-id [] -> NativeId
  (checked-id ["CheckedDivisionI64Result" "division-by-zero"]))

(defn optional-id-in?
  [candidate :- (U NativeId Nil)
   allowed :- (Vec NativeId)] :- Bool
  (if (nil? candidate) true (id-in? allowed candidate)))

(defn append-ids
  [left :- (Vec NativeId)
   right :- (Vec NativeId)] :- (Vec NativeId)
  (vec (concat left right)))

(defn parameter-ids [parameters :- (Vec Parameter)] :- (Vec NativeId)
  (mapv (fn [parameter :- Parameter] :- NativeId (parameter-id parameter))
    parameters))

(defn instruction-result-id [instruction :- Instruction] :- NativeId
  (match instruction
    [(AtomInstruction result atom) (ssavaluev0-id result)]
    [(CopyInstruction result source-id) (ssavaluev0-id result)]
    [(AddF64Instruction result left-id right-id) (ssavaluev0-id result)]
    [(CheckedInstruction result operation) (ssavaluev0-id result)]
    [(BitwiseInstructionV0 result operation) (ssavaluev0-id result)]
    [(StoreInstruction result store tokens) (ssavaluev0-id result)]
    [(AllocateInstruction result region capability byte-count-id tokens)
     (ssavaluev0-id result)]
    [(CallInstruction result function-id arguments tokens) (ssavaluev0-id result)]
    [(ExternCallInstruction result abi-id arguments arena-id tokens)
     (ssavaluev0-id result)]
    [(CompareInstruction result comparison left-id right-id) (ssavaluev0-id result)]
    [(FieldInstruction result source-id field-id) (ssavaluev0-id result)]
    [(VariantValueInstruction result source-id variant-id) (ssavaluev0-id result)]
    [(RecordInstruction result field-ids) (ssavaluev0-id result)]
    [(RecordAssocInstructionV0 result source-id field-id value-id arena-id)
     (ssavaluev0-id result)]
    [(BoxRecordInstruction result source-id arena-id) (ssavaluev0-id result)]
    [(RecordMaterializeInstructionV0 result source-id)
     (ssavaluev0-id result)]
    [(UnionConstructInstruction result variant-id payload-id)
     (ssavaluev0-id result)]
    [(UnionExtractInstruction result source-id variant-id)
     (ssavaluev0-id result)]
    [(VecLengthInstruction result source-id) (ssavaluev0-id result)]
    [(VecGetInstruction result source-id index-id) (ssavaluev0-id result)]
    [(VecPushInstruction result source-id value-id arena-id)
     (ssavaluev0-id result)]
    [(VecEmptyInstruction result capacity-id arena-id) (ssavaluev0-id result)]
    [(VecConcatInstruction result left-id right-id arena-id)
     (ssavaluev0-id result)]
    [(VecSliceInstructionV0 result source-id start-id end-id arena-id)
     (ssavaluev0-id result)]
    [(VecReverseInstructionV0 result source-id arena-id)
     (ssavaluev0-id result)]
    [(MapLiteralInstructionV0 result key-ids value-ids arena-id key-equality)
     (ssavaluev0-id result)]
    [(SetLiteralInstructionV0 result value-ids arena-id element-equality)
     (ssavaluev0-id result)]
    [(MapCountInstructionV0 result source-id) (ssavaluev0-id result)]
    [(MapGetInstructionV0 result source-id key-id default-id key-equality)
     (ssavaluev0-id result)]
    [(MapContainsInstructionV0 result source-id key-id key-equality)
     (ssavaluev0-id result)]
    [(MapAssocInstructionV0 result source-id key-id value-id arena-id key-equality)
     (ssavaluev0-id result)]
    [(MapDissocInstructionV0 result source-id key-id arena-id key-equality)
     (ssavaluev0-id result)]
    [(MapKeysInstructionV0 result source-id arena-id) (ssavaluev0-id result)]
    [(MapValuesInstructionV0 result source-id arena-id) (ssavaluev0-id result)]
    [(SetCountInstructionV0 result source-id) (ssavaluev0-id result)]
    [(SetContainsInstructionV0 result source-id value-id element-equality)
     (ssavaluev0-id result)]
    [(SetConjInstructionV0 result source-id value-id arena-id element-equality)
     (ssavaluev0-id result)]
    [(SetDisjInstructionV0 result source-id value-id arena-id element-equality)
     (ssavaluev0-id result)]
    [(SetVectorInstructionV0 result source-id arena-id) (ssavaluev0-id result)]
    [(ArenaInstruction result region capability tokens) (ssavaluev0-id result)]
    [(AtomStateInstruction result region capability tokens)
     (ssavaluev0-id result)]
    [(AtomCreateInstruction result initial-id arena-id state-id)
     (ssavaluev0-id result)]
    [(AtomDerefInstruction result cell-id state-id) (ssavaluev0-id result)]
    [(AtomSwapInstruction result cell-id state-id updater-id arguments)
     (ssavaluev0-id result)]
    [(TextLengthInstruction result source-id) (ssavaluev0-id result)]
    [(TextIndexOfInstruction result source-id needle-id) (ssavaluev0-id result)]
    [(TextBlankInstruction result source-id) (ssavaluev0-id result)]
    [(TextParseI64Instruction result source-id) (ssavaluev0-id result)]
    [(TextSliceInstruction result arena-id source-id start-id end-id failure-code)
     (ssavaluev0-id result)]
    [(TextConcatInstruction result arena-id operand-ids) (ssavaluev0-id result)]
    [(TextBuiltinInstruction result operation) (ssavaluev0-id result)]
    [(ValueSemanticsInstruction result operation) (ssavaluev0-id result)]
    [(ValueToTextInstructionV0 result mode domain-type value-id arena-id)
     (ssavaluev0-id result)]
    [(CodecPrimitiveInstructionV0 result operation)
     (ssavaluev0-id result)]))

(defn instruction-result-ids [instructions :- (Vec Instruction)] :- (Vec NativeId)
  (mapv (fn [instruction :- Instruction] :- NativeId (instruction-result-id instruction))
    instructions))

(defn type-definition-with-id
  [types: (Vec TypeDef)
   target: NativeId] -> (U TypeDef Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: TypeDef (nth types position)]
        (if (native-id= target (typedef-id definition))
          definition
          (recur (+ position 1)))))))

(defn record-field-with-id
  [types: (Vec TypeDef)
   owner: NativeId
   target: NativeId] -> (U TypeField Nil)
  (let [definition: (U TypeDef Nil) (type-definition-with-id types owner)]
    (if (nil? definition)
      nil
      (let [shape: TypeShape (typedef-shape definition)]
        (if (not (instance? native.core.RecordType shape))
          nil
          (loop [position: Int 0 fields: (Vec TypeField) (recordtype-fields shape)]
            (if (>= position (count fields))
              nil
              (let [field: TypeField (nth fields position)]
                (if (native-id= target (typefield-id field))
                  field
                  (recur (+ position 1) fields))))))))))

(defn parameters-value-type
  [parameters: (Vec Parameter)
   target: NativeId] -> (U NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count parameters))
      nil
      (let [parameter: Parameter (nth parameters position)]
        (if (native-id= target (parameter-id parameter))
          (parameter-type-id parameter)
          (recur (+ position 1)))))))

(defn instructions-value-type
  [instructions: (Vec Instruction)
   target: NativeId] -> (U NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count instructions))
      nil
      (let [result: SsaValueV0 (get (nth instructions position) :result)]
        (if (native-id= target (ssavaluev0-id result))
          (ssavaluev0-type-id result)
          (recur (+ position 1)))))))

(defn block-value-type
  [block: BasicBlock
   target: NativeId] -> (U NativeId Nil)
  (let [parameter-type: (U NativeId Nil)
        (parameters-value-type (basicblock-parameters block) target)]
    (if (nil? parameter-type)
      (instructions-value-type (basicblock-instructions block) target)
      parameter-type)))

(defn function-value-type
  [function: FunctionDef
   target: NativeId] -> (U NativeId Nil)
  (let [parameter-type: (U NativeId Nil)
        (parameters-value-type (functiondef-parameters function) target)]
    (if (some? parameter-type)
      parameter-type
      (loop [position: Int 0 blocks: (Vec BasicBlock) (functiondef-blocks function)]
        (if (>= position (count blocks))
          nil
          (let [value-type: (U NativeId Nil)
                (block-value-type (nth blocks position) target)]
            (if (nil? value-type)
              (recur (+ position 1) blocks)
              value-type)))))))

(defn block-produces-arena?
  [block: BasicBlock
   target: NativeId] -> Bool
  (loop [position: Int 0 instructions: (Vec Instruction)
         (basicblock-instructions block)]
    (if (>= position (count instructions))
      false
      (let [instruction: Instruction (nth instructions position)]
        (if (and (instance? native.core.ArenaInstruction instruction)
              (native-id= target (instruction-result-id instruction)))
          true
          (recur (+ position 1) instructions))))))

(defn function-produces-arena?
  [function: FunctionDef
   target: NativeId] -> Bool
  (loop [position: Int 0 blocks: (Vec BasicBlock) (functiondef-blocks function)]
    (if (>= position (count blocks))
      false
      (if (block-produces-arena? (nth blocks position) target)
        true
        (recur (+ position 1) blocks)))))

(defn record-assoc-instruction-valid?
  [types: (Vec TypeDef)
   function: FunctionDef
   instruction: Instruction] -> Bool
  (if (not (instance? native.core.RecordAssocInstructionV0 instruction))
    true
    (let [result: SsaValueV0 (recordassocinstructionv0-result instruction)
          owner: NativeId (ssavaluev0-type-id result)
          source-type: (U NativeId Nil)
          (function-value-type function
            (recordassocinstructionv0-source-id instruction))
          value-type: (U NativeId Nil)
          (function-value-type function
            (recordassocinstructionv0-value-id instruction))
          field: (U TypeField Nil)
          (record-field-with-id types owner
            (recordassocinstructionv0-field-id instruction))]
      (if (or (nil? source-type) (nil? value-type) (nil? field))
        false
        (and (native-id= owner source-type)
          (native-id= value-type (typefield-type-id field))
          (function-produces-arena? function
            (recordassocinstructionv0-arena-id instruction)))))))

(defn function-record-assocs-valid?
  [types: (Vec TypeDef)
   function: FunctionDef] -> Bool
  (every?
    (fn [block: BasicBlock] -> Bool
      (every?
        (fn [instruction: Instruction] -> Bool
          (record-assoc-instruction-valid? types function instruction))
        (basicblock-instructions block)))
    (functiondef-blocks function)))

(defn record-materialize-instruction-valid?
  [types: (Vec TypeDef)
   function: FunctionDef
   instruction: Instruction] -> Bool
  (if (not (instance? native.core.RecordMaterializeInstructionV0 instruction))
    true
    (let [result: SsaValueV0
          (recordmaterializeinstructionv0-result instruction)
          result-type: NativeId (ssavaluev0-type-id result)
          source-type: (U NativeId Nil)
          (function-value-type function
            (recordmaterializeinstructionv0-source-id instruction))
          result-definition: (U TypeDef Nil)
          (type-definition-with-id types result-type)
          source-definition: (U TypeDef Nil)
          (if (nil? source-type)
            nil
            (type-definition-with-id types source-type))]
      (if (or (nil? result-definition) (nil? source-definition))
        false
        (let [result-shape: TypeShape (typedef-shape result-definition)
              source-shape: TypeShape (typedef-shape source-definition)]
          (and (instance? native.core.RecordType result-shape)
            (instance? native.core.ReferenceType source-shape)
            (native-id=
              (referencetype-target-type source-shape)
              result-type)))))))

(defn function-record-materializations-valid?
  [types: (Vec TypeDef)
   function: FunctionDef] -> Bool
  (every?
    (fn [block: BasicBlock] -> Bool
      (every?
        (fn [instruction: Instruction] -> Bool
          (record-materialize-instruction-valid? types function instruction))
        (basicblock-instructions block)))
    (functiondef-blocks function)))

(defn type-shape-owned-ids [shape :- TypeShape] :- (Vec NativeId)
  (match shape
    [(AtomType kind) []]
    [(RecordType fields)
     (mapv (fn [field :- TypeField] :- NativeId (typefield-id field)) fields)]
    [(UnionType variants)
     (mapv (fn [variant :- TypeVariant] :- NativeId (typevariant-id variant))
       variants)]
    [(VectorType element-type) []]
    [(MapTypeV0 key-type value-type iteration-order) []]
    [(SetTypeV0 element-type iteration-order) []]
    [(ReferenceType target-type) []]
    [(AtomCellTypeV0 content-type) []]
    [(FunctionType parameter-types rest-type return-type) []]
    [(OutcomeType value-type failure-type) []]))

(defn type-owned-ids [type-def :- TypeDef] :- (Vec NativeId)
  (into [(typedef-id type-def)] (type-shape-owned-ids (typedef-shape type-def))))

(defn all-type-owned-ids [types :- (Vec TypeDef)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count types))
      ids
      (recur (+ index 1) (append-ids ids (type-owned-ids (nth types index)))))))

(defn block-owned-ids [block :- BasicBlock] :- (Vec NativeId)
  (append-ids [(basicblock-id block)]
    (append-ids (parameter-ids (basicblock-parameters block))
      (instruction-result-ids (basicblock-instructions block)))))

(defn all-block-owned-ids [blocks :- (Vec BasicBlock)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count blocks))
      ids
      (recur (+ index 1) (append-ids ids (block-owned-ids (nth blocks index)))))))

(defn function-owned-ids [function :- FunctionDef] :- (Vec NativeId)
  (append-ids [(functiondef-id function)]
    (append-ids (parameter-ids (functiondef-parameters function))
      (all-block-owned-ids (functiondef-blocks function)))))

(defn all-function-owned-ids [functions :- (Vec FunctionDef)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count functions))
      ids
      (recur (+ index 1)
        (append-ids ids (function-owned-ids (nth functions index)))))))

(defn type-ids [types :- (Vec TypeDef)] :- (Vec NativeId)
  (mapv (fn [type-def :- TypeDef] :- NativeId (typedef-id type-def)) types))

(defn effect-ids [effects :- (Vec EffectDef)] :- (Vec NativeId)
  (mapv (fn [effect :- EffectDef] :- NativeId (effectdef-id effect)) effects))

(defn region-ids [regions :- (Vec RegionDef)] :- (Vec NativeId)
  (mapv (fn [region :- RegionDef] :- NativeId (regiondef-id region)) regions))

(defn capability-ids [capabilities :- (Vec CapabilityDef)] :- (Vec NativeId)
  (mapv (fn [capability :- CapabilityDef] :- NativeId (capabilitydef-id capability))
    capabilities))

(defn layout-ids [layouts :- (Vec LayoutDef)] :- (Vec NativeId)
  (mapv (fn [layout :- LayoutDef] :- NativeId (layoutdef-id layout)) layouts))

(defn function-ids [functions :- (Vec FunctionDef)] :- (Vec NativeId)
  (mapv (fn [function :- FunctionDef] :- NativeId (functiondef-id function))
    functions))

(defn abi-ids [abis :- (Vec AbiDeclV0)] :- (Vec NativeId)
  (mapv (fn [abi :- AbiDeclV0] :- NativeId (abideclv0-id abi)) abis))

(defn world-owned-ids [world :- NativeWorld] :- (Vec NativeId)
  (let [owned0 :- (Vec NativeId) [(nativeworld-id world)] owned1 :- (Vec NativeId) (append-ids owned0 (all-type-owned-ids (nativeworld-types world))) owned2 :- (Vec NativeId) (append-ids owned1 (effect-ids (nativeworld-effects world))) owned3 :- (Vec NativeId) (append-ids owned2 (region-ids (nativeworld-regions world))) owned4 :- (Vec NativeId) (append-ids owned3 (capability-ids (nativeworld-capabilities world))) owned5 :- (Vec NativeId) (append-ids owned4 (layout-ids (nativeworld-layouts world)))]
    (append-ids
      (append-ids owned5 (all-function-owned-ids (nativeworld-functions world)))
      (abi-ids (nativeworld-abis world)))))

(defn type-member-ids [types :- (Vec TypeDef)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count types))
      ids
      (recur (+ index 1)
        (append-ids ids
          (type-shape-owned-ids (typedef-shape (nth types index))))))))

(defn atom-kind-refs-closed?
  [kind :- AtomKind
   known-types :- (Vec NativeId)] :- Bool
  (match kind
    [(BoolKind value) true]
    [(I64Kind value) true]
    [(F64Kind value) true]
    [(TextKind value) true]
    [(BytesKind value) true]
    [(KeywordKind value) true]
    [(RefKind target) (id-in? known-types target)]))

(defn type-fields-refs-closed?
  [fields :- (Vec TypeField)
   known-types :- (Vec NativeId)] :- Bool
  (every? (fn [field :- TypeField] :- Bool (id-in? known-types (typefield-type-id field)))
    fields))

(defn type-variants-refs-closed?
  [variants :- (Vec TypeVariant)
   known-types :- (Vec NativeId)] :- Bool
  (every? (fn [variant :- TypeVariant] :- Bool (optional-id-in? (typevariant-payload-type variant) known-types))
    variants))

(defn type-shape-refs-closed?
  [shape :- TypeShape
   known-types :- (Vec NativeId)] :- Bool
  (match shape
    [(AtomType kind) (atom-kind-refs-closed? kind known-types)]
    [(RecordType fields) (type-fields-refs-closed? fields known-types)]
    [(UnionType variants) (type-variants-refs-closed? variants known-types)]
    [(VectorType element-type) (id-in? known-types element-type)]
    [(MapTypeV0 key-type value-type iteration-order)
     (and (id-in? known-types key-type) (id-in? known-types value-type))]
    [(SetTypeV0 element-type iteration-order) (id-in? known-types element-type)]
    [(ReferenceType target-type) (id-in? known-types target-type)]
    [(AtomCellTypeV0 content-type) (id-in? known-types content-type)]
    [(FunctionType parameter-types rest-type return-type)
     (and (ids-in? parameter-types known-types)
       (optional-id-in? rest-type known-types)
       (id-in? known-types return-type))]
    [(OutcomeType value-type failure-type)
     (and (id-in? known-types value-type) (id-in? known-types failure-type))]))

(defn types-refs-closed? [types :- (Vec TypeDef)] :- Bool
  (let [known-types :- (Vec NativeId) (type-ids types)]
    (every? (fn [type-def :- TypeDef] :- Bool (type-shape-refs-closed? (typedef-shape type-def) known-types))
      types)))

(defn effect-kind-refs-closed?
  [kind :- EffectKind
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)] :- Bool
  (match kind
    [(PureEffect value) true]
    [(AllocateEffect region) (id-in? known-regions region)]
    [(ReadEffect region) (id-in? known-regions region)]
    [(WriteEffect region) (id-in? known-regions region)]
    [(CapabilityEffect capability) (id-in? known-capabilities capability)]
    [(IoEffect capability) (id-in? known-capabilities capability)]
    [(SocketEffect capability) (id-in? known-capabilities capability)]
    [(ClockEffect capability) (id-in? known-capabilities capability)]
    [(AtomicEffect region capability)
     (and (id-in? known-regions region)
       (id-in? known-capabilities capability))]))

(defn effects-refs-closed?
  [effects :- (Vec EffectDef)
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)] :- Bool
  (every? (fn [effect :- EffectDef] :- Bool (effect-kind-refs-closed? (effectdef-kind effect) known-regions known-capabilities))
    effects))

(defn regions-refs-closed? [regions :- (Vec RegionDef)] :- Bool
  (let [known :- (Vec NativeId) (region-ids regions)]
    (every? (fn [region :- RegionDef] :- Bool (optional-id-in? (regiondef-parent region) known))
      regions)))

(defn capabilities-refs-closed?
  [capabilities :- (Vec CapabilityDef)
   known-regions :- (Vec NativeId)] :- Bool
  (every? (fn [capability :- CapabilityDef] :- Bool (optional-id-in? (capabilitydef-region capability) known-regions))
    capabilities))

(defn field-layout-refs-closed?
  [field :- FieldLayoutV0
   known-members :- (Vec NativeId)
   known-types :- (Vec NativeId)] :- Bool
  (and (id-in? known-members (fieldlayoutv0-field-id field))
    (id-in? known-types (fieldlayoutv0-type-id field))
    (>= (fieldlayoutv0-offset-bytes field) 0)
    (> (fieldlayoutv0-align-bytes field) 0)))

(defn union-variant-layout-refs-closed?
  [variant :- UnionVariantLayoutV0
   known-members :- (Vec NativeId)
   known-types :- (Vec NativeId)] :- Bool
  (and (id-in? known-members (unionvariantlayoutv0-variant-id variant))
    (optional-id-in? (unionvariantlayoutv0-payload-type variant) known-types)
    (>= (unionvariantlayoutv0-payload-offset-bytes variant) 0)))

(defn layout-shape-refs-closed?
  [shape :- LayoutShapeV0
   known-members :- (Vec NativeId)
   known-types :- (Vec NativeId)] :- Bool
  (match shape
    [(ScalarShapeV0 representation) true]
    [(BytesShapeV0 token) true]
    [(RecordShapeV0 fields)
     (every? (fn [field :- FieldLayoutV0] :- Bool (field-layout-refs-closed? field known-members known-types)) fields)]
    [(UnionShapeV0 tag-type tag-offset-bytes variants)
     (and (id-in? known-types tag-type)
       (>= tag-offset-bytes 0)
       (every? (fn [variant :- UnionVariantLayoutV0] :- Bool (union-variant-layout-refs-closed? variant known-members known-types)) variants))]
    [(VectorShapeV0 element-type stride-bytes)
     (and (id-in? known-types element-type) (> stride-bytes 0))]
    [(MapShapeV0 key-type key-stride-bytes key-align-bytes
       value-type value-stride-bytes value-align-bytes iteration-order)
     (and (id-in? known-types key-type)
       (> key-stride-bytes 0)
       (> key-align-bytes 0)
       (id-in? known-types value-type)
       (> value-stride-bytes 0)
       (> value-align-bytes 0))]
    [(SetShapeV0 element-type stride-bytes align-bytes iteration-order)
     (and (id-in? known-types element-type)
       (> stride-bytes 0)
       (> align-bytes 0))]
    [(ReferenceShapeV0 target-type) (id-in? known-types target-type)]
    [(AtomCellShapeV0 content-type) (id-in? known-types content-type)]))

(defn layout-refs-closed?
  [layout :- LayoutDef
   known-members :- (Vec NativeId)
   known-types :- (Vec NativeId)] :- Bool
  (and (id-in? known-types (layoutdef-type-id layout))
    (>= (layoutdef-size-bytes layout) 0)
    (> (layoutdef-align-bytes layout) 0)
    (layout-shape-refs-closed? (layoutdef-shape layout) known-members known-types)))

(defn layouts-refs-closed?
  [layouts :- (Vec LayoutDef)
   types :- (Vec TypeDef)] :- Bool
  (let [known-types :- (Vec NativeId) (type-ids types) known-members :- (Vec NativeId) (type-member-ids types)]
    (every? (fn [layout :- LayoutDef] :- Bool (layout-refs-closed? layout known-members known-types))
      layouts)))

(defn basic-block-ids [blocks :- (Vec BasicBlock)] :- (Vec NativeId)
  (mapv (fn [block :- BasicBlock] :- NativeId (basicblock-id block)) blocks))

(defn native-atom-refs-closed?
  [atom :- NativeAtom
   known-owned :- (Vec NativeId)] :- Bool
  (match atom
    [(BoolAtom value) true]
    [(I64Atom value) true]
    [(F64Atom value) true]
    [(TextAtom value) true]
    [(KeywordAtom value) true]
    [(RefAtom target) (id-in? known-owned target)]))

(defn store-op-resources-closed?
  [store :- StoreOp
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)] :- Bool
  (match store
    [(StoreBool address value region capability) (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(StoreI64 address value region capability) (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(StoreF64 address value region capability) (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(StoreText address value region capability) (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(StoreRef address value region capability) (and (id-in? known-regions region) (id-in? known-capabilities capability))]))

(defn instruction-semantic-refs-closed?
  [instruction :- Instruction
   known-functions :- (Vec NativeId)
   known-abis :- (Vec NativeId)
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)
   known-types :- (Vec NativeId)
   known-owned :- (Vec NativeId)] :- Bool
  (match instruction
    [(AtomInstruction result atom) (native-atom-refs-closed? atom known-owned)]
    [(CopyInstruction result source-id) true]
    [(AddF64Instruction result left-id right-id) true]
    [(CheckedInstruction result operation) true]
    [(BitwiseInstructionV0 result operation) true]
    [(StoreInstruction result store tokens)
     (store-op-resources-closed? store known-regions known-capabilities)]
    [(AllocateInstruction result region capability byte-count-id tokens)
     (and (id-in? known-regions region)
       (id-in? known-capabilities capability))]
    [(CallInstruction result function-id arguments tokens)
     (id-in? known-functions function-id)]
    [(ExternCallInstruction result abi-id arguments arena-id tokens)
     (id-in? known-abis abi-id)]
    [(CompareInstruction result comparison left-id right-id) true]
    [(FieldInstruction result source-id field-id) (id-in? known-owned field-id)]
    [(VariantValueInstruction result source-id variant-id)
     (id-in? known-owned variant-id)]
    [(RecordInstruction result field-ids) true]
    [(RecordAssocInstructionV0 result source-id field-id value-id arena-id)
     (id-in? known-owned field-id)]
    [(BoxRecordInstruction result source-id arena-id) true]
    [(RecordMaterializeInstructionV0 result source-id) true]
    [(UnionConstructInstruction result variant-id payload-id)
     (id-in? known-owned variant-id)]
    [(UnionExtractInstruction result source-id variant-id)
     (id-in? known-owned variant-id)]
    [(VecLengthInstruction result source-id) true]
    [(VecGetInstruction result source-id index-id) true]
    [(VecPushInstruction result source-id value-id arena-id) true]
    [(VecEmptyInstruction result capacity-id arena-id) true]
    [(VecConcatInstruction result left-id right-id arena-id) true]
    [(VecSliceInstructionV0 result source-id start-id end-id arena-id) true]
    [(VecReverseInstructionV0 result source-id arena-id) true]
    [(MapLiteralInstructionV0 result key-ids value-ids arena-id key-equality)
     (= (count key-ids) (count value-ids))]
    [(SetLiteralInstructionV0 result value-ids arena-id element-equality) true]
    [(MapCountInstructionV0 result source-id) true]
    [(MapGetInstructionV0 result source-id key-id default-id key-equality) true]
    [(MapContainsInstructionV0 result source-id key-id key-equality) true]
    [(MapAssocInstructionV0 result source-id key-id value-id arena-id key-equality)
     true]
    [(MapDissocInstructionV0 result source-id key-id arena-id key-equality) true]
    [(MapKeysInstructionV0 result source-id arena-id) true]
    [(MapValuesInstructionV0 result source-id arena-id) true]
    [(SetCountInstructionV0 result source-id) true]
    [(SetContainsInstructionV0 result source-id value-id element-equality) true]
    [(SetConjInstructionV0 result source-id value-id arena-id element-equality) true]
    [(SetDisjInstructionV0 result source-id value-id arena-id element-equality) true]
    [(SetVectorInstructionV0 result source-id arena-id) true]
    [(ArenaInstruction result region capability tokens)
     (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(AtomStateInstruction result region capability tokens)
     (and (id-in? known-regions region) (id-in? known-capabilities capability))]
    [(AtomCreateInstruction result initial-id arena-id state-id) true]
    [(AtomDerefInstruction result cell-id state-id) true]
    [(AtomSwapInstruction result cell-id state-id updater-id arguments)
     (id-in? known-functions updater-id)]
    [(TextLengthInstruction result source-id) true]
    [(TextIndexOfInstruction result source-id needle-id) true]
    [(TextBlankInstruction result source-id) true]
    [(TextParseI64Instruction result source-id) true]
    [(TextSliceInstruction result arena-id source-id start-id end-id failure-code)
     true]
    [(TextConcatInstruction result arena-id operand-ids) true]
    [(TextBuiltinInstruction result operation) true]
    [(ValueSemanticsInstruction result operation)
     (match operation
       [(ValueEqualV0 domain-type left-id right-id)
        (id-in? known-types domain-type)]
       [(ValueHashV0 domain-type value-id)
        (id-in? known-types domain-type)]
       [(ValueCompareV0 domain-type left-id right-id)
        (id-in? known-types domain-type)])]
    [(ValueToTextInstructionV0 result mode domain-type value-id arena-id)
     (id-in? known-types domain-type)]
    [(CodecPrimitiveInstructionV0 result operation) true]))

(defn parameter-types-closed?
  [parameters :- (Vec Parameter)
   known-types :- (Vec NativeId)] :- Bool
  (every? (fn [parameter :- Parameter] :- Bool (id-in? known-types (parameter-type-id parameter)))
    parameters))

(defn terminator-block-refs-closed?
  [terminator :- Terminator
   known-blocks :- (Vec NativeId)] :- Bool
  (match terminator
    [(ReturnTerminator value) true]
    [(JumpTerminator block-id arguments) (id-in? known-blocks block-id)]
    [(BranchTerminator condition true-block false-block)
     (and (id-in? known-blocks true-block) (id-in? known-blocks false-block))]
    [(SwitchTerminator value-id cases)
     (every? (fn [switch-case :- SwitchCaseV0] :- Bool (id-in? known-blocks (switchcasev0-block-id switch-case))) cases)]
    [(TrapTerminator failure-id) true]))

(defn block-reference-closed?
  [block :- BasicBlock
   known-types :- (Vec NativeId)
   known-functions :- (Vec NativeId)
   known-abis :- (Vec NativeId)
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)
   known-owned :- (Vec NativeId)
   known-blocks :- (Vec NativeId)] :- Bool
  (and (parameter-types-closed? (basicblock-parameters block) known-types)
    (every? (fn [instruction :- Instruction] :- Bool (instruction-semantic-refs-closed? instruction known-functions known-abis known-regions known-capabilities known-types known-owned))
      (basicblock-instructions block))
    (every? (fn [terminator :- Terminator] :- Bool (terminator-block-refs-closed? terminator known-blocks))
      (basicblock-terminators block))))

(defn function-reference-closed?
  [function :- FunctionDef
   types :- (Vec TypeDef)
   known-types :- (Vec NativeId)
   known-effects :- (Vec NativeId)
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)
   known-functions :- (Vec NativeId)
   known-abis :- (Vec NativeId)
   known-owned :- (Vec NativeId)] :- Bool
  (let [blocks :- (Vec BasicBlock) (functiondef-blocks function) known-blocks :- (Vec NativeId) (basic-block-ids blocks)]
    (and (parameter-types-closed? (functiondef-parameters function) known-types)
      (optional-id-in? (functiondef-return-type function) known-types)
      (id-in? known-blocks (functiondef-entry-block function))
      (ids-in? (functiondef-effects function) known-effects)
      (ids-in? (functiondef-regions function) known-regions)
      (ids-in? (functiondef-capabilities function) known-capabilities)
      (function-record-assocs-valid? types function)
      (function-record-materializations-valid? types function)
      (every? (fn [block :- BasicBlock] :- Bool (block-reference-closed? block known-types known-functions known-abis known-regions known-capabilities known-owned known-blocks))
        blocks))))

(defn functions-reference-closed?
  [functions :- (Vec FunctionDef)
   types :- (Vec TypeDef)
   known-types :- (Vec NativeId)
   known-effects :- (Vec NativeId)
   known-regions :- (Vec NativeId)
   known-capabilities :- (Vec NativeId)
   known-abis :- (Vec NativeId)
   known-owned :- (Vec NativeId)] :- Bool
  (let [known-functions :- (Vec NativeId) (function-ids functions)]
    (every? (fn [function :- FunctionDef] :- Bool (function-reference-closed? function types known-types known-effects known-regions known-capabilities known-functions known-abis known-owned))
      functions)))

(defn world-reference-closed? [world :- NativeWorld] :- Bool
  (let [types :- (Vec TypeDef) (nativeworld-types world) effects :- (Vec EffectDef) (nativeworld-effects world) regions :- (Vec RegionDef) (nativeworld-regions world) capabilities :- (Vec CapabilityDef) (nativeworld-capabilities world) known-types :- (Vec NativeId) (type-ids types) known-effects :- (Vec NativeId) (effect-ids effects) known-regions :- (Vec NativeId) (region-ids regions) known-capabilities :- (Vec NativeId) (capability-ids capabilities) known-abis :- (Vec NativeId) (abi-ids (nativeworld-abis world)) known-owned :- (Vec NativeId) (world-owned-ids world)]
    (and (types-refs-closed? types)
      (effects-refs-closed? effects known-regions known-capabilities)
      (regions-refs-closed? regions)
      (capabilities-refs-closed? capabilities known-regions)
      (layouts-refs-closed? (nativeworld-layouts world) types)
      (functions-reference-closed? (nativeworld-functions world)
        types
        known-types
        known-effects
        known-regions
        known-capabilities
        known-abis
        known-owned))))

(defn store-op-ssa-refs [store :- StoreOp] :- (Vec NativeId)
  (match store
    [(StoreBool address value region capability) [address value]]
    [(StoreI64 address value region capability) [address value]]
    [(StoreF64 address value region capability) [address value]]
    [(StoreText address value region capability) [address value]]
    [(StoreRef address value region capability) [address value]]))

(defn checked-operation-ssa-refs [operation :- CheckedOperationV0] :- (Vec NativeId)
  (match operation
    [(CheckedAddI64V0 left-id right-id) [left-id right-id]]
    [(CheckedSubI64V0 left-id right-id) [left-id right-id]]
    [(CheckedMulI64V0 left-id right-id) [left-id right-id]]
    [(CheckedQuotI64V0 left-id right-id) [left-id right-id]]
    [(CheckedRemI64V0 left-id right-id) [left-id right-id]]
    [(CheckedModI64V0 left-id right-id) [left-id right-id]]
    [(CheckedBoundsV0 index-id length-id) [index-id length-id]]))

(defn bitwise-operation-ssa-refs [operation: BitwiseOperationV0] -> (Vec NativeId)
  (match operation
    [(BitAndI64V0 left-id right-id) [left-id right-id]]
    [(BitXorI64V0 left-id right-id) [left-id right-id]]
    [(BitShiftLeftI64V0 value-id distance-id) [value-id distance-id]]))

(defn switch-case-ssa-refs [cases :- (Vec SwitchCaseV0)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count cases))
      ids
      (recur (+ index 1)
        (append-ids ids (switchcasev0-arguments (nth cases index)))))))

(defn text-builtin-ssa-refs [operation: TextBuiltinOpV0] -> (Vec NativeId)
  (match operation
    [(TextCompareV0 left-id right-id) [left-id right-id]]
    [(TextTrimV0 arena-id source-id) [arena-id source-id]]
    [(TextLowerV0 arena-id source-id) [arena-id source-id]]
    [(TextRegexReplaceV0 arena-id source-id pattern-id replacement-id)
     [arena-id source-id pattern-id replacement-id]]
    [(TextRegexMatchesV0 source-id pattern-id) [source-id pattern-id]]
    [(TextRegexFindV0 arena-id source-id pattern-id)
     [arena-id source-id pattern-id]]
    [(TextSplitV0 arena-id source-id pattern-id)
     [arena-id source-id pattern-id]]
    [(TextVectorTrimV0 arena-id source-id) [arena-id source-id]]
    [(TextVectorRemoveBlankV0 arena-id source-id) [arena-id source-id]]
    [(TextJoinV0 arena-id separator-id source-id)
     [arena-id separator-id source-id]]
    [(TextRepeatV0 arena-id source-id count-id)
     [arena-id source-id count-id]]))

(defn codec-primitive-ssa-refs [operation: CodecPrimitiveOpV0] -> (Vec NativeId)
  (match operation
    [(Utf8EncodeV0 arena-id source-id) [arena-id source-id]]
    [(Utf8DecodeV0 arena-id source-id) [arena-id source-id]]
    [(Sha256BytesV0 arena-id source-id) [arena-id source-id]]
    [(FloatToBitsV0 source-id) [source-id]]
    [(FloatFromBitsV0 source-id) [source-id]]))

(defn instruction-ssa-refs [instruction :- Instruction] :- (Vec NativeId)
  (match instruction
    [(AtomInstruction result atom) []]
    [(CopyInstruction result source-id) [source-id]]
    [(AddF64Instruction result left-id right-id) [left-id right-id]]
    [(CheckedInstruction result operation) (checked-operation-ssa-refs operation)]
    [(BitwiseInstructionV0 result operation)
     (bitwise-operation-ssa-refs operation)]
    [(StoreInstruction result store tokens) (store-op-ssa-refs store)]
    [(AllocateInstruction result region capability byte-count-id tokens)
     [byte-count-id]]
    [(CallInstruction result function-id arguments tokens) arguments]
    [(ExternCallInstruction result abi-id arguments arena-id tokens)
     (if (nil? arena-id) arguments (into arguments [arena-id]))]
    [(CompareInstruction result comparison left-id right-id) [left-id right-id]]
    [(FieldInstruction result source-id field-id) [source-id]]
    [(VariantValueInstruction result source-id variant-id) [source-id]]
    [(RecordInstruction result field-ids) field-ids]
    [(RecordAssocInstructionV0 result source-id field-id value-id arena-id)
     [arena-id source-id value-id]]
    [(BoxRecordInstruction result source-id arena-id) [arena-id source-id]]
    [(RecordMaterializeInstructionV0 result source-id) [source-id]]
    [(UnionConstructInstruction result variant-id payload-id)
     (if (nil? payload-id) [] [payload-id])]
    [(UnionExtractInstruction result source-id variant-id) [source-id]]
    [(VecLengthInstruction result source-id) [source-id]]
    [(VecGetInstruction result source-id index-id) [source-id index-id]]
    [(VecPushInstruction result source-id value-id arena-id)
     [arena-id source-id value-id]]
    [(VecEmptyInstruction result capacity-id arena-id) [arena-id capacity-id]]
    [(VecConcatInstruction result left-id right-id arena-id)
     [arena-id left-id right-id]]
    [(VecSliceInstructionV0 result source-id start-id end-id arena-id)
     [arena-id source-id start-id end-id]]
    [(VecReverseInstructionV0 result source-id arena-id)
     [arena-id source-id]]
    [(MapLiteralInstructionV0 result key-ids value-ids arena-id key-equality)
     (into [arena-id] (vec (concat key-ids value-ids)))]
    [(SetLiteralInstructionV0 result value-ids arena-id element-equality)
     (into [arena-id] value-ids)]
    [(MapCountInstructionV0 result source-id) [source-id]]
    [(MapGetInstructionV0 result source-id key-id default-id key-equality)
     (if (nil? default-id) [source-id key-id]
       [source-id key-id default-id])]
    [(MapContainsInstructionV0 result source-id key-id key-equality)
     [source-id key-id]]
    [(MapAssocInstructionV0 result source-id key-id value-id arena-id key-equality)
     [arena-id source-id key-id value-id]]
    [(MapDissocInstructionV0 result source-id key-id arena-id key-equality)
     [arena-id source-id key-id]]
    [(MapKeysInstructionV0 result source-id arena-id) [arena-id source-id]]
    [(MapValuesInstructionV0 result source-id arena-id) [arena-id source-id]]
    [(SetCountInstructionV0 result source-id) [source-id]]
    [(SetContainsInstructionV0 result source-id value-id element-equality)
     [source-id value-id]]
    [(SetConjInstructionV0 result source-id value-id arena-id element-equality)
     [arena-id source-id value-id]]
    [(SetDisjInstructionV0 result source-id value-id arena-id element-equality)
     [arena-id source-id value-id]]
    [(SetVectorInstructionV0 result source-id arena-id) [arena-id source-id]]
    [(ArenaInstruction result region capability tokens) []]
    [(AtomStateInstruction result region capability tokens) []]
    [(AtomCreateInstruction result initial-id arena-id state-id)
     [initial-id arena-id state-id]]
    [(AtomDerefInstruction result cell-id state-id) [cell-id state-id]]
    [(AtomSwapInstruction result cell-id state-id updater-id arguments)
     (into [cell-id state-id] arguments)]
    [(TextLengthInstruction result source-id) [source-id]]
    [(TextIndexOfInstruction result source-id needle-id) [source-id needle-id]]
    [(TextBlankInstruction result source-id) [source-id]]
    [(TextParseI64Instruction result source-id) [source-id]]
    [(TextSliceInstruction result arena-id source-id start-id end-id failure-code)
     [arena-id source-id start-id end-id]]
    [(TextConcatInstruction result arena-id operand-ids)
     (into [arena-id] operand-ids)]
    [(TextBuiltinInstruction result operation)
     (text-builtin-ssa-refs operation)]
    [(ValueSemanticsInstruction result operation)
     (match operation
       [(ValueEqualV0 domain-type left-id right-id) [left-id right-id]]
       [(ValueHashV0 domain-type value-id) [value-id]]
       [(ValueCompareV0 domain-type left-id right-id) [left-id right-id]])]
    [(ValueToTextInstructionV0 result mode domain-type value-id arena-id)
     [arena-id value-id]]
    [(CodecPrimitiveInstructionV0 result operation)
     (codec-primitive-ssa-refs operation)]))

(defn terminator-ssa-refs [terminator :- Terminator] :- (Vec NativeId)
  (match terminator
    [(ReturnTerminator value) (if (nil? value) [] [value])]
    [(JumpTerminator block-id arguments) arguments]
    [(BranchTerminator condition true-block false-block) [condition]]
    [(SwitchTerminator value-id cases)
     (into [value-id] (switch-case-ssa-refs cases))]
    [(TrapTerminator failure-id) [failure-id]]))

(defn block-value-ids [block :- BasicBlock] :- (Vec NativeId)
  (append-ids (parameter-ids (basicblock-parameters block))
    (instruction-result-ids (basicblock-instructions block))))

(defn all-block-value-ids [blocks :- (Vec BasicBlock)] :- (Vec NativeId)
  (loop [index :- Int 0 ids :- (Vec NativeId) []]
    (if (>= index (count blocks))
      ids
      (recur (+ index 1) (append-ids ids (block-value-ids (nth blocks index)))))))

(defn function-value-ids [function :- FunctionDef] :- (Vec NativeId)
  (append-ids (parameter-ids (functiondef-parameters function))
    (all-block-value-ids (functiondef-blocks function))))

(defn block-ssa-closed?
  [block :- BasicBlock
   known-values :- (Vec NativeId)] :- Bool
  (and (every? (fn [instruction :- Instruction] :- Bool (ids-in? (instruction-ssa-refs instruction) known-values)) (basicblock-instructions block))
    (every? (fn [terminator :- Terminator] :- Bool (ids-in? (terminator-ssa-refs terminator) known-values))
      (basicblock-terminators block))))

(defn function-ssa-closed? [function :- FunctionDef] :- Bool
  (let [known-values :- (Vec NativeId) (function-value-ids function)]
    (and (unique-ids? known-values)
      (every? (fn [block :- BasicBlock] :- Bool (block-ssa-closed? block known-values))
        (functiondef-blocks function)))))

(defn world-ssa-closed? [world :- NativeWorld] :- Bool
  (every? (fn [function :- FunctionDef] :- Bool (function-ssa-closed? function))
    (nativeworld-functions world)))

(defn functions-single-terminator? [functions :- (Vec FunctionDef)] :- Bool
  (every? (fn [function :- FunctionDef] :- Bool (every? (fn [block :- BasicBlock] :- Bool (= 1 (count (basicblock-terminators block)))) (functiondef-blocks function)))
    functions))

(defn instruction-resources-allowed?
  [instruction :- Instruction
   allowed-regions :- (Vec NativeId)
   allowed-capabilities :- (Vec NativeId)] :- Bool
  (match instruction
    [(AtomInstruction result atom) true]
    [(CopyInstruction result source-id) true]
    [(AddF64Instruction result left-id right-id) true]
    [(CheckedInstruction result operation) true]
    [(BitwiseInstructionV0 result operation) true]
    [(StoreInstruction result store tokens)
     (store-op-resources-closed? store allowed-regions allowed-capabilities)]
    [(AllocateInstruction result region capability byte-count-id tokens)
     (and (id-in? allowed-regions region)
       (id-in? allowed-capabilities capability))]
    [(CallInstruction result function-id arguments tokens) true]
    [(ExternCallInstruction result abi-id arguments arena-id tokens) true]
    [(CompareInstruction result comparison left-id right-id) true]
    [(FieldInstruction result source-id field-id) true]
    [(VariantValueInstruction result source-id variant-id) true]
    [(RecordInstruction result field-ids) true]
    [(RecordAssocInstructionV0 result source-id field-id value-id arena-id) true]
    [(BoxRecordInstruction result source-id arena-id) true]
    [(RecordMaterializeInstructionV0 result source-id) true]
    [(UnionConstructInstruction result variant-id payload-id) true]
    [(UnionExtractInstruction result source-id variant-id) true]
    [(VecLengthInstruction result source-id) true]
    [(VecGetInstruction result source-id index-id) true]
    [(VecPushInstruction result source-id value-id arena-id) true]
    [(VecEmptyInstruction result capacity-id arena-id) true]
    [(VecConcatInstruction result left-id right-id arena-id) true]
    [(VecSliceInstructionV0 result source-id start-id end-id arena-id) true]
    [(VecReverseInstructionV0 result source-id arena-id) true]
    [(MapLiteralInstructionV0 result key-ids value-ids arena-id key-equality) true]
    [(SetLiteralInstructionV0 result value-ids arena-id element-equality) true]
    [(MapCountInstructionV0 result source-id) true]
    [(MapGetInstructionV0 result source-id key-id default-id key-equality) true]
    [(MapContainsInstructionV0 result source-id key-id key-equality) true]
    [(MapAssocInstructionV0 result source-id key-id value-id arena-id key-equality)
     true]
    [(MapDissocInstructionV0 result source-id key-id arena-id key-equality) true]
    [(MapKeysInstructionV0 result source-id arena-id) true]
    [(MapValuesInstructionV0 result source-id arena-id) true]
    [(SetCountInstructionV0 result source-id) true]
    [(SetContainsInstructionV0 result source-id value-id element-equality) true]
    [(SetConjInstructionV0 result source-id value-id arena-id element-equality) true]
    [(SetDisjInstructionV0 result source-id value-id arena-id element-equality) true]
    [(SetVectorInstructionV0 result source-id arena-id) true]
    [(ArenaInstruction result region capability tokens)
     (and (id-in? allowed-regions region)
       (id-in? allowed-capabilities capability))]
    [(AtomStateInstruction result region capability tokens)
     (and (id-in? allowed-regions region)
       (id-in? allowed-capabilities capability))]
    [(AtomCreateInstruction result initial-id arena-id state-id) true]
    [(AtomDerefInstruction result cell-id state-id) true]
    [(AtomSwapInstruction result cell-id state-id updater-id arguments) true]
    [(TextLengthInstruction result source-id) true]
    [(TextIndexOfInstruction result source-id needle-id) true]
    [(TextBlankInstruction result source-id) true]
    [(TextParseI64Instruction result source-id) true]
    [(TextSliceInstruction result arena-id source-id start-id end-id failure-code)
     true]
    [(TextConcatInstruction result arena-id operand-ids) true]
    [(TextBuiltinInstruction result operation) true]
    [(ValueSemanticsInstruction result operation) true]
    [(ValueToTextInstructionV0 result mode domain-type value-id arena-id) true]
    [(CodecPrimitiveInstructionV0 result operation) true]))

(defn block-resources-allowed?
  [block :- BasicBlock
   allowed-regions :- (Vec NativeId)
   allowed-capabilities :- (Vec NativeId)] :- Bool
  (every? (fn [instruction :- Instruction] :- Bool (instruction-resources-allowed? instruction allowed-regions allowed-capabilities))
    (basicblock-instructions block)))

(defn function-uses-allowed?
  [function :- FunctionDef
   allowed-effects :- (Vec NativeId)
   allowed-regions :- (Vec NativeId)
   allowed-capabilities :- (Vec NativeId)] :- Bool
  (and (ids-in? (functiondef-effects function) allowed-effects)
    (ids-in? (functiondef-regions function) allowed-regions)
    (ids-in? (functiondef-capabilities function) allowed-capabilities)
    (every? (fn [block :- BasicBlock] :- Bool (block-resources-allowed? block allowed-regions allowed-capabilities))
      (functiondef-blocks function))))

(defn world-allowed-sets-valid? [world :- NativeWorld] :- Bool
  (let [allowed-effects :- (Vec NativeId) (nativeworld-allowed-effects world) allowed-regions :- (Vec NativeId) (nativeworld-allowed-regions world) allowed-capabilities :- (Vec NativeId) (nativeworld-allowed-capabilities world)]
    (and (unique-ids? allowed-effects)
      (unique-ids? allowed-regions)
      (unique-ids? allowed-capabilities)
      (ids-in? allowed-effects (effect-ids (nativeworld-effects world)))
      (ids-in? allowed-regions (region-ids (nativeworld-regions world)))
      (ids-in? allowed-capabilities
        (capability-ids (nativeworld-capabilities world)))
      (every? (fn [function :- FunctionDef] :- Bool (function-uses-allowed? function allowed-effects allowed-regions allowed-capabilities))
        (nativeworld-functions world)))))

(defn world-unique-ids? [world :- NativeWorld] :- Bool
  (unique-ids? (world-owned-ids world)))

(defn validate-world [world :- NativeWorld] :- ValidationReport
  (let [unique-pass :- Bool (world-unique-ids? world) allowed-pass :- Bool (world-allowed-sets-valid? world) reference-pass :- Bool (world-reference-closed? world) terminator-pass :- Bool (functions-single-terminator? (nativeworld-functions world)) ssa-pass :- Bool (world-ssa-closed? world) valid-ssa-pass :- Bool (and unique-pass reference-pass terminator-pass ssa-pass) results :- (Vec ObligationResult) [(->ObligationResult (->ValidSsaObligation true) valid-ssa-pass "IDs, references, terminators, and SSA uses form a closed function graph") (->ObligationResult (->BoundedEffectsObligation true) allowed-pass "declared resource use stays inside closed allowed sets")]]
    (->ValidationReport (and unique-pass allowed-pass reference-pass terminator-pass ssa-pass)
      results)))

(defn i64-kind [] :- AtomKind (->I64Kind true))

(defn f64-kind [] :- AtomKind (->F64Kind true))

(defn atom-type-shape [kind :- AtomKind] :- TypeShape (->AtomType kind))

(defn arena-region-kind [] :- RegionKind (->ArenaRegion true))

(defn write-capability-kind [] :- CapabilityKind (->WriteCapability true))

(defn write-effect-kind [region :- NativeId] :- EffectKind
  (->WriteEffect region))

(defn store-i64-op
  [address :- NativeId
   value :- NativeId
   region :- NativeId
   capability :- NativeId] :- StoreOp
  (->StoreI64 address value region capability))

(defn store-f64-op
  [address :- NativeId
   value :- NativeId
   region :- NativeId
   capability :- NativeId] :- StoreOp
  (->StoreF64 address value region capability))

(defn store-instruction
  [result-id :- NativeId
   result-type-id :- NativeId
   store :- StoreOp] :- Instruction
  (->StoreInstruction (->SsaValueV0 result-id result-type-id)
    store
    (->TokenFlowV0 [] [])))

(defn copy-instruction
  [result-id :- NativeId
   result-type-id :- NativeId
   source-id :- NativeId] :- Instruction
  (->CopyInstruction (->SsaValueV0 result-id result-type-id) source-id))

(defn return-terminator [value :- (U NativeId Nil)] :- Terminator
  (->ReturnTerminator value))

(defn fri2-observation
  [artifact-id :- NativeId
   digest :- String
   byte-count :- Int] :- ExternalObservation
  (->Fri2Observation artifact-id digest byte-count))
