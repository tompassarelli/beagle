#lang beagle/clj
;; @upstream:text-arm — operator-authorized for Native Stage 3; re-ingest this
;; module into the graph after landing. Authority: North thread 019fbd6c.
(ns native.slice
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.obligations :as obligations]
            [native.c11 :as c11]))


;; One row of the canonical source-fact projection: subject and object name
;; source nodes by ordinal; kind "t" carries literal text and "e" its escaped
;; delimiter-safe spelling.
(defrecord SliceFactV0
  [(subject String)
   (predicate String)
   (kind String)
   (object String)])

(defrecord UniqueStringsV0 [(values (Vec String)) (seen (Map String Bool))])

(defrecord SliceProjectionV0
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))])

(defn char-at [(text String) (index Int)] String
  (subs text index (+ index 1)))

(defn split-on [(text String) (separator String)] (Vec String)
  (loop [index Int 0 start Int 0 parts (Vec String) []]
    (if (>= index (count text))
      (conj parts (subs text start index))
      (if (= separator (char-at text index))
        (recur (+ index 1) (+ index 1) (conj parts (subs text start index)))
        (recur (+ index 1) start parts)))))

(defn escaped-text [(value String)] String
  (loop [index Int 0 decoded String ""]
    (if (>= index (count value))
      decoded
      (let [(character String) (char-at value index)]
        (if (= character "\\")
          (if (>= (+ index 1) (count value))
            (str decoded "\\")
            (let [(escape String) (char-at value (+ index 1))]
              (recur (+ index 2)
                (str decoded
                  (cond
                    (= escape "s") " "
                    (= escape "t") "\t"
                    (= escape "n") "\n"
                    (= escape "r") "\r"
                    (= escape "z") ""
                    (= escape "\\") "\\"
                    :else (str "\\" escape))))))
          (recur (+ index 1) (str decoded character)))))))

(defn text-row? [(row SliceFactV0)] Bool
  (or (= "t" (slicefactv0-kind row)) (= "e" (slicefactv0-kind row))))

(defn row-text [(row SliceFactV0)] String
  (if (= "e" (slicefactv0-kind row))
    (escaped-text (slicefactv0-object row))
    (slicefactv0-object row)))

(defn parse-row [(line String)] (Vec SliceFactV0)
  (let [(cells (Vec String)) (split-on line "\t")]
    (if (= 4 (count cells))
      [(->SliceFactV0 (nth cells 0) (nth cells 1) (nth cells 2) (nth cells 3))]
      [])))

(defn parse-facts [(text String)] (Vec SliceFactV0)
  (let [(lines (Vec String)) (split-on text "\n")]
    (loop [index Int 0 rows (Vec SliceFactV0) []]
      (if (>= index (count lines))
        rows
        (let [(parsed (Vec SliceFactV0)) (parse-row (nth lines index))]
          (recur (+ index 1)
            (if (= 0 (count parsed)) rows (conj rows (nth parsed 0)))))))))

(defn add-unique-string
  [(unique UniqueStringsV0)
   (candidate String)] UniqueStringsV0
  (if (= true (get (uniquestringsv0-seen unique) candidate))
    unique
    (->UniqueStringsV0
      (conj (uniquestringsv0-values unique) candidate)
      (assoc (uniquestringsv0-seen unique) candidate true))))

(defn node-names [(rows (Vec SliceFactV0))] (Vec String)
  (loop [index Int 0 unique UniqueStringsV0 (->UniqueStringsV0 [] {})]
    (if (>= index (count rows))
      (uniquestringsv0-values unique)
      (let [(row SliceFactV0) (nth rows index)
            (with-subject UniqueStringsV0)
            (add-unique-string unique (slicefactv0-subject row))]
        (recur (+ index 1)
          (if (text-row? row)
            with-subject
            (add-unique-string with-subject (slicefactv0-object row))))))))

(defn text-values [(rows (Vec SliceFactV0))] (Vec String)
  (loop [index Int 0 unique UniqueStringsV0 (->UniqueStringsV0 [] {})]
    (if (>= index (count rows))
      (uniquestringsv0-values unique)
      (let [(row SliceFactV0) (nth rows index)
            (with-predicate UniqueStringsV0)
            (add-unique-string unique (slicefactv0-predicate row))]
        (recur (+ index 1)
          (if (text-row? row)
            (add-unique-string with-predicate (row-text row))
            with-predicate))))))

(defn slice-id [(domain String) (parts (Vec String))] core/NativeId
  (core/canonical-id (str "native-slice-v0/" domain) parts))

(defn node-id [(name String)] core/NativeId (slice-id "node" [name]))

(defn text-id [(value String)] core/NativeId (slice-id "text" [value]))

(defn marker-nodes [(names (Vec String))] (Vec stages/TermNodeV0)
  (mapv
    (fn [(name String)] stages/TermNodeV0
      (stages/->TermNodeV0 (node-id name) (stages/->TextTermV0 "source-node-v0")))
    names))

(defn text-nodes [(values (Vec String))] (Vec stages/TermNodeV0)
  (mapv
    (fn [(value String)] stages/TermNodeV0
      (stages/->TermNodeV0 (text-id value) (stages/->TextTermV0 value)))
    values))

(defn fact-nodes [(rows (Vec SliceFactV0))] (Vec stages/TermNodeV0)
  (loop [index Int 0 nodes (Vec stages/TermNodeV0) []]
    (if (>= index (count rows))
      nodes
      (let [(row SliceFactV0) (nth rows index)
            (object core/NativeId)
            (if (text-row? row)
              (text-id (row-text row))
              (node-id (slicefactv0-object row)))]
        (recur (+ index 1)
          (conj nodes
            (stages/->TermNodeV0
              (slice-id "fact" [(str index)])
              (stages/->TripleTermV0
                (node-id (slicefactv0-subject row))
                (text-id (slicefactv0-predicate row))
                object))))))))

(defn row-first-text
  [(rows (Vec SliceFactV0))
   (subject String)
   (predicate String)] (U String Nil)
  (loop [position Int 0]
    (if (>= position (count rows))
      nil
      (let [(row SliceFactV0) (nth rows position)]
        (if (and (= subject (slicefactv0-subject row))
                 (= predicate (slicefactv0-predicate row))
                 (text-row? row))
          (row-text row)
          (recur (+ position 1)))))))

(defn row-node-objects
  [(rows (Vec SliceFactV0))
   (subject String)
   (predicate String)] (Vec String)
  (loop [position Int 0 objects (Vec String) []]
    (if (>= position (count rows))
      objects
      (let [(row SliceFactV0) (nth rows position)]
        (recur (+ position 1)
          (if (and (= subject (slicefactv0-subject row))
                   (= predicate (slicefactv0-predicate row))
                   (not (text-row? row)))
            (conj objects (slicefactv0-object row))
            objects))))))

(defn form-node-names [(rows (Vec SliceFactV0)) (kind String)] (Vec String)
  (loop [position Int 0 selected (Vec String) []]
    (if (>= position (count rows))
      selected
      (let [(row SliceFactV0) (nth rows position)]
        (recur (+ position 1)
          (if (and (= "form-kind" (slicefactv0-predicate row))
                   (text-row? row)
                   (= kind (row-text row)))
            (conj selected (slicefactv0-subject row))
            selected))))))

(defn source-module
  [(rows (Vec SliceFactV0))
   (root-name String)
   (fallback-name String)
   (fallback-path String)] stages/SourceModuleV1
  (let [(declared-name (U String Nil)) (row-first-text rows root-name "namespace")
        (declared-path (U String Nil)) (row-first-text rows root-name "relative-path")
        (source-digest (U String Nil))
        (row-first-text rows root-name "source-sha256")
        (projection-digest (U String Nil))
        (row-first-text rows root-name "checked-projection-sha256")
        (interface-digest (U String Nil))
        (row-first-text rows root-name "interface-sha256")
        (module-name String)
        (if (or (nil? declared-name) (= "" declared-name)) fallback-name declared-name)
        (relative-path String)
        (if (or (nil? declared-path) (= "" declared-path)) fallback-path declared-path)]
    (stages/->SourceModuleV1
      (slice-id "module" [module-name relative-path])
      module-name
      relative-path
      (if (nil? source-digest) "" source-digest)
      (if (nil? projection-digest) "" projection-digest)
      (if (nil? interface-digest) "" interface-digest)
      (node-id root-name))))

(defn source-modules
  [(rows (Vec SliceFactV0))
   (fallback-name String)
   (fallback-path String)] (Vec stages/SourceModuleV1)
  (let [(roots (Vec String)) (form-node-names rows "module-root")]
    (if (= 0 (count roots))
      [(source-module rows "0" fallback-name fallback-path)]
      (mapv
        (fn [(root-name String)] stages/SourceModuleV1
          (source-module rows root-name fallback-name fallback-path))
        roots))))

(defn source-module-id
  [(modules (Vec stages/SourceModuleV1))
   (module-name String)] core/NativeId
  (loop [position Int 0]
    (if (>= position (count modules))
      (slice-id "missing-module" [module-name])
      (let [(module stages/SourceModuleV1) (nth modules position)]
        (if (= module-name (stages/sourcemodulev1-name module))
          (stages/sourcemodulev1-id module)
          (recur (+ position 1)))))))

(defn semantic-unit-node-names [(rows (Vec SliceFactV0))] (Vec String)
  (loop [position Int 0 unique UniqueStringsV0 (->UniqueStringsV0 [] {})]
    (if (>= position (count rows))
      (uniquestringsv0-values unique)
      (let [(row SliceFactV0) (nth rows position)]
        (recur (+ position 1)
          (if (and (= "semantic-unit-sha256" (slicefactv0-predicate row))
                   (text-row? row))
            (add-unique-string unique (slicefactv0-subject row))
            unique))))))

(defn sorted-node-ids [(node-names (Vec String))] (Vec core/NativeId)
  (mapv
    (fn [(identity String)] core/NativeId (core/->NativeId identity))
    (sort
      (mapv
        (fn [(node-name String)] String
          (core/nativeid-value (node-id node-name)))
        node-names))))

(defn source-unit
  [(rows (Vec SliceFactV0))
   (modules (Vec stages/SourceModuleV1))
   (root-name String)] stages/SourceUnitV0
  (let [(kind (U String Nil))
        (row-first-text rows root-name "semantic-unit-kind")
        (name (U String Nil))
        (row-first-text rows root-name "semantic-unit-name")
        (module-name (U String Nil))
        (row-first-text rows root-name "semantic-unit-module")
        (semantic-digest (U String Nil))
        (row-first-text rows root-name "semantic-unit-sha256")
        (root core/NativeId) (node-id root-name)
        (read-names (Vec String))
        (sort (row-node-objects rows root-name "semantic-read"))]
    (stages/->SourceUnitV0
      root
      (source-module-id modules (if (nil? module-name) "" module-name))
      (if (nil? kind) "" kind)
      (if (nil? name) "" name)
      (if (nil? semantic-digest) "" semantic-digest)
      root
      (sorted-node-ids read-names))))

(defn source-units
  [(rows (Vec SliceFactV0))
   (modules (Vec stages/SourceModuleV1))] (Vec stages/SourceUnitV0)
  (mapv
    (fn [(root-name String)] stages/SourceUnitV0
      (source-unit rows modules root-name))
    (semantic-unit-node-names rows)))

(defn source-imports [(rows (Vec SliceFactV0))] (Vec core/NativeId)
  (mapv
    (fn [(node-name String)] core/NativeId (node-id node-name))
    (form-node-names rows "import")))

;; Node "0" is the program root. New projections carry one module root per AST;
;; old facts without module metadata remain a single-module source program.
(defn source-program
  [(rows (Vec SliceFactV0))
   (module-name String)
   (relative-path String)] stages/SourceStageV1
  (let [(root core/NativeId) (node-id "0")
        (nodes (Vec stages/TermNodeV0))
        (vec (concat (marker-nodes (node-names rows))
               (text-nodes (text-values rows))
               (fact-nodes rows)))
        (modules (Vec stages/SourceModuleV1))
        (source-modules rows module-name relative-path)]
    (stages/->SourceStageV1
      (stages/->TermGraphV0 root nodes)
      modules
      (source-units rows modules)
      (source-imports rows)
      [])))

(defn type-field-refs [(definition core/TypeDef)] (Vec core/NativeId)
  (let [(shape core/TypeShape) (core/typedef-shape definition)]
    (if (instance? native.core.RecordType shape)
      (mapv
        (fn [(field core/TypeField)] core/NativeId (core/typefield-type-id field))
        (core/recordtype-fields shape))
      [])))

(defn record-type? [(definition core/TypeDef)] Bool
  (instance? native.core.RecordType (core/typedef-shape definition)))

(defn find-type
  [(types (Vec core/TypeDef))
   (target core/NativeId)] (U core/TypeDef Nil)
  (loop [index Int 0]
    (if (>= index (count types))
      nil
      (let [(definition core/TypeDef) (nth types index)]
        (if (core/native-id= (core/typedef-id definition) target)
          definition
          (recur (+ index 1)))))))

(defn type-id-in? [(ids (Vec core/NativeId)) (target core/NativeId)] Bool
  (core/id-in? ids target))

(defn supported-record-ids
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))] (Vec core/NativeId)
  (loop [index Int 0 ids (Vec core/NativeId) []]
    (if (>= index (count types))
      ids
      (let [(definition core/TypeDef) (nth types index)]
        (recur (+ index 1)
          (if (and (record-type? definition)
                   (c11/type-supported? definition layouts))
            (conj ids (core/typedef-id definition))
            ids))))))

;; A record survives only when every field type also survives, so the kept set
;; shrinks to a fixpoint before the scalars it reaches are pulled in.
(defn closed-record-ids
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))
   (candidates (Vec core/NativeId))] (Vec core/NativeId)
  (let [(next (Vec core/NativeId))
        (filterv
          (fn [(candidate core/NativeId)] Bool
            (let [(definition (U core/TypeDef Nil)) (find-type types candidate)]
              (if (nil? definition)
                false
                (every?
                  (fn [(reference core/NativeId)] Bool
                    (let [(referenced (U core/TypeDef Nil)) (find-type types reference)]
                      (if (nil? referenced)
                        false
                        (if (record-type? referenced)
                          (type-id-in? candidates reference)
                          (c11/type-supported? referenced layouts)))))
                  (type-field-refs definition)))))
          candidates)]
    (if (= (count next) (count candidates))
      next
      (closed-record-ids types layouts next))))

(defn scalar-ids-for
  [(types (Vec core/TypeDef))
   (records (Vec core/NativeId))] (Vec core/NativeId)
  (loop [index Int 0 ids (Vec core/NativeId) []]
    (if (>= index (count records))
      ids
      (let [(definition (U core/TypeDef Nil)) (find-type types (nth records index))
            (references (Vec core/NativeId))
            (if (nil? definition) [] (type-field-refs definition))]
        (recur (+ index 1)
          (loop [inner Int 0 collected (Vec core/NativeId) ids]
            (if (>= inner (count references))
              collected
              (let [(reference core/NativeId) (nth references inner)]
                (recur (+ inner 1)
                  (if (or (type-id-in? records reference)
                          (type-id-in? collected reference))
                    collected
                    (conj collected reference)))))))))))

;; The C17 reference slice is a projection, never a claim about the whole
;; program: it keeps the source record ABI and the scalars those records reach,
;; and drops every shape the restricted materializer cannot spell.
(defn c17-projection
  [(types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))] SliceProjectionV0
  (let [(records (Vec core/NativeId))
        (closed-record-ids types layouts (supported-record-ids types layouts))
        (scalars (Vec core/NativeId)) (scalar-ids-for types records)
        (kept (Vec core/NativeId)) (vec (concat records scalars))
        (kept-types (Vec core/TypeDef))
        (filterv
          (fn [(definition core/TypeDef)] Bool
            (type-id-in? kept (core/typedef-id definition)))
          types)
        (kept-layouts (Vec core/LayoutDef))
        (filterv
          (fn [(layout core/LayoutDef)] Bool
            (type-id-in? kept (core/layoutdef-type-id layout)))
          layouts)]
    (->SliceProjectionV0 kept-types kept-layouts)))

(defn projected-program
  [(program core/NativeCoreProgram)
   (projection SliceProjectionV0)] core/NativeCoreProgram
  (core/->NativeCoreProgram
    (core/nativecoreprogram-id program)
    (core/nativecoreprogram-parent program)
    (core/nativecoreprogram-compiler-pass program)
    (sliceprojectionv0-types projection)
    (core/nativecoreprogram-effects program)
    (core/nativecoreprogram-regions program)
    (core/nativecoreprogram-capabilities program)
    (sliceprojectionv0-layouts projection)
    (core/nativecoreprogram-functions program)
    (core/nativecoreprogram-allowed-effects program)
    (core/nativecoreprogram-allowed-regions program)
    (core/nativecoreprogram-allowed-capabilities program)
    (core/nativecoreprogram-abis program)
    (core/nativecoreprogram-observations program)))

(defunion SliceMaterializationV0
  (SliceMaterializedV0 [(artifact c11/C11Artifact)])
  (SliceRefusedV0 [(detail String)]))

(defn materialize
  [(program core/NativeCoreProgram)
   (module-index Int)] SliceMaterializationV0
  (let [(validation core/ValidationReport) (core/validate-program program)]
    (cond
      (not (core/validationreport-passed validation))
      (->SliceRefusedV0 "projected program failed Native Core validation")

      (not (c11/program-supported? program))
      (->SliceRefusedV0 "projected program leaves the restricted C17 reference slice")

      :else
      (let [(types (Vec core/TypeDef))
            (c11/ordered-types (core/nativecoreprogram-types program))
            (layouts (Vec core/LayoutDef))
            (c11/ordered-layouts (core/nativecoreprogram-layouts program))
            (functions (Vec core/FunctionDef))
            (c11/ordered-functions (core/nativecoreprogram-functions program))
            (header-name String) (str "module_" module-index ".h")]
        (->SliceMaterializedV0
          (c11/->C11Artifact
            header-name
            (c11/emit-header types layouts functions module-index)
            (str "module_" module-index ".c")
            (c11/emit-source functions types module-index header-name)))))))

(defn obligation-names [] (Vec String)
  ["valid-ssa" "exhaustive-matches" "closed-layouts" "checked-arithmetic"
   "legal-abi" "discharged-tokens" "bounded-effects" "epoch-soundness"
   "leak-freedom" "deterministic-parallelism"])

(defn obligation-report
  [(label String)
   (program core/NativeCoreProgram)
   (abi core/AbiProfileV0)] String
  (let [(verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program program abi)
        (names (Vec String)) (obligation-names)]
    (loop [index Int 0 report String ""]
      (if (>= index (count verdicts))
        report
        (recur (+ index 1)
          (str report label " "
            (if (obligations/obligation-passed? (nth verdicts index)) "PASS" "FAIL")
            " " (nth names index) "\n"))))))

(defn type-names [(types (Vec core/TypeDef))] String
  (loop [index Int 0 report String ""]
    (if (>= index (count types))
      report
      (recur (+ index 1)
        (str report "type " (core/typedef-name (nth types index)) "\n")))))

(defn pending-report [(obligation core/ReceiptObligationV0)] String
  (str "pending " (core/receiptobligationv0-detail obligation) "\n"))

(defn pending-reports [(items (Vec core/ReceiptObligationV0))] String
  (loop [index Int 0 report String ""]
    (if (>= index (count items))
      report
      (recur (+ index 1) (str report (pending-report (nth items index)))))))

(defn native-frozen
  [(result lower/NativeLoweringResultV0)] stages/FrozenNativeStageV0
  (if (instance? native.lower.NativeLoweringCompleteV0 result)
    (lower/nativeloweringcompletev0-frozen result)
    (lower/nativeloweringpendingv0-frozen result)))

(defn native-pending
  [(result lower/NativeLoweringResultV0)] (Vec core/ReceiptObligationV0)
  (if (instance? native.lower.NativeLoweringPendingV0 result)
    (lower/nativeloweringpendingv0-obligations result)
    []))

;; Writes the C set into artifacts-dir and returns the run report; every stage
;; that refuses returns its own report rather than throwing.
(defn emit-slice-for-abi!
  [(facts-path String)
   (module-name String)
   (relative-path String)
   (artifacts-dir String)
   (compiler-commit String)
   (abi core/AbiProfileV0)] String
  (let [(rows (Vec SliceFactV0)) (parse-facts (slurp facts-path))
        (configuration (Vec String))
        ["profile=3" (str "abi=" (core/abiprofilev0-id abi))]
        (program stages/SourceStageV1)
        (source-program rows module-name relative-path)
        (freeze-result lower/SourceFreezeResultV0)
        (lower/freeze-source-stage program compiler-commit configuration)]
    (if (not (instance? native.lower.SourceFreezeAcceptedV0 freeze-result))
      "stage source-freeze REJECTED\n"
      (let [(frozen-source stages/FrozenSourceStageV1)
            (lower/sourcefreezeacceptedv0-frozen freeze-result)
            (typing-result lower/TypingResultV0)
            (lower/lower-typed-stage frozen-source compiler-commit configuration)]
        (if (not (instance? native.lower.TypingAcceptedV0 typing-result))
          "stage source-freeze ACCEPTED\nstage source-to-typed REJECTED\n"
          (let [(frozen-typed stages/FrozenTypedStageV0)
                (lower/typingacceptedv0-frozen typing-result)
                (slice lower/TypedSliceV0) (lower/typingacceptedv0-slice typing-result)
                (native-result lower/NativeLoweringResultV0)
                (lower/lower-native-stage frozen-typed slice compiler-commit
                  configuration abi)
                (epoch-result lower/EpochLoweringResultV0)
                (lower/epoch-identity-stage (native-frozen native-result)
                  compiler-commit configuration abi)
                (frozen-native stages/FrozenNativeStageV0)
                (lower/epoch-result-frozen epoch-result)
                (program core/NativeCoreProgram)
                (stages/nativestagev0-program
                  (stages/frozennativestagev0-stage frozen-native))
                (projection SliceProjectionV0)
                (c17-projection (core/nativecoreprogram-types program)
                  (core/nativecoreprogram-layouts program))
                (projected core/NativeCoreProgram) (projected-program program projection)
                (result SliceMaterializationV0) (materialize projected 0)
                (head String)
                (str "stage source-freeze ACCEPTED\n"
                  "stage source-to-typed ACCEPTED\n"
                  "stage typed-to-native "
                  (if (instance? native.lower.NativeLoweringCompleteV0 native-result)
                    "COMPLETE" "PENDING")
                  "\n"
                  "stage native-to-epoch "
                  (if (lower/epoch-result-complete? epoch-result)
                    "COMPLETE" "PENDING")
                  "\n"
                  "program-types " (str (count (core/nativecoreprogram-types program))) "\n"
                  "program-layouts " (str (count (core/nativecoreprogram-layouts program))) "\n"
                  "program-functions " (str (count (core/nativecoreprogram-functions program))) "\n"
                  "program-abis " (str (count (core/nativecoreprogram-abis program))) "\n"
                  "projected-types " (str (count (sliceprojectionv0-types projection))) "\n"
                  (type-names (sliceprojectionv0-types projection))
                  (obligation-report "obligation-program" program abi)
                  (obligation-report "obligation-projection" projected abi)
                  (pending-reports (native-pending native-result)))]
            (match result
              [(SliceRefusedV0 detail) (str head "materialize REFUSED " detail "\n")]
              [(SliceMaterializedV0 artifact)
               (do
                 (spit (str artifacts-dir "/" (c11/c11artifact-header-name artifact))
                   (c11/c11artifact-header-text artifact))
                 (spit (str artifacts-dir "/" (c11/c11artifact-source-name artifact))
                   (c11/c11artifact-source-text artifact))
                 (str head "materialize OK "
                   (c11/c11artifact-header-name artifact) " "
                   (c11/c11artifact-source-name artifact) "\n"))])))))))

(defn emit-slice!
  [(facts-path String)
   (module-name String)
   (relative-path String)
   (artifacts-dir String)
   (compiler-commit String)
   (abi-id String)] String
  (let [(profile (U core/AbiProfileV0 Nil)) (core/abi-profile-for abi-id)]
    (if (nil? profile)
      (str "stage abi REJECTED unknown abi profile " abi-id "\n")
      (emit-slice-for-abi! facts-path module-name relative-path artifacts-dir
        compiler-commit profile))))
