#lang beagle/clj
(ns native.validation-corpus (:require [native.core :as core]))

(define-mode strict)

(defrecord CorpusResult
  [(valid-accepted Bool)
   (duplicate-rejected Bool)
   (allowed-rejected Bool)
   (reference-rejected Bool)
   (missing-terminator-rejected Bool)
   (double-terminator-rejected Bool)
   (ssa-rejected Bool)
   (canonical-deterministic Bool)
   (canonical-separated Bool)
   (i64-f64-distinct Bool)])

(defn corpus-id [(name String)] core/NativeId
  (core/canonical-id "native-core-v0-corpus" [name]))

(def corpus-i64-type core/TypeDef
  (core/->TypeDef (corpus-id "type-i64")
    "I64"
    (core/atom-type-shape (core/i64-kind))))

(def corpus-f64-type core/TypeDef
  (core/->TypeDef (corpus-id "type-f64")
    "F64"
    (core/atom-type-shape (core/f64-kind))))

(def corpus-region core/RegionDef
  (core/->RegionDef (corpus-id "region-arena") (core/arena-region-kind) nil))

(def corpus-capability core/CapabilityDef
  (core/->CapabilityDef (corpus-id "capability-write")
    (core/write-capability-kind)
    (corpus-id "region-arena")
    true))

(def corpus-effect core/EffectDef
  (core/->EffectDef (corpus-id "effect-write")
    (core/write-effect-kind (corpus-id "region-arena"))))

(def corpus-i64-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "layout-i64")
    (corpus-id "type-i64")
    8
    8
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(def corpus-f64-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "layout-f64")
    (corpus-id "type-f64")
    8
    8
    (core/->ScalarShapeV0 (core/->FloatReprV0 64))))

(def corpus-entry-block core/BasicBlock
  (core/->BasicBlock (corpus-id "block-entry")
    []
    [(core/store-instruction (corpus-id "ssa-store-i64")
       (corpus-id "type-i64")
       (core/store-i64-op (corpus-id "ssa-address")
         (corpus-id "ssa-i64-input")
         (corpus-id "region-arena")
         (corpus-id "capability-write")))
     (core/store-instruction (corpus-id "ssa-store-f64")
       (corpus-id "type-f64")
       (core/store-f64-op (corpus-id "ssa-address")
         (corpus-id "ssa-f64-input")
         (corpus-id "region-arena")
         (corpus-id "capability-write")))]
    [(core/return-terminator nil)]))

(def corpus-function core/FunctionDef
  (core/->FunctionDef (corpus-id "function-store-pair")
    "store-pair"
    [(core/->Parameter (corpus-id "ssa-address") (corpus-id "type-i64"))
     (core/->Parameter (corpus-id "ssa-i64-input") (corpus-id "type-i64"))
     (core/->Parameter (corpus-id "ssa-f64-input") (corpus-id "type-f64"))]
    [corpus-entry-block]
    (corpus-id "block-entry")
    nil
    [(corpus-id "effect-write")]
    [(corpus-id "region-arena")]
    [(corpus-id "capability-write")]))

(def valid-program core/NativeCoreProgram
  (core/->NativeCoreProgram (corpus-id "program-valid")
    nil
    "native-core-v0"
    [corpus-i64-type corpus-f64-type]
    [corpus-effect]
    [corpus-region]
    [corpus-capability]
    [corpus-i64-layout corpus-f64-layout]
    [corpus-function]
    [(corpus-id "effect-write")]
    [(corpus-id "region-arena")]
    [(corpus-id "capability-write")]
    []
    [(core/fri2-observation (corpus-id "fri2-dump")
       "sha256:0123456789abcdef"
       128)]))

(def duplicate-id-program core/NativeCoreProgram
  (with valid-program
    [:layouts
     [corpus-i64-layout
      (core/->LayoutDef (corpus-id "layout-i64")
        (corpus-id "type-f64")
        8
        8
        (core/->ScalarShapeV0 (core/->FloatReprV0 64)))]]))

(def disallowed-program core/NativeCoreProgram
  (with valid-program [:allowed-capabilities []]))

(def dangling-function core/FunctionDef
  (with corpus-function [:return-type (corpus-id "type-missing")]))

(def dangling-program core/NativeCoreProgram
  (with valid-program [:functions [dangling-function]]))

(def missing-terminator-block core/BasicBlock
  (with corpus-entry-block [:terminators []]))

(def missing-terminator-function core/FunctionDef
  (with corpus-function [:blocks [missing-terminator-block]]))

(def missing-terminator-program core/NativeCoreProgram
  (with valid-program [:functions [missing-terminator-function]]))

(def double-terminator-block core/BasicBlock
  (with corpus-entry-block
    [:terminators [(core/return-terminator nil) (core/return-terminator nil)]]))

(def double-terminator-function core/FunctionDef
  (with corpus-function [:blocks [double-terminator-block]]))

(def double-terminator-program core/NativeCoreProgram
  (with valid-program [:functions [double-terminator-function]]))

(def dangling-ssa-block core/BasicBlock
  (with corpus-entry-block
    [:instructions
     [(core/copy-instruction (corpus-id "ssa-bad-result")
        (corpus-id "type-i64")
        (corpus-id "ssa-missing"))]]))

(def dangling-ssa-function core/FunctionDef
  (with corpus-function [:blocks [dangling-ssa-block]]))

(def dangling-ssa-program core/NativeCoreProgram
  (with valid-program [:functions [dangling-ssa-function]]))

;; Closed record-assoc corpus: the valid case fixes source/result ownership,
;; field membership, replacement type, and a real ArenaInstruction producer.
;; Each negative changes exactly one of those facts while keeping references
;; and SSA IDs otherwise closed.
(def assoc-arena-type core/TypeDef
  (core/->TypeDef (corpus-id "assoc-type-arena") "ArenaHandle"
    (core/->ReferenceType (corpus-id "assoc-type-arena"))))

(def assoc-left-field core/TypeField
  (core/->TypeField (corpus-id "assoc-field-left") "left"
    (corpus-id "type-i64")))

(def assoc-right-field core/TypeField
  (core/->TypeField (corpus-id "assoc-field-right") "right"
    (corpus-id "type-i64")))

(def assoc-pair-type core/TypeDef
  (core/->TypeDef (corpus-id "assoc-type-pair") "Pair"
    (core/->RecordType [assoc-left-field assoc-right-field])))

(def assoc-foreign-field core/TypeField
  (core/->TypeField (corpus-id "assoc-field-foreign") "foreign"
    (corpus-id "type-i64")))

(def assoc-foreign-type core/TypeDef
  (core/->TypeDef (corpus-id "assoc-type-foreign") "Foreign"
    (core/->RecordType [assoc-foreign-field])))

(def assoc-arena-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "assoc-layout-arena")
    (corpus-id "assoc-type-arena") 8 8
    (core/->ReferenceShapeV0 (corpus-id "assoc-type-arena"))))

(def assoc-pair-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "assoc-layout-pair")
    (corpus-id "assoc-type-pair") 16 8
    (core/->RecordShapeV0
      [(core/->FieldLayoutV0 (corpus-id "assoc-field-left")
         (corpus-id "type-i64") 0 8)
       (core/->FieldLayoutV0 (corpus-id "assoc-field-right")
         (corpus-id "type-i64") 8 8)])))

(def assoc-foreign-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "assoc-layout-foreign")
    (corpus-id "assoc-type-foreign") 8 8
    (core/->RecordShapeV0
      [(core/->FieldLayoutV0 (corpus-id "assoc-field-foreign")
         (corpus-id "type-i64") 0 8)])))

(def assoc-region core/RegionDef
  (core/->RegionDef (corpus-id "assoc-region") (core/arena-region-kind) nil))

(def assoc-capability core/CapabilityDef
  (core/->CapabilityDef (corpus-id "assoc-capability")
    (core/->AllocateCapability true) (corpus-id "assoc-region") true))

(def assoc-effect core/EffectDef
  (core/->EffectDef (corpus-id "assoc-effect")
    (core/->AllocateEffect (corpus-id "assoc-region"))))

(def assoc-arena-instruction core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (corpus-id "assoc-ssa-arena")
      (corpus-id "assoc-type-arena"))
    (corpus-id "assoc-region")
    (corpus-id "assoc-capability")
    (core/->TokenFlowV0
      [(corpus-id "assoc-region") (corpus-id "assoc-capability")]
      [])))

(def assoc-instruction core/Instruction
  (core/->RecordAssocInstructionV0
    (core/->SsaValueV0 (corpus-id "assoc-ssa-result")
      (corpus-id "assoc-type-pair"))
    (corpus-id "assoc-ssa-source")
    (corpus-id "assoc-field-right")
    (corpus-id "assoc-ssa-value")
    (corpus-id "assoc-ssa-arena")))

(def assoc-block core/BasicBlock
  (core/->BasicBlock (corpus-id "assoc-block") []
    [assoc-arena-instruction assoc-instruction]
    [(core/return-terminator (corpus-id "assoc-ssa-result"))]))

(def assoc-function core/FunctionDef
  (core/->FunctionDef (corpus-id "assoc-function") "assoc-right"
    [(core/->Parameter (corpus-id "assoc-ssa-source")
       (corpus-id "assoc-type-pair"))
     (core/->Parameter (corpus-id "assoc-ssa-value")
       (corpus-id "type-i64"))]
    [assoc-block]
    (corpus-id "assoc-block")
    (corpus-id "assoc-type-pair")
    [(corpus-id "assoc-effect")]
    [(corpus-id "assoc-region")]
    [(corpus-id "assoc-capability")]))

(def record-assoc-program core/NativeCoreProgram
  (core/->NativeCoreProgram (corpus-id "assoc-program") nil "native-core-v0-record-assoc"
    [assoc-pair-type assoc-foreign-type assoc-arena-type
     corpus-i64-type corpus-f64-type]
    [assoc-effect]
    [assoc-region]
    [assoc-capability]
    [assoc-pair-layout assoc-foreign-layout assoc-arena-layout
     corpus-i64-layout corpus-f64-layout]
    [assoc-function]
    [(corpus-id "assoc-effect")]
    [(corpus-id "assoc-region")]
    [(corpus-id "assoc-capability")]
    []
    []))

(def assoc-bad-field-instruction core/Instruction
  (with assoc-instruction [:field-id (corpus-id "assoc-field-foreign")]))

(def assoc-bad-field-block core/BasicBlock
  (with assoc-block
    [:instructions [assoc-arena-instruction assoc-bad-field-instruction]]))

(def assoc-bad-field-function core/FunctionDef
  (with assoc-function [:blocks [assoc-bad-field-block]]))

(def record-assoc-bad-field-program core/NativeCoreProgram
  (with record-assoc-program [:functions [assoc-bad-field-function]]))

(def assoc-bad-value-parameter core/Parameter
  (core/->Parameter (corpus-id "assoc-ssa-value") (corpus-id "type-f64")))

(def assoc-bad-type-function core/FunctionDef
  (with assoc-function
    [:parameters
     [(core/->Parameter (corpus-id "assoc-ssa-source")
        (corpus-id "assoc-type-pair"))
      assoc-bad-value-parameter]]))

(def record-assoc-bad-type-program core/NativeCoreProgram
  (with record-assoc-program [:functions [assoc-bad-type-function]]))

(def assoc-bad-arena-instruction core/Instruction
  (with assoc-instruction [:arena-id (corpus-id "assoc-ssa-source")]))

(def assoc-bad-arena-block core/BasicBlock
  (with assoc-block
    [:instructions [assoc-arena-instruction assoc-bad-arena-instruction]]))

(def assoc-bad-arena-function core/FunctionDef
  (with assoc-function [:blocks [assoc-bad-arena-block]]))

(def record-assoc-bad-arena-program core/NativeCoreProgram
  (with record-assoc-program [:functions [assoc-bad-arena-function]]))

(def assoc-bad-source-parameter core/Parameter
  (core/->Parameter (corpus-id "assoc-ssa-source")
    (corpus-id "assoc-type-foreign")))

(def assoc-bad-source-function core/FunctionDef
  (with assoc-function
    [:parameters
     [assoc-bad-source-parameter
      (core/->Parameter (corpus-id "assoc-ssa-value")
        (corpus-id "type-i64"))]]))

(def record-assoc-bad-source-program core/NativeCoreProgram
  (with record-assoc-program [:functions [assoc-bad-source-function]]))

(def record-assoc-corpus-passes? Bool
  (and
    (core/validationreport-passed (core/validate-program record-assoc-program))
    (not (core/validationreport-passed
      (core/validate-program record-assoc-bad-field-program)))
    (not (core/validationreport-passed
      (core/validate-program record-assoc-bad-type-program)))
    (not (core/validationreport-passed
      (core/validate-program record-assoc-bad-arena-program)))
    (not (core/validationreport-passed
      (core/validate-program record-assoc-bad-source-program)))))

;; Buffer instruction typing is frozen IR law, not an emitter assumption. The
;; valid graph fixes the Buffer element type and native Int length/index. Each
;; named negative changes one SSA type fact while keeping every ID closed.
(def buffer-type core/TypeDef
  (core/->TypeDef (corpus-id "buffer-type-f64") "BufferF64"
    (core/->BufferTypeV0 (corpus-id "type-f64"))))

(def buffer-i64-type core/TypeDef
  (core/->TypeDef (corpus-id "buffer-type-i64") "BufferI64"
    (core/->BufferTypeV0 (corpus-id "type-i64"))))

(def buffer-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "buffer-layout-f64")
    (corpus-id "buffer-type-f64") 8 8
    (core/->BufferShapeV0 (corpus-id "type-f64") 8 8)))

(def buffer-i64-layout core/LayoutDef
  (core/->LayoutDef (corpus-id "buffer-layout-i64")
    (corpus-id "buffer-type-i64") 8 8
    (core/->BufferShapeV0 (corpus-id "type-i64") 8 8)))

(def buffer-read-capability core/CapabilityDef
  (core/->CapabilityDef (corpus-id "buffer-capability-read")
    (core/->ReadCapability true) (corpus-id "assoc-region") true))

(def buffer-write-capability core/CapabilityDef
  (core/->CapabilityDef (corpus-id "buffer-capability-write")
    (core/->WriteCapability true) (corpus-id "assoc-region") true))

(def buffer-read-effect core/EffectDef
  (core/->EffectDef (corpus-id "buffer-effect-read")
    (core/->ReadEffect (corpus-id "assoc-region"))))

(def buffer-write-effect core/EffectDef
  (core/->EffectDef (corpus-id "buffer-effect-write")
    (core/->WriteEffect (corpus-id "assoc-region"))))

(def buffer-arena-instruction core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (corpus-id "buffer-ssa-arena")
      (corpus-id "assoc-type-arena"))
    (corpus-id "assoc-region")
    (corpus-id "assoc-capability")
    (core/->TokenFlowV0
      [(corpus-id "assoc-region") (corpus-id "assoc-capability")]
      [])))

(def buffer-allocate-instruction core/Instruction
  (core/->BufferAllocateInstructionV0
    (core/->SsaValueV0 (corpus-id "buffer-ssa-buffer")
      (corpus-id "buffer-type-f64"))
    (corpus-id "buffer-ssa-length")
    (corpus-id "buffer-ssa-arena")
    (corpus-id "assoc-region")
    (corpus-id "assoc-capability")))

(def buffer-length-instruction core/Instruction
  (core/->BufferLengthInstructionV0
    (core/->SsaValueV0 (corpus-id "buffer-ssa-observed-length")
      (corpus-id "type-i64"))
    (corpus-id "buffer-ssa-buffer")
    (corpus-id "assoc-region")
    (corpus-id "buffer-capability-read")))

(def buffer-get-instruction core/Instruction
  (core/->BufferGetCheckedInstructionV0
    (core/->SsaValueV0 (corpus-id "buffer-ssa-read")
      (corpus-id "type-f64"))
    (corpus-id "buffer-ssa-buffer")
    (corpus-id "buffer-ssa-index")
    (corpus-id "assoc-region")
    (corpus-id "buffer-capability-read")))

(def buffer-set-instruction core/Instruction
  (core/->BufferSetCheckedInstructionV0
    (core/->SsaValueV0 (corpus-id "buffer-ssa-written")
      (corpus-id "type-f64"))
    (corpus-id "buffer-ssa-buffer")
    (corpus-id "buffer-ssa-index")
    (corpus-id "buffer-ssa-value")
    (corpus-id "assoc-region")
    (corpus-id "buffer-capability-write")))

(def buffer-instructions (Vec core/Instruction)
  [buffer-arena-instruction buffer-allocate-instruction
   buffer-length-instruction buffer-get-instruction buffer-set-instruction])

(def buffer-block core/BasicBlock
  (core/->BasicBlock (corpus-id "buffer-block") [] buffer-instructions
    [(core/return-terminator (corpus-id "buffer-ssa-written"))]))

(def buffer-function core/FunctionDef
  (core/->FunctionDef (corpus-id "buffer-function") "buffer-round-trip"
    [(core/->Parameter (corpus-id "buffer-ssa-length")
       (corpus-id "type-i64"))
     (core/->Parameter (corpus-id "buffer-ssa-index")
       (corpus-id "type-i64"))
     (core/->Parameter (corpus-id "buffer-ssa-value")
       (corpus-id "type-f64"))
     (core/->Parameter (corpus-id "buffer-ssa-i64-buffer")
       (corpus-id "buffer-type-i64"))]
    [buffer-block]
    (corpus-id "buffer-block")
    (corpus-id "type-f64")
    [(corpus-id "assoc-effect") (corpus-id "buffer-effect-read")
     (corpus-id "buffer-effect-write")]
    [(corpus-id "assoc-region")]
    [(corpus-id "assoc-capability") (corpus-id "buffer-capability-read")
     (corpus-id "buffer-capability-write")]))

(def buffer-program core/NativeCoreProgram
  (core/->NativeCoreProgram (corpus-id "buffer-program") nil
    "native-core-v0-buffer"
    [buffer-type buffer-i64-type assoc-arena-type corpus-i64-type
     corpus-f64-type]
    [assoc-effect buffer-read-effect buffer-write-effect]
    [assoc-region]
    [assoc-capability buffer-read-capability buffer-write-capability]
    [buffer-layout buffer-i64-layout assoc-arena-layout corpus-i64-layout
     corpus-f64-layout]
    [buffer-function]
    [(corpus-id "assoc-effect") (corpus-id "buffer-effect-read")
     (corpus-id "buffer-effect-write")]
    [(corpus-id "assoc-region")]
    [(corpus-id "assoc-capability") (corpus-id "buffer-capability-read")
     (corpus-id "buffer-capability-write")]
    []
    []))

(defn buffer-program-with-instructions
  [(instructions (Vec core/Instruction))] core/NativeCoreProgram
  (with buffer-program
    [:functions
     [(with buffer-function
        [:blocks [(with buffer-block [:instructions instructions])]])]]))

(def buffer-non-buffer-source-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction
     (with buffer-get-instruction
       [:source-id (corpus-id "buffer-ssa-value")])
     buffer-set-instruction]))

(def buffer-length-non-buffer-source-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     (with buffer-length-instruction
       [:source-id (corpus-id "buffer-ssa-value")])
     buffer-get-instruction buffer-set-instruction]))

(def buffer-set-non-buffer-source-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction buffer-get-instruction
     (with buffer-set-instruction
       [:source-id (corpus-id "buffer-ssa-value")])]))

(def buffer-non-int-length-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction
     (with buffer-allocate-instruction
       [:length-id (corpus-id "buffer-ssa-value")])
     buffer-length-instruction buffer-get-instruction buffer-set-instruction]))

(def buffer-non-int-index-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction
     (with buffer-get-instruction
       [:index-id (corpus-id "buffer-ssa-value")])
     buffer-set-instruction]))

(def buffer-set-non-int-index-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction buffer-get-instruction
     (with buffer-set-instruction
       [:index-id (corpus-id "buffer-ssa-value")])]))

(def buffer-wrong-allocate-result-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction
     (with buffer-allocate-instruction
       [:result (core/->SsaValueV0 (corpus-id "buffer-ssa-buffer")
                  (corpus-id "type-f64"))])
     buffer-length-instruction buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-length-result-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     (with buffer-length-instruction
       [:result (core/->SsaValueV0 (corpus-id "buffer-ssa-observed-length")
                  (corpus-id "type-f64"))])
     buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-get-result-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction
     (with buffer-get-instruction
       [:result (core/->SsaValueV0 (corpus-id "buffer-ssa-read")
                  (corpus-id "type-i64"))])
     buffer-set-instruction]))

(def buffer-wrong-set-result-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction buffer-get-instruction
     (with buffer-set-instruction
       [:result (core/->SsaValueV0 (corpus-id "buffer-ssa-written")
                  (corpus-id "type-i64"))])]))

(def buffer-wrong-set-value-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction buffer-get-instruction
     (with buffer-set-instruction
       [:value-id (corpus-id "buffer-ssa-length")])]))

(def buffer-mismatched-element-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction
     (with buffer-get-instruction
       [:source-id (corpus-id "buffer-ssa-i64-buffer")])
     buffer-set-instruction]))

(def buffer-forged-external-root-program core/NativeCoreProgram
  (with buffer-program
    [:regions
     [(with assoc-region [:kind (core/->ExternalRegion true)])]]))

(def buffer-mismatched-arena-producer-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [(with buffer-arena-instruction
       [:capability (corpus-id "buffer-capability-read")])
     buffer-allocate-instruction buffer-length-instruction
     buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-arena-handle-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [(with buffer-arena-instruction
       [:result (core/->SsaValueV0 (corpus-id "buffer-ssa-arena")
                  (corpus-id "type-i64"))])
     buffer-allocate-instruction buffer-length-instruction
     buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-allocate-capability-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [(with buffer-arena-instruction
       [:capability (corpus-id "buffer-capability-read")])
     (with buffer-allocate-instruction
       [:capability (corpus-id "buffer-capability-read")])
     buffer-length-instruction buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-read-capability-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     (with buffer-length-instruction
       [:capability (corpus-id "assoc-capability")])
     buffer-get-instruction buffer-set-instruction]))

(def buffer-wrong-write-capability-program core/NativeCoreProgram
  (buffer-program-with-instructions
    [buffer-arena-instruction buffer-allocate-instruction
     buffer-length-instruction buffer-get-instruction
     (with buffer-set-instruction
       [:capability (corpus-id "buffer-capability-read")])]))

(def buffer-second-region core/RegionDef
  (core/->RegionDef (corpus-id "buffer-second-region")
    (core/arena-region-kind) nil))

(def buffer-second-read-capability core/CapabilityDef
  (core/->CapabilityDef (corpus-id "buffer-second-read-capability")
    (core/->ReadCapability true) (corpus-id "buffer-second-region") true))

(def buffer-incoherent-root-function core/FunctionDef
  (with
    (with
      (with buffer-function
        [:regions
         [(corpus-id "assoc-region") (corpus-id "buffer-second-region")]])
      [:capabilities
       [(corpus-id "assoc-capability") (corpus-id "buffer-capability-read")
        (corpus-id "buffer-capability-write")
        (corpus-id "buffer-second-read-capability")]])
    [:blocks
     [(with buffer-block
        [:instructions
         [buffer-arena-instruction buffer-allocate-instruction
          buffer-length-instruction
          (with
            (with buffer-get-instruction
              [:region (corpus-id "buffer-second-region")])
            [:capability (corpus-id "buffer-second-read-capability")])
          buffer-set-instruction]])]]))

(def buffer-incoherent-root-program core/NativeCoreProgram
  (with
    (with
      (with
        (with
          (with buffer-program
            [:regions [assoc-region buffer-second-region]])
          [:capabilities
           [assoc-capability buffer-read-capability buffer-write-capability
            buffer-second-read-capability]])
        [:functions [buffer-incoherent-root-function]])
      [:allowed-regions
       [(corpus-id "assoc-region") (corpus-id "buffer-second-region")]])
    [:allowed-capabilities
     [(corpus-id "assoc-capability") (corpus-id "buffer-capability-read")
      (corpus-id "buffer-capability-write")
      (corpus-id "buffer-second-read-capability")]]))

(def buffer-instruction-corpus-passes? Bool
  (and
    (core/validationreport-passed (core/validate-program buffer-program))
    (not (core/validationreport-passed
      (core/validate-program buffer-non-buffer-source-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-length-non-buffer-source-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-set-non-buffer-source-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-non-int-length-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-non-int-index-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-set-non-int-index-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-allocate-result-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-length-result-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-get-result-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-set-result-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-set-value-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-mismatched-element-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-forged-external-root-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-mismatched-arena-producer-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-arena-handle-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-allocate-capability-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-read-capability-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-wrong-write-capability-program)))
    (not (core/validationreport-passed
      (core/validate-program buffer-incoherent-root-program)))))

(def corpus-result CorpusResult
  (->CorpusResult (core/validationreport-passed (core/validate-program valid-program))
    (not (core/validationreport-passed (core/validate-program duplicate-id-program)))
    (not (core/validationreport-passed (core/validate-program disallowed-program)))
    (not (core/validationreport-passed (core/validate-program dangling-program)))
    (not (core/validationreport-passed (core/validate-program missing-terminator-program)))
    (not (core/validationreport-passed (core/validate-program double-terminator-program)))
    (not (core/validationreport-passed (core/validate-program dangling-ssa-program)))
    (core/native-id= (core/canonical-id "scope" ["ab" "c"])
      (core/canonical-id "scope" ["ab" "c"]))
    (not (core/native-id= (core/canonical-id "scope" ["ab" "c"]) (core/canonical-id "scope" ["a" "bc"])))
    (not (core/native-id= (core/typedef-id corpus-i64-type) (core/typedef-id corpus-f64-type)))))

(def corpus-passes? Bool
  (and (corpusresult-valid-accepted corpus-result)
    (corpusresult-duplicate-rejected corpus-result)
    (corpusresult-allowed-rejected corpus-result)
    (corpusresult-reference-rejected corpus-result)
    (corpusresult-missing-terminator-rejected corpus-result)
    (corpusresult-double-terminator-rejected corpus-result)
    (corpusresult-ssa-rejected corpus-result)
    (corpusresult-canonical-deterministic corpus-result)
    (corpusresult-canonical-separated corpus-result)
    (corpusresult-i64-f64-distinct corpus-result)
    record-assoc-corpus-passes?
    buffer-instruction-corpus-passes?))
