;; @upstream:text-arm — operator-authorized for Native Stage 3; re-ingest this
;; module into the graph after landing. Authority: North thread 019fbd6c,
;; accepted design lane-msch3uwf sections 2-3.
(ns native.lower
  (:require [native.core :as core]
            [native.worlds :as worlds]))

(define-mode strict)

(defrecord SourceFactV0
  [identity: core/NativeId
   subject: core/NativeId
   predicate: core/NativeId
   object: core/NativeId])

(defunion LowerFailureV0
  (MissingGraphRootV0 [root: core/NativeId])
  (DuplicateTermIdentityV0 [identity: core/NativeId])
  (UnclosedTermReferenceV0
    [owner: core/NativeId
     target: core/NativeId])
  (MalformedSourceTermV0
    [identity: core/NativeId
     detail: String])
  (MissingSourceFactV0
    [subject: core/NativeId
     predicate: String])
  (UnresolvedSourceTypeV0
    [source-type: core/NativeId
     detail: String])
  (UnsupportedSourceTypeV0
    [source-type: core/NativeId
     spelling: String])
  (MissingFunctionAnnotationV0
    [function-id: core/NativeId
     binding: String])
  (InvalidSourceModuleV0
    [module-id: core/NativeId
     detail: String]))

(defunion SourceSealResultV0
  (SourceSealAcceptedV0
    [sealed: worlds/SealedSourceWorldV0
     receipt: core/PassReceiptV0])
  (SourceSealRejectedV0
    [failure: LowerFailureV0
     receipt: core/PassReceiptV0]))

(defn lower-id
  [domain: String
   parts: (Vec String)] -> core/NativeId
  (core/canonical-id (str "native-lower-v0/" domain) parts))

(defn id-value [id: core/NativeId] -> String
  (core/nativeid-value id))

(defn same-id?
  [left: core/NativeId
   right: core/NativeId] -> Bool
  (core/native-id= left right))

(defn find-node
  [graph: worlds/TermGraphV0
   target: core/NativeId] -> (U worlds/TermNodeV0 Nil)
  (let [nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)]
    (loop [index: Int 0]
      (if (>= index (count nodes))
        nil
        (let [node: worlds/TermNodeV0 (nth nodes index)]
          (if (same-id? target (worlds/termnodev0-identity node))
            node
            (recur (+ index 1))))))))

(defn term-at
  [graph: worlds/TermGraphV0
   target: core/NativeId] -> (U worlds/TermV0 Nil)
  (let [node: (U worlds/TermNodeV0 Nil) (find-node graph target)]
    (if (nil? node) nil (worlds/termnodev0-term node))))

(defn text-at
  [graph: worlds/TermGraphV0
   target: core/NativeId] -> (U String Nil)
  (let [term: (U worlds/TermV0 Nil) (term-at graph target)]
    (if (nil? term)
      nil
      (if (instance? native.worlds.TextTermV0 term) (worlds/texttermv0-value term) nil))))

(defn term-references [term: worlds/TermV0] -> (Vec core/NativeId)
  (cond
    (instance? native.worlds.RefTermV0 term)
    [(worlds/reftermv0-target term)]

    (instance? native.worlds.TripleTermV0 term)
    [(worlds/tripletermv0-subject term)
     (worlds/tripletermv0-predicate term)
     (worlds/tripletermv0-object term)]

    :else []))

(defn graph-identities [graph: worlds/TermGraphV0] -> (Vec core/NativeId)
  (mapv
    (fn [node: worlds/TermNodeV0] -> core/NativeId
      (worlds/termnodev0-identity node))
    (worlds/termgraphv0-nodes graph)))

(defn graph-identity-index [graph: worlds/TermGraphV0] -> (Map String Bool)
  (let [nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)]
    (loop [index: Int 0 identities: (Map String Bool) {}]
      (if (>= index (count nodes))
        identities
        (recur (+ index 1)
          (assoc identities
            (id-value (worlds/termnodev0-identity (nth nodes index))) true))))))

(defn refs-resolve-in?
  [identities: (Map String Bool)
   refs: (Vec core/NativeId)] -> Bool
  (loop [index: Int 0]
    (if (>= index (count refs))
      true
      (if (not (= true (get identities (id-value (nth refs index)))))
        false
        (recur (+ index 1))))))

(defn graph-reference-closed-in?
  [graph: worlds/TermGraphV0
   identities: (Map String Bool)] -> Bool
  (let [nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)]
    (loop [index: Int 0]
      (if (>= index (count nodes))
        true
        (let [node: worlds/TermNodeV0 (nth nodes index)]
          (if (refs-resolve-in? identities
                (term-references (worlds/termnodev0-term node)))
            (recur (+ index 1))
            false))))))

(defn graph-reference-closed? [graph: worlds/TermGraphV0] -> Bool
  (graph-reference-closed-in? graph (graph-identity-index graph)))

(defn source-facts [graph: worlds/TermGraphV0] -> (Vec SourceFactV0)
  (let [nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)]
    (loop [index: Int 0 facts: (Vec SourceFactV0) []]
      (if (>= index (count nodes))
        facts
        (let [node: worlds/TermNodeV0 (nth nodes index)
              term: worlds/TermV0 (worlds/termnodev0-term node)]
          (if (instance? native.worlds.TripleTermV0 term)
            (recur (+ index 1)
              (conj facts
                (->SourceFactV0
                  (worlds/termnodev0-identity node)
                  (worlds/tripletermv0-subject term)
                  (worlds/tripletermv0-predicate term)
                  (worlds/tripletermv0-object term))))
            (recur (+ index 1) facts)))))))

;; Lookup maps preserve first-fact semantics while resolving graph text once.
(defrecord SourceIndexV0
  [fact-count: Int
   first-objects: (Map String core/NativeId)
   first-texts: (Map String String)
   form-ids: (Map String (Vec core/NativeId))
   callee-names: (Map String Bool)
   child-nodes: (Map String (Vec core/NativeId))
   definition-roots: (Map String core/NativeId)
   module-roots: (Map String core/NativeId)
   record-names: (Vec String)])

(defn graph-text-index [graph: worlds/TermGraphV0] -> (Map String String)
  (let [nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)]
    (loop [position: Int 0 texts: (Map String String) {}]
      (if (>= position (count nodes))
        texts
        (let [node: worlds/TermNodeV0 (nth nodes position)
              term: worlds/TermV0 (worlds/termnodev0-term node)]
          (recur (+ position 1)
            (if (instance? native.worlds.TextTermV0 term)
              (assoc texts
                (id-value (worlds/termnodev0-identity node))
                (worlds/texttermv0-value term))
              texts)))))))

(defn graph-text-or-empty
  [texts: (Map String String)
   target: core/NativeId] -> String
  (let [value: (U String Nil) (get texts (id-value target))]
    (if (nil? value) "" value)))

(defn source-index-key
  [subject: core/NativeId
   predicate: String] -> String
  (let [identity: String (id-value subject)]
    (str (count identity) ":" identity predicate)))

(defn index-facts [index: SourceIndexV0] -> Int
  (sourceindexv0-fact-count index))

(defn index-has-callee?
  [index: SourceIndexV0
   expected: String] -> Bool
  (= true (get (sourceindexv0-callee-names index) expected)))

(defn index-first-object
  [index: SourceIndexV0
   subject: core/NativeId
   predicate: String] -> (U core/NativeId Nil)
  (get (sourceindexv0-first-objects index)
    (source-index-key subject predicate)))

(defn index-first-text
  [index: SourceIndexV0
   subject: core/NativeId
   predicate: String] -> (U String Nil)
  (let [value: (U String Nil)
        (get (sourceindexv0-first-texts index)
          (source-index-key subject predicate))]
    (if (or (nil? value) (= 0 (count value))) nil value)))

(defn index-form-ids
  [index: SourceIndexV0
   kind: String] -> (Vec core/NativeId)
  (let [forms: (U (Vec core/NativeId) Nil)
        (get (sourceindexv0-form-ids index) kind)]
    (if (nil? forms) [] forms)))

;; A sequence node carries its items under an ordinal predicate, so item order
;; is the ordinal, never fact order. The two live projections spell that
;; ordinal differently: the AST projection uses f0.., the corpus uses a0...
(defn index-sequence-under
  [index: SourceIndexV0
   sequence-id: core/NativeId
   prefix: String] -> (Vec core/NativeId)
  (loop [position: Int 0 items: (Vec core/NativeId) []]
    (let [item: (U core/NativeId Nil)
          (index-first-object index sequence-id (str prefix position))]
      (if (nil? item)
        items
        (recur (+ position 1) (conj items item))))))

(defn index-sequence-items
  [index: SourceIndexV0
   sequence-id: core/NativeId] -> (Vec core/NativeId)
  (let [indexed: (Vec core/NativeId) (index-sequence-under index sequence-id "f")]
    (if (> (count indexed) 0)
      indexed
      (index-sequence-under index sequence-id "a"))))

(defn module-sequence
  [index: SourceIndexV0
   module-root: core/NativeId
   predicate: String] -> (Vec core/NativeId)
  (let [sequence: (U core/NativeId Nil)
        (index-first-object index module-root predicate)]
    (if (nil? sequence) [] (index-sequence-items index sequence))))

(defn source-module-root
  [index: SourceIndexV0
   definition: core/NativeId] -> (U core/NativeId Nil)
  (let [root: (U core/NativeId Nil)
        (get (sourceindexv0-definition-roots index) (id-value definition))
        roots: (Vec core/NativeId) (index-form-ids index "module-root")]
    (if (nil? root)
      (if (= 1 (count roots)) (nth roots 0) nil)
      root)))

(defn source-module-name
  [index: SourceIndexV0
   definition: core/NativeId] -> String
  (let [root: (U core/NativeId Nil) (source-module-root index definition)]
    (if (nil? root)
      ""
      (let [name: (U String Nil) (index-first-text index root "namespace")]
        (if (nil? name) "" name)))))

(defn module-root-named
  [index: SourceIndexV0
   module-name: String] -> (U core/NativeId Nil)
  (get (sourceindexv0-module-roots index) module-name))

(defn imported-module-name
  [index: SourceIndexV0
   module-name: String
   alias: String] -> (U String Nil)
  (let [root: (U core/NativeId Nil) (module-root-named index module-name)
        imports: (Vec core/NativeId)
        (if (nil? root) [] (module-sequence index root "imports"))]
    (loop [position: Int 0]
      (if (>= position (count imports))
        nil
        (let [import-node: core/NativeId (nth imports position)
              candidate: (U String Nil) (index-first-text index import-node "alias")
              target: (U String Nil) (index-first-text index import-node "namespace")]
          (if (and (some? candidate) (= alias candidate) (some? target))
            target
            (recur (+ position 1))))))))

(defn add-module-indexes [index: SourceIndexV0] -> SourceIndexV0
  (let [roots: (Vec core/NativeId) (index-form-ids index "module-root")]
    (loop [position: Int 0
           definition-roots: (Map String core/NativeId) {}
           module-roots: (Map String core/NativeId) {}]
      (if (>= position (count roots))
        (with (with index [:definition-roots definition-roots])
          [:module-roots module-roots])
        (let [root: core/NativeId (nth roots position)
              module-name: (U String Nil) (index-first-text index root "namespace")
              definitions: (Vec core/NativeId)
              (module-sequence index root "definitions")
              next-definitions: (Map String core/NativeId)
              (loop [inner: Int 0 current: (Map String core/NativeId) definition-roots]
                (if (>= inner (count definitions))
                  current
                  (let [key: String (id-value (nth definitions inner))]
                    (recur (+ inner 1)
                      (if (nil? (get current key))
                        (assoc current key root)
                        current)))))]
          (recur (+ position 1)
            next-definitions
            (if (or (nil? module-name) (some? (get module-roots module-name)))
              module-roots
              (assoc module-roots module-name root))))))))

(defn build-source-index [graph: worlds/TermGraphV0] -> SourceIndexV0
  (let [facts: (Vec SourceFactV0) (source-facts graph)
        graph-texts: (Map String String) (graph-text-index graph)
        partial: SourceIndexV0
        (loop [position: Int 0
               first-objects: (Map String core/NativeId) {}
               first-texts: (Map String String) {}
               form-ids: (Map String (Vec core/NativeId)) {}
               callee-names: (Map String Bool) {}
               child-nodes: (Map String (Vec core/NativeId)) {}]
          (if (>= position (count facts))
            (->SourceIndexV0 (count facts) first-objects first-texts form-ids
              callee-names child-nodes {} {} [])
            (let [fact: SourceFactV0 (nth facts position)
                  subject: core/NativeId (sourcefactv0-subject fact)
                  object: core/NativeId (sourcefactv0-object fact)
                  predicate: String
                  (graph-text-or-empty graph-texts (sourcefactv0-predicate fact))
                  object-text: String (graph-text-or-empty graph-texts object)
                  key: String (source-index-key subject predicate)
                  existing-object: (U core/NativeId Nil) (get first-objects key)
                  existing-text: (U String Nil) (get first-texts key)
                  prior-forms: (U (Vec core/NativeId) Nil) (get form-ids object-text)
                  forms: (Vec core/NativeId)
                  (if (nil? prior-forms) [] prior-forms)
                  subject-key: String (id-value subject)
                  prior-children: (U (Vec core/NativeId) Nil)
                  (get child-nodes subject-key)
                  children: (Vec core/NativeId)
                  (if (nil? prior-children) [] prior-children)]
              (recur (+ position 1)
                (if (nil? existing-object)
                  (assoc first-objects key object)
                  first-objects)
                (if (nil? existing-text)
                  (assoc first-texts key object-text)
                  first-texts)
                (if (= "form-kind" predicate)
                  (assoc form-ids object-text (conj forms subject))
                  form-ids)
                (if (= "callee" predicate)
                  (assoc callee-names object-text true)
                  callee-names)
                (assoc child-nodes subject-key (conj children object))))))
        indexed: SourceIndexV0 (add-module-indexes partial)
        records: (Vec core/NativeId) (index-form-ids indexed "record")
        names: (Vec String)
        (loop [position: Int 0 collected: (Vec String) []]
          (if (>= position (count records))
            collected
            (let [name: (U String Nil)
                  (index-first-text indexed (nth records position) "name")]
              (recur (+ position 1)
                (if (nil? name) collected (conj collected name))))))]
    (with indexed [:record-names names])))

(defn encode-term [term: worlds/TermV0] -> String
  (cond
    (instance? native.worlds.NilTermV0 term)
    (worlds/canonical-record "nil"
      [(worlds/encode-bool (worlds/niltermv0-token term))])

    (instance? native.worlds.BoolTermV0 term)
    (worlds/canonical-record "bool"
      [(worlds/encode-bool (worlds/booltermv0-value term))])

    (instance? native.worlds.I64TermV0 term)
    (worlds/canonical-record "i64" [(str (worlds/i64termv0-value term))])

    (instance? native.worlds.F64TermV0 term)
    (worlds/canonical-record "f64"
      [(worlds/f64termv0-canonical-value term)])

    (instance? native.worlds.TextTermV0 term)
    (worlds/canonical-record "text" [(worlds/texttermv0-value term)])

    (instance? native.worlds.RefTermV0 term)
    (worlds/canonical-record "ref"
      [(id-value (worlds/reftermv0-target term))])

    :else
    (worlds/canonical-record "triple"
      [(id-value (worlds/tripletermv0-subject term))
       (id-value (worlds/tripletermv0-predicate term))
       (id-value (worlds/tripletermv0-object term))])))

(defn encode-node [node: worlds/TermNodeV0] -> String
  (worlds/canonical-record "node"
    [(id-value (worlds/termnodev0-identity node))
     (encode-term (worlds/termnodev0-term node))]))

(defn encode-term-graph [graph: worlds/TermGraphV0] -> String
  (let [encoded-nodes: (Vec String)
        (mapv
          (fn [node: worlds/TermNodeV0] -> String (encode-node node))
          (worlds/termgraphv0-nodes graph))]
    (worlds/canonical-record "term-graph-v0"
      [(id-value (worlds/termgraphv0-root graph))
       (worlds/canonical-set "nodes" encoded-nodes)])))

(defn encode-source-module [module: worlds/SourceModuleV0] -> String
  (worlds/canonical-record "source-module-v0"
    [(id-value (worlds/sourcemodulev0-id module))
     (worlds/sourcemodulev0-name module)
     (worlds/sourcemodulev0-relative-path module)
     (worlds/sourcemodulev0-source-digest module)
     (worlds/sourcemodulev0-interface-digest module)
     (id-value (worlds/sourcemodulev0-root-term module))]))

(defn encode-source-world [world: worlds/SourceProgramWorldV0] -> String
  (let [modules: (Vec String)
        (mapv
          (fn [module: worlds/SourceModuleV0] -> String
            (encode-source-module module))
          (worlds/sourceprogramworldv0-modules world))
        imports: (Vec String)
        (mapv
          (fn [id: core/NativeId] -> String (id-value id))
          (worlds/sourceprogramworldv0-imports world))]
    (worlds/canonical-record "source-program-world-v0"
      [(encode-term-graph (worlds/sourceprogramworldv0-terms world))
       (worlds/canonical-set "modules" modules)
       (worlds/canonical-set "imports" imports)])))

(defn source-world-valid? [world: worlds/SourceProgramWorldV0] -> Bool
  (let [graph: worlds/TermGraphV0 (worlds/sourceprogramworldv0-terms world)
        nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)
        identities: (Map String Bool) (graph-identity-index graph)
        modules: (Vec worlds/SourceModuleV0)
        (worlds/sourceprogramworldv0-modules world)]
    (and (= true (get identities (id-value (worlds/termgraphv0-root graph))))
         (= (count nodes) (count identities))
         (graph-reference-closed-in? graph identities)
         (every?
           (fn [module: worlds/SourceModuleV0] -> Bool
             (= true
               (get identities
                 (id-value (worlds/sourcemodulev0-root-term module)))))
           modules))))

(defn source-failure [world: worlds/SourceProgramWorldV0] -> LowerFailureV0
  (let [graph: worlds/TermGraphV0 (worlds/sourceprogramworldv0-terms world)
        root: core/NativeId (worlds/termgraphv0-root graph)
        nodes: (Vec worlds/TermNodeV0) (worlds/termgraphv0-nodes graph)
        identities: (Map String Bool) (graph-identity-index graph)]
    (cond
      (not (= true (get identities (id-value root))))
      (->MissingGraphRootV0 root)

      (not (= (count nodes) (count identities)))
      (->DuplicateTermIdentityV0 root)

      (not (graph-reference-closed-in? graph identities))
      (->UnclosedTermReferenceV0 root root)

      :else
      (->InvalidSourceModuleV0 root "a module root is absent from the source Term graph"))))

(defn encode-configuration [configuration: (Vec String)] -> String
  (worlds/canonical-set "configuration" configuration))

(defn make-receipt
  [input-digest: String
   compiler-commit: String
   pass-id: String
   configuration: (Vec String)
   diagnostics: (Vec core/DiagnosticV0)
   obligations: (Vec core/ReceiptObligationV0)
   output-digest: String] -> core/PassReceiptV0
  (core/->PassReceiptV0
    (lower-id "receipt" [pass-id input-digest output-digest])
    input-digest
    compiler-commit
    pass-id
    "v0"
    configuration
    (worlds/configuration-digest configuration)
    diagnostics
    obligations
    output-digest
    "none"
    "none"
    []))

(defn source-closure-obligation
  [digest: String
   passed: Bool
   detail: String] -> core/ReceiptObligationV0
  (core/->ReceiptObligationV0
    (core/->ValidSsaObligation true)
    "v0"
    digest
    passed
    detail))

(defn seal-source-world
  [world: worlds/SourceProgramWorldV0
   compiler-commit: String
   configuration: (Vec String)] -> SourceSealResultV0
  (let [encoding: String (worlds/encode-source-world world)
        digest: String (worlds/content-digest encoding)]
    (if (source-world-valid? world)
      (->SourceSealAcceptedV0
        (worlds/->SealedSourceWorldV0 world encoding digest)
        (make-receipt digest compiler-commit "source-seal" configuration []
          [(source-closure-obligation digest true
             "source Term identities and module roots are closed")]
          digest))
      (let [failure: LowerFailureV0 (source-failure world)]
        (->SourceSealRejectedV0
          failure
          (make-receipt digest compiler-commit "source-seal" configuration
            [(core/->DiagnosticV0
               "LOWER-SOURCE-NOT-CLOSED"
               "source Term graph or module roots are not closed")]
            [(source-closure-obligation digest false
               "source Term identities or module roots are not closed")]
            ""))))))

;; The records below are a closed hot-loop projection of the authoritative
;; typed Term graph. They are discarded and rebuilt from the sealed world.
(defunion NativeReadinessV0
  (NativeReadyV0 [operation: String])
  (NativeLoweredV0
    [entry-block: core/NativeId
     blocks: (Vec core/BasicBlock)])
  (NativeTodoV0
    [code: String
     detail: String]))

(defrecord TypedFunctionV0
  [id: core/NativeId
   name: String
   abi-symbol: String
   parameters: (Vec core/Parameter)
   return-type: core/NativeId
   failure-type: core/NativeId
   effects: (Vec core/NativeId)
   readiness: NativeReadinessV0
   encoding: String])

(defrecord TypedSliceV0
  [types: (Vec core/TypeDef)
   functions: (Vec TypedFunctionV0)
   effects: (Vec core/EffectDef)
   regions: (Vec core/RegionDef)
   capabilities: (Vec core/CapabilityDef)
   failures: (Vec core/NativeId)])

(defn ready-function? [function: TypedFunctionV0] -> Bool
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) true]
    [(NativeLoweredV0 entry-block blocks) true]
    [(NativeTodoV0 code detail) false]))

(defn function-operation [function: TypedFunctionV0] -> String
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) operation]
    [(NativeLoweredV0 entry-block blocks) "native-body-v0"]
    [(NativeTodoV0 code detail) "pending"]))

(defn function-body-blocks [function: TypedFunctionV0] -> (Vec core/BasicBlock)
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) []]
    [(NativeLoweredV0 entry-block blocks) blocks]
    [(NativeTodoV0 code detail) []]))

(defn function-body-entry [function: TypedFunctionV0] -> (U core/NativeId Nil)
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) nil]
    [(NativeLoweredV0 entry-block blocks) entry-block]
    [(NativeTodoV0 code detail) nil]))

(defrecord TypeResolutionV0
  [type-id: core/NativeId
   definitions: (Vec core/TypeDef)
   diagnostics: (Vec core/DiagnosticV0)
   valid: Bool])

(defunion TypingResultV0
  (TypingAcceptedV0
    [sealed: worlds/SealedTypedWorldV0
     slice: TypedSliceV0
     receipt: core/PassReceiptV0])
  (TypingRejectedV0
    [failure: LowerFailureV0
     receipt: core/PassReceiptV0]))

(defn ends-with?
  [value: String
   suffix: String] -> Bool
  (let [value-count: Int (count value)
        suffix-count: Int (count suffix)]
    (and (>= value-count suffix-count)
         (= suffix (subs value (- value-count suffix-count) value-count)))))

(defn unqualified-name [spelling: String] -> String
  (loop [index: Int 0 start: Int 0]
    (if (>= index (count spelling))
      (subs spelling start (count spelling))
      (if (= "/" (subs spelling index (+ index 1)))
        (recur (+ index 1) (+ index 1))
        (recur (+ index 1) start)))))

(defrecord ResolvedSourceNameV0
  [module-name: String
   local-name: String
   visible: Bool])

(defn first-slash [spelling: String] -> Int
  (loop [position: Int 0]
    (if (>= position (count spelling))
      -1
      (if (= "/" (subs spelling position (+ position 1)))
        position
        (recur (+ position 1))))))

(defn resolve-source-name
  [index: SourceIndexV0
   module-name: String
   spelling: String] -> ResolvedSourceNameV0
  (let [slash: Int (first-slash spelling)]
    (if (< slash 0)
      (->ResolvedSourceNameV0 module-name spelling (> (count spelling) 0))
      (let [alias: String (subs spelling 0 slash)
            local-name: String (subs spelling (+ slash 1) (count spelling))
            imported: (U String Nil)
            (if (= alias module-name)
              module-name
              (imported-module-name index module-name alias))]
        (if (or (nil? imported) (= "" local-name))
          (->ResolvedSourceNameV0 "" local-name false)
          (->ResolvedSourceNameV0 imported local-name true))))))

(defn resolved-source-key [resolved: ResolvedSourceNameV0] -> String
  (if (resolvedsourcenamev0-visible resolved)
    (str (resolvedsourcenamev0-module-name resolved) "/"
      (resolvedsourcenamev0-local-name resolved))
    ""))

(defn type-id [name: String] -> core/NativeId
  (lower-id "type" [(unqualified-name name)]))

(defn field-id
  [record-name: String
   field-name: String] -> core/NativeId
  (lower-id "field" [(unqualified-name record-name) field-name]))

(defn function-id
  [source-id: core/NativeId
   name: String] -> core/NativeId
  (lower-id "function" [(id-value source-id) name]))

(defn variant-id
  [owner: String
   name: String] -> core/NativeId
  (lower-id "variant" [owner name]))

(defn bool-type [] -> core/TypeDef
  (core/->TypeDef (type-id "Bool") "Bool"
    (core/->AtomType (core/->BoolKind true))))

(defn i64-type [] -> core/TypeDef
  (core/->TypeDef (type-id "Int") "I64"
    (core/->AtomType (core/->I64Kind true))))

(defn f64-type [] -> core/TypeDef
  (core/->TypeDef (type-id "Float") "F64"
    (core/->AtomType (core/->F64Kind true))))

(defn text-type [] -> core/TypeDef
  (core/->TypeDef (type-id "String") "Text"
    (core/->AtomType (core/->TextKind true))))

(defn bytes-type-id [] -> core/NativeId (type-id "NativeBytes"))

(defn bytes-type [] -> core/TypeDef
  (core/->TypeDef (bytes-type-id) "NativeBytes"
    (core/->AtomType (core/->BytesKind true))))

(defn regex-match-type-id [] -> core/NativeId
  (lower-id "regex-match-type" [(id-value (type-id "String"))]))

;; A successful regular-expression search always has element zero (the whole
;; match), so an empty vector is an unambiguous absence representation.
(defn regex-match-type [] -> core/TypeDef
  (core/->TypeDef (regex-match-type-id) "RegexMatch"
    (core/->VectorType (type-id "String"))))

(defn keyword-type [] -> core/TypeDef
  (core/->TypeDef (type-id "Keyword") "Keyword"
    (core/->AtomType (core/->KeywordKind true))))

;; The arena handle a body acquires before it allocates. Self-referential by
;; construction: an opaque pointer has no closed pointee in the native world.
(defn arena-handle-type-id [] -> core/NativeId (type-id "ArenaHandle"))

(defn arena-handle-type [] -> core/TypeDef
  (core/->TypeDef (arena-handle-type-id) "ArenaHandle"
    (core/->ReferenceType (arena-handle-type-id))))

(defn atom-state-handle-type-id [] -> core/NativeId
  (type-id "AtomStateHandle"))

(defn atom-state-handle-type [] -> core/TypeDef
  (core/->TypeDef (atom-state-handle-type-id) "AtomStateHandle"
    (core/->ReferenceType (atom-state-handle-type-id))))

(defn nil-type [] -> core/TypeDef
  (core/->TypeDef (type-id "Nil") "Unit"
    (core/->UnionType
      [(core/->TypeVariant (variant-id "Unit" "unit") "unit" nil)])))

(defn record-reference-type-id [record-name: String] -> core/NativeId
  (lower-id "reference-type" [(id-value (type-id record-name))]))

(defn record-reference-type [record-name: String] -> core/TypeDef
  (core/->TypeDef (record-reference-type-id record-name) "Reference"
    (core/->ReferenceType (type-id record-name))))

;; Records enter Any by reference, never by value: a record whose own fields are
;; Any (Triple) would otherwise have no finite layout.
(defn slice-value-variants [record-names: (Vec String)] -> (Vec core/TypeVariant)
  (loop [position: Int 0
         variants: (Vec core/TypeVariant)
         [(core/->TypeVariant (variant-id "SliceValue" "bool") "bool" (type-id "Bool"))
          (core/->TypeVariant (variant-id "SliceValue" "i64") "i64" (type-id "Int"))
          (core/->TypeVariant (variant-id "SliceValue" "f64") "f64" (type-id "Float"))
          (core/->TypeVariant (variant-id "SliceValue" "text") "text" (type-id "String"))
          (core/->TypeVariant (variant-id "SliceValue" "keyword") "keyword"
            (type-id "Keyword"))
          (core/->TypeVariant (variant-id "SliceValue" "nil") "nil" nil)]]
    (if (>= position (count record-names))
      variants
      (let [name: String (nth record-names position)]
        (recur (+ position 1)
          (conj variants
            (core/->TypeVariant (variant-id "SliceValue" name) name
              (record-reference-type-id name))))))))

(defn slice-value-type [record-names: (Vec String)] -> core/TypeDef
  (core/->TypeDef (type-id "SliceValue") "SliceValue"
    (core/->UnionType (slice-value-variants record-names))))

(defn slice-value-definitions [record-names: (Vec String)] -> (Vec core/TypeDef)
  (loop [position: Int 0
         definitions: (Vec core/TypeDef)
         [(slice-value-type record-names) (bool-type) (i64-type) (f64-type)
          (text-type) (keyword-type)]]
    (if (>= position (count record-names))
      definitions
      (recur (+ position 1)
        (conj definitions (record-reference-type (nth record-names position)))))))

;; A record enters every closed union by reference, as it enters Any: a by-value
;; alternative has no address to hand a tag-inject coercion.
(defn union-member-id
  [record-names: (Vec String)
   member: core/NativeId] -> core/NativeId
  (loop [position: Int 0]
    (if (>= position (count record-names))
      member
      (let [name: String (nth record-names position)]
        (if (same-id? member (type-id name))
          (record-reference-type-id name)
          (recur (+ position 1)))))))

(defn union-member-ids
  [record-names: (Vec String)
   ids: (Vec core/NativeId)] -> (Vec core/NativeId)
  (mapv
    (fn [member: core/NativeId] -> core/NativeId
      (union-member-id record-names member))
    ids))

(defn lower-failure-type [] -> core/TypeDef
  (core/->TypeDef (type-id "LowerFailure") "LowerFailure"
    (core/->UnionType
      [(core/->TypeVariant (variant-id "LowerFailure" "invalid-term") "invalid-term" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "invalid-coordinate") "invalid-coordinate" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "union-variant-mismatch") "union-variant-mismatch" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "bounds") "bounds" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "overflow") "overflow" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "malformed-source") "malformed-source" nil)])))

;; An Outcome's tag namespace is its failure union, so the success alternative
;; has to live there: `ok` carries the value, `overflow` carries nothing.
(defn checked-i64-result-type [] -> core/TypeDef
  (core/->TypeDef (core/checked-i64-result-type-id) "CheckedI64Result"
    (core/->UnionType
      [(core/->TypeVariant (core/checked-ok-variant-id) "ok" (type-id "Int"))
       (core/->TypeVariant (core/checked-overflow-variant-id) "overflow" nil)])))

(defn checked-i64-type [] -> core/TypeDef
  (core/->TypeDef (core/checked-i64-type-id) "CheckedI64"
    (core/->OutcomeType (type-id "Int") (core/checked-i64-result-type-id))))

(defn checked-arithmetic-types [] -> (Vec core/TypeDef)
  [(i64-type) (checked-i64-result-type) (checked-i64-type)])

(defn socket-int-result-type-id [] -> core/NativeId
  (type-id "HostSocketIntResult"))

(defn socket-int-outcome-type-id [] -> core/NativeId
  (type-id "HostSocketIntOutcome"))

(defn socket-bytes-result-type-id [] -> core/NativeId
  (type-id "HostSocketBytesResult"))

(defn socket-bytes-outcome-type-id [] -> core/NativeId
  (type-id "HostSocketBytesOutcome"))

(defn socket-close-result-type-id [] -> core/NativeId
  (type-id "HostSocketCloseResult"))

(defn socket-close-outcome-type-id [] -> core/NativeId
  (type-id "HostSocketCloseOutcome"))

(defn socket-result-variants
  [owner: String
   ok-payload: (U core/NativeId Nil)] -> (Vec core/TypeVariant)
  [(core/->TypeVariant (variant-id owner "ok") "ok" ok-payload)
   (core/->TypeVariant (variant-id owner "peer-closed") "peer-closed" nil)
   (core/->TypeVariant (variant-id owner "error") "error" (type-id "Int"))])

(defn socket-int-result-type [] -> core/TypeDef
  (core/->TypeDef (socket-int-result-type-id) "HostSocketIntResult"
    (core/->UnionType
      (socket-result-variants "HostSocketIntResult" (type-id "Int")))))

(defn socket-int-outcome-type [] -> core/TypeDef
  (core/->TypeDef (socket-int-outcome-type-id) "HostSocketIntOutcome"
    (core/->OutcomeType (type-id "Int") (socket-int-result-type-id))))

(defn socket-bytes-result-type [] -> core/TypeDef
  (core/->TypeDef (socket-bytes-result-type-id) "HostSocketBytesResult"
    (core/->UnionType
      (socket-result-variants "HostSocketBytesResult" (bytes-type-id)))))

(defn socket-bytes-outcome-type [] -> core/TypeDef
  (core/->TypeDef (socket-bytes-outcome-type-id) "HostSocketBytesOutcome"
    (core/->OutcomeType (bytes-type-id) (socket-bytes-result-type-id))))

(defn socket-close-result-type [] -> core/TypeDef
  (core/->TypeDef (socket-close-result-type-id) "HostSocketCloseResult"
    (core/->UnionType
      (socket-result-variants "HostSocketCloseResult" nil))))

(defn socket-close-outcome-type [] -> core/TypeDef
  (core/->TypeDef (socket-close-outcome-type-id) "HostSocketCloseOutcome"
    (core/->OutcomeType (type-id "Nil") (socket-close-result-type-id))))

(defn socket-outcome-types [] -> (Vec core/TypeDef)
  [(i64-type) (nil-type) (bytes-type)
   (socket-int-result-type) (socket-int-outcome-type)
   (socket-bytes-result-type) (socket-bytes-outcome-type)
   (socket-close-result-type) (socket-close-outcome-type)])

(defn type-def-in?
  [definitions: (Vec core/TypeDef)
   id: core/NativeId] -> Bool
  (loop [index: Int 0]
    (if (>= index (count definitions))
      false
      (if (same-id? id (core/typedef-id (nth definitions index)))
        true
        (recur (+ index 1))))))

(defn append-type-def
  [definitions: (Vec core/TypeDef)
   definition: core/TypeDef] -> (Vec core/TypeDef)
  (if (type-def-in? definitions (core/typedef-id definition))
    definitions
    (conj definitions definition)))

(defn append-type-defs
  [definitions: (Vec core/TypeDef)
   additions: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [index: Int 0 current: (Vec core/TypeDef) definitions]
    (if (>= index (count additions))
      current
      (recur (+ index 1) (append-type-def current (nth additions index))))))

(defn union-member-definitions
  [record-names: (Vec String)
   ids: (Vec core/NativeId)
   definitions: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [position: Int 0 current: (Vec core/TypeDef) definitions]
    (if (>= position (count record-names))
      current
      (let [name: String (nth record-names position)]
        (recur (+ position 1)
          (if (core/id-in? ids (type-id name))
            (append-type-def current (record-reference-type name))
            current))))))

(defn builtin-types [record-names: (Vec String)] -> (Vec core/TypeDef)
  (append-type-defs
    [(bool-type) (i64-type) (f64-type) (text-type) (keyword-type)
     (nil-type) (lower-failure-type)]
    (slice-value-definitions record-names)))

(defn append-diagnostics
  [left: (Vec core/DiagnosticV0)
   right: (Vec core/DiagnosticV0)] -> (Vec core/DiagnosticV0)
  (vec (concat left right)))

(defn source-type-kind
  [index: SourceIndexV0
   source-type: core/NativeId] -> (U String Nil)
  (let [kind: (U String Nil) (index-first-text index source-type "type-kind")]
    (if (some? kind) kind (index-first-text index source-type "form-kind"))))

(defn source-type-spelling
  [index: SourceIndexV0
   source-type: core/NativeId] -> (U String Nil)
  (let [name: (U String Nil) (index-first-text index source-type "name")]
    (if (some? name) name (index-first-text index source-type "f0"))))

(defn primitive-resolution
  [index: SourceIndexV0
   source-type: core/NativeId
   spelling: String] -> TypeResolutionV0
  (cond
    (= "Bool" spelling)
    (->TypeResolutionV0 (type-id "Bool") [(bool-type)] [] true)

    (= "Int" spelling)
    (->TypeResolutionV0 (type-id "Int") [(i64-type)] [] true)

    (= "Float" spelling)
    (->TypeResolutionV0 (type-id "Float") [(f64-type)] [] true)

    (= "String" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    ;; Regex values stay as their sealed pattern text until a regex operation
    ;; consumes them; compilation belongs to the materializer/runtime boundary.
    (= "Regex" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    (= "SpaceId" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    (= "Keyword" spelling)
    (->TypeResolutionV0 (type-id "Keyword") [(keyword-type)] [] true)

    (= "Nil" spelling)
    (->TypeResolutionV0 (type-id "Nil") [(nil-type)] [] true)

    (= "Any" spelling)
    (->TypeResolutionV0
      (type-id "SliceValue")
      (slice-value-definitions (sourceindexv0-record-names index))
      [(core/->DiagnosticV0
         "LOWER-CLOSED-RAW-ANY"
         "raw Any was closed to the finite SliceValue union")]
      true)

    :else
    (let [name: String (unqualified-name spelling)
          id: core/NativeId (type-id name)]
      (->TypeResolutionV0 id [] [] true))))

(defn source-type-arguments
  [index: SourceIndexV0
   source-type: core/NativeId] -> (Vec core/NativeId)
  (let [direct: (U core/NativeId Nil) (index-first-object index source-type "args")
        legacy: (U core/NativeId Nil) (index-first-object index source-type "f1")
        arguments: (U core/NativeId Nil) (if (some? direct) direct legacy)]
    (if (nil? arguments) [] (index-sequence-items index arguments))))

(defn resolution-ids [resolutions: (Vec TypeResolutionV0)] -> (Vec core/NativeId)
  (mapv
    (fn [resolution: TypeResolutionV0] -> core/NativeId
      (typeresolutionv0-type-id resolution))
    resolutions))

(defn resolution-definitions [resolutions: (Vec TypeResolutionV0)] -> (Vec core/TypeDef)
  (loop [index: Int 0 definitions: (Vec core/TypeDef) []]
    (if (>= index (count resolutions))
      definitions
      (recur (+ index 1)
        (append-type-defs definitions
          (typeresolutionv0-definitions (nth resolutions index)))))))

(defn resolution-diagnostics [resolutions: (Vec TypeResolutionV0)] -> (Vec core/DiagnosticV0)
  (loop [index: Int 0 diagnostics: (Vec core/DiagnosticV0) []]
    (if (>= index (count resolutions))
      diagnostics
      (recur (+ index 1)
        (append-diagnostics diagnostics
          (typeresolutionv0-diagnostics (nth resolutions index)))))))

(defn union-variants
  [owner: String
   type-ids: (Vec core/NativeId)] -> (Vec core/TypeVariant)
  (loop [index: Int 0 variants: (Vec core/TypeVariant) []]
    (if (>= index (count type-ids))
      variants
      (recur (+ index 1)
        (conj variants
          (core/->TypeVariant
            (variant-id owner (str index))
            (str "case-" index)
            (nth type-ids index)))))))

(defn nullable-map-value-type-id [value-type: core/NativeId] -> core/NativeId
  (lower-id "closed-union-type"
    [(id-value value-type) (id-value (type-id "Nil"))]))

(defn nullable-map-value-type [value-type: core/NativeId] -> core/TypeDef
  (let [id: core/NativeId (nullable-map-value-type-id value-type)
        owner: String (id-value id)]
    (core/->TypeDef id "ClosedUnion"
      (core/->UnionType
        (union-variants owner [value-type (type-id "Nil")])))))

(defn application-resolution
  [source-type: core/NativeId
   constructor: String
   record-names: (Vec String)
   resolutions: (Vec TypeResolutionV0)] -> TypeResolutionV0
  (let [ids: (Vec core/NativeId) (resolution-ids resolutions)
        definitions: (Vec core/TypeDef) (resolution-definitions resolutions)
        diagnostics: (Vec core/DiagnosticV0) (resolution-diagnostics resolutions)]
    (cond
      (and (= "Vec" constructor) (= 1 (count ids)))
      (let [id: core/NativeId (lower-id "vector-type" [(id-value (nth ids 0))])]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (core/->TypeDef id "Vector" (core/->VectorType (nth ids 0))))
          diagnostics
          true))

      (and (= "Atom" constructor) (= 1 (count ids)))
      (let [id: core/NativeId
            (lower-id "atom-cell-type" [(id-value (nth ids 0))])]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (core/->TypeDef id "AtomCell"
              (core/->AtomCellTypeV0 (nth ids 0))))
          diagnostics
          true))

      (and (= "Map" constructor) (= 2 (count ids)))
      (let [id: core/NativeId
            (lower-id "map-type-v0"
              [(id-value (nth ids 0)) (id-value (nth ids 1))])]
        (->TypeResolutionV0 id
          (append-type-def
            (append-type-def definitions
              (nullable-map-value-type (nth ids 1)))
            (core/->TypeDef id "Map"
              (core/->MapTypeV0 (nth ids 0) (nth ids 1)
                (core/->InsertionOrderV0 true))))
          diagnostics
          true))

      (and (= "Set" constructor) (= 1 (count ids)))
      (let [id: core/NativeId
            (lower-id "set-type-v0" [(id-value (nth ids 0))])]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (core/->TypeDef id "Set"
              (core/->SetTypeV0 (nth ids 0) (core/->InsertionOrderV0 true))))
          diagnostics
          true))

      (or (= "Dyn" constructor) (= "U" constructor))
      (let [members: (Vec core/NativeId) (union-member-ids record-names ids)
            id: core/NativeId
            (lower-id "closed-union-type"
              (mapv (fn [part: core/NativeId] -> String (id-value part)) members))]
        (->TypeResolutionV0 id
          (append-type-def
            (union-member-definitions record-names ids definitions)
            (core/->TypeDef id "ClosedUnion"
              (core/->UnionType (union-variants (id-value id) members))))
          diagnostics
          true))

      :else
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        (conj diagnostics
          (core/->DiagnosticV0
            "LOWER-UNSUPPORTED-TYPE-APPLICATION"
            (str "unsupported closed type constructor: " constructor)))
        false))))

(defn resolve-source-type
  [index: SourceIndexV0
   source-type: core/NativeId] -> TypeResolutionV0
  (let [kind: (U String Nil) (source-type-kind index source-type)
        spelling: (U String Nil) (source-type-spelling index source-type)]
    (cond
      (nil? kind)
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-MISSING-TYPE-KIND"
           (str "source type has no kind: " (id-value source-type)))]
        false)

      (or (= "type-prim" kind) (= "prim" kind))
      (if (nil? spelling)
        (->TypeResolutionV0
          (type-id "LowerFailure")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-MISSING-TYPE-NAME"
             (str "primitive type has no spelling: " (id-value source-type)))]
          false)
        (primitive-resolution index source-type spelling))

      (or (= "type-app" kind) (= "app" kind))
      (if (nil? spelling)
        (->TypeResolutionV0
          (type-id "LowerFailure")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-MISSING-TYPE-CONSTRUCTOR"
             (str "type application has no constructor: " (id-value source-type)))]
          false)
        (let [arguments: (Vec core/NativeId) (source-type-arguments index source-type)
              resolutions: (Vec TypeResolutionV0)
              (mapv
                (fn [argument: core/NativeId] -> TypeResolutionV0
                  (resolve-source-type index argument))
                arguments)]
          (application-resolution source-type spelling
            (sourceindexv0-record-names index) resolutions)))

      (or (= "type-union" kind) (= "union" kind))
      (let [arguments: (Vec core/NativeId) (source-type-arguments index source-type)
            resolutions: (Vec TypeResolutionV0)
            (mapv
              (fn [argument: core/NativeId] -> TypeResolutionV0
                (resolve-source-type index argument))
              arguments)]
        (application-resolution source-type "U"
          (sourceindexv0-record-names index) resolutions))

      (= "type-fn" kind)
      (let [parameters-node: (U core/NativeId Nil)
            (index-first-object index source-type "params")
            parameter-sources: (Vec core/NativeId)
            (if (nil? parameters-node)
              []
              (index-sequence-items index parameters-node))
            rest-source: (U core/NativeId Nil)
            (index-first-object index source-type "rest")
            return-source: (U core/NativeId Nil)
            (index-first-object index source-type "ret")
            component-sources: (Vec core/NativeId)
            (vec (concat parameter-sources
                   (if (nil? rest-source) [] [rest-source])
                   (if (nil? return-source) [] [return-source])))
            resolutions: (Vec TypeResolutionV0)
            (mapv
              (fn [component: core/NativeId] -> TypeResolutionV0
                (resolve-source-type index component))
              component-sources)
            parameter-count: Int (count parameter-sources)
            parameter-types: (Vec core/NativeId)
            (loop [position: Int 0 collected: (Vec core/NativeId) []]
              (if (>= position parameter-count)
                collected
                (recur (+ position 1)
                  (conj collected
                    (typeresolutionv0-type-id (nth resolutions position))))))
            rest-position: Int parameter-count
            return-position: Int
            (+ parameter-count (if (nil? rest-source) 0 1))
            rest-type: (U core/NativeId Nil)
            (if (nil? rest-source)
              nil
              (typeresolutionv0-type-id (nth resolutions rest-position)))
            return-type: core/NativeId
            (if (nil? return-source)
              (type-id "LowerFailure")
              (typeresolutionv0-type-id (nth resolutions return-position)))
            parts: (Vec String)
            (vec (concat
                   (mapv
                     (fn [parameter: core/NativeId] -> String
                       (id-value parameter))
                     parameter-types)
                   [(if (nil? rest-type)
                      "fixed"
                      (str "rest:" (id-value rest-type)))
                    "returns"
                    (id-value return-type)]))
            id: core/NativeId (lower-id "function-type" parts)
            definitions: (Vec core/TypeDef)
            (append-type-def
              (resolution-definitions resolutions)
              (core/->TypeDef id "Function"
                (core/->FunctionType parameter-types rest-type return-type)))
            diagnostics: (Vec core/DiagnosticV0)
            (resolution-diagnostics resolutions)
            valid: Bool
            (and (some? return-source)
              (every?
                (fn [resolution: TypeResolutionV0] -> Bool
                  (typeresolutionv0-valid resolution))
                resolutions))]
        (->TypeResolutionV0 id definitions
          (if (some? return-source)
            diagnostics
            (conj diagnostics
              (core/->DiagnosticV0
                "LOWER-FUNCTION-TYPE-RETURN"
                "function type has no return annotation")))
          valid))

      :else
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-UNSUPPORTED-TYPE-KIND"
           (str "unsupported source type kind: " kind))]
        false))))

(defrecord RecordResolutionV0
  [definition: core/TypeDef
   supporting-definitions: (Vec core/TypeDef)
   diagnostics: (Vec core/DiagnosticV0)
   valid: Bool])

(defrecord ParameterResolutionV0
  [parameters: (Vec core/Parameter)
   definitions: (Vec core/TypeDef)
   diagnostics: (Vec core/DiagnosticV0)
   valid: Bool])

(defrecord FunctionResolutionV0
  [function: TypedFunctionV0
   definitions: (Vec core/TypeDef)
   diagnostics: (Vec core/DiagnosticV0)
   valid: Bool])

(defn field-name-at
  [index: SourceIndexV0
   source-field: core/NativeId] -> (U String Nil)
  (let [name: (U String Nil) (index-first-text index source-field "name")]
    (if (some? name) name (index-first-text index source-field "f0"))))

(defn field-type-at
  [index: SourceIndexV0
   source-field: core/NativeId] -> (U core/NativeId Nil)
  (let [annotation: (U core/NativeId Nil)
        (index-first-object index source-field "ann")]
    (if (some? annotation)
      annotation
      (index-first-object index source-field "f1"))))

(defn record-field-items
  [index: SourceIndexV0
   source-record: core/NativeId] -> (Vec core/NativeId)
  (let [fields: (U core/NativeId Nil)
        (index-first-object index source-record "fields")]
    (if (nil? fields) [] (index-sequence-items index fields))))

(defn resolve-record
  [index: SourceIndexV0
   source-record: core/NativeId] -> RecordResolutionV0
  (let [record-name: (U String Nil) (index-first-text index source-record "name")]
    (if (nil? record-name)
      (->RecordResolutionV0
        (core/->TypeDef (type-id "LowerFailure") "LowerFailure"
          (core/->ReferenceType (type-id "LowerFailure")))
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-RECORD-MISSING-NAME"
           (str "record form has no name: " (id-value source-record)))]
        false)
      (let [source-fields: (Vec core/NativeId) (record-field-items index source-record)]
        (loop [position: Int 0
               fields: (Vec core/TypeField) []
               definitions: (Vec core/TypeDef) []
               diagnostics: (Vec core/DiagnosticV0) []
               valid: Bool true]
          (if (>= position (count source-fields))
            (->RecordResolutionV0
              (core/->TypeDef (type-id record-name) record-name
                (core/->RecordType fields))
              definitions
              diagnostics
              valid)
            (let [source-field: core/NativeId (nth source-fields position)
                  name: (U String Nil) (field-name-at index source-field)
                  source-type: (U core/NativeId Nil) (field-type-at index source-field)]
              (if (or (nil? name) (nil? source-type))
                (recur (+ position 1)
                  fields
                  definitions
                  (conj diagnostics
                    (core/->DiagnosticV0
                      "LOWER-FIELD-MISSING-ANNOTATION"
                      (str "record field is missing a name or type: "
                        (id-value source-field))))
                  false)
                (let [resolution: TypeResolutionV0
                      (resolve-source-type index source-type)]
                  (recur (+ position 1)
                    (conj fields
                      (core/->TypeField
                        (field-id record-name name)
                        name
                        (typeresolutionv0-type-id resolution)))
                    (append-type-defs definitions
                      (typeresolutionv0-definitions resolution))
                    (append-diagnostics diagnostics
                      (typeresolutionv0-diagnostics resolution))
                    (and valid (typeresolutionv0-valid resolution))))))))))))

(defn resolve-records [index: SourceIndexV0] -> (Vec RecordResolutionV0)
  (mapv
    (fn [source-record: core/NativeId] -> RecordResolutionV0
      (resolve-record index source-record))
    (index-form-ids index "record")))

(defn parameter-name-at
  [index: SourceIndexV0
   source-parameter: core/NativeId] -> String
  (let [name: (U String Nil) (index-first-text index source-parameter "name")
        legacy: (U String Nil) (index-first-text index source-parameter "f0")]
    (cond
      (some? name) name
      (some? legacy) legacy
      :else (str "parameter-" (id-value source-parameter)))))

(defn function-parameter-items
  [index: SourceIndexV0
   source-function: core/NativeId] -> (Vec core/NativeId)
  (let [parameters: (U core/NativeId Nil)
        (index-first-object index source-function "params")]
    (if (nil? parameters) [] (index-sequence-items index parameters))))

(defn resolve-parameters
  [index: SourceIndexV0
   source-function: core/NativeId
   owner-id: core/NativeId] -> ParameterResolutionV0
  (let [source-parameters: (Vec core/NativeId)
        (function-parameter-items index source-function)]
    (loop [position: Int 0
           parameters: (Vec core/Parameter) []
           definitions: (Vec core/TypeDef) []
           diagnostics: (Vec core/DiagnosticV0) []
           valid: Bool true]
      (if (>= position (count source-parameters))
        (->ParameterResolutionV0 parameters definitions diagnostics valid)
        (let [source-parameter: core/NativeId (nth source-parameters position)
              name: String (parameter-name-at index source-parameter)
              source-type: (U core/NativeId Nil) (field-type-at index source-parameter)]
          (if (nil? source-type)
            (recur (+ position 1)
              parameters
              definitions
              (conj diagnostics
                (core/->DiagnosticV0
                  "LOWER-PARAMETER-MISSING-ANNOTATION"
                  (str "function parameter has no closed type: " name)))
              false)
            (let [resolution: TypeResolutionV0
                  (resolve-source-type index source-type)]
              (recur (+ position 1)
                (conj parameters
                  (core/->Parameter
                    (lower-id "parameter" [(id-value owner-id) name])
                    (typeresolutionv0-type-id resolution)))
                (append-type-defs definitions
                  (typeresolutionv0-definitions resolution))
                (append-diagnostics diagnostics
                  (typeresolutionv0-diagnostics resolution))
                (and valid (typeresolutionv0-valid resolution))))))))))

(defn pure-effect-id [] -> core/NativeId (lower-id "effect" ["pure"]))

(defn arena-region-id [] -> core/NativeId (lower-id "region" ["slice-arena"]))

(defn write-effect-id [] -> core/NativeId (lower-id "effect" ["arena-write"]))

(defn write-capability-id [] -> core/NativeId
  (lower-id "capability" ["arena-write"]))

(defn allocate-effect-id [] -> core/NativeId
  (lower-id "effect" ["arena-allocate"]))

(defn allocate-capability-id [] -> core/NativeId
  (lower-id "capability" ["arena-allocate"]))

(defn atom-state-region-id [] -> core/NativeId
  (lower-id "region" ["atom-state"]))

(defn atom-state-effect-id [] -> core/NativeId
  (lower-id "effect" ["atom-state"]))

(defn atom-state-capability-id [] -> core/NativeId
  (lower-id "capability" ["atom-state"]))

(defn host-environment-effect-id [] -> core/NativeId
  (lower-id "effect" ["host-environment-read"]))

(defn host-environment-capability-id [] -> core/NativeId
  (lower-id "capability" ["host-environment"]))

(defn host-environment-abi-id [] -> core/NativeId
  (lower-id "abi" ["host-environment-lookup-v0"]))

(defn host-environment-function-id [] -> core/NativeId
  (lower-id "extern" ["host-environment-lookup-v0"]))

(defn host-environment-callee? [name: String] -> Bool
  (or (= name "System/getenv") (= name "java.lang.System/getenv")))

(defn host-stdout-effect-id [] -> core/NativeId
  (lower-id "effect" ["host-stdout-write"]))

(defn host-stdout-capability-id [] -> core/NativeId
  (lower-id "capability" ["host-stdout"]))

(defn host-stdout-abi-id [] -> core/NativeId
  (lower-id "abi" ["host-stdout-write-line-v0"]))

(defn host-stdout-function-id [] -> core/NativeId
  (lower-id "extern" ["host-stdout-write-line-v0"]))

(defn host-socket-effect-id [] -> core/NativeId
  (lower-id "effect" ["host-socket-peer-lifecycle-v0"]))

(defn host-socket-capability-id [] -> core/NativeId
  (lower-id "capability" ["host-socket-peer-lifecycle-v0"]))

(defn host-socket-abi-id [operation: String] -> core/NativeId
  (lower-id "abi" [(str "host-socket-" operation "-v0")]))

(defn host-socket-function-id [operation: String] -> core/NativeId
  (lower-id "extern" [(str "host-socket-" operation "-v0")]))

(defn host-socket-callee? [name: String] -> Bool
  (or (= name "host.socket/inherited-listener")
      (= name "host.socket/accept")
      (= name "host.socket/read-bounded")
      (= name "host.socket/write-bounded")
      (= name "host.socket/close")))

(defn host-socket-operation [name: String] -> String
  (cond
    (= name "host.socket/inherited-listener") "inherited-listener"
    (= name "host.socket/accept") "accept"
    (= name "host.socket/read-bounded") "read-bounded"
    (= name "host.socket/write-bounded") "write-bounded"
    (= name "host.socket/close") "close"
    :else ""))

(defn host-socket-abi-id? [candidate: core/NativeId] -> Bool
  (or (same-id? candidate (host-socket-abi-id "inherited-listener"))
      (same-id? candidate (host-socket-abi-id "accept"))
      (same-id? candidate (host-socket-abi-id "read-bounded"))
      (same-id? candidate (host-socket-abi-id "write-bounded"))
      (same-id? candidate (host-socket-abi-id "close"))))

(defn slice-effects
  [include-environment: Bool
   include-stdout: Bool
   include-socket: Bool] -> (Vec core/EffectDef)
  (let [base: (Vec core/EffectDef)
        [(core/->EffectDef (pure-effect-id) (core/->PureEffect true))
         (core/->EffectDef (write-effect-id) (core/->WriteEffect (arena-region-id)))
         (core/->EffectDef (allocate-effect-id)
           (core/->AllocateEffect (arena-region-id)))
         (core/->EffectDef (atom-state-effect-id)
           (core/->AtomicEffect (atom-state-region-id)
             (atom-state-capability-id)))]
        with-environment: (Vec core/EffectDef)
        (if include-environment
          (conj base
            (core/->EffectDef (host-environment-effect-id)
              (core/->CapabilityEffect (host-environment-capability-id))))
          base)
        with-stdout: (Vec core/EffectDef)
        (if include-stdout
          (conj with-environment
            (core/->EffectDef (host-stdout-effect-id)
              (core/->IoEffect (host-stdout-capability-id))))
          with-environment)]
      (if include-socket
        (conj with-stdout
          (core/->EffectDef (host-socket-effect-id)
            (core/->SocketEffect (host-socket-capability-id))))
        with-stdout)))

;; RULING (v0): a pure-named function MAY allocate. v0 source carries no effect
;; annotation, so the Allocate effect is inferred from the lowered body and from
;; every callee, then declared in the function, its regions, its capabilities
;; and its ABI. Inferred, never hidden.
(defn function-effects [name: String] -> (Vec core/NativeId)
  (if (ends-with? name "!") [(write-effect-id)] [(pure-effect-id)]))

(defn encode-parameter [parameter: core/Parameter] -> String
  (worlds/canonical-record "parameter"
    [(id-value (core/parameter-id parameter))
     (id-value (core/parameter-type-id parameter))]))

(defn encode-typed-function
  [id: core/NativeId
   name: String
   abi-symbol: String
   parameters: (Vec core/Parameter)
   return-type: core/NativeId
   failure-type: core/NativeId
   effects: (Vec core/NativeId)
   readiness-code: String] -> String
  (worlds/canonical-record "typed-function-v0"
    [(id-value id)
     name
     abi-symbol
     (worlds/canonical-record "parameters"
       (mapv
         (fn [parameter: core/Parameter] -> String
           (encode-parameter parameter))
         parameters))
     (id-value return-type)
     (id-value failure-type)
     (worlds/canonical-record "effects"
       (mapv (fn [effect: core/NativeId] -> String (id-value effect)) effects))
     readiness-code]))

(defn ascii-lower [value: String] -> String
  (let [upper: String "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        lower: String "abcdefghijklmnopqrstuvwxyz"]
    (loop [position: Int 0 result: String ""]
      (if (>= position (count value))
        result
        (let [character: String (subs value position (+ position 1))
              hit: Int
              (loop [scan: Int 0]
                (cond
                  (>= scan 26) -1
                  (= character (subs upper scan (+ scan 1))) scan
                  :else (recur (+ scan 1))))]
          (recur (+ position 1)
            (str result (if (< hit 0) character (subs lower hit (+ hit 1))))))))))

(defn digit-value [character: String] -> Int
  (let [digits: String "0123456789"]
    (loop [scan: Int 0]
      (cond
        (>= scan 10) -1
        (= character (subs digits scan (+ scan 1))) scan
        :else (recur (+ scan 1))))))

(defn parse-int-text [value: String] -> (U Int Nil)
  (let [negative: Bool (and (> (count value) 0) (= "-" (subs value 0 1)))
        start: Int (if negative 1 0)
        maximum: Int 9223372036854775807
        minimum: Int (- (- 0 maximum) 1)
        limit: Int (if negative minimum (- 0 maximum))
        multiply-limit: Int (quot limit 10)]
    (if (>= start (count value))
      nil
      ;; Keep the accumulator negative so Int's asymmetric range needs no +2^63.
      (loop [position: Int start result: Int 0]
        (if (>= position (count value))
          (if negative result (- 0 result))
          (let [digit: Int (digit-value (subs value position (+ position 1)))]
            (cond
              (< digit 0) nil
              (< result multiply-limit) nil
              :else
              (let [shifted: Int (* result 10)]
                (if (< shifted (+ limit digit))
                  nil
                  (recur (+ position 1) (- shifted digit)))))))))))

(defn fact-text
  [index: SourceIndexV0
   subject: core/NativeId
   predicate: String] -> String
  (let [value: (U String Nil) (index-first-text index subject predicate)]
    (if (nil? value) "" value)))

(defrecord GlobalBindingV0
  [module-name: String
   name: String
   value: core/NativeId
   annotation: (U core/NativeId Nil)])

(defn source-globals [index: SourceIndexV0] -> (Vec GlobalBindingV0)
  (let [forms: (Vec core/NativeId) (index-form-ids index "def")]
    (loop [position: Int 0 globals: (Vec GlobalBindingV0) []]
      (if (>= position (count forms))
        globals
        (let [form: core/NativeId (nth forms position)
              name: String (fact-text index form "name")
              value: (U core/NativeId Nil) (index-first-object index form "value")]
          (recur (+ position 1)
            (if (or (= "" name) (nil? value))
              globals
              (conj globals
                (->GlobalBindingV0 (source-module-name index form) name value
                  (index-first-object index form "ann"))))))))))

(defn global-key [global: GlobalBindingV0] -> String
  (str (globalbindingv0-module-name global) "/" (globalbindingv0-name global)))

(defn global-type-definitions
  [index: SourceIndexV0
   globals: (Vec GlobalBindingV0)] -> (Vec core/TypeDef)
  (loop [position: Int 0 definitions: (Vec core/TypeDef) []]
    (if (>= position (count globals))
      definitions
      (let [annotation: (U core/NativeId Nil)
            (globalbindingv0-annotation (nth globals position))]
        (recur (+ position 1)
          (if (nil? annotation)
            definitions
            (append-type-defs definitions
              (typeresolutionv0-definitions
                (resolve-source-type index annotation)))))))))

;; Local annotations participate in body typing just as signatures and globals
;; do. Collect them before lowering so a body's first nullable value already
;; names a closed world type instead of minting one after the fact.
(defn binding-type-definitions [index: SourceIndexV0] -> (Vec core/TypeDef)
  (let [bindings: (Vec core/NativeId) (index-form-ids index "binding")]
    (loop [position: Int 0 definitions: (Vec core/TypeDef) []]
      (if (>= position (count bindings))
        definitions
        (let [annotation: (U core/NativeId Nil)
              (index-first-object index (nth bindings position) "ann")]
          (recur (+ position 1)
            (if (nil? annotation)
              definitions
              (append-type-defs definitions
                (typeresolutionv0-definitions
                  (resolve-source-type index annotation))))))))))

(defn lookup-type
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (U core/TypeDef Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)]
        (if (same-id? target (core/typedef-id definition))
          definition
          (recur (+ position 1)))))))

(defn lookup-named-type
  [types: (Vec core/TypeDef)
   name: String] -> (U core/TypeDef Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)]
        (if (= name (core/typedef-name definition))
          definition
          (recur (+ position 1)))))))

(defn type-carries-function?
  [types: (Vec core/TypeDef)
   target: core/NativeId
   visited: (Vec core/NativeId)
   fuel: Int] -> Bool
  (if (or (<= fuel 0) (core/id-in? visited target))
    false
    (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [shape: core/TypeShape (core/typedef-shape definition)
              next-visited: (Vec core/NativeId) (conj visited target)
              references: (Vec core/NativeId)
              (cond
                (instance? native.core.AtomType shape)
                (let [kind: core/AtomKind (core/atomtype-kind shape)]
                  (if (instance? native.core.RefKind kind)
                    [(core/refkind-target kind)]
                    []))

                (instance? native.core.RecordType shape)
                (mapv
                  (fn [field: core/TypeField] -> core/NativeId
                    (core/typefield-type-id field))
                  (core/recordtype-fields shape))

                (instance? native.core.UnionType shape)
                (loop [position: Int 0
                       variants: (Vec core/TypeVariant)
                       (core/uniontype-variants shape)
                       collected: (Vec core/NativeId) []]
                  (if (>= position (count variants))
                    collected
                    (let [payload: (U core/NativeId Nil)
                          (core/typevariant-payload-type
                            (nth variants position))]
                      (recur (+ position 1) variants
                        (if (nil? payload) collected
                          (conj collected payload))))))

                (instance? native.core.VectorType shape)
                [(core/vectortype-element-type shape)]

                (instance? native.core.ReferenceType shape)
                [(core/referencetype-target-type shape)]

                (instance? native.core.OutcomeType shape)
                [(core/outcometype-value-type shape)
                 (core/outcometype-failure-type shape)]

                :else [])]
          (or (instance? native.core.FunctionType shape)
            (some?
              (some
                (fn [reference: core/NativeId] -> Bool
                  (type-carries-function? types reference next-visited
                    (- fuel 1)))
                references))))))))

(defn function-signature-carries-function?
  [types: (Vec core/TypeDef)
   function: TypedFunctionV0] -> Bool
  (let [fuel: Int (+ 1 (count types))]
    (or
      (type-carries-function? types (typedfunctionv0-return-type function) [] fuel)
      (some?
        (some
          (fn [parameter: core/Parameter] -> Bool
            (type-carries-function? types (core/parameter-type-id parameter) [] fuel))
          (typedfunctionv0-parameters function))))))

(defrecord LocalBindingV0
  [name: String
   value-id: core/NativeId
   type-id: core/NativeId])

;; One live `loop`: the SSA header block whose block-parameters ARE the typed
;; accumulators. `recur` is a Jump back to this header, so the innermost frame
;; is the lexical recur target and a nested loop shadows its parent.
(defrecord LoopFrameV0
  [header-id: core/NativeId
   parameters: (Vec core/Parameter)])

;; One in-flight function body: finished blocks, the open block being filled,
;; the lexical environment, and the first refusal that made lowering stop.
(defrecord BodyStateV0
  [blocks: (Vec core/BasicBlock)
   block-id: core/NativeId
   block-parameters: (Vec core/Parameter)
   instructions: (Vec core/Instruction)
   open: Bool
   counter: Int
   locals: (Vec LocalBindingV0)
   failure: String
   loop-frames: (Vec LoopFrameV0)])

(defrecord ExprResultV0
  [state: BodyStateV0
   value-id: core/NativeId
   type-id: core/NativeId
   terminated: Bool])

(defrecord ArgsResultV0
  [state: BodyStateV0
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)
   terminated: Bool])

(defrecord MapItemsResultV0
  [state: BodyStateV0
   key-ids: (Vec core/NativeId)
   key-types: (Vec core/NativeId)
   value-ids: (Vec core/NativeId)
   value-types: (Vec core/NativeId)
   terminated: Bool])

(defrecord BodyEnvV0
  [index: SourceIndexV0
   types: (Vec core/TypeDef)
   signatures: (Vec TypedFunctionV0)
   signature-sources: (Vec core/NativeId)
   globals: (Vec GlobalBindingV0)])

(defn state-blocked? [state: BodyStateV0] -> Bool
  (> (count (bodystatev0-failure state)) 0))

(defn state-fail
  [state: BodyStateV0
   detail: String] -> BodyStateV0
  (if (state-blocked? state) state (with state [:failure detail])))

(defn dead-result [state: BodyStateV0] -> ExprResultV0
  (->ExprResultV0 state (lower-id "body" ["unreachable"])
    (type-id "LowerFailure") true))

(defn fail-result
  [state: BodyStateV0
   detail: String] -> ExprResultV0
  (dead-result (state-fail state detail)))

(defn state-id
  [state: BodyStateV0
   owner: core/NativeId
   label: String] -> core/NativeId
  (lower-id "body"
    [(id-value owner) label (str (bodystatev0-counter state))]))

(defn state-bump [state: BodyStateV0] -> BodyStateV0
  (with state [:counter (+ 1 (bodystatev0-counter state))]))

(defn state-emit
  [state: BodyStateV0
   instruction: core/Instruction] -> BodyStateV0
  (with state
    [:instructions (conj (bodystatev0-instructions state) instruction)]))

(defn state-close
  [state: BodyStateV0
   terminator: core/Terminator] -> BodyStateV0
  (if (not (bodystatev0-open state))
    state
    (with
      (with state
        [:blocks
         (conj (bodystatev0-blocks state)
           (core/->BasicBlock
             (bodystatev0-block-id state)
             (bodystatev0-block-parameters state)
             (bodystatev0-instructions state)
             [terminator]))])
      [:open false])))

(defn state-open-block
  [state: BodyStateV0
   block-id: core/NativeId
   parameters: (Vec core/Parameter)] -> BodyStateV0
  (with
    (with
      (with (with state [:block-id block-id]) [:block-parameters parameters])
      [:instructions []])
    [:open true]))

(defn retarget-jump
  [block: core/BasicBlock
   from: core/NativeId
   to: core/NativeId] -> core/BasicBlock
  (let [terminators: (Vec core/Terminator) (core/basicblock-terminators block)]
    (if (not (= 1 (count terminators)))
      block
      (let [terminator: core/Terminator (nth terminators 0)]
        (if (and (instance? native.core.JumpTerminator terminator)
              (same-id? (core/jumpterminator-block-id terminator) from))
          (core/->BasicBlock
            (core/basicblock-id block)
            (core/basicblock-parameters block)
            (core/basicblock-instructions block)
            [(core/->JumpTerminator to
               (core/jumpterminator-arguments terminator))])
          block)))))

(defn retarget-jumps-between
  [state: BodyStateV0
   start: Int
   end: Int
   from: core/NativeId
   to: core/NativeId] -> BodyStateV0
  (let [blocks: (Vec core/BasicBlock) (bodystatev0-blocks state)]
    (loop [position: Int 0 collected: (Vec core/BasicBlock) []]
      (if (>= position (count blocks))
        (with state [:blocks collected])
        (recur (+ position 1)
          (conj collected
            (if (and (>= position start) (< position end))
              (retarget-jump (nth blocks position) from to)
              (nth blocks position))))))))

(defn state-bind
  [state: BodyStateV0
   name: String
   value-id: core/NativeId
   type-id: core/NativeId] -> BodyStateV0
  (with state
    [:locals (conj (bodystatev0-locals state)
               (->LocalBindingV0 name value-id type-id))]))

(defn state-push-loop
  [state: BodyStateV0
   frame: LoopFrameV0] -> BodyStateV0
  (with state [:loop-frames (conj (bodystatev0-loop-frames state) frame)]))

(defn current-loop [state: BodyStateV0] -> (U LoopFrameV0 Nil)
  (let [frames: (Vec LoopFrameV0) (bodystatev0-loop-frames state)]
    (if (= 0 (count frames)) nil (nth frames (- (count frames) 1)))))

(defn find-local
  [locals: (Vec LocalBindingV0)
   name: String] -> (U LocalBindingV0 Nil)
  (loop [position: Int (- (count locals) 1)]
    (if (< position 0)
      nil
      (let [binding: LocalBindingV0 (nth locals position)]
        (if (= name (localbindingv0-name binding))
          binding
          (recur (- position 1)))))))

(defn owner-source
  [env: BodyEnvV0
   owner: core/NativeId] -> (U core/NativeId Nil)
  (let [signatures: (Vec TypedFunctionV0) (bodyenvv0-signatures env)
        sources: (Vec core/NativeId) (bodyenvv0-signature-sources env)]
    (loop [position: Int 0]
      (if (or (>= position (count signatures)) (>= position (count sources)))
        nil
        (if (same-id? owner (typedfunctionv0-id (nth signatures position)))
          (nth sources position)
          (recur (+ position 1)))))))

(defn body-owner-module
  [env: BodyEnvV0
   owner: core/NativeId] -> String
  (let [source: (U core/NativeId Nil) (owner-source env owner)]
    (if (nil? source) "" (source-module-name (bodyenvv0-index env) source))))

(defn find-signature
  [env: BodyEnvV0
   owner: core/NativeId
   spelling: String] -> (U TypedFunctionV0 Nil)
  (let [index: SourceIndexV0 (bodyenvv0-index env)
        signatures: (Vec TypedFunctionV0) (bodyenvv0-signatures env)
        sources: (Vec core/NativeId) (bodyenvv0-signature-sources env)
        resolved: ResolvedSourceNameV0
        (resolve-source-name index (body-owner-module env owner) spelling)]
    (if (not (resolvedsourcenamev0-visible resolved))
      nil
      (loop [position: Int 0]
        (if (or (>= position (count signatures)) (>= position (count sources)))
          nil
          (let [signature: TypedFunctionV0 (nth signatures position)
                source: core/NativeId (nth sources position)]
            (if (and
                  (= (resolvedsourcenamev0-local-name resolved)
                    (typedfunctionv0-name signature))
                  (= (resolvedsourcenamev0-module-name resolved)
                    (source-module-name index source)))
              signature
              (recur (+ position 1)))))))))

(defn tail-parameters [parameters: (Vec core/Parameter)] -> (Vec core/Parameter)
  (loop [position: Int 1 collected: (Vec core/Parameter) []]
    (if (>= position (count parameters))
      collected
      (recur (+ position 1) (conj collected (nth parameters position))))))

(defn pure-updater-signature?
  [signature: TypedFunctionV0
   content-type: core/NativeId
   extra-count: Int] -> Bool
  (let [parameters: (Vec core/Parameter)
        (typedfunctionv0-parameters signature)
        effects: (Vec core/NativeId) (typedfunctionv0-effects signature)]
    (and (= (+ extra-count 1) (count parameters))
      (> (count parameters) 0)
      (same-id? content-type
        (core/parameter-type-id (nth parameters 0)))
      (same-id? content-type (typedfunctionv0-return-type signature))
      (= 1 (count effects))
      (same-id? (pure-effect-id) (nth effects 0)))))

;; A Beagle record accessor is spelled <lowercased record name>-<field>; the
;; native world knows records only by their TypeDef, so the spelling is rebuilt.
;; Types already enter by unqualified name, so the accessor drops its alias too.
(defrecord AccessorHitV0
  [found: Bool
   owner-type: core/NativeId
   field-id: core/NativeId
   field-type: core/NativeId])

(defn accessor-miss [] -> AccessorHitV0
  (->AccessorHitV0 false (type-id "LowerFailure") (type-id "LowerFailure")
    (type-id "LowerFailure")))

(defn record-accessor
  [types: (Vec core/TypeDef)
   qualified: String] -> AccessorHitV0
  (let [callee: String (unqualified-name qualified)]
   (loop [position: Int 0]
    (if (>= position (count types))
      (accessor-miss)
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (not (instance? native.core.RecordType shape))
          (recur (+ position 1))
          (let [prefix: String (str (ascii-lower (core/typedef-name definition)) "-")
                fields: (Vec core/TypeField) (core/recordtype-fields shape)
                hit: AccessorHitV0
                (loop [field-position: Int 0]
                  (if (>= field-position (count fields))
                    (accessor-miss)
                    (let [field: core/TypeField (nth fields field-position)]
                      (if (= callee (str prefix (core/typefield-name field)))
                        (->AccessorHitV0 true (core/typedef-id definition)
                          (core/typefield-id field) (core/typefield-type-id field))
                        (recur (+ field-position 1))))))]
            (if (accessorhitv0-found hit) hit (recur (+ position 1))))))))))

(defn record-keyword-field
  [types: (Vec core/TypeDef)
   target: core/NativeId
   keyword: String] -> AccessorHitV0
  (let [target-definition: (U core/TypeDef Nil) (lookup-type types target)
        owner: (U core/NativeId Nil)
        (if (nil? target-definition)
          nil
          (let [shape: core/TypeShape (core/typedef-shape target-definition)]
            (cond
              (instance? native.core.RecordType shape) target
              (instance? native.core.ReferenceType shape)
              (core/referencetype-target-type shape)
              :else nil)))]
    (if (nil? owner)
      (accessor-miss)
      (let [definition: (U core/TypeDef Nil) (lookup-type types owner)]
        (if (nil? definition)
          (accessor-miss)
          (let [shape: core/TypeShape (core/typedef-shape definition)]
            (if (not (instance? native.core.RecordType shape))
              (accessor-miss)
              (loop [position: Int 0
                     fields: (Vec core/TypeField) (core/recordtype-fields shape)]
                (if (>= position (count fields))
                  (accessor-miss)
                  (let [field: core/TypeField (nth fields position)]
                    (if (= keyword (core/typefield-name field))
                      (->AccessorHitV0 true owner (core/typefield-id field)
                        (core/typefield-type-id field))
                      (recur (+ position 1) fields))))))))))))

(defn union-variants-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (Vec core/TypeVariant)
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      []
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.UnionType shape)
          (core/uniontype-variants shape)
          [])))))

(defn variant-named
  [variants: (Vec core/TypeVariant)
   name: String] -> (U core/TypeVariant Nil)
  (loop [position: Int 0]
    (if (>= position (count variants))
      nil
      (let [variant: core/TypeVariant (nth variants position)]
        (if (= name (core/typevariant-name variant))
          variant
          (recur (+ position 1)))))))

(defn compare-op-for [callee: String] -> (U core/CompareOpV0 Nil)
  (cond
    (= "=" callee) (core/->CompareEqI64V0 true)
    (= "<" callee) (core/->CompareLtI64V0 true)
    (= "<=" callee) (core/->CompareLeI64V0 true)
    (= ">" callee) (core/->CompareLtI64V0 true)
    (= ">=" callee) (core/->CompareLeI64V0 true)
    :else nil))

(defn compare-swaps? [callee: String] -> Bool
  (or (= ">" callee) (= ">=" callee)))

(defn bool-type-id [] -> core/NativeId (type-id "Bool"))

(defn int-type-id [] -> core/NativeId (type-id "Int"))

;; v0 traps carry an i64 failure code, not a payload: the closed LowerFailure
;; union names the codes, and the host exception argument is discarded.
(defn trap-failure-code [] -> Int 1)

;; NATIVE_TRAP_OVERFLOW in native-core/shim/native_shim.h.
(defn overflow-failure-code [] -> Int 2)

;; v0 integer arithmetic is checked, never wrapping and never bare: every
;; operation answers an Outcome the caller has to dispatch on.
(defn checked-arith-op? [callee: String] -> Bool
  (or (= "+" callee) (= "-" callee) (= "*" callee)))

;; Division and modulo are absent on purpose: what a zero divisor does (trap,
;; or a third Outcome alternative) is an open design decision, so v0 refuses
;; them by name rather than picking one silently.
(defn refused-arith-op? [callee: String] -> Bool
  (or (= "/" callee) (= "quot" callee) (= "rem" callee) (= "mod" callee)))

(defn checked-arith-operation
  [callee: String
   left: core/NativeId
   right: core/NativeId] -> core/CheckedOperationV0
  (cond
    (= "+" callee) (core/->CheckedAddI64V0 left right)
    (= "-" callee) (core/->CheckedSubI64V0 left right)
    :else (core/->CheckedMulI64V0 left right)))

;; The trap-on-overflow variant is not a second instruction: it is the ordinary
;; dispatch, with the overflow arm closing on a trap and the ok arm reading the
;; value out of the alternative whose tag it has just proved.
(defn lower-checked-arith
  [state: BodyStateV0
   owner: core/NativeId
   callee: String
   left: core/NativeId
   right: core/NativeId] -> ExprResultV0
  (let [result-id: core/NativeId (state-id state owner "arith")
        ok-id: core/NativeId (state-id state owner "arith-ok")
        overflow-id: core/NativeId (state-id state owner "arith-overflow")
        carried: core/NativeId (state-id state owner "arith-outcome")
        value-id: core/NativeId (state-id state owner "arith-value")
        code-id: core/NativeId (state-id state owner "arith-trap")
        outcome-type: core/NativeId (core/checked-i64-type-id)
        switched: BodyStateV0
        (state-close
          (state-emit (state-bump state)
            (core/->CheckedInstruction
              (core/->SsaValueV0 result-id outcome-type)
              (checked-arith-operation callee left right)))
          (core/->SwitchTerminator result-id
            [(core/->SwitchCaseV0 (core/checked-ok-variant-id) ok-id [result-id])
             (core/->SwitchCaseV0 (core/checked-overflow-variant-id)
               overflow-id [])]))
        trapped: BodyStateV0
        (state-close
          (state-emit (state-open-block switched overflow-id [])
            (core/->AtomInstruction
              (core/->SsaValueV0 code-id (int-type-id))
              (core/->I64Atom (overflow-failure-code))))
          (core/->TrapTerminator code-id))]
    (->ExprResultV0
      (state-emit
        (state-open-block trapped ok-id
          [(core/->Parameter carried outcome-type)])
        (core/->VariantValueInstruction
          (core/->SsaValueV0 value-id (int-type-id))
          carried (core/checked-ok-variant-id)))
      value-id (int-type-id) false)))

;; One accumulator's init, lowered: the name it binds, its value and the type
;; that init fixes for the whole loop.
(defrecord LoopInitsV0
  [state: BodyStateV0
   names: (Vec String)
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)
   terminated: Bool])

(defn index-child-nodes
  [index: SourceIndexV0
   subject: core/NativeId] -> (Vec core/NativeId)
  (let [children: (U (Vec core/NativeId) Nil)
        (get (sourceindexv0-child-nodes index) (id-value subject))]
    (if (nil? children) [] children)))

(defn string-member?
  [values: (Vec String)
   target: String] -> Bool
  (some?
    (some (fn [value: String] -> Bool (= value target)) values)))

(defn append-unique-strings
  [values: (Vec String)
   additions: (Vec String)] -> (Vec String)
  (loop [position: Int 0 current: (Vec String) values]
    (if (>= position (count additions))
      current
      (let [addition: String (nth additions position)]
        (recur (+ position 1)
          (if (string-member? current addition)
            current
            (conj current addition)))))))

(defn source-free-ref-names
  [index: SourceIndexV0
   node: core/NativeId
   bound: (Vec String)
   fuel: Int] -> (Vec String)
  (if (<= fuel 0)
    []
    (let [kind: String (fact-text index node "form-kind")]
      (cond
        (= "ref" kind)
        (let [name: String (fact-text index node "name")]
          (if (or (= "" name) (= "else" name) (string-member? bound name)) [] [name]))

        (or (= "let" kind) (= "loop" kind))
        (let [bindings-node: (U core/NativeId Nil)
              (index-first-object index node "bindings")
              items: (Vec core/NativeId)
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              binding-refs: (Vec String)
              (loop [position: Int 0
                     current-bound: (Vec String) bound
                     names: (Vec String) []]
                (if (>= position (count items))
                  names
                  (let [binding: core/NativeId (nth items position)
                        value: (U core/NativeId Nil)
                        (index-first-object index binding "value")
                        found: (Vec String)
                        (if (nil? value)
                          []
                          (source-free-ref-names index value current-bound
                            (- fuel 1)))
                        name: String (fact-text index binding "name")]
                    (recur (+ position 1)
                      (if (= "" name) current-bound (conj current-bound name))
                      (append-unique-strings names found)))))
              body-bound: (Vec String)
              (loop [position: Int 0 current: (Vec String) bound]
                (if (>= position (count items))
                  current
                  (let [name: String (fact-text index (nth items position) "name")]
                    (recur (+ position 1)
                      (if (= "" name) current (conj current name))))))
              body: (U core/NativeId Nil) (index-first-object index node "body")]
          (if (nil? body)
            binding-refs
            (append-unique-strings binding-refs
              (source-free-ref-names index body body-bound (- fuel 1)))))

        :else
        (let [children: (Vec core/NativeId) (index-child-nodes index node)]
          (loop [position: Int 0 names: (Vec String) []]
            (if (>= position (count children))
              names
              (recur (+ position 1)
                (append-unique-strings names
                  (source-free-ref-names index (nth children position) bound
                    (- fuel 1)))))))))))

(defn source-ref-keys
  [index: SourceIndexV0
   module-name: String
   node: core/NativeId
   bound: (Vec String)
   fuel: Int] -> (Vec String)
  (let [names: (Vec String) (source-free-ref-names index node bound fuel)]
    (loop [position: Int 0 keys: (Vec String) []]
      (if (>= position (count names))
        keys
        (let [key: String
              (resolved-source-key
                (resolve-source-name index module-name (nth names position)))]
          (recur (+ position 1)
            (if (or (= "" key) (string-member? keys key)) keys (conj keys key))))))))

(defn close-global-keys
  [index: SourceIndexV0
   globals: (Vec GlobalBindingV0)
   seeds: (Vec String)] -> (Vec String)
  (loop [round: Int 0 keys: (Vec String) seeds]
    (if (>= round (count globals))
      keys
      (let [expanded: (Vec String)
            (loop [position: Int 0 current: (Vec String) keys]
              (if (>= position (count globals))
                current
                (let [global: GlobalBindingV0 (nth globals position)]
                  (recur (+ position 1)
                    (if (string-member? current (global-key global))
                      (append-unique-strings current
                        (source-ref-keys index (globalbindingv0-module-name global)
                          (globalbindingv0-value global) []
                          (+ 1 (index-facts index))))
                      current)))))]
        (if (= (count expanded) (count keys))
          keys
          (recur (+ round 1) expanded))))))

(defn needed-globals
  [env: BodyEnvV0
   owner: core/NativeId
   body: core/NativeId
   bound: (Vec String)] -> (Vec GlobalBindingV0)
  (let [index: SourceIndexV0 (bodyenvv0-index env)
        globals: (Vec GlobalBindingV0) (bodyenvv0-globals env)
        keys: (Vec String)
        (close-global-keys index globals
          (source-ref-keys index (body-owner-module env owner) body bound
            (+ 1 (index-facts index))))]
    (loop [position: Int 0 selected: (Vec GlobalBindingV0) []]
      (if (>= position (count globals))
        selected
        (let [global: GlobalBindingV0 (nth globals position)]
          (recur (+ position 1)
            (if (string-member? keys (global-key global))
              (conj selected global)
              selected)))))))

;; A nested loop's body belongs to its own header (its init forms do not), and
;; an unknown form kind is walked as non-tail so a `recur` reachable through
;; another arm's form is refused rather than mislowered.
(defn recur-tail-only?
  [index: SourceIndexV0
   node: core/NativeId
   tail: Bool
   fuel: Int] -> Bool
  (if (<= fuel 0)
    false
    (let [kind: String (fact-text index node "form-kind")]
      (cond
        (= "recur" kind)
        (let [args-node: (U core/NativeId Nil) (index-first-object index node "args")
              args: (Vec core/NativeId)
              (if (nil? args-node) [] (index-sequence-items index args-node))]
          (and tail
            (loop [position: Int 0]
              (if (>= position (count args))
                true
                (if (recur-tail-only? index (nth args position) false (- fuel 1))
                  (recur (+ position 1))
                  false)))))

        (= "loop" kind)
        (let [bindings-node: (U core/NativeId Nil)
              (index-first-object index node "bindings")
              items: (Vec core/NativeId)
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))]
          (loop [position: Int 0]
            (if (>= position (count items))
              true
              (let [value-node: (U core/NativeId Nil)
                    (index-first-object index (nth items position) "value")]
                (if (or (nil? value-node)
                        (recur-tail-only? index value-node false (- fuel 1)))
                  (recur (+ position 1))
                  false)))))

        (= "if" kind)
        (let [condition-node: (U core/NativeId Nil)
              (index-first-object index node "cond")
              then-node: (U core/NativeId Nil) (index-first-object index node "then")
              else-node: (U core/NativeId Nil) (index-first-object index node "else")]
          (and
            (or (nil? condition-node)
                (recur-tail-only? index condition-node false (- fuel 1)))
            (or (nil? then-node)
                (recur-tail-only? index then-node tail (- fuel 1)))
            (or (nil? else-node)
                (recur-tail-only? index else-node tail (- fuel 1)))))

        (= "let" kind)
        (let [bindings-node: (U core/NativeId Nil)
              (index-first-object index node "bindings")
              items: (Vec core/NativeId)
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              body-node: (U core/NativeId Nil) (index-first-object index node "body")]
          (and
            (loop [position: Int 0]
              (if (>= position (count items))
                true
                (let [value-node: (U core/NativeId Nil)
                      (index-first-object index (nth items position) "value")]
                  (if (or (nil? value-node)
                          (recur-tail-only? index value-node false (- fuel 1)))
                    (recur (+ position 1))
                    false))))
            (or (nil? body-node)
                (recur-tail-only? index body-node tail (- fuel 1)))))

        :else
        (let [children: (Vec core/NativeId) (index-child-nodes index node)]
          (loop [position: Int 0]
            (if (>= position (count children))
              true
              (if (recur-tail-only? index (nth children position) false (- fuel 1))
                (recur (+ position 1))
                false))))))))

(defn recur-type-mismatch
  [parameters: (Vec core/Parameter)
   value-types: (Vec core/NativeId)] -> Int
  (loop [position: Int 0]
    (cond
      (>= position (count parameters)) -1
      (same-id? (core/parameter-type-id (nth parameters position))
        (nth value-types position))
      (recur (+ position 1))
      :else position)))

(defn header-parameter?
  [parameters: (Vec core/Parameter)
   value: core/NativeId] -> Bool
  (loop [position: Int 0]
    (if (>= position (count parameters))
      false
      (if (same-id? (core/parameter-id (nth parameters position)) value)
        true
        (recur (+ position 1))))))

;; A back edge whose arguments are materialized as sequential copies into the
;; header parameters corrupts any argument that IS a header parameter, so the
;; recur arm routes every argument through a fresh value when one aliases.
(defn recur-aliases-header?
  [parameters: (Vec core/Parameter)
   values: (Vec core/NativeId)] -> Bool
  (loop [position: Int 0]
    (if (>= position (count values))
      false
      (if (header-parameter? parameters (nth values position))
        true
        (recur (+ position 1))))))

;; Coercion rule (ratified, North thread 019fbd6c): widen = free tag inject,
;; narrow = checked extract trapping to LowerFailure/union-variant-mismatch.
;; SliceValue is confined to one sealed world, never a cross-world ABI type.
(defn variant-for-payload
  [variants: (Vec core/TypeVariant)
   payload: core/NativeId] -> (U core/TypeVariant Nil)
  (loop [position: Int 0]
    (if (>= position (count variants))
      nil
      (let [variant: core/TypeVariant (nth variants position)
            declared: (U core/NativeId Nil) (core/typevariant-payload-type variant)]
          (if (nil? declared)
            (recur (+ position 1))
            (if (same-id? declared payload) variant (recur (+ position 1))))))))

(defn variant-for-record-reference
  [types: (Vec core/TypeDef)
   variants: (Vec core/TypeVariant)
   record-type: core/NativeId] -> (U core/TypeVariant Nil)
  (loop [position: Int 0]
    (if (>= position (count variants))
      nil
      (let [variant: core/TypeVariant (nth variants position)
            payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)
            definition: (U core/TypeDef Nil)
            (if (nil? payload) nil (lookup-type types payload))]
        (if (nil? definition)
          (recur (+ position 1))
          (let [shape: core/TypeShape (core/typedef-shape definition)]
            (if (and (instance? native.core.ReferenceType shape)
                  (same-id? (core/referencetype-target-type shape) record-type))
              variant
              (recur (+ position 1)))))))))

(defn payloadless-variants [variants: (Vec core/TypeVariant)] -> (Vec core/TypeVariant)
  (loop [position: Int 0 collected: (Vec core/TypeVariant) []]
    (if (>= position (count variants))
      collected
      (let [variant: core/TypeVariant (nth variants position)]
        (recur (+ position 1)
          (if (nil? (core/typevariant-payload-type variant))
            (conj collected variant)
            collected))))))

;; A recursive union must be refused, not looped over.
(defn widen-budget [] -> Int 4)

(defn arena-value-id [owner: core/NativeId] -> core/NativeId
  (lower-id "arena-handle" [(id-value owner)]))

(defn atom-state-value-id [owner: core/NativeId] -> core/NativeId
  (lower-id "atom-state-handle" [(id-value owner)]))

;; The absent alternative carries nothing to extract, so this arm injects the
;; target's own unit variant and never reads the source payload.
(defn widen-unit-arm
  [state: BodyStateV0
   owner: core/NativeId
   label: String
   variant-name: String
   to: core/NativeId
   unit-variants: (Vec core/TypeVariant)
   join-id: core/NativeId] -> BodyStateV0
  (if (not (= 1 (count unit-variants)))
    (state-fail state
      (str "TODO-NATIVE-WIDEN-UNIT: " variant-name
        " carries no value and the target has no unit alternative"))
    (let [unit-id: core/NativeId (state-id state owner label)]
      (state-close
        (state-emit (state-bump state)
          (core/->UnionConstructInstruction
            (core/->SsaValueV0 unit-id to)
            (core/typevariant-id (nth unit-variants 0))
            nil))
        (core/->JumpTerminator join-id [unit-id])))))

(defn lower-widen
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   value-id: core/NativeId
   from: core/NativeId
   to: core/NativeId
   budget: Int] -> ExprResultV0
  (cond
    (state-blocked? state) (dead-result state)

    (same-id? from to) (->ExprResultV0 state value-id to false)

    (< budget 0)
    (fail-result state
      "TODO-NATIVE-WIDEN-DEPTH: closed-union coercion nested past the v0 budget")

    :else
    (let [target-variants: (Vec core/TypeVariant) (union-variants-of types to)
          direct: (U core/TypeVariant Nil)
          (variant-for-payload target-variants from)
          boxed: (U core/TypeVariant Nil)
          (variant-for-record-reference types target-variants from)
          unit-variants: (Vec core/TypeVariant)
          (payloadless-variants target-variants)
          source-variants: (Vec core/TypeVariant) (union-variants-of types from)]
      (cond
        (= 0 (count target-variants))
        (fail-result state
          "TODO-NATIVE-WIDEN-TARGET: the declared type is not a closed union")

        (some? direct)
        (let [result-id: core/NativeId (state-id state owner "inject")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionConstructInstruction
                (core/->SsaValueV0 result-id to)
                (core/typevariant-id direct)
                value-id))
            result-id to false))

        (some? boxed)
        (let [reference-type: (U core/NativeId Nil)
              (core/typevariant-payload-type boxed)]
          (if (nil? reference-type)
            (fail-result state
              "TODO-NATIVE-BOX-RECORD: reference-backed variant has no payload")
            (let [reference-id: core/NativeId (state-id state owner "box-record")
                  result-id: core/NativeId
                  (state-id (state-bump state) owner "inject-record")]
              (->ExprResultV0
                (state-emit
                  (state-emit (state-bump (state-bump state))
                    (core/->BoxRecordInstruction
                      (core/->SsaValueV0 reference-id reference-type)
                      value-id (arena-value-id owner)))
                  (core/->UnionConstructInstruction
                    (core/->SsaValueV0 result-id to)
                    (core/typevariant-id boxed)
                    reference-id))
                result-id to false))))

        ;; Nil is the absence of a value, so it widens to the target's own
        ;; payload-less alternative rather than to a variant carrying Unit.
        (and (same-id? from (type-id "Nil")) (= 1 (count unit-variants)))
        (let [result-id: core/NativeId (state-id state owner "inject-unit")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionConstructInstruction
                (core/->SsaValueV0 result-id to)
                (core/typevariant-id (nth unit-variants 0))
                nil))
            result-id to false))

        (= 0 (count source-variants))
        (fail-result state
          "TODO-NATIVE-WIDEN-SOURCE: no target alternative carries this type and the source is not a closed union")

        :else
        (let [join-id: core/NativeId (state-id state owner "widen-join")
              join-parameter: core/NativeId (state-id state owner "widen-value")
              cases: (Vec core/SwitchCaseV0)
              (loop [position: Int 0 collected: (Vec core/SwitchCaseV0) []]
                (if (>= position (count source-variants))
                  collected
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id (nth source-variants position))
                        (state-id state owner (str "widen-arm-" position))
                        [])))))
              switched: BodyStateV0
              (state-close (state-bump state)
                (core/->SwitchTerminator value-id cases))
              armed: BodyStateV0
              (loop [position: Int 0 current: BodyStateV0 switched]
                (if (or (>= position (count source-variants))
                        (state-blocked? current))
                  current
                  (let [variant: core/TypeVariant (nth source-variants position)
                        arm-id: core/NativeId
                        (state-id state owner (str "widen-arm-" position))
                        payload-type: (U core/NativeId Nil)
                        (core/typevariant-payload-type variant)
                        opened: BodyStateV0 (state-open-block current arm-id [])]
                    (if (nil? payload-type)
                      (recur (+ position 1)
                        (widen-unit-arm opened owner
                          (str "widen-unit-" position)
                          (core/typevariant-name variant)
                          to unit-variants join-id))
                      (if (same-id? payload-type (type-id "Nil"))
                        (recur (+ position 1)
                          (widen-unit-arm opened owner
                            (str "widen-unit-" position)
                            (core/typevariant-name variant)
                            to unit-variants join-id))
                        (let [extract-id: core/NativeId
                              (state-id opened owner (str "widen-extract-" position))
                              extracted: BodyStateV0
                              (state-emit (state-bump opened)
                                (core/->UnionExtractInstruction
                                  (core/->SsaValueV0 extract-id payload-type)
                                  value-id
                                  (core/typevariant-id variant)))
                              widened: ExprResultV0
                              (lower-widen types owner extracted extract-id
                                payload-type to (- budget 1))]
                          (if (state-blocked? (exprresultv0-state widened))
                            (exprresultv0-state widened)
                            (recur (+ position 1)
                              (state-close (exprresultv0-state widened)
                                (core/->JumpTerminator join-id
                                  [(exprresultv0-value-id widened)]))))))))))]
          (if (state-blocked? armed)
            (dead-result armed)
            (->ExprResultV0
              (state-open-block armed join-id
                [(core/->Parameter join-parameter to)])
              join-parameter to false)))))))

;; A narrowed reference borrows from the union value it came out of; it must not
;; outlive that value's region. Vacuous while every payload is world-confined.
(defrecord NarrowHitV0
  [found: Bool
   variant-id: core/NativeId
   reference-type: core/NativeId])

(defn narrow-miss [] -> NarrowHitV0
  (->NarrowHitV0 false (type-id "LowerFailure") (type-id "LowerFailure")))

(defn reference-variant-for
  [types: (Vec core/TypeDef)
   union-id: core/NativeId
   target: core/NativeId] -> NarrowHitV0
  (let [variants: (Vec core/TypeVariant) (union-variants-of types union-id)]
    (loop [position: Int 0]
      (if (>= position (count variants))
        (narrow-miss)
        (let [variant: core/TypeVariant (nth variants position)
              payload: (U core/NativeId Nil)
              (core/typevariant-payload-type variant)]
          (if (nil? payload)
            (recur (+ position 1))
            (let [definition: (U core/TypeDef Nil) (lookup-type types payload)]
              (if (nil? definition)
                (recur (+ position 1))
                (let [shape: core/TypeShape (core/typedef-shape definition)]
                  (if (and (instance? native.core.ReferenceType shape)
                        (same-id? (core/referencetype-target-type shape) target))
                    (->NarrowHitV0 true (core/typevariant-id variant) payload)
                    (recur (+ position 1))))))))))))

(defn reference-targets?
  [types: (Vec core/TypeDef)
   reference: core/NativeId
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types reference)]
    (if (nil? definition)
      false
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (and (instance? native.core.ReferenceType shape)
          (same-id? (core/referencetype-target-type shape) target))))))

;; Source annotations and calls are semantic boundaries: widen into their
;; declared union, or checked-extract the one alternative the boundary names.
(defn lower-boundary-coerce
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   value-id: core/NativeId
   from: core/NativeId
   to: core/NativeId] -> ExprResultV0
  (if (same-id? from to)
    (->ExprResultV0 state value-id to false)
    (let [source-variants: (Vec core/TypeVariant) (union-variants-of types from)
          scalar: (U core/TypeVariant Nil) (variant-for-payload source-variants to)
          record: NarrowHitV0 (reference-variant-for types from to)]
      (cond
        (some? scalar)
        (let [result-id: core/NativeId (state-id state owner "boundary-extract")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionExtractInstruction
                (core/->SsaValueV0 result-id to)
                value-id (core/typevariant-id scalar)))
            result-id to false))

        (narrowhitv0-found record)
        (let [result-id: core/NativeId (state-id state owner "boundary-reference")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionExtractInstruction
                (core/->SsaValueV0 result-id
                  (narrowhitv0-reference-type record))
                value-id (narrowhitv0-variant-id record)))
            result-id (narrowhitv0-reference-type record) false))

        :else
        (lower-widen types owner state value-id from to (widen-budget))))))

(defn coerce-arguments
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)
   parameters: (Vec core/Parameter)] -> ArgsResultV0
  (loop [position: Int 0
         current: BodyStateV0 state
         coerced-values: (Vec core/NativeId) []
         coerced-types: (Vec core/NativeId) []]
    (if (or (>= position (count values)) (state-blocked? current))
      (->ArgsResultV0 current coerced-values coerced-types false)
      (let [coerced: ExprResultV0
            (lower-boundary-coerce types owner current
              (nth values position)
              (nth value-types position)
              (core/parameter-type-id (nth parameters position)))]
        (recur (+ position 1)
          (exprresultv0-state coerced)
          (conj coerced-values (exprresultv0-value-id coerced))
          (conj coerced-types (exprresultv0-type-id coerced)))))))

(defn coerce-values-to-type
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)
   target: core/NativeId] -> ArgsResultV0
  (loop [position: Int 0
         current: BodyStateV0 state
         coerced-values: (Vec core/NativeId) []
         coerced-types: (Vec core/NativeId) []]
    (if (or (>= position (count values)) (state-blocked? current))
      (->ArgsResultV0 current coerced-values coerced-types false)
      (let [coerced: ExprResultV0
            (lower-boundary-coerce types owner current
              (nth values position) (nth value-types position) target)]
        (recur (+ position 1)
          (exprresultv0-state coerced)
          (conj coerced-values (exprresultv0-value-id coerced))
          (conj coerced-types (exprresultv0-type-id coerced)))))))

(defn vector-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.VectorType (core/typedef-shape definition)))))

(defn vector-element-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> core/NativeId
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.VectorType shape)
          (core/vectortype-element-type shape)
          (type-id "LowerFailure"))))))

(defn map-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.MapTypeV0 (core/typedef-shape definition)))))

(defn map-key-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> core/NativeId
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.MapTypeV0 shape)
          (core/maptypev0-key-type shape)
          (type-id "LowerFailure"))))))

(defn map-value-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> core/NativeId
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.MapTypeV0 shape)
          (core/maptypev0-value-type shape)
          (type-id "LowerFailure"))))))

(defn set-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.SetTypeV0 (core/typedef-shape definition)))))

(defn set-element-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> core/NativeId
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.SetTypeV0 shape)
          (core/settypev0-element-type shape)
          (type-id "LowerFailure"))))))

(defn value-semantics-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      false
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (or (instance? native.core.RecordType shape)
            (or (instance? native.core.UnionType shape)
                (instance? native.core.VectorType shape)))))))

(defn nil-value-variant?
  [definition: core/TypeDef
   variant: core/TypeVariant] -> Bool
  (and (nil? (core/typevariant-payload-type variant))
    (or (= "nil" (core/typevariant-name variant))
      (and (= "Unit" (core/typedef-name definition))
        (= "unit" (core/typevariant-name variant))))))

(defn value-to-text-type-inner?
  [types: (Vec core/TypeDef)
   target: core/NativeId
   visiting: (Vec core/NativeId)] -> Bool
  (if (core/id-in? visiting target)
    false
    (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [shape: core/TypeShape (core/typedef-shape definition)
              next: (Vec core/NativeId) (conj visiting target)]
          (cond
            (instance? native.core.AtomType shape)
            (let [kind: core/AtomKind (core/atomtype-kind shape)]
              (or (instance? native.core.BoolKind kind)
                (instance? native.core.I64Kind kind)
                (instance? native.core.F64Kind kind)
                (instance? native.core.TextKind kind)
                (instance? native.core.KeywordKind kind)))

            (instance? native.core.VectorType shape)
            (value-to-text-type-inner? types
              (core/vectortype-element-type shape) next)

            (instance? native.core.MapTypeV0 shape)
            (and
              (instance? native.core.InsertionOrderV0
                (core/maptypev0-iteration-order shape))
              (value-to-text-type-inner? types
                (core/maptypev0-key-type shape) next)
              (value-to-text-type-inner? types
                (core/maptypev0-value-type shape) next))

            (instance? native.core.UnionType shape)
            (let [variants: (Vec core/TypeVariant)
                  (core/uniontype-variants shape)]
              (and (> (count variants) 0)
                (every?
                  (fn [variant: core/TypeVariant] -> Bool
                    (let [payload: (U core/NativeId Nil)
                          (core/typevariant-payload-type variant)]
                      (if (nil? payload)
                        (nil-value-variant? definition variant)
                        (value-to-text-type-inner? types payload next))))
                  variants)))

            :else false))))))

(defn value-to-text-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (value-to-text-type-inner? types target []))

;; The vector TypeDef for an element type exists only when some annotation in
;; the module named (Vec T); a literal cannot mint one, so it looks one up.
(defn vector-type-of
  [types: (Vec core/TypeDef)
   element: core/NativeId] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.VectorType shape)
              (= "Vector" (core/typedef-name definition))
              (same-id? (core/vectortype-element-type shape) element))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn text-vector-type-of [types: (Vec core/TypeDef)] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.VectorType shape)
              (= "Vector" (core/typedef-name definition))
              (same-id? (core/vectortype-element-type shape)
                (type-id "String")))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn map-value?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (some? definition)
      (= "MapEntries" (core/typedef-name definition)))))

(defn text-builtin-allocates? [operation: core/TextBuiltinOpV0] -> Bool
  (not (or (instance? native.core.TextCompareV0 operation)
           (instance? native.core.TextRegexMatchesV0 operation))))

(defn map-type-of
  [types: (Vec core/TypeDef)
   key-type: core/NativeId
   value-type: core/NativeId] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.MapTypeV0 shape)
              (same-id? (core/maptypev0-key-type shape) key-type)
              (same-id? (core/maptypev0-value-type shape) value-type))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn set-type-of
  [types: (Vec core/TypeDef)
   element-type: core/NativeId] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.SetTypeV0 shape)
              (same-id? (core/settypev0-element-type shape) element-type))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn concrete-equality-for [target: core/NativeId] -> (U core/ConcreteEqualityV0 Nil)
  (cond
    (same-id? target (type-id "Bool")) (core/->BoolEqualityV0 true)
    (same-id? target (type-id "Int")) (core/->I64EqualityV0 true)
    (same-id? target (type-id "Float")) (core/->F64EqualityV0 true)
    (same-id? target (type-id "String")) (core/->TextEqualityV0 true)
    (same-id? target (type-id "Keyword")) (core/->KeywordEqualityV0 true)
    :else nil))

(defn atom-cell-content-of
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (U core/NativeId Nil)
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      nil
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.AtomCellTypeV0 shape)
          (core/atomcelltypev0-content-type shape)
          nil)))))

(defn atom-cell-type-of
  [types: (Vec core/TypeDef)
   content: core/NativeId] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.AtomCellTypeV0 shape)
              (same-id? (core/atomcelltypev0-content-type shape) content))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn allocating-instruction? [instruction: core/Instruction] -> Bool
  (or (instance? native.core.VecPushInstruction instruction)
      (instance? native.core.VecEmptyInstruction instruction)
      (instance? native.core.VecConcatInstruction instruction)
      (instance? native.core.MapLiteralInstructionV0 instruction)
      (instance? native.core.SetLiteralInstructionV0 instruction)
      (instance? native.core.MapAssocInstructionV0 instruction)
      (instance? native.core.MapDissocInstructionV0 instruction)
      (instance? native.core.MapKeysInstructionV0 instruction)
      (instance? native.core.MapValuesInstructionV0 instruction)
      (instance? native.core.SetConjInstructionV0 instruction)
      (instance? native.core.SetDisjInstructionV0 instruction)
      (instance? native.core.SetVectorInstructionV0 instruction)
      (instance? native.core.BoxRecordInstruction instruction)
      (instance? native.core.AllocateInstruction instruction)
      (instance? native.core.AtomCreateInstruction instruction)
      (instance? native.core.TextSliceInstruction instruction)
      (instance? native.core.TextConcatInstruction instruction)
      (instance? native.core.ValueToTextInstructionV0 instruction)
      (and (instance? native.core.ExternCallInstruction instruction)
        (some? (core/externcallinstruction-arena-id instruction)))
      (and (instance? native.core.TextBuiltinInstruction instruction)
        (text-builtin-allocates?
          (core/textbuiltininstruction-builtin instruction)))))

(defn atom-state-instruction? [instruction: core/Instruction] -> Bool
  (or (instance? native.core.AtomCreateInstruction instruction)
      (instance? native.core.AtomDerefInstruction instruction)
      (instance? native.core.AtomSwapInstruction instruction)))

(defn blocks-use-atom-state? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some? (some atom-state-instruction?
                 (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-environment? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some?
          (some
            (fn [instruction: core/Instruction] -> Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  (host-environment-abi-id))))
            (core/basicblock-instructions block))))
      blocks)))

(defn instructions-allocate? [instructions: (Vec core/Instruction)] -> Bool
  (some?
    (some (fn [instruction: core/Instruction] -> Bool
            (allocating-instruction? instruction))
      instructions)))

(defn blocks-allocate? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some (fn [block: core/BasicBlock] -> Bool
            (instructions-allocate? (core/basicblock-instructions block)))
      blocks)))

(defn empty-vector-form?
  [index: SourceIndexV0
   node: core/NativeId] -> Bool
  (if (not (= "vec" (fact-text index node "form-kind")))
    false
    (let [items-node: (U core/NativeId Nil) (index-first-object index node "items")]
      (if (nil? items-node)
        true
        (= 0 (count (index-sequence-items index items-node)))))))

(defn source-ref-named?
  [index: SourceIndexV0
   node: core/NativeId
   expected: String] -> Bool
  (and (= "ref" (fact-text index node "form-kind"))
    (= expected (fact-text index node "name"))))

(defn source-call-named?
  [index: SourceIndexV0
   node: core/NativeId
   expected: String] -> Bool
  (and (= "call" (fact-text index node "form-kind"))
    (= expected (fact-text index node "callee"))))

(defn source-call-arguments
  [index: SourceIndexV0
   node: core/NativeId] -> (Vec core/NativeId)
  (let [args: (U core/NativeId Nil) (index-first-object index node "args")]
    (if (nil? args) [] (index-sequence-items index args))))

(defn text-vector-value?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (and (vector-type? types target)
    (same-id? (vector-element-of types target) (type-id "String"))))

(defn empty-map-form?
  [index: SourceIndexV0
   node: core/NativeId] -> Bool
  (if (not (= "map" (fact-text index node "form-kind")))
    false
    (let [pairs-node: (U core/NativeId Nil) (index-first-object index node "pairs")]
      (if (nil? pairs-node)
        true
        (= 0 (count (index-sequence-items index pairs-node)))))))

(defn empty-set-form?
  [index: SourceIndexV0
   node: core/NativeId] -> Bool
  (if (not (= "set" (fact-text index node "form-kind")))
    false
    (let [items-node: (U core/NativeId Nil) (index-first-object index node "items")]
      (if (nil? items-node)
        true
        (= 0 (count (index-sequence-items index items-node)))))))

;; An empty literal names no element type, so the only closed source for one is
;; the annotation on the binding it initializes.
(defn lower-empty-vector
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   annotation: (U core/NativeId Nil)] -> ExprResultV0
  (if (nil? annotation)
    (fail-result state
      "TODO-NATIVE-EMPTY-VECTOR-LITERAL: an empty literal names no element type")
    (let [index: SourceIndexV0 (bodyenvv0-index env)
          types: (Vec core/TypeDef) (bodyenvv0-types env)
          resolved: core/NativeId
          (typeresolutionv0-type-id (resolve-source-type index annotation))]
      (if (not (vector-type? types resolved))
        (fail-result state
          "TODO-NATIVE-EMPTY-VECTOR-LITERAL: the binding annotation is not a native vector type")
        (let [capacity-id: core/NativeId (state-id state owner "vec-cap")
              result-id: core/NativeId (state-id (state-bump state) owner "vec-lit")]
          (->ExprResultV0
            (state-emit
              (state-emit (state-bump (state-bump state))
                (core/->AtomInstruction
                  (core/->SsaValueV0 capacity-id (int-type-id))
                  (core/->I64Atom 0)))
              (core/->VecEmptyInstruction
                (core/->SsaValueV0 result-id resolved)
                capacity-id (arena-value-id owner)))
            result-id resolved false))))))

(defn lower-empty-map
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   annotation: (U core/NativeId Nil)] -> ExprResultV0
  (if (nil? annotation)
    (fail-result state
      "TODO-NATIVE-EMPTY-MAP-LITERAL: an empty literal names no key or value type")
    (let [index: SourceIndexV0 (bodyenvv0-index env)
          types: (Vec core/TypeDef) (bodyenvv0-types env)
          resolved: core/NativeId
          (typeresolutionv0-type-id (resolve-source-type index annotation))]
      (if (not (map-type? types resolved))
        (fail-result state
          "TODO-NATIVE-EMPTY-MAP-LITERAL: the binding annotation is not a native map type")
        (let [equality: (U core/ConcreteEqualityV0 Nil)
              (concrete-equality-for (map-key-of types resolved))]
          (if (nil? equality)
            (fail-result state
              "TODO-NATIVE-MAP-KEY-EQUALITY: the key type has no closed concrete equality")
            (let [result-id: core/NativeId (state-id state owner "map-lit")]
              (->ExprResultV0
                (state-emit (state-bump state)
                  (core/->MapLiteralInstructionV0
                    (core/->SsaValueV0 result-id resolved)
                    [] [] (arena-value-id owner) equality))
                result-id resolved false))))))))

(defn lower-empty-set
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   annotation: (U core/NativeId Nil)] -> ExprResultV0
  (if (nil? annotation)
    (fail-result state
      "TODO-NATIVE-EMPTY-SET-LITERAL: an empty literal names no element type")
    (let [index: SourceIndexV0 (bodyenvv0-index env)
          types: (Vec core/TypeDef) (bodyenvv0-types env)
          resolved: core/NativeId
          (typeresolutionv0-type-id (resolve-source-type index annotation))]
      (if (not (set-type? types resolved))
        (fail-result state
          "TODO-NATIVE-EMPTY-SET-LITERAL: the binding annotation is not a native set type")
        (let [equality: (U core/ConcreteEqualityV0 Nil)
              (concrete-equality-for (set-element-of types resolved))]
          (if (nil? equality)
            (fail-result state
              "TODO-NATIVE-SET-ELEMENT-EQUALITY: the element type has no closed concrete equality")
            (let [result-id: core/NativeId (state-id state owner "set-lit")]
              (->ExprResultV0
                (state-emit (state-bump state)
                  (core/->SetLiteralInstructionV0
                    (core/->SsaValueV0 result-id resolved)
                    [] (arena-value-id owner) equality))
                result-id resolved false))))))))

;; Some collection calls close an empty literal from the receiver type (for
;; example `(get m k [])`). This is still type-directed lowering: the call's
;; concrete Map/Set/Vec signature supplies the otherwise absent literal type.
(defn lower-contextual-empty-aggregate
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   node: core/NativeId
   expected: core/NativeId] -> ExprResultV0
  (let [index: SourceIndexV0 (bodyenvv0-index env)
        types: (Vec core/TypeDef) (bodyenvv0-types env)]
    (cond
      (and (empty-vector-form? index node) (vector-type? types expected))
      (let [capacity-id: core/NativeId (state-id state owner "vec-cap")
            result-id: core/NativeId (state-id (state-bump state) owner "vec-lit")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump state))
              (core/->AtomInstruction
                (core/->SsaValueV0 capacity-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->VecEmptyInstruction
              (core/->SsaValueV0 result-id expected)
              capacity-id (arena-value-id owner)))
          result-id expected false))

      (and (empty-map-form? index node) (map-type? types expected))
      (let [equality: (U core/ConcreteEqualityV0 Nil)
            (concrete-equality-for (map-key-of types expected))]
        (if (nil? equality)
          (fail-result state
            "TODO-NATIVE-MAP-KEY-EQUALITY: the contextual key type has no closed concrete equality")
          (let [result-id: core/NativeId (state-id state owner "map-lit")]
            (->ExprResultV0
              (state-emit (state-bump state)
                (core/->MapLiteralInstructionV0
                  (core/->SsaValueV0 result-id expected)
                  [] [] (arena-value-id owner) equality))
              result-id expected false))))

      (and (empty-set-form? index node) (set-type? types expected))
      (let [equality: (U core/ConcreteEqualityV0 Nil)
            (concrete-equality-for (set-element-of types expected))]
        (if (nil? equality)
          (fail-result state
            "TODO-NATIVE-SET-ELEMENT-EQUALITY: the contextual element type has no closed concrete equality")
          (let [result-id: core/NativeId (state-id state owner "set-lit")]
            (->ExprResultV0
              (state-emit (state-bump state)
                (core/->SetLiteralInstructionV0
                  (core/->SsaValueV0 result-id expected)
                  [] (arena-value-id owner) equality))
              result-id expected false))))

      :else
      (fail-result state
        "TODO-NATIVE-CONTEXTUAL-EMPTY-LITERAL: the receiver type does not close this literal"))))

(defn expected-collection-argument-type
  [types: (Vec core/TypeDef)
   callee: String
   position: Int
   prior-types: (Vec core/NativeId)] -> (U core/NativeId Nil)
  (if (= 0 (count prior-types))
    nil
    (let [receiver: core/NativeId (nth prior-types 0)]
      (cond
        (and (= position 1) (map-type? types receiver)
          (or (= "get" callee) (= "assoc" callee) (= "dissoc" callee)
            (= "contains?" callee)))
        (map-key-of types receiver)

        (and (= position 2) (map-type? types receiver)
          (or (= "get" callee) (= "assoc" callee)))
        (map-value-of types receiver)

        (and (= position 1) (set-type? types receiver)
          (or (= "contains?" callee) (= "conj" callee) (= "disj" callee)))
        (set-element-of types receiver)

        (and (= position 1) (vector-type? types receiver) (= "conj" callee))
        (vector-element-of types receiver)

        :else nil))))

(defn text-type-id [] -> core/NativeId (type-id "String"))

(defn keyword-type-id [] -> core/NativeId (type-id "Keyword"))

(defn exact-closed-type?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (some? definition)
      (not (instance? native.core.UnionType (core/typedef-shape definition))))))

(defn static-type-predicate? [callee: String] -> Bool
  (or (= "sequential?" callee)
    (= "map?" callee)
    (= "set?" callee)
    (= "string?" callee)
    (= "integer?" callee)))

(defn static-collection-predicate? [callee: String] -> Bool
  (or (= "sequential?" callee) (= "map?" callee) (= "set?" callee)))

(defn static-type-predicate-value
  [types: (Vec core/TypeDef)
   callee: String
   value-type: core/NativeId] -> (U Bool Nil)
  (if (not (and (static-type-predicate? callee)
             (exact-closed-type? types value-type)))
    nil
    (cond
      (= "sequential?" callee)
      (and (vector-type? types value-type)
        (not (map-value? types value-type)))
      (= "map?" callee)
      (or (map-type? types value-type) (map-value? types value-type))
      (= "set?" callee) (set-type? types value-type)
      (= "string?" callee) (same-id? value-type (text-type-id))
      (= "integer?" callee) (same-id? value-type (int-type-id))
      :else nil)))

;; The trap code IS the LowerFailure variant ordinal, read off the union rather
;; than spelled twice.
(defn failure-code [name: String] -> Int
  (let [shape: core/TypeShape (core/typedef-shape (lower-failure-type))
        variants: (Vec core/TypeVariant)
        (if (instance? native.core.UnionType shape)
          (core/uniontype-variants shape)
          [])]
    (loop [position: Int 0]
      (cond
        (>= position (count variants)) (trap-failure-code)
        (= name (core/typevariant-name (nth variants position))) position
        :else (recur (+ position 1))))))

(defn text-operand? [type-id-value: core/NativeId] -> Bool
  (same-id? type-id-value (text-type-id)))

(defn concat-operands-native? [value-types: (Vec core/NativeId)] -> Bool
  (loop [position: Int 0]
    (if (>= position (count value-types))
      true
      (let [operand: core/NativeId (nth value-types position)]
        (if (or (text-operand? operand) (same-id? operand (int-type-id)))
          (recur (+ position 1))
          false)))))

(defn scalar-predicate? [callee: String] -> Bool
  (or (= "string?" callee)
    (= "integer?" callee)
    (= "number?" callee)
    (= "boolean?" callee)
    (= "keyword?" callee)))

(defn scalar-predicate-types [callee: String] -> (Vec core/NativeId)
  (cond
    (= "string?" callee) [(text-type-id)]
    (= "integer?" callee) [(int-type-id)]
    (= "number?" callee) [(int-type-id) (type-id "Float")]
    (= "boolean?" callee) [(bool-type-id)]
    (= "keyword?" callee) [(keyword-type-id)]
    :else []))

(defn bool-constant-result
  [state: BodyStateV0
   owner: core/NativeId
   label: String
   value: Bool] -> ExprResultV0
  (let [result-id: core/NativeId (state-id state owner label)]
    (->ExprResultV0
      (state-emit (state-bump state)
        (core/->AtomInstruction
          (core/->SsaValueV0 result-id (bool-type-id))
          (core/->BoolAtom value)))
      result-id (bool-type-id) false)))

(defn static-predicate-condition-value
  [index: SourceIndexV0
   owner: core/NativeId
   condition-node: core/NativeId
   condition: ExprResultV0] -> (U Bool Nil)
  (let [state: BodyStateV0 (exprresultv0-state condition)
        instructions: (Vec core/Instruction) (bodystatev0-instructions state)
        callee: String (fact-text index condition-node "callee")]
    (if (not (and (= "call" (fact-text index condition-node "form-kind"))
               (static-type-predicate? callee)
               (= 1 (count (source-call-arguments index condition-node)))
               (> (bodystatev0-counter state) 0)
               (> (count instructions) 0)))
      nil
      (let [instruction: core/Instruction
            (nth instructions (- (count instructions) 1))
            prior: BodyStateV0
            (with state [:counter (- (bodystatev0-counter state) 1)])]
        (if (not (instance? native.core.AtomInstruction instruction))
          nil
          (let [atom: core/NativeAtom (core/atominstruction-atom instruction)]
            (cond
              (not (same-id? (exprresultv0-value-id condition)
                     (state-id prior owner "static-predicate"))) nil
              (not (same-id? (exprresultv0-value-id condition)
                     (core/ssavaluev0-id
                       (core/atominstruction-result instruction)))) nil
              (instance? native.core.BoolAtom atom) (core/boolatom-value atom)
              :else nil)))))))

(defn drop-static-predicate-result [state: BodyStateV0] -> BodyStateV0
  (let [instructions: (Vec core/Instruction) (bodystatev0-instructions state)]
    (loop [position: Int 0 kept: (Vec core/Instruction) []]
      (if (>= (+ position 1) (count instructions))
        (with state [:instructions kept])
        (recur (+ position 1) (conj kept (nth instructions position)))))))

(defn variant-payload-in?
  [variant: core/TypeVariant
   accepted: (Vec core/NativeId)] -> Bool
  (let [payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)]
    (if (nil? payload) false (core/id-in? accepted payload))))

(defn lower-scalar-predicate
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   callee: String
   value-id: core/NativeId
   value-type: core/NativeId] -> ExprResultV0
  (let [accepted: (Vec core/NativeId) (scalar-predicate-types callee)
        variants: (Vec core/TypeVariant) (union-variants-of types value-type)]
    (if (= 0 (count variants))
      (bool-constant-result state owner "scalar-predicate"
        (core/id-in? accepted value-type))
      (let [true-id: core/NativeId (state-id state owner "predicate-true")
            false-id: core/NativeId (state-id state owner "predicate-false")
            join-id: core/NativeId (state-id state owner "predicate-join")
            join-parameter: core/NativeId
            (state-id state owner "predicate-value")
            true-value: core/NativeId (state-id state owner "predicate-yes")
            false-value: core/NativeId (state-id state owner "predicate-no")
            cases: (Vec core/SwitchCaseV0)
            (mapv
              (fn [variant: core/TypeVariant] -> core/SwitchCaseV0
                (core/->SwitchCaseV0 (core/typevariant-id variant)
                  (if (variant-payload-in? variant accepted) true-id false-id)
                  []))
              variants)
            switched: BodyStateV0
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            true-block: BodyStateV0
            (state-close
              (state-emit (state-open-block switched true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            false-block: BodyStateV0
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn collection-predicate? [callee: String] -> Bool
  (or (= "map?" callee)
    (= "set?" callee)
    (= "sequential?" callee)))

(defn collection-predicate-type?
  [types: (Vec core/TypeDef)
   callee: String
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (if (nil? definition)
      false
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (cond
          (= "map?" callee) (instance? native.core.MapTypeV0 shape)
          (= "set?" callee) (instance? native.core.SetTypeV0 shape)
          (= "sequential?" callee) (instance? native.core.VectorType shape)
          :else false)))))

(defn collection-variant-matches?
  [types: (Vec core/TypeDef)
   callee: String
   variant: core/TypeVariant] -> Bool
  (let [payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)]
    (if (nil? payload)
      false
      (collection-predicate-type? types callee payload))))

(defn lower-collection-predicate
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   callee: String
   value-id: core/NativeId
   value-type: core/NativeId] -> ExprResultV0
  (let [variants: (Vec core/TypeVariant) (union-variants-of types value-type)]
    (if (= 0 (count variants))
      (bool-constant-result state owner "collection-predicate"
        (collection-predicate-type? types callee value-type))
      (let [true-id: core/NativeId (state-id state owner "collection-true")
            false-id: core/NativeId (state-id state owner "collection-false")
            join-id: core/NativeId (state-id state owner "collection-join")
            join-parameter: core/NativeId
            (state-id state owner "collection-value")
            true-value: core/NativeId (state-id state owner "collection-yes")
            false-value: core/NativeId (state-id state owner "collection-no")
            cases: (Vec core/SwitchCaseV0)
            (mapv
              (fn [variant: core/TypeVariant] -> core/SwitchCaseV0
                (core/->SwitchCaseV0 (core/typevariant-id variant)
                  (if (collection-variant-matches? types callee variant)
                    true-id false-id)
                  []))
              variants)
            switched: BodyStateV0
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            true-block: BodyStateV0
            (state-close
              (state-emit (state-open-block switched true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            false-block: BodyStateV0
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn nil-variant? [variant: core/TypeVariant] -> Bool
  (let [payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)]
    (if (nil? payload)
      (= "nil" (core/typevariant-name variant))
      (same-id? payload (type-id "Nil")))))

(defn nil-variant-count [variants: (Vec core/TypeVariant)] -> Int
  (loop [position: Int 0 found: Int 0]
    (if (>= position (count variants))
      found
      (recur (+ position 1)
        (+ found (if (nil-variant? (nth variants position)) 1 0))))))

(defn optional-scalar-type-of
  [types: (Vec core/TypeDef)
   scalar: core/NativeId] -> (U core/NativeId Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (let [definition: core/TypeDef (nth types position)
            variants: (Vec core/TypeVariant)
            (union-variants-of types (core/typedef-id definition))]
        (if (and (= 2 (count variants))
              (= 1 (nil-variant-count variants))
              (some? (variant-for-payload variants scalar)))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn regex-match-value?
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (lookup-type types target)]
    (and (some? definition)
      (= "RegexMatch" (core/typedef-name definition)))))

(defn nullable-value-type-of
  [types: (Vec core/TypeDef)
   value-type: core/NativeId] -> (U core/NativeId Nil)
  (let [direct: (Vec core/TypeVariant) (union-variants-of types value-type)
        wrapper: core/NativeId (nullable-map-value-type-id value-type)]
    (cond
      (> (nil-variant-count direct) 0) value-type
      (some? (lookup-type types wrapper)) wrapper
      :else (optional-scalar-type-of types value-type))))

(defn lower-presence-predicate
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   value-id: core/NativeId
   value-type: core/NativeId
   want-present: Bool] -> ExprResultV0
  (let [variants: (Vec core/TypeVariant) (union-variants-of types value-type)]
    (cond
      (regex-match-value? types value-type)
      (let [length-id: core/NativeId (state-id state owner "match-length")
            zero-id: core/NativeId
            (state-id (state-bump state) owner "match-zero")
            result-id: core/NativeId
            (state-id (state-bump (state-bump state)) owner "match-present")]
        (->ExprResultV0
          (state-emit
            (state-emit
              (state-emit
                (state-bump (state-bump (state-bump state)))
                (core/->VecLengthInstruction
                  (core/->SsaValueV0 length-id (int-type-id)) value-id))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (if want-present
                (core/->CompareLtI64V0 true)
                (core/->CompareEqI64V0 true))
              zero-id length-id))
          result-id (bool-type-id) false))

      (same-id? value-type (type-id "Nil"))
      (bool-constant-result state owner "presence-direct" (not want-present))

      (= 0 (count variants))
      (bool-constant-result state owner "presence-direct" want-present)

      (not (= 1 (nil-variant-count variants)))
      (fail-result state
        "TODO-NATIVE-PRESENCE-TYPE: nil?/some? needs one closed nil alternative")

      :else
      (let [true-id: core/NativeId (state-id state owner "presence-true")
            false-id: core/NativeId (state-id state owner "presence-false")
            join-id: core/NativeId (state-id state owner "presence-join")
            join-parameter: core/NativeId
            (state-id state owner "presence-value")
            true-value: core/NativeId (state-id state owner "presence-yes")
            false-value: core/NativeId (state-id state owner "presence-no")
            cases: (Vec core/SwitchCaseV0)
            (mapv
              (fn [variant: core/TypeVariant] -> core/SwitchCaseV0
                (let [present: Bool (not (nil-variant? variant))]
                  (core/->SwitchCaseV0 (core/typevariant-id variant)
                    (if (= present want-present) true-id false-id) [])))
              variants)
            switched: BodyStateV0
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            true-block: BodyStateV0
            (state-close
              (state-emit (state-open-block switched true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            false-block: BodyStateV0
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn lower-truthy-with-budget
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   value-id: core/NativeId
   value-type: core/NativeId
   budget: Int] -> ExprResultV0
  (let [variants: (Vec core/TypeVariant) (union-variants-of types value-type)]
    (cond
      (same-id? value-type (bool-type-id))
      (->ExprResultV0 state value-id (bool-type-id) false)

      (same-id? value-type (type-id "Nil"))
      (bool-constant-result state owner "truthy-nil" false)

      (= 0 (count variants))
      (bool-constant-result state owner "truthy-value" true)

      (< budget 0)
      (fail-result state
        "TODO-NATIVE-TRUTHY-DEPTH: closed-union truthiness nested past the v0 budget")

      :else
      (let [true-id: core/NativeId (state-id state owner "truthy-true")
            false-id: core/NativeId (state-id state owner "truthy-false")
            join-id: core/NativeId (state-id state owner "truthy-join")
            join-parameter: core/NativeId
            (state-id state owner "truthy-result")
            cases: (Vec core/SwitchCaseV0)
            (loop [position: Int 0 collected: (Vec core/SwitchCaseV0) []]
              (if (>= position (count variants))
                collected
                (let [variant: core/TypeVariant (nth variants position)
                      payload: (U core/NativeId Nil)
                      (core/typevariant-payload-type variant)
                      target: core/NativeId
                      (if (nil-variant? variant)
                        false-id
                        (if (nil? payload)
                          true-id
                          (if (or (same-id? payload (bool-type-id))
                                (> (count (union-variants-of types payload)) 0))
                            (state-id state owner
                              (str "truthy-arm-" position))
                            true-id)))]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id variant) target []))))))
            switched: BodyStateV0
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            armed: BodyStateV0
            (loop [position: Int 0 current: BodyStateV0 switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [variant: core/TypeVariant (nth variants position)
                      payload: (U core/NativeId Nil)
                      (core/typevariant-payload-type variant)]
                  (if (or (nil? payload)
                        (nil-variant? variant)
                        (and (not (same-id? payload (bool-type-id)))
                          (= 0 (count (union-variants-of types payload)))))
                    (recur (+ position 1) current)
                    (let [arm-id: core/NativeId
                          (state-id state owner (str "truthy-arm-" position))
                          opened: BodyStateV0 (state-open-block current arm-id [])
                          extracted-id: core/NativeId
                          (state-id opened owner (str "truthy-payload-" position))
                          extracted: BodyStateV0
                          (state-emit (state-bump opened)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 extracted-id payload)
                              value-id (core/typevariant-id variant)))
                          truthy: ExprResultV0
                          (lower-truthy-with-budget types owner extracted
                            extracted-id payload (- budget 1))]
                      (if (state-blocked? (exprresultv0-state truthy))
                        (exprresultv0-state truthy)
                        (recur (+ position 1)
                          (state-close (exprresultv0-state truthy)
                            (core/->JumpTerminator join-id
                              [(exprresultv0-value-id truthy)])))))))))
            true-value: core/NativeId (state-id armed owner "truthy-yes")
            true-block: BodyStateV0
            (state-close
              (state-emit (state-open-block armed true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            false-value: core/NativeId (state-id true-block owner "truthy-no")
            false-block: BodyStateV0
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (if (state-blocked? false-block)
          (dead-result false-block)
          (->ExprResultV0
            (state-open-block false-block join-id
              [(core/->Parameter join-parameter (bool-type-id))])
            join-parameter (bool-type-id) false))))))

(defn lower-truthy
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   value-id: core/NativeId
   value-type: core/NativeId] -> ExprResultV0
  (lower-truthy-with-budget types owner state value-id value-type (widen-budget)))

(defn lower-text-index
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   source-id: core/NativeId
   needle-id: core/NativeId] -> ExprResultV0
  (let [optional: (U core/NativeId Nil)
        (optional-scalar-type-of types (int-type-id))]
    (if (nil? optional)
      (fail-result state
        "TODO-NATIVE-TEXT-INDEX-TYPE: the source world declares no nullable Int")
      (let [result-id: core/NativeId (state-id state owner "text-index")]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->TextIndexOfInstruction
              (core/->SsaValueV0 result-id optional) source-id needle-id))
          result-id optional false)))))

(defn lower-positive
  [types: (Vec core/TypeDef)
   state: BodyStateV0
   owner: core/NativeId
   value-id: core/NativeId
   value-type: core/NativeId] -> ExprResultV0
  (let [value: ExprResultV0
        (lower-boundary-coerce types owner state value-id value-type (int-type-id))]
    (if (state-blocked? (exprresultv0-state value))
      (dead-result (exprresultv0-state value))
      (let [base: BodyStateV0 (exprresultv0-state value)
            zero-id: core/NativeId (state-id base owner "positive-zero")
            result-id: core/NativeId (state-id (state-bump base) owner "positive")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump base))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (core/->CompareLtI64V0 true)
              zero-id (exprresultv0-value-id value)))
          result-id (bool-type-id) false)))))

(defn lower-negative
  [types: (Vec core/TypeDef)
   state: BodyStateV0
   owner: core/NativeId
   value-id: core/NativeId
   value-type: core/NativeId] -> ExprResultV0
  (let [value: ExprResultV0
        (lower-boundary-coerce types owner state value-id value-type (int-type-id))]
    (if (state-blocked? (exprresultv0-state value))
      (dead-result (exprresultv0-state value))
      (let [base: BodyStateV0 (exprresultv0-state value)
            zero-id: core/NativeId (state-id base owner "negative-zero")
            result-id: core/NativeId (state-id (state-bump base) owner "negative")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump base))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (core/->CompareLtI64V0 true)
              (exprresultv0-value-id value) zero-id))
          result-id (bool-type-id) false)))))

(defn equality-comparison [type-id-value: core/NativeId] -> (U core/CompareOpV0 Nil)
  (cond
    (same-id? type-id-value (int-type-id)) (core/->CompareEqI64V0 true)
    (same-id? type-id-value (keyword-type-id)) (core/->CompareEqI64V0 true)
    (same-id? type-id-value (bool-type-id)) (core/->CompareEqBoolV0 true)
    (same-id? type-id-value (text-type-id)) (core/->CompareEqTextV0 true)
    :else nil))

;; Equality is total across a scalar and a union: another tag is false, while
;; the matching tag is extracted and compared with its scalar semantics.
(defn lower-scalar-union-equality
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   scalar-id: core/NativeId
   scalar-type: core/NativeId
   union-id: core/NativeId
   union-type: core/NativeId] -> ExprResultV0
  (let [variants: (Vec core/TypeVariant) (union-variants-of types union-type)
        target: (U core/TypeVariant Nil) (variant-for-payload variants scalar-type)
        comparison: (U core/CompareOpV0 Nil) (equality-comparison scalar-type)]
    (cond
      (nil? comparison)
      (fail-result state
        "TODO-NATIVE-EQUALITY-SCALAR: the scalar has no native equality")

      (nil? target)
      (bool-constant-result state owner "equality-miss" false)

      :else
      (let [match-id: core/NativeId (state-id state owner "equality-match")
            miss-id: core/NativeId (state-id state owner "equality-miss")
            join-id: core/NativeId (state-id state owner "equality-join")
            join-parameter: core/NativeId (state-id state owner "equality-value")
            extracted-id: core/NativeId (state-id state owner "equality-scalar")
            compared-id: core/NativeId (state-id state owner "equality-compared")
            false-id: core/NativeId (state-id state owner "equality-false")
            cases: (Vec core/SwitchCaseV0)
            (mapv
              (fn [variant: core/TypeVariant] -> core/SwitchCaseV0
                (core/->SwitchCaseV0 (core/typevariant-id variant)
                  (if (same-id? (core/typevariant-id variant)
                        (core/typevariant-id target))
                    match-id miss-id)
                  []))
              variants)
            switched: BodyStateV0
            (state-close (state-bump state)
              (core/->SwitchTerminator union-id cases))
            matched: BodyStateV0
            (state-emit
              (state-emit (state-open-block switched match-id [])
                (core/->UnionExtractInstruction
                  (core/->SsaValueV0 extracted-id scalar-type)
                  union-id (core/typevariant-id target)))
              (core/->CompareInstruction
                (core/->SsaValueV0 compared-id (bool-type-id))
                comparison scalar-id extracted-id))
            after-match: BodyStateV0
            (state-close matched (core/->JumpTerminator join-id [compared-id]))
            missed: BodyStateV0
            (state-emit (state-open-block after-match miss-id [])
              (core/->AtomInstruction
                (core/->SsaValueV0 false-id (bool-type-id))
                (core/->BoolAtom false)))
            after-miss: BodyStateV0
            (state-close missed (core/->JumpTerminator join-id [false-id]))]
        (->ExprResultV0
          (state-open-block after-miss join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn lower-text-search-predicate
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   callee: String
   source-id: core/NativeId
   needle-id: core/NativeId] -> ExprResultV0
  (let [found: ExprResultV0
        (lower-text-index types owner state source-id needle-id)
        current: BodyStateV0 (exprresultv0-state found)]
    (cond
      (state-blocked? current) (dead-result current)
      (= "str/includes?" callee)
      (lower-presence-predicate types owner current
        (exprresultv0-value-id found) (exprresultv0-type-id found) true)
      :else
      (let [zero-id: core/NativeId (state-id current owner "text-index-zero")
            with-zero: BodyStateV0
            (state-emit (state-bump current)
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))]
        (lower-scalar-union-equality types owner with-zero zero-id
          (int-type-id) (exprresultv0-value-id found)
          (exprresultv0-type-id found))))))

(defn lower-ordered-union-comparison
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   callee: String
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)] -> ExprResultV0
  (let [left-union: Bool
        (> (count (union-variants-of types (nth value-types 0))) 0)
        scalar-position: Int (if left-union 1 0)
        union-position: Int (if left-union 0 1)
        scalar-type: core/NativeId (nth value-types scalar-position)
        extracted: ExprResultV0
        (lower-boundary-coerce types owner state
          (nth values union-position) (nth value-types union-position) scalar-type)
        settled: BodyStateV0 (exprresultv0-state extracted)
        ordered-values: (Vec core/NativeId)
        (if left-union
          [(exprresultv0-value-id extracted) (nth values 1)]
          [(nth values 0) (exprresultv0-value-id extracted)])
        comparison: (U core/CompareOpV0 Nil) (compare-op-for callee)
        swap: Bool (compare-swaps? callee)
        result-id: core/NativeId (state-id settled owner "ordered-compare")]
    (cond
      (state-blocked? settled) (dead-result settled)
      (or (nil? comparison) (not (same-id? scalar-type (int-type-id))))
      (fail-result settled
        "TODO-NATIVE-ORDERED-UNION: ordered comparison needs an Int alternative")
      :else
      (->ExprResultV0
        (state-emit (state-bump settled)
          (core/->CompareInstruction
            (core/->SsaValueV0 result-id (bool-type-id))
            comparison
            (nth ordered-values (if swap 1 0))
            (nth ordered-values (if swap 0 1))))
        result-id (bool-type-id) false))))

(defn type-widens-to?
  [types: (Vec core/TypeDef)
   from: core/NativeId
   to: core/NativeId
   budget: Int] -> Bool
  (cond
    (same-id? from to) true
    (< budget 0) false
    :else
    (let [targets: (Vec core/TypeVariant) (union-variants-of types to)
          sources: (Vec core/TypeVariant) (union-variants-of types from)]
      (cond
        (= 0 (count targets)) false
        (some? (variant-for-payload targets from)) true
        (some? (variant-for-record-reference types targets from)) true
        (same-id? from (type-id "Nil"))
        (some? (some nil-variant? targets))
        (= 0 (count sources)) false
        :else
        (every?
          (fn [variant: core/TypeVariant] -> Bool
            (let [payload: (U core/NativeId Nil)
                  (core/typevariant-payload-type variant)]
              (if (or (nil? payload) (same-id? payload (type-id "Nil")))
                (some? (some nil-variant? targets))
                (type-widens-to? types payload to (- budget 1)))))
          sources)))))

(defn join-type-for
  [types: (Vec core/TypeDef)
   left: core/NativeId
   right: core/NativeId] -> (U core/NativeId Nil)
  (cond
    (same-id? left right) left
    (type-widens-to? types right left (widen-budget)) left
    (type-widens-to? types left right (widen-budget)) right
    :else
    (loop [position: Int 0
           chosen: (U core/NativeId Nil) nil
           chosen-width: Int 2147483647]
      (if (>= position (count types))
        chosen
        (let [candidate: core/NativeId (core/typedef-id (nth types position))
              variants: (Vec core/TypeVariant) (union-variants-of types candidate)
              width: Int (count variants)]
          (if (and (> width 0)
                (< width chosen-width)
                (type-widens-to? types left candidate (widen-budget))
                (type-widens-to? types right candidate (widen-budget)))
            (recur (+ position 1) candidate width)
            (recur (+ position 1) chosen chosen-width)))))))

(defn bridge-join-arms
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   state: BodyStateV0
   left-start: Int
   left-end: Int
   right-start: Int
   right-end: Int
   join-id: core/NativeId
   join-parameter: core/NativeId
   left-type: core/NativeId
   right-type: core/NativeId] -> ExprResultV0
  (let [target: (U core/NativeId Nil) (join-type-for types left-type right-type)]
    (if (nil? target)
      (fail-result state
        "TODO-NATIVE-JOIN-TYPE: live arms have no declared native union")
      (let [left-id: core/NativeId (state-id state owner "join-left-coerce")
            right-id: core/NativeId (state-id state owner "join-right-coerce")
            left-value: core/NativeId (state-id state owner "join-left-value")
            right-value: core/NativeId (state-id state owner "join-right-value")
            rewired-left: BodyStateV0
            (retarget-jumps-between state left-start left-end join-id left-id)
            rewired: BodyStateV0
            (retarget-jumps-between rewired-left
              right-start right-end join-id right-id)
            left-open: BodyStateV0
            (state-open-block rewired left-id
              [(core/->Parameter left-value left-type)])
            left: ExprResultV0
            (lower-boundary-coerce types owner left-open
              left-value left-type target)]
        (if (state-blocked? (exprresultv0-state left))
          (dead-result (exprresultv0-state left))
          (let [left-closed: BodyStateV0
                (state-close (exprresultv0-state left)
                  (core/->JumpTerminator join-id
                    [(exprresultv0-value-id left)]))
                right-open: BodyStateV0
                (state-open-block left-closed right-id
                  [(core/->Parameter right-value right-type)])
                right: ExprResultV0
                (lower-boundary-coerce types owner right-open
                  right-value right-type target)]
            (if (state-blocked? (exprresultv0-state right))
              (dead-result (exprresultv0-state right))
              (->ExprResultV0
                (state-open-block
                  (state-close (exprresultv0-state right)
                    (core/->JumpTerminator join-id
                      [(exprresultv0-value-id right)]))
                  join-id [(core/->Parameter join-parameter target)])
                join-parameter target false))))))))

(defn host-socket-operands-valid?
  [callee: String
   value-types: (Vec core/NativeId)] -> Bool
  (cond
    (or (= callee "host.socket/inherited-listener")
        (= callee "host.socket/accept")
        (= callee "host.socket/close"))
    (and (= 1 (count value-types))
      (same-id? (nth value-types 0) (int-type-id)))

    (= callee "host.socket/read-bounded")
    (and (= 2 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (int-type-id)))

    (= callee "host.socket/write-bounded")
    (and (= 3 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (bytes-type-id))
      (same-id? (nth value-types 2) (int-type-id)))

    :else false))

(defn host-socket-result-type [callee: String] -> core/NativeId
  (cond
    (= callee "host.socket/read-bounded") (socket-bytes-outcome-type-id)
    (= callee "host.socket/close") (socket-close-outcome-type-id)
    :else (socket-int-outcome-type-id)))

(defn lower-host-socket-call
  [owner: core/NativeId
   state: BodyStateV0
   callee: String
   values: (Vec core/NativeId)
   value-types: (Vec core/NativeId)] -> ExprResultV0
  (if (not (host-socket-operands-valid? callee value-types))
    (fail-result state
      (str "TODO-NATIVE-HOST-SOCKET-OPERANDS: " callee
        " needs explicit Int descriptors; read takes a bound and write takes NativeBytes plus a bound"))
    (let [result-id: core/NativeId (state-id state owner "host-socket")
          result-type: core/NativeId (host-socket-result-type callee)
          operation: String (host-socket-operation callee)
          arena: (U core/NativeId Nil)
          (if (= callee "host.socket/read-bounded")
            (arena-value-id owner)
            nil)]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id result-type)
            (host-socket-abi-id operation)
            values
            arena
            (core/->TokenFlowV0 [] [])))
        result-id result-type false))))

(defn lower-expr
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   expr: core/NativeId] -> ExprResultV0
  (if (state-blocked? state)
    (dead-result state)
    (let [index: SourceIndexV0 (bodyenvv0-index env)
          types: (Vec core/TypeDef) (bodyenvv0-types env)
          kind: String (fact-text index expr "form-kind")]
      (cond
        (= "literal" kind)
        (let [literal-kind: String (fact-text index expr "literal-kind")
              text: String (fact-text index expr "value")
              result-id: core/NativeId (state-id state owner "lit")
              bumped: BodyStateV0 (state-bump state)]
          (cond
            (or (= "int" literal-kind) (= "number" literal-kind))
            (let [parsed: (U Int Nil) (parse-int-text text)]
              (if (nil? parsed)
                (fail-result state
                  (str "TODO-NATIVE-LITERAL-INT: " text
                    " is not an exact native integer"))
                (->ExprResultV0
                  (state-emit bumped
                    (core/->AtomInstruction
                      (core/->SsaValueV0 result-id (int-type-id))
                      (core/->I64Atom parsed)))
                  result-id (int-type-id) false)))

            (= "bool" literal-kind)
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (bool-type-id))
                  (core/->BoolAtom (= "true" text))))
              result-id (bool-type-id) false)

            (= "string" literal-kind)
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (text-type-id))
                  (core/->TextAtom text)))
              result-id (text-type-id) false)

            (= "keyword" literal-kind)
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (keyword-type-id))
                  (core/->KeywordAtom text)))
              result-id (keyword-type-id) false)

            (= "nil" literal-kind)
            (let [variants: (Vec core/TypeVariant)
                  (union-variants-of types (type-id "Nil"))]
              (if (and (= 1 (count variants))
                    (nil? (core/typevariant-payload-type (nth variants 0))))
                (->ExprResultV0
                  (state-emit bumped
                    (core/->UnionConstructInstruction
                      (core/->SsaValueV0 result-id (type-id "Nil"))
                      (core/typevariant-id (nth variants 0))
                      nil))
                  result-id (type-id "Nil") false)
                (fail-result state
                  "TODO-NATIVE-LITERAL-NIL-TYPE: Nil has no closed unit variant")))

            :else
            (fail-result state
              (str "TODO-NATIVE-LITERAL-" literal-kind
                ": no native atom for this literal kind"))))

        (= "ref" kind)
        (let [name: String (fact-text index expr "name")
              direct: (U LocalBindingV0 Nil)
              (find-local (bodystatev0-locals state) name)
              canonical: String
              (resolved-source-key
                (resolve-source-name index (body-owner-module env owner) name))
              binding: (U LocalBindingV0 Nil)
              (if (some? direct)
                direct
                (find-local (bodystatev0-locals state) canonical))]
          (if (nil? binding)
            (fail-result state
              (str "TODO-NATIVE-FREE-REFERENCE: " name
                " is not a parameter or local binding"))
            (->ExprResultV0 state (localbindingv0-value-id binding)
              (localbindingv0-type-id binding) false)))

        (= "fn" kind)
        (fail-result state
          "TODO-NATIVE-FN-ESCAPES: anonymous functions lower only as an inline reduce callback")

        (= "let" kind)
        (let [outer-locals: (Vec LocalBindingV0) (bodystatev0-locals state)
              bindings-node: (U core/NativeId Nil)
              (index-first-object index expr "bindings")
              items: (Vec core/NativeId)
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              bound: ExprResultV0
              (loop [position: Int 0 current: BodyStateV0 state]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ExprResultV0 current (lower-id "body" ["let"])
                    (type-id "LowerFailure") false)
                  (let [item: core/NativeId (nth items position)
                        name: String (fact-text index item "name")
                        annotation: (U core/NativeId Nil)
                        (index-first-object index item "ann")
                        value-node: (U core/NativeId Nil)
                        (index-first-object index item "value")]
                    (if (nil? value-node)
                      (->ExprResultV0
                        (state-fail current
                          (str "TODO-NATIVE-BINDING-VALUE: " name " has no value form"))
                        (lower-id "body" ["let"]) (type-id "LowerFailure") false)
                      (let [raw: ExprResultV0
                            (cond
                              (empty-vector-form? index value-node)
                              (lower-empty-vector env owner current annotation)

                              (empty-map-form? index value-node)
                              (lower-empty-map env owner current annotation)

                              (empty-set-form? index value-node)
                              (lower-empty-set env owner current annotation)

                              :else
                              (lower-expr env owner current value-node))
                            value: ExprResultV0
                            (if (or (nil? annotation)
                                  (exprresultv0-terminated raw)
                                  (state-blocked? (exprresultv0-state raw)))
                              raw
                              (lower-boundary-coerce types owner
                                (exprresultv0-state raw)
                                (exprresultv0-value-id raw)
                                (exprresultv0-type-id raw)
                                (typeresolutionv0-type-id
                                  (resolve-source-type index annotation))))]
                        (if (exprresultv0-terminated value)
                          value
                          (recur (+ position 1)
                            (state-bind (exprresultv0-state value) name
                              (exprresultv0-value-id value)
                              (exprresultv0-type-id value)))))))))
              body-node: (U core/NativeId Nil) (index-first-object index expr "body")]
          (cond
            (exprresultv0-terminated bound) bound
            (state-blocked? (exprresultv0-state bound))
            (dead-result (exprresultv0-state bound))
            (nil? body-node)
            (fail-result (exprresultv0-state bound)
              "TODO-NATIVE-LET-BODY: let form has no body")
            :else
            (let [body: ExprResultV0
                  (lower-expr env owner (exprresultv0-state bound) body-node)]
              (->ExprResultV0
                (with (exprresultv0-state body) [:locals outer-locals])
                (exprresultv0-value-id body)
                (exprresultv0-type-id body)
                (exprresultv0-terminated body)))))

        (= "if" kind)
        (let [condition-node: (U core/NativeId Nil)
              (index-first-object index expr "cond")
              then-node: (U core/NativeId Nil) (index-first-object index expr "then")
              else-node: (U core/NativeId Nil) (index-first-object index expr "else")]
          (if (or (nil? condition-node) (nil? then-node) (nil? else-node))
            (fail-result state
              "TODO-NATIVE-IF-ARMS: if form needs a condition and both arms")
            (let [raw-condition: ExprResultV0
                  (lower-expr env owner state condition-node)
                  condition: ExprResultV0
                  (if (or (exprresultv0-terminated raw-condition)
                          (state-blocked? (exprresultv0-state raw-condition)))
                    raw-condition
                    (lower-truthy types owner
                      (exprresultv0-state raw-condition)
                      (exprresultv0-value-id raw-condition)
                      (exprresultv0-type-id raw-condition)))]
              (cond
                (exprresultv0-terminated condition) condition
                (state-blocked? (exprresultv0-state condition))
                (dead-result (exprresultv0-state condition))
                (not (same-id? (exprresultv0-type-id condition) (bool-type-id)))
                (fail-result (exprresultv0-state condition)
                  "TODO-NATIVE-IF-CONDITION: condition is not a native Bool")
                :else
                (let [static-condition: (U Bool Nil)
                      (static-predicate-condition-value index owner
                        condition-node condition)]
                  (if (some? static-condition)
                    ;; Operand instructions are already in state; discard only the predicate atom.
                    (lower-expr env owner
                      (drop-static-predicate-result
                        (exprresultv0-state condition))
                      (if static-condition then-node else-node))
                    (let [base: BodyStateV0 (exprresultv0-state condition)
                      then-id: core/NativeId (state-id base owner "then")
                      else-id: core/NativeId (state-id base owner "else")
                      join-id: core/NativeId (state-id base owner "join")
                      join-parameter: core/NativeId (state-id base owner "join-value")
                      branched: BodyStateV0
                      (state-open-block
                        (state-close (state-bump base)
                          (core/->BranchTerminator
                            (exprresultv0-value-id condition) then-id else-id))
                        then-id [])
                      then-start: Int (count (bodystatev0-blocks branched))
                      then-result: ExprResultV0 (lower-expr env owner branched then-node)
                      after-then: BodyStateV0
                      (if (exprresultv0-terminated then-result)
                        (exprresultv0-state then-result)
                        (state-close (exprresultv0-state then-result)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id then-result)])))
                      then-end: Int (count (bodystatev0-blocks after-then))
                      else-start: BodyStateV0 (state-open-block after-then else-id [])
                      else-block-start: Int (count (bodystatev0-blocks else-start))
                      else-result: ExprResultV0
                      (lower-expr env owner else-start else-node)
                      after-else: BodyStateV0
                      (if (exprresultv0-terminated else-result)
                        (exprresultv0-state else-result)
                        (state-close (exprresultv0-state else-result)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id else-result)])))
                      else-end: Int (count (bodystatev0-blocks after-else))
                      then-live: Bool (not (exprresultv0-terminated then-result))
                      else-live: Bool (not (exprresultv0-terminated else-result))
                      result-type: core/NativeId
                      (if then-live
                        (exprresultv0-type-id then-result)
                        (exprresultv0-type-id else-result))]
                  (cond
                    (state-blocked? after-else) (dead-result after-else)
                    (and (not then-live) (not else-live))
                    (->ExprResultV0 after-else (lower-id "body" ["unreachable"])
                      result-type true)
                    (and then-live else-live
                      (not (same-id? (exprresultv0-type-id then-result)
                             (exprresultv0-type-id else-result))))
                    (bridge-join-arms types owner after-else
                      then-start then-end else-block-start else-end
                      join-id join-parameter
                      (exprresultv0-type-id then-result)
                      (exprresultv0-type-id else-result))
                    :else
                    (->ExprResultV0
                      (state-open-block after-else join-id
                        [(core/->Parameter join-parameter result-type)])
                      join-parameter result-type false)))))))))

        (= "cond" kind)
        (let [clauses-node: (U core/NativeId Nil)
              (index-first-object index expr "clauses")
              clauses: (Vec core/NativeId)
              (if (nil? clauses-node) []
                (index-sequence-items index clauses-node))
              join-id: core/NativeId (state-id state owner "cond-join")
              join-parameter: core/NativeId
              (state-id state owner "cond-value")]
          (loop [position: Int 0
                 current: BodyStateV0 state
                 result-type: (U core/NativeId Nil) nil
                 live-arms: Int 0]
            (if (>= position (count clauses))
              (cond
                (state-blocked? current) (dead-result current)
                (nil? result-type)
                (->ExprResultV0 current (lower-id "body" ["cond-terminated"])
                  (type-id "LowerFailure") true)
                :else
                (->ExprResultV0
                  (state-open-block current join-id
                    [(core/->Parameter join-parameter result-type)])
                  join-parameter result-type false))
              (let [clause: core/NativeId (nth clauses position)
                    test-node: (U core/NativeId Nil)
                    (index-first-object index clause "test")
                    body-node: (U core/NativeId Nil)
                    (index-first-object index clause "body")
                    fallback: Bool
                    (and (some? test-node)
                      (= "ref" (fact-text index test-node "form-kind"))
                      (= "else" (fact-text index test-node "name")))]
                (cond
                  (or (nil? test-node) (nil? body-node))
                  (fail-result current
                    "TODO-NATIVE-COND-CLAUSE: cond clauses need one test and one body")

                  fallback
                  (let [body: ExprResultV0
                        (lower-expr env owner current body-node)
                        body-state: BodyStateV0 (exprresultv0-state body)]
                    (cond
                      (state-blocked? body-state) (dead-result body-state)
                      (exprresultv0-terminated body)
                      (recur (count clauses) body-state result-type live-arms)
                      (nil? result-type)
                      (recur (count clauses)
                        (state-close body-state
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id body)]))
                        (exprresultv0-type-id body) (+ live-arms 1))
                      :else
                      (let [settled: ExprResultV0
                            (lower-boundary-coerce types owner body-state
                              (exprresultv0-value-id body)
                              (exprresultv0-type-id body) result-type)]
                        (if (state-blocked? (exprresultv0-state settled))
                          (dead-result (exprresultv0-state settled))
                          (recur (count clauses)
                            (state-close (exprresultv0-state settled)
                              (core/->JumpTerminator join-id
                                [(exprresultv0-value-id settled)]))
                            result-type (+ live-arms 1))))))

                  :else
                  (let [raw-condition: ExprResultV0
                        (lower-expr env owner current test-node)
                        condition: ExprResultV0
                        (if (or (exprresultv0-terminated raw-condition)
                                (state-blocked? (exprresultv0-state raw-condition)))
                          raw-condition
                          (lower-truthy types owner
                            (exprresultv0-state raw-condition)
                            (exprresultv0-value-id raw-condition)
                            (exprresultv0-type-id raw-condition)))
                        condition-state: BodyStateV0
                        (exprresultv0-state condition)]
                    (cond
                      (state-blocked? condition-state)
                      (dead-result condition-state)
                      (exprresultv0-terminated condition) condition
                      (not (same-id? (exprresultv0-type-id condition)
                             (bool-type-id)))
                      (fail-result condition-state
                        "TODO-NATIVE-COND-CONDITION: cond tests must lower to Bool")
                      :else
                      (let [body-id: core/NativeId
                            (state-id condition-state owner "cond-body")
                            next-id: core/NativeId
                            (state-id (state-bump condition-state) owner "cond-next")
                            branched: BodyStateV0
                            (state-open-block
                              (state-close (state-bump (state-bump condition-state))
                                (core/->BranchTerminator
                                  (exprresultv0-value-id condition)
                                  body-id next-id))
                              body-id [])
                            body: ExprResultV0
                            (lower-expr env owner branched body-node)
                            body-state: BodyStateV0 (exprresultv0-state body)
                            body-live: Bool
                            (not (exprresultv0-terminated body))]
                        (cond
                          (state-blocked? body-state) (dead-result body-state)
                          (not body-live)
                          (recur (+ position 1)
                            (state-open-block body-state next-id [])
                            result-type live-arms)
                          (nil? result-type)
                          (recur (+ position 1)
                            (state-open-block
                              (state-close body-state
                                (core/->JumpTerminator join-id
                                  [(exprresultv0-value-id body)]))
                              next-id [])
                            (exprresultv0-type-id body) (+ live-arms 1))
                          :else
                          (let [settled: ExprResultV0
                                (lower-boundary-coerce types owner body-state
                                  (exprresultv0-value-id body)
                                  (exprresultv0-type-id body) result-type)]
                            (if (state-blocked? (exprresultv0-state settled))
                              (dead-result (exprresultv0-state settled))
                              (recur (+ position 1)
                                (state-open-block
                                  (state-close (exprresultv0-state settled)
                                    (core/->JumpTerminator join-id
                                      [(exprresultv0-value-id settled)]))
                                  next-id [])
                                result-type (+ live-arms 1)))))))))))))

        (= "loop" kind)
        (let [bindings-node: (U core/NativeId Nil)
              (index-first-object index expr "bindings")
              items: (Vec core/NativeId)
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              body-node: (U core/NativeId Nil) (index-first-object index expr "body")
              outer-locals: (Vec LocalBindingV0) (bodystatev0-locals state)
              outer-frames: (Vec LoopFrameV0) (bodystatev0-loop-frames state)]
          (cond
            (nil? body-node)
            (fail-result state "TODO-NATIVE-LOOP-BODY: loop form has no body")

            (not (recur-tail-only? index body-node true (+ 1 (index-facts index))))
            (fail-result state
              "TODO-NATIVE-RECUR-NON-TAIL: recur is not in tail position of its loop")

            :else
            (let [inits: LoopInitsV0
                  (loop [position: Int 0
                         accumulated: LoopInitsV0
                         (->LoopInitsV0 state [] [] [] false)]
                    (if (or (>= position (count items))
                            (state-blocked? (loopinitsv0-state accumulated))
                            (loopinitsv0-terminated accumulated))
                      accumulated
                      (let [item: core/NativeId (nth items position)
                            name: String (fact-text index item "name")
                            value-node: (U core/NativeId Nil)
                            (index-first-object index item "value")]
                        (if (nil? value-node)
                          (->LoopInitsV0
                            (state-fail (loopinitsv0-state accumulated)
                              (str "TODO-NATIVE-LOOP-INIT: accumulator " name
                                " has no init form"))
                            (loopinitsv0-names accumulated)
                            (loopinitsv0-values accumulated)
                            (loopinitsv0-value-types accumulated) false)
                          (let [value: ExprResultV0
                                (lower-expr env owner
                                  (loopinitsv0-state accumulated) value-node)]
                            (if (exprresultv0-terminated value)
                              (->LoopInitsV0 (exprresultv0-state value)
                                (loopinitsv0-names accumulated)
                                (loopinitsv0-values accumulated)
                                (loopinitsv0-value-types accumulated) true)
                              (recur (+ position 1)
                                (->LoopInitsV0
                                  ;; each init sees the ones before it, like `let`
                                  (state-bind (exprresultv0-state value) name
                                    (exprresultv0-value-id value)
                                    (exprresultv0-type-id value))
                                  (conj (loopinitsv0-names accumulated) name)
                                  (conj (loopinitsv0-values accumulated)
                                    (exprresultv0-value-id value))
                                  (conj (loopinitsv0-value-types accumulated)
                                    (exprresultv0-type-id value))
                                  false))))))))
                  base: BodyStateV0 (loopinitsv0-state inits)]
              (cond
                (loopinitsv0-terminated inits)
                (->ExprResultV0 base (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? base) (dead-result base)

                :else
                (let [header-id: core/NativeId (state-id base owner "loop-header")
                      parameters: (Vec core/Parameter)
                      (loop [position: Int 0 collected: (Vec core/Parameter) []]
                        (if (>= position (count (loopinitsv0-names inits)))
                          collected
                          (recur (+ position 1)
                            (conj collected
                              (core/->Parameter
                                (state-id base owner (str "loop-param-" position))
                                (nth (loopinitsv0-value-types inits) position))))))
                      entered: BodyStateV0
                      (state-open-block
                        (state-close (state-bump base)
                          (core/->JumpTerminator header-id
                            (loopinitsv0-values inits)))
                        header-id parameters)
                      bound: BodyStateV0
                      (loop [position: Int 0 current: BodyStateV0 entered]
                        (if (>= position (count parameters))
                          current
                          (recur (+ position 1)
                            (state-bind current
                              (nth (loopinitsv0-names inits) position)
                              (core/parameter-id (nth parameters position))
                              (core/parameter-type-id (nth parameters position))))))
                      body: ExprResultV0
                      (lower-expr env owner
                        (state-push-loop bound (->LoopFrameV0 header-id parameters))
                        body-node)]
                  ;; the loop's value is the join value of the body exiting
                  ;; without recur, in whatever block that exit left open
                  (->ExprResultV0
                    (with (with (exprresultv0-state body) [:locals outer-locals])
                      [:loop-frames outer-frames])
                    (exprresultv0-value-id body)
                    (exprresultv0-type-id body)
                    (exprresultv0-terminated body)))))))

        (= "recur" kind)
        (let [frame: (U LoopFrameV0 Nil) (current-loop state)]
          (if (nil? frame)
            (fail-result state
              "TODO-NATIVE-RECUR-OUTSIDE-LOOP: recur has no enclosing loop header")
            (let [args-node: (U core/NativeId Nil)
                  (index-first-object index expr "args")
                  args: (Vec core/NativeId)
                  (if (nil? args-node) [] (index-sequence-items index args-node))
                  parameters: (Vec core/Parameter) (loopframev0-parameters frame)
                  lowered: ArgsResultV0
                  (loop [position: Int 0
                         current: BodyStateV0 state
                         values: (Vec core/NativeId) []
                         value-types: (Vec core/NativeId) []]
                    (if (or (>= position (count args)) (state-blocked? current))
                      (->ArgsResultV0 current values value-types false)
                      (let [argument: ExprResultV0
                            (lower-expr env owner current (nth args position))]
                        (if (exprresultv0-terminated argument)
                          (->ArgsResultV0 (exprresultv0-state argument) values
                            value-types true)
                          (recur (+ position 1) (exprresultv0-state argument)
                            (conj values (exprresultv0-value-id argument))
                            (conj value-types (exprresultv0-type-id argument)))))))
                  current: BodyStateV0 (argsresultv0-state lowered)
                  values: (Vec core/NativeId) (argsresultv0-values lowered)
                  value-types: (Vec core/NativeId) (argsresultv0-value-types lowered)]
              (cond
                (argsresultv0-terminated lowered)
                (->ExprResultV0 current (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? current) (dead-result current)

                (not (= (count parameters) (count values)))
                (fail-result current
                  (str "TODO-NATIVE-RECUR-ARITY: recur passes "
                    (str (count values)) " arguments to a loop with "
                    (str (count parameters)) " accumulators"))

                (>= (recur-type-mismatch parameters value-types) 0)
                (fail-result current
                  (str "TODO-NATIVE-RECUR-TYPES: recur argument "
                    (str (recur-type-mismatch parameters value-types))
                    " is not the native type its accumulator's init fixed"))

                :else
                (let [copied: ArgsResultV0
                      (if (not (recur-aliases-header? parameters values))
                        (->ArgsResultV0 current values value-types false)
                        (loop [position: Int 0
                               accumulated: ArgsResultV0
                               (->ArgsResultV0 (state-bump current) []
                                 value-types false)]
                          (if (>= position (count values))
                            accumulated
                            (let [copy-id: core/NativeId
                                  (state-id current owner
                                    (str "recur-copy-" position))]
                              (recur (+ position 1)
                                (->ArgsResultV0
                                  (state-emit (argsresultv0-state accumulated)
                                    (core/->CopyInstruction
                                      (core/->SsaValueV0 copy-id
                                        (nth value-types position))
                                      (nth values position)))
                                  (conj (argsresultv0-values accumulated) copy-id)
                                  value-types false))))))]
                  (->ExprResultV0
                    (state-close (argsresultv0-state copied)
                      (core/->JumpTerminator (loopframev0-header-id frame)
                        (argsresultv0-values copied)))
                    (lower-id "body" ["recur"]) (type-id "LowerFailure") true))))))

        (= "vec" kind)
        (let [items-node: (U core/NativeId Nil) (index-first-object index expr "items")
              items: (Vec core/NativeId)
              (if (nil? items-node) [] (index-sequence-items index items-node))
              lowered: ArgsResultV0
              (loop [position: Int 0
                     current: BodyStateV0 state
                     values: (Vec core/NativeId) []
                     value-types: (Vec core/NativeId) []]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ArgsResultV0 current values value-types false)
                  (let [item: ExprResultV0
                        (lower-expr env owner current (nth items position))]
                    (if (exprresultv0-terminated item)
                      (->ArgsResultV0 (exprresultv0-state item) values value-types
                        true)
                      (recur (+ position 1) (exprresultv0-state item)
                        (conj values (exprresultv0-value-id item))
                        (conj value-types (exprresultv0-type-id item)))))))
              current: BodyStateV0 (argsresultv0-state lowered)
              values: (Vec core/NativeId) (argsresultv0-values lowered)
              value-types: (Vec core/NativeId) (argsresultv0-value-types lowered)]
          (cond
            (argsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count values))
            (fail-result current
              "TODO-NATIVE-EMPTY-VECTOR-LITERAL: an empty literal names no element type")

            :else
            (let [element: core/NativeId (nth value-types 0)
                  uniform: Bool
                  (loop [position: Int 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) element)
                      (recur (+ position 1))
                      :else false))
                  vector-type: (U core/NativeId Nil) (vector-type-of types element)]
              (cond
                (not uniform)
                (fail-result current
                  "TODO-NATIVE-VECTOR-LITERAL-ELEMENTS: the items do not share one native type")

                (nil? vector-type)
                (fail-result current
                  "TODO-NATIVE-VECTOR-LITERAL-TYPE: the module declares no vector of this element type")

                :else
                (let [capacity-id: core/NativeId (state-id current owner "vec-cap")
                      empty-id: core/NativeId
                      (state-id (state-bump current) owner "vec-lit")
                      seeded: BodyStateV0
                      (state-emit
                        (state-emit (state-bump (state-bump current))
                          (core/->AtomInstruction
                            (core/->SsaValueV0 capacity-id (int-type-id))
                            (core/->I64Atom (count values))))
                        (core/->VecEmptyInstruction
                          (core/->SsaValueV0 empty-id vector-type)
                          capacity-id (arena-value-id owner)))
                      filled: ExprResultV0
                      (loop [position: Int 0
                             built: BodyStateV0 seeded
                             holder: core/NativeId empty-id]
                        (if (>= position (count values))
                          (->ExprResultV0 built holder vector-type false)
                          (let [push-id: core/NativeId
                                (state-id built owner "vec-lit-push")]
                            (recur (+ position 1)
                              (state-emit (state-bump built)
                                (core/->VecPushInstruction
                                  (core/->SsaValueV0 push-id vector-type)
                                  holder (nth values position)
                                  (arena-value-id owner)))
                              push-id))))]
                  filled)))))

        (= "set" kind)
        (let [items-node: (U core/NativeId Nil) (index-first-object index expr "items")
              items: (Vec core/NativeId)
              (if (nil? items-node) [] (index-sequence-items index items-node))
              lowered: ArgsResultV0
              (loop [position: Int 0
                     current: BodyStateV0 state
                     values: (Vec core/NativeId) []
                     value-types: (Vec core/NativeId) []]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ArgsResultV0 current values value-types false)
                  (let [item: ExprResultV0
                        (lower-expr env owner current (nth items position))]
                    (if (exprresultv0-terminated item)
                      (->ArgsResultV0 (exprresultv0-state item) values value-types true)
                      (recur (+ position 1) (exprresultv0-state item)
                        (conj values (exprresultv0-value-id item))
                        (conj value-types (exprresultv0-type-id item)))))))
              current: BodyStateV0 (argsresultv0-state lowered)
              values: (Vec core/NativeId) (argsresultv0-values lowered)
              value-types: (Vec core/NativeId) (argsresultv0-value-types lowered)]
          (cond
            (argsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count values))
            (fail-result current
              "TODO-NATIVE-EMPTY-SET-LITERAL: an empty literal names no element type")

            :else
            (let [element-type: core/NativeId (nth value-types 0)
                  uniform: Bool
                  (loop [position: Int 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) element-type)
                      (recur (+ position 1))
                      :else false))
                  set-type: (U core/NativeId Nil) (set-type-of types element-type)
                  equality: (U core/ConcreteEqualityV0 Nil)
                  (concrete-equality-for element-type)]
              (cond
                (not uniform)
                (fail-result current
                  "TODO-NATIVE-SET-LITERAL-ELEMENTS: the items do not share one native type")

                (nil? set-type)
                (fail-result current
                  "TODO-NATIVE-SET-LITERAL-TYPE: the module declares no set of this element type")

                (nil? equality)
                (fail-result current
                  "TODO-NATIVE-SET-ELEMENT-EQUALITY: the element type has no closed concrete equality")

                :else
                (let [result-id: core/NativeId (state-id current owner "set-lit")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->SetLiteralInstructionV0
                        (core/->SsaValueV0 result-id set-type)
                        values (arena-value-id owner) equality))
                    result-id set-type false))))))

        (= "map" kind)
        (let [pairs-node: (U core/NativeId Nil) (index-first-object index expr "pairs")
              pairs: (Vec core/NativeId)
              (if (nil? pairs-node) [] (index-sequence-items index pairs-node))
              lowered: MapItemsResultV0
              (loop [position: Int 0
                     current: BodyStateV0 state
                     key-ids: (Vec core/NativeId) []
                     key-types: (Vec core/NativeId) []
                     value-ids: (Vec core/NativeId) []
                     value-types: (Vec core/NativeId) []]
                (if (or (>= position (count pairs)) (state-blocked? current))
                  (->MapItemsResultV0 current key-ids key-types value-ids value-types false)
                  (let [pair: core/NativeId (nth pairs position)
                        key-node: (U core/NativeId Nil) (index-first-object index pair "key")
                        value-node: (U core/NativeId Nil) (index-first-object index pair "value")]
                    (if (or (nil? key-node) (nil? value-node))
                      (->MapItemsResultV0
                        (state-fail current
                          "TODO-NATIVE-MAP-LITERAL-PAIR: every pair needs a key and value")
                        key-ids key-types value-ids value-types false)
                      (let [entry-left: ExprResultV0
                            (lower-expr env owner current key-node)]
                        (if (exprresultv0-terminated entry-left)
                          (->MapItemsResultV0 (exprresultv0-state entry-left)
                            key-ids key-types value-ids value-types true)
                          (let [lowered-value: ExprResultV0
                                (lower-expr env owner
                                  (exprresultv0-state entry-left) value-node)]
                            (if (exprresultv0-terminated lowered-value)
                              (->MapItemsResultV0 (exprresultv0-state lowered-value)
                                key-ids key-types value-ids value-types true)
                              (recur (+ position 1)
                                (exprresultv0-state lowered-value)
                                (conj key-ids (exprresultv0-value-id entry-left))
                                (conj key-types (exprresultv0-type-id entry-left))
                                (conj value-ids (exprresultv0-value-id lowered-value))
                                (conj value-types (exprresultv0-type-id lowered-value)))))))))))
              current: BodyStateV0 (mapitemsresultv0-state lowered)
              key-ids: (Vec core/NativeId) (mapitemsresultv0-key-ids lowered)
              key-types: (Vec core/NativeId) (mapitemsresultv0-key-types lowered)
              value-ids: (Vec core/NativeId) (mapitemsresultv0-value-ids lowered)
              value-types: (Vec core/NativeId) (mapitemsresultv0-value-types lowered)]
          (cond
            (mapitemsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count key-ids))
            (fail-result current
              "TODO-NATIVE-EMPTY-MAP-LITERAL: an empty literal names no key or value type")

            :else
            (let [key-type: core/NativeId (nth key-types 0)
                  value-type: core/NativeId (nth value-types 0)
                  uniform-keys: Bool
                  (loop [position: Int 1]
                    (cond
                      (>= position (count key-types)) true
                      (same-id? (nth key-types position) key-type) (recur (+ position 1))
                      :else false))
                  uniform-values: Bool
                  (loop [position: Int 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) value-type) (recur (+ position 1))
                      :else false))
                  map-type: (U core/NativeId Nil)
                  (map-type-of types key-type value-type)
                  equality: (U core/ConcreteEqualityV0 Nil)
                  (concrete-equality-for key-type)]
              (cond
                (or (not uniform-keys) (not uniform-values))
                (fail-result current
                  "TODO-NATIVE-MAP-LITERAL-ITEMS: keys and values must each share one native type")

                (nil? map-type)
                (fail-result current
                  "TODO-NATIVE-MAP-LITERAL-TYPE: the module declares no map of these key/value types")

                (nil? equality)
                (fail-result current
                  "TODO-NATIVE-MAP-KEY-EQUALITY: the key type has no closed concrete equality")

                :else
                (let [result-id: core/NativeId (state-id current owner "map-lit")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->MapLiteralInstructionV0
                        (core/->SsaValueV0 result-id map-type)
                        key-ids value-ids (arena-value-id owner) equality))
                    result-id map-type false))))))

        (= "kw-access" kind)
        (let [keyword: String (fact-text index expr "keyword")
              target-node: (U core/NativeId Nil)
              (index-first-object index expr "target")]
          (if (or (= "" keyword) (nil? target-node))
            (fail-result state
              "TODO-NATIVE-KEYWORD-ACCESS-SOURCE: keyword access needs a literal key and target")
            (let [target: ExprResultV0
                  (lower-expr env owner state target-node)
                  current: BodyStateV0 (exprresultv0-state target)
                  target-type: core/NativeId (exprresultv0-type-id target)
                  field: AccessorHitV0
                  (record-keyword-field types target-type keyword)]
              (cond
                (exprresultv0-terminated target) target

                (state-blocked? current) (dead-result current)

                (accessorhitv0-found field)
                (let [result-id: core/NativeId
                      (state-id current owner "keyword-field")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->FieldInstruction
                        (core/->SsaValueV0 result-id
                          (accessorhitv0-field-type field))
                        (exprresultv0-value-id target)
                        (accessorhitv0-field-id field)))
                    result-id (accessorhitv0-field-type field) false))

                (map-type? types target-type)
                (let [key-type: core/NativeId (map-key-of types target-type)
                      value-type: core/NativeId (map-value-of types target-type)
                      result-type: (U core/NativeId Nil)
                      (nullable-value-type-of types value-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for key-type)]
                  (cond
                    (not (same-id? key-type (keyword-type-id)))
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-KEY: keyword access needs a Keyword-keyed map")

                    (nil? result-type)
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-RESULT: keyword access needs the map's closed nullable value type")

                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-EQUALITY: keyword access needs closed Keyword equality")

                    :else
                    (let [key-id: core/NativeId
                          (state-id current owner "keyword-key")
                          keyed: BodyStateV0
                          (state-emit (state-bump current)
                            (core/->AtomInstruction
                              (core/->SsaValueV0 key-id (keyword-type-id))
                              (core/->KeywordAtom keyword)))
                          result-id: core/NativeId
                          (state-id keyed owner "keyword-get")]
                      (->ExprResultV0
                        (state-emit (state-bump keyed)
                          (core/->MapGetInstructionV0
                            (core/->SsaValueV0 result-id result-type)
                            (exprresultv0-value-id target) key-id nil equality))
                        result-id result-type false))))

                :else
                (fail-result current
                  "TODO-NATIVE-KEYWORD-ACCESS-TARGET: keyword access needs a closed map or known record field")))))

        (or (= "call" kind)
          (and (= "static-call" kind)
            (or (host-environment-callee? (fact-text index expr "callee"))
                (host-socket-callee? (fact-text index expr "callee")))))
        (let [callee: String (fact-text index expr "callee")
              callee-form: (U core/NativeId Nil)
              (index-first-object index expr "callee-form")
              args-node: (U core/NativeId Nil) (index-first-object index expr "args")
              args: (Vec core/NativeId)
              (if (nil? args-node) [] (index-sequence-items index args-node))]
          (cond
            (and (= "" callee) (some? callee-form))
            (fail-result state
              "TODO-NATIVE-INDIRECT-CALL: v0 has no closure or function-pointer ABI")

            (and (= "apply" callee)
              (not (and (= 2 (count args))
                (source-ref-named? index (nth args 0) "str")
                (source-call-named? index (nth args 1) "repeat"))))
            (fail-result state
              "TODO-NATIVE-APPLY: no frozen Fram function requires dynamic argument spreading")

            (= "reduce" callee)
            (if (not (= 3 (count args)))
              (fail-result state
                "TODO-NATIVE-REDUCE-ARITY: reduce lowers only as (reduce fn init vector)")
              (let [callback-node: core/NativeId (nth args 0)
                    callback-kind: String
                    (fact-text index callback-node "form-kind")
                    callback-rest: String (fact-text index callback-node "rest")
                    callback-body: (U core/NativeId Nil)
                    (index-first-object index callback-node "body")
                    callback-return-source: (U core/NativeId Nil)
                    (index-first-object index callback-node "ret")
                    callback-source-parameters: (Vec core/NativeId)
                    (function-parameter-items index callback-node)
                    callback-owner: core/NativeId
                    (state-id state owner "reduce-callback")
                    callback-resolution: ParameterResolutionV0
                    (resolve-parameters index callback-node callback-owner)
                    callback-parameters: (Vec core/Parameter)
                    (parameterresolutionv0-parameters callback-resolution)
                    callback-names: (Vec String)
                    (mapv
                      (fn [parameter: core/NativeId] -> String
                        (parameter-name-at index parameter))
                      callback-source-parameters)
                    captures: (Vec String)
                    (if (nil? callback-body)
                      []
                      (source-free-ref-names index callback-body callback-names
                        (+ 1 (index-facts index))))]
                (cond
                  (not (= "fn" callback-kind))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK: v0 requires an anonymous function literal")

                  (not (= "false" callback-rest))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-VARIADIC: reduce callbacks must have fixed arity")

                  (or (not (= 2 (count callback-source-parameters)))
                      (not (= 2 (count callback-parameters))))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-ARITY: reduce callbacks take accumulator and element")

                  (not (parameterresolutionv0-valid callback-resolution))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-TYPES: both callback parameters need closed native types")

                  (nil? callback-body)
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-BODY: callback needs exactly one body form")

                  (nil? callback-return-source)
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-RETURN: callback needs a closed return annotation")

                  (> (count captures) 0)
                  (fail-result state
                    (str "TODO-NATIVE-FN-CAPTURE: reduce callback captures "
                      (nth captures 0) " instead of receiving it as a parameter"))

                  :else
                  (let [callback-return: TypeResolutionV0
                        (resolve-source-type index callback-return-source)
                        accumulator-type: core/NativeId
                        (core/parameter-type-id (nth callback-parameters 0))
                        element-type: core/NativeId
                        (core/parameter-type-id (nth callback-parameters 1))]
                    (if (not (typeresolutionv0-valid callback-return))
                      (fail-result state
                        "TODO-NATIVE-REDUCE-CALLBACK-RETURN: callback return is not a closed native type")
                      (if (not (same-id? accumulator-type
                                 (typeresolutionv0-type-id callback-return)))
                        (fail-result state
                          "TODO-NATIVE-REDUCE-ACCUMULATOR: callback return must match its accumulator parameter")
                        (let [initial: ExprResultV0
                              (lower-expr env owner state (nth args 1))]
                          (cond
                            (exprresultv0-terminated initial) initial
                            (state-blocked? (exprresultv0-state initial))
                            (dead-result (exprresultv0-state initial))
                            :else
                            (let [collection: ExprResultV0
                                  (lower-expr env owner
                                    (exprresultv0-state initial) (nth args 2))
                                  collection-state: BodyStateV0
                                  (exprresultv0-state collection)]
                              (cond
                                (exprresultv0-terminated collection) collection
                                (state-blocked? collection-state)
                                (dead-result collection-state)
                                (not (same-id? accumulator-type
                                       (exprresultv0-type-id initial)))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-INIT: initial value must match the callback accumulator")
                                (not (vector-type? types
                                       (exprresultv0-type-id collection)))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-COLLECTION: v0 reduces a native vector")
                                (not (same-id? element-type
                                       (vector-element-of types
                                         (exprresultv0-type-id collection))))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-ELEMENT: vector element must match the callback element parameter")
                                :else
                                (let [outer-locals: (Vec LocalBindingV0)
                                      (bodystatev0-locals collection-state)
                                      outer-frames: (Vec LoopFrameV0)
                                      (bodystatev0-loop-frames collection-state)
                                      length-id: core/NativeId
                                      (state-id collection-state owner "reduce-length")
                                      zero-id: core/NativeId
                                      (state-id collection-state owner "reduce-zero")
                                      header-id: core/NativeId
                                      (state-id collection-state owner "reduce-header")
                                      body-id: core/NativeId
                                      (state-id collection-state owner "reduce-body")
                                      exit-id: core/NativeId
                                      (state-id collection-state owner "reduce-exit")
                                      header-index: core/NativeId
                                      (state-id collection-state owner "reduce-index")
                                      header-accumulator: core/NativeId
                                      (state-id collection-state owner
                                        "reduce-accumulator")
                                      prepared: BodyStateV0
                                      (state-emit
                                        (state-emit (state-bump collection-state)
                                          (core/->VecLengthInstruction
                                            (core/->SsaValueV0 length-id
                                              (int-type-id))
                                            (exprresultv0-value-id collection)))
                                        (core/->AtomInstruction
                                          (core/->SsaValueV0 zero-id
                                            (int-type-id))
                                          (core/->I64Atom 0)))
                                      entered: BodyStateV0
                                      (state-open-block
                                        (state-close (state-bump prepared)
                                          (core/->JumpTerminator header-id
                                            [zero-id
                                             (exprresultv0-value-id initial)]))
                                        header-id
                                        [(core/->Parameter header-index
                                           (int-type-id))
                                         (core/->Parameter header-accumulator
                                           accumulator-type)])
                                      has-item: core/NativeId
                                      (state-id entered owner "reduce-has-item")
                                      compared: BodyStateV0
                                      (state-emit (state-bump entered)
                                        (core/->CompareInstruction
                                          (core/->SsaValueV0 has-item
                                            (bool-type-id))
                                          (core/->CompareLtI64V0 true)
                                          header-index length-id))
                                      branched: BodyStateV0
                                      (state-open-block
                                        (state-close compared
                                          (core/->BranchTerminator has-item
                                            body-id exit-id))
                                        body-id [])
                                      item-id: core/NativeId
                                      (state-id branched owner "reduce-item")
                                      isolated: BodyStateV0
                                      (with
                                        (with
                                          (state-emit (state-bump branched)
                                            (core/->VecGetInstruction
                                              (core/->SsaValueV0 item-id
                                                element-type)
                                              (exprresultv0-value-id collection)
                                              header-index))
                                          [:locals []])
                                        [:loop-frames []])
                                      callback-state: BodyStateV0
                                      (state-bind
                                        (state-bind isolated
                                          (nth callback-names 0)
                                          header-accumulator accumulator-type)
                                        (nth callback-names 1) item-id element-type)
                                      callback-result: ExprResultV0
                                      (lower-expr env owner callback-state
                                        callback-body)
                                      restored: BodyStateV0
                                      (with
                                        (with (exprresultv0-state callback-result)
                                          [:locals outer-locals])
                                        [:loop-frames outer-frames])]
                                  (cond
                                    (state-blocked? restored) (dead-result restored)
                                    (exprresultv0-terminated callback-result)
                                    (fail-result restored
                                      "TODO-NATIVE-REDUCE-CALLBACK-DIVERGES: callback does not produce the next accumulator")
                                    (not (same-id? accumulator-type
                                           (exprresultv0-type-id callback-result)))
                                    (fail-result restored
                                      "TODO-NATIVE-REDUCE-CALLBACK-RESULT: callback body does not produce its declared accumulator type")
                                    :else
                                    (let [one-id: core/NativeId
                                          (state-id restored owner "reduce-one")
                                          with-one: BodyStateV0
                                          (state-emit (state-bump restored)
                                            (core/->AtomInstruction
                                              (core/->SsaValueV0 one-id
                                                (int-type-id))
                                              (core/->I64Atom 1)))
                                          next-index: ExprResultV0
                                          (lower-checked-arith with-one owner "+"
                                            header-index one-id)
                                          next-state: BodyStateV0
                                          (exprresultv0-state next-index)]
                                      (if (state-blocked? next-state)
                                        (dead-result next-state)
                                        (->ExprResultV0
                                          (state-open-block
                                            (state-close next-state
                                              (core/->JumpTerminator header-id
                                                [(exprresultv0-value-id next-index)
                                                 (exprresultv0-value-id
                                                   callback-result)]))
                                            exit-id [])
                                          header-accumulator accumulator-type
                                          false)))))))))))))))

            (and (= "map" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str"))
            (let [source: ExprResultV0
                  (lower-expr env owner state (nth args 1))]
              (if (or (exprresultv0-terminated source)
                      (state-blocked? (exprresultv0-state source)))
                source
                (if (text-vector-value? types (exprresultv0-type-id source))
                  source
                  (fail-result (exprresultv0-state source)
                    "TODO-NATIVE-TEXT-MAP-OPERAND: map str needs a vector of Text"))))

            (and (= "map" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str/trim"))
            (let [source: ExprResultV0
                  (lower-expr env owner state (nth args 1))]
              (cond
                (exprresultv0-terminated source) source
                (state-blocked? (exprresultv0-state source))
                (dead-result (exprresultv0-state source))
                (not (text-vector-value? types (exprresultv0-type-id source)))
                (fail-result (exprresultv0-state source)
                  "TODO-NATIVE-TEXT-MAP-OPERAND: map str/trim needs a vector of Text")
                :else
                (let [base: BodyStateV0 (exprresultv0-state source)
                      result-id: core/NativeId
                      (state-id base owner "text-vector-trim")]
                  (->ExprResultV0
                    (state-emit (state-bump base)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id
                          (exprresultv0-type-id source))
                        (core/->TextVectorTrimV0 (arena-value-id owner)
                          (exprresultv0-value-id source))))
                    result-id (exprresultv0-type-id source) false))))

            (and (= "remove" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str/blank?"))
            (let [source: ExprResultV0
                  (lower-expr env owner state (nth args 1))]
              (cond
                (exprresultv0-terminated source) source
                (state-blocked? (exprresultv0-state source))
                (dead-result (exprresultv0-state source))
                (not (text-vector-value? types (exprresultv0-type-id source)))
                (fail-result (exprresultv0-state source)
                  "TODO-NATIVE-TEXT-REMOVE-OPERAND: remove str/blank? needs a vector of Text")
                :else
                (let [base: BodyStateV0 (exprresultv0-state source)
                      result-id: core/NativeId
                      (state-id base owner "text-vector-nonblank")]
                  (->ExprResultV0
                    (state-emit (state-bump base)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id
                          (exprresultv0-type-id source))
                        (core/->TextVectorRemoveBlankV0 (arena-value-id owner)
                          (exprresultv0-value-id source))))
                    result-id (exprresultv0-type-id source) false))))

            (and (= "apply" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str")
              (source-call-named? index (nth args 1) "repeat"))
            (let [repeat-args: (Vec core/NativeId)
                  (source-call-arguments index (nth args 1))]
              (if (not (= 2 (count repeat-args)))
                (fail-result state
                  "TODO-NATIVE-TEXT-REPEAT-ARITY: repeat needs a count and Text")
                (let [count-value: ExprResultV0
                      (lower-expr env owner state (nth repeat-args 0))
                      source: ExprResultV0
                      (if (or (exprresultv0-terminated count-value)
                              (state-blocked? (exprresultv0-state count-value)))
                        count-value
                        (lower-expr env owner
                          (exprresultv0-state count-value)
                          (nth repeat-args 1)))]
                  (cond
                    (exprresultv0-terminated source) source
                    (state-blocked? (exprresultv0-state source))
                    (dead-result (exprresultv0-state source))
                    (not (and (same-id? (exprresultv0-type-id count-value)
                                (int-type-id))
                           (text-operand? (exprresultv0-type-id source))))
                    (fail-result (exprresultv0-state source)
                      "TODO-NATIVE-TEXT-REPEAT-OPERANDS: repeat needs Int and Text")
                    :else
                    (let [base: BodyStateV0 (exprresultv0-state source)
                          result-id: core/NativeId
                          (state-id base owner "text-repeat")]
                      (->ExprResultV0
                        (state-emit (state-bump base)
                          (core/->TextBuiltinInstruction
                            (core/->SsaValueV0 result-id (text-type-id))
                            (core/->TextRepeatV0 (arena-value-id owner)
                              (exprresultv0-value-id source)
                              (exprresultv0-value-id count-value))))
                        result-id (text-type-id) false))))))

            (= "throw" callee)
            (let [code-id: core/NativeId (state-id state owner "trap")
                  emitted: BodyStateV0
                  (state-emit (state-bump state)
                    (core/->AtomInstruction
                      (core/->SsaValueV0 code-id (int-type-id))
                      (core/->I64Atom (trap-failure-code))))]
              (->ExprResultV0
                (state-close emitted (core/->TrapTerminator code-id))
                code-id (type-id "LowerFailure") true))

            (or (= "and" callee) (= "or" callee))
            (let [arity: Int (count args)]
              (if (= 0 arity)
                (let [result-id: core/NativeId (state-id state owner "logic-empty")]
                  (->ExprResultV0
                    (state-emit (state-bump state)
                      (core/->AtomInstruction
                        (core/->SsaValueV0 result-id (bool-type-id))
                        (core/->BoolAtom (= "and" callee))))
                    result-id (bool-type-id) false))
                (if (= 1 arity)
                  (let [only: ExprResultV0
                        (lower-expr env owner state (nth args 0))]
                    (cond
                      (exprresultv0-terminated only) only
                      (state-blocked? (exprresultv0-state only))
                      (dead-result (exprresultv0-state only))
                      (not (same-id? (exprresultv0-type-id only) (bool-type-id)))
                      (fail-result (exprresultv0-state only)
                        (str "TODO-NATIVE-BOOL-OPERAND: " callee
                          " needs native Bool operands"))
                      :else only))
                  (let [shortcut-id: core/NativeId
                        (state-id state owner "logic-shortcut")
                        join-id: core/NativeId (state-id state owner "logic-join")
                        join-parameter: core/NativeId
                        (state-id state owner "logic-value")
                        short-value: core/NativeId
                        (state-id state owner "logic-const")]
                    (loop [position: Int 0
                           current: BodyStateV0 (state-bump state)]
                      (let [operand: ExprResultV0
                            (lower-expr env owner current (nth args position))]
                        (cond
                          (state-blocked? (exprresultv0-state operand))
                          (dead-result (exprresultv0-state operand))
                          (exprresultv0-terminated operand)
                          (if (= 0 position)
                            operand
                            (fail-result (exprresultv0-state operand)
                              (str "TODO-NATIVE-DIVERGENT-OPERAND: " callee
                                " operand " (+ position 1)
                                " does not produce a value")))
                          (not (same-id? (exprresultv0-type-id operand) (bool-type-id)))
                          (fail-result (exprresultv0-state operand)
                            (str "TODO-NATIVE-BOOL-OPERAND: " callee
                              " needs native Bool operands"))
                          (= (+ position 1) arity)
                          (let [after-value: BodyStateV0
                                (state-close (state-bump (exprresultv0-state operand))
                                  (core/->JumpTerminator join-id
                                    [(exprresultv0-value-id operand)]))
                                shortcut: BodyStateV0
                                (state-emit
                                  (state-open-block after-value shortcut-id [])
                                  (core/->AtomInstruction
                                    (core/->SsaValueV0 short-value (bool-type-id))
                                    (core/->BoolAtom (= "or" callee))))
                                after-shortcut: BodyStateV0
                                (state-close (state-bump shortcut)
                                  (core/->JumpTerminator join-id [short-value]))]
                            (->ExprResultV0
                              (state-open-block after-shortcut join-id
                                [(core/->Parameter join-parameter (bool-type-id))])
                              join-parameter (bool-type-id) false))
                          :else
                          (let [next-id: core/NativeId
                                (state-id (exprresultv0-state operand) owner
                                  (str "logic-rest-" position))
                                branched: BodyStateV0
                                (state-close (state-bump (exprresultv0-state operand))
                                  (if (= "and" callee)
                                    (core/->BranchTerminator
                                      (exprresultv0-value-id operand)
                                      next-id shortcut-id)
                                    (core/->BranchTerminator
                                      (exprresultv0-value-id operand)
                                      shortcut-id next-id)))]
                            (recur (+ position 1)
                              (state-open-block branched next-id []))))))))))

            (= "not" callee)
            (if (not (= 1 (count args)))
              (fail-result state "TODO-NATIVE-NOT-ARITY: not takes one operand")
              (let [raw-operand: ExprResultV0
                    (lower-expr env owner state (nth args 0))
                    operand: ExprResultV0
                    (if (or (exprresultv0-terminated raw-operand)
                            (state-blocked? (exprresultv0-state raw-operand)))
                      raw-operand
                      (lower-truthy types owner
                        (exprresultv0-state raw-operand)
                        (exprresultv0-value-id raw-operand)
                        (exprresultv0-type-id raw-operand)))]
                (cond
                  (exprresultv0-terminated operand) operand
                  (state-blocked? (exprresultv0-state operand))
                  (dead-result (exprresultv0-state operand))
                  (not (same-id? (exprresultv0-type-id operand) (bool-type-id)))
                  (fail-result (exprresultv0-state operand)
                    "TODO-NATIVE-BOOL-OPERAND: not needs a native Bool operand")
                  :else
                  (let [base: BodyStateV0 (exprresultv0-state operand)
                        false-id: core/NativeId (state-id base owner "not-const")
                        result-id: core/NativeId (state-id base owner "not")]
                    (->ExprResultV0
                      (state-emit
                        (state-emit (state-bump base)
                          (core/->AtomInstruction
                            (core/->SsaValueV0 false-id (bool-type-id))
                            (core/->BoolAtom false)))
                        (core/->CompareInstruction
                          (core/->SsaValueV0 result-id (bool-type-id))
                          (core/->CompareEqBoolV0 true)
                          (exprresultv0-value-id operand) false-id))
                      result-id (bool-type-id) false)))))

            (= "instance?" callee)
            (if (not (= 2 (count args)))
              (fail-result state
                "TODO-NATIVE-INSTANCE-ARITY: instance? takes a type and a value")
              (let [record-name: String (fact-text index (nth args 0) "name")
                    value: ExprResultV0 (lower-expr env owner state (nth args 1))]
                (cond
                  (exprresultv0-terminated value) value
                  (state-blocked? (exprresultv0-state value))
                  (dead-result (exprresultv0-state value))
                  :else
                  (let [variants: (Vec core/TypeVariant)
                        (union-variants-of types (exprresultv0-type-id value))
                        target: (U core/TypeVariant Nil)
                        (variant-named variants record-name)]
                    (if (or (= 0 (count variants)) (nil? target))
                      (fail-result (exprresultv0-state value)
                        (str "TODO-NATIVE-INSTANCE-TEST: " record-name
                          " is not an alternative of the tested closed union"))
                      (let [base: BodyStateV0 (exprresultv0-state value)
                            true-id: core/NativeId (state-id base owner "is")
                            false-id: core/NativeId (state-id base owner "is-not")
                            join-id: core/NativeId (state-id base owner "is-join")
                            join-parameter: core/NativeId
                            (state-id base owner "is-value")
                            true-value: core/NativeId (state-id base owner "is-true")
                            false-value: core/NativeId (state-id base owner "is-false")
                            cases: (Vec core/SwitchCaseV0)
                            (mapv
                              (fn [variant: core/TypeVariant] -> core/SwitchCaseV0
                                (core/->SwitchCaseV0 (core/typevariant-id variant)
                                  (if (= record-name (core/typevariant-name variant))
                                    true-id false-id)
                                  []))
                              variants)
                            switched: BodyStateV0
                            (state-close (state-bump base)
                              (core/->SwitchTerminator
                                (exprresultv0-value-id value) cases))
                            true-block: BodyStateV0
                            (state-close
                              (state-emit (state-open-block switched true-id [])
                                (core/->AtomInstruction
                                  (core/->SsaValueV0 true-value (bool-type-id))
                                  (core/->BoolAtom true)))
                              (core/->JumpTerminator join-id [true-value]))
                            false-block: BodyStateV0
                            (state-close
                              (state-emit (state-open-block true-block false-id [])
                                (core/->AtomInstruction
                                  (core/->SsaValueV0 false-value (bool-type-id))
                                  (core/->BoolAtom false)))
                              (core/->JumpTerminator join-id [false-value]))]
                        (->ExprResultV0
                          (state-open-block false-block join-id
                            [(core/->Parameter join-parameter (bool-type-id))])
                          join-parameter (bool-type-id) false)))))))

            (= "swap!" (unqualified-name callee))
            (if (< (count args) 2)
              (fail-result state
                "TODO-NATIVE-ATOM-SWAP-ARITY: swap! takes an Atom, a named updater, and optional updater arguments")
              (let [cell: ExprResultV0
                    (lower-expr env owner state (nth args 0))
                    cell-state: BodyStateV0 (exprresultv0-state cell)]
                (cond
                  (exprresultv0-terminated cell) cell
                  (state-blocked? cell-state) (dead-result cell-state)
                  (not (= "ref" (fact-text index (nth args 1) "form-kind")))
                  (fail-result cell-state
                    "TODO-NATIVE-ATOM-SWAP-UPDATER: swap! requires a statically named pure native updater")
                  :else
                  (let [updater-name: String
                        (fact-text index (nth args 1) "name")
                        signature: (U TypedFunctionV0 Nil)
                        (find-signature env owner updater-name)
                        content: (U core/NativeId Nil)
                        (atom-cell-content-of types (exprresultv0-type-id cell))]
                    (cond
                      (nil? content)
                      (fail-result cell-state
                        "TODO-NATIVE-ATOM-SWAP-CELL: swap! first operand is not an Atom")
                      (nil? signature)
                      (fail-result cell-state
                        (str "TODO-NATIVE-ATOM-SWAP-UPDATER: " updater-name
                          " is not a statically sealed native function"))
                      (not (pure-updater-signature? signature content
                             (- (count args) 2)))
                      (fail-result cell-state
                        (str "TODO-NATIVE-ATOM-SWAP-UPDATER: " updater-name
                          " must be pure, take the Atom value first, and return that same type"))
                      :else
                      (let [lowered: ArgsResultV0
                            (loop [position: Int 2
                                   current: BodyStateV0 cell-state
                                   values: (Vec core/NativeId) []
                                   value-types: (Vec core/NativeId) []]
                              (if (or (>= position (count args))
                                    (state-blocked? current))
                                (->ArgsResultV0 current values value-types false)
                                (let [argument: ExprResultV0
                                      (lower-expr env owner current
                                        (nth args position))]
                                  (if (exprresultv0-terminated argument)
                                    (->ArgsResultV0
                                      (exprresultv0-state argument)
                                      values value-types true)
                                    (recur (+ position 1)
                                      (exprresultv0-state argument)
                                      (conj values
                                        (exprresultv0-value-id argument))
                                      (conj value-types
                                        (exprresultv0-type-id argument)))))))
                            current: BodyStateV0 (argsresultv0-state lowered)]
                        (cond
                          (argsresultv0-terminated lowered)
                          (->ExprResultV0 current
                            (lower-id "body" ["unreachable"])
                            (type-id "LowerFailure") true)
                          (state-blocked? current) (dead-result current)
                          :else
                          (let [coerced: ArgsResultV0
                                (coerce-arguments types owner current
                                  (argsresultv0-values lowered)
                                  (argsresultv0-value-types lowered)
                                  (tail-parameters
                                    (typedfunctionv0-parameters signature)))
                                settled: BodyStateV0
                                (argsresultv0-state coerced)
                                result-id: core/NativeId
                                (state-id settled owner "atom-swap")]
                            (if (state-blocked? settled)
                              (fail-result settled
                                "TODO-NATIVE-ATOM-SWAP-ARGUMENTS: updater arguments do not match its native parameters")
                              (->ExprResultV0
                                (state-emit (state-bump settled)
                                  (core/->AtomSwapInstruction
                                    (core/->SsaValueV0 result-id content)
                                    (exprresultv0-value-id cell)
                                    (atom-state-value-id owner)
                                    (typedfunctionv0-id signature)
                                    (argsresultv0-values coerced)))
                                result-id content false))))))))))

            :else
            (let [lowered: ArgsResultV0
                  (loop [position: Int 0
                         current: BodyStateV0 state
                         values: (Vec core/NativeId) []
                         value-types: (Vec core/NativeId) []]
                    (if (or (>= position (count args)) (state-blocked? current))
                      (->ArgsResultV0 current values value-types false)
                      (let [node: core/NativeId (nth args position)
                            expected: (U core/NativeId Nil)
                            (expected-collection-argument-type
                              types callee position value-types)
                            empty-aggregate: Bool
                            (or (empty-vector-form? index node)
                              (empty-map-form? index node)
                              (empty-set-form? index node))
                            argument: ExprResultV0
                            (if (and (some? expected) empty-aggregate)
                              (lower-contextual-empty-aggregate
                                env owner current node expected)
                              (lower-expr env owner current node))]
                        (if (exprresultv0-terminated argument)
                          (->ArgsResultV0 (exprresultv0-state argument) values
                            value-types true)
                          (recur (+ position 1) (exprresultv0-state argument)
                            (conj values (exprresultv0-value-id argument))
                            (conj value-types (exprresultv0-type-id argument)))))))
                  current: BodyStateV0 (argsresultv0-state lowered)
                  values: (Vec core/NativeId) (argsresultv0-values lowered)
                  value-types: (Vec core/NativeId) (argsresultv0-value-types lowered)
                  comparison: (U core/CompareOpV0 Nil) (compare-op-for callee)
                  callee-visible: Bool
                  (resolvedsourcenamev0-visible
                    (resolve-source-name index (body-owner-module env owner) callee))
                  accessor: AccessorHitV0
                  (if callee-visible
                    (record-accessor types callee)
                    (accessor-miss))
                  bare-callee: String (unqualified-name callee)
                  constructor: (U core/TypeDef Nil)
                  (if (and callee-visible (> (count bare-callee) 2)
                           (= "->" (subs bare-callee 0 2)))
                    (lookup-named-type types
                      (subs bare-callee 2 (count bare-callee)))
                    nil)
                  signature: (U TypedFunctionV0 Nil)
                  (find-signature env owner callee)
                  static-predicate: (U Bool Nil)
                  (if (= 1 (count values))
                    (static-type-predicate-value types callee
                      (nth value-types 0))
                    nil)]
              (cond
                (argsresultv0-terminated lowered)
                (->ExprResultV0 current (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? current) (dead-result current)

                (some? static-predicate)
                (bool-constant-result current owner "static-predicate"
                  static-predicate)

                (and (static-collection-predicate? callee)
                  (= 1 (count values)))
                (fail-result current
                  (str "TODO-NATIVE-PREDICATE-TYPE: " callee
                    " needs a known exact native type"))

                (static-collection-predicate? callee)
                (fail-result current
                  (str "TODO-NATIVE-PREDICATE-ARITY: " callee
                    " takes one operand"))

                (and (= "compare" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-compare")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (int-type-id))
                        (core/->TextCompareV0
                          (nth values 0) (nth values 1))))
                    result-id (int-type-id) false))

                (= "compare" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-COMPARE-OPERANDS: compare takes two native Text operands")

                (and (= "str/trim" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-trim")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (text-type-id))
                        (core/->TextTrimV0 (arena-value-id owner)
                          (nth values 0))))
                    result-id (text-type-id) false))

                (= "str/trim" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-TRIM-OPERAND: str/trim takes one native Text operand")

                (and (= "str/lower-case" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-lower")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (text-type-id))
                        (core/->TextLowerV0 (arena-value-id owner)
                          (nth values 0))))
                    result-id (text-type-id) false))

                (= "str/lower-case" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-LOWER-OPERAND: str/lower-case takes one native Text operand")

                (and (= "str/replace" callee) (= 3 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1))
                  (text-operand? (nth value-types 2)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-regex-replace")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (text-type-id))
                        (core/->TextRegexReplaceV0 (arena-value-id owner)
                          (nth values 0) (nth values 1) (nth values 2))))
                    result-id (text-type-id) false))

                (= "str/replace" callee)
                (fail-result current
                  "TODO-NATIVE-REGEX-REPLACE-OPERANDS: str/replace takes Text, Regex, Text")

                (and (= "re-matches" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-regex-matches")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (bool-type-id))
                        ;; re-matches spells pattern before source.
                        (core/->TextRegexMatchesV0
                          (nth values 1) (nth values 0))))
                    result-id (bool-type-id) false))

                (= "re-matches" callee)
                (fail-result current
                  "TODO-NATIVE-REGEX-MATCHES-OPERANDS: re-matches takes Regex and Text")

                (and (= "re-find" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-regex-find")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (regex-match-type-id))
                        (core/->TextRegexFindV0 (arena-value-id owner)
                          (nth values 1) (nth values 0))))
                    result-id (regex-match-type-id) false))

                (= "re-find" callee)
                (fail-result current
                  "TODO-NATIVE-REGEX-FIND-OPERANDS: re-find takes Regex and Text")

                (and (= "str/split" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (let [vector-type: (U core/NativeId Nil)
                      (text-vector-type-of types)]
                  (if (nil? vector-type)
                    (fail-result current
                      "TODO-NATIVE-TEXT-SPLIT-TYPE: str/split needs a declared Vec Text")
                    (let [result-id: core/NativeId
                          (state-id current owner "text-split")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->TextBuiltinInstruction
                            (core/->SsaValueV0 result-id vector-type)
                            (core/->TextSplitV0 (arena-value-id owner)
                              (nth values 0) (nth values 1))))
                        result-id vector-type false))))

                (= "str/split" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-SPLIT-OPERANDS: str/split takes Text and Regex")

                (and (= "str/join" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-vector-value? types (nth value-types 1)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-join")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (text-type-id))
                        (core/->TextJoinV0 (arena-value-id owner)
                          (nth values 0) (nth values 1))))
                    result-id (text-type-id) false))

                (= "str/join" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-JOIN-OPERANDS: str/join takes Text and Vec Text")

                (and (or (= "boolean" callee) (= "long" callee))
                  (= 1 (count values))
                  (or (and (= "boolean" callee)
                        (same-id? (nth value-types 0) (bool-type-id)))
                      (and (= "long" callee)
                        (same-id? (nth value-types 0) (int-type-id)))))
                (->ExprResultV0 current (nth values 0) (nth value-types 0) false)

                (and (= "max" callee) (= 2 (count values))
                  (same-id? (nth value-types 0) (int-type-id))
                  (same-id? (nth value-types 1) (int-type-id)))
                (let [compare-id: core/NativeId
                      (state-id current owner "max-compare")
                      left-id: core/NativeId
                      (state-id (state-bump current) owner "max-left")
                      right-id: core/NativeId
                      (state-id (state-bump (state-bump current)) owner "max-right")
                      join-id: core/NativeId
                      (state-id (state-bump (state-bump (state-bump current)))
                        owner "max-join")
                      join-value: core/NativeId
                      (state-id
                        (state-bump (state-bump (state-bump (state-bump current))))
                        owner "max-value")
                      compared: BodyStateV0
                      (state-emit
                        (state-bump (state-bump (state-bump
                          (state-bump (state-bump current)))))
                        (core/->CompareInstruction
                          (core/->SsaValueV0 compare-id (bool-type-id))
                          (core/->CompareLeI64V0 true)
                          (nth values 0) (nth values 1)))
                      branched: BodyStateV0
                      (state-close compared
                        (core/->BranchTerminator compare-id right-id left-id))
                      left: BodyStateV0
                      (state-close (state-open-block branched left-id [])
                        (core/->JumpTerminator join-id [(nth values 0)]))
                      right: BodyStateV0
                      (state-close (state-open-block left right-id [])
                        (core/->JumpTerminator join-id [(nth values 1)]))]
                  (->ExprResultV0
                    (state-open-block right join-id
                      [(core/->Parameter join-value (int-type-id))])
                    join-value (int-type-id) false))

                (and (= "atom" bare-callee) (= 1 (count values)))
                (let [cell-type: (U core/NativeId Nil)
                      (atom-cell-type-of types (nth value-types 0))]
                  (if (nil? cell-type)
                    (fail-result current
                      "TODO-NATIVE-ATOM-TYPE: atom needs a closed (Atom T) annotation for its initial value type")
                    (let [result-id: core/NativeId
                          (state-id current owner "atom-create")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->AtomCreateInstruction
                            (core/->SsaValueV0 result-id cell-type)
                            (nth values 0)
                            (arena-value-id owner)
                            (atom-state-value-id owner)))
                        result-id cell-type false))))

                (= "atom" bare-callee)
                (fail-result current
                  "TODO-NATIVE-ATOM-ARITY: atom takes exactly one initial value")

                (and (= "deref" bare-callee) (= 1 (count values)))
                (let [content: (U core/NativeId Nil)
                      (atom-cell-content-of types (nth value-types 0))]
                  (if (nil? content)
                    (fail-result current
                      "TODO-NATIVE-ATOM-DEREF-CELL: deref operand is not an Atom")
                    (let [result-id: core/NativeId
                          (state-id current owner "atom-deref")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->AtomDerefInstruction
                            (core/->SsaValueV0 result-id content)
                            (nth values 0)
                            (atom-state-value-id owner)))
                        result-id content false))))

                (= "deref" bare-callee)
                (fail-result current
                  "TODO-NATIVE-ATOM-DEREF-ARITY: deref takes exactly one Atom")

                (= "reset!" bare-callee)
                (fail-result current
                  "TODO-NATIVE-ATOM-RESET-REFUSED: reset! is outside the measured Atom seam; use a statically named swap! updater")

                (refused-arith-op? callee)
                (fail-result current
                  (str "TODO-NATIVE-DIVISION-" callee
                    ": integer division semantics on a zero divisor is an open"
                    " design decision, so v0 refuses it by name"))

                (checked-arith-op? callee)
                (cond
                  (not (= 2 (count values)))
                  (fail-result current
                    (str "TODO-NATIVE-ARITH-ARITY: " callee
                      " lowers only in its two-operand form"))

                  :else
                  (let [coerced: ArgsResultV0
                        (coerce-values-to-type types owner current values
                          value-types (int-type-id))
                        settled: BodyStateV0 (argsresultv0-state coerced)]
                    (if (state-blocked? settled)
                      (fail-result settled
                        (str "TODO-NATIVE-ARITH-OPERANDS: " callee
                          " needs values safely narrowable to Int"))
                      (lower-checked-arith settled owner callee
                        (nth (argsresultv0-values coerced) 0)
                        (nth (argsresultv0-values coerced) 1)))))

                (and (= "println" callee)
                  (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "host-stdout")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->ExternCallInstruction
                        (core/->SsaValueV0 result-id (type-id "Nil"))
                        (host-stdout-abi-id)
                        values
                        nil
                        (core/->TokenFlowV0 [] [])))
                    result-id (type-id "Nil") false))

                (= "println" callee)
                (fail-result current
                  "TODO-NATIVE-HOST-STDOUT-OPERAND: println takes one native Text value")

                (and (host-environment-callee? callee)
                  (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [optional: (U core/NativeId Nil)
                      (optional-scalar-type-of types (text-type-id))]
                  (if (nil? optional)
                    (fail-result current
                      "TODO-NATIVE-HOST-ENVIRONMENT-TYPE: environment lookup needs a nullable Text result")
                    (let [result-id: core/NativeId
                          (state-id current owner "host-environment")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->ExternCallInstruction
                            (core/->SsaValueV0 result-id optional)
                            (host-environment-abi-id)
                            values
                            (arena-value-id owner)
                            (core/->TokenFlowV0 [] [])))
                        result-id optional false))))

                (host-environment-callee? callee)
                (fail-result current
                  "TODO-NATIVE-HOST-ENVIRONMENT-OPERAND: environment lookup takes one native Text name")

                (host-socket-callee? callee)
                (lower-host-socket-call owner current callee values value-types)

                (and (or (= "nil?" callee) (= "some?" callee))
                  (= 1 (count values)))
                (lower-presence-predicate types owner current
                  (nth values 0) (nth value-types 0) (= "some?" callee))

                (or (= "nil?" callee) (= "some?" callee))
                (fail-result current
                  (str "TODO-NATIVE-PRESENCE-ARITY: " callee
                    " takes one operand"))

                (and (= "re-pattern" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (->ExprResultV0 current (nth values 0) (text-type-id) false)

                (= "re-pattern" callee)
                (fail-result current
                  "TODO-NATIVE-REGEX-PATTERN-OPERAND: re-pattern takes one native Text operand")

                (and (or (= "str/starts-with?" callee)
                           (= "str/includes?" callee))
                  (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (lower-text-search-predicate types owner current callee
                  (nth values 0) (nth values 1))

                (or (= "str/starts-with?" callee)
                    (= "str/includes?" callee))
                (fail-result current
                  (str "TODO-NATIVE-TEXT-SEARCH-OPERANDS: " callee
                    " takes two native Text operands"))

                (and (= "str/index-of" callee) (= 2 (count values))
                  (text-operand? (nth value-types 0))
                  (text-operand? (nth value-types 1)))
                (lower-text-index types owner current
                  (nth values 0) (nth values 1))

                (= "str/index-of" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-INDEX-OPERANDS: str/index-of takes two native Text operands")

                (and (= "str/blank?" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "text-blank")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBlankInstruction
                        (core/->SsaValueV0 result-id (bool-type-id))
                        (nth values 0)))
                    result-id (bool-type-id) false))

                (= "str/blank?" callee)
                (fail-result current
                  "TODO-NATIVE-TEXT-BLANK-OPERAND: str/blank? takes one native Text operand")

                (and (= "parse-long" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [optional: (U core/NativeId Nil)
                      (optional-scalar-type-of types (int-type-id))]
                  (if (nil? optional)
                    (fail-result current
                      "TODO-NATIVE-PARSE-I64-TYPE: parse-long needs a nullable Int in the source world")
                    (let [result-id: core/NativeId
                          (state-id current owner "parse-i64")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->TextParseI64Instruction
                            (core/->SsaValueV0 result-id optional)
                            (nth values 0)))
                        result-id optional false))))

                (= "parse-long" callee)
                (fail-result current
                  "TODO-NATIVE-PARSE-I64-OPERAND: parse-long takes one native Text operand")

                (and (scalar-predicate? callee) (= 1 (count values)))
                (lower-scalar-predicate types owner current callee
                  (nth values 0) (nth value-types 0))

                (scalar-predicate? callee)
                (fail-result current
                  (str "TODO-NATIVE-PREDICATE-ARITY: " callee
                    " takes one operand"))

                (and (collection-predicate? callee) (= 1 (count values)))
                (lower-collection-predicate types owner current callee
                  (nth values 0) (nth value-types 0))

                (collection-predicate? callee)
                (fail-result current
                  (str "TODO-NATIVE-COLLECTION-PREDICATE-ARITY: " callee
                    " takes one operand"))

                (and (= "pos?" callee) (= 1 (count values)))
                (lower-positive types current owner
                  (nth values 0) (nth value-types 0))

                (= "pos?" callee)
                (fail-result current "TODO-NATIVE-POS-ARITY: pos? takes one operand")

                (and (= "neg?" callee) (= 1 (count values)))
                (lower-negative types current owner
                  (nth values 0) (nth value-types 0))

                (= "neg?" callee)
                (fail-result current "TODO-NATIVE-NEG-ARITY: neg? takes one operand")

                (and (= "count" callee) (= 1 (count values))
                  (vector-type? types (nth value-types 0)))
                (let [result-id: core/NativeId (state-id current owner "vec-length")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->VecLengthInstruction
                        (core/->SsaValueV0 result-id (int-type-id))
                        (nth values 0)))
                    result-id (int-type-id) false))

                (and (= "count" callee) (= 1 (count values))
                  (map-type? types (nth value-types 0)))
                (let [result-id: core/NativeId (state-id current owner "map-count")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->MapCountInstructionV0
                        (core/->SsaValueV0 result-id (int-type-id))
                        (nth values 0)))
                    result-id (int-type-id) false))

                (and (= "count" callee) (= 1 (count values))
                  (set-type? types (nth value-types 0)))
                (let [result-id: core/NativeId (state-id current owner "set-count")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->SetCountInstructionV0
                        (core/->SsaValueV0 result-id (int-type-id))
                        (nth values 0)))
                    result-id (int-type-id) false))

                (and (= "get" callee)
                  (or (= 2 (count values)) (= 3 (count values)))
                  (map-type? types (nth value-types 0)))
                (let [map-type: core/NativeId (nth value-types 0)
                      key-type: core/NativeId (map-key-of types map-type)
                      value-type: core/NativeId (map-value-of types map-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for key-type)]
                  (cond
                    (not (same-id? key-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-GET-KEY: the lookup key does not match the map key type")

                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-MAP-KEY-EQUALITY: get needs closed concrete key equality")

                    (= 3 (count values))
                    (let [coerced: ExprResultV0
                          (lower-boundary-coerce types owner current
                            (nth values 2) (nth value-types 2) value-type)
                          settled: BodyStateV0 (exprresultv0-state coerced)]
                      (if (state-blocked? settled)
                        (fail-result settled
                          "TODO-NATIVE-GET-DEFAULT: the default does not match the map value type")
                        (let [result-id: core/NativeId
                              (state-id settled owner "map-get")]
                          (->ExprResultV0
                            (state-emit (state-bump settled)
                              (core/->MapGetInstructionV0
                                (core/->SsaValueV0 result-id value-type)
                                (nth values 0) (nth values 1)
                                (exprresultv0-value-id coerced) equality))
                            result-id value-type false))))

                    :else
                    (let [optional: (U core/NativeId Nil)
                          (nullable-value-type-of types value-type)]
                      (if (nil? optional)
                        (fail-result current
                          "TODO-NATIVE-GET-RESULT: two-argument get needs a closed nullable value type")
                        (let [result-id: core/NativeId
                              (state-id current owner "map-get")]
                          (->ExprResultV0
                            (state-emit (state-bump current)
                              (core/->MapGetInstructionV0
                                (core/->SsaValueV0 result-id optional)
                                (nth values 0) (nth values 1) nil equality))
                            result-id optional false))))))

                (= "get" callee)
                (fail-result current
                  "TODO-NATIVE-GET-OPERANDS: get lowers a closed map, key, and optional typed default")

                (and (= "contains?" callee) (= 2 (count values))
                  (map-type? types (nth value-types 0)))
                (let [map-type: core/NativeId (nth value-types 0)
                      key-type: core/NativeId (map-key-of types map-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for key-type)]
                  (cond
                    (not (same-id? key-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-CONTAINS-KEY: the key does not match the map key type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-MAP-KEY-EQUALITY: contains? needs closed concrete key equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "map-contains")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->MapContainsInstructionV0
                            (core/->SsaValueV0 result-id (bool-type-id))
                            (nth values 0) (nth values 1) equality))
                        result-id (bool-type-id) false))))

                (and (= "contains?" callee) (= 2 (count values))
                  (set-type? types (nth value-types 0)))
                (let [set-type: core/NativeId (nth value-types 0)
                      element-type: core/NativeId (set-element-of types set-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for element-type)]
                  (cond
                    (not (same-id? element-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-CONTAINS-ELEMENT: the value does not match the set element type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-SET-ELEMENT-EQUALITY: contains? needs closed concrete element equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "set-contains")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->SetContainsInstructionV0
                            (core/->SsaValueV0 result-id (bool-type-id))
                            (nth values 0) (nth values 1) equality))
                        result-id (bool-type-id) false))))

                (= "contains?" callee)
                (fail-result current
                  "TODO-NATIVE-CONTAINS-OPERANDS: contains? lowers a closed map key or set element")

                (and (= "assoc" callee) (= 3 (count values))
                  (map-type? types (nth value-types 0)))
                (let [map-type: core/NativeId (nth value-types 0)
                      key-type: core/NativeId (map-key-of types map-type)
                      value-type: core/NativeId (map-value-of types map-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for key-type)]
                  (cond
                    (not (same-id? key-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-ASSOC-KEY: the key does not match the map key type")
                    (not (same-id? value-type (nth value-types 2)))
                    (fail-result current
                      "TODO-NATIVE-ASSOC-VALUE: the value does not match the map value type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-MAP-KEY-EQUALITY: assoc needs closed concrete key equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "map-assoc")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->MapAssocInstructionV0
                            (core/->SsaValueV0 result-id map-type)
                            (nth values 0) (nth values 1) (nth values 2)
                            (arena-value-id owner) equality))
                        result-id map-type false))))

                (= "assoc" callee)
                (fail-result current
                  "TODO-NATIVE-ASSOC-OPERANDS: assoc lowers one key/value pair on a closed map")

                (and (= "dissoc" callee) (= 2 (count values))
                  (map-type? types (nth value-types 0)))
                (let [map-type: core/NativeId (nth value-types 0)
                      key-type: core/NativeId (map-key-of types map-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for key-type)]
                  (cond
                    (not (same-id? key-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-DISSOC-KEY: the key does not match the map key type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-MAP-KEY-EQUALITY: dissoc needs closed concrete key equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "map-dissoc")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->MapDissocInstructionV0
                            (core/->SsaValueV0 result-id map-type)
                            (nth values 0) (nth values 1)
                            (arena-value-id owner) equality))
                        result-id map-type false))))

                (= "dissoc" callee)
                (fail-result current
                  "TODO-NATIVE-DISSOC-OPERANDS: dissoc lowers one key on a closed map")

                (and (= "keys" callee) (= 1 (count values))
                  (map-type? types (nth value-types 0)))
                (let [element: core/NativeId
                      (map-key-of types (nth value-types 0))
                      vector-type: (U core/NativeId Nil)
                      (vector-type-of types element)]
                  (if (nil? vector-type)
                    (fail-result current
                      "TODO-NATIVE-MAP-KEYS-TYPE: the world declares no vector of the map key type")
                    (let [result-id: core/NativeId
                          (state-id current owner "map-keys")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->MapKeysInstructionV0
                            (core/->SsaValueV0 result-id vector-type)
                            (nth values 0) (arena-value-id owner)))
                        result-id vector-type false))))

                (= "keys" callee)
                (fail-result current
                  "TODO-NATIVE-MAP-KEYS-OPERAND: keys lowers one closed map")

                (and (= "vals" callee) (= 1 (count values))
                  (map-type? types (nth value-types 0)))
                (let [element: core/NativeId
                      (map-value-of types (nth value-types 0))
                      vector-type: (U core/NativeId Nil)
                      (vector-type-of types element)]
                  (if (nil? vector-type)
                    (fail-result current
                      "TODO-NATIVE-MAP-VALUES-TYPE: the world declares no vector of the map value type")
                    (let [result-id: core/NativeId
                          (state-id current owner "map-values")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->MapValuesInstructionV0
                            (core/->SsaValueV0 result-id vector-type)
                            (nth values 0) (arena-value-id owner)))
                        result-id vector-type false))))

                (= "vals" callee)
                (fail-result current
                  "TODO-NATIVE-MAP-VALUES-OPERAND: vals lowers one closed map")

                (and (= "nth" callee) (= 2 (count values))
                  (vector-type? types (nth value-types 0)))
                (if (not (same-id? (nth value-types 1) (int-type-id)))
                  (fail-result current
                    "TODO-NATIVE-NTH-INDEX: the index operand is not a native Int")
                  (let [element: core/NativeId
                        (vector-element-of types (nth value-types 0))
                        result-id: core/NativeId (state-id current owner "vec-get")]
                    (->ExprResultV0
                      (state-emit (state-bump current)
                        (core/->VecGetInstruction
                          (core/->SsaValueV0 result-id element)
                          (nth values 0) (nth values 1)))
                      result-id element false)))

                (and (= "conj" callee) (= 2 (count values))
                  (vector-type? types (nth value-types 0)))
                (let [vector-type: core/NativeId (nth value-types 0)
                      element: core/NativeId (vector-element-of types vector-type)]
                  (if (not (same-id? element (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-CONJ-ELEMENT: the pushed value is not the vector's element type")
                    (let [result-id: core/NativeId (state-id current owner "vec-push")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->VecPushInstruction
                            (core/->SsaValueV0 result-id vector-type)
                            (nth values 0) (nth values 1)
                            (arena-value-id owner)))
                        result-id vector-type false))))

                (and (= "conj" callee) (= 2 (count values))
                  (set-type? types (nth value-types 0)))
                (let [set-type: core/NativeId (nth value-types 0)
                      element-type: core/NativeId (set-element-of types set-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for element-type)]
                  (cond
                    (not (same-id? element-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-CONJ-ELEMENT: the value is not the set's element type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-SET-ELEMENT-EQUALITY: conj needs closed concrete element equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "set-conj")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->SetConjInstructionV0
                            (core/->SsaValueV0 result-id set-type)
                            (nth values 0) (nth values 1)
                            (arena-value-id owner) equality))
                        result-id set-type false))))

                (= "conj" callee)
                (fail-result current
                  "TODO-NATIVE-CONJ-OPERANDS: conj lowers a native vector push or closed set insertion")

                (and (= "disj" callee) (= 2 (count values))
                  (set-type? types (nth value-types 0)))
                (let [set-type: core/NativeId (nth value-types 0)
                      element-type: core/NativeId (set-element-of types set-type)
                      equality: (U core/ConcreteEqualityV0 Nil)
                      (concrete-equality-for element-type)]
                  (cond
                    (not (same-id? element-type (nth value-types 1)))
                    (fail-result current
                      "TODO-NATIVE-DISJ-ELEMENT: the value is not the set's element type")
                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-SET-ELEMENT-EQUALITY: disj needs closed concrete element equality")
                    :else
                    (let [result-id: core/NativeId
                          (state-id current owner "set-disj")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->SetDisjInstructionV0
                            (core/->SsaValueV0 result-id set-type)
                            (nth values 0) (nth values 1)
                            (arena-value-id owner) equality))
                        result-id set-type false))))

                (= "disj" callee)
                (fail-result current
                  "TODO-NATIVE-DISJ-OPERANDS: disj lowers one value from a closed set")

                (and (= "concat" callee) (= 2 (count values))
                  (vector-type? types (nth value-types 0))
                  (same-id? (nth value-types 0) (nth value-types 1)))
                (let [vector-type: core/NativeId (nth value-types 0)
                      result-id: core/NativeId
                      (state-id current owner "vec-concat")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->VecConcatInstruction
                        (core/->SsaValueV0 result-id vector-type)
                        (nth values 0) (nth values 1)
                        (arena-value-id owner)))
                    result-id vector-type false))

                (= "concat" callee)
                (fail-result current
                  "TODO-NATIVE-CONCAT-OPERANDS: concat lowers two native vectors of the same type")

                (and (= "vec" callee) (= 1 (count values))
                  (vector-type? types (nth value-types 0)))
                (->ExprResultV0 current (nth values 0) (nth value-types 0) false)

                (and (= "vec" callee) (= 1 (count values))
                  (set-type? types (nth value-types 0)))
                (let [element: core/NativeId
                      (set-element-of types (nth value-types 0))
                      vector-type: (U core/NativeId Nil)
                      (vector-type-of types element)]
                  (if (nil? vector-type)
                    (fail-result current
                      "TODO-NATIVE-SET-VECTOR-TYPE: the world declares no vector of the set element type")
                    (let [result-id: core/NativeId
                          (state-id current owner "set-vector")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->SetVectorInstructionV0
                            (core/->SsaValueV0 result-id vector-type)
                            (nth values 0) (arena-value-id owner)))
                        result-id vector-type false))))

                (= "vec" callee)
                (fail-result current
                  "TODO-NATIVE-VEC-OPERAND: vec lowers a native vector or a closed insertion-order set")

                (and (= "=" callee) (= 2 (count values))
                  (same-id? (nth value-types 0) (nth value-types 1))
                  (value-semantics-type? types (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "value-equal")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->ValueSemanticsInstruction
                        (core/->SsaValueV0 result-id (bool-type-id))
                        (core/->ValueEqualV0 (nth value-types 0)
                          (nth values 0) (nth values 1))))
                    result-id (bool-type-id) false))

                (and (not (= "=" callee)) (some? comparison)
                  (= 2 (count values))
                  (or
                    (and (> (count (union-variants-of types (nth value-types 0))) 0)
                      (= 0 (count (union-variants-of types (nth value-types 1)))))
                    (and (= 0 (count (union-variants-of types (nth value-types 0))))
                      (> (count (union-variants-of types (nth value-types 1))) 0))))
                (lower-ordered-union-comparison types owner current callee
                  values value-types)

                (and (= "=" callee) (= 2 (count values))
                  (or
                    (and (> (count (union-variants-of types (nth value-types 0))) 0)
                      (= 0 (count (union-variants-of types (nth value-types 1)))))
                    (and (= 0 (count (union-variants-of types (nth value-types 0))))
                      (> (count (union-variants-of types (nth value-types 1))) 0))))
                (if (> (count (union-variants-of types (nth value-types 0))) 0)
                  (lower-scalar-union-equality types owner current
                    (nth values 1) (nth value-types 1)
                    (nth values 0) (nth value-types 0))
                  (lower-scalar-union-equality types owner current
                    (nth values 0) (nth value-types 0)
                    (nth values 1) (nth value-types 1)))

                (some? comparison)
                (if (not (= 2 (count values)))
                  (fail-result current
                    (str "TODO-NATIVE-COMPARE-ARITY: " callee " takes two operands"))
                  (let [left-type: core/NativeId (nth value-types 0)
                        right-type: core/NativeId (nth value-types 1)
                        both-int: Bool
                        (and (same-id? left-type (int-type-id))
                             (same-id? right-type (int-type-id)))
                        both-bool: Bool
                        (and (same-id? left-type (bool-type-id))
                             (same-id? right-type (bool-type-id)))
                        both-text: Bool
                        (and (same-id? left-type (text-type-id))
                             (same-id? right-type (text-type-id)))
                        both-keyword: Bool
                        (and (same-id? left-type (keyword-type-id))
                             (same-id? right-type (keyword-type-id)))
                        swap: Bool (compare-swaps? callee)
                        left-id: core/NativeId (nth values (if swap 1 0))
                        right-id: core/NativeId (nth values (if swap 0 1))
                        result-id: core/NativeId (state-id current owner "compare")]
                    (cond
                      both-int
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->CompareInstruction
                            (core/->SsaValueV0 result-id (bool-type-id))
                            comparison left-id right-id))
                        result-id (bool-type-id) false)

                      (and both-bool (= "=" callee))
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->CompareInstruction
                            (core/->SsaValueV0 result-id (bool-type-id))
                            (core/->CompareEqBoolV0 true) left-id right-id))
                        result-id (bool-type-id) false)

                      (and both-text (= "=" callee))
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->CompareInstruction
                            (core/->SsaValueV0 result-id (bool-type-id))
                            (core/->CompareEqTextV0 true) left-id right-id))
                        result-id (bool-type-id) false)

                      ;; The keyword table is sealed at lowering and a handle is
                      ;; its index, so index equality IS keyword equality.
                      (and both-keyword (= "=" callee))
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->CompareInstruction
                            (core/->SsaValueV0 result-id (bool-type-id))
                            (core/->CompareEqI64V0 true) left-id right-id))
                        result-id (bool-type-id) false)

                      :else
                      (fail-result current
                        (str "TODO-NATIVE-COMPARE-OPERANDS: " callee
                          " has no native comparison for these operand types")))))

                (and (= "count" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [result-id: core/NativeId (state-id current owner "text-count")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextLengthInstruction
                        (core/->SsaValueV0 result-id (int-type-id))
                        (nth values 0)))
                    result-id (int-type-id) false))

                (and (= "count" callee) (= 1 (count values))
                  (> (count (union-variants-of types (nth value-types 0))) 0))
                (let [text-value: ExprResultV0
                      (lower-boundary-coerce types owner current
                        (nth values 0) (nth value-types 0) (text-type-id))
                      settled: BodyStateV0 (exprresultv0-state text-value)
                      result-id: core/NativeId
                      (state-id settled owner "text-count")]
                  (if (state-blocked? settled)
                    (dead-result settled)
                    (->ExprResultV0
                      (state-emit (state-bump settled)
                        (core/->TextLengthInstruction
                          (core/->SsaValueV0 result-id (int-type-id))
                          (exprresultv0-value-id text-value)))
                      result-id (int-type-id) false)))

                (= "subs" callee)
                (if (not (and (or (= 2 (count values)) (= 3 (count values)))
                           (text-operand? (nth value-types 0))))
                  (fail-result current
                    "TODO-NATIVE-SUBS-OPERANDS: subs takes a native Text and one or two native Int byte bounds")
                  (let [open-ended: Bool (= 2 (count values))
                        bounds: (Vec core/NativeId)
                        (if open-ended [(nth values 1)]
                          [(nth values 1) (nth values 2)])
                        bound-types: (Vec core/NativeId)
                        (if open-ended [(nth value-types 1)]
                          [(nth value-types 1) (nth value-types 2)])
                        coerced: ArgsResultV0
                        (coerce-values-to-type types owner current bounds
                          bound-types (int-type-id))
                        settled: BodyStateV0 (argsresultv0-state coerced)]
                    (if (state-blocked? settled)
                      (fail-result settled
                        "TODO-NATIVE-SUBS-OPERANDS: subs bounds are not safely narrowable to Int")
                      (let [length-id: core/NativeId
                            (state-id settled owner "subs-end")
                            measured: BodyStateV0
                            (if open-ended
                              (state-emit (state-bump settled)
                                (core/->TextLengthInstruction
                                  (core/->SsaValueV0 length-id (int-type-id))
                                  (nth values 0)))
                              settled)
                            upper-id: core/NativeId
                            (if open-ended length-id
                              (nth (argsresultv0-values coerced) 1))
                            result-id: core/NativeId
                            (state-id measured owner "subs")]
                        (->ExprResultV0
                          (state-emit (state-bump measured)
                            (core/->TextSliceInstruction
                              (core/->SsaValueV0 result-id (text-type-id))
                              (arena-value-id owner)
                              (nth values 0)
                              (nth (argsresultv0-values coerced) 0)
                              upper-id
                              (failure-code "bounds")))
                          result-id (text-type-id) false)))))

                (and (= 1 (count values))
                  (or (= "pr-str" callee)
                    (and (= "str" callee)
                      (not (concat-operands-native? value-types))))
                  (value-to-text-type? types (nth value-types 0)))
                (let [result-id: core/NativeId
                      (state-id current owner "value-to-text")
                      mode: core/ValueTextModeV0
                      (if (= "pr-str" callee)
                        (core/->ValuePrStrV0 true)
                        (core/->ValueStrV0 true))]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->ValueToTextInstructionV0
                        (core/->SsaValueV0 result-id (text-type-id))
                        mode
                        (nth value-types 0)
                        (nth values 0)
                        (arena-value-id owner)))
                    result-id (text-type-id) false))

                (= "pr-str" callee)
                (fail-result current
                  "TODO-NATIVE-PR-STR-OPERANDS: pr-str takes one acyclic closed native value")

                (= "str" callee)
                (if (not (and (> (count values) 0)
                           (concat-operands-native? value-types)))
                  (fail-result current
                    "TODO-NATIVE-STR-OPERANDS: str concatenates one or more native Text or Int operands")
                  (let [result-id: core/NativeId (state-id current owner "str")]
                    (->ExprResultV0
                      (state-emit (state-bump current)
                        (core/->TextConcatInstruction
                          (core/->SsaValueV0 result-id (text-type-id))
                          (arena-value-id owner)
                          values))
                      result-id (text-type-id) false)))

                (accessorhitv0-found accessor)
                (let [owner-type: core/NativeId (accessorhitv0-owner-type accessor)
                      unary: Bool (= 1 (count values))
                      direct: Bool
                      (and unary
                        (or (same-id? (nth value-types 0) owner-type)
                          (reference-targets? types (nth value-types 0)
                            owner-type)))
                      narrowing: NarrowHitV0
                      (if (or direct (not unary))
                        (narrow-miss)
                        (reference-variant-for types (nth value-types 0)
                          owner-type))]
                  (cond
                    direct
                    (let [result-id: core/NativeId (state-id current owner "field")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->FieldInstruction
                            (core/->SsaValueV0 result-id
                              (accessorhitv0-field-type accessor))
                            (nth values 0)
                            (accessorhitv0-field-id accessor)))
                        result-id (accessorhitv0-field-type accessor) false))

                    ;; The operand's static type is the union, so the expected
                    ;; variant is known: a direct checked extract, not a Switch.
                    (narrowhitv0-found narrowing)
                    (let [reference-id: core/NativeId
                          (state-id current owner "narrow")
                          result-id: core/NativeId (state-id current owner "field")]
                      (->ExprResultV0
                        (state-emit
                          (state-emit (state-bump current)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 reference-id
                                (narrowhitv0-reference-type narrowing))
                              (nth values 0)
                              (narrowhitv0-variant-id narrowing)))
                          (core/->FieldInstruction
                            (core/->SsaValueV0 result-id
                              (accessorhitv0-field-type accessor))
                            reference-id
                            (accessorhitv0-field-id accessor)))
                        result-id (accessorhitv0-field-type accessor) false))

                    :else
                    (fail-result current
                      (str "TODO-NATIVE-ACCESSOR-OPERAND: " callee
                        " was not applied to its own record type"))))

                (some? constructor)
                (let [shape: core/TypeShape (core/typedef-shape constructor)
                      fields: (Vec core/TypeField)
                      (if (instance? native.core.RecordType shape)
                        (core/recordtype-fields shape)
                        [])
                      arity-ok: Bool
                      (and (> (count fields) 0) (= (count fields) (count values)))
                      parameters: (Vec core/Parameter)
                      (mapv
                        (fn [field: core/TypeField] -> core/Parameter
                          (core/->Parameter (core/typefield-id field)
                            (core/typefield-type-id field)))
                        fields)
                      coerced: ArgsResultV0
                      (if arity-ok
                        (coerce-arguments types owner current values value-types
                          parameters)
                        (->ArgsResultV0 current values value-types false))
                      settled: BodyStateV0 (argsresultv0-state coerced)
                      coerced-values: (Vec core/NativeId)
                      (argsresultv0-values coerced)
                      coerced-types: (Vec core/NativeId)
                      (argsresultv0-value-types coerced)
                      types-ok: Bool
                        (and arity-ok
                          (loop [position: Int 0]
                            (if (>= position (count fields))
                              true
                              (if (same-id? (core/typefield-type-id (nth fields position))
                                  (nth coerced-types position))
                                (recur (+ position 1))
                                false))))
                      result-id: core/NativeId (state-id settled owner "record")]
                  (if (state-blocked? settled)
                    (dead-result settled)
                    (if (not types-ok)
                    (fail-result current
                      (str "TODO-NATIVE-CONSTRUCTOR-ARGUMENTS: " callee
                        " arguments do not match the record field types"))
                    (->ExprResultV0
                      (state-emit (state-bump settled)
                        (core/->RecordInstruction
                          (core/->SsaValueV0 result-id (core/typedef-id constructor))
                          coerced-values))
                      result-id (core/typedef-id constructor) false))))

                (some? signature)
                (let [parameters: (Vec core/Parameter)
                      (typedfunctionv0-parameters signature)
                      arity-ok: Bool (= (count parameters) (count values))]
                  (if (not arity-ok)
                    (fail-result current
                      (str "TODO-NATIVE-CALL-ARGUMENTS: " callee
                        " arguments do not match its native parameters"))
                    (let [coerced: ArgsResultV0
                          (coerce-arguments types owner current values value-types
                            parameters)
                          settled: BodyStateV0 (argsresultv0-state coerced)
                          coerced-values: (Vec core/NativeId)
                          (argsresultv0-values coerced)
                          coerced-types: (Vec core/NativeId)
                          (argsresultv0-value-types coerced)
                          types-ok: Bool
                          (and (= (count parameters) (count coerced-types))
                            (loop [position: Int 0]
                              (if (>= position (count parameters))
                                true
                                (if (same-id?
                                      (core/parameter-type-id
                                        (nth parameters position))
                                      (nth coerced-types position))
                                  (recur (+ position 1))
                                  false))))
                          result-id: core/NativeId
                          (state-id settled owner "call")]
                      (cond
                        (state-blocked? settled) (dead-result settled)
                        (not types-ok)
                        (fail-result settled
                          (str "TODO-NATIVE-CALL-ARGUMENTS: " callee
                            " arguments do not match its native parameters"))
                        :else
                        (->ExprResultV0
                          (state-emit (state-bump settled)
                            (core/->CallInstruction
                              (core/->SsaValueV0 result-id
                                (typedfunctionv0-return-type signature))
                              (typedfunctionv0-id signature)
                              coerced-values
                              (core/->TokenFlowV0 [] [])))
                          result-id (typedfunctionv0-return-type signature)
                          false)))))

                :else
                (fail-result current
                  (str "TODO-NATIVE-CALL-" callee
                    ": no native lowering for this callee")))))) 

        :else
        (fail-result state
          (str "TODO-NATIVE-FORM-" kind ": no native lowering for this source form"))))))

;; Native v0 has no module-init block. A needed immutable module value is
;; hoisted once into each function entry, so aggregate allocation remains an
;; explicit effect and never occurs inside a loop merely because it is read.
(defn lower-global-bindings
  [env: BodyEnvV0
   owner: core/NativeId
   state: BodyStateV0
   globals: (Vec GlobalBindingV0)] -> BodyStateV0
  (loop [position: Int 0 current: BodyStateV0 state]
    (if (or (>= position (count globals)) (state-blocked? current))
      current
      (let [global: GlobalBindingV0 (nth globals position)
            annotation: (U core/NativeId Nil)
            (globalbindingv0-annotation global)
            raw: ExprResultV0
            (cond
              (empty-vector-form? (bodyenvv0-index env)
                (globalbindingv0-value global))
              (lower-empty-vector env owner current annotation)

              (empty-map-form? (bodyenvv0-index env)
                (globalbindingv0-value global))
              (lower-empty-map env owner current annotation)

              (empty-set-form? (bodyenvv0-index env)
                (globalbindingv0-value global))
              (lower-empty-set env owner current annotation)

              :else
              (lower-expr env owner current (globalbindingv0-value global)))
            value: ExprResultV0
            (if (or (nil? annotation)
                    (exprresultv0-terminated raw)
                    (state-blocked? (exprresultv0-state raw)))
              raw
              (lower-boundary-coerce (bodyenvv0-types env) owner
                (exprresultv0-state raw)
                (exprresultv0-value-id raw)
                (exprresultv0-type-id raw)
                (typeresolutionv0-type-id
                  (resolve-source-type (bodyenvv0-index env) annotation))))]
        (cond
          (state-blocked? (exprresultv0-state value))
          (exprresultv0-state value)

          (exprresultv0-terminated value)
          (state-fail (exprresultv0-state value)
            (str "TODO-NATIVE-GLOBAL-INITIALIZER: "
              (globalbindingv0-name global) " does not produce a value"))

          :else
          (recur (+ position 1)
            (state-bind (exprresultv0-state value)
              (global-key global)
              (exprresultv0-value-id value)
              (exprresultv0-type-id value))))))))

(defn function-native-op
  [index: SourceIndexV0
   source-function: core/NativeId] -> (U String Nil)
  (index-first-text index source-function "native-op"))

(defn recognized-native-op? [operation: String] -> Bool
  (or (= operation "identity")
      (= operation "checked-add-i64")
      (= operation "const-zero-i64")))

;; Pass one: the signature only. Bodies need every signature in the module
;; (a call names its callee), so they are lowered after this pass closes.
(defn resolve-function
  [index: SourceIndexV0
   source-function: core/NativeId] -> FunctionResolutionV0
  (let [source-name: (U String Nil) (index-first-text index source-function "name")]
    (if (nil? source-name)
      (let [id: core/NativeId (function-id source-function "unnamed")]
        (->FunctionResolutionV0
          (->TypedFunctionV0 id "unnamed" "native_unnamed" [] (type-id "LowerFailure")
            (type-id "LowerFailure") []
            (->NativeTodoV0 "TODO-NATIVE-UNNAMED-FUNCTION"
              "source function lacks a name")
            "")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-FUNCTION-MISSING-NAME"
             (str "function form has no name: " (id-value source-function)))]
          false))
      (let [id: core/NativeId (function-id source-function source-name)
            parameters: ParameterResolutionV0
            (resolve-parameters index source-function id)
            source-return: (U core/NativeId Nil)
            (index-first-object index source-function "ret")
            source-abi-symbol: (U String Nil)
            (index-first-text index source-function "abi-symbol")
            abi-symbol: String
            (if (nil? source-abi-symbol) source-name source-abi-symbol)
            return-resolution: TypeResolutionV0
            (if (nil? source-return)
              (->TypeResolutionV0
                (type-id "Nil")
                [(nil-type)]
                [(core/->DiagnosticV0
                   "TODO-NATIVE-SIGNATURE-FACTS"
                   (str "checked source projection omitted the return annotation for " source-name))]
                true)
              (resolve-source-type index source-return))
            native-op: (U String Nil) (function-native-op index source-function)
            readiness: NativeReadinessV0
            (if (and (some? native-op) (recognized-native-op? native-op))
              (->NativeReadyV0 native-op)
              (->NativeTodoV0
                "TODO-NATIVE-FUNCTION-BODY"
                (str "native body lowering remains for " source-name)))
            effects: (Vec core/NativeId) (function-effects source-name)]
        (->FunctionResolutionV0
          (->TypedFunctionV0
            id
            source-name
            abi-symbol
            (parameterresolutionv0-parameters parameters)
            (typeresolutionv0-type-id return-resolution)
            (type-id "LowerFailure")
            effects
            readiness
            "")
          (append-type-defs
            (parameterresolutionv0-definitions parameters)
            (typeresolutionv0-definitions return-resolution))
          (append-diagnostics
            (parameterresolutionv0-diagnostics parameters)
            (typeresolutionv0-diagnostics return-resolution))
          (and (parameterresolutionv0-valid parameters)
               (typeresolutionv0-valid return-resolution)))))))

(defn resolve-functions [index: SourceIndexV0] -> (Vec FunctionResolutionV0)
  (mapv
    (fn [source-function: core/NativeId] -> FunctionResolutionV0
      (resolve-function index source-function))
    (index-form-ids index "defn")))

(defn finish-body
  [signature: TypedFunctionV0
   entry-id: core/NativeId
   blocks: (Vec core/BasicBlock)] -> NativeReadinessV0
  (->NativeLoweredV0 entry-id blocks))

(defn lower-function-body
  [env: BodyEnvV0
   signature: TypedFunctionV0
   source-function: core/NativeId] -> NativeReadinessV0
  (let [index: SourceIndexV0 (bodyenvv0-index env)
        id: core/NativeId (typedfunctionv0-id signature)
        name: String (typedfunctionv0-name signature)
        body-node: (U core/NativeId Nil)
        (index-first-object index source-function "body")
        return-annotation: (U core/NativeId Nil)
        (index-first-object index source-function "ret")
        parameters: (Vec core/Parameter) (typedfunctionv0-parameters signature)
        source-parameters: (Vec core/NativeId)
        (function-parameter-items index source-function)
        parameter-locals: (Vec LocalBindingV0)
        (loop [position: Int 0 collected: (Vec LocalBindingV0) []]
          (if (or (>= position (count parameters))
                  (>= position (count source-parameters)))
            collected
            (recur (+ position 1)
              (conj collected
                (->LocalBindingV0
                  (parameter-name-at index (nth source-parameters position))
                  (core/parameter-id (nth parameters position))
                  (core/parameter-type-id (nth parameters position)))))))
        entry-id: core/NativeId (lower-id "block-entry" [(id-value id)])]
    (if (nil? body-node)
      (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
        (str "the checked source projection carries no body form for " name))
      (let [globalized: BodyStateV0
            (lower-global-bindings env id
              (->BodyStateV0 [] entry-id [] [] true 0 [] "" [])
              (needed-globals env id body-node
                (mapv
                  (fn [binding: LocalBindingV0] -> String
                    (localbindingv0-name binding))
                  parameter-locals)))
            initialized: BodyStateV0
            (loop [position: Int 0 current: BodyStateV0 globalized]
              (if (>= position (count parameter-locals))
                current
                (let [binding: LocalBindingV0 (nth parameter-locals position)]
                  (recur (+ position 1)
                    (state-bind current
                      (localbindingv0-name binding)
                      (localbindingv0-value-id binding)
                      (localbindingv0-type-id binding))))))
            result: ExprResultV0
            (cond
              (empty-vector-form? index body-node)
              (lower-empty-vector env id initialized return-annotation)

              (empty-map-form? index body-node)
              (lower-empty-map env id initialized return-annotation)

              (empty-set-form? index body-node)
              (lower-empty-set env id initialized return-annotation)

              :else
              (lower-expr env id initialized body-node))
            state: BodyStateV0 (exprresultv0-state result)]
        (cond
          (state-blocked? state)
          (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
            (str (bodystatev0-failure state) " [" name "]"))

          (exprresultv0-terminated result)
          (finish-body signature entry-id (bodystatev0-blocks state))

          :else
          ;; A body whose type differs from the declared return type is coerced,
          ;; never reinterpreted: identity when they agree, otherwise the widen.
          (let [coerced: ExprResultV0
                (lower-boundary-coerce (bodyenvv0-types env) id state
                  (exprresultv0-value-id result)
                  (exprresultv0-type-id result)
                  (typedfunctionv0-return-type signature))
                settled: BodyStateV0 (exprresultv0-state coerced)]
            (if (state-blocked? settled)
              (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
                (str "TODO-NATIVE-RETURN-TYPE: the lowered body of " name
                  " does not produce its declared return type: "
                  (bodystatev0-failure settled)))
              (finish-body signature entry-id
                (bodystatev0-blocks
                  (state-close settled
                    (core/->ReturnTerminator
                      (exprresultv0-value-id coerced))))))))))))

(defn readiness-code [readiness: NativeReadinessV0] -> String
  (match readiness
    [(NativeReadyV0 operation) operation]
    [(NativeLoweredV0 entry-block blocks) "native-body-v0"]
    [(NativeTodoV0 code detail) code]))

(defn readiness-blocks [readiness: NativeReadinessV0] -> (Vec core/BasicBlock)
  (match readiness
    [(NativeReadyV0 operation) []]
    [(NativeLoweredV0 entry-block blocks) blocks]
    [(NativeTodoV0 code detail) []]))

(defn readiness-detail [readiness: NativeReadinessV0] -> String
  (match readiness
    [(NativeReadyV0 operation) ""]
    [(NativeLoweredV0 entry-block blocks) ""]
    [(NativeTodoV0 code detail) detail]))

(defn blocks-use-checked? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some?
          (some
            (fn [instruction: core/Instruction] -> Bool
              (instance? native.core.CheckedInstruction instruction))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-environment? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some?
          (some
            (fn [instruction: core/Instruction] -> Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  (host-environment-abi-id))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-stdout? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some?
          (some
            (fn [instruction: core/Instruction] -> Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  (host-stdout-abi-id))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-socket? [blocks: (Vec core/BasicBlock)] -> Bool
  (some?
    (some
      (fn [block: core/BasicBlock] -> Bool
        (some?
          (some
            (fn [instruction: core/Instruction] -> Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (host-socket-abi-id?
                  (core/externcallinstruction-abi-id instruction))))
            (core/basicblock-instructions block))))
      blocks)))

;; Checked-arithmetic types enter the world only where a body lowered a checked
;; operation, so a slice without arithmetic keeps its type set — and the C type
;; indices its committed artifacts already name.
(defn readiness-uses-checked? [readiness: NativeReadinessV0] -> Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-checked? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn readiness-uses-host-socket? [readiness: NativeReadinessV0] -> Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-host-socket? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn with-effect
  [effects: (Vec core/NativeId)
   effect: core/NativeId] -> (Vec core/NativeId)
  (if (core/id-in? effects effect) effects (conj effects effect)))

(defn function-writes? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function) (write-effect-id)))

(defn function-allocates? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function) (allocate-effect-id)))

(defn function-uses-atom-state? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function) (atom-state-effect-id)))

(defn function-uses-environment? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function)
    (host-environment-effect-id)))

(defn function-uses-stdout? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function) (host-stdout-effect-id)))

(defn function-uses-host-socket? [function: TypedFunctionV0] -> Bool
  (core/id-in? (typedfunctionv0-effects function) (host-socket-effect-id)))

(defn any-function-allocates? [functions: (Vec TypedFunctionV0)] -> Bool
  (some? (some function-allocates? functions)))

(defn any-function-uses-atom-state? [functions: (Vec TypedFunctionV0)] -> Bool
  (some? (some function-uses-atom-state? functions)))

(defn any-function-uses-environment? [functions: (Vec TypedFunctionV0)] -> Bool
  (some? (some function-uses-environment? functions)))

(defn any-function-uses-stdout? [functions: (Vec TypedFunctionV0)] -> Bool
  (some? (some function-uses-stdout? functions)))

(defn any-function-uses-host-socket? [functions: (Vec TypedFunctionV0)] -> Bool
  (some? (some function-uses-host-socket? functions)))

(defn any-function-uses-arena? [functions: (Vec TypedFunctionV0)] -> Bool
  (some?
    (some
      (fn [function: TypedFunctionV0] -> Bool
        (or (function-writes? function) (function-allocates? function)))
      functions)))
(defn attach-body
  [env: BodyEnvV0
   resolution: FunctionResolutionV0
   source-function: core/NativeId] -> FunctionResolutionV0
  (let [signature: TypedFunctionV0 (functionresolutionv0-function resolution)
        prior: NativeReadinessV0 (typedfunctionv0-readiness signature)
        readiness: NativeReadinessV0
        (cond
          (function-signature-carries-function? (bodyenvv0-types env) signature)
          (->NativeTodoV0 "TODO-NATIVE-FUNCTION-ABI"
            (str (typedfunctionv0-name signature)
              " has a function-bearing parameter or return type; v0 has no closure ABI"))

          (ready-function? signature) prior

          :else (lower-function-body env signature source-function))
        ;; A vector allocation is discovered in the body, not the signature, so
        ;; the effect that admits it is added once the blocks exist.
        prior-effects: (Vec core/NativeId) (typedfunctionv0-effects signature)
        allocated-effects: (Vec core/NativeId)
        (if (blocks-allocate? (readiness-blocks readiness))
          (with-effect prior-effects (allocate-effect-id))
          prior-effects)
        atom-effects: (Vec core/NativeId)
        (if (blocks-use-atom-state? (readiness-blocks readiness))
          (with-effect allocated-effects (atom-state-effect-id))
          allocated-effects)
        environment-effects: (Vec core/NativeId)
        (if (blocks-use-host-environment? (readiness-blocks readiness))
          (with-effect atom-effects (host-environment-effect-id))
          atom-effects)
        stdout-effects: (Vec core/NativeId)
        (if (blocks-use-host-stdout? (readiness-blocks readiness))
          (with-effect environment-effects (host-stdout-effect-id))
          environment-effects)
        effects: (Vec core/NativeId)
        (if (blocks-use-host-socket? (readiness-blocks readiness))
          (with-effect stdout-effects (host-socket-effect-id))
          stdout-effects)
        encoding: String
        (encode-typed-function
          (typedfunctionv0-id signature)
          (typedfunctionv0-name signature)
          (typedfunctionv0-abi-symbol signature)
          (typedfunctionv0-parameters signature)
          (typedfunctionv0-return-type signature)
          (typedfunctionv0-failure-type signature)
          effects
          (readiness-code readiness))
        lowered: TypedFunctionV0
        (with
          (with (with signature [:readiness readiness]) [:effects effects])
          [:encoding encoding])]
    (->FunctionResolutionV0
      lowered
      (let [checked-definitions: (Vec core/TypeDef)
            (if (readiness-uses-checked? readiness)
              (append-type-defs (functionresolutionv0-definitions resolution)
                (checked-arithmetic-types))
              (functionresolutionv0-definitions resolution))]
        (if (readiness-uses-host-socket? readiness)
          (append-type-defs checked-definitions (socket-outcome-types))
          checked-definitions))
      (if (ready-function? lowered)
        (functionresolutionv0-diagnostics resolution)
        (conj (functionresolutionv0-diagnostics resolution)
          (core/->DiagnosticV0 "TODO-NATIVE-FUNCTION-BODY"
            (readiness-detail readiness))))
      (functionresolutionv0-valid resolution))))

(defn attach-bodies
  [env: BodyEnvV0
   resolutions: (Vec FunctionResolutionV0)
   sources: (Vec core/NativeId)] -> (Vec FunctionResolutionV0)
  (loop [position: Int 0 attached: (Vec FunctionResolutionV0) []]
    (if (>= position (count resolutions))
      attached
      (recur (+ position 1)
        (conj attached
          (if (>= position (count sources))
            (nth resolutions position)
            (attach-body env (nth resolutions position)
              (nth sources position))))))))

(defn instruction-callee [instruction: core/Instruction] -> (U core/NativeId Nil)
  (cond
    (instance? native.core.CallInstruction instruction)
    (core/callinstruction-function-id instruction)
    (instance? native.core.AtomSwapInstruction instruction)
    (core/atomswapinstruction-updater-id instruction)
    :else nil))

(defn body-call-targets [function: TypedFunctionV0] -> (Vec core/NativeId)
  (let [blocks: (Vec core/BasicBlock) (function-body-blocks function)]
    (loop [position: Int 0 targets: (Vec core/NativeId) []]
      (if (>= position (count blocks))
        targets
        (let [instructions: (Vec core/Instruction)
              (core/basicblock-instructions (nth blocks position))]
          (recur (+ position 1)
            (loop [inner: Int 0 collected: (Vec core/NativeId) targets]
              (if (>= inner (count instructions))
                collected
                (let [callee: (U core/NativeId Nil)
                      (instruction-callee (nth instructions inner))]
                  (recur (+ inner 1)
                    (if (nil? callee) collected (conj collected callee))))))))))))

;; A CallInstruction must name a function the world actually carries, so a
;; caller is only ready once every callee it reaches is ready too.
(defn settle-readiness [functions: (Vec TypedFunctionV0)] -> (Vec TypedFunctionV0)
  (loop [round: Int 0 current: (Vec TypedFunctionV0) functions]
    (if (> round (count functions))
      current
      (let [ready: (Vec core/NativeId)
            (loop [position: Int 0 ids: (Vec core/NativeId) []]
              (if (>= position (count current))
                ids
                (let [function: TypedFunctionV0 (nth current position)]
                  (recur (+ position 1)
                    (if (ready-function? function)
                      (conj ids (typedfunctionv0-id function))
                      ids)))))
            next: (Vec TypedFunctionV0)
            (mapv
              (fn [function: TypedFunctionV0] -> TypedFunctionV0
                (if (and (ready-function? function)
                      (not (core/ids-in? (body-call-targets function) ready)))
                  (with function
                    [:readiness
                     (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
                       (str "TODO-NATIVE-CALLEE: " (typedfunctionv0-name function)
                         " calls a function whose own body is not lowered"))])
                  function))
              current)
            settled: Bool
            (loop [position: Int 0]
              (if (>= position (count current))
                true
                (if (= (ready-function? (nth current position))
                       (ready-function? (nth next position)))
                  (recur (+ position 1))
                  false)))]
        (if settled current (recur (+ round 1) next))))))

;; Effects admitted by a callee are admitted by every caller before ABI sealing.
(defn settle-effect
  [functions: (Vec TypedFunctionV0)
   effect-id: core/NativeId] -> (Vec TypedFunctionV0)
  (loop [round: Int 0 current: (Vec TypedFunctionV0) functions]
    (if (> round (count functions))
      current
      (let [effectful: (Vec core/NativeId)
            (loop [position: Int 0 ids: (Vec core/NativeId) []]
              (if (>= position (count current))
                ids
                (let [function: TypedFunctionV0 (nth current position)]
                  (recur (+ position 1)
                    (if (core/id-in? (typedfunctionv0-effects function)
                          effect-id)
                      (conj ids (typedfunctionv0-id function))
                      ids)))))
            next: (Vec TypedFunctionV0)
            (mapv
              (fn [function: TypedFunctionV0] -> TypedFunctionV0
                (let [targets: (Vec core/NativeId) (body-call-targets function)
                      prior-effects: (Vec core/NativeId)
                      (typedfunctionv0-effects function)
                      needs-effect: Bool
                      (some? (some
                               (fn [target: core/NativeId] -> Bool
                                 (core/id-in? effectful target))
                               targets))
                      effects: (Vec core/NativeId)
                      (if needs-effect
                        (with-effect prior-effects effect-id)
                        prior-effects)]
                (if (= (count prior-effects) (count effects))
                  function
                  (with
                    (with function [:effects effects])
                    [:encoding
                     (encode-typed-function
                       (typedfunctionv0-id function)
                       (typedfunctionv0-name function)
                       (typedfunctionv0-abi-symbol function)
                       (typedfunctionv0-parameters function)
                       (typedfunctionv0-return-type function)
                       (typedfunctionv0-failure-type function)
                       effects
                       (readiness-code (typedfunctionv0-readiness function)))]))))
              current)
            settled: Bool
            (loop [position: Int 0]
              (if (>= position (count current))
                true
                (if (= (count (typedfunctionv0-effects (nth current position)))
                       (count (typedfunctionv0-effects (nth next position))))
                  (recur (+ position 1))
                  false)))]
        (if settled current (recur (+ round 1) next))))))

(defn settle-effects [functions: (Vec TypedFunctionV0)] -> (Vec TypedFunctionV0)
  (settle-effect
    (settle-effect
      (settle-effect
        (settle-effect
          (settle-effect functions (allocate-effect-id))
          (atom-state-effect-id))
        (host-environment-effect-id))
      (host-stdout-effect-id))
    (host-socket-effect-id)))

(defn slice-regions [] -> (Vec core/RegionDef)
  [(core/->RegionDef (arena-region-id) (core/->ArenaRegion true) nil)
   (core/->RegionDef (atom-state-region-id) (core/->ExternalRegion true) nil)])

(defn slice-capabilities
  [include-environment: Bool
   include-stdout: Bool
   include-socket: Bool] -> (Vec core/CapabilityDef)
  (let [base: (Vec core/CapabilityDef)
        [(core/->CapabilityDef
           (write-capability-id)
           (core/->WriteCapability true)
           (arena-region-id)
           true)
         (core/->CapabilityDef
           (allocate-capability-id)
           (core/->AllocateCapability true)
           (arena-region-id)
           true)
         (core/->CapabilityDef
           (atom-state-capability-id)
           (core/->WriteCapability true)
           (atom-state-region-id)
           true)]
        with-environment: (Vec core/CapabilityDef)
        (if include-environment
          (conj base
            (core/->CapabilityDef
              (host-environment-capability-id)
              (core/->HostCapability true)
              nil
              false))
          base)
        with-stdout: (Vec core/CapabilityDef)
        (if include-stdout
          (conj with-environment
            (core/->CapabilityDef
              (host-stdout-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-environment)]
    (if include-socket
      (conj with-stdout
        (core/->CapabilityDef
          (host-socket-capability-id)
          (core/->HostCapability true)
          nil
          false))
      with-stdout)))

(defn slice-capability-ids
  [include-environment: Bool
   include-stdout: Bool
   include-socket: Bool] -> (Vec core/NativeId)
  (let [base: (Vec core/NativeId)
        [(write-capability-id) (allocate-capability-id)
         (atom-state-capability-id)]
        with-environment: (Vec core/NativeId)
        (if include-environment
          (conj base (host-environment-capability-id))
          base)
        with-stdout: (Vec core/NativeId)
        (if include-stdout
          (conj with-environment (host-stdout-capability-id))
          with-environment)]
    (if include-socket
      (conj with-stdout (host-socket-capability-id))
      with-stdout)))

(defn collect-record-types
  [record-names: (Vec String)
   resolutions: (Vec RecordResolutionV0)] -> (Vec core/TypeDef)
  (loop [index: Int 0 definitions: (Vec core/TypeDef) (builtin-types record-names)]
    (if (>= index (count resolutions))
      definitions
      (let [resolution: RecordResolutionV0 (nth resolutions index)]
        (recur (+ index 1)
          (append-type-defs
            (append-type-def definitions
              (recordresolutionv0-definition resolution))
            (recordresolutionv0-supporting-definitions resolution)))))))

(defn collect-function-types
  [definitions: (Vec core/TypeDef)
   resolutions: (Vec FunctionResolutionV0)] -> (Vec core/TypeDef)
  (loop [index: Int 0 current: (Vec core/TypeDef) definitions]
    (if (>= index (count resolutions))
      current
      (recur (+ index 1)
        (append-type-defs current
          (functionresolutionv0-definitions (nth resolutions index)))))))

(defn collect-functions [resolutions: (Vec FunctionResolutionV0)] -> (Vec TypedFunctionV0)
  (mapv
    (fn [resolution: FunctionResolutionV0] -> TypedFunctionV0
      (functionresolutionv0-function resolution))
    resolutions))

(defn collect-typing-diagnostics
  [records: (Vec RecordResolutionV0)
   functions: (Vec FunctionResolutionV0)] -> (Vec core/DiagnosticV0)
  (let [record-diagnostics: (Vec core/DiagnosticV0)
        (loop [index: Int 0 diagnostics: (Vec core/DiagnosticV0) []]
          (if (>= index (count records))
            diagnostics
            (recur (+ index 1)
              (append-diagnostics diagnostics
                (recordresolutionv0-diagnostics (nth records index))))))]
    (loop [index: Int 0 diagnostics: (Vec core/DiagnosticV0) record-diagnostics]
      (if (>= index (count functions))
        diagnostics
        (recur (+ index 1)
          (append-diagnostics diagnostics
            (functionresolutionv0-diagnostics (nth functions index))))))))

(defn typing-resolutions-valid?
  [records: (Vec RecordResolutionV0)
   functions: (Vec FunctionResolutionV0)] -> Bool
  (and
    (every?
      (fn [resolution: RecordResolutionV0] -> Bool
        (recordresolutionv0-valid resolution))
      records)
    (every?
      (fn [resolution: FunctionResolutionV0] -> Bool
        (functionresolutionv0-valid resolution))
      functions)))

(defn encode-atom-kind [kind: core/AtomKind] -> String
  (cond
    (instance? native.core.BoolKind kind) "bool"
    (instance? native.core.I64Kind kind) "i64"
    (instance? native.core.F64Kind kind) "f64"
    (instance? native.core.TextKind kind) "text"
    (instance? native.core.BytesKind kind) "bytes"
    (instance? native.core.KeywordKind kind) "keyword"
    :else (worlds/canonical-record "reference-kind"
            [(id-value (core/refkind-target kind))])))

(defn encode-type-field [field: core/TypeField] -> String
  (worlds/canonical-record "field"
    [(id-value (core/typefield-id field))
     (core/typefield-name field)
     (id-value (core/typefield-type-id field))]))

(defn encode-type-variant [variant: core/TypeVariant] -> String
  (let [payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)]
    (worlds/canonical-record "variant"
      [(id-value (core/typevariant-id variant))
       (core/typevariant-name variant)
       (if (nil? payload) "unit" (id-value payload))])))

(defn encode-type-shape [shape: core/TypeShape] -> String
  (cond
    (instance? native.core.AtomType shape)
    (worlds/canonical-record "atom"
      [(encode-atom-kind (core/atomtype-kind shape))])

    (instance? native.core.RecordType shape)
    (worlds/canonical-record "record"
      (mapv
        (fn [field: core/TypeField] -> String (encode-type-field field))
        (core/recordtype-fields shape)))

    (instance? native.core.UnionType shape)
    (worlds/canonical-record "closed-union"
      (mapv
        (fn [variant: core/TypeVariant] -> String (encode-type-variant variant))
        (core/uniontype-variants shape)))

    (instance? native.core.VectorType shape)
    (worlds/canonical-record "vector"
      [(id-value (core/vectortype-element-type shape))])

    (instance? native.core.MapTypeV0 shape)
    (worlds/canonical-record "map-v0"
      [(id-value (core/maptypev0-key-type shape))
       (id-value (core/maptypev0-value-type shape))
       "insertion-order-v0"])

    (instance? native.core.SetTypeV0 shape)
    (worlds/canonical-record "set-v0"
      [(id-value (core/settypev0-element-type shape))
       "insertion-order-v0"])

    (instance? native.core.ReferenceType shape)
    (worlds/canonical-record "reference"
      [(id-value (core/referencetype-target-type shape))])

    (instance? native.core.FunctionType shape)
    (worlds/canonical-record "function"
      [(worlds/canonical-record "parameters"
         (mapv
           (fn [parameter: core/NativeId] -> String (id-value parameter))
           (core/functiontype-parameter-types shape)))
       (let [rest-type: (U core/NativeId Nil)
             (core/functiontype-rest-type shape)]
         (if (nil? rest-type) "fixed" (id-value rest-type)))
       (id-value (core/functiontype-return-type shape))])

    (instance? native.core.AtomCellTypeV0 shape)
    (worlds/canonical-record "atom-cell"
      [(id-value (core/atomcelltypev0-content-type shape))])

    (instance? native.core.OutcomeType shape)
    (worlds/canonical-record "outcome"
      [(id-value (core/outcometype-value-type shape))
       (id-value (core/outcometype-failure-type shape))])

    :else "invalid-type-shape"))

(defn encode-type-def [definition: core/TypeDef] -> String
  (worlds/canonical-record "closed-type-v0"
    [(id-value (core/typedef-id definition))
     (core/typedef-name definition)
     (encode-type-shape (core/typedef-shape definition))]))

(defn encode-effect [effect: core/EffectDef] -> String
  (let [kind: core/EffectKind (core/effectdef-kind effect)
        kind-encoding: String
        (cond
          (instance? native.core.PureEffect kind) "pure"
          (instance? native.core.AllocateEffect kind)
          (worlds/canonical-record "allocate"
            [(id-value (core/allocateeffect-region kind))])
          (instance? native.core.ReadEffect kind)
          (worlds/canonical-record "read"
            [(id-value (core/readeffect-region kind))])
          (instance? native.core.WriteEffect kind)
          (worlds/canonical-record "write"
            [(id-value (core/writeeffect-region kind))])
          (instance? native.core.CapabilityEffect kind)
          (worlds/canonical-record "capability"
            [(id-value (core/capabilityeffect-capability kind))])
          (instance? native.core.IoEffect kind)
          (worlds/canonical-record "io"
            [(id-value (core/ioeffect-capability kind))])
          (instance? native.core.SocketEffect kind)
          (worlds/canonical-record "socket"
            [(id-value (core/socketeffect-capability kind))])
          (instance? native.core.ClockEffect kind)
          (worlds/canonical-record "clock"
            [(id-value (core/clockeffect-capability kind))])
          :else
          (worlds/canonical-record "atomic"
            [(id-value (core/atomiceffect-region kind))
             (id-value (core/atomiceffect-capability kind))]))]
    (worlds/canonical-record "effect-v0"
      [(id-value (core/effectdef-id effect)) kind-encoding])))

(defn typed-term-nodes
  [types: (Vec core/TypeDef)
   functions: (Vec TypedFunctionV0)
   effects: (Vec core/EffectDef)
   include-environment: Bool
   include-stdout: Bool
   include-socket: Bool] -> (Vec worlds/TermNodeV0)
  (let [type-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [definition: core/TypeDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0
              (core/typedef-id definition)
              (worlds/->TextTermV0 (encode-type-def definition))))
          types)
        function-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [function: TypedFunctionV0] -> worlds/TermNodeV0
            (worlds/->TermNodeV0
              (typedfunctionv0-id function)
              (worlds/->TextTermV0 (typedfunctionv0-encoding function))))
          functions)
        effect-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [effect: core/EffectDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0
              (core/effectdef-id effect)
              (worlds/->TextTermV0 (encode-effect effect))))
          effects)
        region-node: worlds/TermNodeV0
        (worlds/->TermNodeV0 (arena-region-id)
          (worlds/->TextTermV0
            (worlds/canonical-record "region-v0"
              [(id-value (arena-region-id)) "arena"])))
        capability-node: worlds/TermNodeV0
        (worlds/->TermNodeV0 (write-capability-id)
          (worlds/->TextTermV0
            (worlds/canonical-record "capability-v0"
              [(id-value (write-capability-id))
               (id-value (arena-region-id))
               "affine-write"])))
        environment-capability-nodes: (Vec worlds/TermNodeV0)
        (if include-environment
          [(worlds/->TermNodeV0 (host-environment-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-environment-capability-id))
                  "host-environment"
                  "non-affine"])))]
          [])
        stdout-capability-nodes: (Vec worlds/TermNodeV0)
        (if include-stdout
          [(worlds/->TermNodeV0 (host-stdout-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-stdout-capability-id))
                  "host-stdout"
                  "non-affine"])))]
          [])
        socket-capability-nodes: (Vec worlds/TermNodeV0)
        (if include-socket
          [(worlds/->TermNodeV0 (host-socket-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-socket-capability-id))
                  "host-socket-peer-lifecycle-v0"
                  "non-affine"])))]
          [])]
    (vec (concat type-nodes function-nodes effect-nodes
           [region-node capability-node] environment-capability-nodes
           stdout-capability-nodes socket-capability-nodes))))

(defn forbidden-world-text? [value: String] -> Bool
  (or (= value "Any")
      (= value "Atom")
      (= value "Map")
      (= value "Set")
      (= value "throw")
      (= value "ex-info")
      (= value "#lang")
      (= value "clj")
      (= value "js")
      (= value "nix")))

(defn term-is-clean? [term: worlds/TermV0] -> Bool
  (if (instance? native.worlds.TextTermV0 term)
    (not (forbidden-world-text? (worlds/texttermv0-value term)))
    true))

(defn term-graph-clean? [graph: worlds/TermGraphV0] -> Bool
  (every?
    (fn [node: worlds/TermNodeV0] -> Bool
      (term-is-clean? (worlds/termnodev0-term node)))
    (worlds/termgraphv0-nodes graph)))

(defn encode-id-roots
  [tag: String
   roots: (Vec core/NativeId)] -> String
  (worlds/canonical-set tag
    (mapv (fn [id: core/NativeId] -> String (id-value id)) roots)))

(defn encode-typed-world [world: worlds/TypedEffectWorldV0] -> String
  (worlds/canonical-record "typed-effect-world-v0"
    [(encode-term-graph (worlds/typedeffectworldv0-terms world))
     (worlds/typedeffectworldv0-source-digest world)
     (encode-id-roots "types" (worlds/typedeffectworldv0-type-roots world))
     (encode-id-roots "functions" (worlds/typedeffectworldv0-function-roots world))
     (encode-id-roots "effects" (worlds/typedeffectworldv0-effect-roots world))
     (encode-id-roots "regions" (worlds/typedeffectworldv0-region-roots world))
     (encode-id-roots "capabilities"
       (worlds/typedeffectworldv0-capability-token-roots world))
     (encode-id-roots "refinements"
       (worlds/typedeffectworldv0-refinement-roots world))]))

(defn function-todo-obligations
  [functions: (Vec TypedFunctionV0)
   subject-digest: String] -> (Vec core/ReceiptObligationV0)
  (loop [index: Int 0 obligations: (Vec core/ReceiptObligationV0) []]
    (if (>= index (count functions))
      obligations
      (let [function: TypedFunctionV0 (nth functions index)
            readiness: NativeReadinessV0 (typedfunctionv0-readiness function)]
        (match readiness
          [(NativeReadyV0 operation) (recur (+ index 1) obligations)]
          [(NativeLoweredV0 entry-block blocks) (recur (+ index 1) obligations)]
          [(NativeTodoV0 code detail)
           (recur (+ index 1)
             (conj obligations
               (core/->ReceiptObligationV0
                 (core/->ValidSsaObligation true)
                 "v0" subject-digest false (str code ": " detail))))])))))

(defn type-closure-obligations
  [digest: String
   closed: Bool
   clean: Bool] -> (Vec core/ReceiptObligationV0)
  [(core/->ReceiptObligationV0
     (core/->ClosedLayoutsObligation true) "v0" digest closed
     "every reachable type is a closed Native Core TypeShape")
   (core/->ReceiptObligationV0
     (core/->BoundedEffectsObligation true) "v0" digest clean
     "typed Terms contain no raw Any, host exception, host collection, or target syntax")])

(defn lower-typed-world
  [sealed-source: worlds/SealedSourceWorldV0
   compiler-commit: String
   configuration: (Vec String)] -> TypingResultV0
  (let [source: worlds/SourceProgramWorldV0
        (worlds/sealedsourceworldv0-world sealed-source)
        source-digest: String (worlds/sealedsourceworldv0-digest sealed-source)
        graph: worlds/TermGraphV0 (worlds/sourceprogramworldv0-terms source)
        index: SourceIndexV0 (build-source-index graph)
        record-names: (Vec String) (sourceindexv0-record-names index)
        record-resolutions: (Vec RecordResolutionV0) (resolve-records index)
        function-sources: (Vec core/NativeId) (index-form-ids index "defn")
        signature-resolutions: (Vec FunctionResolutionV0) (resolve-functions index)
        base-record-types: (Vec core/TypeDef)
        (collect-record-types record-names record-resolutions)
        record-types: (Vec core/TypeDef)
        (if (index-has-callee? index "re-find")
          (append-type-def base-record-types (regex-match-type))
          base-record-types)
        globals: (Vec GlobalBindingV0) (source-globals index)
        declared-types: (Vec core/TypeDef)
        (append-type-defs
          (append-type-defs record-types (global-type-definitions index globals))
          (binding-type-definitions index))
        source-types: (Vec core/TypeDef)
        (collect-function-types declared-types signature-resolutions)
        signatures: (Vec TypedFunctionV0) (collect-functions signature-resolutions)
        function-resolutions: (Vec FunctionResolutionV0)
        (attach-bodies
          (->BodyEnvV0 index source-types signatures function-sources globals)
          signature-resolutions function-sources)
        functions: (Vec TypedFunctionV0)
        (settle-effects (settle-readiness (collect-functions function-resolutions)))
        uses-environment: Bool (any-function-uses-environment? functions)
        uses-stdout: Bool (any-function-uses-stdout? functions)
        sockets: Bool (any-function-uses-host-socket? functions)
        ;; Bodies contribute types of their own (checked arithmetic answers an
        ;; Outcome), so the world's type set closes only after they lower.
        body-types: (Vec core/TypeDef)
        (collect-function-types source-types function-resolutions)
        arena-types: (Vec core/TypeDef)
        (if (any-function-uses-arena? functions)
          (append-type-def body-types (arena-handle-type))
          body-types)
        types: (Vec core/TypeDef)
        (if (any-function-uses-atom-state? functions)
          (append-type-def arena-types (atom-state-handle-type))
          arena-types)
        effects: (Vec core/EffectDef)
        (slice-effects uses-environment uses-stdout sockets)
        regions: (Vec core/RegionDef) (slice-regions)
        capabilities: (Vec core/CapabilityDef)
        (slice-capabilities uses-environment uses-stdout sockets)
        root: core/NativeId (lower-id "typed-world" [source-digest])
        nodes: (Vec worlds/TermNodeV0)
        (typed-term-nodes types functions effects uses-environment uses-stdout sockets)
        terms: worlds/TermGraphV0
        (worlds/->TermGraphV0 root
          (conj nodes
            (worlds/->TermNodeV0 root
              (worlds/->TextTermV0 "typed-effect-world-v0"))))
        typed-world: worlds/TypedEffectWorldV0
        (worlds/->TypedEffectWorldV0
          terms
          source-digest
          (mapv (fn [definition: core/TypeDef] -> core/NativeId
                  (core/typedef-id definition)) types)
          (mapv (fn [function: TypedFunctionV0] -> core/NativeId
                  (typedfunctionv0-id function)) functions)
          (mapv (fn [effect: core/EffectDef] -> core/NativeId
                  (core/effectdef-id effect)) effects)
          [(arena-region-id) (atom-state-region-id)]
          (slice-capability-ids uses-environment uses-stdout sockets)
          [(type-id "LowerFailure")])
        encoding: String (worlds/encode-typed-world typed-world)
        digest: String (worlds/content-digest encoding)
        resolutions-valid: Bool
        (typing-resolutions-valid? record-resolutions function-resolutions)
        types-closed: Bool (core/types-refs-closed? types)
        clean: Bool (term-graph-clean? terms)
        valid: Bool (and resolutions-valid types-closed clean)
        diagnostics: (Vec core/DiagnosticV0)
        (collect-typing-diagnostics record-resolutions function-resolutions)
        obligations: (Vec core/ReceiptObligationV0)
        (vec (concat (type-closure-obligations digest types-closed clean)
               (function-todo-obligations functions digest)))]
    (if valid
      (->TypingAcceptedV0
        (worlds/->SealedTypedWorldV0 typed-world encoding digest)
        (->TypedSliceV0 types functions effects regions capabilities
          [(type-id "LowerFailure")])
        (make-receipt source-digest compiler-commit "source-to-typed"
          configuration diagnostics obligations digest))
      (->TypingRejectedV0
        (->UnresolvedSourceTypeV0
          (worlds/termgraphv0-root graph)
          "one or more source annotations do not close over Native Core types")
        (make-receipt source-digest compiler-commit "source-to-typed"
          configuration diagnostics obligations "")))))

(defrecord LayoutMeasureV0
  [size-bytes: Int
   align-bytes: Int
   closed: Bool
   detail: String])

(defrecord LayoutResolutionV0
  [layout: core/LayoutDef
   closed: Bool
   detail: String])

(defunion NativeLoweringResultV0
  (NativeLoweringCompleteV0
    [sealed: worlds/SealedNativeWorldV0
     receipt: core/PassReceiptV0])
  (NativeLoweringPendingV0
    [sealed: worlds/SealedNativeWorldV0
     receipt: core/PassReceiptV0
     obligations: (Vec core/ReceiptObligationV0)]))

(defn align-up
  [offset: Int
   alignment: Int] -> Int
  (if (= 0 alignment)
    offset
    (let [remainder: Int (mod offset alignment)]
      (if (= 0 remainder) offset (+ offset (- alignment remainder))))))

(defn max-int
  [left: Int
   right: Int] -> Int
  (if (> left right) left right))

(defn find-type-def
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (U core/TypeDef Nil)
  (loop [index: Int 0]
    (if (>= index (count types))
      nil
      (let [definition: core/TypeDef (nth types index)]
        (if (same-id? target (core/typedef-id definition))
          definition
          (recur (+ index 1)))))))

;; The alternatives an Outcome dispatches on: its failure union's variants.
(defn outcome-variants
  [types: (Vec core/TypeDef)
   failure-type: core/NativeId] -> (Vec core/TypeVariant)
  (let [definition: (U core/TypeDef Nil) (find-type-def types failure-type)
        shape: core/TypeShape
        (if (nil? definition) (core/->UnionType []) (core/typedef-shape definition))]
    (if (instance? native.core.UnionType shape)
      (core/uniontype-variants shape)
      [])))

(defn measure-type
  [types: (Vec core/TypeDef)
   target: core/NativeId
   depth: Int] -> LayoutMeasureV0
  (if (> depth 32)
    (->LayoutMeasureV0 8 8 false
      (str "recursive value layout requires an explicit reference edge: "
        (id-value target)))
    (let [definition: (U core/TypeDef Nil) (find-type-def types target)]
      (if (nil? definition)
        (->LayoutMeasureV0 8 8 false
          (str "layout target has no TypeDef: " (id-value target)))
        (let [shape: core/TypeShape (core/typedef-shape definition)]
          (cond
            (instance? native.core.AtomType shape)
            (let [kind: core/AtomKind (core/atomtype-kind shape)]
              (cond
                (instance? native.core.BoolKind kind) (->LayoutMeasureV0 1 1 true "bool")
                (instance? native.core.I64Kind kind) (->LayoutMeasureV0 8 8 true "i64")
                (instance? native.core.F64Kind kind) (->LayoutMeasureV0 8 8 true "f64")
                (instance? native.core.TextKind kind)
                (->LayoutMeasureV0 8 8 true "text handle")
                (instance? native.core.BytesKind kind)
                (->LayoutMeasureV0 16 8 true "owned byte span")
                (instance? native.core.KeywordKind kind)
                (->LayoutMeasureV0 8 8 true "keyword handle")
                :else (->LayoutMeasureV0 8 8 true "reference-sized atom")))

            (instance? native.core.ReferenceType shape)
            (->LayoutMeasureV0 8 8 true "reference")

            (instance? native.core.AtomCellTypeV0 shape)
            (->LayoutMeasureV0 8 8 true "atom cell handle")

            ;; A vector value is a reference to its {elements, length, capacity}
            ;; header, so its size never depends on the element type — that is
            ;; what closes the layout of a record with a (Vec Record) field.
            (instance? native.core.VectorType shape)
            (->LayoutMeasureV0 8 8 true "vector header reference")

            (instance? native.core.FunctionType shape)
            (->LayoutMeasureV0 8 8 false
              "TODO-NATIVE-FUNCTION-LAYOUT: callable signatures have no closure layout or indirect-call ABI")

            (instance? native.core.MapTypeV0 shape)
            (->LayoutMeasureV0 8 8 true "map header reference")

            (instance? native.core.SetTypeV0 shape)
            (->LayoutMeasureV0 8 8 true "set header reference")

            (instance? native.core.RecordType shape)
            (let [fields: (Vec core/TypeField) (core/recordtype-fields shape)]
              (loop [index: Int 0 offset: Int 0 alignment: Int 1 closed: Bool true]
                (if (>= index (count fields))
                  (->LayoutMeasureV0 (align-up offset alignment) alignment closed
                    (if closed "record" "record contains an unclosed field layout"))
                  (let [field: core/TypeField (nth fields index)
                        measure: LayoutMeasureV0
                        (measure-type types (core/typefield-type-id field) (+ depth 1))
                        field-align: Int (layoutmeasurev0-align-bytes measure)
                        field-offset: Int (align-up offset field-align)]
                    (recur (+ index 1)
                      (+ field-offset (layoutmeasurev0-size-bytes measure))
                      (max-int alignment field-align)
                      (and closed (layoutmeasurev0-closed measure)))))))

            (instance? native.core.UnionType shape)
            (let [variants: (Vec core/TypeVariant) (core/uniontype-variants shape)]
              (loop [index: Int 0 payload-size: Int 0 payload-align: Int 1 closed: Bool true]
                (if (>= index (count variants))
                  (let [alignment: Int (max-int 8 payload-align)
                        payload-offset: Int (align-up 8 payload-align)]
                    (->LayoutMeasureV0
                      (align-up (+ payload-offset payload-size) alignment)
                      alignment
                      closed
                      (if closed "closed union" "union contains an unclosed payload layout")))
                  (let [variant: core/TypeVariant (nth variants index)
                        payload: (U core/NativeId Nil)
                        (core/typevariant-payload-type variant)]
                    (if (nil? payload)
                      (recur (+ index 1) payload-size payload-align closed)
                      (let [measure: LayoutMeasureV0
                            (measure-type types payload (+ depth 1))]
                        (recur (+ index 1)
                          (max-int payload-size (layoutmeasurev0-size-bytes measure))
                          (max-int payload-align (layoutmeasurev0-align-bytes measure))
                          (and closed (layoutmeasurev0-closed measure)))))))))

            ;; Measured over the failure union's payloads, not its boxed size:
            ;; layout-shape-for flattens those alternatives into the Outcome.
            (instance? native.core.OutcomeType shape)
            (let [value-measure: LayoutMeasureV0
                  (measure-type types (core/outcometype-value-type shape) (+ depth 1))
                  variants: (Vec core/TypeVariant)
                  (outcome-variants types (core/outcometype-failure-type shape))
                  payloads: LayoutMeasureV0
                  (loop [index: Int 0 size: Int 0 alignment: Int 1 closed: Bool true]
                    (if (>= index (count variants))
                      (->LayoutMeasureV0 size alignment closed "outcome payloads")
                      (let [payload: (U core/NativeId Nil)
                            (core/typevariant-payload-type (nth variants index))]
                        (if (nil? payload)
                          (recur (+ index 1) size alignment closed)
                          (let [measure: LayoutMeasureV0
                                (measure-type types payload (+ depth 1))]
                            (recur (+ index 1)
                              (max-int size (layoutmeasurev0-size-bytes measure))
                              (max-int alignment
                                (layoutmeasurev0-align-bytes measure))
                              (and closed (layoutmeasurev0-closed measure))))))))
                  payload-align: Int
                  (max-int (layoutmeasurev0-align-bytes value-measure)
                    (layoutmeasurev0-align-bytes payloads))
                  payload-size: Int
                  (max-int (layoutmeasurev0-size-bytes value-measure)
                    (layoutmeasurev0-size-bytes payloads))
                  alignment: Int (max-int 8 payload-align)
                  payload-offset: Int (align-up 8 payload-align)]
              (->LayoutMeasureV0
                (align-up (+ payload-offset payload-size) alignment)
                alignment
                (and (layoutmeasurev0-closed value-measure)
                     (layoutmeasurev0-closed payloads))
                "outcome"))

            :else
            (->LayoutMeasureV0 8 8 false "unknown native type shape")))))))

(defn field-layouts
  [types: (Vec core/TypeDef)
   fields: (Vec core/TypeField)] -> (Vec core/FieldLayoutV0)
  (loop [index: Int 0 offset: Int 0 layouts: (Vec core/FieldLayoutV0) []]
    (if (>= index (count fields))
      layouts
      (let [field: core/TypeField (nth fields index)
            measure: LayoutMeasureV0
            (measure-type types (core/typefield-type-id field) 0)
            field-offset: Int (align-up offset (layoutmeasurev0-align-bytes measure))]
        (recur (+ index 1)
          (+ field-offset (layoutmeasurev0-size-bytes measure))
          (conj layouts
            (core/->FieldLayoutV0
              (core/typefield-id field)
              (core/typefield-type-id field)
              field-offset
              (layoutmeasurev0-align-bytes measure))))))))

(defn variant-layouts
  [types: (Vec core/TypeDef)
   variants: (Vec core/TypeVariant)] -> (Vec core/UnionVariantLayoutV0)
  (loop [index: Int 0 layouts: (Vec core/UnionVariantLayoutV0) []]
    (if (>= index (count variants))
      layouts
      (let [variant: core/TypeVariant (nth variants index)
            payload: (U core/NativeId Nil) (core/typevariant-payload-type variant)
            payload-align: Int
            (if (nil? payload)
              1
              (layoutmeasurev0-align-bytes (measure-type types payload 0)))]
        (recur (+ index 1)
          (conj layouts
            (core/->UnionVariantLayoutV0
              (core/typevariant-id variant)
              index
              payload
              (align-up 8 payload-align))))))))

(defn layout-shape-for
  [types: (Vec core/TypeDef)
   definition: core/TypeDef] -> core/LayoutShapeV0
  (let [shape: core/TypeShape (core/typedef-shape definition)]
    (cond
      (instance? native.core.AtomType shape)
      (let [kind: core/AtomKind (core/atomtype-kind shape)]
        (cond
          (instance? native.core.BoolKind kind) (core/->ScalarShapeV0 (core/->BoolReprV0 8))
          (instance? native.core.I64Kind kind) (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))
          (instance? native.core.F64Kind kind) (core/->ScalarShapeV0 (core/->FloatReprV0 64))
          ;; Text and Keyword are handles: the bytes live outside the value, so
          ;; the value itself is an exact 64-bit scalar.
          (instance? native.core.TextKind kind)
          (core/->ScalarShapeV0 (core/->UnsignedIntReprV0 64))
          (instance? native.core.BytesKind kind)
          (core/->BytesShapeV0 true)
          (instance? native.core.KeywordKind kind)
          (core/->ScalarShapeV0 (core/->UnsignedIntReprV0 64))
          :else (core/->ReferenceShapeV0 (core/typedef-id definition))))

      (instance? native.core.RecordType shape)
      (core/->RecordShapeV0 (field-layouts types (core/recordtype-fields shape)))

      (instance? native.core.UnionType shape)
      (core/->UnionShapeV0
        (type-id "UnionTag")
        0
        (variant-layouts types (core/uniontype-variants shape)))

      (instance? native.core.VectorType shape)
      (let [element: core/NativeId (core/vectortype-element-type shape)
            measure: LayoutMeasureV0 (measure-type types element 0)]
        (core/->VectorShapeV0 element (layoutmeasurev0-size-bytes measure)))

      (instance? native.core.MapTypeV0 shape)
      (let [key-type: core/NativeId (core/maptypev0-key-type shape)
            value-type: core/NativeId (core/maptypev0-value-type shape)
            key-measure: LayoutMeasureV0 (measure-type types key-type 0)
            value-measure: LayoutMeasureV0 (measure-type types value-type 0)]
        (core/->MapShapeV0
          key-type
          (layoutmeasurev0-size-bytes key-measure)
          (layoutmeasurev0-align-bytes key-measure)
          value-type
          (layoutmeasurev0-size-bytes value-measure)
          (layoutmeasurev0-align-bytes value-measure)
          (core/maptypev0-iteration-order shape)))

      (instance? native.core.SetTypeV0 shape)
      (let [element: core/NativeId (core/settypev0-element-type shape)
            measure: LayoutMeasureV0 (measure-type types element 0)]
        (core/->SetShapeV0 element
          (layoutmeasurev0-size-bytes measure)
          (layoutmeasurev0-align-bytes measure)
          (core/settypev0-iteration-order shape)))

      (instance? native.core.ReferenceType shape)
      (core/->ReferenceShapeV0 (core/referencetype-target-type shape))

      ;; Placeholder only: resolve-layout marks FunctionType unclosed, so this
      ;; reference-sized shape can never authorize a closure ABI.
      (instance? native.core.FunctionType shape)
      (core/->ReferenceShapeV0 (core/typedef-id definition))

      (instance? native.core.AtomCellTypeV0 shape)
      (core/->AtomCellShapeV0 (core/atomcelltypev0-content-type shape))

      (instance? native.core.OutcomeType shape)
      (core/->UnionShapeV0
        (type-id "UnionTag")
        0
        (variant-layouts types
          (outcome-variants types (core/outcometype-failure-type shape))))

      :else
      (core/->ReferenceShapeV0 (core/typedef-id definition)))))

(defn resolve-layout
  [types: (Vec core/TypeDef)
   definition: core/TypeDef] -> LayoutResolutionV0
  (let [measure: LayoutMeasureV0
        (measure-type types (core/typedef-id definition) 0)]
    (->LayoutResolutionV0
      (core/->LayoutDef
        (lower-id "layout" [(id-value (core/typedef-id definition))])
        (core/typedef-id definition)
        (layoutmeasurev0-size-bytes measure)
        (layoutmeasurev0-align-bytes measure)
        (layout-shape-for types definition))
      (layoutmeasurev0-closed measure)
      (layoutmeasurev0-detail measure))))

(defn resolve-layouts [types: (Vec core/TypeDef)] -> (Vec LayoutResolutionV0)
  (mapv
    (fn [definition: core/TypeDef] -> LayoutResolutionV0
      (resolve-layout types definition))
    types))

(defn collect-layouts [resolutions: (Vec LayoutResolutionV0)] -> (Vec core/LayoutDef)
  (mapv
    (fn [resolution: LayoutResolutionV0] -> core/LayoutDef
      (layoutresolutionv0-layout resolution))
    resolutions))

(defn layouts-closed? [resolutions: (Vec LayoutResolutionV0)] -> Bool
  (every?
    (fn [resolution: LayoutResolutionV0] -> Bool
      (layoutresolutionv0-closed resolution))
    resolutions))

(defn union-tag-type [] -> core/TypeDef
  (core/->TypeDef (type-id "UnionTag") "UnionTag"
    (core/->AtomType (core/->I64Kind true))))


(defn ready-functions [functions: (Vec TypedFunctionV0)] -> (Vec TypedFunctionV0)
  (filterv
    (fn [function: TypedFunctionV0] -> Bool (ready-function? function))
    functions))


(defn function-capabilities [function: TypedFunctionV0] -> (Vec core/NativeId)
  (let [written: (Vec core/NativeId)
        (if (function-writes? function) [(write-capability-id)] [])
        allocated: (Vec core/NativeId)
        (if (function-allocates? function)
          (conj written (allocate-capability-id))
          written)
        with-atom: (Vec core/NativeId)
        (if (function-uses-atom-state? function)
          (conj allocated (atom-state-capability-id))
          allocated)
        with-environment: (Vec core/NativeId)
        (if (function-uses-environment? function)
          (conj with-atom (host-environment-capability-id))
          with-atom)
        with-stdout: (Vec core/NativeId)
        (if (function-uses-stdout? function)
          (conj with-environment (host-stdout-capability-id))
          with-environment)]
    (if (function-uses-host-socket? function)
      (conj with-stdout (host-socket-capability-id))
      with-stdout)))

(defn host-capability-id? [capability: core/NativeId] -> Bool
  (or (same-id? capability (host-environment-capability-id))
      (same-id? capability (host-stdout-capability-id))
      (same-id? capability (host-socket-capability-id))))

(defn function-affine-capabilities [function: TypedFunctionV0] -> (Vec core/NativeId)
  (filterv
    (fn [capability: core/NativeId] -> Bool
      (not (host-capability-id? capability)))
    (function-capabilities function)))

(defn function-regions [function: TypedFunctionV0] -> (Vec core/NativeId)
  (let [arena: (Vec core/NativeId)
        (if (or (function-writes? function) (function-allocates? function))
          [(arena-region-id)]
          [])]
    (if (function-uses-atom-state? function)
      (conj arena (atom-state-region-id))
      arena)))

(defn arena-function-tokens [function: TypedFunctionV0] -> (Vec core/NativeId)
  (let [written: (Vec core/NativeId)
        (if (function-writes? function) [(write-capability-id)] [])
        capabilities: (Vec core/NativeId)
        (if (function-allocates? function)
          (conj written (allocate-capability-id))
          written)]
    (into [(arena-region-id)] capabilities)))

;; The acquisition consumes exactly the function's affine set, so every path out
;; of the entry block leaves it empty.
(defn arena-acquire-instruction [function: TypedFunctionV0] -> core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (arena-value-id (typedfunctionv0-id function))
      (arena-handle-type-id))
    (arena-region-id)
    (if (function-allocates? function)
      (allocate-capability-id)
      (write-capability-id))
    (core/->TokenFlowV0 (arena-function-tokens function) [])))

(defn atom-state-acquire-instruction [function: TypedFunctionV0] -> core/Instruction
  (core/->AtomStateInstruction
    (core/->SsaValueV0 (atom-state-value-id (typedfunctionv0-id function))
      (atom-state-handle-type-id))
    (atom-state-region-id)
    (atom-state-capability-id)
    (core/->TokenFlowV0
      [(atom-state-region-id) (atom-state-capability-id)] [])))

(defn with-arena-acquire
  [entry-id: core/NativeId
   acquire: core/Instruction
   blocks: (Vec core/BasicBlock)] -> (Vec core/BasicBlock)
  (mapv
    (fn [block: core/BasicBlock] -> core/BasicBlock
      (if (same-id? (core/basicblock-id block) entry-id)
        (with block
          [:instructions
           (into [acquire] (core/basicblock-instructions block))])
        block))
    blocks))

(defn lower-function-instructions [function: TypedFunctionV0] -> (Vec core/Instruction)
  (let [operation: String (function-operation function)
        parameters: (Vec core/Parameter) (typedfunctionv0-parameters function)
        result-id: core/NativeId
        (lower-id "ssa-result" [(id-value (typedfunctionv0-id function))])]
    (cond
      (= operation "checked-add-i64")
      [(core/->CheckedInstruction
         (core/->SsaValueV0 result-id (typedfunctionv0-return-type function))
         (core/->CheckedAddI64V0
           (core/parameter-id (nth parameters 0))
           (core/parameter-id (nth parameters 1))))]

      (= operation "const-zero-i64")
      [(core/->AtomInstruction
         (core/->SsaValueV0 result-id (typedfunctionv0-return-type function))
         (core/->I64Atom 0))]

      :else [])))

(defn lower-function-return [function: TypedFunctionV0] -> (U core/NativeId Nil)
  (let [operation: String (function-operation function)
        parameters: (Vec core/Parameter) (typedfunctionv0-parameters function)]
    (cond
      (= operation "identity")
      (if (= 0 (count parameters)) nil (core/parameter-id (nth parameters 0)))

      (or (= operation "checked-add-i64") (= operation "const-zero-i64"))
      (lower-id "ssa-result" [(id-value (typedfunctionv0-id function))])

      :else nil)))

(defn lower-ready-function [function: TypedFunctionV0] -> core/FunctionDef
  (let [entry-id: core/NativeId
        (lower-id "block-entry" [(id-value (typedfunctionv0-id function))])
        lowered-blocks: (Vec core/BasicBlock) (function-body-blocks function)
        body-blocks: (Vec core/BasicBlock)
        (if (> (count lowered-blocks) 0)
          lowered-blocks
          [(core/->BasicBlock
             entry-id
             []
             (lower-function-instructions function)
             [(core/->ReturnTerminator (lower-function-return function))])])
        arena-blocks: (Vec core/BasicBlock)
        (if (or (function-writes? function) (function-allocates? function))
          (with-arena-acquire entry-id (arena-acquire-instruction function)
            body-blocks)
          body-blocks)
        blocks: (Vec core/BasicBlock)
        (if (function-uses-atom-state? function)
          (with-arena-acquire entry-id
            (atom-state-acquire-instruction function) arena-blocks)
          arena-blocks)]
    (core/->FunctionDef
      (typedfunctionv0-id function)
      (typedfunctionv0-name function)
      (typedfunctionv0-parameters function)
      blocks
      entry-id
      (typedfunctionv0-return-type function)
      (typedfunctionv0-effects function)
      (function-regions function)
      (function-capabilities function))))

(defn lower-ready-functions [functions: (Vec TypedFunctionV0)] -> (Vec core/FunctionDef)
  (mapv
    (fn [function: TypedFunctionV0] -> core/FunctionDef
      (lower-ready-function function))
    (ready-functions functions)))

(defn instruction-consumed-tokens [instruction: core/Instruction] -> (Vec core/NativeId)
  (let [flow: (U core/TokenFlowV0 Nil) (get instruction :tokens nil)]
    (if (nil? flow) [] (core/tokenflowv0-consumed flow))))

(defn function-consumed-tokens [function: core/FunctionDef] -> (Vec core/NativeId)
  (loop [position: Int 0
         blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)
         consumed: (Vec core/NativeId) []]
    (if (>= position (count blocks))
      consumed
      (recur (+ position 1) blocks
        (loop [inner: Int 0
               instructions: (Vec core/Instruction)
               (core/basicblock-instructions (nth blocks position))
               collected: (Vec core/NativeId) consumed]
          (if (>= inner (count instructions))
            collected
            (recur (+ inner 1) instructions
              (core/append-ids collected
                (instruction-consumed-tokens (nth instructions inner))))))))))

(defn function-tokens-discharged? [function: core/FunctionDef] -> Bool
  (let [affine-capabilities: (Vec core/NativeId)
        (filterv
          (fn [capability: core/NativeId] -> Bool
            (not (host-capability-id? capability)))
          (core/functiondef-capabilities function))
        required: (Vec core/NativeId)
        (core/append-ids (core/functiondef-regions function)
          affine-capabilities)
        consumed: (Vec core/NativeId) (function-consumed-tokens function)]
    (and (core/unique-ids? consumed)
      (core/ids-in? required consumed)
      (core/ids-in? consumed required))))

(defn layout-digest [layouts: (Vec core/LayoutDef)] -> String
  (worlds/content-digest
    (worlds/canonical-set "layout-set-v0"
      (mapv
        (fn [layout: core/LayoutDef] -> String
          (worlds/canonical-record "layout"
            [(id-value (core/layoutdef-id layout))
             (id-value (core/layoutdef-type-id layout))
             (str (core/layoutdef-size-bytes layout))
             (str (core/layoutdef-align-bytes layout))]))
        layouts))))

(defn abi-parameters [parameters: (Vec core/Parameter)] -> (Vec core/AbiValueV0)
  (mapv
    (fn [parameter: core/Parameter] -> core/AbiValueV0
      (core/->AbiValueV0
        (id-value (core/parameter-id parameter))
        (core/parameter-type-id parameter)
        (core/->BorrowedV0 true)
        nil))
    parameters))

(defn function-abi
  [function: TypedFunctionV0
   layouts-digest: String] -> core/AbiDeclV0
  (core/->AbiDeclV0
    (lower-id "abi" [(id-value (typedfunctionv0-id function))])
    (typedfunctionv0-id function)
    (typedfunctionv0-abi-symbol function)
    (core/->AbiExportV0 true)
    (core/->RestrictedCAbiV0 true)
    (abi-parameters (typedfunctionv0-parameters function))
    (core/->AbiValueV0
      "result"
      (typedfunctionv0-return-type function)
      (core/->OwnedV0 true)
      nil)
    (typedfunctionv0-failure-type function)
    (typedfunctionv0-effects function)
    (function-capabilities function)
    "v0"
    layouts-digest))

(defn function-abis
  [functions: (Vec TypedFunctionV0)
   layouts: (Vec core/LayoutDef)] -> (Vec core/AbiDeclV0)
  (let [digest: String (layout-digest layouts)]
    (mapv
      (fn [function: TypedFunctionV0] -> core/AbiDeclV0
        (function-abi function digest))
      (ready-functions functions))))

(defn host-environment-abi
  [result-type: core/NativeId
   layouts-digest: String] -> core/AbiDeclV0
  (core/->AbiDeclV0
    (host-environment-abi-id)
    (host-environment-function-id)
    "native_host_environment_lookup_v0"
    (core/->AbiImportV0 true)
    (core/->RestrictedCOptionalOutAbiV0 true)
    [(core/->AbiValueV0 "name" (text-type-id)
       (core/->BorrowedV0 true) nil)]
    (core/->AbiValueV0 "result" result-type
      (core/->ArenaOwnedV0 (arena-region-id))
      (arena-region-id))
    (type-id "LowerFailure")
    [(allocate-effect-id) (host-environment-effect-id)]
    [(allocate-capability-id) (host-environment-capability-id)]
    "v0"
    layouts-digest))

(defn host-stdout-abi [layouts-digest: String] -> core/AbiDeclV0
  (core/->AbiDeclV0
    (host-stdout-abi-id)
    (host-stdout-function-id)
    "native_host_stdout_write_line_v0"
    (core/->AbiImportV0 true)
    (core/->RestrictedCAbiV0 true)
    [(core/->AbiValueV0 "text" (text-type-id)
       (core/->BorrowedV0 true) nil)]
    nil
    (type-id "LowerFailure")
    [(host-stdout-effect-id)]
    [(host-stdout-capability-id)]
    "v0"
    layouts-digest))

(defn borrowed-abi-value
  [name: String
   type: core/NativeId] -> core/AbiValueV0
  (core/->AbiValueV0 name type (core/->BorrowedV0 true) nil))

(defn host-socket-abi
  [operation: String
   symbol: String
   parameters: (Vec core/AbiValueV0)
   result-type: core/NativeId
   arena-owned: Bool
   layouts-digest: String] -> core/AbiDeclV0
  (let [effects: (Vec core/NativeId)
        (if arena-owned
          [(allocate-effect-id) (host-socket-effect-id)]
          [(host-socket-effect-id)])
        capabilities: (Vec core/NativeId)
        (if arena-owned
          [(allocate-capability-id) (host-socket-capability-id)]
          [(host-socket-capability-id)])]
    (core/->AbiDeclV0
      (host-socket-abi-id operation)
      (host-socket-function-id operation)
      symbol
      (core/->AbiImportV0 true)
      (core/->RestrictedCOutcomeOutAbiV0 true)
      parameters
      (core/->AbiValueV0 "result" result-type
        (if arena-owned
          (core/->ArenaOwnedV0 (arena-region-id))
          (core/->OwnedV0 true))
        (if arena-owned (arena-region-id) nil))
      (type-id "LowerFailure")
      effects
      capabilities
      "v0"
      layouts-digest)))

(defn host-socket-abis [layouts-digest: String] -> (Vec core/AbiDeclV0)
  [(host-socket-abi
     "inherited-listener"
     "native_host_socket_inherited_listener_v0"
     [(borrowed-abi-value "fd" (int-type-id))]
     (socket-int-outcome-type-id)
     false
     layouts-digest)
   (host-socket-abi
     "accept"
     "native_host_socket_accept_v0"
     [(borrowed-abi-value "listener-fd" (int-type-id))]
     (socket-int-outcome-type-id)
     false
     layouts-digest)
   (host-socket-abi
     "read-bounded"
     "native_host_socket_read_bounded_v0"
     [(borrowed-abi-value "peer-fd" (int-type-id))
      (borrowed-abi-value "max-bytes" (int-type-id))]
     (socket-bytes-outcome-type-id)
     true
     layouts-digest)
   (host-socket-abi
     "write-bounded"
     "native_host_socket_write_bounded_v0"
     [(borrowed-abi-value "peer-fd" (int-type-id))
      (borrowed-abi-value "bytes" (bytes-type-id))
      (borrowed-abi-value "max-bytes" (int-type-id))]
     (socket-int-outcome-type-id)
     false
     layouts-digest)
   (host-socket-abi
     "close"
     "native_host_socket_close_v0"
     [(borrowed-abi-value "fd" (int-type-id))]
     (socket-close-outcome-type-id)
     false
     layouts-digest)])

(defn slice-abis
  [functions: (Vec TypedFunctionV0)
   types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)] -> (Vec core/AbiDeclV0)
  (let [digest: String (layout-digest layouts)
        exports: (Vec core/AbiDeclV0) (function-abis functions layouts)
        with-environment: (Vec core/AbiDeclV0)
        (if (not (any-function-uses-environment? functions))
          exports
          (let [optional: (U core/NativeId Nil)
                (optional-scalar-type-of types (text-type-id))]
            (if (nil? optional)
              exports
              (conj exports (host-environment-abi optional digest)))))
        with-stdout: (Vec core/AbiDeclV0)
        (if (any-function-uses-stdout? functions)
          (conj with-environment (host-stdout-abi digest))
          with-environment)]
    (if (any-function-uses-host-socket? functions)
      (vec (concat with-stdout (host-socket-abis digest)))
      with-stdout)))

(defn encode-scalar-repr [representation: core/ScalarReprV0] -> String
  (cond
    (instance? native.core.BoolReprV0 representation)
    (worlds/canonical-record "bool" [(str (core/boolreprv0-bit-width representation))])
    (instance? native.core.SignedIntReprV0 representation)
    (worlds/canonical-record "signed-int"
      [(str (core/signedintreprv0-bit-width representation))])
    (instance? native.core.UnsignedIntReprV0 representation)
    (worlds/canonical-record "unsigned-int"
      [(str (core/unsignedintreprv0-bit-width representation))])
    :else
    (worlds/canonical-record "float"
      [(str (core/floatreprv0-bit-width representation))])))

(defn encode-field-layout [field: core/FieldLayoutV0] -> String
  (worlds/canonical-record "field-layout-v0"
    [(id-value (core/fieldlayoutv0-field-id field))
     (id-value (core/fieldlayoutv0-type-id field))
     (str (core/fieldlayoutv0-offset-bytes field))
     (str (core/fieldlayoutv0-align-bytes field))]))

(defn encode-variant-layout [variant: core/UnionVariantLayoutV0] -> String
  (let [payload: (U core/NativeId Nil)
        (core/unionvariantlayoutv0-payload-type variant)]
    (worlds/canonical-record "variant-layout-v0"
      [(id-value (core/unionvariantlayoutv0-variant-id variant))
       (str (core/unionvariantlayoutv0-tag variant))
       (if (nil? payload) "unit" (id-value payload))
       (str (core/unionvariantlayoutv0-payload-offset-bytes variant))])))

(defn encode-layout-shape [shape: core/LayoutShapeV0] -> String
  (cond
    (instance? native.core.ScalarShapeV0 shape)
    (worlds/canonical-record "scalar-layout"
      [(encode-scalar-repr (core/scalarshapev0-representation shape))])

    (instance? native.core.BytesShapeV0 shape)
    "native-bytes-layout-v0"

    (instance? native.core.RecordShapeV0 shape)
    (worlds/canonical-record "record-layout"
      (mapv
        (fn [field: core/FieldLayoutV0] -> String
          (encode-field-layout field))
        (core/recordshapev0-fields shape)))

    (instance? native.core.UnionShapeV0 shape)
    (worlds/canonical-record "union-layout"
      [(id-value (core/unionshapev0-tag-type shape))
       (str (core/unionshapev0-tag-offset-bytes shape))
       (worlds/canonical-record "variants"
         (mapv
           (fn [variant: core/UnionVariantLayoutV0] -> String
             (encode-variant-layout variant))
           (core/unionshapev0-variants shape)))])

    (instance? native.core.VectorShapeV0 shape)
    (worlds/canonical-record "vector-layout"
      [(id-value (core/vectorshapev0-element-type shape))
       (str (core/vectorshapev0-stride-bytes shape))])

    (instance? native.core.MapShapeV0 shape)
    (worlds/canonical-record "map-layout-v0"
      [(id-value (core/mapshapev0-key-type shape))
       (str (core/mapshapev0-key-stride-bytes shape))
       (str (core/mapshapev0-key-align-bytes shape))
       (id-value (core/mapshapev0-value-type shape))
       (str (core/mapshapev0-value-stride-bytes shape))
       (str (core/mapshapev0-value-align-bytes shape))
       "insertion-order-v0"])

    (instance? native.core.SetShapeV0 shape)
    (worlds/canonical-record "set-layout-v0"
      [(id-value (core/setshapev0-element-type shape))
       (str (core/setshapev0-stride-bytes shape))
       (str (core/setshapev0-align-bytes shape))
       "insertion-order-v0"])

    (instance? native.core.AtomCellShapeV0 shape)
    (worlds/canonical-record "atom-cell-layout"
      [(id-value (core/atomcellshapev0-content-type shape))])

    :else
    (worlds/canonical-record "reference-layout"
      [(id-value (core/referenceshapev0-target-type shape))])))

(defn encode-layout-def [layout: core/LayoutDef] -> String
  (worlds/canonical-record "exact-layout-v0"
    [(id-value (core/layoutdef-id layout))
     (id-value (core/layoutdef-type-id layout))
     (str (core/layoutdef-size-bytes layout))
     (str (core/layoutdef-align-bytes layout))
     (encode-layout-shape (core/layoutdef-shape layout))]))

(defn encode-ssa-value [value: core/SsaValueV0] -> String
  (worlds/canonical-record "ssa-value"
    [(id-value (core/ssavaluev0-id value))
     (id-value (core/ssavaluev0-type-id value))]))

(defn encode-text-builtin-operation [operation: core/TextBuiltinOpV0] -> String
  (cond
    (instance? native.core.TextCompareV0 operation)
    (worlds/canonical-record "text-compare"
      [(id-value (core/textcomparev0-left-id operation))
       (id-value (core/textcomparev0-right-id operation))])
    (instance? native.core.TextTrimV0 operation)
    (worlds/canonical-record "text-trim"
      [(id-value (core/texttrimv0-arena-id operation))
       (id-value (core/texttrimv0-source-id operation))])
    (instance? native.core.TextLowerV0 operation)
    (worlds/canonical-record "text-lower"
      [(id-value (core/textlowerv0-arena-id operation))
       (id-value (core/textlowerv0-source-id operation))])
    (instance? native.core.TextRegexReplaceV0 operation)
    (worlds/canonical-record "text-regex-replace"
      [(id-value (core/textregexreplacev0-arena-id operation))
       (id-value (core/textregexreplacev0-source-id operation))
       (id-value (core/textregexreplacev0-pattern-id operation))
       (id-value (core/textregexreplacev0-replacement-id operation))])
    (instance? native.core.TextRegexMatchesV0 operation)
    (worlds/canonical-record "text-regex-matches"
      [(id-value (core/textregexmatchesv0-source-id operation))
       (id-value (core/textregexmatchesv0-pattern-id operation))])
    (instance? native.core.TextRegexFindV0 operation)
    (worlds/canonical-record "text-regex-find"
      [(id-value (core/textregexfindv0-arena-id operation))
       (id-value (core/textregexfindv0-source-id operation))
       (id-value (core/textregexfindv0-pattern-id operation))])
    (instance? native.core.TextSplitV0 operation)
    (worlds/canonical-record "text-split"
      [(id-value (core/textsplitv0-arena-id operation))
       (id-value (core/textsplitv0-source-id operation))
       (id-value (core/textsplitv0-pattern-id operation))])
    (instance? native.core.TextVectorTrimV0 operation)
    (worlds/canonical-record "text-vector-trim"
      [(id-value (core/textvectortrimv0-arena-id operation))
       (id-value (core/textvectortrimv0-source-id operation))])
    (instance? native.core.TextVectorRemoveBlankV0 operation)
    (worlds/canonical-record "text-vector-remove-blank"
      [(id-value (core/textvectorremoveblankv0-arena-id operation))
       (id-value (core/textvectorremoveblankv0-source-id operation))])
    (instance? native.core.TextJoinV0 operation)
    (worlds/canonical-record "text-join"
      [(id-value (core/textjoinv0-arena-id operation))
       (id-value (core/textjoinv0-separator-id operation))
       (id-value (core/textjoinv0-source-id operation))])
    :else
    (worlds/canonical-record "text-repeat"
      [(id-value (core/textrepeatv0-arena-id operation))
       (id-value (core/textrepeatv0-source-id operation))
       (id-value (core/textrepeatv0-count-id operation))])))

(defn encode-concrete-equality [equality: core/ConcreteEqualityV0] -> String
  (cond
    (instance? native.core.BoolEqualityV0 equality) "bool-equality-v0"
    (instance? native.core.I64EqualityV0 equality) "i64-equality-v0"
    (instance? native.core.F64EqualityV0 equality) "f64-equality-v0"
    (instance? native.core.TextEqualityV0 equality) "text-equality-v0"
    :else "keyword-equality-v0"))

(defn encode-value-semantics-operation [operation: core/ValueSemanticsOpV0] -> String
  (match operation
    [(ValueEqualV0 domain-type left-id right-id)
     (worlds/canonical-record "value-equal-v0"
       [(id-value domain-type) (id-value left-id) (id-value right-id)])]))

(defn encode-instruction [instruction: core/Instruction] -> String
  (cond
    (instance? native.core.AtomInstruction instruction)
    (worlds/canonical-record "atom-instruction"
      [(encode-ssa-value (core/atominstruction-result instruction))])

    (instance? native.core.CopyInstruction instruction)
    (worlds/canonical-record "copy-instruction"
      [(encode-ssa-value (core/copyinstruction-result instruction))
       (id-value (core/copyinstruction-source-id instruction))])

    (instance? native.core.AddF64Instruction instruction)
    (worlds/canonical-record "add-f64-instruction"
      [(encode-ssa-value (core/addf64instruction-result instruction))
       (id-value (core/addf64instruction-left-id instruction))
       (id-value (core/addf64instruction-right-id instruction))])

    (instance? native.core.CheckedInstruction instruction)
    (let [operation: core/CheckedOperationV0
          (core/checkedinstruction-operation instruction)
          result: String
          (encode-ssa-value (core/checkedinstruction-result instruction))]
      (cond
        (instance? native.core.CheckedAddI64V0 operation)
        (worlds/canonical-record "checked-add-i64-instruction"
          [result
           (id-value (core/checkedaddi64v0-left-id operation))
           (id-value (core/checkedaddi64v0-right-id operation))])

        (instance? native.core.CheckedSubI64V0 operation)
        (worlds/canonical-record "checked-sub-i64-instruction"
          [result
           (id-value (core/checkedsubi64v0-left-id operation))
           (id-value (core/checkedsubi64v0-right-id operation))])

        (instance? native.core.CheckedMulI64V0 operation)
        (worlds/canonical-record "checked-mul-i64-instruction"
          [result
           (id-value (core/checkedmuli64v0-left-id operation))
           (id-value (core/checkedmuli64v0-right-id operation))])

        :else
        (worlds/canonical-record "checked-bounds-instruction"
          [result
           (id-value (core/checkedboundsv0-index-id operation))
           (id-value (core/checkedboundsv0-length-id operation))])))

    (instance? native.core.CompareInstruction instruction)
    (let [comparison: core/CompareOpV0
          (core/compareinstruction-comparison instruction)
          label: String
          (cond
            (instance? native.core.CompareEqI64V0 comparison) "compare-eq-i64-instruction"
            (instance? native.core.CompareLtI64V0 comparison) "compare-lt-i64-instruction"
            (instance? native.core.CompareLeI64V0 comparison) "compare-le-i64-instruction"
            (instance? native.core.CompareEqBoolV0 comparison) "compare-eq-bool-instruction"
            :else "compare-eq-text-instruction")]
      (worlds/canonical-record label
        [(encode-ssa-value (core/compareinstruction-result instruction))
         (id-value (core/compareinstruction-left-id instruction))
         (id-value (core/compareinstruction-right-id instruction))]))

    (instance? native.core.FieldInstruction instruction)
    (worlds/canonical-record "field-instruction"
      [(encode-ssa-value (core/fieldinstruction-result instruction))
       (id-value (core/fieldinstruction-source-id instruction))
       (id-value (core/fieldinstruction-field-id instruction))])

    (instance? native.core.VariantValueInstruction instruction)
    (worlds/canonical-record "variant-value-instruction"
      [(encode-ssa-value (core/variantvalueinstruction-result instruction))
       (id-value (core/variantvalueinstruction-source-id instruction))
       (id-value (core/variantvalueinstruction-variant-id instruction))])

    (instance? native.core.RecordInstruction instruction)
    (worlds/canonical-record "record-instruction"
      [(encode-ssa-value (core/recordinstruction-result instruction))
       (encode-id-roots "fields" (core/recordinstruction-field-ids instruction))])

    (instance? native.core.BoxRecordInstruction instruction)
    (worlds/canonical-record "box-record-instruction"
      [(encode-ssa-value (core/boxrecordinstruction-result instruction))
       (id-value (core/boxrecordinstruction-source-id instruction))
       (id-value (core/boxrecordinstruction-arena-id instruction))])

    (instance? native.core.UnionConstructInstruction instruction)
    (let [payload: (U core/NativeId Nil)
          (core/unionconstructinstruction-payload-id instruction)]
      (worlds/canonical-record "union-construct-instruction"
        [(encode-ssa-value (core/unionconstructinstruction-result instruction))
         (id-value (core/unionconstructinstruction-variant-id instruction))
         (if (nil? payload) "unit" (id-value payload))]))

    (instance? native.core.UnionExtractInstruction instruction)
    (worlds/canonical-record "union-extract-instruction"
      [(encode-ssa-value (core/unionextractinstruction-result instruction))
       (id-value (core/unionextractinstruction-source-id instruction))
       (id-value (core/unionextractinstruction-variant-id instruction))])

    (instance? native.core.StoreInstruction instruction)
    (worlds/canonical-record "store-instruction"
      [(encode-ssa-value (core/storeinstruction-result instruction))])

    (instance? native.core.AllocateInstruction instruction)
    (worlds/canonical-record "allocate-instruction"
      [(encode-ssa-value (core/allocateinstruction-result instruction))
       (id-value (core/allocateinstruction-region instruction))
       (id-value (core/allocateinstruction-capability instruction))])

    (instance? native.core.VecLengthInstruction instruction)
    (worlds/canonical-record "vec-length-instruction"
      [(encode-ssa-value (core/veclengthinstruction-result instruction))
       (id-value (core/veclengthinstruction-source-id instruction))])

    (instance? native.core.VecGetInstruction instruction)
    (worlds/canonical-record "vec-get-instruction"
      [(encode-ssa-value (core/vecgetinstruction-result instruction))
       (id-value (core/vecgetinstruction-source-id instruction))
       (id-value (core/vecgetinstruction-index-id instruction))])

    (instance? native.core.VecPushInstruction instruction)
    (worlds/canonical-record "vec-push-instruction"
      [(encode-ssa-value (core/vecpushinstruction-result instruction))
       (id-value (core/vecpushinstruction-source-id instruction))
       (id-value (core/vecpushinstruction-value-id instruction))
       (id-value (core/vecpushinstruction-arena-id instruction))])

    (instance? native.core.VecEmptyInstruction instruction)
    (worlds/canonical-record "vec-empty-instruction"
      [(encode-ssa-value (core/vecemptyinstruction-result instruction))
       (id-value (core/vecemptyinstruction-capacity-id instruction))
       (id-value (core/vecemptyinstruction-arena-id instruction))])

    (instance? native.core.VecConcatInstruction instruction)
    (worlds/canonical-record "vec-concat-instruction"
      [(encode-ssa-value (core/vecconcatinstruction-result instruction))
       (id-value (core/vecconcatinstruction-left-id instruction))
       (id-value (core/vecconcatinstruction-right-id instruction))
       (id-value (core/vecconcatinstruction-arena-id instruction))])

    (instance? native.core.MapLiteralInstructionV0 instruction)
    (worlds/canonical-record "map-literal-instruction-v0"
      [(encode-ssa-value (core/mapliteralinstructionv0-result instruction))
       (encode-id-roots "keys"
         (core/mapliteralinstructionv0-key-ids instruction))
       (encode-id-roots "values"
         (core/mapliteralinstructionv0-value-ids instruction))
       (id-value (core/mapliteralinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/mapliteralinstructionv0-key-equality instruction))])

    (instance? native.core.SetLiteralInstructionV0 instruction)
    (worlds/canonical-record "set-literal-instruction-v0"
      [(encode-ssa-value (core/setliteralinstructionv0-result instruction))
       (encode-id-roots "values"
         (core/setliteralinstructionv0-value-ids instruction))
       (id-value (core/setliteralinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/setliteralinstructionv0-element-equality instruction))])

    (instance? native.core.MapCountInstructionV0 instruction)
    (worlds/canonical-record "map-count-instruction-v0"
      [(encode-ssa-value (core/mapcountinstructionv0-result instruction))
       (id-value (core/mapcountinstructionv0-source-id instruction))])

    (instance? native.core.MapGetInstructionV0 instruction)
    (let [default: (U core/NativeId Nil)
          (core/mapgetinstructionv0-default-id instruction)]
      (worlds/canonical-record "map-get-instruction-v0"
        [(encode-ssa-value (core/mapgetinstructionv0-result instruction))
         (id-value (core/mapgetinstructionv0-source-id instruction))
         (id-value (core/mapgetinstructionv0-key-id instruction))
         (if (nil? default) "absent-v0" (id-value default))
         (encode-concrete-equality
           (core/mapgetinstructionv0-key-equality instruction))]))

    (instance? native.core.MapContainsInstructionV0 instruction)
    (worlds/canonical-record "map-contains-instruction-v0"
      [(encode-ssa-value (core/mapcontainsinstructionv0-result instruction))
       (id-value (core/mapcontainsinstructionv0-source-id instruction))
       (id-value (core/mapcontainsinstructionv0-key-id instruction))
       (encode-concrete-equality
         (core/mapcontainsinstructionv0-key-equality instruction))])

    (instance? native.core.MapAssocInstructionV0 instruction)
    (worlds/canonical-record "map-assoc-instruction-v0"
      [(encode-ssa-value (core/mapassocinstructionv0-result instruction))
       (id-value (core/mapassocinstructionv0-source-id instruction))
       (id-value (core/mapassocinstructionv0-key-id instruction))
       (id-value (core/mapassocinstructionv0-value-id instruction))
       (id-value (core/mapassocinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/mapassocinstructionv0-key-equality instruction))])

    (instance? native.core.MapDissocInstructionV0 instruction)
    (worlds/canonical-record "map-dissoc-instruction-v0"
      [(encode-ssa-value (core/mapdissocinstructionv0-result instruction))
       (id-value (core/mapdissocinstructionv0-source-id instruction))
       (id-value (core/mapdissocinstructionv0-key-id instruction))
       (id-value (core/mapdissocinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/mapdissocinstructionv0-key-equality instruction))])

    (instance? native.core.MapKeysInstructionV0 instruction)
    (worlds/canonical-record "map-keys-instruction-v0"
      [(encode-ssa-value (core/mapkeysinstructionv0-result instruction))
       (id-value (core/mapkeysinstructionv0-source-id instruction))
       (id-value (core/mapkeysinstructionv0-arena-id instruction))])

    (instance? native.core.MapValuesInstructionV0 instruction)
    (worlds/canonical-record "map-values-instruction-v0"
      [(encode-ssa-value (core/mapvaluesinstructionv0-result instruction))
       (id-value (core/mapvaluesinstructionv0-source-id instruction))
       (id-value (core/mapvaluesinstructionv0-arena-id instruction))])

    (instance? native.core.SetCountInstructionV0 instruction)
    (worlds/canonical-record "set-count-instruction-v0"
      [(encode-ssa-value (core/setcountinstructionv0-result instruction))
       (id-value (core/setcountinstructionv0-source-id instruction))])

    (instance? native.core.SetContainsInstructionV0 instruction)
    (worlds/canonical-record "set-contains-instruction-v0"
      [(encode-ssa-value (core/setcontainsinstructionv0-result instruction))
       (id-value (core/setcontainsinstructionv0-source-id instruction))
       (id-value (core/setcontainsinstructionv0-value-id instruction))
       (encode-concrete-equality
         (core/setcontainsinstructionv0-element-equality instruction))])

    (instance? native.core.SetConjInstructionV0 instruction)
    (worlds/canonical-record "set-conj-instruction-v0"
      [(encode-ssa-value (core/setconjinstructionv0-result instruction))
       (id-value (core/setconjinstructionv0-source-id instruction))
       (id-value (core/setconjinstructionv0-value-id instruction))
       (id-value (core/setconjinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/setconjinstructionv0-element-equality instruction))])

    (instance? native.core.SetDisjInstructionV0 instruction)
    (worlds/canonical-record "set-disj-instruction-v0"
      [(encode-ssa-value (core/setdisjinstructionv0-result instruction))
       (id-value (core/setdisjinstructionv0-source-id instruction))
       (id-value (core/setdisjinstructionv0-value-id instruction))
       (id-value (core/setdisjinstructionv0-arena-id instruction))
       (encode-concrete-equality
         (core/setdisjinstructionv0-element-equality instruction))])

    (instance? native.core.SetVectorInstructionV0 instruction)
    (worlds/canonical-record "set-vector-instruction-v0"
      [(encode-ssa-value (core/setvectorinstructionv0-result instruction))
       (id-value (core/setvectorinstructionv0-source-id instruction))
       (id-value (core/setvectorinstructionv0-arena-id instruction))])

    (instance? native.core.ArenaInstruction instruction)
    (worlds/canonical-record "arena-instruction"
      [(encode-ssa-value (core/arenainstruction-result instruction))
       (id-value (core/arenainstruction-region instruction))
       (id-value (core/arenainstruction-capability instruction))])

    (instance? native.core.AtomStateInstruction instruction)
    (worlds/canonical-record "atom-state-instruction"
      [(encode-ssa-value (core/atomstateinstruction-result instruction))
       (id-value (core/atomstateinstruction-region instruction))
       (id-value (core/atomstateinstruction-capability instruction))])

    (instance? native.core.AtomCreateInstruction instruction)
    (worlds/canonical-record "atom-create-instruction"
      [(encode-ssa-value (core/atomcreateinstruction-result instruction))
       (id-value (core/atomcreateinstruction-initial-id instruction))
       (id-value (core/atomcreateinstruction-arena-id instruction))
       (id-value (core/atomcreateinstruction-state-id instruction))])

    (instance? native.core.AtomDerefInstruction instruction)
    (worlds/canonical-record "atom-deref-instruction"
      [(encode-ssa-value (core/atomderefinstruction-result instruction))
       (id-value (core/atomderefinstruction-cell-id instruction))
       (id-value (core/atomderefinstruction-state-id instruction))])

    (instance? native.core.AtomSwapInstruction instruction)
    (worlds/canonical-record "atom-swap-instruction"
      [(encode-ssa-value (core/atomswapinstruction-result instruction))
       (id-value (core/atomswapinstruction-cell-id instruction))
       (id-value (core/atomswapinstruction-state-id instruction))
       (id-value (core/atomswapinstruction-updater-id instruction))
       (encode-id-roots "arguments"
         (core/atomswapinstruction-arguments instruction))])

    (instance? native.core.TextLengthInstruction instruction)
    (worlds/canonical-record "text-length-instruction"
      [(encode-ssa-value (core/textlengthinstruction-result instruction))
       (id-value (core/textlengthinstruction-source-id instruction))])

    (instance? native.core.TextIndexOfInstruction instruction)
    (worlds/canonical-record "text-index-of-instruction"
      [(encode-ssa-value (core/textindexofinstruction-result instruction))
       (id-value (core/textindexofinstruction-source-id instruction))
       (id-value (core/textindexofinstruction-needle-id instruction))])

    (instance? native.core.TextBlankInstruction instruction)
    (worlds/canonical-record "text-blank-instruction"
      [(encode-ssa-value (core/textblankinstruction-result instruction))
       (id-value (core/textblankinstruction-source-id instruction))])

    (instance? native.core.TextParseI64Instruction instruction)
    (worlds/canonical-record "text-parse-i64-instruction"
      [(encode-ssa-value (core/textparsei64instruction-result instruction))
       (id-value (core/textparsei64instruction-source-id instruction))])

    (instance? native.core.TextSliceInstruction instruction)
    (worlds/canonical-record "text-slice-instruction"
      [(encode-ssa-value (core/textsliceinstruction-result instruction))
       (id-value (core/textsliceinstruction-arena-id instruction))
       (id-value (core/textsliceinstruction-source-id instruction))
       (id-value (core/textsliceinstruction-start-id instruction))
       (id-value (core/textsliceinstruction-end-id instruction))
       (str (core/textsliceinstruction-failure-code instruction))])

    (instance? native.core.TextConcatInstruction instruction)
    (worlds/canonical-record "text-concat-instruction"
      [(encode-ssa-value (core/textconcatinstruction-result instruction))
       (id-value (core/textconcatinstruction-arena-id instruction))
       (encode-id-roots "operands"
         (core/textconcatinstruction-operand-ids instruction))])

    (instance? native.core.TextBuiltinInstruction instruction)
    (worlds/canonical-record "text-builtin-instruction"
      [(encode-ssa-value (core/textbuiltininstruction-result instruction))
       (encode-text-builtin-operation
         (core/textbuiltininstruction-builtin instruction))])

    (instance? native.core.ValueSemanticsInstruction instruction)
    (worlds/canonical-record "value-semantics-instruction"
      [(encode-ssa-value
         (core/valuesemanticsinstruction-result instruction))
       (encode-value-semantics-operation
         (core/valuesemanticsinstruction-operation instruction))])

    (instance? native.core.ValueToTextInstructionV0 instruction)
    (worlds/canonical-record "value-to-text-instruction-v0"
      [(encode-ssa-value
         (core/valuetotextinstructionv0-result instruction))
       (if (instance? native.core.ValuePrStrV0
             (core/valuetotextinstructionv0-mode instruction))
         "pr-str"
         "str")
       (id-value (core/valuetotextinstructionv0-domain-type instruction))
       (id-value (core/valuetotextinstructionv0-value-id instruction))
       (id-value (core/valuetotextinstructionv0-arena-id instruction))])

    (instance? native.core.CallInstruction instruction)
    (worlds/canonical-record "call-instruction"
      [(encode-ssa-value (core/callinstruction-result instruction))
       (id-value (core/callinstruction-function-id instruction))
       (encode-id-roots "arguments" (core/callinstruction-arguments instruction))])

    (instance? native.core.ExternCallInstruction instruction)
    (let [arena: (U core/NativeId Nil)
          (core/externcallinstruction-arena-id instruction)]
      (worlds/canonical-record "extern-call-instruction"
        [(encode-ssa-value (core/externcallinstruction-result instruction))
         (id-value (core/externcallinstruction-abi-id instruction))
         (encode-id-roots "arguments"
           (core/externcallinstruction-arguments instruction))
         (if (nil? arena) "no-arena" (id-value arena))]))

    :else ""))

(defn encode-terminator [terminator: core/Terminator] -> String
  (cond
    (instance? native.core.ReturnTerminator terminator)
    (let [value: (U core/NativeId Nil) (core/returnterminator-value terminator)]
      (worlds/canonical-record "return"
        [(if (nil? value) "unit" (id-value value))]))

    (instance? native.core.JumpTerminator terminator)
    (worlds/canonical-record "jump"
      [(id-value (core/jumpterminator-block-id terminator))
       (encode-id-roots "arguments" (core/jumpterminator-arguments terminator))])

    (instance? native.core.BranchTerminator terminator)
    (worlds/canonical-record "branch"
      [(id-value (core/branchterminator-condition terminator))
       (id-value (core/branchterminator-true-block terminator))
       (id-value (core/branchterminator-false-block terminator))])

    (instance? native.core.SwitchTerminator terminator)
    (worlds/canonical-record "switch"
      [(id-value (core/switchterminator-value-id terminator))])

    :else
    (worlds/canonical-record "trap"
      [(id-value (core/trapterminator-failure-id terminator))])))

(defn encode-basic-block [block: core/BasicBlock] -> String
  (worlds/canonical-record "basic-block-v0"
    [(id-value (core/basicblock-id block))
     (worlds/canonical-record "parameters"
       (mapv
         (fn [parameter: core/Parameter] -> String (encode-parameter parameter))
         (core/basicblock-parameters block)))
     (worlds/canonical-record "instructions"
       (mapv
         (fn [instruction: core/Instruction] -> String
           (encode-instruction instruction))
         (core/basicblock-instructions block)))
     (worlds/canonical-record "terminators"
       (mapv
         (fn [terminator: core/Terminator] -> String
           (encode-terminator terminator))
         (core/basicblock-terminators block)))]))

(defn encode-native-function [function: core/FunctionDef] -> String
  (worlds/canonical-record "native-function-v0"
    [(id-value (core/functiondef-id function))
     (core/functiondef-name function)
     (worlds/canonical-record "parameters"
       (mapv
         (fn [parameter: core/Parameter] -> String (encode-parameter parameter))
         (core/functiondef-parameters function)))
     (worlds/canonical-record "blocks"
       (mapv
         (fn [block: core/BasicBlock] -> String (encode-basic-block block))
         (core/functiondef-blocks function)))
     (id-value (core/functiondef-entry-block function))
     (let [result: (U core/NativeId Nil) (core/functiondef-return-type function)]
       (if (nil? result) "unit" (id-value result)))
     (encode-id-roots "effects" (core/functiondef-effects function))
     (encode-id-roots "regions" (core/functiondef-regions function))
     (encode-id-roots "capabilities" (core/functiondef-capabilities function))]))

(defn encode-abi-value [value: core/AbiValueV0] -> String
  (worlds/canonical-record "abi-value-v0"
    [(core/abivaluev0-name value)
     (id-value (core/abivaluev0-type-id value))]))

(defn encode-ownership [ownership: core/OwnershipRuleV0] -> String
  (cond
    (instance? native.core.BorrowedV0 ownership) "borrowed"
    (instance? native.core.OwnedV0 ownership) "owned"
    :else
    (worlds/canonical-record "arena-owned"
      [(id-value (core/arenaownedv0-region ownership))])))

(defn encode-import-abi-value [value: core/AbiValueV0] -> String
  (let [lifetime: (U core/NativeId Nil)
        (core/abivaluev0-lifetime-region value)]
    (worlds/canonical-record "import-abi-value-v0"
      [(core/abivaluev0-name value)
       (id-value (core/abivaluev0-type-id value))
       (encode-ownership (core/abivaluev0-ownership value))
       (if (nil? lifetime) "no-lifetime" (id-value lifetime))])))

(defn encode-abi [abi: core/AbiDeclV0] -> String
  (let [result: (U core/AbiValueV0 Nil) (core/abideclv0-result abi)]
    (if (instance? native.core.AbiImportV0 (core/abideclv0-direction abi))
      (worlds/canonical-record "abi-import-declaration-v0"
        [(id-value (core/abideclv0-id abi))
         (id-value (core/abideclv0-function-id abi))
         (core/abideclv0-symbol abi)
         (cond
           (instance? native.core.RestrictedCOptionalOutAbiV0
             (core/abideclv0-convention abi))
           "restricted-c-optional-out-v0"
           (instance? native.core.RestrictedCOutcomeOutAbiV0
             (core/abideclv0-convention abi))
           "restricted-c-outcome-out-v0"
           :else "restricted-c-v0")
         (worlds/canonical-record "parameters"
           (mapv
             (fn [value: core/AbiValueV0] -> String
               (encode-import-abi-value value))
             (core/abideclv0-parameters abi)))
         (if (nil? result) "unit" (encode-import-abi-value result))
         (id-value (core/abideclv0-failure-type abi))
         (encode-id-roots "effects" (core/abideclv0-required-effects abi))
         (encode-id-roots "capabilities"
           (core/abideclv0-required-capabilities abi))
         (core/abideclv0-version abi)
         (core/abideclv0-layout-digest abi)])
      (worlds/canonical-record "abi-declaration-v0"
        [(id-value (core/abideclv0-id abi))
         (id-value (core/abideclv0-function-id abi))
         (core/abideclv0-symbol abi)
         (worlds/canonical-record "parameters"
           (mapv
             (fn [value: core/AbiValueV0] -> String (encode-abi-value value))
             (core/abideclv0-parameters abi)))
         (if (nil? result) "unit" (encode-abi-value result))
         (id-value (core/abideclv0-failure-type abi))
         (encode-id-roots "effects" (core/abideclv0-required-effects abi))
         (encode-id-roots "capabilities"
           (core/abideclv0-required-capabilities abi))
         (core/abideclv0-version abi)
         (core/abideclv0-layout-digest abi)]))))

(defn native-term-nodes
  [types: (Vec core/TypeDef)
   effects: (Vec core/EffectDef)
   capabilities: (Vec core/CapabilityDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   obligation-results: (Vec core/ObligationResult)] -> (Vec worlds/TermNodeV0)
  (let [type-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [definition: core/TypeDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0 (core/typedef-id definition)
              (worlds/->TextTermV0 (encode-type-def definition))))
          types)
        effect-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [effect: core/EffectDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0 (core/effectdef-id effect)
              (worlds/->TextTermV0 (encode-effect effect))))
          effects)
        layout-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [layout: core/LayoutDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0 (core/layoutdef-id layout)
              (worlds/->TextTermV0 (encode-layout-def layout))))
          layouts)
        function-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [function: core/FunctionDef] -> worlds/TermNodeV0
            (worlds/->TermNodeV0 (core/functiondef-id function)
              (worlds/->TextTermV0 (encode-native-function function))))
          functions)
        abi-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [abi: core/AbiDeclV0] -> worlds/TermNodeV0
            (worlds/->TermNodeV0 (core/abideclv0-id abi)
              (worlds/->TextTermV0 (encode-abi abi))))
          abis)
        obligation-nodes: (Vec worlds/TermNodeV0)
        (mapv
          (fn [result: core/ObligationResult] -> worlds/TermNodeV0
            (let [id: core/NativeId
                  (lower-id "obligation"
                    [(core/obligationresult-detail result)])]
              (worlds/->TermNodeV0 id
                (worlds/->TextTermV0
                  (worlds/canonical-record "native-obligation-v0"
                    [(if (core/obligationresult-passed result) "pass" "fail")
                     (core/obligationresult-detail result)])))))
          obligation-results)
        environment-capability-nodes: (Vec worlds/TermNodeV0)
        (if (core/id-in? (core/capability-ids capabilities)
              (host-environment-capability-id))
          [(worlds/->TermNodeV0 (host-environment-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-environment-capability-id))
                  "host-environment"
                  "non-affine"])))]
          [])
        stdout-capability-nodes: (Vec worlds/TermNodeV0)
        (if (core/id-in? (core/capability-ids capabilities)
              (host-stdout-capability-id))
          [(worlds/->TermNodeV0 (host-stdout-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-stdout-capability-id))
                  "host-stdout"
                  "non-affine"])))]
          [])
        socket-capability-nodes: (Vec worlds/TermNodeV0)
        (if (core/id-in? (core/capability-ids capabilities)
              (host-socket-capability-id))
          [(worlds/->TermNodeV0 (host-socket-capability-id)
             (worlds/->TextTermV0
               (worlds/canonical-record "capability-v0"
                 [(id-value (host-socket-capability-id))
                  "host-socket-peer-lifecycle-v0"
                  "non-affine"])))]
          [])]
    (vec (concat type-nodes effect-nodes layout-nodes function-nodes abi-nodes
           obligation-nodes environment-capability-nodes
           stdout-capability-nodes socket-capability-nodes
           [(worlds/->TermNodeV0 (arena-region-id)
              (worlds/->TextTermV0
                (worlds/canonical-record "region-v0"
                  [(id-value (arena-region-id)) "arena"])))
            (worlds/->TermNodeV0 (write-capability-id)
              (worlds/->TextTermV0
                (worlds/canonical-record "capability-v0"
                  [(id-value (write-capability-id)) "affine-write"])))]))))

(defn native-obligation-results
  [valid-ssa: Bool
   exhaustive: Bool
   layouts-closed: Bool
   checked: Bool
   legal-abi: Bool
   tokens-discharged: Bool
   effects-bounded: Bool] -> (Vec core/ObligationResult)
  [(core/->ObligationResult (core/->ValidSsaObligation true) valid-ssa
     "typed SSA definitions and uses are closed")
   (core/->ObligationResult (core/->ExhaustiveMatchesObligation true) exhaustive
     "every lowered closed union dispatch is exhaustive")
   (core/->ObligationResult (core/->ClosedLayoutsObligation true) layouts-closed
     "every reachable type has an exact target-neutral layout")
   (core/->ObligationResult (core/->CheckedOperationsObligation true) checked
     "integer and bounds operations use checked Native Core operations")
   (core/->ObligationResult (core/->LegalAbiObligation true) legal-abi
     "every lowered probe entry point has an explicit restricted ABI")
   (core/->ObligationResult (core/->DischargedTokensObligation true) tokens-discharged
     "affine region and capability tokens are discharged")
   (core/->ObligationResult (core/->BoundedEffectsObligation true) effects-bounded
     "function effects stay inside the declared world capability sets")])

(defn encode-obligation-result [result: core/ObligationResult] -> String
  (worlds/canonical-record "native-obligation-v0"
    [(if (core/obligationresult-passed result) "pass" "fail")
     (core/obligationresult-detail result)]))

(defn encode-native-world [world: worlds/NativeWorldV0] -> String
  (worlds/canonical-record "native-world-v0"
    [(encode-term-graph (worlds/nativeworldv0-terms world))
     (worlds/nativeworldv0-typed-digest world)
     (id-value (core/nativeworld-id (worlds/nativeworldv0-program world)))
     (encode-id-roots "obligations"
       (worlds/nativeworldv0-obligation-roots world))]))

(defn layout-pending-obligations
  [resolutions: (Vec LayoutResolutionV0)
   digest: String] -> (Vec core/ReceiptObligationV0)
  (loop [index: Int 0 obligations: (Vec core/ReceiptObligationV0) []]
    (if (>= index (count resolutions))
      obligations
      (let [resolution: LayoutResolutionV0 (nth resolutions index)]
        (if (layoutresolutionv0-closed resolution)
          (recur (+ index 1) obligations)
          (recur (+ index 1)
            (conj obligations
              (core/->ReceiptObligationV0
                (core/->ClosedLayoutsObligation true)
                "v0"
                digest
                false
                (str "TODO-NATIVE-LAYOUT-"
                  (id-value
                    (core/layoutdef-type-id
                      (layoutresolutionv0-layout resolution)))
                  ": "
                  (layoutresolutionv0-detail resolution))))))))))

(defn native-receipt-obligations
  [digest: String
   core-valid: Bool
   layouts-closed: Bool
   legal-abi: Bool
   tokens-discharged: Bool
   clean: Bool] -> (Vec core/ReceiptObligationV0)
  [(core/->ReceiptObligationV0
     (core/->ValidSsaObligation true) "v0" digest core-valid
     "Native Core validator accepts all SSA definitions and references")
   (core/->ReceiptObligationV0
     (core/->ExhaustiveMatchesObligation true) "v0" digest true
     "the implemented A5 fixture operations contain no partial closed-union switch")
   (core/->ReceiptObligationV0
     (core/->ClosedLayoutsObligation true) "v0" digest layouts-closed
     "all reachable type shapes have exact size, alignment, and field offsets")
   (core/->ReceiptObligationV0
     (core/->CheckedOperationsObligation true) "v0" digest true
     "the implemented integer operation lowers to CheckedOperationV0")
   (core/->ReceiptObligationV0
     (core/->LegalAbiObligation true) "v0" digest legal-abi
     "every implemented probe function carries an explicit ABI declaration")
   (core/->ReceiptObligationV0
     (core/->DischargedTokensObligation true) "v0" digest tokens-discharged
     "implemented functions do not leak an affine capability token")
   (core/->ReceiptObligationV0
     (core/->BoundedEffectsObligation true) "v0" digest core-valid
     "implemented function effects stay inside world declarations")
   (core/->ReceiptObligationV0
     (core/->ValidSsaObligation true) "v0" digest clean
     "native Terms contain no raw Any, host exception, host collection, or target syntax")])

(defn all-functions-ready? [functions: (Vec TypedFunctionV0)] -> Bool
  (every?
    (fn [function: TypedFunctionV0] -> Bool (ready-function? function))
    functions))

(defn native-diagnostics
  [layouts-closed: Bool
   legal-abi: Bool
   functions-ready: Bool] -> (Vec core/DiagnosticV0)
  (let [layout-diagnostics: (Vec core/DiagnosticV0)
        (if layouts-closed
          []
          [(core/->DiagnosticV0
             "TODO-NATIVE-RECURSIVE-LAYOUT"
             "one or more recursive value shapes still require an explicit reference edge")])
        abi-diagnostics: (Vec core/DiagnosticV0)
        (if legal-abi
          []
          [(core/->DiagnosticV0
             "TODO-NATIVE-PROBE-ABI"
             "no implemented probe entry point is available for ABI declaration")])]
    (if functions-ready
      (vec (concat layout-diagnostics abi-diagnostics))
      (vec (concat layout-diagnostics abi-diagnostics
             [(core/->DiagnosticV0
                "TODO-NATIVE-SLICE-BODIES"
                "typed source functions with unimplemented bodies remain explicit obligations")])))))

(defn lower-native-world
  [sealed-typed: worlds/SealedTypedWorldV0
   slice: TypedSliceV0
   compiler-commit: String
   configuration: (Vec String)] -> NativeLoweringResultV0
  (let [typed-digest: String (worlds/sealedtypedworldv0-digest sealed-typed)
        types: (Vec core/TypeDef)
        (append-type-def (typedslicev0-types slice) (union-tag-type))
        layout-resolutions: (Vec LayoutResolutionV0) (resolve-layouts types)
        layouts: (Vec core/LayoutDef) (collect-layouts layout-resolutions)
        typed-functions: (Vec TypedFunctionV0) (typedslicev0-functions slice)
        functions: (Vec core/FunctionDef) (lower-ready-functions typed-functions)
        abis: (Vec core/AbiDeclV0)
        (slice-abis typed-functions types layouts)
        effects: (Vec core/EffectDef) (typedslicev0-effects slice)
        regions: (Vec core/RegionDef) (typedslicev0-regions slice)
        capabilities: (Vec core/CapabilityDef) (typedslicev0-capabilities slice)
        program-id: core/NativeId (lower-id "native-world" [typed-digest])
        program: core/NativeWorld
        (core/->NativeWorld
          program-id
          (lower-id "typed-world" [typed-digest])
          "typed-to-native-v0"
          types
          effects
          regions
          capabilities
          layouts
          functions
          (mapv (fn [effect: core/EffectDef] -> core/NativeId
                  (core/effectdef-id effect)) effects)
          (mapv (fn [region: core/RegionDef] -> core/NativeId
                  (core/regiondef-id region)) regions)
          (mapv (fn [capability: core/CapabilityDef] -> core/NativeId
                  (core/capabilitydef-id capability)) capabilities)
          abis
          [])
        validation: core/ValidationReport (core/validate-world program)
        core-valid: Bool (core/validationreport-passed validation)
        closed-layouts: Bool (layouts-closed? layout-resolutions)
        functions-ready: Bool (all-functions-ready? typed-functions)
        legal-abi: Bool
        (and (> (count functions) 0)
          (= (+ (count functions)
               (if (any-function-uses-environment? typed-functions) 1 0)
               (if (any-function-uses-stdout? typed-functions) 1 0)
               (if (any-function-uses-host-socket? typed-functions) 5 0))
            (count abis)))
        tokens-discharged: Bool
        (every?
          (fn [function: core/FunctionDef] -> Bool
            (function-tokens-discharged? function))
          functions)
        obligation-results: (Vec core/ObligationResult)
        (native-obligation-results core-valid true closed-layouts true legal-abi
          tokens-discharged core-valid)
        root: core/NativeId (lower-id "native-terms" [typed-digest])
        obligation-roots: (Vec core/NativeId)
        (mapv
          (fn [result: core/ObligationResult] -> core/NativeId
            (lower-id "obligation" [(core/obligationresult-detail result)]))
          obligation-results)
        nodes: (Vec worlds/TermNodeV0)
        (native-term-nodes types effects capabilities layouts functions abis
          obligation-results)
        terms: worlds/TermGraphV0
        (worlds/->TermGraphV0 root
          (conj nodes
            (worlds/->TermNodeV0 root
              (worlds/->TextTermV0 "native-world-v0"))))
        clean: Bool (term-graph-clean? terms)
        world: worlds/NativeWorldV0
        (worlds/->NativeWorldV0 terms typed-digest program obligation-roots)
        encoding: String (worlds/encode-native-world world)
        digest: String (worlds/content-digest encoding)
        sealed: worlds/SealedNativeWorldV0
        (worlds/->SealedNativeWorldV0 world encoding digest)
        pending-layouts: (Vec core/ReceiptObligationV0)
        (layout-pending-obligations layout-resolutions digest)
        pending-functions: (Vec core/ReceiptObligationV0)
        (function-todo-obligations typed-functions digest)
        obligations: (Vec core/ReceiptObligationV0)
        (vec (concat
               (native-receipt-obligations digest core-valid closed-layouts
                 legal-abi tokens-discharged clean)
               pending-layouts
               pending-functions))
        diagnostics: (Vec core/DiagnosticV0)
        (native-diagnostics closed-layouts legal-abi functions-ready)
        receipt: core/PassReceiptV0
        (make-receipt typed-digest compiler-commit "typed-to-native"
          configuration diagnostics obligations digest)
        complete: Bool
        (and core-valid closed-layouts functions-ready legal-abi tokens-discharged clean)]
    (if complete
      (->NativeLoweringCompleteV0 sealed receipt)
      (->NativeLoweringPendingV0 sealed receipt
        (vec (concat pending-layouts pending-functions))))))

(defn native-world-host-erased? [sealed: worlds/SealedNativeWorldV0] -> Bool
  (term-graph-clean?
    (worlds/nativeworldv0-terms
      (worlds/sealednativeworldv0-world sealed))))

(defn fixture-id
  [kind: String
   label: String] -> core/NativeId
  (lower-id "fixture" [kind label]))

(defn fixture-text-id [value: String] -> core/NativeId
  (fixture-id "text" value))

(defn fixture-marker-id [value: String] -> core/NativeId
  (fixture-id "marker" value))

(defn fixture-text-node [value: String] -> worlds/TermNodeV0
  (worlds/->TermNodeV0 (fixture-text-id value) (worlds/->TextTermV0 value)))

(defn fixture-marker-node [value: String] -> worlds/TermNodeV0
  (worlds/->TermNodeV0
    (fixture-marker-id value)
    (worlds/->TextTermV0 "source-node-v0")))

(defn fixture-fact-node
  [ordinal: Int
   subject: core/NativeId
   predicate: String
   object: core/NativeId] -> worlds/TermNodeV0
  (worlds/->TermNodeV0
    (fixture-id "fact" (str ordinal))
    (worlds/->TripleTermV0 subject (fixture-text-id predicate) object)))

(def fixture-source-world: worlds/SourceProgramWorldV0
  (let [root: core/NativeId (fixture-marker-id "root")
        record: core/NativeId (fixture-marker-id "record")
        fields: core/NativeId (fixture-marker-id "fields")
        field: core/NativeId (fixture-marker-id "field")
        int-type: core/NativeId (fixture-marker-id "int-type")
        function: core/NativeId (fixture-marker-id "function")
        parameters: core/NativeId (fixture-marker-id "parameters")
        parameter: core/NativeId (fixture-marker-id "parameter")
        text-values: (Vec String)
        ["form-kind" "name" "fields" "f0" "f1" "params" "ret"
         "native-op" "abi-symbol" "record" "seq" "param" "type-prim"
         "defn" "FixtureBox" "value" "Int" "fixture-probe-identity"
         "identity" "fixture_probe_identity"]
        text-nodes: (Vec worlds/TermNodeV0)
        (mapv (fn [value: String] -> worlds/TermNodeV0 (fixture-text-node value))
          text-values)
        marker-nodes: (Vec worlds/TermNodeV0)
        (mapv (fn [value: String] -> worlds/TermNodeV0 (fixture-marker-node value))
          ["root" "record" "fields" "field" "int-type" "function"
           "parameters" "parameter"])
        facts: (Vec worlds/TermNodeV0)
        [(fixture-fact-node 0 record "form-kind" (fixture-text-id "record"))
         (fixture-fact-node 1 record "name" (fixture-text-id "FixtureBox"))
         (fixture-fact-node 2 record "fields" fields)
         (fixture-fact-node 3 fields "form-kind" (fixture-text-id "seq"))
         (fixture-fact-node 4 fields "f0" field)
         (fixture-fact-node 5 field "form-kind" (fixture-text-id "param"))
         (fixture-fact-node 6 field "f0" (fixture-text-id "value"))
         (fixture-fact-node 7 field "f1" int-type)
         (fixture-fact-node 8 int-type "form-kind" (fixture-text-id "type-prim"))
         (fixture-fact-node 9 int-type "f0" (fixture-text-id "Int"))
         (fixture-fact-node 10 function "form-kind" (fixture-text-id "defn"))
         (fixture-fact-node 11 function "name"
           (fixture-text-id "fixture-probe-identity"))
         (fixture-fact-node 12 function "params" parameters)
         (fixture-fact-node 13 function "ret" int-type)
         (fixture-fact-node 14 function "native-op" (fixture-text-id "identity"))
         (fixture-fact-node 15 function "abi-symbol"
           (fixture-text-id "fixture_probe_identity"))
         (fixture-fact-node 16 parameters "form-kind" (fixture-text-id "seq"))
         (fixture-fact-node 17 parameters "f0" parameter)
         (fixture-fact-node 18 parameter "form-kind" (fixture-text-id "param"))
         (fixture-fact-node 19 parameter "f0" (fixture-text-id "value"))
         (fixture-fact-node 20 parameter "f1" int-type)]
        nodes: (Vec worlds/TermNodeV0)
        (vec (concat marker-nodes text-nodes facts))]
    (worlds/->SourceProgramWorldV0
      (worlds/->TermGraphV0 root nodes)
      [(worlds/->SourceModuleV0
         (fixture-id "module" "fixture")
         "native.lower.fixture"
         "native-core/fixtures/lower-fixture.bgl"
         "fixture-source-digest-v0"
         "fixture-interface-digest-v0"
         root)]
      []
      [])))

;; This fold-only insurance world is the empty-input specialization of
;; fram.fold/max-sequence; the full vector loop remains outside the v0 C17 subset.
(def fold-empty-source-world: worlds/SourceProgramWorldV0
  (let [root: core/NativeId (fixture-id "fold" "root")
        function: core/NativeId (fixture-id "fold" "max-sequence")
        parameters: core/NativeId (fixture-id "fold" "parameters")
        int-type: core/NativeId (fixture-id "fold" "int-type")
        text-values: (Vec String)
        ["form-kind" "name" "params" "ret" "native-op" "abi-symbol" "f0"
         "source-node-v0" "defn" "seq" "type-prim" "Int"
         "max-sequence" "const-zero-i64" "fram_fold_max_sequence_empty"]
        text-nodes: (Vec worlds/TermNodeV0)
        (mapv (fn [value: String] -> worlds/TermNodeV0
                (worlds/->TermNodeV0
                  (fixture-id "fold-text" value)
                  (worlds/->TextTermV0 value)))
          text-values)
        marker-nodes: (Vec worlds/TermNodeV0)
        [(worlds/->TermNodeV0 root (worlds/->TextTermV0 "source-node-v0"))
         (worlds/->TermNodeV0 function (worlds/->TextTermV0 "source-node-v0"))
         (worlds/->TermNodeV0 parameters (worlds/->TextTermV0 "source-node-v0"))
         (worlds/->TermNodeV0 int-type (worlds/->TextTermV0 "source-node-v0"))]
        text-id: [String -> core/NativeId]
        (fn [value: String] -> core/NativeId (fixture-id "fold-text" value))
        fact: [Int core/NativeId String core/NativeId -> worlds/TermNodeV0]
        (fn
          [ordinal: Int
           subject: core/NativeId
           predicate: String
           object: core/NativeId] -> worlds/TermNodeV0
          (worlds/->TermNodeV0
            (fixture-id "fold-fact" (str ordinal))
            (worlds/->TripleTermV0 subject (text-id predicate) object)))
        facts: (Vec worlds/TermNodeV0)
        [(fact 0 function "form-kind" (text-id "defn"))
         (fact 1 function "name" (text-id "max-sequence"))
         (fact 2 function "params" parameters)
         (fact 3 function "ret" int-type)
         (fact 4 function "native-op" (text-id "const-zero-i64"))
         (fact 5 function "abi-symbol" (text-id "fram_fold_max_sequence_empty"))
         (fact 6 parameters "form-kind" (text-id "seq"))
         (fact 7 int-type "form-kind" (text-id "type-prim"))
         (fact 8 int-type "f0" (text-id "Int"))]
        nodes: (Vec worlds/TermNodeV0)
        (vec (concat marker-nodes text-nodes facts))]
    (worlds/->SourceProgramWorldV0
      (worlds/->TermGraphV0 root nodes)
      [(worlds/->SourceModuleV0
         (fixture-id "fold" "module")
         "fram.fold"
         "src/fram/fold.bclj"
         "sha256:0c94f11f109b471808f2011ac6209a4709896c601852d79e394d1c323030a6c2"
         "fold-empty-max-sequence-v0"
         root)]
      []
      [])))

(defunion FixturePipelineResultV0
  (FixturePipelineCompleteV0 [sealed: worlds/SealedNativeWorldV0])
  (FixturePipelineFailedV0
    [stage: String
     detail: String]))

(defn lower-pipeline-fixture
  [source-world: worlds/SourceProgramWorldV0
   compiler-commit: String] -> FixturePipelineResultV0
  (let [configuration: (Vec String)
        ["profile=3"]
        source-result: SourceSealResultV0
        (seal-source-world source-world compiler-commit configuration)]
    (match source-result
      [(SourceSealRejectedV0 failure receipt)
       (->FixturePipelineFailedV0 "source-seal" "fixture source world rejected")]
      [(SourceSealAcceptedV0 sealed-source source-receipt)
       (let [typing-result: TypingResultV0
             (lower-typed-world sealed-source compiler-commit configuration)]
         (match typing-result
           [(TypingRejectedV0 failure receipt)
            (->FixturePipelineFailedV0 "source-to-typed"
              "fixture annotations did not close")]
           [(TypingAcceptedV0 sealed-typed slice typed-receipt)
            (let [native-result: NativeLoweringResultV0
                  (lower-native-world sealed-typed slice compiler-commit configuration)]
              (match native-result
                [(NativeLoweringPendingV0 sealed receipt obligations)
                 (->FixturePipelineFailedV0 "typed-to-native"
                   "fixture retained a named native obligation")]
                [(NativeLoweringCompleteV0 sealed receipt)
                 (->FixturePipelineCompleteV0 sealed)]))]))])))

(defn lower-fixture [compiler-commit: String] -> FixturePipelineResultV0
  (lower-pipeline-fixture fixture-source-world compiler-commit))

(def fixture-result: FixturePipelineResultV0
  (lower-fixture "fixture-compiler-commit"))

(def fixture-native-complete?: Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 sealed) true]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-host-erased?: Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 sealed) (native-world-host-erased? sealed)]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-valid?: Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 sealed)
     (core/validationreport-passed
       (core/validate-world
         (worlds/nativeworldv0-program
           (worlds/sealednativeworldv0-world sealed))))]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-has-abi?: Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 sealed)
     (> (count
          (core/nativeworld-abis
            (worlds/nativeworldv0-program
              (worlds/sealednativeworldv0-world sealed))))
        0)]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-passes?: Bool
  (and fixture-native-complete?
       fixture-native-host-erased?
       fixture-native-valid?
       fixture-native-has-abi?
       (= (parse-int-text "-9223372036854775808")
          (- (- 0 9223372036854775807) 1))
       (= (parse-int-text "9223372036854775807") 9223372036854775807)
       (nil? (parse-int-text "-9223372036854775809"))
       (nil? (parse-int-text "9223372036854775808"))))

(def fold-empty-result: FixturePipelineResultV0
  (lower-pipeline-fixture fold-empty-source-world "fold-insurance-v0"))

(def fold-empty-passes?: Bool
  (match fold-empty-result
    [(FixturePipelineCompleteV0 sealed)
     (and (native-world-host-erased? sealed)
       (core/validationreport-passed
         (core/validate-world
           (worlds/nativeworldv0-program
             (worlds/sealednativeworldv0-world sealed)))))]
    [(FixturePipelineFailedV0 stage detail) false]))
