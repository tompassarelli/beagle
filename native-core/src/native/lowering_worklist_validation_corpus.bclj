#lang beagle/clj
(ns native.lowering-worklist-validation-corpus
  (:require [native.core :as core]
            [native.lower :as lower]
            [native.stages :as stages]))


(defrecord StageArtifactsV0
  [(typed-encoding String)
   (typed-digest String)
   (typed-receipt String)
   (native-encoding String)
   (native-digest String)
   (native-receipt String)])

(defrecord WorklistGateRunV0
  [(function-count Int)
   (call-edge-count Int)
   (effect-kind-count Int)
   (readiness-edge-visits Int)
   (effect-edge-visits Int)
   (reference-artifacts String)
   (optimized-artifacts String)
   (reference-equals-optimized Bool)
   (unaffected-component-unchanged Bool)
   (readiness-closure-correct Bool)
   (effect-closure-correct Bool)
   (mixed-closure-correct Bool)
   (bounds-hold Bool)])

(defn corpus-id [(kind String) (position Int)] core/NativeId
  (core/canonical-id "native-lowering-worklist-corpus-v0"
    [kind (str position)]))

(defn corpus-edge-id [(caller Int) (target-position Int)] core/NativeId
  (core/canonical-id "native-lowering-worklist-corpus-v0/edge"
    [(str caller) (str target-position)]))

(defn call-target-indices [(position Int)] (Vec Int)
  (cond
    (= position 0) []
    (<= position 223)
    (if (>= position 112)
      [(- position 1) (- position 112)]
      [(- position 1)])
    (= position 224) []
    :else [(- position 1)]))

(defn corpus-instructions [(position Int)] (Vec core/Instruction)
  (let [(targets (Vec Int)) (call-target-indices position)]
    (mapv
      (fn [(target-position Int)] core/Instruction
        (core/->CallInstruction
          (core/->SsaValueV0
            (corpus-edge-id position target-position)
            (lower/int-type-id))
          (corpus-id "function" target-position)
          []
          nil
          (core/->TokenFlowV0 [] [])))
      targets)))

(defn effect-seed [] (Vec core/NativeId)
  (vec (rest (lower/closure-effect-order))))

(defn corpus-readiness
  [(scenario String) (position Int)] lower/NativeReadinessV0
  (if (and (or (= scenario "readiness") (= scenario "mixed"))
        (= position 0))
    (lower/->NativeTodoV0 "CORPUS-NOT-READY"
      "the deterministic readiness seed is not lowered")
    (let [(block-id core/NativeId) (corpus-id "block" position)]
      (lower/->NativeLoweredV0 block-id
        [(core/->BasicBlock block-id [] (corpus-instructions position)
           [(core/->ReturnTerminator nil)])]))))

(defn corpus-function [(scenario String) (position Int)] lower/TypedFunctionV0
  (let [(id core/NativeId) (corpus-id "function" position)
        (name String) (str "worklist-function-" position)
        (effects (Vec core/NativeId))
        (if (and (or (= scenario "effects") (= scenario "mixed"))
              (= position 0))
          (effect-seed)
          [])
        (readiness lower/NativeReadinessV0)
        (corpus-readiness scenario position)]
    (lower/->TypedFunctionV0
      id
      name
      (str "worklist_function_" position)
      []
      (lower/type-id "Nil")
      (lower/type-id "LowerFailure")
      effects
      readiness
      (lower/encode-typed-function id name (str "worklist_function_" position)
        [] (lower/type-id "Nil") (lower/type-id "LowerFailure") effects
        (lower/readiness-code readiness)))))

(defn corpus-functions [(scenario String)] (Vec lower/TypedFunctionV0)
  (loop [position Int 0 functions (Vec lower/TypedFunctionV0) []]
    (if (>= position 256)
      functions
      (recur (+ position 1)
        (conj functions (corpus-function scenario position))))))

;; This is the pre-worklist reference semantics: whole-set readiness rounds,
;; then one whole-set fixed point for each serialized effect in exact order.
(defn reference-settle-readiness
  [(functions (Vec lower/TypedFunctionV0))] (Vec lower/TypedFunctionV0)
  (loop [round Int 0 current (Vec lower/TypedFunctionV0) functions]
    (if (> round (count functions))
      current
      (let [(ready (Vec core/NativeId))
            (loop [position Int 0 ids (Vec core/NativeId) []]
              (if (>= position (count current))
                ids
                (let [(function lower/TypedFunctionV0) (nth current position)]
                  (recur (+ position 1)
                    (if (lower/ready-function? function)
                      (conj ids (lower/typedfunctionv0-id function))
                      ids)))))
            (next (Vec lower/TypedFunctionV0))
            (mapv
              (fn [(function lower/TypedFunctionV0)] lower/TypedFunctionV0
                (if (and (lower/ready-function? function)
                      (not (core/ids-in?
                             (lower/body-call-targets function) ready)))
                  (with function
                    [:readiness
                     (lower/->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
                       (str "TODO-NATIVE-CALLEE: "
                         (lower/typedfunctionv0-name function)
                         " calls a function whose own body is not lowered"))])
                  function))
              current)
            (settled Bool)
            (loop [position Int 0]
              (if (>= position (count current))
                true
                (if (= (lower/ready-function? (nth current position))
                       (lower/ready-function? (nth next position)))
                  (recur (+ position 1))
                  false)))]
        (if settled current (recur (+ round 1) next))))))

(defn reference-settle-effect
  [(functions (Vec lower/TypedFunctionV0))
   (effect-id core/NativeId)]
  (Vec lower/TypedFunctionV0)
  (loop [round Int 0 current (Vec lower/TypedFunctionV0) functions]
    (if (> round (count functions))
      current
      (let [(effectful (Vec core/NativeId))
            (loop [position Int 0 ids (Vec core/NativeId) []]
              (if (>= position (count current))
                ids
                (let [(function lower/TypedFunctionV0) (nth current position)]
                  (recur (+ position 1)
                    (if (core/id-in?
                          (lower/typedfunctionv0-effects function) effect-id)
                      (conj ids (lower/typedfunctionv0-id function))
                      ids)))))
            (next (Vec lower/TypedFunctionV0))
            (mapv
              (fn [(function lower/TypedFunctionV0)] lower/TypedFunctionV0
                (let [(targets (Vec core/NativeId))
                      (lower/body-call-targets function)
                      (prior-effects (Vec core/NativeId))
                      (lower/typedfunctionv0-effects function)
                      (needs-effect Bool)
                      (some? (some
                               (fn [(target core/NativeId)] Bool
                                 (core/id-in? effectful target))
                               targets))
                      (effects (Vec core/NativeId))
                      (if needs-effect
                        (lower/with-effect prior-effects effect-id)
                        prior-effects)]
                  (if (= (count prior-effects) (count effects))
                    function
                    (with
                      (with function [:effects effects])
                      [:encoding
                       (lower/encode-typed-function
                         (lower/typedfunctionv0-id function)
                         (lower/typedfunctionv0-name function)
                         (lower/typedfunctionv0-abi-symbol function)
                         (lower/typedfunctionv0-parameters function)
                         (lower/typedfunctionv0-return-type function)
                         (lower/typedfunctionv0-failure-type function)
                         effects
                         (lower/readiness-code
                           (lower/typedfunctionv0-readiness function)))]))))
              current)
            (settled Bool)
            (loop [position Int 0]
              (if (>= position (count current))
                true
                (if (=
                      (count
                        (lower/typedfunctionv0-effects
                          (nth current position)))
                      (count
                        (lower/typedfunctionv0-effects (nth next position))))
                  (recur (+ position 1))
                  false)))]
        (if settled current (recur (+ round 1) next))))))

(defn reference-settle-effects
  [(functions (Vec lower/TypedFunctionV0))] (Vec lower/TypedFunctionV0)
  (let [(order (Vec core/NativeId)) (lower/closure-effect-order)]
    (loop [position Int 0 current (Vec lower/TypedFunctionV0) functions]
      (if (>= position (count order))
        current
        (recur (+ position 1)
          (reference-settle-effect current (nth order position)))))))

(defn reference-settle-functions
  [(functions (Vec lower/TypedFunctionV0))] (Vec lower/TypedFunctionV0)
  (reference-settle-effects (reference-settle-readiness functions)))

(defn typed-stage-artifacts
  [(label String) (functions (Vec lower/TypedFunctionV0))] StageArtifactsV0
  (let [(types (Vec core/TypeDef)) (lower/builtin-types [])
        (effects (Vec core/EffectDef))
        (lower/slice-effects true true true true true true true true)
        (regions (Vec core/RegionDef)) (lower/slice-regions)
        (capabilities (Vec core/CapabilityDef))
        (lower/slice-capabilities true true true true true true true true)
        (source-digest String)
        (stages/content-digest
          (stages/canonical-record "lowering-worklist-source-v0" [label]))
        (typed-root core/NativeId)
        (lower/lower-id "lowering-worklist-validation-typed" [label])
        (typed-terms stages/TermGraphV0)
        (stages/->TermGraphV0 typed-root
          (conj
            (lower/typed-term-nodes types functions effects
              true true true true true true true true)
            (stages/->TermNodeV0 typed-root
              (stages/->TextTermV0 "typed-stage-v0"))))
        (typed-stage stages/TypedStageV0)
        (stages/->TypedStageV0
          typed-terms
          source-digest
          (mapv
            (fn [(definition core/TypeDef)] core/NativeId
              (core/typedef-id definition))
            types)
          (mapv
            (fn [(function lower/TypedFunctionV0)] core/NativeId
              (lower/typedfunctionv0-id function))
            functions)
          (mapv
            (fn [(effect core/EffectDef)] core/NativeId
              (core/effectdef-id effect))
            effects)
          (mapv
            (fn [(region core/RegionDef)] core/NativeId
              (core/regiondef-id region))
            regions)
          (mapv
            (fn [(capability core/CapabilityDef)] core/NativeId
              (core/capabilitydef-id capability))
            capabilities)
          [(lower/type-id "LowerFailure")])
        (typed-encoding String) (stages/encode-typed-stage typed-stage)
        (typed-digest String) (stages/content-digest typed-encoding)
        (typed-receipt String)
        (stages/encode-pass-receipt
          (lower/make-receipt source-digest "lowering-worklist-validation-v0"
            "source-to-typed" [] [] [] typed-digest))
        (layouts (Vec core/LayoutDef))
        (lower/collect-layouts
          (lower/resolve-layouts types (core/abi-profile-lp64)))
        (native-functions (Vec core/FunctionDef))
        (lower/lower-ready-functions functions)
        (abis (Vec core/AbiDeclV0))
        (lower/function-abis functions native-functions layouts)
        (native-root core/NativeId)
        (lower/lower-id "lowering-worklist-validation-native" [typed-digest])
        (native-terms stages/TermGraphV0)
        (stages/->TermGraphV0 native-root
          (conj
            (lower/native-term-nodes types effects capabilities layouts
              native-functions abis [])
            (stages/->TermNodeV0 native-root
              (stages/->TextTermV0 "native-stage-v0"))))
        (program core/NativeCoreProgram)
        (core/->NativeCoreProgram
          (lower/lower-id "lowering-worklist-validation-program" [typed-digest])
          (lower/lower-id "typed-stage" [typed-digest])
          "typed-to-native-v0"
          types
          effects
          regions
          capabilities
          layouts
          native-functions
          (mapv
            (fn [(effect core/EffectDef)] core/NativeId
              (core/effectdef-id effect))
            effects)
          (mapv
            (fn [(region core/RegionDef)] core/NativeId
              (core/regiondef-id region))
            regions)
          (mapv
            (fn [(capability core/CapabilityDef)] core/NativeId
              (core/capabilitydef-id capability))
            capabilities)
          abis
          [])
        (native-stage stages/NativeStageV0)
        (stages/->NativeStageV0 native-terms typed-digest program [])
        (native-encoding String) (stages/encode-native-stage native-stage)
        (native-digest String) (stages/content-digest native-encoding)
        (native-receipt String)
        (stages/encode-pass-receipt
          (lower/make-receipt typed-digest "lowering-worklist-validation-v0"
            "typed-to-native" [] [] [] native-digest))]
    (->StageArtifactsV0 typed-encoding typed-digest typed-receipt
      native-encoding native-digest native-receipt)))

(defn encode-stage-artifacts [(artifacts StageArtifactsV0)] String
  (stages/canonical-record "lowering-worklist-stage-artifacts-v0"
    [(stageartifactsv0-typed-encoding artifacts)
     (stageartifactsv0-typed-digest artifacts)
     (stageartifactsv0-typed-receipt artifacts)
     (stageartifactsv0-native-encoding artifacts)
     (stageartifactsv0-native-digest artifacts)
     (stageartifactsv0-native-receipt artifacts)]))

(defn encode-scenario-artifacts
  [(effect-artifacts StageArtifactsV0)
   (readiness-artifacts StageArtifactsV0)
   (mixed-artifacts StageArtifactsV0)]
  String
  (stages/canonical-record "lowering-worklist-scenarios-v0"
    [(encode-stage-artifacts effect-artifacts)
     (encode-stage-artifacts readiness-artifacts)
     (encode-stage-artifacts mixed-artifacts)]))

(defn range-unchanged?
  [(before (Vec lower/TypedFunctionV0))
   (after (Vec lower/TypedFunctionV0))
   (start Int)]
  Bool
  (loop [position Int start]
    (if (>= position (count before))
      true
      (if (= (nth before position) (nth after position))
        (recur (+ position 1))
        false))))

(defn readiness-closure-correct? [(functions (Vec lower/TypedFunctionV0))] Bool
  (loop [position Int 0]
    (if (>= position (count functions))
      true
      (let [(expected Bool) (>= position 224)
            (actual Bool) (lower/ready-function? (nth functions position))]
        (if (= expected actual) (recur (+ position 1)) false)))))

(defn effect-closure-correct? [(functions (Vec lower/TypedFunctionV0))] Bool
  (let [(expected (Vec core/NativeId)) (effect-seed)]
    (loop [position Int 0]
      (if (>= position (count functions))
        true
        (let [(actual (Vec core/NativeId))
              (lower/typedfunctionv0-effects (nth functions position))
              (correct Bool)
              (if (< position 224) (= expected actual) (= [] actual))]
          (if correct (recur (+ position 1)) false))))))

(defn mixed-closure-correct? [(functions (Vec lower/TypedFunctionV0))] Bool
  (let [(expected-effects (Vec core/NativeId)) (effect-seed)]
    (loop [position Int 0]
      (if (>= position (count functions))
        true
        (let [(function lower/TypedFunctionV0) (nth functions position)
              (expected-ready Bool) (>= position 224)
              (expected-function-effects (Vec core/NativeId))
              (if (= position 0) expected-effects [])
              (correct Bool)
              (and (= expected-ready (lower/ready-function? function))
                (= expected-function-effects
                  (lower/typedfunctionv0-effects function)))]
          (if correct (recur (+ position 1)) false))))))

(defn run-worklist-gate [] WorklistGateRunV0
  (let [(effect-input (Vec lower/TypedFunctionV0))
        (corpus-functions "effects")
        (readiness-input (Vec lower/TypedFunctionV0))
        (corpus-functions "readiness")
        (mixed-input (Vec lower/TypedFunctionV0))
        (corpus-functions "mixed")
        (effect-reference (Vec lower/TypedFunctionV0))
        (reference-settle-functions effect-input)
        (readiness-reference (Vec lower/TypedFunctionV0))
        (reference-settle-functions readiness-input)
        (mixed-reference (Vec lower/TypedFunctionV0))
        (reference-settle-functions mixed-input)
        (effect-optimized lower/FunctionClosureSettlementV0)
        (lower/settle-function-closures-with-metrics effect-input)
        (readiness-optimized lower/FunctionClosureSettlementV0)
        (lower/settle-function-closures-with-metrics readiness-input)
        (mixed-optimized lower/FunctionClosureSettlementV0)
        (lower/settle-function-closures-with-metrics mixed-input)
        (effect-functions (Vec lower/TypedFunctionV0))
        (lower/functionclosuresettlementv0-functions effect-optimized)
        (readiness-functions (Vec lower/TypedFunctionV0))
        (lower/functionclosuresettlementv0-functions readiness-optimized)
        (mixed-functions (Vec lower/TypedFunctionV0))
        (lower/functionclosuresettlementv0-functions mixed-optimized)
        (effect-metrics lower/FunctionClosureMetricsV0)
        (lower/functionclosuresettlementv0-metrics effect-optimized)
        (readiness-metrics lower/FunctionClosureMetricsV0)
        (lower/functionclosuresettlementv0-metrics readiness-optimized)
        (effect-reference-artifacts StageArtifactsV0)
        (typed-stage-artifacts "effects" effect-reference)
        (effect-optimized-artifacts StageArtifactsV0)
        (typed-stage-artifacts "effects" effect-functions)
        (readiness-reference-artifacts StageArtifactsV0)
        (typed-stage-artifacts "readiness" readiness-reference)
        (readiness-optimized-artifacts StageArtifactsV0)
        (typed-stage-artifacts "readiness" readiness-functions)
        (mixed-reference-artifacts StageArtifactsV0)
        (typed-stage-artifacts "mixed" mixed-reference)
        (mixed-optimized-artifacts StageArtifactsV0)
        (typed-stage-artifacts "mixed" mixed-functions)
        (reference-artifacts String)
        (encode-scenario-artifacts effect-reference-artifacts
          readiness-reference-artifacts mixed-reference-artifacts)
        (optimized-artifacts String)
        (encode-scenario-artifacts effect-optimized-artifacts
          readiness-optimized-artifacts mixed-optimized-artifacts)
        (function-count Int)
        (lower/functionclosuremetricsv0-function-count effect-metrics)
        (call-edge-count Int)
        (lower/functionclosuremetricsv0-call-edge-count effect-metrics)
        (effect-kind-count Int)
        (lower/functionclosuremetricsv0-effect-kind-count effect-metrics)
        (readiness-edge-visits Int)
        (lower/functionclosuremetricsv0-readiness-edge-visits readiness-metrics)
        (effect-edge-visits Int)
        (lower/functionclosuremetricsv0-effect-edge-visits effect-metrics)
        (bounds-hold Bool)
        (and (= function-count 256)
          (and (= call-edge-count 366)
            (and (= effect-kind-count 12)
              (and (<= readiness-edge-visits 366)
                (and (<= effect-edge-visits 4392)
                  (<= (+ readiness-edge-visits effect-edge-visits) 4758))))))]
    (->WorklistGateRunV0
      function-count
      call-edge-count
      effect-kind-count
      readiness-edge-visits
      effect-edge-visits
      reference-artifacts
      optimized-artifacts
      (and (= effect-reference effect-functions)
        (and (= readiness-reference readiness-functions)
          (and (= mixed-reference mixed-functions)
            (= reference-artifacts optimized-artifacts))))
      (and (range-unchanged? effect-input effect-functions 224)
        (and (range-unchanged? readiness-input readiness-functions 224)
          (range-unchanged? mixed-input mixed-functions 224)))
      (readiness-closure-correct? readiness-functions)
      (effect-closure-correct? effect-functions)
      (mixed-closure-correct? mixed-functions)
      bounds-hold)))

(defn gate-passes? [(run WorklistGateRunV0)] Bool
  (and (worklistgaterunv0-reference-equals-optimized run)
    (and (worklistgaterunv0-unaffected-component-unchanged run)
      (and (worklistgaterunv0-readiness-closure-correct run)
        (and (worklistgaterunv0-effect-closure-correct run)
          (and (worklistgaterunv0-mixed-closure-correct run)
            (worklistgaterunv0-bounds-hold run)))))))

(defn gate-metrics [(run WorklistGateRunV0)] String
  (str
    "function-count " (worklistgaterunv0-function-count run) "\n"
    "call-edge-count " (worklistgaterunv0-call-edge-count run) "\n"
    "effect-kind-count " (worklistgaterunv0-effect-kind-count run) "\n"
    "readiness-edge-visits "
    (worklistgaterunv0-readiness-edge-visits run) "\n"
    "effect-edge-visits " (worklistgaterunv0-effect-edge-visits run) "\n"
    "total-edge-visits "
    (+ (worklistgaterunv0-readiness-edge-visits run)
      (worklistgaterunv0-effect-edge-visits run)) "\n"
    "reference-equals-optimized "
    (worklistgaterunv0-reference-equals-optimized run) "\n"
    "unaffected-component-unchanged "
    (worklistgaterunv0-unaffected-component-unchanged run) "\n"
    "readiness-closure-correct "
    (worklistgaterunv0-readiness-closure-correct run) "\n"
    "effect-closure-correct "
    (worklistgaterunv0-effect-closure-correct run) "\n"
    "mixed-closure-correct "
    (worklistgaterunv0-mixed-closure-correct run) "\n"
    "bounds-hold " (worklistgaterunv0-bounds-hold run) "\n"
    "gate-passes " (gate-passes? run) "\n"))
