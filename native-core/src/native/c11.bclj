#lang beagle/clj
(ns native.c11)

(define-mode strict)

(require native.core :as core)

;; A `match` arm names a variant bare, so a variant defined in native.core has
;; to be a resolvable class here or the module will not load; importing them is
;; what makes the cross-module arms below legal without a post-emit rewrite.
(import (native.core
          BoolKind I64Kind F64Kind TextKind BytesKind KeywordKind RefKind
          ScalarShapeV0 BytesShapeV0 RecordShapeV0 UnionShapeV0 VectorShapeV0 ReferenceShapeV0
          MapShapeV0 SetShapeV0 AtomCellShapeV0
          AtomType RecordType UnionType VectorType MapTypeV0 SetTypeV0
          ReferenceType AtomCellTypeV0 FunctionType OutcomeType
          BoolAtom I64Atom F64Atom TextAtom KeywordAtom RefAtom
          CheckedAddI64V0 CheckedSubI64V0 CheckedMulI64V0
          CheckedQuotI64V0 CheckedRemI64V0 CheckedModI64V0 CheckedBoundsV0
          AtomInstruction CopyInstruction AddF64Instruction
          SubF64InstructionV0 MulF64InstructionV0 DivF64InstructionV0
          CheckedInstruction
          StoreInstruction AllocateInstruction CallInstruction
          ReturnTerminator JumpTerminator BranchTerminator SwitchTerminator
          TrapTerminator))

(defrecord C11Artifact
  [header-name: String
   header-text: String
   source-name: String
   source-text: String])

(defunion C11Materialization
  (C11Success [artifact: C11Artifact])
  (C11Failure [detail: String]))

(defn join-lines [lines: (Vec String)] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count lines))
      result
      (recur (+ index 1) (str result (nth lines index) "\n")))))

;; Canonical ids are length-prefixed, so this is a deterministic order and
;; never a semantic one: use it only where any stable order is correct.
(defn id-before? [left: core/NativeId right: core/NativeId] -> Bool
  (< (compare (core/nativeid-value left) (core/nativeid-value right)) 0))

(defn insert-type
  [item: core/TypeDef
   sorted: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/TypeDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/TypeDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/typedef-id item) (core/typedef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn id-ordered-types [types: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [index: Int 0 result: (Vec core/TypeDef) []]
    (if (>= index (count types))
      result
      (recur (+ index 1) (insert-type (nth types index) result)))))

(defn type-field-refs [definition: core/TypeDef] -> (Vec core/NativeId)
  (let [shape: core/TypeShape (core/typedef-shape definition)]
    (match shape
      [(AtomType value) []]
      [(RecordType value)
       (mapv
         (fn [field: core/TypeField] -> core/NativeId (core/typefield-type-id field))
         (core/recordtype-fields shape))]
      [(UnionType value) []]
      [(VectorType value) []]
      [(MapTypeV0 value) []]
      [(SetTypeV0 value) []]
      [(ReferenceType value) []]
      [(AtomCellTypeV0 value) []]
      [(FunctionType value) []]
      [(OutcomeType value) []])))

(defn type-emitted?
  [emitted: (Vec core/TypeDef)
   target: core/NativeId] -> Bool
  (loop [index: Int 0]
    (if (>= index (count emitted))
      false
      (if (core/native-id= (core/typedef-id (nth emitted index)) target)
        true
        (recur (+ index 1))))))

(defn ready-type?
  [emitted: (Vec core/TypeDef)
   definition: core/TypeDef] -> Bool
  (every?
    (fn [reference: core/NativeId] -> Bool (type-emitted? emitted reference))
    (type-field-refs definition)))

;; A record typedef spells its field types, so every reference must already be
;; declared; the id order only seeds a deterministic start, and a cycle or an
;; unreachable reference falls through in seed order rather than looping.
(defn ordered-types [types: (Vec core/TypeDef)] -> (Vec core/TypeDef)
  (loop [pending: (Vec core/TypeDef) (id-ordered-types types)
         emitted: (Vec core/TypeDef) []]
    (if (= 0 (count pending))
      emitted
      (let [ready: (Vec core/TypeDef)
            (filterv
              (fn [definition: core/TypeDef] -> Bool (ready-type? emitted definition))
              pending)]
        (if (= 0 (count ready))
          (vec (concat emitted pending))
          (recur
            (filterv
              (fn [definition: core/TypeDef] -> Bool
                (not (ready-type? emitted definition)))
              pending)
            (vec (concat emitted ready))))))))

(defn insert-layout
  [item: core/LayoutDef
   sorted: (Vec core/LayoutDef)] -> (Vec core/LayoutDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/LayoutDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/LayoutDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/layoutdef-id item) (core/layoutdef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-layouts [layouts: (Vec core/LayoutDef)] -> (Vec core/LayoutDef)
  (loop [index: Int 0 result: (Vec core/LayoutDef) []]
    (if (>= index (count layouts))
      result
      (recur (+ index 1) (insert-layout (nth layouts index) result)))))

(defn insert-function
  [item: core/FunctionDef
   sorted: (Vec core/FunctionDef)] -> (Vec core/FunctionDef)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/FunctionDef) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/FunctionDef (nth sorted index)]
        (if (and (not inserted) (id-before? (core/functiondef-id item) (core/functiondef-id current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-functions
  [functions: (Vec core/FunctionDef)] -> (Vec core/FunctionDef)
  (loop [index: Int 0 result: (Vec core/FunctionDef) []]
    (if (>= index (count functions))
      result
      (recur (+ index 1) (insert-function (nth functions index) result)))))

(defn insert-field-layout
  [item: core/FieldLayoutV0
   sorted: (Vec core/FieldLayoutV0)] -> (Vec core/FieldLayoutV0)
  (loop [index: Int 0 inserted: Bool false result: (Vec core/FieldLayoutV0) []]
    (if (>= index (count sorted))
      (if inserted result (conj result item))
      (let [current: core/FieldLayoutV0 (nth sorted index)]
        (if (and (not inserted) (< (core/fieldlayoutv0-offset-bytes item) (core/fieldlayoutv0-offset-bytes current)))
          (recur (+ index 1) true (conj (conj result item) current))
          (recur (+ index 1) inserted (conj result current)))))))

(defn ordered-field-layouts
  [fields: (Vec core/FieldLayoutV0)] -> (Vec core/FieldLayoutV0)
  (loop [index: Int 0 result: (Vec core/FieldLayoutV0) []]
    (if (>= index (count fields))
      result
      (recur (+ index 1) (insert-field-layout (nth fields index) result)))))

(defn type-index [types: (Vec core/TypeDef) type-id: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count types))
      -1
      (if (core/native-id= (core/typedef-id (nth types index)) type-id)
        index
        (recur (+ index 1))))))

(defn layout-for-type
  [layouts: (Vec core/LayoutDef)
   type-id: core/NativeId] -> (U core/LayoutDef Nil)
  (loop [index: Int 0]
    (if (>= index (count layouts))
      nil
      (let [layout: core/LayoutDef (nth layouts index)]
        (if (core/native-id= (core/layoutdef-type-id layout) type-id)
          layout
          (recur (+ index 1)))))))

(defn atom-kind-supported? [kind: core/AtomKind] -> Bool
  (match kind
    [(BoolKind token) true]
    [(I64Kind token) true]
    [(F64Kind token) true]
    [(TextKind token) false]
    [(BytesKind token) false]
    [(KeywordKind token) false]
    [(RefKind target) false]))

(defn layout-scalar? [layout: core/LayoutDef] -> Bool
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (match shape
      [(ScalarShapeV0 value) true]
      [(BytesShapeV0 value) false]
      [(RecordShapeV0 value) false]
      [(UnionShapeV0 value) false]
      [(VectorShapeV0 value) false]
      [(MapShapeV0 value) false]
      [(SetShapeV0 value) false]
      [(ReferenceShapeV0 value) false]
      [(AtomCellShapeV0 value) false])))

(defn layout-record? [layout: core/LayoutDef] -> Bool
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (match shape
      [(ScalarShapeV0 value) false]
      [(BytesShapeV0 value) false]
      [(RecordShapeV0 value) true]
      [(UnionShapeV0 value) false]
      [(VectorShapeV0 value) false]
      [(MapShapeV0 value) false]
      [(SetShapeV0 value) false]
      [(ReferenceShapeV0 value) false]
      [(AtomCellShapeV0 value) false])))

(defn record-layout-fields
  [layout: core/LayoutDef] -> (Vec core/FieldLayoutV0)
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (match shape
      [(ScalarShapeV0 value) []]
      [(BytesShapeV0 value) []]
      [(RecordShapeV0 value) (core/recordshapev0-fields shape)]
      [(UnionShapeV0 value) []]
      [(VectorShapeV0 value) []]
      [(MapShapeV0 value) []]
      [(SetShapeV0 value) []]
      [(ReferenceShapeV0 value) []]
      [(AtomCellShapeV0 value) []])))

(defn type-supported?
  [type-def: core/TypeDef
   layouts: (Vec core/LayoutDef)] -> Bool
  (let [shape: core/TypeShape (core/typedef-shape type-def)
        layout-value: (U core/LayoutDef Nil) (layout-for-type layouts (core/typedef-id type-def))]
    (match shape
      [(AtomType value) (and (some? layout-value) (layout-scalar? layout-value) (atom-kind-supported? (core/atomtype-kind shape)))]
      [(RecordType value) (and (some? layout-value) (layout-record? layout-value))]
      [(UnionType value) false]
      [(VectorType value) false]
      [(MapTypeV0 value) false]
      [(SetTypeV0 value) false]
      [(ReferenceType value) false]
      [(AtomCellTypeV0 value) false]
      [(FunctionType value) false]
      [(OutcomeType value) false])))

(defn atom-supported? [atom: core/NativeAtom] -> Bool
  (match atom
    [(BoolAtom value) true]
    [(I64Atom value) true]
    [(F64Atom value) true]
    [(TextAtom value) false]
    [(KeywordAtom value) false]
    [(RefAtom target) false]))

(defn checked-operation-supported?
  [operation: core/CheckedOperationV0] -> Bool
  (match operation
    [(CheckedAddI64V0 value) true]
    [(CheckedSubI64V0 value) false]
    [(CheckedMulI64V0 value) false]
    [(CheckedQuotI64V0 value) false]
    [(CheckedRemI64V0 value) false]
    [(CheckedModI64V0 value) false]
    [(CheckedBoundsV0 value) false]))

;; Qualified instance? rather than match: a match on an imported union emits
;; bare variant class names, which only resolve for variants the consumer
;; registered when it was parsed.
(defn instruction-supported? [instruction: core/Instruction] -> Bool
  (cond
    (instance? native.core.AtomInstruction instruction)
    (atom-supported? (core/atominstruction-atom instruction))
    (instance? native.core.AddF64Instruction instruction) true
    (instance? native.core.SubF64InstructionV0 instruction) true
    (instance? native.core.MulF64InstructionV0 instruction) true
    (instance? native.core.DivF64InstructionV0 instruction) true
    (instance? native.core.CheckedInstruction instruction)
    (checked-operation-supported? (core/checkedinstruction-operation instruction))
    :else false))

(defn terminator-supported? [terminator: core/Terminator] -> Bool
  (match terminator
    [(ReturnTerminator value) true]
    [(JumpTerminator value) false]
    [(BranchTerminator value) false]
    [(SwitchTerminator value) false]
    [(TrapTerminator value) false]))

(defn block-supported? [block: core/BasicBlock] -> Bool
  (and (every? instruction-supported? (core/basicblock-instructions block))
    (every? terminator-supported? (core/basicblock-terminators block))))

(defn function-supported? [function: core/FunctionDef] -> Bool
  (and (= 1 (count (core/functiondef-blocks function)))
    (every? block-supported? (core/functiondef-blocks function))))

(defn type-id-supported?
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   type-id: core/NativeId] -> Bool
  (loop [index: Int 0]
    (if (>= index (count types))
      false
      (let [definition: core/TypeDef (nth types index)]
        (if (core/native-id= (core/typedef-id definition) type-id)
          (type-supported? definition layouts)
          (recur (+ index 1)))))))

(defn function-types-supported?
  [function: core/FunctionDef
   types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)] -> Bool
  (let [parameters-supported: Bool
        (every?
          (fn [parameter: core/Parameter] -> Bool
            (type-id-supported? types layouts (core/parameter-type-id parameter)))
          (core/functiondef-parameters function))
        result: (U core/NativeId Nil) (core/functiondef-return-type function)]
    (and parameters-supported
      (or (nil? result) (type-id-supported? types layouts result)))))

(defn program-supported? [program: core/NativeCoreProgram] -> Bool
  (let [types: (Vec core/TypeDef) (core/nativecoreprogram-types program)
        layouts: (Vec core/LayoutDef) (core/nativecoreprogram-layouts program)
        functions: (Vec core/FunctionDef) (core/nativecoreprogram-functions program)]
    (and (every? function-supported? functions)
      (every?
        (fn [function: core/FunctionDef] -> Bool
          (function-types-supported? function types layouts))
        functions))))

(defn module-prefix [module-index: Int] -> String
  (str "native_m" module-index))

(defn type-name [module-index: Int type-index-value: Int] -> String
  (str (module-prefix module-index) "_type_" type-index-value))

(defn c-type
  [types: (Vec core/TypeDef)
   module-index: Int
   type-id: core/NativeId] -> String
  (let [index: Int (type-index types type-id)]
    (if (< index 0)
      "void"
      (type-name module-index index))))

(defn emit-layout-assertions
  [type-name-value: String
   layout: core/LayoutDef
   fields: (Vec core/FieldLayoutV0)] -> String
  (let [base: (Vec String)
        [(str "_Static_assert(sizeof(" type-name-value ") == " (core/layoutdef-size-bytes layout) ", \"layout size\");")
         (str "_Static_assert(_Alignof(" type-name-value ") == " (core/layoutdef-align-bytes layout) ", \"layout alignment\");")]]
    (loop [index: Int 0 lines: (Vec String) base]
      (if (>= index (count fields))
        (join-lines lines)
        (let [field: core/FieldLayoutV0 (nth fields index)]
          (recur (+ index 1)
            (conj lines
              (str "_Static_assert(offsetof(" type-name-value ", field_" index ") == "
                (core/fieldlayoutv0-offset-bytes field) ", \"field offset\");"))))))))

(defn emit-atom-type
  [type-name-value: String
   kind: core/AtomKind
   layout: core/LayoutDef] -> String
  (let [size: Int (core/layoutdef-size-bytes layout)
        backing: String
        (match kind
          [(BoolKind token) "bool"]
          [(I64Kind token)
           (cond
             (= size 1) "int8_t"
             (= size 2) "int16_t"
             (= size 4) "int32_t"
             :else "int64_t")]
          [(F64Kind token) (if (= size 4) "float" "double")]
          [(TextKind token) "native_bytes"]
          [(BytesKind token) "native_bytes"]
          [(KeywordKind token) "uint64_t"]
          [(RefKind target) "void *"])]
    (str "typedef " backing " " type-name-value ";\n"
      (emit-layout-assertions type-name-value layout []))) )

(defn emit-record-fields
  [types: (Vec core/TypeDef)
   module-index: Int
   fields: (Vec core/FieldLayoutV0)] -> String
  (loop [index: Int 0 lines: (Vec String) []]
    (if (>= index (count fields))
      (join-lines lines)
      (let [field: core/FieldLayoutV0 (nth fields index)]
        (recur (+ index 1)
          (conj lines
            (str "  " (c-type types module-index (core/fieldlayoutv0-type-id field)) " field_" index ";")))))))

(defn emit-type
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int
   type-def: core/TypeDef] -> String
  (let [index: Int (type-index types (core/typedef-id type-def))
        type-name-value: String (type-name module-index index)
        layout-value: (U core/LayoutDef Nil) (layout-for-type layouts (core/typedef-id type-def))
        shape: core/TypeShape (core/typedef-shape type-def)]
    (if (nil? layout-value)
      ""
      (match shape
        [(AtomType value) (emit-atom-type type-name-value (core/atomtype-kind shape) layout-value)]
        [(RecordType value)
         (let [fields: (Vec core/FieldLayoutV0) (ordered-field-layouts (record-layout-fields layout-value))]
           (str "typedef struct " type-name-value " {\n"
             (emit-record-fields types module-index fields)
             "} " type-name-value ";\n"
             (emit-layout-assertions type-name-value layout-value fields)))]
        [(UnionType value) ""]
        [(VectorType value) ""]
        [(MapTypeV0 value) ""]
        [(SetTypeV0 value) ""]
        [(ReferenceType value) ""]
        [(AtomCellTypeV0 value) ""]
        [(FunctionType value) ""]
        [(OutcomeType value) ""]))))

(defn emit-types
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count types))
      result
      (recur (+ index 1)
        (str result (emit-type types layouts module-index (nth types index)) "\n")))))

(defn parameter-index
  [parameters: (Vec core/Parameter)
   target: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count parameters))
      -1
      (if (core/native-id= (core/parameter-id (nth parameters index)) target)
        index
        (recur (+ index 1))))))

(defn instruction-index
  [instructions: (Vec core/Instruction)
   target: core/NativeId] -> Int
  (loop [index: Int 0]
    (if (>= index (count instructions))
      -1
      (if (core/native-id= (core/instruction-result-id (nth instructions index)) target)
        index
        (recur (+ index 1))))))

(defn value-name
  [function: core/FunctionDef
   block: core/BasicBlock
   target: core/NativeId] -> String
  (let [parameters: (Vec core/Parameter) (core/functiondef-parameters function)
        parameter-position: Int (parameter-index parameters target)]
    (if (>= parameter-position 0)
      (str "native_v_" parameter-position)
      (let [position: Int (instruction-index (core/basicblock-instructions block) target)]
        (str "native_v_" (+ (count parameters) position))))))

(defn function-return-type
  [types: (Vec core/TypeDef)
   module-index: Int
   function: core/FunctionDef] -> String
  (let [return-type: (U core/NativeId Nil) (core/functiondef-return-type function)]
    (if (nil? return-type) "void" (c-type types module-index return-type))))

(defn emit-parameter-list
  [types: (Vec core/TypeDef)
   module-index: Int
   function: core/FunctionDef] -> String
  (let [parameters: (Vec core/Parameter) (core/functiondef-parameters function)
        arena: Bool (> (count (core/functiondef-regions function)) 0)
        capability: Bool (> (count (core/functiondef-capabilities function)) 0)
        initial: (Vec String) (if arena ["native_arena *arena"] [])
        with-capability: (Vec String) (if capability (conj initial "const native_capability *capability") initial)]
    (loop [index: Int 0 result: String ""]
      (if (>= index (count parameters))
        (if (and (= (count with-capability) 0) (= (count result) 0))
          "void"
          (loop [extra-index: Int 0 text: String ""]
            (if (>= extra-index (count with-capability))
              (if (= (count result) 0) text (str text (if (= (count text) 0) "" ", ") result))
              (recur (+ extra-index 1)
                (str text (if (= extra-index 0) "" ", ") (nth with-capability extra-index))))))
        (let [parameter: core/Parameter (nth parameters index)
              fragment: String (str (c-type types module-index (core/parameter-type-id parameter)) " native_v_" index)]
          (recur (+ index 1) (str result (if (= index 0) "" ", ") fragment)))))))

(defn emit-function-prototype
  [types: (Vec core/TypeDef)
   module-index: Int
   function-index: Int
   function: core/FunctionDef] -> String
  (str (function-return-type types module-index function) " " (module-prefix module-index) "_fn_" function-index
    "(" (emit-parameter-list types module-index function) ");"))

(defn emit-function-prototypes
  [types: (Vec core/TypeDef)
   module-index: Int
   functions: (Vec core/FunctionDef)] -> String
  (loop [index: Int 0 lines: (Vec String) []]
    (if (>= index (count functions))
      (join-lines lines)
      (recur (+ index 1)
        (conj lines (emit-function-prototype types module-index index (nth functions index)))))))

(defn emit-atom-expression [atom: core/NativeAtom] -> String
  (match atom
    [(BoolAtom value) (if (core/boolatom-value atom) "true" "false")]
    [(I64Atom value) (str "INT64_C(" (core/i64atom-value atom) ")")]
    [(F64Atom value) (str (core/f64atom-value atom))]
    [(TextAtom value) ""]
    [(KeywordAtom value) ""]
    [(RefAtom target) ""]))

(defn atom-c-type
  [types: (Vec core/TypeDef)
   module-index: Int
   atom: core/NativeAtom] -> String
  (match atom
    [(BoolAtom value) "bool"]
    [(I64Atom value) "int64_t"]
    [(F64Atom value) "double"]
    [(TextAtom value) "native_bytes"]
    [(KeywordAtom value) "uint64_t"]
    [(RefAtom target) "void *"]))

(defn emit-instruction
  [types: (Vec core/TypeDef)
   module-index: Int
   function: core/FunctionDef
   block: core/BasicBlock
   instruction-position: Int
   instruction: core/Instruction] -> String
  (let [result-name: String (str "native_v_" (+ (count (core/functiondef-parameters function)) instruction-position))]
    (cond
      (instance? native.core.AtomInstruction instruction)
      (let [atom-value: core/NativeAtom (core/atominstruction-atom instruction)]
        (str "  " (atom-c-type types module-index atom-value) " " result-name " = " (emit-atom-expression atom-value) ";\n"
          "  (void)" result-name ";\n"))

      (instance? native.core.AddF64Instruction instruction)
      (str "  double " result-name " = " (value-name function block (core/addf64instruction-left-id instruction)) " + "
        (value-name function block (core/addf64instruction-right-id instruction)) ";\n  (void)" result-name ";\n")

      (instance? native.core.SubF64InstructionV0 instruction)
      (str "  double " result-name " = "
        (value-name function block
          (core/subf64instructionv0-left-id instruction)) " - "
        (value-name function block
          (core/subf64instructionv0-right-id instruction))
        ";\n  (void)" result-name ";\n")

      (instance? native.core.MulF64InstructionV0 instruction)
      (str "  double " result-name " = "
        (value-name function block
          (core/mulf64instructionv0-left-id instruction)) " * "
        (value-name function block
          (core/mulf64instructionv0-right-id instruction))
        ";\n  (void)" result-name ";\n")

      (instance? native.core.DivF64InstructionV0 instruction)
      (let [left: String
            (value-name function block
              (core/divf64instructionv0-left-id instruction))
            right: String
            (value-name function block
              (core/divf64instructionv0-right-id instruction))]
        (str "  if (" right " == 0.0) {\n"
          "    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
          "  }\n"
          "  double " result-name " = " left " / " right
          ";\n  (void)" result-name ";\n"))

      (instance? native.core.CheckedInstruction instruction)
      (let [operation: core/CheckedOperationV0 (core/checkedinstruction-operation instruction)]
        (if (instance? native.core.CheckedAddI64V0 operation)
          (let [left: String (value-name function block (core/checkedaddi64v0-left-id operation))
                right: String (value-name function block (core/checkedaddi64v0-right-id operation))]
            (str "  int64_t " result-name ";\n"
              "  if (((" right " > INT64_C(0)) && (" left " > (INT64_MAX - " right "))) ||\n"
              "      ((" right " < INT64_C(0)) && (" left " < (INT64_MIN - " right ")))) {\n"
              "    native_trap(NATIVE_TRAP_OVERFLOW);\n"
              "  }\n"
              "  " result-name " = " left " + " right ";\n"
              "  (void)" result-name ";\n"))
          ""))

      :else "")))

(defn emit-instructions
  [types: (Vec core/TypeDef)
   module-index: Int
   function: core/FunctionDef
   block: core/BasicBlock] -> String
  (let [instructions: (Vec core/Instruction) (core/basicblock-instructions block)]
    (loop [index: Int 0 result: String ""]
      (if (>= index (count instructions))
        result
        (recur (+ index 1)
          (str result (emit-instruction types module-index function block index (nth instructions index))))))))

(defn emit-return
  [function: core/FunctionDef
   block: core/BasicBlock
   terminator: core/Terminator] -> String
  (match terminator
    [(ReturnTerminator value)
     (let [return-value: (U core/NativeId Nil) (core/returnterminator-value terminator)]
       (if (nil? return-value) "  return;\n" (str "  return " (value-name function block return-value) ";\n")))]
    [(JumpTerminator value) ""]
    [(BranchTerminator value) ""]
    [(SwitchTerminator value) ""]
    [(TrapTerminator value) ""]))

(defn emit-unused-resources [function: core/FunctionDef] -> String
  (str (if (> (count (core/functiondef-regions function)) 0) "  (void)arena;\n" "")
    (if (> (count (core/functiondef-capabilities function)) 0) "  (void)capability;\n" "")))

(defn emit-function
  [types: (Vec core/TypeDef)
   module-index: Int
   function-index: Int
   function: core/FunctionDef] -> String
  (let [block: core/BasicBlock (nth (core/functiondef-blocks function) 0)
        terminator: core/Terminator (nth (core/basicblock-terminators block) 0)]
    (str (function-return-type types module-index function) " " (module-prefix module-index) "_fn_" function-index
      "(" (emit-parameter-list types module-index function) ") {\n"
      (emit-unused-resources function)
      (emit-instructions types module-index function block)
      (emit-return function block terminator)
      "}\n")))

(defn emit-functions
  [types: (Vec core/TypeDef)
   module-index: Int
   functions: (Vec core/FunctionDef)] -> String
  (loop [index: Int 0 result: String ""]
    (if (>= index (count functions))
      result
      (recur (+ index 1)
        (str result (emit-function types module-index index (nth functions index)))))))

(defn emit-header
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   module-index: Int] -> String
  (let [guard: String (str "NATIVE_MODULE_" module-index "_ABI_H")]
    (str "/* Generated by native.c11; do not edit. */\n"
      "#ifndef " guard "\n#define " guard "\n\n"
      "#include \"native_shim.h\"\n\n"
      (emit-types types layouts module-index)
      (emit-function-prototypes types module-index functions)
      "\n#endif\n")))

(defn emit-source
  [functions: (Vec core/FunctionDef)
   types: (Vec core/TypeDef)
   module-index: Int
   header-name: String] -> String
  (str "/* Generated by native.c11; do not edit. */\n"
    "#include \"" header-name "\"\n\n"
    (emit-functions types module-index functions)))

(defn materialize-program
  [program: core/NativeCoreProgram
   module-index: Int] -> C11Materialization
  (let [validation: core/ValidationReport (core/validate-program program)]
    (cond
      (< module-index 0)
      (->C11Failure "module index must be nonnegative")
      (not (core/validationreport-passed validation))
      (->C11Failure "native program is not frozen: validation obligations failed")
      (not (program-supported? program))
      (->C11Failure "native program uses a shape outside the restricted C17 reference slice")
      :else
      (let [types: (Vec core/TypeDef) (ordered-types (core/nativecoreprogram-types program))
            layouts: (Vec core/LayoutDef) (ordered-layouts (core/nativecoreprogram-layouts program))
            functions: (Vec core/FunctionDef) (ordered-functions (core/nativecoreprogram-functions program))
            header-name: String (str "module_" module-index ".h")
            source-name: String (str "module_" module-index ".c")
            header-text: String (emit-header types layouts functions module-index)
            source-text: String (emit-source functions types module-index header-name)]
        (->C11Success (->C11Artifact header-name header-text source-name source-text))))))
