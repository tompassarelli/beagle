#lang beagle
(ns native.edn
  (:require [beagle.datum-reader :as reader]))

(defunion EdnEvent
  (EdnMapStart [(offset Int)])
  (EdnMapEnd [(offset Int)])
  (EdnVectorStart [(offset Int)])
  (EdnVectorEnd [(offset Int)])
  (EdnKeyword [(offset Int) (value Keyword)])
  (EdnString [(offset Int) (value String)])
  (EdnInteger [(offset Int) (value Int)])
  (EdnBoolean [(offset Int) (value Bool)])
  (EdnNil [(offset Int)]))

(defunion EdnDecodeResult
  (EdnDecoded [(events (Vec EdnEvent))])
  (EdnDecodeError [(offset Int) (message String)]))

(defunion EdnEncodeResult
  (EdnEncoded [(text String)])
  (EdnEncodeError [(event-index Int) (message String)]))

(defrecord DecodeStackEntry
  [(kind Keyword) (items Int)])

(defunion ValueCount
  (ValueCounted [(stack (Vec DecodeStackEntry)) (roots Int)])
  (ValueCountRejected [(token Bool)]))

(defunion EncodeExpectation
  (EncodeValue [(token Bool)])
  (EncodeMapKeyFirst [(token Bool)])
  (EncodeMapKeyNext [(token Bool)])
  (EncodeMapValue [(token Bool)])
  (EncodeVectorValueFirst [(token Bool)])
  (EncodeVectorValueNext [(token Bool)])
  (EncodeDone [(token Bool)]))

(defunion EncodeStep
  (ValueEncoded
    [(fragment String)
     (expectation EncodeExpectation)
     (continuations (Vec EncodeExpectation))])
  (ValueEncodeRejected [(message String)]))

(defn count-value
  [(stack (Vec DecodeStackEntry)) (roots Int)] ValueCount
  (if (empty? stack)
    (if (= roots 0)
      (->ValueCounted stack 1)
      (->ValueCountRejected true))
    (let [(index Int) (dec (count stack))
          (entry DecodeStackEntry) (nth stack index)]
      (->ValueCounted
        (assoc stack index
          (->DecodeStackEntry
            (decodestackentry-kind entry)
            (inc (decodestackentry-items entry))))
        roots))))

(defn decimal-digit? [(character String)] Bool
  (str/includes? "0123456789" character))

(defn integer-token? [(value String)] Bool
  (let [(length Int) (count value)
        (start Int)
        (if (and (> length 0)
                 (or (= (subs value 0 1) "-")
                     (= (subs value 0 1) "+")))
          1
          0)]
    (if (>= start length)
      false
      (loop [(offset Int) start]
        (if (>= offset length)
          true
          (if (decimal-digit? (subs value offset (inc offset)))
            (recur (inc offset))
            false))))))

(defn decode [(text String)] EdnDecodeResult
  (let [(read reader/DatumRead) (reader/read-events text)
        (read-error String?) (reader/datumread-error read)]
    (if (some? read-error)
      (->EdnDecodeError
        (reader/datumread-error-offset read)
        (or read-error "invalid EDN"))
      (loop [(remaining (Vec reader/ReaderEvent))
             (reader/datumread-events read)
             (events (Vec EdnEvent)) []
             (stack (Vec DecodeStackEntry)) []
             (roots Int) 0]
        (if (empty? remaining)
          (if (= roots 1)
            (->EdnDecoded events)
            (->EdnDecodeError (count text) "expected one EDN value"))
          (let [(event reader/ReaderEvent) (first remaining)
                (kind Keyword) (reader/readerevent-kind event)
                (value String) (reader/readerevent-value event)
                (offset Int) (reader/readerevent-offset event)]
            (cond
              (or (= kind :map/open) (= kind :vector/open))
              (match (count-value stack roots)
                [(ValueCountRejected token)
                 (->EdnDecodeError offset
                   "unexpected data after EDN value")]
                [(ValueCounted counted-stack counted-roots)
                 (let [(entry-kind Keyword)
                       (if (= kind :map/open) :map :vector)
                       (semantic EdnEvent)
                       (if (= kind :map/open)
                         (->EdnMapStart offset)
                         (->EdnVectorStart offset))]
                   (recur (rest remaining)
                     (conj events semantic)
                     (conj counted-stack (->DecodeStackEntry entry-kind 0))
                     counted-roots))])

              (= kind :map/close)
              (if (empty? stack)
                (->EdnDecodeError offset "unexpected map end event")
                (let [(entry DecodeStackEntry) (peek stack)]
                  (cond
                    (not= (decodestackentry-kind entry) :map)
                    (->EdnDecodeError offset "unexpected map end event")

                    (not= (mod (decodestackentry-items entry) 2) 0)
                    (->EdnDecodeError offset
                      "map requires an even number of forms")

                    :else
                    (recur (rest remaining)
                      (conj events (->EdnMapEnd offset))
                      (pop stack) roots))))

              (= kind :vector/close)
              (if (or (empty? stack)
                      (not= (decodestackentry-kind (peek stack)) :vector))
                (->EdnDecodeError offset "unexpected vector end event")
                (recur (rest remaining)
                  (conj events (->EdnVectorEnd offset))
                  (pop stack) roots))

              (= kind :keyword)
              (if (or (<= (count value) 1)
                      (and (> (count value) 1)
                           (= (subs value 1 2) ":")))
                (->EdnDecodeError offset "keyword requires a name")
                (match (count-value stack roots)
                  [(ValueCountRejected token)
                   (->EdnDecodeError offset
                     "unexpected data after EDN value")]
                  [(ValueCounted counted-stack counted-roots)
                   (recur (rest remaining)
                     (conj events
                       (->EdnKeyword offset
                         (keyword (subs value 1 (count value)))))
                     counted-stack counted-roots)]))

              (= kind :string)
              (match (count-value stack roots)
                [(ValueCountRejected token)
                 (->EdnDecodeError offset
                   "unexpected data after EDN value")]
                [(ValueCounted counted-stack counted-roots)
                 (recur (rest remaining)
                   (conj events (->EdnString offset value))
                   counted-stack counted-roots)])

              (= kind :boolean)
              (match (count-value stack roots)
                [(ValueCountRejected token)
                 (->EdnDecodeError offset
                   "unexpected data after EDN value")]
                [(ValueCounted counted-stack counted-roots)
                 (recur (rest remaining)
                   (conj events (->EdnBoolean offset (= value "true")))
                   counted-stack counted-roots)])

              (= kind :nil)
              (match (count-value stack roots)
                [(ValueCountRejected token)
                 (->EdnDecodeError offset
                   "unexpected data after EDN value")]
                [(ValueCounted counted-stack counted-roots)
                 (recur (rest remaining)
                   (conj events (->EdnNil offset))
                   counted-stack counted-roots)])

              (= kind :symbol)
              (if (not (integer-token? value))
                (->EdnDecodeError offset
                  "unsupported EDN symbol; expected an integer")
                (let [(parsed (U Int Nil)) (parse-long value)]
                  (if (nil? parsed)
                    (->EdnDecodeError offset "integer is outside Int range")
                    (match (count-value stack roots)
                      [(ValueCountRejected token)
                       (->EdnDecodeError offset
                         "unexpected data after EDN value")]
                      [(ValueCounted counted-stack counted-roots)
                       (recur (rest remaining)
                         (conj events (->EdnInteger offset parsed))
                         counted-stack counted-roots)]))))

              :else
              (->EdnDecodeError offset "unsupported EDN form"))))))))

(defn encode-value-step
  [(event EdnEvent)
   (prefix String)
   (continuation EncodeExpectation)
   (continuations (Vec EncodeExpectation))]
  EncodeStep
  (match event
    [(EdnMapStart offset)
     (->ValueEncoded (str prefix "{") (->EncodeMapKeyFirst true)
       (conj continuations continuation))]
    [(EdnVectorStart offset)
     (->ValueEncoded (str prefix "[") (->EncodeVectorValueFirst true)
       (conj continuations continuation))]
    [(EdnKeyword offset value)
     (->ValueEncoded (str prefix value) continuation continuations)]
    [(EdnString offset value)
     (->ValueEncoded (str prefix (reader/render-string-literal value))
       continuation continuations)]
    [(EdnInteger offset value)
     (->ValueEncoded (str prefix value) continuation continuations)]
    [(EdnBoolean offset value)
     (->ValueEncoded (str prefix (if value "true" "false"))
       continuation continuations)]
    [(EdnNil offset)
     (->ValueEncoded (str prefix "nil") continuation continuations)]
    [(EdnMapEnd offset)
     (->ValueEncodeRejected "unexpected map end event")]
    [(EdnVectorEnd offset)
     (->ValueEncodeRejected "unexpected vector end event")]))

(defn encode [(events (Vec EdnEvent))] EdnEncodeResult
  (loop [(index Int) 0
         (result String) ""
         (expectation EncodeExpectation) (->EncodeValue true)
         (continuations (Vec EncodeExpectation)) [(->EncodeDone true)]]
    (match expectation
      [(EncodeValue token)
       (if (>= index (count events))
         (->EdnEncodeError index "expected an EDN value event")
         (match (encode-value-step (nth events index) ""
                  (peek continuations) (pop continuations))
           [(ValueEncoded fragment next-expectation next-continuations)
            (recur (inc index) (str result fragment)
              next-expectation next-continuations)]
           [(ValueEncodeRejected message)
            (->EdnEncodeError index message)]))]

      [(EncodeMapKeyFirst token)
       (if (>= index (count events))
         (->EdnEncodeError index "unterminated map event sequence")
         (let [(event EdnEvent) (nth events index)]
           (match event
             [(EdnMapEnd offset)
              (recur (inc index) (str result "}")
                (peek continuations) (pop continuations))]
             [(EdnMapStart offset)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorStart offset)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorEnd offset)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnKeyword offset value)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnString offset value)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnInteger offset value)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnBoolean offset value)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnNil offset)
              (match (encode-value-step event ""
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])])))]

      [(EncodeMapKeyNext token)
       (if (>= index (count events))
         (->EdnEncodeError index "unterminated map event sequence")
         (let [(event EdnEvent) (nth events index)]
           (match event
             [(EdnMapEnd offset)
              (recur (inc index) (str result "}")
                (peek continuations) (pop continuations))]
             [(EdnMapStart offset)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorStart offset)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorEnd offset)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnKeyword offset value)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnString offset value)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnInteger offset value)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnBoolean offset value)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnNil offset)
              (match (encode-value-step event ", "
                       (->EncodeMapValue true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])])))]

      [(EncodeMapValue token)
       (if (>= index (count events))
         (->EdnEncodeError index "map key has no value event")
         (match (encode-value-step (nth events index) " "
                  (->EncodeMapKeyNext true) continuations)
           [(ValueEncoded fragment next-expectation next-continuations)
            (recur (inc index) (str result fragment)
              next-expectation next-continuations)]
           [(ValueEncodeRejected message)
            (->EdnEncodeError index message)]))]

      [(EncodeVectorValueFirst token)
       (if (>= index (count events))
         (->EdnEncodeError index "unterminated vector event sequence")
         (let [(event EdnEvent) (nth events index)]
           (match event
             [(EdnVectorEnd offset)
              (recur (inc index) (str result "]")
                (peek continuations) (pop continuations))]
             [(EdnMapStart offset)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnMapEnd offset)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorStart offset)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnKeyword offset value)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnString offset value)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnInteger offset value)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnBoolean offset value)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnNil offset)
              (match (encode-value-step event ""
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])])))]

      [(EncodeVectorValueNext token)
       (if (>= index (count events))
         (->EdnEncodeError index "unterminated vector event sequence")
         (let [(event EdnEvent) (nth events index)]
           (match event
             [(EdnVectorEnd offset)
              (recur (inc index) (str result "]")
                (peek continuations) (pop continuations))]
             [(EdnMapStart offset)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnMapEnd offset)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnVectorStart offset)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnKeyword offset value)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnString offset value)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnInteger offset value)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnBoolean offset value)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])]
             [(EdnNil offset)
              (match (encode-value-step event " "
                       (->EncodeVectorValueNext true) continuations)
                [(ValueEncoded fragment next-expectation next-continuations)
                 (recur (inc index) (str result fragment)
                   next-expectation next-continuations)]
                [(ValueEncodeRejected message)
                 (->EdnEncodeError index message)])])))]

      [(EncodeDone token)
       (if (= index (count events))
         (->EdnEncoded result)
         (->EdnEncodeError index
           "unexpected event after complete EDN value"))])))
