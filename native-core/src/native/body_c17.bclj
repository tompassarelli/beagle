#lang beagle/clj
;; Restricted C17 materializer for lowered function bodies: multi-block SSA with
;; block arguments, closed-union dispatch, record extract/construct, and traps.
;; Types, layouts and prototypes are native.fold-c17's; only bodies live here.
(ns native.body-c17)

(define-mode strict)

(require native.core :as core)
(require native.fold-c17 :as c17)

(defrecord BodyArtifactV0
  [header-name: String
   header-text: String
   source-name: String
   source-text: String])

(defunion BodyMaterializationV0
  (BodySuccessV0 [artifact: BodyArtifactV0])
  (BodyFailureV0 [detail: String]))

(defrecord ValueSlotV0 [id: core/NativeId type-id: core/NativeId])

;; Text and Keyword literals become length-prefixed constant blobs. Their
;; distinct static types share one immutable UTF-8 handle representation.
(defrecord ConstantPoolV0 [texts: (Vec String) keywords: (Vec String)])

;; v0 C17 literal alphabet. Anything else is refused rather than escaped
;; wrongly: without a code-point primitive the emitter cannot tell a control
;; byte from a multi-byte UTF-8 lead.
(defn printable-ascii [] -> String
  (str " !\"#$%&'()*+,-./0123456789:;<=>?@"
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`"
    "abcdefghijklmnopqrstuvwxyz{|}~"))

(defn character-in? [alphabet: String character: String] -> Bool
  (loop [position: Int 0]
    (cond
      (>= position (count alphabet)) false
      (= character (subs alphabet position (+ position 1))) true
      :else (recur (+ position 1)))))

;; Generated translation units are frozen UTF-8 artifacts.
(defn text-emittable? [value: String] -> Bool true)

(defn escape-c-character [character: String] -> String
  (cond
    (= character "\\") "\\\\"
    (= character "\"") "\\\""
    (= character "?") "\\?"
    (= character "\u0001") "\\001"
    (= character "\t") "\\t"
    (= character "\n") "\\n"
    (= character "\u000b") "\\v"
    (= character "\u000c") "\\f"
    (= character "\r") "\\r"
    :else character))

(defn escape-c-text [value: String] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count value))
      result
      (recur (+ position 1)
        (str result
          (escape-c-character (subs value position (+ position 1))))))))

(defn value-position [values: (Vec String) target: String] -> Int
  (loop [position: Int 0]
    (cond
      (>= position (count values)) -1
      (= target (nth values position)) position
      :else (recur (+ position 1)))))

(defn conj-value [values: (Vec String) candidate: String] -> (Vec String)
  (if (>= (value-position values candidate) 0) values (conj values candidate)))

(defn pool-with-atom
  [pool: ConstantPoolV0
   atom: core/NativeAtom] -> ConstantPoolV0
  (cond
    (instance? native.core.TextAtom atom)
    (with pool
      [:texts (conj-value (constantpoolv0-texts pool) (core/textatom-value atom))])
    (instance? native.core.KeywordAtom atom)
    (with pool
      [:keywords
       (conj-value (constantpoolv0-keywords pool)
         (core/keywordatom-value atom))])
    :else pool))

(defn pool-with-instruction
  [pool: ConstantPoolV0
   instruction: core/Instruction] -> ConstantPoolV0
  (if (instance? native.core.AtomInstruction instruction)
    (pool-with-atom pool (core/atominstruction-atom instruction))
    pool))

;; Deterministic: first appearance in the already-ordered function, block and
;; instruction sequence, so the table is a pure function of the frozen native program.
(defn collect-pool [functions: (Vec core/FunctionDef)] -> ConstantPoolV0
  (loop [position: Int 0 pool: ConstantPoolV0 (->ConstantPoolV0 [] [])]
    (if (>= position (count functions))
      pool
      (recur (+ position 1)
        (loop [block-position: Int 0
               blocks: (Vec core/BasicBlock)
               (core/functiondef-blocks (nth functions position))
               current: ConstantPoolV0 pool]
          (if (>= block-position (count blocks))
            current
            (recur (+ block-position 1) blocks
              (loop [inner: Int 0
                     instructions: (Vec core/Instruction)
                     (core/basicblock-instructions (nth blocks block-position))
                     collected: ConstantPoolV0 current]
                (if (>= inner (count instructions))
                  collected
                  (recur (+ inner 1) instructions
                    (pool-with-instruction collected
                      (nth instructions inner))))))))))))

(defn pool-emittable? [pool: ConstantPoolV0] -> Bool
  (and (every? text-emittable? (constantpoolv0-texts pool))
    (every? text-emittable? (constantpoolv0-keywords pool))))

;; Consumers live in other namespaces, where a `match` on this union does not
;; survive emission; these three are the supported way to read the result.
(defn materialization-ok? [result: BodyMaterializationV0] -> Bool
  (match result
    [(BodySuccessV0 artifact) true]
    [(BodyFailureV0 detail) false]))

(defn materialization-detail [result: BodyMaterializationV0] -> String
  (match result
    [(BodySuccessV0 artifact) ""]
    [(BodyFailureV0 detail) detail]))

(defn materialization-artifact [result: BodyMaterializationV0] -> BodyArtifactV0
  (match result
    [(BodySuccessV0 artifact) artifact]
    [(BodyFailureV0 detail) (->BodyArtifactV0 "" "" "" "")]))

;; Bounds checks have no i64 Outcome shape here, so only the three arithmetic
;; operations materialize; anything else is refused rather than approximated.
(defn checked-operation-supported? [operation: core/CheckedOperationV0] -> Bool
  (or (instance? native.core.CheckedAddI64V0 operation)
      (instance? native.core.CheckedSubI64V0 operation)
      (instance? native.core.CheckedMulI64V0 operation)
      (instance? native.core.CheckedQuotI64V0 operation)
      (instance? native.core.CheckedRemI64V0 operation)
      (instance? native.core.CheckedModI64V0 operation)))

(defn instruction-supported? [instruction: core/Instruction] -> Bool
  (cond
    (instance? native.core.AtomInstruction instruction)
    (let [atom: core/NativeAtom (core/atominstruction-atom instruction)]
      (or (instance? native.core.BoolAtom atom)
          (instance? native.core.I64Atom atom)
          (instance? native.core.F64Atom atom)
          (instance? native.core.TextAtom atom)
          (instance? native.core.KeywordAtom atom)))
    (instance? native.core.CopyInstruction instruction) true
    (instance? native.core.AddF64Instruction instruction) true
    (instance? native.core.SubF64InstructionV0 instruction) true
    (instance? native.core.MulF64InstructionV0 instruction) true
    (instance? native.core.DivF64InstructionV0 instruction) true
    (instance? native.core.I64ToF64InstructionV0 instruction) true
    (instance? native.core.CompareInstruction instruction) true
    (instance? native.core.FieldInstruction instruction) true
    (instance? native.core.RecordInstruction instruction) true
    (instance? native.core.RecordAssocInstructionV0 instruction) true
    (instance? native.core.BoxRecordInstruction instruction) true
    (instance? native.core.RecordMaterializeInstructionV0 instruction) true
    (instance? native.core.CallInstruction instruction) true
    (instance? native.core.ExternCallInstruction instruction) true
    (instance? native.core.VariantValueInstruction instruction) true
    (instance? native.core.CheckedInstruction instruction)
    (checked-operation-supported? (core/checkedinstruction-operation instruction))
    (instance? native.core.BitwiseInstructionV0 instruction) true
    (instance? native.core.UnionConstructInstruction instruction) true
    (instance? native.core.UnionExtractInstruction instruction) true
    (instance? native.core.VecLengthInstruction instruction) true
    (instance? native.core.VecGetInstruction instruction) true
    (instance? native.core.VecAssocInstructionV0 instruction) true
    (instance? native.core.VecPushInstruction instruction) true
    (instance? native.core.VecEmptyInstruction instruction) true
    (instance? native.core.VecConcatInstruction instruction) true
    (instance? native.core.VecSliceInstructionV0 instruction) true
    (instance? native.core.ByteSourceLengthInstructionV0 instruction) true
    (instance? native.core.ByteSourceGetInstructionV0 instruction) true
    (instance? native.core.ByteSourceSliceInstructionV0 instruction) true
    (instance? native.core.VecReverseInstructionV0 instruction) true
    (instance? native.core.VecSortInstructionV0 instruction) true
    (instance? native.core.MapLiteralInstructionV0 instruction) true
    (instance? native.core.SetLiteralInstructionV0 instruction) true
    (instance? native.core.MapCountInstructionV0 instruction) true
    (instance? native.core.MapGetInstructionV0 instruction) true
    (instance? native.core.MapContainsInstructionV0 instruction) true
    (instance? native.core.MapAssocInstructionV0 instruction) true
    (instance? native.core.MapDissocInstructionV0 instruction) true
    (instance? native.core.MapKeysInstructionV0 instruction) true
    (instance? native.core.MapValuesInstructionV0 instruction) true
    (instance? native.core.SetCountInstructionV0 instruction) true
    (instance? native.core.SetContainsInstructionV0 instruction) true
    (instance? native.core.SetConjInstructionV0 instruction) true
    (instance? native.core.SetDisjInstructionV0 instruction) true
    (instance? native.core.SetVectorInstructionV0 instruction) true
    (instance? native.core.CollectionTransientOpenInstructionV0 instruction) true
    (instance? native.core.CollectionPersistentCloseInstructionV0 instruction) true
    (instance? native.core.TransientMapAssocInstructionV0 instruction) true
    (instance? native.core.TransientSetConjInstructionV0 instruction) true
    (instance? native.core.ArenaInstruction instruction) true
    (instance? native.core.AtomStateInstruction instruction) true
    (instance? native.core.AtomCreateInstruction instruction) true
    (instance? native.core.AtomDerefInstruction instruction) true
    (instance? native.core.AtomResetInstruction instruction) true
    (instance? native.core.AtomCompareExchangeInstruction instruction) true
    (instance? native.core.AtomSwapInstruction instruction) true
    (instance? native.core.TextLengthInstruction instruction) true
    (instance? native.core.TextIndexOfInstruction instruction) true
    (instance? native.core.TextBlankInstruction instruction) true
    (instance? native.core.TextParseI64Instruction instruction) true
    (instance? native.core.TextParseF64Instruction instruction) true
    (instance? native.core.TextSliceInstruction instruction) true
    (instance? native.core.TextConcatInstruction instruction) true
    (instance? native.core.TextBuiltinInstruction instruction) true
    (instance? native.core.ValueSemanticsInstruction instruction) true
    (instance? native.core.ValueToTextInstructionV0 instruction) true
    (instance? native.core.CodecPrimitiveInstructionV0 instruction) true
    :else false))

(defn terminator-supported? [terminator: core/Terminator] -> Bool
  (or (instance? native.core.ReturnTerminator terminator)
      (instance? native.core.JumpTerminator terminator)
      (instance? native.core.BranchTerminator terminator)
      (instance? native.core.SwitchTerminator terminator)
      (instance? native.core.TrapTerminator terminator)))

(defn block-supported? [block: core/BasicBlock] -> Bool
  (and (= 1 (count (core/basicblock-terminators block)))
    (every? instruction-supported? (core/basicblock-instructions block))
    (every? terminator-supported? (core/basicblock-terminators block))))

(defn function-supported? [function: core/FunctionDef] -> Bool
  (and (> (count (core/functiondef-blocks function)) 0)
    (every? block-supported? (core/functiondef-blocks function))))

(defn host-socket-symbol? [symbol: String] -> Bool
  (or (= symbol "native_host_socket_inherited_listener_v0")
      (= symbol "native_host_socket_accept_v0")
      (= symbol "native_host_socket_read_bounded_v0")
      (= symbol "native_host_socket_write_bounded_v0")
      (= symbol "native_host_socket_close_v0")))

(defn host-direct-symbol? [symbol: String] -> Bool
  (or (= symbol "native_host_stdout_write_line_v0")
      (= symbol "native_host_clock_monotonic_nanoseconds_v0")))

(defn program-supported? [program: core/NativeCoreProgram] -> Bool
  (let [layouts: (Vec core/LayoutDef) (core/nativecoreprogram-layouts program)
        types: (Vec core/TypeDef) (core/nativecoreprogram-types program)]
    (and (every? (fn [type-def: core/TypeDef] -> Bool
                   (c17/type-supported? type-def types layouts))
           types)
      (c17/types-orderable? types layouts)
      (every?
        (fn [abi: core/AbiDeclV0] -> Bool
          (or (instance? native.core.AbiExportV0
                (core/abideclv0-direction abi))
            (and (instance? native.core.RestrictedCOptionalOutAbiV0
                   (core/abideclv0-convention abi))
              (= "native_host_environment_lookup_v0"
                (core/abideclv0-symbol abi)))
            (and (instance? native.core.RestrictedCAbiV0
                   (core/abideclv0-convention abi))
              (host-direct-symbol? (core/abideclv0-symbol abi)))
            (and (instance? native.core.RestrictedCOutcomeOutAbiV0
                   (core/abideclv0-convention abi))
              (host-socket-symbol? (core/abideclv0-symbol abi)))))
        (core/nativecoreprogram-abis program))
      (every? function-supported? (core/nativecoreprogram-functions program)))))

(defn block-index [blocks: (Vec core/BasicBlock) target: core/NativeId] -> Int
  (loop [position: Int 0]
    (if (>= position (count blocks))
      -1
      (if (core/native-id= (core/basicblock-id (nth blocks position)) target)
        position
        (recur (+ position 1))))))

(defn label-name [function-index: Int block: Int] -> String
  (str "native_l" function-index "_" block))

(defn function-name [module-index: Int function-index: Int] -> String
  (str (c17/module-prefix module-index) "_fn_" function-index))

;; Every block parameter and instruction result gets one C local declared at the
;; top of the function: a goto target may not jump over a declaration.
(defn function-value-slots [function: core/FunctionDef] -> (Vec ValueSlotV0)
  (let [blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (loop [position: Int 0 slots: (Vec ValueSlotV0) []]
      (if (>= position (count blocks))
        slots
        (let [block: core/BasicBlock (nth blocks position)
              with-parameters: (Vec ValueSlotV0)
              (loop [inner: Int 0
                     collected: (Vec ValueSlotV0) slots
                     parameters: (Vec core/Parameter) (core/basicblock-parameters block)]
                (if (>= inner (count parameters))
                  collected
                  (recur (+ inner 1)
                    (conj collected
                      (->ValueSlotV0 (core/parameter-id (nth parameters inner))
                        (core/parameter-type-id (nth parameters inner))))
                    parameters)))
              with-results: (Vec ValueSlotV0)
              (loop [inner: Int 0
                     collected: (Vec ValueSlotV0) with-parameters
                     instructions: (Vec core/Instruction)
                     (core/basicblock-instructions block)]
                (if (>= inner (count instructions))
                  collected
                  (let [result: core/SsaValueV0
                        (get (nth instructions inner) :result)]
                    (recur (+ inner 1)
                      (conj collected
                        (->ValueSlotV0 (core/ssavaluev0-id result)
                          (core/ssavaluev0-type-id result)))
                      instructions))))]
          (recur (+ position 1) with-results))))))

(defn slot-index [slots: (Vec ValueSlotV0) target: core/NativeId] -> Int
  (loop [position: Int 0]
    (if (>= position (count slots))
      -1
      (if (core/native-id= (valueslotv0-id (nth slots position)) target)
        position
        (recur (+ position 1))))))

(defn parameter-index
  [parameters: (Vec core/Parameter)
   target: core/NativeId] -> Int
  (loop [position: Int 0]
    (if (>= position (count parameters))
      -1
      (if (core/native-id= (core/parameter-id (nth parameters position)) target)
        position
        (recur (+ position 1))))))

(defn value-name
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: core/NativeId] -> String
  (let [position: Int
        (parameter-index (core/functiondef-parameters function) target)]
    (if (>= position 0)
      (str "native_v_" position)
      (str "native_s_" (slot-index slots target)))))

(defn emit-declarations
  [types: (Vec core/TypeDef)
   module-index: Int
   slots: (Vec ValueSlotV0)] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count slots))
      result
      (recur (+ position 1)
        (str result "  "
          (c17/c-type types module-index (valueslotv0-type-id (nth slots position)))
          " native_s_" position ";\n")))))

(defn text-symbol [module-index: Int position: Int] -> String
  (str (c17/module-prefix module-index) "_text_" position))

(defn keyword-symbol [module-index: Int position: Int] -> String
  (str (c17/module-prefix module-index) "_keyword_" position))

(defn atom-expression
  [module-index: Int
   pool: ConstantPoolV0
   atom: core/NativeAtom] -> String
  (cond
    (instance? native.core.BoolAtom atom)
    (if (core/boolatom-value atom) "true" "false")
    (instance? native.core.I64Atom atom)
    (str "INT64_C(" (core/i64atom-value atom) ")")
    (instance? native.core.F64Atom atom) (str (core/f64atom-value atom))
    (instance? native.core.TextAtom atom)
    (str "(uint64_t)(uintptr_t)&"
      (text-symbol module-index
        (value-position (constantpoolv0-texts pool)
          (core/textatom-value atom))))
    (instance? native.core.KeywordAtom atom)
    (str "(uint64_t)(uintptr_t)&"
      (keyword-symbol module-index
        (value-position (constantpoolv0-keywords pool)
          (core/keywordatom-value atom))))
    :else ""))

(defn compare-operator [comparison: core/CompareOpV0] -> String
  (cond
    (or (instance? native.core.CompareEqI64V0 comparison)
        (instance? native.core.CompareEqF64V0 comparison)) "=="
    (or (instance? native.core.CompareLtI64V0 comparison)
        (instance? native.core.CompareLtF64V0 comparison)) "<"
    (or (instance? native.core.CompareLeI64V0 comparison)
        (instance? native.core.CompareLeF64V0 comparison)) "<="
    :else "=="))

(defn emit-text-constant
  [module-index: Int
   position: Int
   value: String] -> String
  (let [symbol: String (text-symbol module-index position)
        literal: String (str "\"" (escape-c-text value) "\"")]
    (str "struct " symbol "_blob { uint64_t length; uint8_t bytes[sizeof "
      literal "]; };\n"
      "static const struct " symbol "_blob " symbol " = { (uint64_t)(sizeof "
      literal " - 1U), " literal " };\n"
      "_Static_assert(offsetof(struct " symbol "_blob, bytes) == 8,"
      " \"text blob is length-prefixed\");\n")))

(defn emit-keyword-pool [module-index: Int keywords: (Vec String)] -> String
  (if (= 0 (count keywords))
    ""
    (loop [position: Int 0 result: String ""]
      (if (>= position (count keywords))
        result
        (let [symbol: String (keyword-symbol module-index position)
              literal: String
              (str "\"" (escape-c-text (nth keywords position)) "\"")]
          (recur (+ position 1)
            (str result
              "struct " symbol "_blob { uint64_t length; uint8_t bytes[sizeof "
              literal "]; };\n"
              "static const struct " symbol "_blob " symbol
              " = { (uint64_t)(sizeof " literal " - 1U), " literal " };\n"
              "_Static_assert(offsetof(struct " symbol "_blob, bytes) == 8,"
              " \"keyword blob is length-prefixed\");\n")))))))

(defn emit-text-pool [module-index: Int pool: ConstantPoolV0] -> String
  (let [texts: (Vec String) (constantpoolv0-texts pool)
        keywords: (Vec String) (constantpoolv0-keywords pool)]
    (str
      (loop [position: Int 0 result: String ""]
        (if (>= position (count texts))
          result
          (recur (+ position 1)
            (str result
              (emit-text-constant module-index position (nth texts position))))))
      (emit-keyword-pool module-index keywords)
      (if (and (= 0 (count texts)) (= 0 (count keywords)))
        ""
        "\n"))))

(defn descriptor-symbol
  [types: (Vec core/TypeDef)
   module-index: Int
   target: core/NativeId] -> String
  (str (c17/module-prefix module-index) "_value_"
    (c17/type-index types target)))

(defn descriptor-kind [definition: core/TypeDef] -> String
  (let [shape: core/TypeShape (core/typedef-shape definition)]
    (cond
      (instance? native.core.AtomType shape)
      (let [kind: core/AtomKind (core/atomtype-kind shape)]
        (cond
          (instance? native.core.BoolKind kind) "NATIVE_VALUE_BOOL"
          (instance? native.core.I64Kind kind) "NATIVE_VALUE_SIGNED"
          (instance? native.core.F64Kind kind) "NATIVE_VALUE_FLOAT"
          (instance? native.core.TextKind kind) "NATIVE_VALUE_TEXT"
          (instance? native.core.BytesKind kind) "NATIVE_VALUE_BYTES"
          (instance? native.core.KeywordKind kind) "NATIVE_VALUE_KEYWORD"
          :else "NATIVE_VALUE_REFERENCE"))
      (instance? native.core.RecordType shape) "NATIVE_VALUE_RECORD"
      (or (instance? native.core.UnionType shape)
          (instance? native.core.OutcomeType shape)) "NATIVE_VALUE_UNION"
      (instance? native.core.VectorType shape) "NATIVE_VALUE_VECTOR"
      (instance? native.core.MapTypeV0 shape) "NATIVE_VALUE_MAP"
      :else "NATIVE_VALUE_REFERENCE")))

(defn field-descriptor-symbol
  [types: (Vec core/TypeDef)
   module-index: Int
   target: core/NativeId] -> String
  (str (descriptor-symbol types module-index target) "_fields"))

(defn variant-descriptor-symbol
  [types: (Vec core/TypeDef)
   module-index: Int
   target: core/NativeId] -> String
  (str (descriptor-symbol types module-index target) "_variants"))

(defn emit-field-descriptors
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int
   layout: core/LayoutDef] -> String
  (let [fields: (Vec core/FieldLayoutV0) (c17/record-layout-fields layout)]
    (if (= 0 (count fields))
      ""
      (str "static const native_value_field_descriptor "
        (field-descriptor-symbol types module-index (core/layoutdef-type-id layout))
        "[] = {\n"
        (loop [position: Int 0 result: String ""]
          (if (>= position (count fields))
            result
            (let [field: core/FieldLayoutV0 (nth fields position)]
              (recur (+ position 1)
                (str result "  { .offset = (size_t)"
                  (core/fieldlayoutv0-offset-bytes field)
                  ", .value = &"
                  (descriptor-symbol types module-index
                    (core/fieldlayoutv0-type-id field))
                  " },\n")))))
        "};\n"))))

(defn emit-variant-descriptors
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int
   layout: core/LayoutDef] -> String
  (let [variants: (Vec core/UnionVariantLayoutV0)
        (c17/union-layout-variants layout)]
    (if (= 0 (count variants))
      ""
      (str "static const native_value_variant_descriptor "
        (variant-descriptor-symbol types module-index
          (core/layoutdef-type-id layout))
        "[] = {\n"
        (loop [position: Int 0 result: String ""]
          (if (>= position (count variants))
            result
            (let [variant: core/UnionVariantLayoutV0 (nth variants position)
                  payload: (U core/NativeId Nil)
                  (core/unionvariantlayoutv0-payload-type variant)]
              (recur (+ position 1)
                (str result "  { .tag = INT64_C("
                  (core/unionvariantlayoutv0-tag variant)
                  "), .payload_offset = (size_t)"
                  (core/unionvariantlayoutv0-payload-offset-bytes variant)
                  ", .payload = "
                  (if (nil? payload)
                    "NULL"
                    (str "&" (descriptor-symbol types module-index payload)))
                  " },\n")))))
        "};\n"))))

(defn descriptor-element
  [types: (Vec core/TypeDef)
   module-index: Int
   layout: core/LayoutDef] -> String
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (cond
      (instance? native.core.VectorShapeV0 shape)
      (str "&" (descriptor-symbol types module-index
        (core/vectorshapev0-element-type shape)))
      (instance? native.core.ReferenceShapeV0 shape)
      (str "&" (descriptor-symbol types module-index
        (core/referenceshapev0-target-type shape)))
      :else "NULL")))

(defn descriptor-stride [layout: core/LayoutDef] -> Int
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (if (instance? native.core.VectorShapeV0 shape)
      (core/vectorshapev0-stride-bytes shape)
      0)))

(defn descriptor-map-key
  [types: (Vec core/TypeDef)
   module-index: Int
   layout: core/LayoutDef] -> String
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (if (instance? native.core.MapShapeV0 shape)
      (str "&" (descriptor-symbol types module-index
        (core/mapshapev0-key-type shape)))
      "NULL")))

(defn descriptor-map-value
  [types: (Vec core/TypeDef)
   module-index: Int
   layout: core/LayoutDef] -> String
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (if (instance? native.core.MapShapeV0 shape)
      (str "&" (descriptor-symbol types module-index
        (core/mapshapev0-value-type shape)))
      "NULL")))

(defn descriptor-tag-offset [layout: core/LayoutDef] -> Int
  (let [shape: core/LayoutShapeV0 (core/layoutdef-shape layout)]
    (if (instance? native.core.UnionShapeV0 shape)
      (core/unionshapev0-tag-offset-bytes shape)
      0)))

(defn emit-value-descriptor
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int
   definition: core/TypeDef] -> String
  (let [target: core/NativeId (core/typedef-id definition)
        layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts target)]
    (if (nil? layout)
      ""
      (let [fields: (Vec core/FieldLayoutV0) (c17/record-layout-fields layout)
            variants: (Vec core/UnionVariantLayoutV0)
            (c17/union-layout-variants layout)]
        (str "const native_value_descriptor "
          (descriptor-symbol types module-index target) " = {\n"
          "  .abi_version = NATIVE_VALUE_ABI_VERSION,\n"
          "  .kind = " (descriptor-kind definition) ",\n"
          "  .size = (size_t)" (core/layoutdef-size-bytes layout) ",\n"
          "  .alignment = (size_t)" (core/layoutdef-align-bytes layout) ",\n"
          "  .tag_offset = (size_t)" (descriptor-tag-offset layout) ",\n"
          "  .fields = "
          (if (= 0 (count fields)) "NULL"
            (field-descriptor-symbol types module-index target)) ",\n"
          "  .field_count = (size_t)" (count fields) ",\n"
          "  .variants = "
          (if (= 0 (count variants)) "NULL"
            (variant-descriptor-symbol types module-index target)) ",\n"
          "  .variant_count = (size_t)" (count variants) ",\n"
          "  .element = " (descriptor-element types module-index layout) ",\n"
          "  .stride = (size_t)" (descriptor-stride layout) ",\n"
          "  .map_key = " (descriptor-map-key types module-index layout) ",\n"
          "  .map_value = " (descriptor-map-value types module-index layout) ",\n"
          "  .keywords = NULL,\n"
          "  .keyword_count = (size_t)0\n"
          "};\n")))))

(defn structural-collection-equality? [instruction: core/Instruction] -> Bool
  (cond
    (instance? native.core.MapLiteralInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/mapliteralinstructionv0-key-equality instruction))
    (instance? native.core.SetLiteralInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/setliteralinstructionv0-element-equality instruction))
    (instance? native.core.MapGetInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/mapgetinstructionv0-key-equality instruction))
    (instance? native.core.MapContainsInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/mapcontainsinstructionv0-key-equality instruction))
    (instance? native.core.MapAssocInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/mapassocinstructionv0-key-equality instruction))
    (instance? native.core.MapDissocInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/mapdissocinstructionv0-key-equality instruction))
    (instance? native.core.SetContainsInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/setcontainsinstructionv0-element-equality instruction))
    (instance? native.core.SetConjInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/setconjinstructionv0-element-equality instruction))
    (instance? native.core.SetDisjInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/setdisjinstructionv0-element-equality instruction))
    (instance? native.core.TransientMapAssocInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/transientmapassocinstructionv0-key-equality instruction))
    (instance? native.core.TransientSetConjInstructionV0 instruction)
    (instance? native.core.StructuralEqualityV0
      (core/transientsetconjinstructionv0-element-equality instruction))
    :else false))

(defn value-descriptors-used? [functions: (Vec core/FunctionDef)] -> Bool
  (some?
    (some
      (fn [function: core/FunctionDef] -> Bool
        (some?
          (some
            (fn [block: core/BasicBlock] -> Bool
              (some?
                (some
                  (fn [instruction: core/Instruction] -> Bool
                    (or
                      (instance? native.core.ValueSemanticsInstruction instruction)
                      (instance? native.core.ValueToTextInstructionV0 instruction)
                      (instance? native.core.VecSortInstructionV0 instruction)
                      (structural-collection-equality? instruction)))
                  (core/basicblock-instructions block))))
            (core/functiondef-blocks function))))
      functions)))

(defn emit-value-descriptors
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   module-index: Int] -> String
  (if (not (value-descriptors-used? functions))
    ""
    (str
      (loop [position: Int 0 result: String ""]
        (if (>= position (count types))
          result
          (recur (+ position 1)
            (str result "extern const native_value_descriptor "
              (descriptor-symbol types module-index
                (core/typedef-id (nth types position)))
              ";\n"))))
      "\n"
      (loop [position: Int 0 result: String ""]
        (if (>= position (count types))
          result
          (let [definition: core/TypeDef (nth types position)
                layout: (U core/LayoutDef Nil)
                (c17/layout-for-type layouts (core/typedef-id definition))]
            (recur (+ position 1)
              (if (nil? layout)
                result
                (str result
                  (emit-field-descriptors types layouts module-index layout)
                  (emit-variant-descriptors types layouts module-index layout)))))))
      (loop [position: Int 0 result: String ""]
        (if (>= position (count types))
          result
          (recur (+ position 1)
            (str result
              (emit-value-descriptor types layouts module-index
                (nth types position))))))
      "\n")))

(defn field-position
  [layouts: (Vec core/LayoutDef)
   owner: core/NativeId
   field: core/NativeId] -> Int
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts owner)]
    (if (nil? layout)
      -1
      (let [fields: (Vec core/FieldLayoutV0) (c17/record-layout-fields layout)]
        (loop [position: Int 0]
          (if (>= position (count fields))
            -1
            (if (core/native-id= (core/fieldlayoutv0-field-id (nth fields position))
                  field)
              position
              (recur (+ position 1)))))))))

(defn slot-type
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: core/NativeId] -> core/NativeId
  (let [position: Int
        (parameter-index (core/functiondef-parameters function) target)]
    (if (>= position 0)
      (core/parameter-type-id (nth (core/functiondef-parameters function) position))
      (let [slot: Int (slot-index slots target)]
        (if (< slot 0)
          (core/->NativeId "native-body-c17-missing-value")
          (valueslotv0-type-id (nth slots slot)))))))

(defn function-index-of
  [functions: (Vec core/FunctionDef)
   target: core/NativeId] -> Int
  (loop [position: Int 0]
    (if (>= position (count functions))
      -1
      (if (core/native-id= (core/functiondef-id (nth functions position)) target)
        position
        (recur (+ position 1))))))

(defn variant-tag
  [layouts: (Vec core/LayoutDef)
   owner: core/NativeId
   variant: core/NativeId] -> Int
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts owner)]
    (if (nil? layout)
      -1
      (let [variants: (Vec core/UnionVariantLayoutV0)
            (c17/union-layout-variants layout)]
        (loop [position: Int 0]
          (if (>= position (count variants))
            -1
            (if (core/native-id=
                  (core/unionvariantlayoutv0-variant-id (nth variants position))
                  variant)
              (core/unionvariantlayoutv0-tag (nth variants position))
              (recur (+ position 1)))))))))

(defn type-with-id
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (U core/TypeDef Nil)
  (loop [position: Int 0]
    (if (>= position (count types))
      nil
      (if (core/native-id= (core/typedef-id (nth types position)) target)
        (nth types position)
          (recur (+ position 1))))))

(defn variant-tag-for-payload
  [layouts: (Vec core/LayoutDef)
   owner: core/NativeId
   payload-type: core/NativeId] -> Int
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts owner)]
    (if (nil? layout)
      -1
      (let [variants: (Vec core/UnionVariantLayoutV0)
            (c17/union-layout-variants layout)]
        (loop [position: Int 0]
          (if (>= position (count variants))
            -1
            (let [variant: core/UnionVariantLayoutV0 (nth variants position)
                  payload: (U core/NativeId Nil)
                  (core/unionvariantlayoutv0-payload-type variant)]
              (if (and (some? payload) (core/native-id= payload payload-type))
                (core/unionvariantlayoutv0-tag variant)
                (recur (+ position 1))))))))))

(defn unit-type? [types: (Vec core/TypeDef) target: core/NativeId] -> Bool
  (let [definition: (U core/TypeDef Nil) (type-with-id types target)]
    (if (nil? definition)
      false
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (not (instance? native.core.UnionType shape))
          false
          (let [variants: (Vec core/TypeVariant)
                (core/uniontype-variants shape)]
            (and (= 1 (count variants))
              (nil? (core/typevariant-payload-type (nth variants 0))))))))))

(defn absent-variant-tag
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   owner: core/NativeId] -> Int
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts owner)]
    (if (nil? layout)
      -1
      (let [variants: (Vec core/UnionVariantLayoutV0)
            (c17/union-layout-variants layout)]
        (loop [position: Int 0]
          (if (>= position (count variants))
            -1
            (let [variant: core/UnionVariantLayoutV0 (nth variants position)
                  payload: (U core/NativeId Nil)
                  (core/unionvariantlayoutv0-payload-type variant)]
              (if (or (nil? payload)
                    (and (some? payload) (unit-type? types payload)))
                (core/unionvariantlayoutv0-tag variant)
                (recur (+ position 1))))))))))

(defn optional-payload-type
  [types: (Vec core/TypeDef)
   owner: core/NativeId] -> (U core/NativeId Nil)
  (let [definition: (U core/TypeDef Nil) (type-with-id types owner)]
    (if (nil? definition)
      nil
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (not (instance? native.core.UnionType shape))
          nil
          (loop [position: Int 0
                 variants: (Vec core/TypeVariant)
                 (core/uniontype-variants shape)]
            (if (>= position (count variants))
              nil
              (let [payload: (U core/NativeId Nil)
                    (core/typevariant-payload-type (nth variants position))]
                (if (or (nil? payload) (unit-type? types payload))
                  (recur (+ position 1) variants)
                  payload)))))))))

(defn outcome-variants
  [types: (Vec core/TypeDef)
   owner: core/NativeId] -> (Vec core/TypeVariant)
  (let [outcome: (U core/TypeDef Nil) (type-with-id types owner)]
    (if (nil? outcome)
      []
      (let [shape: core/TypeShape (core/typedef-shape outcome)]
        (if (not (instance? native.core.OutcomeType shape))
          []
          (let [result: (U core/TypeDef Nil)
                (type-with-id types (core/outcometype-failure-type shape))]
            (if (nil? result)
              []
              (let [result-shape: core/TypeShape (core/typedef-shape result)]
                (if (instance? native.core.UnionType result-shape)
                  (core/uniontype-variants result-shape)
                  [])))))))))

(defn outcome-variant
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   name: String] -> (U core/TypeVariant Nil)
  (let [variants: (Vec core/TypeVariant) (outcome-variants types owner)]
    (loop [position: Int 0]
      (cond
        (>= position (count variants)) nil
        (= name (core/typevariant-name (nth variants position)))
        (nth variants position)
        :else (recur (+ position 1))))))

(defn outcome-variant-tag
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   owner: core/NativeId
   name: String] -> Int
  (let [variant: (U core/TypeVariant Nil) (outcome-variant types owner name)]
    (if (nil? variant)
      -1
      (variant-tag layouts owner (core/typevariant-id variant)))))

(defn outcome-variant-payload
  [types: (Vec core/TypeDef)
   owner: core/NativeId
   name: String] -> (U core/NativeId Nil)
  (let [variant: (U core/TypeVariant Nil) (outcome-variant types owner name)]
    (if (nil? variant) nil (core/typevariant-payload-type variant))))

(defn find-abi
  [abis: (Vec core/AbiDeclV0)
   target: core/NativeId] -> (U core/AbiDeclV0 Nil)
  (loop [position: Int 0]
    (if (>= position (count abis))
      nil
      (if (core/native-id= (core/abideclv0-id (nth abis position)) target)
        (nth abis position)
        (recur (+ position 1))))))

(defn join-c-arguments [arguments: (Vec String)] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count arguments))
      result
      (recur (+ position 1)
        (str result (if (= position 0) "" ", ")
          (nth arguments position))))))

(defn i64-type-id [types: (Vec core/TypeDef)] -> core/NativeId
  (loop [position: Int 0]
    (if (>= position (count types))
      (core/->NativeId "native-body-c17-missing-i64")
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.AtomType shape)
              (instance? native.core.I64Kind (core/atomtype-kind shape)))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn f64-type-id [types: (Vec core/TypeDef)] -> core/NativeId
  (loop [position: Int 0]
    (if (>= position (count types))
      (core/->NativeId "native-body-c17-missing-f64")
      (let [definition: core/TypeDef (nth types position)
            shape: core/TypeShape (core/typedef-shape definition)]
        (if (and (instance? native.core.AtomType shape)
              (instance? native.core.F64Kind (core/atomtype-kind shape)))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn emit-optional-i64-call
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   target: String
   result: core/SsaValueV0
   call: String] -> String
  (let [owner: core/NativeId (core/ssavaluev0-type-id result)
        ok-tag: Int
        (variant-tag-for-payload layouts owner (i64-type-id types))
        absent-tag: Int (absent-variant-tag types layouts owner)]
    (if (or (< ok-tag 0) (< absent-tag 0))
      ""
      (str "  memset(&" target ", 0, sizeof " target ");\n"
        "  if (" call "&" target ".payload.variant_" ok-tag ")) {\n"
        "    " target ".tag = INT64_C(" ok-tag ");\n"
        "  } else {\n"
        "    " target ".tag = INT64_C(" absent-tag ");\n"
        "  }\n"))))

(defn emit-optional-f64-call
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   target: String
   result: core/SsaValueV0
   call: String] -> String
  (let [owner: core/NativeId (core/ssavaluev0-type-id result)
        ok-tag: Int
        (variant-tag-for-payload layouts owner (f64-type-id types))
        absent-tag: Int (absent-variant-tag types layouts owner)]
    (if (or (< ok-tag 0) (< absent-tag 0))
      ""
      (str "  memset(&" target ", 0, sizeof " target ");\n"
        "  if (" call "&" target ".payload.variant_" ok-tag ")) {\n"
        "    " target ".tag = INT64_C(" ok-tag ");\n"
        "  } else {\n"
        "    " target ".tag = INT64_C(" absent-tag ");\n"
        "  }\n"))))

;; A record inside a closed union is a reference, so a field read through it
;; loads via the pointer and takes its layout from the reference target.
(defn dereferenced-type
  [types: (Vec core/TypeDef)
   target: core/NativeId] -> (U core/NativeId Nil)
  (let [definition: (U core/TypeDef Nil) (type-with-id types target)]
    (if (nil? definition)
      nil
      (let [shape: core/TypeShape (core/typedef-shape definition)]
        (if (instance? native.core.ReferenceType shape)
          (core/referencetype-target-type shape)
          nil)))))

;; A callee that declares a region takes the arena (and a capability) ahead of
;; its own parameters, and bounded-effects guarantees the caller holds both.
(defn function-arena-id [function: core/FunctionDef] -> (U core/NativeId Nil)
  (loop [block-position: Int 0]
    (if (>= block-position (count (core/functiondef-blocks function)))
      nil
      (let [instructions: (Vec core/Instruction)
            (core/basicblock-instructions
              (nth (core/functiondef-blocks function) block-position))
            arena-id: (U core/NativeId Nil)
            (loop [instruction-position: Int 0]
              (if (>= instruction-position (count instructions))
                nil
                (let [instruction: core/Instruction
                      (nth instructions instruction-position)]
                  (if (instance? native.core.ArenaInstruction instruction)
                    (core/ssavaluev0-id
                      (core/arenainstruction-result instruction))
                    (recur (+ instruction-position 1))))))]
        (if (nil? arena-id)
          (recur (+ block-position 1))
          arena-id)))))

(defn caller-arena-argument
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)] -> String
  (let [arena-id: (U core/NativeId Nil) (function-arena-id function)]
    (if (nil? arena-id)
      "arena"
      (str "(native_arena *)" (value-name function slots arena-id)))))

(defn callee-resource-arguments
  [functions: (Vec core/FunctionDef)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: core/NativeId] -> String
  (let [position: Int (function-index-of functions target)]
    (if (< position 0)
      ""
      (let [callee: core/FunctionDef (nth functions position)
            arena: String
            (if (> (count (core/functiondef-regions callee)) 0)
              (caller-arena-argument function slots)
              "")
            capability: String
            (if (> (count (core/functiondef-capabilities callee)) 0)
              "capability" "")]
        (cond
          (and (= 0 (count arena)) (= 0 (count capability))) ""
          (= 0 (count capability)) arena
          (= 0 (count arena)) capability
          :else (str arena ", " capability))))))

(defn emit-arguments
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   arguments: (Vec core/NativeId)] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count arguments))
      result
      (recur (+ position 1)
        (str result (if (= position 0) "" ", ")
          (value-name function slots (nth arguments position)))))))

(defn checked-builtin [operation: core/CheckedOperationV0] -> String
  (cond
    (instance? native.core.CheckedAddI64V0 operation) "__builtin_add_overflow"
    (instance? native.core.CheckedSubI64V0 operation) "__builtin_sub_overflow"
    (instance? native.core.CheckedMulI64V0 operation) "__builtin_mul_overflow"
    :else ""))

(defn checked-left [operation: core/CheckedOperationV0] -> core/NativeId
  (cond
    (instance? native.core.CheckedAddI64V0 operation)
    (core/checkedaddi64v0-left-id operation)
    (instance? native.core.CheckedSubI64V0 operation)
    (core/checkedsubi64v0-left-id operation)
    (instance? native.core.CheckedMulI64V0 operation)
    (core/checkedmuli64v0-left-id operation)
    (instance? native.core.CheckedQuotI64V0 operation)
    (core/checkedquoti64v0-left-id operation)
    (instance? native.core.CheckedRemI64V0 operation)
    (core/checkedremi64v0-left-id operation)
    (instance? native.core.CheckedModI64V0 operation)
    (core/checkedmodi64v0-left-id operation)
    (instance? native.core.CheckedBoundsV0 operation)
    (core/checkedboundsv0-index-id operation)
    :else (core/->NativeId "")))

(defn checked-right [operation: core/CheckedOperationV0] -> core/NativeId
  (cond
    (instance? native.core.CheckedAddI64V0 operation)
    (core/checkedaddi64v0-right-id operation)
    (instance? native.core.CheckedSubI64V0 operation)
    (core/checkedsubi64v0-right-id operation)
    (instance? native.core.CheckedMulI64V0 operation)
    (core/checkedmuli64v0-right-id operation)
    (instance? native.core.CheckedQuotI64V0 operation)
    (core/checkedquoti64v0-right-id operation)
    (instance? native.core.CheckedRemI64V0 operation)
    (core/checkedremi64v0-right-id operation)
    (instance? native.core.CheckedModI64V0 operation)
    (core/checkedmodi64v0-right-id operation)
    (instance? native.core.CheckedBoundsV0 operation)
    (core/checkedboundsv0-length-id operation)
    :else (core/->NativeId "")))

(defn checked-division? [operation: core/CheckedOperationV0] -> Bool
  (or (instance? native.core.CheckedQuotI64V0 operation)
      (instance? native.core.CheckedRemI64V0 operation)
      (instance? native.core.CheckedModI64V0 operation)))

;; Guard C's one signed-division UB edge before emitting either / or %.
(defn emit-checked-division
  [layouts: (Vec core/LayoutDef)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   result: core/SsaValueV0
   operation: core/CheckedOperationV0] -> String
  (let [outcome: core/NativeId (core/ssavaluev0-type-id result)
        ok-tag: Int
        (variant-tag layouts outcome (core/checked-division-ok-variant-id))
        zero-tag: Int
        (variant-tag layouts outcome (core/checked-division-zero-variant-id))
        left: String (value-name function slots (checked-left operation))
        right: String (value-name function slots (checked-right operation))
        payload: String (str target ".payload.variant_" ok-tag)
        remainder: String (str target "_remainder")
        edge-value: String
        (if (instance? native.core.CheckedQuotI64V0 operation)
          "INT64_MIN"
          "INT64_C(0)")
        ordinary: String
        (cond
          (instance? native.core.CheckedQuotI64V0 operation)
          (str "    " payload " = " left " / " right ";\n")
          (instance? native.core.CheckedRemI64V0 operation)
          (str "    " payload " = " left " % " right ";\n")
          :else
          (str "    int64_t " remainder " = " left " % " right ";\n"
            "    " payload " = ((" remainder " != INT64_C(0)) &&\n"
            "        ((" remainder " < INT64_C(0)) != (" right
            " < INT64_C(0))))\n"
            "      ? " remainder " + " right " : " remainder ";\n"))]
    (if (or (< ok-tag 0) (< zero-tag 0))
      (str "  if (" right " == INT64_C(0)) {\n"
        "    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
        "  }\n")
      (str "  if (" right " == INT64_C(0)) {\n"
        "    " target ".tag = INT64_C(" zero-tag ");\n"
        "  } else {\n"
        "    " target ".tag = INT64_C(" ok-tag ");\n"
        "    if ((" left " == INT64_MIN) && (" right
        " == -INT64_C(1))) {\n"
        "      " payload " = " edge-value ";\n"
        "    } else {\n"
        ordinary
        "    }\n"
        "  }\n"))))

;; No wrapped value ever escapes: the builtin reports overflow as a tag, and the
;; payload is written only where the ok tag is the one the switch will select.
(defn emit-checked-instruction
  [layouts: (Vec core/LayoutDef)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   result: core/SsaValueV0
   operation: core/CheckedOperationV0] -> String
  (cond
    (instance? native.core.CheckedBoundsV0 operation) ""
    (checked-division? operation)
    (emit-checked-division layouts function slots target result operation)
    :else
    (let [outcome: core/NativeId (core/ssavaluev0-type-id result)
          ok-tag: Int (variant-tag layouts outcome (core/checked-ok-variant-id))
          overflow-tag: Int
          (variant-tag layouts outcome (core/checked-overflow-variant-id))
          left: String (value-name function slots (checked-left operation))
          right: String (value-name function slots (checked-right operation))]
      ;; A checked op whose result type is not the Outcome union has no ok tag to
      ;; write into, so the overflow decision has to become a trap on the spot.
      (if (< ok-tag 0)
        (str "  if (" (checked-builtin operation) "(" left ", " right ", &"
          target ")) {\n"
          "    native_trap(NATIVE_TRAP_OVERFLOW);\n"
          "  }\n")
        (str "  if (" (checked-builtin operation) "(" left ", " right ", &"
          target ".payload.variant_" ok-tag ")) {\n"
          "    " target ".tag = INT64_C(" overflow-tag ");\n"
          "  } else {\n"
          "    " target ".tag = INT64_C(" ok-tag ");\n"
          "  }\n")))))

(defn emit-call-arguments
  [functions: (Vec core/FunctionDef)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: core/NativeId
   arguments: (Vec core/NativeId)] -> String
  (let [prefix: String
        (callee-resource-arguments functions function slots target)
        supplied: String (emit-arguments function slots arguments)]
    (cond
      (= 0 (count prefix)) supplied
      (= 0 (count supplied)) prefix
      :else (str prefix ", " supplied))))

(defn vector-layout-of
  [layouts: (Vec core/LayoutDef)
   vector-type: core/NativeId] -> core/LayoutShapeV0
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts vector-type)]
    (if (nil? layout)
      (core/->VectorShapeV0 vector-type 0)
      (core/layoutdef-shape layout))))

(defn vector-stride
  [layouts: (Vec core/LayoutDef)
   vector-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (vector-layout-of layouts vector-type)]
    (if (instance? native.core.VectorShapeV0 shape)
      (core/vectorshapev0-stride-bytes shape)
      0)))

(defn vector-element-alignment
  [layouts: (Vec core/LayoutDef)
   vector-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (vector-layout-of layouts vector-type)]
    (if (not (instance? native.core.VectorShapeV0 shape))
      1
      (let [element: (U core/LayoutDef Nil)
            (c17/layout-for-type layouts (core/vectorshapev0-element-type shape))]
        (if (nil? element) 1 (core/layoutdef-align-bytes element))))))

(defn collection-layout-of
  [layouts: (Vec core/LayoutDef)
   collection-type: core/NativeId] -> core/LayoutShapeV0
  (let [layout: (U core/LayoutDef Nil)
        (c17/layout-for-type layouts collection-type)]
    (if (nil? layout)
      (core/->ReferenceShapeV0 collection-type)
      (core/layoutdef-shape layout))))

(defn map-key-type
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> core/NativeId
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-key-type shape)
      map-type)))

(defn map-value-type
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> core/NativeId
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-value-type shape)
      map-type)))

(defn map-key-stride
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-key-stride-bytes shape)
      0)))

(defn map-key-alignment
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-key-align-bytes shape)
      1)))

(defn map-value-stride
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-value-stride-bytes shape)
      0)))

(defn map-value-alignment
  [layouts: (Vec core/LayoutDef)
   map-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts map-type)]
    (if (instance? native.core.MapShapeV0 shape)
      (core/mapshapev0-value-align-bytes shape)
      1)))

(defn set-element-type
  [layouts: (Vec core/LayoutDef)
   set-type: core/NativeId] -> core/NativeId
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts set-type)]
    (if (instance? native.core.SetShapeV0 shape)
      (core/setshapev0-element-type shape)
      set-type)))

(defn set-stride [layouts: (Vec core/LayoutDef) set-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts set-type)]
    (if (instance? native.core.SetShapeV0 shape)
      (core/setshapev0-stride-bytes shape)
      0)))

(defn set-alignment
  [layouts: (Vec core/LayoutDef)
   set-type: core/NativeId] -> Int
  (let [shape: core/LayoutShapeV0 (collection-layout-of layouts set-type)]
    (if (instance? native.core.SetShapeV0 shape)
      (core/setshapev0-align-bytes shape)
      1)))

(defn concrete-equality-name
  [types: (Vec core/TypeDef)
   module-index: Int
   equality: core/ConcreteEqualityV0] -> String
  (cond
    (instance? native.core.BoolEqualityV0 equality)
    "NATIVE_COLLECTION_EQ_BOOL"
    (instance? native.core.I64EqualityV0 equality)
    "NATIVE_COLLECTION_EQ_I64"
    (instance? native.core.F64EqualityV0 equality)
    "NATIVE_COLLECTION_EQ_F64"
    (instance? native.core.TextEqualityV0 equality)
    "NATIVE_COLLECTION_EQ_TEXT"
    (instance? native.core.KeywordEqualityV0 equality)
    "NATIVE_COLLECTION_EQ_KEYWORD"
    :else
    (str "NATIVE_COLLECTION_EQ_STRUCTURAL(&"
      (descriptor-symbol types module-index
        (core/structuralequalityv0-domain-type equality))
      ")")))

(defn emit-value-list
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   values: (Vec core/NativeId)] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count values))
      result
      (recur (+ position 1)
        (str result (if (= position 0) " " ", ")
          (value-name function slots (nth values position)))))))

(defn collection-symbol
  [prefix: String
   slots: (Vec ValueSlotV0)
   result-id: core/NativeId] -> String
  (str "native_" prefix "_" (slot-index slots result-id)))

(defn parts-symbol [slots: (Vec ValueSlotV0) result-id: core/NativeId] -> String
  (str "native_parts_" (slot-index slots result-id)))

(defn text-operand-expression
  [types: (Vec core/TypeDef)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   arena: String
   operand: core/NativeId] -> String
  (let [operand-type: core/NativeId (slot-type function slots operand)
        definition: (U core/TypeDef Nil)
        (c17/type-def-for types operand-type)
        text: Bool
        (if (nil? definition) false (c17/text-type-def? definition))]
    (if text
      (value-name function slots operand)
      (str "native_text_from_int(" arena ", "
        (value-name function slots operand) ")"))))

(defn emit-optional-out-extern-call
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   abis: (Vec core/AbiDeclV0)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   instruction: core/ExternCallInstruction] -> String
  (let [abi: (U core/AbiDeclV0 Nil)
        (find-abi abis (core/externcallinstruction-abi-id instruction))]
    (if (nil? abi)
      ""
      (let [result: core/SsaValueV0
            (core/externcallinstruction-result instruction)
            owner: core/NativeId (core/ssavaluev0-type-id result)
            payload: (U core/NativeId Nil) (optional-payload-type types owner)
            result-value: (U core/AbiValueV0 Nil) (core/abideclv0-result abi)
            arena-id: (U core/NativeId Nil)
            (core/externcallinstruction-arena-id instruction)
            ok-tag: Int
            (if (nil? payload) -1
              (variant-tag-for-payload layouts owner payload))
            absent-tag: Int (absent-variant-tag types layouts owner)]
        (if (or (nil? payload) (nil? result-value) (nil? arena-id)
              (< ok-tag 0) (< absent-tag 0))
          ""
          (let [hidden: (Vec String)
                [(str "(native_arena *)"
                   (value-name function slots arena-id))]
                with-capability: (Vec String)
                (if (> (count (core/abideclv0-required-capabilities abi)) 0)
                  (conj hidden "capability")
                  hidden)
                arguments: (Vec String)
                (loop [position: Int 0
                       collected: (Vec String) with-capability
                       values: (Vec core/NativeId)
                       (core/externcallinstruction-arguments instruction)]
                  (if (>= position (count values))
                    collected
                    (recur (+ position 1)
                      (conj collected
                        (value-name function slots (nth values position)))
                      values)))
                call-arguments: (Vec String)
                (conj arguments
                  (str "&" target ".payload.variant_" ok-tag))]
            (str "  memset(&" target ", 0, sizeof " target ");\n"
              "  if (" (core/abideclv0-symbol abi) "("
              (join-c-arguments call-arguments) ")) {\n"
              "    " target ".tag = INT64_C(" ok-tag ");\n"
              "  } else {\n"
              "    " target ".tag = INT64_C(" absent-tag ");\n"
              "  }\n")))))))

(defn emit-text-builtin
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   operation: core/TextBuiltinOpV0] -> String
  (cond
    (instance? native.core.TextCompareV0 operation)
    (str "  " target " = native_text_compare("
      (value-name function slots (core/textcomparev0-left-id operation)) ", "
      (value-name function slots (core/textcomparev0-right-id operation)) ");\n")
    (instance? native.core.TextEndsWithV0 operation)
    (let [source: String
          (value-name function slots (core/textendswithv0-source-id operation))
          suffix: String
          (value-name function slots (core/textendswithv0-suffix-id operation))
          source-length: String (str target "_source_length")
          suffix-length: String (str target "_suffix_length")]
      (str "  {\n"
        "    const uint64_t " source-length " = native_text_length(" source ");\n"
        "    const uint64_t " suffix-length " = native_text_length(" suffix ");\n"
        "    " target " = (" suffix-length " <= " source-length ") &&\n"
        "      ((" suffix-length " == UINT64_C(0)) ||\n"
        "       (memcmp(native_text_bytes(" source ") + (" source-length " - "
        suffix-length "), native_text_bytes(" suffix "), (size_t)"
        suffix-length ") == 0));\n"
        "  }\n"))
    (instance? native.core.TextTrimV0 operation)
    (str "  " target " = native_text_trim((native_arena *)"
      (value-name function slots (core/texttrimv0-arena-id operation)) ", "
      (value-name function slots (core/texttrimv0-source-id operation)) ");\n")
    (instance? native.core.TextLowerV0 operation)
    (str "  " target " = native_text_lower_root((native_arena *)"
      (value-name function slots (core/textlowerv0-arena-id operation)) ", "
      (value-name function slots (core/textlowerv0-source-id operation)) ");\n")
    (instance? native.core.TextLetterDecimalRunsV0 operation)
    (str "  " target " = native_text_letter_decimal_runs((native_arena *)"
      (value-name function slots
        (core/textletterdecimalrunsv0-arena-id operation)) ", "
      (value-name function slots
        (core/textletterdecimalrunsv0-source-id operation)) ", "
      (value-name function slots
        (core/textletterdecimalrunsv0-pattern-id operation)) ");\n")
    (instance? native.core.TextRegexReplaceV0 operation)
    (str "  " target " = native_text_regex_replace((native_arena *)"
      (value-name function slots (core/textregexreplacev0-arena-id operation)) ", "
      (value-name function slots (core/textregexreplacev0-source-id operation)) ", "
      (value-name function slots (core/textregexreplacev0-pattern-id operation)) ", "
      (value-name function slots (core/textregexreplacev0-replacement-id operation)) ");\n")
    (instance? native.core.TextRegexMatchesV0 operation)
    (str "  " target " = native_text_regex_matches("
      (value-name function slots (core/textregexmatchesv0-source-id operation)) ", "
      (value-name function slots (core/textregexmatchesv0-pattern-id operation)) ");\n")
    (instance? native.core.TextRegexFindV0 operation)
    (str "  " target " = native_text_regex_find((native_arena *)"
      (value-name function slots (core/textregexfindv0-arena-id operation)) ", "
      (value-name function slots (core/textregexfindv0-source-id operation)) ", "
      (value-name function slots (core/textregexfindv0-pattern-id operation)) ");\n")
    (instance? native.core.TextSplitV0 operation)
    (str "  " target " = native_text_regex_split((native_arena *)"
      (value-name function slots (core/textsplitv0-arena-id operation)) ", "
      (value-name function slots (core/textsplitv0-source-id operation)) ", "
      (value-name function slots (core/textsplitv0-pattern-id operation)) ");\n")
    (instance? native.core.TextVectorTrimV0 operation)
    (str "  " target " = native_text_vector_trim((native_arena *)"
      (value-name function slots (core/textvectortrimv0-arena-id operation)) ", "
      (value-name function slots (core/textvectortrimv0-source-id operation)) ");\n")
    (instance? native.core.TextVectorRemoveBlankV0 operation)
    (str "  " target " = native_text_vector_remove_blank((native_arena *)"
      (value-name function slots
        (core/textvectorremoveblankv0-arena-id operation)) ", "
      (value-name function slots
        (core/textvectorremoveblankv0-source-id operation)) ");\n")
    (instance? native.core.TextJoinV0 operation)
    (str "  " target " = native_text_join((native_arena *)"
      (value-name function slots (core/textjoinv0-arena-id operation)) ", "
      (value-name function slots (core/textjoinv0-separator-id operation)) ", "
      (value-name function slots (core/textjoinv0-source-id operation)) ");\n")
    :else
    (str "  " target " = native_text_repeat((native_arena *)"
      (value-name function slots (core/textrepeatv0-arena-id operation)) ", "
      (value-name function slots (core/textrepeatv0-source-id operation)) ", "
      (value-name function slots (core/textrepeatv0-count-id operation)) ");\n")))

(defn emit-map-get
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   module-index: Int
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   instruction: core/MapGetInstructionV0] -> String
  (let [result: core/SsaValueV0 (core/mapgetinstructionv0-result instruction)
        result-id: core/NativeId (core/ssavaluev0-id result)
        target: String (value-name function slots result-id)
        source: core/NativeId (core/mapgetinstructionv0-source-id instruction)
        source-type: core/NativeId (slot-type function slots source)
        value-type: core/NativeId (map-value-type layouts source-type)
        default: (U core/NativeId Nil)
        (core/mapgetinstructionv0-default-id instruction)
        hit: String (collection-symbol "map_hit" slots result-id)
        call: String
        (str "native_map_get(" (value-name function slots source) ", &"
          (value-name function slots (core/mapgetinstructionv0-key-id instruction))
          ", "
          (concrete-equality-name
            types module-index
            (core/mapgetinstructionv0-key-equality instruction))
          ")")]
    (if (some? default)
      (str "  {\n    const void *" hit " = " call ";\n"
        "    " target " = (" hit " == NULL) ? "
        (value-name function slots default) " : *(const "
        (c17/c-type types module-index value-type) " *)" hit ";\n  }\n")
      (let [result-type: core/NativeId (core/ssavaluev0-type-id result)
            absent-tag: Int (absent-variant-tag types layouts result-type)]
        (if (core/native-id= result-type value-type)
          (if (< absent-tag 0)
            ""
            (str "  {\n    const void *" hit " = " call ";\n"
              "    if (" hit " != NULL) {\n"
              "      " target " = *(const "
              (c17/c-type types module-index value-type) " *)" hit ";\n"
              "    } else {\n      memset(&" target ", 0, sizeof " target ");\n"
              "      " target ".tag = INT64_C(" absent-tag ");\n"
              "    }\n  }\n"))
          (let [value-tag: Int
                (variant-tag-for-payload layouts result-type value-type)]
            (if (or (< value-tag 0) (< absent-tag 0))
              ""
              (str "  {\n    const void *" hit " = " call ";\n"
                "    memset(&" target ", 0, sizeof " target ");\n"
                "    if (" hit " != NULL) {\n"
                "      " target ".tag = INT64_C(" value-tag ");\n"
                "      " target ".payload.variant_" value-tag " = *(const "
                (c17/c-type types module-index value-type) " *)" hit ";\n"
                "    } else {\n"
                "      " target ".tag = INT64_C(" absent-tag ");\n"
                "    }\n  }\n"))))))))

(defn emit-direct-extern-call
  [abis: (Vec core/AbiDeclV0)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   instruction: core/ExternCallInstruction] -> String
  (let [abi: (U core/AbiDeclV0 Nil)
        (find-abi abis (core/externcallinstruction-abi-id instruction))]
    (if (nil? abi)
      ""
      (let [result-value: (U core/AbiValueV0 Nil)
            (core/abideclv0-result abi)
            arena-id: (U core/NativeId Nil)
            (core/externcallinstruction-arena-id instruction)
            hidden: (Vec String)
            (if (> (count (core/abideclv0-required-capabilities abi)) 0)
              ["capability"]
              [])
            arguments: (Vec String)
            (loop [position: Int 0
                   collected: (Vec String) hidden
                   values: (Vec core/NativeId)
                   (core/externcallinstruction-arguments instruction)]
              (if (>= position (count values))
                collected
                (recur (+ position 1)
                  (conj collected
                    (value-name function slots (nth values position)))
                  values)))]
        (if (not (nil? arena-id))
          ""
          (if (nil? result-value)
            (str "  " (core/abideclv0-symbol abi) "("
              (join-c-arguments arguments) ");\n"
              "  memset(&" target ", 0, sizeof " target ");\n")
            (str "  " target " = " (core/abideclv0-symbol abi) "("
              (join-c-arguments arguments) ");\n")))))))

(defn emit-outcome-out-extern-call
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   abis: (Vec core/AbiDeclV0)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   instruction: core/ExternCallInstruction] -> String
  (let [abi: (U core/AbiDeclV0 Nil)
        (find-abi abis (core/externcallinstruction-abi-id instruction))]
    (if (nil? abi)
      ""
      (let [result: core/SsaValueV0
            (core/externcallinstruction-result instruction)
            owner: core/NativeId (core/ssavaluev0-type-id result)
            ok-variant: (U core/TypeVariant Nil)
            (outcome-variant types owner "ok")
            peer-variant: (U core/TypeVariant Nil)
            (outcome-variant types owner "peer-closed")
            error-variant: (U core/TypeVariant Nil)
            (outcome-variant types owner "error")
            ok-payload: (U core/NativeId Nil)
            (outcome-variant-payload types owner "ok")
            error-payload: (U core/NativeId Nil)
            (outcome-variant-payload types owner "error")
            ok-tag: Int (outcome-variant-tag types layouts owner "ok")
            peer-tag: Int
            (outcome-variant-tag types layouts owner "peer-closed")
            error-tag: Int (outcome-variant-tag types layouts owner "error")
            result-value: (U core/AbiValueV0 Nil)
            (core/abideclv0-result abi)
            arena-id: (U core/NativeId Nil)
            (core/externcallinstruction-arena-id instruction)]
        (if (or (nil? ok-variant) (nil? peer-variant) (nil? error-variant)
              (nil? error-payload) (nil? result-value)
              (< ok-tag 0) (< peer-tag 0) (< error-tag 0))
          ""
          (let [hidden: (Vec String)
                (if (nil? arena-id)
                  []
                  [(str "(native_arena *)"
                     (value-name function slots arena-id))])
                with-capability: (Vec String)
                (if (> (count (core/abideclv0-required-capabilities abi)) 0)
                  (conj hidden "capability")
                  hidden)
                arguments: (Vec String)
                (loop [position: Int 0
                       collected: (Vec String) with-capability
                       values: (Vec core/NativeId)
                       (core/externcallinstruction-arguments instruction)]
                  (if (>= position (count values))
                    collected
                    (recur (+ position 1)
                      (conj collected
                        (value-name function slots (nth values position)))
                      values)))
                call-arguments: (Vec String)
                (if (nil? ok-payload)
                  arguments
                  (conj arguments
                    (str "&" target ".payload.variant_" ok-tag)))
                status: String (str target "_status")]
            (str "  memset(&" target ", 0, sizeof " target ");\n"
              "  {\n"
              "    int32_t " status " = " (core/abideclv0-symbol abi) "("
              (join-c-arguments call-arguments) ");\n"
              "    if (" status " == INT32_C(0)) {\n"
              "      " target ".tag = INT64_C(" ok-tag ");\n"
              "    } else if (" status
              " == NATIVE_HOST_SOCKET_PEER_CLOSED) {\n"
              "      " target ".tag = INT64_C(" peer-tag ");\n"
              "    } else {\n"
              "      " target ".tag = INT64_C(" error-tag ");\n"
              "      " target ".payload.variant_" error-tag
              " = (int64_t)" status ";\n"
              "    }\n"
              "  }\n")))))))

(defn emit-extern-call
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   abis: (Vec core/AbiDeclV0)
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   target: String
   instruction: core/ExternCallInstruction] -> String
  (let [abi: (U core/AbiDeclV0 Nil)
        (find-abi abis (core/externcallinstruction-abi-id instruction))]
    (if (nil? abi)
      ""
      (cond
        (instance? native.core.RestrictedCOptionalOutAbiV0
          (core/abideclv0-convention abi))
        (emit-optional-out-extern-call types layouts abis function slots target
          instruction)

        (instance? native.core.RestrictedCOutcomeOutAbiV0
          (core/abideclv0-convention abi))
        (emit-outcome-out-extern-call types layouts abis function slots target
          instruction)

        (instance? native.core.RestrictedCAbiV0
          (core/abideclv0-convention abi))
        (emit-direct-extern-call abis function slots target instruction)

        :else ""))))

(defn value-referenced?
  [function: core/FunctionDef
   target: core/NativeId] -> Bool
  (let [blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (loop [position: Int 0]
      (if (>= position (count blocks))
        false
        (let [block: core/BasicBlock (nth blocks position)
              instructions: (Vec core/Instruction)
              (core/basicblock-instructions block)
              terminators: (Vec core/Terminator)
              (core/basicblock-terminators block)
              instruction-use: Bool
              (loop [inner: Int 0]
                (if (>= inner (count instructions))
                  false
                  (if (core/id-in?
                        (core/instruction-ssa-refs (nth instructions inner)) target)
                    true
                    (recur (+ inner 1)))))
              terminator-use: Bool
              (loop [inner: Int 0]
                (if (>= inner (count terminators))
                  false
                  (if (core/id-in?
                        (core/terminator-ssa-refs (nth terminators inner)) target)
                    true
                    (recur (+ inner 1)))))]
          (if (or instruction-use terminator-use)
            true
            (recur (+ position 1))))))))

(defn emit-unused-block-parameters
  [function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   block: core/BasicBlock] -> String
  (let [parameters: (Vec core/Parameter) (core/basicblock-parameters block)]
    (loop [position: Int 0 emitted: String ""]
      (if (>= position (count parameters))
        emitted
        (let [parameter: core/Parameter (nth parameters position)]
          (recur (+ position 1)
            (if (value-referenced? function (core/parameter-id parameter))
              emitted
              (str emitted "  (void)"
                (value-name function slots (core/parameter-id parameter)) ";\n"))))))))

(defn emit-instruction
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   module-index: Int
   pool: ConstantPoolV0
   function: core/FunctionDef
   slots: (Vec ValueSlotV0)
   instruction: core/Instruction] -> String
  (let [result: core/SsaValueV0 (get instruction :result)
        target: String (value-name function slots (core/ssavaluev0-id result))
        emitted: String
        (cond
      (instance? native.core.AtomInstruction instruction)
      (str "  " target " = "
        (atom-expression module-index pool
          (core/atominstruction-atom instruction))
        ";\n  (void)" target ";\n")

      (instance? native.core.ArenaInstruction instruction)
      (str "  " target " = arena;\n  (void)" target ";\n")

      (instance? native.core.AtomStateInstruction instruction)
      (str "  " target " = (void *)capability;\n  (void)" target ";\n")

      (instance? native.core.AtomCreateInstruction instruction)
      (let [initial-id: core/NativeId
            (core/atomcreateinstruction-initial-id instruction)
            initial: String (value-name function slots initial-id)
            initial-type: core/NativeId (slot-type function slots initial-id)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/atomcreateinstruction-arena-id instruction)))
            state: String
            (str "(const native_capability *)"
              (value-name function slots
                (core/atomcreateinstruction-state-id instruction)))
            content: String (c17/c-type types module-index initial-type)]
        (str "  " target " = native_atom_new(" arena ", " state ", &"
          initial ", sizeof(" content "), _Alignof(" content "));\n"))

      (instance? native.core.AtomDerefInstruction instruction)
      (let [cell: String
            (value-name function slots
              (core/atomderefinstruction-cell-id instruction))
            state: String
            (str "(const native_capability *)"
              (value-name function slots
                (core/atomderefinstruction-state-id instruction)))]
        (str "  native_atom_deref(" cell ", " state ", &" target
          ", sizeof(" target "));\n"))

      (instance? native.core.AtomResetInstruction instruction)
      (let [cell: String
            (value-name function slots
              (core/atomresetinstruction-cell-id instruction))
            state: String
            (str "(const native_capability *)"
              (value-name function slots
                (core/atomresetinstruction-state-id instruction)))
            value: String
            (value-name function slots
              (core/atomresetinstruction-value-id instruction))]
        (str "  native_atom_lock(" cell ", " state ", &" target
          ", sizeof(" target "));\n"
          "  " target " = " value ";\n"
          "  native_atom_store_unlock(" cell ", " state ", &" target
          ", sizeof(" target "));\n"))

      (instance? native.core.AtomCompareExchangeInstruction instruction)
      (let [cell: String
            (value-name function slots
              (core/atomcompareexchangeinstruction-cell-id instruction))
            state: String
            (str "(const native_capability *)"
              (value-name function slots
                (core/atomcompareexchangeinstruction-state-id instruction)))
            expected: String
            (value-name function slots
              (core/atomcompareexchangeinstruction-expected-id instruction))
            replacement: String
            (value-name function slots
              (core/atomcompareexchangeinstruction-replacement-id instruction))]
        (str "  " target " = native_atom_compare_exchange(" cell ", " state
          ", &" expected ", &" replacement ", sizeof(" replacement "));\n"))

      (instance? native.core.AtomSwapInstruction instruction)
      (let [cell: String
            (value-name function slots
              (core/atomswapinstruction-cell-id instruction))
            state: String
            (str "(const native_capability *)"
              (value-name function slots
                (core/atomswapinstruction-state-id instruction)))
            updater: String
            (function-name module-index
              (function-index-of functions
                (core/atomswapinstruction-updater-id instruction)))
            arguments: (Vec core/NativeId)
            (core/atomswapinstruction-arguments instruction)]
        (str "  native_atom_lock(" cell ", " state ", &" target
          ", sizeof(" target "));\n"
          "  " target " = " updater "(" target
          (loop [position: Int 0 fragment: String ""]
            (if (>= position (count arguments))
              fragment
              (recur (+ position 1)
                (str fragment ", "
                  (value-name function slots (nth arguments position))))))
          ");\n"
          "  native_atom_store_unlock(" cell ", " state ", &" target
          ", sizeof(" target "));\n"))

      (instance? native.core.TextLengthInstruction instruction)
      (str "  " target " = (int64_t)native_text_length("
        (value-name function slots
          (core/textlengthinstruction-source-id instruction))
        ");\n")

      (instance? native.core.TextIndexOfInstruction instruction)
      (emit-optional-i64-call types layouts target result
        (str "native_text_index_of("
          (value-name function slots
            (core/textindexofinstruction-source-id instruction))
          ", "
          (value-name function slots
            (core/textindexofinstruction-needle-id instruction))
          ", "))

      (instance? native.core.TextBlankInstruction instruction)
      (str "  " target " = native_text_is_blank("
        (value-name function slots
          (core/textblankinstruction-source-id instruction))
        ");\n")

      (instance? native.core.TextParseI64Instruction instruction)
      (emit-optional-i64-call types layouts target result
        (str "native_text_parse_i64("
          (value-name function slots
            (core/textparsei64instruction-source-id instruction))
          ", "))

      (instance? native.core.TextParseF64Instruction instruction)
      (emit-optional-f64-call types layouts target result
        (str "native_text_parse_f64("
          (value-name function slots
            (core/textparsef64instruction-source-id instruction))
          ", "))

      (instance? native.core.TextSliceInstruction instruction)
      (let [arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/textsliceinstruction-arena-id instruction)))
            source: String
            (value-name function slots
              (core/textsliceinstruction-source-id instruction))
            start: String
            (value-name function slots
              (core/textsliceinstruction-start-id instruction))
            end: String
            (value-name function slots
              (core/textsliceinstruction-end-id instruction))]
        (str "  if ((" start " < INT64_C(0)) || (" end " < " start
          ") ||\n      (" end " > (int64_t)native_text_length(" source "))) {\n"
          "    native_trap(UINT32_C("
          (core/textsliceinstruction-failure-code instruction) "));\n"
          "  }\n"
          "  " target " = native_text_slice(" arena ", " source ", (uint64_t)"
          start ", (uint64_t)" end ");\n"))

      (instance? native.core.TextConcatInstruction instruction)
      (let [arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/textconcatinstruction-arena-id instruction)))
            operands: (Vec core/NativeId)
            (core/textconcatinstruction-operand-ids instruction)
            parts: String (parts-symbol slots (core/ssavaluev0-id result))]
        (str "  {\n    const uint64_t " parts "[" (count operands) "] = {"
          (loop [position: Int 0 fragment: String ""]
            (if (>= position (count operands))
              fragment
              (recur (+ position 1)
                (str fragment (if (= position 0) " " ", ")
                  (text-operand-expression types function slots arena
                    (nth operands position))))))
          " };\n    " target " = native_text_concat(" arena ", " parts
          ", UINT64_C(" (count operands) "));\n  }\n"))

      (instance? native.core.TextBuiltinInstruction instruction)
      (emit-text-builtin function slots target
        (core/textbuiltininstruction-builtin instruction))

      (instance? native.core.CopyInstruction instruction)
      (str "  " target " = "
        (value-name function slots (core/copyinstruction-source-id instruction))
        ";\n")

      (instance? native.core.AddF64Instruction instruction)
      (str "  " target " = "
        (value-name function slots
          (core/addf64instruction-left-id instruction))
        " + "
        (value-name function slots
          (core/addf64instruction-right-id instruction))
        ";\n")

      (instance? native.core.SubF64InstructionV0 instruction)
      (str "  " target " = "
        (value-name function slots
          (core/subf64instructionv0-left-id instruction))
        " - "
        (value-name function slots
          (core/subf64instructionv0-right-id instruction))
        ";\n")

      (instance? native.core.MulF64InstructionV0 instruction)
      (str "  " target " = "
        (value-name function slots
          (core/mulf64instructionv0-left-id instruction))
        " * "
        (value-name function slots
          (core/mulf64instructionv0-right-id instruction))
        ";\n")

      (instance? native.core.DivF64InstructionV0 instruction)
      (let [left: String
            (value-name function slots
              (core/divf64instructionv0-left-id instruction))
            right: String
            (value-name function slots
              (core/divf64instructionv0-right-id instruction))]
        (str "  if (" right " == 0.0) {\n"
          "    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
          "  }\n"
          "  " target " = " left " / " right ";\n"))

      (instance? native.core.I64ToF64InstructionV0 instruction)
      (str "  " target " = (double)"
        (value-name function slots
          (core/i64tof64instructionv0-source-id instruction))
        ";\n")

      (instance? native.core.CompareInstruction instruction)
      (let [left: String
            (value-name function slots
              (core/compareinstruction-left-id instruction))
            right: String
            (value-name function slots
              (core/compareinstruction-right-id instruction))
            comparison: core/CompareOpV0
            (core/compareinstruction-comparison instruction)]
        (if (instance? native.core.CompareEqTextV0 comparison)
          (str "  " target " = native_text_eq(" left ", " right ");\n")
          (str "  " target " = (" left " " (compare-operator comparison) " "
            right ");\n")))

      (instance? native.core.ValueSemanticsInstruction instruction)
      (let [operation: core/ValueSemanticsOpV0
            (core/valuesemanticsinstruction-operation instruction)]
        (match operation
          [(ValueEqualV0 domain-type left-id right-id)
          (str "  " target " = native_value_equal(&"
            (descriptor-symbol types module-index domain-type)
            ", &"
            (value-name function slots left-id)
            ", &"
            (value-name function slots right-id)
            ");\n")]

          [(ValueHashV0 domain-type value-id)
           (str "  " target " = native_value_hash(&"
             (descriptor-symbol types module-index domain-type)
             ", &"
             (value-name function slots value-id)
             ");\n")]

          [(ValueCompareV0 domain-type left-id right-id)
           (str "  " target " = native_value_compare(&"
             (descriptor-symbol types module-index domain-type)
             ", &"
             (value-name function slots left-id)
             ", &"
             (value-name function slots right-id)
             ");\n")]))

      (instance? native.core.ValueToTextInstructionV0 instruction)
      (str "  " target " = native_value_to_text((native_arena *)"
        (value-name function slots
          (core/valuetotextinstructionv0-arena-id instruction))
        ", &"
        (descriptor-symbol types module-index
          (core/valuetotextinstructionv0-domain-type instruction))
        ", &"
        (value-name function slots
          (core/valuetotextinstructionv0-value-id instruction))
        ", "
        (if (instance? native.core.ValuePrStrV0
              (core/valuetotextinstructionv0-mode instruction))
          "NATIVE_VALUE_PR_STR"
          "NATIVE_VALUE_STR")
        ");\n")

      (instance? native.core.CodecPrimitiveInstructionV0 instruction)
      (let [operation: core/CodecPrimitiveOpV0
            (core/codecprimitiveinstructionv0-operation instruction)]
        (cond
          (instance? native.core.Utf8EncodeV0 operation)
          (str "  " target " = native_utf8_encode((native_arena *)"
            (value-name function slots (core/utf8encodev0-arena-id operation))
            ", "
            (value-name function slots (core/utf8encodev0-source-id operation))
            ");\n")
          (instance? native.core.Utf8DecodeV0 operation)
          (str "  " target " = native_utf8_decode((native_arena *)"
            (value-name function slots (core/utf8decodev0-arena-id operation))
            ", "
            (value-name function slots (core/utf8decodev0-source-id operation))
            ");\n")
          (instance? native.core.Utf8DecodeSourceV0 operation)
          (str "  " target " = native_utf8_decode_source((native_arena *)"
            (value-name function slots
              (core/utf8decodesourcev0-arena-id operation))
            ", (const native_byte_source *)"
            (value-name function slots
              (core/utf8decodesourcev0-source-id operation))
            ");\n")
          (instance? native.core.Sha256BytesV0 operation)
          (str "  " target " = native_sha256_bytes((native_arena *)"
            (value-name function slots (core/sha256bytesv0-arena-id operation))
            ", "
            (value-name function slots (core/sha256bytesv0-source-id operation))
            ");\n")
          (instance? native.core.FloatToBitsV0 operation)
          (str "  " target " = native_float_to_bits("
            (value-name function slots (core/floattobitsv0-source-id operation))
            ");\n")
          :else
          (str "  " target " = native_float_from_bits("
            (value-name function slots (core/floatfrombitsv0-source-id operation))
            ");\n")))

      (instance? native.core.FieldInstruction instruction)
      (let [source: core/NativeId (core/fieldinstruction-source-id instruction)
            source-type: core/NativeId (slot-type function slots source)
            pointee: (U core/NativeId Nil) (dereferenced-type types source-type)
            owner: core/NativeId (if (nil? pointee) source-type pointee)
            position: Int
            (field-position layouts owner
              (core/fieldinstruction-field-id instruction))
            access: String
            (if (nil? pointee)
              (str (value-name function slots source) ".")
              (str "((" (c17/c-type types module-index owner) " *)"
                (value-name function slots source) ")->"))]
        (str "  " target " = " access "field_" position ";\n"))

      (instance? native.core.UnionConstructInstruction instruction)
      (let [union-type: core/NativeId (core/ssavaluev0-type-id result)
            tag: Int
            (variant-tag layouts union-type
              (core/unionconstructinstruction-variant-id instruction))
            payload: (U core/NativeId Nil)
            (core/unionconstructinstruction-payload-id instruction)]
        (if (nil? payload)
          (str "  " target " = (" (c17/c-type types module-index union-type)
            "){ .tag = INT64_C(" tag ") };\n")
          (str "  " target " = (" (c17/c-type types module-index union-type)
            "){ .tag = INT64_C(" tag "), .payload = { .variant_" tag " = "
            (value-name function slots payload) " } };\n")))

      ;; The tag test is the whole check: a mismatch must trap, never
      ;; reinterpret the payload bytes as the expected variant.
      (instance? native.core.UnionExtractInstruction instruction)
      (let [source: core/NativeId
            (core/unionextractinstruction-source-id instruction)
            source-name: String (value-name function slots source)
            tag: Int
            (variant-tag layouts (slot-type function slots source)
              (core/unionextractinstruction-variant-id instruction))]
        (str "  if (" source-name ".tag != INT64_C(" tag ")) {\n"
          "    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
          "  }\n"
          "  " target " = " source-name ".payload.variant_" tag ";\n"
          (if (unit-type? types (core/ssavaluev0-type-id result))
            (str "  (void)" target ";\n")
            "")))

      (instance? native.core.CheckedInstruction instruction)
      (emit-checked-instruction layouts function slots target result
        (core/checkedinstruction-operation instruction))

      (instance? native.core.BitwiseInstructionV0 instruction)
      (let [operation: core/BitwiseOperationV0
            (core/bitwiseinstructionv0-operation instruction)]
        (cond
          (instance? native.core.BitAndI64V0 operation)
          (str "  " target " = native_bit_and_i64("
            (value-name function slots (core/bitandi64v0-left-id operation))
            ", "
            (value-name function slots (core/bitandi64v0-right-id operation))
            ");\n")

          (instance? native.core.BitOrI64V0 operation)
          (str "  " target " = native_bit_or_i64("
            (value-name function slots (core/bitori64v0-left-id operation))
            ", "
            (value-name function slots (core/bitori64v0-right-id operation))
            ");\n")

          (instance? native.core.BitXorI64V0 operation)
          (str "  " target " = native_bit_xor_i64("
            (value-name function slots (core/bitxori64v0-left-id operation))
            ", "
            (value-name function slots (core/bitxori64v0-right-id operation))
            ");\n")

          (instance? native.core.BitShiftLeftI64V0 operation)
          (str "  " target " = native_bit_shift_left_i64("
            (value-name function slots
              (core/bitshiftlefti64v0-value-id operation))
            ", "
            (value-name function slots
              (core/bitshiftlefti64v0-distance-id operation))
            ");\n")

          :else
          (str "  " target " = native_unsigned_bit_shift_right_i64("
            (value-name function slots
              (core/unsignedbitshiftrighti64v0-value-id operation))
            ", "
            (value-name function slots
              (core/unsignedbitshiftrighti64v0-distance-id operation))
            ");\n")))

      (instance? native.core.VariantValueInstruction instruction)
      (let [source: core/NativeId
            (core/variantvalueinstruction-source-id instruction)]
        (str "  " target " = " (value-name function slots source)
          ".payload.variant_"
          (variant-tag layouts (slot-type function slots source)
            (core/variantvalueinstruction-variant-id instruction))
          ";\n"))

      (instance? native.core.RecordInstruction instruction)
      (let [values: (Vec core/NativeId) (core/recordinstruction-field-ids instruction)]
        (str "  " target " = ("
          (c17/c-type types module-index (core/ssavaluev0-type-id result)) "){"
          (loop [position: Int 0 fragment: String ""]
            (if (>= position (count values))
              fragment
              (recur (+ position 1)
                (str fragment (if (= position 0) " " ", ")
                  ".field_" position " = "
                  (value-name function slots (nth values position))))))
          " };\n"))

      (instance? native.core.RecordAssocInstructionV0 instruction)
      (let [record-type-id: core/NativeId (core/ssavaluev0-type-id result)
            record-type: String (c17/c-type types module-index record-type-id)
            copy: String (str target "_copy")
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/recordassocinstructionv0-arena-id instruction)))
            position: Int
            (field-position layouts record-type-id
              (core/recordassocinstructionv0-field-id instruction))]
        (str "  {\n    " record-type " *" copy " = native_arena_alloc("
          arena ", sizeof(" record-type "), _Alignof(" record-type "));\n"
          "    *" copy " = "
          (value-name function slots
            (core/recordassocinstructionv0-source-id instruction))
          ";\n"
          "    " copy "->field_" position " = "
          (value-name function slots
            (core/recordassocinstructionv0-value-id instruction))
          ";\n"
          "    " target " = *" copy ";\n  }\n"))

      (instance? native.core.BoxRecordInstruction instruction)
      (let [reference-type: core/NativeId (core/ssavaluev0-type-id result)
            pointee: (U core/NativeId Nil)
            (dereferenced-type types reference-type)]
        (if (nil? pointee)
          ""
          (let [record-type: String (c17/c-type types module-index pointee)
                arena: String
                (str "(native_arena *)"
                  (value-name function slots
                    (core/boxrecordinstruction-arena-id instruction)))]
            (str "  " target " = native_arena_alloc(" arena ", sizeof("
              record-type "), _Alignof(" record-type "));\n"
              "  *(" record-type " *)" target " = "
              (value-name function slots
                (core/boxrecordinstruction-source-id instruction))
              ";\n"))))

      (instance? native.core.RecordMaterializeInstructionV0 instruction)
      (let [record-type: String
            (c17/c-type types module-index
              (core/ssavaluev0-type-id result))
            source: String
            (value-name function slots
              (core/recordmaterializeinstructionv0-source-id instruction))]
        (str "  if (" source " == NULL) {\n"
          "    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
          "  }\n"
          "  " target " = *((const " record-type " *)" source ");\n"))

      (instance? native.core.VecLengthInstruction instruction)
      (str "  " target " = native_vec_length("
        (value-name function slots
          (core/veclengthinstruction-source-id instruction))
        ");\n")

      ;; native_vec_at traps outside [0, length), so the read is total here.
      (instance? native.core.VecGetInstruction instruction)
      (let [source: core/NativeId (core/vecgetinstruction-source-id instruction)
            stride: Int (vector-stride layouts (slot-type function slots source))]
        (str "  " target " = *(const "
          (c17/c-type types module-index (core/ssavaluev0-type-id result))
          " *)native_vec_at(" (value-name function slots source) ", "
          (value-name function slots
            (core/vecgetinstruction-index-id instruction))
          ", INT64_C(" stride "));\n"))

      (instance? native.core.VecAssocInstructionV0 instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecassocinstructionv0-arena-id instruction)))]
        (str "  " target " = native_vec_assoc(" arena ", "
          (value-name function slots
            (core/vecassocinstructionv0-source-id instruction))
          ", "
          (value-name function slots
            (core/vecassocinstructionv0-index-id instruction))
          ", &"
          (value-name function slots
            (core/vecassocinstructionv0-value-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.VecPushInstruction instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecpushinstruction-arena-id instruction)))]
        (str "  " target " = native_vec_push(" arena ", "
          (value-name function slots
            (core/vecpushinstruction-source-id instruction))
          ", &"
          (value-name function slots
            (core/vecpushinstruction-value-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.VecEmptyInstruction instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecemptyinstruction-arena-id instruction)))]
        (str "  " target " = native_vec_new(" arena ", "
          (value-name function slots
            (core/vecemptyinstruction-capacity-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.VecConcatInstruction instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecconcatinstruction-arena-id instruction)))]
        (str "  " target " = native_vec_concat(" arena ", "
          (value-name function slots
            (core/vecconcatinstruction-left-id instruction))
          ", "
          (value-name function slots
            (core/vecconcatinstruction-right-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.VecSliceInstructionV0 instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecsliceinstructionv0-arena-id instruction)))]
        (str "  " target " = native_vec_slice(" arena ", "
          (value-name function slots
            (core/vecsliceinstructionv0-source-id instruction))
          ", "
          (value-name function slots
            (core/vecsliceinstructionv0-start-id instruction))
          ", "
          (value-name function slots
            (core/vecsliceinstructionv0-end-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.ByteSourceLengthInstructionV0 instruction)
      (str "  " target " = native_byte_source_length((const native_byte_source *)"
        (value-name function slots
          (core/bytesourcelengthinstructionv0-source-id instruction))
        ");\n")

      ;; native_byte_source_at zero-extends and traps outside [0, length).
      (instance? native.core.ByteSourceGetInstructionV0 instruction)
      (str "  " target " = native_byte_source_at((const native_byte_source *)"
        (value-name function slots
          (core/bytesourcegetinstructionv0-source-id instruction))
        ", "
        (value-name function slots
          (core/bytesourcegetinstructionv0-index-id instruction))
        ");\n")

      (instance? native.core.ByteSourceSliceInstructionV0 instruction)
      (str "  " target " = native_byte_source_slice((native_arena *)"
        (value-name function slots
          (core/bytesourcesliceinstructionv0-arena-id instruction))
        ", (const native_byte_source *)"
        (value-name function slots
          (core/bytesourcesliceinstructionv0-source-id instruction))
        ", "
        (value-name function slots
          (core/bytesourcesliceinstructionv0-start-id instruction))
        ", "
        (value-name function slots
          (core/bytesourcesliceinstructionv0-end-id instruction))
        ");\n")

      (instance? native.core.VecReverseInstructionV0 instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecreverseinstructionv0-arena-id instruction)))]
        (str "  " target " = native_vec_reverse(" arena ", "
          (value-name function slots
            (core/vecreverseinstructionv0-source-id instruction))
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.VecSortInstructionV0 instruction)
      (let [vector-type: core/NativeId (core/ssavaluev0-type-id result)
            element-type: core/NativeId
            (core/vecsortinstructionv0-element-type instruction)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/vecsortinstructionv0-arena-id instruction)))]
        (str "  " target " = native_vec_sort(" arena ", "
          (value-name function slots
            (core/vecsortinstructionv0-source-id instruction))
          ", &" (descriptor-symbol types module-index element-type)
          ", INT64_C(" (vector-stride layouts vector-type) "), (size_t)"
          (vector-element-alignment layouts vector-type) ");\n"))

      (instance? native.core.MapLiteralInstructionV0 instruction)
      (let [map-type: core/NativeId (core/ssavaluev0-type-id result)
            keys: (Vec core/NativeId)
            (core/mapliteralinstructionv0-key-ids instruction)
            values: (Vec core/NativeId)
            (core/mapliteralinstructionv0-value-ids instruction)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/mapliteralinstructionv0-arena-id instruction)))
            equality: String
            (concrete-equality-name
              types module-index
              (core/mapliteralinstructionv0-key-equality instruction))]
        (if (= 0 (count keys))
          (str "  " target " = native_map_from_arrays(" arena
            ", NULL, NULL, INT64_C(0), INT64_C("
            (map-key-stride layouts map-type) "), (size_t)"
            (map-key-alignment layouts map-type) ", INT64_C("
            (map-value-stride layouts map-type) "), (size_t)"
            (map-value-alignment layouts map-type) ", " equality ");\n")
          (let [key-array: String
                (collection-symbol "map_keys" slots (core/ssavaluev0-id result))
                value-array: String
                (collection-symbol "map_values" slots (core/ssavaluev0-id result))]
            (str "  {\n    const "
              (c17/c-type types module-index (map-key-type layouts map-type))
              " " key-array "[" (count keys) "] = {"
              (emit-value-list function slots keys) " };\n    const "
              (c17/c-type types module-index (map-value-type layouts map-type))
              " " value-array "[" (count values) "] = {"
              (emit-value-list function slots values) " };\n    "
              target " = native_map_from_arrays(" arena ", " key-array ", "
              value-array ", INT64_C(" (count keys) "), INT64_C("
              (map-key-stride layouts map-type) "), (size_t)"
              (map-key-alignment layouts map-type) ", INT64_C("
              (map-value-stride layouts map-type) "), (size_t)"
              (map-value-alignment layouts map-type) ", " equality ");\n  }\n"))))

      (instance? native.core.SetLiteralInstructionV0 instruction)
      (let [set-type: core/NativeId (core/ssavaluev0-type-id result)
            values: (Vec core/NativeId)
            (core/setliteralinstructionv0-value-ids instruction)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/setliteralinstructionv0-arena-id instruction)))
            equality: String
            (concrete-equality-name
              types module-index
              (core/setliteralinstructionv0-element-equality instruction))]
        (if (= 0 (count values))
          (str "  " target " = native_set_from_array(" arena
            ", NULL, INT64_C(0), INT64_C(" (set-stride layouts set-type)
            "), (size_t)" (set-alignment layouts set-type) ", " equality ");\n")
          (let [array: String
                (collection-symbol "set_values" slots (core/ssavaluev0-id result))]
            (str "  {\n    const "
              (c17/c-type types module-index (set-element-type layouts set-type))
              " " array "[" (count values) "] = {"
              (emit-value-list function slots values) " };\n    "
              target " = native_set_from_array(" arena ", " array
              ", INT64_C(" (count values) "), INT64_C("
              (set-stride layouts set-type) "), (size_t)"
              (set-alignment layouts set-type) ", " equality ");\n  }\n"))))

      (instance? native.core.MapCountInstructionV0 instruction)
      (str "  " target " = native_map_count("
        (value-name function slots
          (core/mapcountinstructionv0-source-id instruction))
        ");\n")

      (instance? native.core.MapGetInstructionV0 instruction)
      (emit-map-get types layouts module-index function slots instruction)

      (instance? native.core.MapContainsInstructionV0 instruction)
      (str "  " target " = native_map_contains("
        (value-name function slots
          (core/mapcontainsinstructionv0-source-id instruction))
        ", &"
        (value-name function slots
          (core/mapcontainsinstructionv0-key-id instruction))
        ", "
        (concrete-equality-name
          types module-index
          (core/mapcontainsinstructionv0-key-equality instruction))
        ");\n")

      (instance? native.core.MapAssocInstructionV0 instruction)
      (let [map-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/mapassocinstructionv0-arena-id instruction)))]
        (str "  " target " = native_map_assoc(" arena ", "
          (value-name function slots
            (core/mapassocinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/mapassocinstructionv0-key-id instruction))
          ", &"
          (value-name function slots
            (core/mapassocinstructionv0-value-id instruction))
          ", INT64_C(" (map-key-stride layouts map-type) "), (size_t)"
          (map-key-alignment layouts map-type) ", INT64_C("
          (map-value-stride layouts map-type) "), (size_t)"
          (map-value-alignment layouts map-type) ", "
          (concrete-equality-name
            types module-index
            (core/mapassocinstructionv0-key-equality instruction))
          ");\n"))

      (instance? native.core.MapDissocInstructionV0 instruction)
      (let [map-type: core/NativeId (core/ssavaluev0-type-id result)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/mapdissocinstructionv0-arena-id instruction)))]
        (str "  " target " = native_map_dissoc(" arena ", "
          (value-name function slots
            (core/mapdissocinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/mapdissocinstructionv0-key-id instruction))
          ", INT64_C(" (map-key-stride layouts map-type) "), (size_t)"
          (map-key-alignment layouts map-type) ", INT64_C("
          (map-value-stride layouts map-type) "), (size_t)"
          (map-value-alignment layouts map-type) ", "
          (concrete-equality-name
            types module-index
            (core/mapdissocinstructionv0-key-equality instruction))
          ");\n"))

      (instance? native.core.MapKeysInstructionV0 instruction)
      (let [source: core/NativeId (core/mapkeysinstructionv0-source-id instruction)
            map-type: core/NativeId (slot-type function slots source)]
        (str "  " target " = native_map_keys((native_arena *)"
          (value-name function slots
            (core/mapkeysinstructionv0-arena-id instruction))
          ", " (value-name function slots source) ", (size_t)"
          (map-key-alignment layouts map-type) ");\n"))

      (instance? native.core.MapValuesInstructionV0 instruction)
      (let [source: core/NativeId
            (core/mapvaluesinstructionv0-source-id instruction)
            map-type: core/NativeId (slot-type function slots source)]
        (str "  " target " = native_map_values((native_arena *)"
          (value-name function slots
            (core/mapvaluesinstructionv0-arena-id instruction))
          ", " (value-name function slots source) ", (size_t)"
          (map-value-alignment layouts map-type) ");\n"))

      (instance? native.core.SetCountInstructionV0 instruction)
      (str "  " target " = native_set_count("
        (value-name function slots
          (core/setcountinstructionv0-source-id instruction))
        ");\n")

      (instance? native.core.SetContainsInstructionV0 instruction)
      (str "  " target " = native_set_contains("
        (value-name function slots
          (core/setcontainsinstructionv0-source-id instruction))
        ", &"
        (value-name function slots
          (core/setcontainsinstructionv0-value-id instruction))
        ", "
        (concrete-equality-name
          types module-index
          (core/setcontainsinstructionv0-element-equality instruction))
        ");\n")

      (instance? native.core.SetConjInstructionV0 instruction)
      (let [set-type: core/NativeId (core/ssavaluev0-type-id result)]
        (str "  " target " = native_set_conj((native_arena *)"
          (value-name function slots
            (core/setconjinstructionv0-arena-id instruction))
          ", "
          (value-name function slots
            (core/setconjinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/setconjinstructionv0-value-id instruction))
          ", INT64_C(" (set-stride layouts set-type) "), (size_t)"
          (set-alignment layouts set-type) ", "
          (concrete-equality-name
            types module-index
            (core/setconjinstructionv0-element-equality instruction))
          ");\n"))

      (instance? native.core.SetDisjInstructionV0 instruction)
      (let [set-type: core/NativeId (core/ssavaluev0-type-id result)]
        (str "  " target " = native_set_disj((native_arena *)"
          (value-name function slots
            (core/setdisjinstructionv0-arena-id instruction))
          ", "
          (value-name function slots
            (core/setdisjinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/setdisjinstructionv0-value-id instruction))
          ", INT64_C(" (set-stride layouts set-type) "), (size_t)"
          (set-alignment layouts set-type) ", "
          (concrete-equality-name
            types module-index
            (core/setdisjinstructionv0-element-equality instruction))
          ");\n"))

      (instance? native.core.SetVectorInstructionV0 instruction)
      (let [source: core/NativeId
            (core/setvectorinstructionv0-source-id instruction)
            set-type: core/NativeId (slot-type function slots source)]
        (str "  " target " = native_set_vector((native_arena *)"
          (value-name function slots
            (core/setvectorinstructionv0-arena-id instruction))
          ", " (value-name function slots source) ", (size_t)"
          (set-alignment layouts set-type) ");\n"))

      (instance? native.core.CollectionTransientOpenInstructionV0 instruction)
      (let [collection-type: core/NativeId (core/ssavaluev0-type-id result)
            shape: core/LayoutShapeV0
            (collection-layout-of layouts collection-type)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/collectiontransientopeninstructionv0-arena-id instruction)))
            source: String
            (value-name function slots
              (core/collectiontransientopeninstructionv0-source-id instruction))]
        (cond
          (instance? native.core.MapShapeV0 shape)
          (str "  " target " = native_map_transient_open(" arena ", " source
            ", (size_t)" (map-key-alignment layouts collection-type)
            ", (size_t)" (map-value-alignment layouts collection-type) ");\n")
          (instance? native.core.SetShapeV0 shape)
          (str "  " target " = native_set_transient_open(" arena ", " source
            ", (size_t)" (set-alignment layouts collection-type) ");\n")
          :else "  native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"))

      (instance? native.core.CollectionPersistentCloseInstructionV0 instruction)
      (let [collection-type: core/NativeId (core/ssavaluev0-type-id result)
            shape: core/LayoutShapeV0
            (collection-layout-of layouts collection-type)
            arena: String
            (str "(native_arena *)"
              (value-name function slots
                (core/collectionpersistentcloseinstructionv0-arena-id instruction)))
            source: String
            (value-name function slots
              (core/collectionpersistentcloseinstructionv0-source-id instruction))]
        (cond
          (instance? native.core.MapShapeV0 shape)
          (str "  " target " = native_map_persistent_close(" arena ", " source
            ");\n")
          (instance? native.core.SetShapeV0 shape)
          (str "  " target " = native_set_persistent_close(" arena ", " source
            ");\n")
          :else "  native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"))

      (instance? native.core.TransientMapAssocInstructionV0 instruction)
      (let [map-type: core/NativeId (core/ssavaluev0-type-id result)]
        (str "  " target " = native_map_assoc_transient((native_arena *)"
          (value-name function slots
            (core/transientmapassocinstructionv0-arena-id instruction))
          ", "
          (value-name function slots
            (core/transientmapassocinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/transientmapassocinstructionv0-key-id instruction))
          ", &"
          (value-name function slots
            (core/transientmapassocinstructionv0-value-id instruction))
          ", INT64_C(" (map-key-stride layouts map-type) "), (size_t)"
          (map-key-alignment layouts map-type) ", INT64_C("
          (map-value-stride layouts map-type) "), (size_t)"
          (map-value-alignment layouts map-type) ", "
          (concrete-equality-name
            types module-index
            (core/transientmapassocinstructionv0-key-equality instruction))
          ");\n"))

      (instance? native.core.TransientSetConjInstructionV0 instruction)
      (let [set-type: core/NativeId (core/ssavaluev0-type-id result)]
        (str "  " target " = native_set_conj_transient((native_arena *)"
          (value-name function slots
            (core/transientsetconjinstructionv0-arena-id instruction))
          ", "
          (value-name function slots
            (core/transientsetconjinstructionv0-source-id instruction))
          ", &"
          (value-name function slots
            (core/transientsetconjinstructionv0-value-id instruction))
          ", INT64_C(" (set-stride layouts set-type) "), (size_t)"
          (set-alignment layouts set-type) ", "
          (concrete-equality-name
            types module-index
            (core/transientsetconjinstructionv0-element-equality instruction))
          ");\n"))

      (instance? native.core.CallInstruction instruction)
      (str "  " target " = "
        (function-name module-index
          (function-index-of functions
            (core/callinstruction-function-id instruction)))
        "("
        (emit-call-arguments functions function slots
          (core/callinstruction-function-id instruction)
          (core/callinstruction-arguments instruction)) ");\n")

      (instance? native.core.ExternCallInstruction instruction)
      (emit-extern-call types layouts abis function slots target instruction)

      :else "")]
    (str emitted
      (if (or (instance? native.core.AtomInstruction instruction)
              (instance? native.core.ArenaInstruction instruction)
              (and (instance? native.core.UnionExtractInstruction instruction)
                (unit-type? types (core/ssavaluev0-type-id result)))
              (value-referenced? function (core/ssavaluev0-id result)))
        ""
        (str "  (void)" target ";\n")))))

(defn variant-tag
  [layouts: (Vec core/LayoutDef)
   owner: core/NativeId
   variant: core/NativeId] -> Int
  (let [layout: (U core/LayoutDef Nil) (c17/layout-for-type layouts owner)]
    (if (nil? layout)
      -1
      (let [variants: (Vec core/UnionVariantLayoutV0)
            (c17/union-layout-variants layout)]
        (loop [position: Int 0]
          (if (>= position (count variants))
            -1
            (if (core/native-id=
                  (core/unionvariantlayoutv0-variant-id (nth variants position))
                  variant)
              (core/unionvariantlayoutv0-tag (nth variants position))
              (recur (+ position 1)))))))))

(defn emit-jump
  [function: core/FunctionDef
   function-index: Int
   slots: (Vec ValueSlotV0)
   target-id: core/NativeId
   arguments: (Vec core/NativeId)] -> String
  (let [blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)
        position: Int (block-index blocks target-id)
        target-block: core/BasicBlock (nth blocks position)
        parameters: (Vec core/Parameter) (core/basicblock-parameters target-block)]
    (str
      (loop [inner: Int 0 result: String ""]
        (if (>= inner (count arguments))
          result
          (let [parameter-id: core/NativeId
                (core/parameter-id (nth parameters inner))
                argument-id: core/NativeId (nth arguments inner)]
            (recur (+ inner 1)
              (if (core/native-id= parameter-id argument-id)
                result
                (str result "  " (value-name function slots parameter-id)
                  " = " (value-name function slots argument-id) ";\n"))))))
      "  goto " (label-name function-index position) ";\n")))

(defn emit-terminator
  [layouts: (Vec core/LayoutDef)
   function: core/FunctionDef
   function-index: Int
   slots: (Vec ValueSlotV0)
   terminator: core/Terminator] -> String
  (let [blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (cond
      (instance? native.core.ReturnTerminator terminator)
      (let [value: (U core/NativeId Nil) (core/returnterminator-value terminator)]
        (if (nil? value)
          "  return;\n"
          (str "  return " (value-name function slots value) ";\n")))

      (instance? native.core.JumpTerminator terminator)
      (emit-jump function function-index slots
        (core/jumpterminator-block-id terminator)
        (core/jumpterminator-arguments terminator))

      (instance? native.core.BranchTerminator terminator)
      (str "  if (" (value-name function slots
                      (core/branchterminator-condition terminator)) ") {\n  "
        (emit-jump function function-index slots
          (core/branchterminator-true-block terminator) [])
        "  } else {\n  "
        (emit-jump function function-index slots
          (core/branchterminator-false-block terminator) [])
        "  }\n")

      (instance? native.core.SwitchTerminator terminator)
      (let [value: core/NativeId (core/switchterminator-value-id terminator)
            owner: core/NativeId (slot-type function slots value)
            cases: (Vec core/SwitchCaseV0)
            (core/switchterminator-cases terminator)]
        (str "  switch (" (value-name function slots value) ".tag) {\n"
          (loop [position: Int 0 result: String ""]
            (if (>= position (count cases))
              result
              (let [switch-case: core/SwitchCaseV0 (nth cases position)]
                (recur (+ position 1)
                  (str result "  case INT64_C("
                    (variant-tag layouts owner
                      (core/switchcasev0-variant-id switch-case))
                    "):\n  "
                    (emit-jump function function-index slots
                      (core/switchcasev0-block-id switch-case)
                      (core/switchcasev0-arguments switch-case)))))))
          "  default:\n    native_trap(NATIVE_TRAP_INVALID_ARGUMENT);\n"
          "  }\n"))

      :else
      (str "  native_trap((uint32_t)"
        (value-name function slots (core/trapterminator-failure-id terminator))
        ");\n"))))

(defn terminator-targets [terminator: core/Terminator] -> (Vec core/NativeId)
  (cond
    (instance? native.core.JumpTerminator terminator)
    [(core/jumpterminator-block-id terminator)]
    (instance? native.core.BranchTerminator terminator)
    [(core/branchterminator-true-block terminator)
     (core/branchterminator-false-block terminator)]
    (instance? native.core.SwitchTerminator terminator)
    (mapv (fn [switch-case: core/SwitchCaseV0] -> core/NativeId
            (core/switchcasev0-block-id switch-case))
      (core/switchterminator-cases terminator))
    :else []))

(defn block-targeted? [function: core/FunctionDef target: core/NativeId] -> Bool
  (let [blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (loop [position: Int 0]
      (if (>= position (count blocks))
        false
        (let [terminators: (Vec core/Terminator)
              (core/basicblock-terminators (nth blocks position))
              hit: Bool
              (loop [inner: Int 0]
                (if (>= inner (count terminators))
                  false
                  (if (core/id-in?
                        (terminator-targets (nth terminators inner))
                        target)
                    true
                    (recur (+ inner 1)))))]
          (if hit true (recur (+ position 1))))))))

(defn emit-block
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   module-index: Int
   pool: ConstantPoolV0
   function: core/FunctionDef
   function-index: Int
   slots: (Vec ValueSlotV0)
   position: Int] -> String
  (let [block: core/BasicBlock (nth (core/functiondef-blocks function) position)
        targeted: Bool (block-targeted? function (core/basicblock-id block))
        label: String
        (if targeted
          (str (label-name function-index position) ": ;\n")
          "")
        instructions: (Vec core/Instruction) (core/basicblock-instructions block)]
    (str label
      (if targeted (emit-unused-block-parameters function slots block) "")
      (loop [inner: Int 0 result: String ""]
        (if (>= inner (count instructions))
          result
          (recur (+ inner 1)
            (str result
              (emit-instruction types layouts functions abis module-index pool
                function slots (nth instructions inner))))))
      (emit-terminator layouts function function-index slots
        (nth (core/basicblock-terminators block) 0)))))

(defn emit-function
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   module-index: Int
   pool: ConstantPoolV0
   function-index: Int
   function: core/FunctionDef] -> String
  (let [slots: (Vec ValueSlotV0) (function-value-slots function)
        blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (str (c17/function-return-type types module-index function) " "
      (function-name module-index function-index)
      "(" (c17/emit-parameter-list types module-index function) ") {\n"
      (if (> (count (core/functiondef-regions function)) 0)
        "  (void)arena;\n" "")
      (if (> (count (core/functiondef-capabilities function)) 0)
        "  (void)capability;\n" "")
      (loop [position: Int 0 fragment: String ""
             parameters: (Vec core/Parameter)
             (core/functiondef-parameters function)]
        (if (>= position (count parameters))
          fragment
          (recur (+ position 1)
            (str fragment "  (void)native_v_" position ";\n")
            parameters)))
      (emit-declarations types module-index slots)
      (loop [position: Int 0 result: String ""]
        (if (>= position (count blocks))
          result
          (recur (+ position 1)
            (str result
              (emit-block types layouts functions abis module-index pool function
                function-index slots position)))))
      "}\n")))

(defn emit-functions
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   module-index: Int
   pool: ConstantPoolV0] -> String
  (loop [position: Int 0 result: String ""]
    (if (>= position (count functions))
      result
      (recur (+ position 1)
        (str result
          (emit-function types layouts functions abis module-index pool position
            (nth functions position)))))))

(defn emit-source
  [types: (Vec core/TypeDef)
   layouts: (Vec core/LayoutDef)
   functions: (Vec core/FunctionDef)
   abis: (Vec core/AbiDeclV0)
   module-index: Int
   pool: ConstantPoolV0
   header-name: String] -> String
  (str "/* Generated by native.body-c17; do not edit. */\n"
    "#include \"" header-name "\"\n\n"
    (emit-text-pool module-index pool)
    (emit-value-descriptors types layouts functions module-index)
    (emit-functions types layouts functions abis module-index pool)))

(defn materialize-program
  [program: core/NativeCoreProgram
   module-index: Int] -> BodyMaterializationV0
  (let [validation: core/ValidationReport (core/validate-program program)]
    (cond
      (< module-index 0)
      (->BodyFailureV0 "module index must be nonnegative")

      (not (core/validationreport-passed validation))
      (->BodyFailureV0 "native program is not frozen: validation obligations failed")

      (not (program-supported? program))
      (->BodyFailureV0
        "native program uses a shape outside the restricted C17 body slice")

      (not (pool-emittable? (collect-pool (core/nativecoreprogram-functions program))))
      (->BodyFailureV0
        "a Text or Keyword literal falls outside the printable-ASCII subset this materializer can spell")

      :else
      (let [layouts: (Vec core/LayoutDef) (core/nativecoreprogram-layouts program)
            types: (Vec core/TypeDef)
            (c17/dependency-ordered-types (core/nativecoreprogram-types program) layouts)
            functions: (Vec core/FunctionDef)
            (c17/ordered-functions (core/nativecoreprogram-functions program))
            abis: (Vec core/AbiDeclV0) (core/nativecoreprogram-abis program)
            pool: ConstantPoolV0 (collect-pool functions)
            header-name: String (str "module_" module-index ".h")]
        (->BodySuccessV0
          (->BodyArtifactV0
            header-name
            (c17/emit-header types layouts functions module-index)
            (str "module_" module-index ".c")
            (emit-source types layouts functions abis module-index pool
              header-name)))))))
