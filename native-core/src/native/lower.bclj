#lang beagle/clj
(ns native.lower
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.obligations :as obligations]))


(defrecord SourceFactV0
  [(identity core/NativeId)
   (subject core/NativeId)
   (predicate core/NativeId)
   (object core/NativeId)])

(defunion LowerFailureV0
  (MissingGraphRootV0 [(root core/NativeId)])
  (DuplicateTermIdentityV0 [(identity core/NativeId)])
  (UnclosedTermReferenceV0 [(owner core/NativeId) (target core/NativeId)])
  (MalformedSourceTermV0 [(identity core/NativeId) (detail String)])
  (MissingSourceFactV0 [(subject core/NativeId) (predicate String)])
  (UnresolvedSourceTypeV0 [(source-type core/NativeId) (detail String)])
  (UnsupportedSourceTypeV0 [(source-type core/NativeId) (spelling String)])
  (MissingFunctionAnnotationV0 [(function-id core/NativeId) (binding String)])
  (InvalidSourceModuleV0 [(module-id core/NativeId) (detail String)]))

(defunion SourceFreezeResultV0
  (SourceFreezeAcceptedV0
    [(frozen stages/FrozenSourceStageV1) (receipt core/PassReceiptV0)])
  (SourceFreezeRejectedV0
    [(failure LowerFailureV0) (receipt core/PassReceiptV0)]))

(defn lower-id [(domain String) (parts (Vec String))] core/NativeId
  (core/canonical-id (str "native-lower-v0/" domain) parts))

(defn id-value [(id core/NativeId)] String
  (core/nativeid-value id))

(defn same-id? [(left core/NativeId) (right core/NativeId)] Bool
  (core/native-id= left right))

(defn find-node
  [(graph stages/TermGraphV0) (target core/NativeId)] (U stages/TermNodeV0 Nil)
  (let [(nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)]
    (loop [(index Int) 0]
      (if (>= index (count nodes))
        nil
        (let [(node stages/TermNodeV0) (nth nodes index)]
          (if (same-id? target (stages/termnodev0-identity node))
            node
            (recur (+ index 1))))))))

(defn term-at
  [(graph stages/TermGraphV0) (target core/NativeId)] (U stages/TermV0 Nil)
  (let [(node (U stages/TermNodeV0 Nil)) (find-node graph target)]
    (if (nil? node) nil (stages/termnodev0-term node))))

(defn text-at [(graph stages/TermGraphV0) (target core/NativeId)] (U String Nil)
  (let [(term (U stages/TermV0 Nil)) (term-at graph target)]
    (if (nil? term)
      nil
      (if (instance? native.stages.TextTermV0 term) (stages/texttermv0-value term) nil))))

(defn term-references [(term stages/TermV0)] (Vec core/NativeId)
  (cond
    (instance? native.stages.RefTermV0 term)
    [(stages/reftermv0-target term)]

    (instance? native.stages.TripleTermV0 term)
    [(stages/tripletermv0-subject term)
     (stages/tripletermv0-predicate term)
     (stages/tripletermv0-object term)]

    :else []))

(defn graph-identities [(graph stages/TermGraphV0)] (Vec core/NativeId)
  (mapv
    (fn [(node stages/TermNodeV0)] core/NativeId
      (stages/termnodev0-identity node))
    (stages/termgraphv0-nodes graph)))

(defn graph-identity-index [(graph stages/TermGraphV0)] (Map String Bool)
  (let [(nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)]
    (loop [(index Int) 0 (identities (Map String Bool)) {}]
      (if (>= index (count nodes))
        identities
        (recur (+ index 1)
          (assoc identities
            (id-value (stages/termnodev0-identity (nth nodes index))) true))))))

(defn refs-resolve-in?
  [(identities (Map String Bool)) (refs (Vec core/NativeId))] Bool
  (loop [(index Int) 0]
    (if (>= index (count refs))
      true
      (if (not (= true (get identities (id-value (nth refs index)))))
        false
        (recur (+ index 1))))))

(defn graph-reference-closed-in?
  [(graph stages/TermGraphV0) (identities (Map String Bool))] Bool
  (let [(nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)]
    (loop [(index Int) 0]
      (if (>= index (count nodes))
        true
        (let [(node stages/TermNodeV0) (nth nodes index)]
          (if (refs-resolve-in? identities
                (term-references (stages/termnodev0-term node)))
            (recur (+ index 1))
            false))))))

(defn graph-reference-closed? [(graph stages/TermGraphV0)] Bool
  (graph-reference-closed-in? graph (graph-identity-index graph)))

(defn source-facts [(graph stages/TermGraphV0)] (Vec SourceFactV0)
  (let [(nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)]
    (loop [(index Int) 0 (facts (Vec SourceFactV0)) []]
      (if (>= index (count nodes))
        facts
        (let [(node stages/TermNodeV0) (nth nodes index)
              (term stages/TermV0) (stages/termnodev0-term node)]
          (if (instance? native.stages.TripleTermV0 term)
            (recur (+ index 1)
              (conj facts
                (->SourceFactV0
                  (stages/termnodev0-identity node)
                  (stages/tripletermv0-subject term)
                  (stages/tripletermv0-predicate term)
                  (stages/tripletermv0-object term))))
            (recur (+ index 1) facts)))))))

;; Lookup maps preserve first-fact semantics while resolving graph text once.
(defrecord SourceIndexV0
  [(fact-count Int)
   (first-objects (Map String core/NativeId))
   (first-texts (Map String String))
   (form-ids (Map String (Vec core/NativeId)))
   (callee-names (Map String Bool))
   (child-nodes (Map String (Vec core/NativeId)))
   (parent-nodes (Map String core/NativeId))
   (definition-roots (Map String core/NativeId))
   (module-roots (Map String core/NativeId))
   (record-keys (Vec String))])

(defn graph-text-index [(graph stages/TermGraphV0)] (Map String String)
  (let [(nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)]
    (loop [(position Int) 0 (texts (Map String String)) {}]
      (if (>= position (count nodes))
        texts
        (let [(node stages/TermNodeV0) (nth nodes position)
              (term stages/TermV0) (stages/termnodev0-term node)]
          (recur (+ position 1)
            (if (instance? native.stages.TextTermV0 term)
              (assoc texts
                (id-value (stages/termnodev0-identity node))
                (stages/texttermv0-value term))
              texts)))))))

(defn graph-text-or-empty
  [(texts (Map String String)) (target core/NativeId)] String
  (let [(value (U String Nil)) (get texts (id-value target))]
    (if (nil? value) "" value)))

(defn source-index-key [(subject core/NativeId) (predicate String)] String
  (let [(identity String) (id-value subject)]
    (str (count identity) ":" identity predicate)))

(defn index-facts [(index SourceIndexV0)] Int
  (sourceindexv0-fact-count index))

(defn index-has-callee? [(index SourceIndexV0) (expected String)] Bool
  (= true (get (sourceindexv0-callee-names index) expected)))

(defn index-first-object
  [(index SourceIndexV0)
   (subject core/NativeId)
   (predicate String)]
  (U core/NativeId Nil)
  (get (sourceindexv0-first-objects index)
    (source-index-key subject predicate)))

(defn index-first-text
  [(index SourceIndexV0)
   (subject core/NativeId)
   (predicate String)]
  (U String Nil)
  (let [(value (U String Nil))
        (get (sourceindexv0-first-texts index)
          (source-index-key subject predicate))]
    (if (or (nil? value) (= 0 (count value))) nil value)))

(defn index-form-ids [(index SourceIndexV0) (kind String)] (Vec core/NativeId)
  (let [(forms (U (Vec core/NativeId) Nil))
        (get (sourceindexv0-form-ids index) kind)]
    (if (nil? forms) [] forms)))

;; A sequence node carries its items under an ordinal predicate, so item order
;; is the ordinal, never fact order. The two live projections spell that
;; ordinal differently: the AST projection uses f0.., the corpus uses a0...
(defn index-sequence-under
  [(index SourceIndexV0)
   (sequence-id core/NativeId)
   (prefix String)]
  (Vec core/NativeId)
  (loop [(position Int) 0 (items (Vec core/NativeId)) []]
    (let [(item (U core/NativeId Nil))
          (index-first-object index sequence-id (str prefix position))]
      (if (nil? item)
        items
        (recur (+ position 1) (conj items item))))))

(defn index-sequence-items
  [(index SourceIndexV0) (sequence-id core/NativeId)] (Vec core/NativeId)
  (let [(indexed (Vec core/NativeId)) (index-sequence-under index sequence-id "f")]
    (if (> (count indexed) 0)
      indexed
      (index-sequence-under index sequence-id "a"))))

(defn module-sequence
  [(index SourceIndexV0)
   (module-root core/NativeId)
   (predicate String)]
  (Vec core/NativeId)
  (let [(sequence (U core/NativeId Nil))
        (index-first-object index module-root predicate)]
    (if (nil? sequence) [] (index-sequence-items index sequence))))

(defn source-parent
  [(index SourceIndexV0) (node core/NativeId)] (U core/NativeId Nil)
  (get (sourceindexv0-parent-nodes index) (id-value node)))

(defn source-module-root-with-fuel
  [(index SourceIndexV0) (node core/NativeId) (fuel Int)] (U core/NativeId Nil)
  (let [(root (U core/NativeId Nil))
        (get (sourceindexv0-definition-roots index) (id-value node))]
    (if (some? root)
      root
      (if (<= fuel 0)
        nil
        (let [(parent (U core/NativeId Nil)) (source-parent index node)]
          (if (nil? parent)
            nil
            (source-module-root-with-fuel index parent (- fuel 1))))))))

(defn source-module-root
  [(index SourceIndexV0) (node core/NativeId)] (U core/NativeId Nil)
  (let [(root (U core/NativeId Nil))
        (source-module-root-with-fuel index node (+ 1 (index-facts index)))
        (roots (Vec core/NativeId)) (index-form-ids index "module-root")]
    (if (nil? root)
      (if (= 1 (count roots)) (nth roots 0) nil)
      root)))

(defn source-module-name
  [(index SourceIndexV0) (definition core/NativeId)] String
  (let [(root (U core/NativeId Nil)) (source-module-root index definition)]
    (if (nil? root)
      ""
      (let [(name (U String Nil)) (index-first-text index root "namespace")]
        (if (nil? name) "" name)))))

(defn fact-text
  [(index SourceIndexV0) (subject core/NativeId) (predicate String)] String
  (let [(value (U String Nil)) (index-first-text index subject predicate)]
    (if (nil? value) "" value)))

(defn module-root-named
  [(index SourceIndexV0) (module-name String)] (U core/NativeId Nil)
  (get (sourceindexv0-module-roots index) module-name))

(defn imported-module-name
  [(index SourceIndexV0) (module-name String) (alias String)] (U String Nil)
  (let [(root (U core/NativeId Nil)) (module-root-named index module-name)
        (imports (Vec core/NativeId))
        (if (nil? root) [] (module-sequence index root "imports"))]
    (loop [(position Int) 0]
      (if (>= position (count imports))
        nil
        (let [(import-node core/NativeId) (nth imports position)
              (candidate (U String Nil)) (index-first-text index import-node "alias")
              (target (U String Nil)) (index-first-text index import-node "namespace")]
          (if (and (some? target)
                (or (and (some? candidate) (= alias candidate))
                    (= alias target)))
            target
            (recur (+ position 1))))))))

(defn add-module-indexes [(index SourceIndexV0)] SourceIndexV0
  (let [(roots (Vec core/NativeId)) (index-form-ids index "module-root")]
    (loop [(position Int) 0
           (definition-roots (Map String core/NativeId)) {}
           (module-roots (Map String core/NativeId)) {}]
      (if (>= position (count roots))
        (with (with index [:definition-roots definition-roots])
          [:module-roots module-roots])
        (let [(root core/NativeId) (nth roots position)
              (module-name (U String Nil)) (index-first-text index root "namespace")
              (definitions (Vec core/NativeId))
              (module-sequence index root "definitions")
              (next-definitions (Map String core/NativeId))
              (loop [(inner Int) 0 (current (Map String core/NativeId)) definition-roots]
                (if (>= inner (count definitions))
                  current
                  (let [(key String) (id-value (nth definitions inner))]
                    (recur (+ inner 1)
                      (if (nil? (get current key))
                        (assoc current key root)
                        current)))))]
          (recur (+ position 1)
            next-definitions
            (if (or (nil? module-name) (some? (get module-roots module-name)))
              module-roots
              (assoc module-roots module-name root))))))))

;; The module table, not the term graph, is authoritative for a module's root
;; and name; a projection that spells neither is still a named module.
(defn seed-module-table
  [(index SourceIndexV0) (modules (Vec stages/SourceModuleV1))] SourceIndexV0
  (loop [(position Int) 0 (seeded SourceIndexV0) index]
    (if (>= position (count modules))
      seeded
      (let [(module stages/SourceModuleV1) (nth modules position)
            (root core/NativeId) (stages/sourcemodulev1-root-term module)
            (texts (Map String String))
            (if (nil? (index-first-text seeded root "namespace"))
              (assoc (sourceindexv0-first-texts seeded)
                (source-index-key root "namespace")
                (stages/sourcemodulev1-name module))
              (sourceindexv0-first-texts seeded))
            (roots (Vec core/NativeId)) (index-form-ids seeded "module-root")
            (listed (Vec core/NativeId))
            (if (core/id-in? roots root) roots (conj roots root))]
        (recur (+ position 1)
          (with (with seeded [:first-texts texts])
            [:form-ids
             (assoc (sourceindexv0-form-ids seeded) "module-root" listed)]))))))

(defn build-source-index
  [(graph stages/TermGraphV0)
   (modules (Vec stages/SourceModuleV1))]
  SourceIndexV0
  (let [(facts (Vec SourceFactV0)) (source-facts graph)
        (graph-texts (Map String String)) (graph-text-index graph)
        (partial SourceIndexV0)
        (loop [(position Int) 0
               (first-objects (Map String core/NativeId)) {}
               (first-texts (Map String String)) {}
               (form-ids (Map String (Vec core/NativeId))) {}
               (callee-names (Map String Bool)) {}
               (child-nodes (Map String (Vec core/NativeId))) {}
               (parent-nodes (Map String core/NativeId)) {}]
          (if (>= position (count facts))
            (->SourceIndexV0 (count facts) first-objects first-texts form-ids
              callee-names child-nodes parent-nodes {} {} [])
            (let [(fact SourceFactV0) (nth facts position)
                  (subject core/NativeId) (sourcefactv0-subject fact)
                  (object core/NativeId) (sourcefactv0-object fact)
                  (predicate String)
                  (graph-text-or-empty graph-texts (sourcefactv0-predicate fact))
                  (object-text String) (graph-text-or-empty graph-texts object)
                  (key String) (source-index-key subject predicate)
                  (existing-object (U core/NativeId Nil)) (get first-objects key)
                  (existing-text (U String Nil)) (get first-texts key)
                  (prior-forms (U (Vec core/NativeId) Nil)) (get form-ids object-text)
                  (forms (Vec core/NativeId))
                  (if (nil? prior-forms) [] prior-forms)
                  (subject-key String) (id-value subject)
                  (prior-children (U (Vec core/NativeId) Nil))
                  (get child-nodes subject-key)
                  (children (Vec core/NativeId))
                  (if (nil? prior-children) [] prior-children)
                  (object-key String) (id-value object)]
              (recur (+ position 1)
                (if (nil? existing-object)
                  (assoc first-objects key object)
                  first-objects)
                (if (nil? existing-text)
                  (assoc first-texts key object-text)
                  first-texts)
                (if (= "form-kind" predicate)
                  (assoc form-ids object-text (conj forms subject))
                  form-ids)
                (if (= "callee" predicate)
                  (assoc callee-names object-text true)
                  callee-names)
                (assoc child-nodes subject-key (conj children object))
                (if (nil? (get parent-nodes object-key))
                  (assoc parent-nodes object-key subject)
                  parent-nodes)))))
        (named SourceIndexV0) (seed-module-table partial modules)
        (indexed SourceIndexV0) (add-module-indexes named)
        (records (Vec core/NativeId))
        (vec (concat (index-form-ids indexed "record")
               (filterv
                 (fn [(group core/NativeId)] Bool
                   (= "true" (index-first-text indexed group "inline")))
                 (index-form-ids indexed "member-field-group"))))
        (keys (Vec String))
        (loop [(position Int) 0 (collected (Vec String)) []]
          (if (>= position (count records))
            collected
            (let [(record core/NativeId) (nth records position)
                  (name (U String Nil)) (index-first-text indexed record "name")
                  (module-name String) (source-module-name indexed record)
                  (key String)
                  (if (or (nil? name) (= "" module-name))
                    ""
                    (str module-name "/" name))]
              (recur (+ position 1)
                (if (or (= "" key)
                      (some? (some (fn [(prior String)] Bool (= prior key))
                               collected)))
                  collected
                  (conj collected key))))))]
    (with indexed [:record-keys keys])))

(defn source-module-identity-index
  [(modules (Vec stages/SourceModuleV1))] (Map String Bool)
  (reduce
    (fn [(found (Map String Bool)) (module stages/SourceModuleV1)]
      (Map String Bool)
      (assoc found (id-value (stages/sourcemodulev1-id module)) true))
    {}
    modules))

(defn source-unit-identity-index
  [(units (Vec stages/SourceUnitV0))] (Map String Bool)
  (reduce
    (fn [(found (Map String Bool)) (unit stages/SourceUnitV0)]
      (Map String Bool)
      (assoc found (id-value (stages/sourceunitv0-id unit)) true))
    {}
    units))

(defn source-unit-valid?
  [(unit stages/SourceUnitV0)
   (graph-identities (Map String Bool))
   (module-identities (Map String Bool))
   (unit-identities (Map String Bool))] Bool
  (and (core/native-id=
         (stages/sourceunitv0-id unit)
         (stages/sourceunitv0-root-term unit))
       (= true
         (get graph-identities
           (id-value (stages/sourceunitv0-root-term unit))))
       (= true
         (get module-identities
           (id-value (stages/sourceunitv0-module-id unit))))
       (not= "" (stages/sourceunitv0-kind unit))
       (not= "" (stages/sourceunitv0-name unit))
       (stages/sha256-digest? (stages/sourceunitv0-semantic-digest unit))
       (every?
         (fn [(read core/NativeId)] Bool
           (= true (get unit-identities (id-value read))))
         (stages/sourceunitv0-read-set unit))))

(defn source-stage-valid? [(stage stages/SourceStageV1)] Bool
  (let [(graph stages/TermGraphV0) (stages/sourcestagev1-terms stage)
        (nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)
        (identities (Map String Bool)) (graph-identity-index graph)
        (modules (Vec stages/SourceModuleV1))
        (stages/sourcestagev1-modules stage)
        (units (Vec stages/SourceUnitV0)) (stages/sourcestagev1-units stage)
        (module-identities (Map String Bool))
        (source-module-identity-index modules)
        (unit-identities (Map String Bool))
        (source-unit-identity-index units)]
    (and (= true (get identities (id-value (stages/termgraphv0-root graph))))
         (= (count nodes) (count identities))
         (graph-reference-closed-in? graph identities)
         (= (count modules) (count module-identities))
         (every?
           (fn [(module stages/SourceModuleV1)] Bool
             (and (= true
                    (get identities
                      (id-value (stages/sourcemodulev1-root-term module))))
                  (stages/sha256-digest?
                    (stages/sourcemodulev1-source-digest module))
                  (stages/sha256-digest?
                    (stages/sourcemodulev1-projection-digest module))
                  (stages/sha256-digest?
                    (stages/sourcemodulev1-interface-digest module))))
           modules)
         (= (count units) (count unit-identities))
         (every?
           (fn [(unit stages/SourceUnitV0)] Bool
             (source-unit-valid? unit identities module-identities unit-identities))
           units))))

(defn source-failure [(stage stages/SourceStageV1)] LowerFailureV0
  (let [(graph stages/TermGraphV0) (stages/sourcestagev1-terms stage)
        (root core/NativeId) (stages/termgraphv0-root graph)
        (nodes (Vec stages/TermNodeV0)) (stages/termgraphv0-nodes graph)
        (identities (Map String Bool)) (graph-identity-index graph)]
    (cond
      (not (= true (get identities (id-value root))))
      (->MissingGraphRootV0 root)

      (not (= (count nodes) (count identities)))
      (->DuplicateTermIdentityV0 root)

      (not (graph-reference-closed-in? graph identities))
      (->UnclosedTermReferenceV0 root root)

      :else
      (->InvalidSourceModuleV0 root
        "a module/unit root, read set, or checked digest is invalid"))))

(defn encode-configuration [(configuration (Vec String))] String
  (stages/canonical-set "configuration" configuration))

(defn make-receipt
  [(input-digest String)
   (compiler-commit String)
   (pass-id String)
   (configuration (Vec String))
   (diagnostics (Vec core/DiagnosticV0))
   (obligations (Vec core/ReceiptObligationV0))
   (output-digest String)]
  core/PassReceiptV0
  (core/->PassReceiptV0
    (lower-id "receipt" [pass-id input-digest output-digest])
    input-digest
    compiler-commit
    pass-id
    "v0"
    configuration
    (stages/configuration-digest configuration)
    diagnostics
    obligations
    output-digest
    "none"
    "none"
    []))

(defn source-closure-obligation
  [(digest String) (passed Bool) (detail String)] core/ReceiptObligationV0
  (core/->ReceiptObligationV0
    (core/->ValidSsaObligation true)
    "v0"
    digest
    passed
    detail))

(defn freeze-source-stage
  [(stage stages/SourceStageV1)
   (compiler-commit String)
   (configuration (Vec String))]
  SourceFreezeResultV0
  (let [(encoding String) (stages/encode-source-stage stage)
        (digest String) (stages/content-digest encoding)]
    (if (source-stage-valid? stage)
      (->SourceFreezeAcceptedV0
        (stages/->FrozenSourceStageV1 stage encoding digest)
        (make-receipt digest compiler-commit "source-freeze" configuration []
          [(source-closure-obligation digest true
             "source Term identities and module roots are closed")]
          digest))
      (let [(failure LowerFailureV0) (source-failure stage)]
        (->SourceFreezeRejectedV0
          failure
          (make-receipt digest compiler-commit "source-freeze" configuration
            [(core/->DiagnosticV0
               "LOWER-SOURCE-NOT-CLOSED"
               "source Term graph or module roots are not closed")]
            [(source-closure-obligation digest false
               "source Term identities or module roots are not closed")]
            ""))))))

;; The records below are a closed hot-loop projection of the authoritative
;; typed Term graph. They are discarded and rebuilt from the frozen stage.
(defunion NativeReadinessV0
  (NativeReadyV0 [(operation String)])
  (NativeLoweredV0 [(entry-block core/NativeId) (blocks (Vec core/BasicBlock))])
  (NativeTodoV0 [(code String) (detail String)]))

(defrecord TypedFunctionV0
  [(id core/NativeId)
   (name String)
   (abi-symbol String)
   (parameters (Vec core/Parameter))
   (return-type core/NativeId)
   (failure-type core/NativeId)
   (effects (Vec core/NativeId))
   (readiness NativeReadinessV0)
   (encoding String)])

(defrecord TypedSliceV0
  [(types (Vec core/TypeDef))
   (functions (Vec TypedFunctionV0))
   (effects (Vec core/EffectDef))
   (regions (Vec core/RegionDef))
   (capabilities (Vec core/CapabilityDef))
   (failures (Vec core/NativeId))])

(defn ready-function? [(function TypedFunctionV0)] Bool
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) true]
    [(NativeLoweredV0 entry-block blocks) true]
    [(NativeTodoV0 code detail) false]))

(defn function-operation [(function TypedFunctionV0)] String
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) operation]
    [(NativeLoweredV0 entry-block blocks) "native-body-v0"]
    [(NativeTodoV0 code detail) "pending"]))

(defn function-body-blocks [(function TypedFunctionV0)] (Vec core/BasicBlock)
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) []]
    [(NativeLoweredV0 entry-block blocks) blocks]
    [(NativeTodoV0 code detail) []]))

(defn function-body-entry [(function TypedFunctionV0)] (U core/NativeId Nil)
  (match (typedfunctionv0-readiness function)
    [(NativeReadyV0 operation) nil]
    [(NativeLoweredV0 entry-block blocks) entry-block]
    [(NativeTodoV0 code detail) nil]))

(defrecord TypeResolutionV0
  [(type-id core/NativeId)
   (definitions (Vec core/TypeDef))
   (diagnostics (Vec core/DiagnosticV0))
   (valid Bool)])

(defunion TypingResultV0
  (TypingAcceptedV0
    [(frozen stages/FrozenTypedStageV0)
     (slice TypedSliceV0)
     (receipt core/PassReceiptV0)])
  (TypingRejectedV0 [(failure LowerFailureV0) (receipt core/PassReceiptV0)]))

(defn ends-with? [(value String) (suffix String)] Bool
  (let [(value-count Int) (count value)
        (suffix-count Int) (count suffix)]
    (and (>= value-count suffix-count)
         (= suffix (subs value (- value-count suffix-count) value-count)))))

(defn unqualified-name [(spelling String)] String
  (loop [(index Int) 0 (start Int) 0]
    (if (>= index (count spelling))
      (subs spelling start (count spelling))
      (if (= "/" (subs spelling index (+ index 1)))
        (recur (+ index 1) (+ index 1))
        (recur (+ index 1) start)))))

(defrecord ResolvedSourceNameV0
  [(module-name String) (local-name String) (visible Bool)])

(defn first-slash [(spelling String)] Int
  (loop [(position Int) 0]
    (if (>= position (count spelling))
      -1
      (if (= "/" (subs spelling position (+ position 1)))
        position
        (recur (+ position 1))))))

;; A projection with one module root and no import table is a closed
;; single-module program, so an alias-qualified spelling can only name that module.
(defn sole-module-name
  [(index SourceIndexV0) (module-name String)] (U String Nil)
  (let [(roots (Vec core/NativeId)) (index-form-ids index "module-root")]
    (if (and (= 1 (count roots))
             (= 0 (count (module-sequence index (nth roots 0) "imports"))))
      module-name
      nil)))

(defn resolve-source-name
  [(index SourceIndexV0)
   (module-name String)
   (spelling String)]
  ResolvedSourceNameV0
  (let [(slash Int) (first-slash spelling)]
    (if (< slash 0)
      (->ResolvedSourceNameV0 module-name spelling (> (count spelling) 0))
      (let [(alias String) (subs spelling 0 slash)
            (local-name String) (subs spelling (+ slash 1) (count spelling))
            (declared (U String Nil))
            (if (= alias module-name)
              module-name
              (imported-module-name index module-name alias))
            ;; The checker admits a fully-qualified reference to any module in
            ;; the closed source set, aliased or not; a declared import alias
            ;; still wins over a module that happens to share its spelling.
            (imported (U String Nil))
            (if (some? declared)
              declared
              (if (some? (module-root-named index alias))
                alias
                (sole-module-name index module-name)))]
        (if (or (nil? imported) (= "" local-name))
          (->ResolvedSourceNameV0 "" local-name false)
          (->ResolvedSourceNameV0 imported local-name true))))))

(defn resolved-source-key [(resolved ResolvedSourceNameV0)] String
  (if (resolvedsourcenamev0-visible resolved)
    (str (resolvedsourcenamev0-module-name resolved) "/"
      (resolvedsourcenamev0-local-name resolved))
    ""))

(defn type-id [(name String)] core/NativeId
  (lower-id "type" [(unqualified-name name)]))

(defn source-type-id [(qualified-name String)] core/NativeId
  (lower-id "type" [qualified-name]))

(defn field-id [(record-key String) (field-name String)] core/NativeId
  (lower-id "field" [record-key field-name]))

(defn function-id [(source-id core/NativeId) (name String)] core/NativeId
  (lower-id "function" [(id-value source-id) name]))

(defn variant-id [(owner String) (name String)] core/NativeId
  (lower-id "variant" [owner name]))

(defn bool-type [] core/TypeDef
  (core/->TypeDef (type-id "Bool") "Bool"
    (core/->AtomType (core/->BoolKind true))))

(defn i64-type [] core/TypeDef
  (core/->TypeDef (type-id "Int") "I64"
    (core/->AtomType (core/->I64Kind true))))

(defn fixed-integer-bit-width [(name String)] Int
  (cond
    (or (= name "I8") (= name "U8")) 8
    (or (= name "I16") (= name "U16")) 16
    (or (= name "I32") (= name "U32")) 32
    (= name "U64") 64
    :else 0))

(defn fixed-integer-name? [(name String)] Bool
  (> (fixed-integer-bit-width name) 0))

(defn fixed-integer-unsigned? [(name String)] Bool
  (or (= name "U8") (= name "U16") (= name "U32") (= name "U64")))

(defn fixed-integer-type [(name String)] core/TypeDef
  (core/->TypeDef (type-id name) name
    (core/->AtomType (core/->I64Kind true))))

(defn integer-type-id? [(target core/NativeId)] Bool
  (or (same-id? target (type-id "Int"))
    (some?
      (some
        (fn [(name String)] Bool (same-id? target (type-id name)))
        ["I8" "I16" "I32" "U8" "U16" "U32" "U64"]))))

(defn f64-type [] core/TypeDef
  (core/->TypeDef (type-id "Float") "F64"
    (core/->AtomType (core/->F64Kind true))))

(defn text-type [] core/TypeDef
  (core/->TypeDef (type-id "String") "Text"
    (core/->AtomType (core/->TextKind true))))

(defn bytes-type-id [] core/NativeId (type-id "NativeBytes"))

(defn bytes-type [] core/TypeDef
  (core/->TypeDef (bytes-type-id) "NativeBytes"
    (core/->AtomType (core/->BytesKind true))))

(defn regex-match-type-id [] core/NativeId
  (lower-id "regex-match-type" [(id-value (type-id "String"))]))

;; A successful regular-expression search always has element zero (the whole
;; match), so an empty vector is an unambiguous absence representation.
(defn regex-match-type [] core/TypeDef
  (core/->TypeDef (regex-match-type-id) "RegexMatch"
    (core/->VectorType (type-id "String"))))

(defn keyword-type [] core/TypeDef
  (core/->TypeDef (type-id "Keyword") "Keyword"
    (core/->AtomType (core/->KeywordKind true))))

;; The arena handle a body acquires before it allocates. Self-referential by
;; construction: an opaque pointer has no closed pointee in native code.
(defn arena-handle-type-id [] core/NativeId (type-id "ArenaHandle"))

(defn arena-handle-type [] core/TypeDef
  (core/->TypeDef (arena-handle-type-id) "ArenaHandle"
    (core/->ReferenceType (arena-handle-type-id))))

;; Borrowed octets a host handed in. Reference-shaped like the arena handle so
;; the whole value is one pointer: nothing here owns, copies, or widens storage.
(defn byte-source-type-id [] core/NativeId (type-id "ByteSource"))

(defn byte-source-type [] core/TypeDef
  (core/->TypeDef (byte-source-type-id) "ByteSource"
    (core/->ReferenceType (byte-source-type-id))))

(defn atom-state-handle-type-id [] core/NativeId
  (type-id "AtomStateHandle"))

(defn atom-state-handle-type [] core/TypeDef
  (core/->TypeDef (atom-state-handle-type-id) "AtomStateHandle"
    (core/->ReferenceType (atom-state-handle-type-id))))

(defn nil-type [] core/TypeDef
  (core/->TypeDef (type-id "Nil") "Unit"
    (core/->UnionType
      [(core/->TypeVariant (variant-id "Unit" "unit") "unit" nil)])))

(defn record-reference-type-id [(record-key String)] core/NativeId
  (lower-id "reference-type" [(id-value (source-type-id record-key))]))

(defn record-reference-type [(record-key String)] core/TypeDef
  (core/->TypeDef (record-reference-type-id record-key) "Reference"
    (core/->ReferenceType (source-type-id record-key))))

;; Records enter Any by reference, never by value: a record whose own fields are
;; Any (Triple) would otherwise have no finite layout.
(defn slice-value-variants [(record-keys (Vec String))] (Vec core/TypeVariant)
  (loop [(position Int) 0
         (variants (Vec core/TypeVariant))
         [(core/->TypeVariant (variant-id "SliceValue" "bool") "bool" (type-id "Bool"))
          (core/->TypeVariant (variant-id "SliceValue" "i64") "i64" (type-id "Int"))
          (core/->TypeVariant (variant-id "SliceValue" "f64") "f64" (type-id "Float"))
          (core/->TypeVariant (variant-id "SliceValue" "text") "text" (type-id "String"))
          (core/->TypeVariant (variant-id "SliceValue" "keyword") "keyword"
            (type-id "Keyword"))
          (core/->TypeVariant (variant-id "SliceValue" "nil") "nil" nil)]]
    (if (>= position (count record-keys))
      variants
      (let [(key String) (nth record-keys position)]
        (recur (+ position 1)
          (conj variants
            (core/->TypeVariant (variant-id "SliceValue" key) key
              (record-reference-type-id key))))))))

(defn slice-value-type [(record-keys (Vec String))] core/TypeDef
  (core/->TypeDef (type-id "SliceValue") "SliceValue"
    (core/->UnionType (slice-value-variants record-keys))))

(defn slice-value-definitions [(record-keys (Vec String))] (Vec core/TypeDef)
  (loop [(position Int) 0
         (definitions (Vec core/TypeDef))
         [(slice-value-type record-keys) (bool-type) (i64-type) (f64-type)
          (text-type) (keyword-type)]]
    (if (>= position (count record-keys))
      definitions
      (recur (+ position 1)
        (conj definitions (record-reference-type (nth record-keys position)))))))

;; A record enters every closed union by reference, as it enters Any: a by-value
;; alternative has no address to hand a tag-inject coercion.
(defn union-member-id
  [(record-keys (Vec String)) (member core/NativeId)] core/NativeId
  (loop [(position Int) 0]
    (if (>= position (count record-keys))
      member
      (let [(key String) (nth record-keys position)]
        (if (same-id? member (source-type-id key))
          (record-reference-type-id key)
          (recur (+ position 1)))))))

(defn union-member-ids
  [(record-keys (Vec String)) (ids (Vec core/NativeId))] (Vec core/NativeId)
  (mapv
    (fn [(member core/NativeId)] core/NativeId
      (union-member-id record-keys member))
    ids))

(defn lower-failure-type [] core/TypeDef
  (core/->TypeDef (type-id "LowerFailure") "LowerFailure"
    (core/->UnionType
      [(core/->TypeVariant (variant-id "LowerFailure" "invalid-term") "invalid-term" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "invalid-coordinate") "invalid-coordinate" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "union-variant-mismatch") "union-variant-mismatch" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "bounds") "bounds" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "overflow") "overflow" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "malformed-source") "malformed-source" nil)
       (core/->TypeVariant (variant-id "LowerFailure" "binding-constraint") "binding-constraint" nil)])))

;; An Outcome's tag namespace is its failure union, so the success alternative
;; has to live there: `ok` carries the value, `overflow` carries nothing.
(defn checked-i64-result-type [] core/TypeDef
  (core/->TypeDef (core/checked-i64-result-type-id) "CheckedI64Result"
    (core/->UnionType
      [(core/->TypeVariant (core/checked-ok-variant-id) "ok" (type-id "Int"))
       (core/->TypeVariant (core/checked-overflow-variant-id) "overflow" nil)])))

(defn checked-i64-type [] core/TypeDef
  (core/->TypeDef (core/checked-i64-type-id) "CheckedI64"
    (core/->OutcomeType (type-id "Int") (core/checked-i64-result-type-id))))

(defn checked-division-i64-result-type [] core/TypeDef
  (core/->TypeDef
    (core/checked-division-i64-result-type-id) "CheckedDivisionI64Result"
    (core/->UnionType
      [(core/->TypeVariant
         (core/checked-division-ok-variant-id) "ok" (type-id "Int"))
       (core/->TypeVariant
         (core/checked-division-zero-variant-id) "division-by-zero" nil)])))

(defn checked-division-i64-type [] core/TypeDef
  (core/->TypeDef
    (core/checked-division-i64-type-id) "CheckedDivisionI64"
    (core/->OutcomeType (type-id "Int")
      (core/checked-division-i64-result-type-id))))

(defn checked-arithmetic-types [] (Vec core/TypeDef)
  [(i64-type)
   (checked-i64-result-type)
   (checked-i64-type)
   (checked-division-i64-result-type)
   (checked-division-i64-type)])

