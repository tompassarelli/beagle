         (encode-id-roots "arguments"
           (core/externcallinstruction-arguments instruction))
         (if (nil? arena) "no-arena" (id-value arena))]))

    :else ""))

(defn encode-terminator [(terminator core/Terminator)] String
  (cond
    (instance? native.core.ReturnTerminator terminator)
    (let [(value (U core/NativeId Nil)) (core/returnterminator-value terminator)]
      (stages/canonical-record "return"
        [(if (nil? value) "unit" (id-value value))]))

    (instance? native.core.JumpTerminator terminator)
    (stages/canonical-record "jump"
      [(id-value (core/jumpterminator-block-id terminator))
       (encode-id-roots "arguments" (core/jumpterminator-arguments terminator))])

    (instance? native.core.BranchTerminator terminator)
    (stages/canonical-record "branch"
      [(id-value (core/branchterminator-condition terminator))
       (id-value (core/branchterminator-true-block terminator))
       (id-value (core/branchterminator-false-block terminator))])

    (instance? native.core.SwitchTerminator terminator)
    (stages/canonical-record "switch"
      [(id-value (core/switchterminator-value-id terminator))])

    :else
    (stages/canonical-record "trap"
      [(id-value (core/trapterminator-failure-id terminator))])))

(defn encode-basic-block [(block core/BasicBlock)] String
  (stages/canonical-record "basic-block-v0"
    [(id-value (core/basicblock-id block))
     (stages/canonical-record "parameters"
       (mapv
         (fn [(parameter core/Parameter)] String (encode-parameter parameter))
         (core/basicblock-parameters block)))
     (stages/canonical-record "instructions"
       (mapv
         (fn [(instruction core/Instruction)] String
           (encode-instruction instruction))
         (core/basicblock-instructions block)))
     (stages/canonical-record "terminators"
       (mapv
         (fn [(terminator core/Terminator)] String
           (encode-terminator terminator))
         (core/basicblock-terminators block)))]))

(defn encode-native-function [(function core/FunctionDef)] String
  (stages/canonical-record "native-function-v0"
    [(id-value (core/functiondef-id function))
     (core/functiondef-name function)
     (stages/canonical-record "parameters"
       (mapv
         (fn [(parameter core/Parameter)] String (encode-parameter parameter))
         (core/functiondef-parameters function)))
     (stages/canonical-record "blocks"
       (mapv
         (fn [(block core/BasicBlock)] String (encode-basic-block block))
         (core/functiondef-blocks function)))
     (id-value (core/functiondef-entry-block function))
     (let [(result (U core/NativeId Nil)) (core/functiondef-return-type function)]
       (if (nil? result) "unit" (id-value result)))
     (encode-id-roots "effects" (core/functiondef-effects function))
     (encode-id-roots "regions" (core/functiondef-regions function))
     (encode-id-roots "capabilities" (core/functiondef-capabilities function))]))

(defn encode-abi-value [(value core/AbiValueV0)] String
  (stages/canonical-record "abi-value-v0"
    [(core/abivaluev0-name value)
     (id-value (core/abivaluev0-type-id value))]))

(defn encode-ownership [(ownership core/OwnershipRuleV0)] String
  (cond
    (instance? native.core.BorrowedV0 ownership) "borrowed"
    (instance? native.core.OwnedV0 ownership) "owned"
    :else
    (stages/canonical-record "arena-owned"
      [(id-value (core/arenaownedv0-region ownership))])))

(defn encode-import-abi-value [(value core/AbiValueV0)] String
  (let [(lifetime (U core/NativeId Nil))
        (core/abivaluev0-lifetime-region value)]
    (stages/canonical-record "import-abi-value-v0"
      [(core/abivaluev0-name value)
       (id-value (core/abivaluev0-type-id value))
       (encode-ownership (core/abivaluev0-ownership value))
       (if (nil? lifetime) "no-lifetime" (id-value lifetime))])))

(defn encode-abi [(abi core/AbiDeclV0)] String
  (let [(result (U core/AbiValueV0 Nil)) (core/abideclv0-result abi)]
    (if (instance? native.core.AbiImportV0 (core/abideclv0-direction abi))
      (stages/canonical-record "abi-import-declaration-v0"
        [(id-value (core/abideclv0-id abi))
         (id-value (core/abideclv0-function-id abi))
         (core/abideclv0-symbol abi)
         (cond
           (instance? native.core.RestrictedCOptionalOutAbiV0
             (core/abideclv0-convention abi))
           "restricted-c-optional-out-v0"
           (instance? native.core.RestrictedCOutcomeOutAbiV0
             (core/abideclv0-convention abi))
           "restricted-c-outcome-out-v0"
           :else "restricted-c-v0")
         (stages/canonical-record "parameters"
           (mapv
             (fn [(value core/AbiValueV0)] String
               (encode-import-abi-value value))
             (core/abideclv0-parameters abi)))
         (if (nil? result) "unit" (encode-import-abi-value result))
         (id-value (core/abideclv0-failure-type abi))
         (encode-id-roots "effects" (core/abideclv0-required-effects abi))
         (encode-id-roots "capabilities"
           (core/abideclv0-required-capabilities abi))
         (core/abideclv0-version abi)
         (core/abideclv0-layout-digest abi)])
      (stages/canonical-record "abi-declaration-v0"
        [(id-value (core/abideclv0-id abi))
         (id-value (core/abideclv0-function-id abi))
         (core/abideclv0-symbol abi)
         (stages/canonical-record "parameters"
           (mapv
             (fn [(value core/AbiValueV0)] String (encode-abi-value value))
             (core/abideclv0-parameters abi)))
         (if (nil? result) "unit" (encode-abi-value result))
         (id-value (core/abideclv0-failure-type abi))
         (encode-id-roots "effects" (core/abideclv0-required-effects abi))
         (encode-id-roots "capabilities"
           (core/abideclv0-required-capabilities abi))
         (core/abideclv0-version abi)
         (core/abideclv0-layout-digest abi)]))))

(defn native-term-nodes
  [(types (Vec core/TypeDef))
   (effects (Vec core/EffectDef))
   (capabilities (Vec core/CapabilityDef))
   (layouts (Vec core/LayoutDef))
   (functions (Vec core/FunctionDef))
   (abis (Vec core/AbiDeclV0))
   (obligation-results (Vec core/ObligationResult))]
  (Vec stages/TermNodeV0)
  (let [(type-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(definition core/TypeDef)] stages/TermNodeV0
            (stages/->TermNodeV0 (core/typedef-id definition)
              (stages/->TextTermV0 (encode-type-def definition))))
          types)
        (effect-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(effect core/EffectDef)] stages/TermNodeV0
            (stages/->TermNodeV0 (core/effectdef-id effect)
              (stages/->TextTermV0 (encode-effect effect))))
          effects)
        (layout-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(layout core/LayoutDef)] stages/TermNodeV0
            (stages/->TermNodeV0 (core/layoutdef-id layout)
              (stages/->TextTermV0 (encode-layout-def layout))))
          layouts)
        (function-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(function core/FunctionDef)] stages/TermNodeV0
            (stages/->TermNodeV0 (core/functiondef-id function)
              (stages/->TextTermV0 (encode-native-function function))))
          functions)
        (abi-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(abi core/AbiDeclV0)] stages/TermNodeV0
            (stages/->TermNodeV0 (core/abideclv0-id abi)
              (stages/->TextTermV0 (encode-abi abi))))
          abis)
        (obligation-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(result core/ObligationResult)] stages/TermNodeV0
            (let [(id core/NativeId)
                  (lower-id "obligation"
                    [(core/obligationresult-detail result)])]
              (stages/->TermNodeV0 id
                (stages/->TextTermV0
                  (stages/canonical-record "native-obligation-v0"
                    [(if (core/obligationresult-passed result) "pass" "fail")
                     (core/obligationresult-detail result)])))))
          obligation-results)
        (environment-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-environment-capability-id))
          [(stages/->TermNodeV0 (host-environment-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-environment-capability-id))
                  "host-environment"
                  "non-affine"])))]
          [])
        (context-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-context-capability-id))
          [(stages/->TermNodeV0 (host-context-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-context-capability-id))
                  "host-context-read-v0"
                  "non-affine"])))]
          [])
        (stdout-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-stdout-capability-id))
          [(stages/->TermNodeV0 (host-stdout-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-stdout-capability-id))
                  "host-stdout"
                  "non-affine"])))]
          [])
        (stderr-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-stderr-capability-id))
          [(stages/->TermNodeV0 (host-stderr-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-stderr-capability-id))
                  "host-stderr"
                  "non-affine"])))]
          [])
        (filesystem-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-filesystem-capability-id))
          [(stages/->TermNodeV0 (host-filesystem-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-filesystem-capability-id))
                  "host-filesystem-v0"
                 "non-affine"])))]
          [])
        (process-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-process-capability-id))
          [(stages/->TermNodeV0 (host-process-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-process-capability-id))
                  "host-process-run-inherit-v0"
                  "non-affine"])))]
          [])
        (socket-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-socket-capability-id))
          [(stages/->TermNodeV0 (host-socket-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-socket-capability-id))
                  "host-socket-peer-lifecycle-v0"
                  "non-affine"])))]
          [])
        (clock-capability-nodes (Vec stages/TermNodeV0))
        (if (core/id-in? (core/capability-ids capabilities)
              (host-clock-capability-id))
          [(stages/->TermNodeV0 (host-clock-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-clock-capability-id))
                  "host-monotonic-clock-v0"
                  "non-affine"])))]
          [])]
    (vec (concat type-nodes effect-nodes layout-nodes function-nodes abi-nodes
           obligation-nodes environment-capability-nodes
           context-capability-nodes
           stdout-capability-nodes stderr-capability-nodes
           filesystem-capability-nodes process-capability-nodes
           socket-capability-nodes
           clock-capability-nodes
           [(stages/->TermNodeV0 (arena-region-id)
              (stages/->TextTermV0
                (stages/canonical-record "region-v0"
                  [(id-value (arena-region-id)) "arena"])))
            (stages/->TermNodeV0 (write-capability-id)
              (stages/->TextTermV0
                (stages/canonical-record "capability-v0"
                  [(id-value (write-capability-id)) "affine-write"])))]))))

(defn native-obligation-results
  [(valid-ssa Bool)
   (exhaustive Bool)
   (layouts-closed Bool)
   (checked Bool)
   (legal-abi Bool)
   (tokens-discharged Bool)
   (effects-bounded Bool)
   (epoch-sound Bool)
   (leak-free Bool)
   (parallel-deterministic Bool)]
  (Vec core/ObligationResult)
  [(core/->ObligationResult (core/->ValidSsaObligation true) valid-ssa
     "typed SSA definitions and uses are closed")
   (core/->ObligationResult (core/->ExhaustiveMatchesObligation true) exhaustive
     "every lowered closed union dispatch is exhaustive")
   (core/->ObligationResult (core/->ClosedLayoutsObligation true) layouts-closed
     "every reachable type has an exact target-neutral layout")
   (core/->ObligationResult (core/->CheckedOperationsObligation true) checked
     "integer and bounds operations use checked Native Core operations")
   (core/->ObligationResult (core/->LegalAbiObligation true) legal-abi
     "every lowered probe entry point has an explicit restricted ABI")
   (core/->ObligationResult (core/->DischargedTokensObligation true) tokens-discharged
     "affine region and capability tokens are discharged")
   (core/->ObligationResult (core/->BoundedEffectsObligation true) effects-bounded
     "function effects stay inside the declared program capability sets")
   (core/->ObligationResult (core/->EpochSoundnessObligation true) epoch-sound
     "no reference points from an older epoch into a younger one")
   (core/->ObligationResult (core/->LeakFreedomObligation true) leak-free
     "every opened epoch region provably closes on all paths in tree order")
   (core/->ObligationResult
     (core/->DeterministicParallelismObligationV0 true)
     parallel-deterministic
     "parallel plans use stable partitions, leaf kernels, and fixed reductions")])

(defn encode-obligation-result [(result core/ObligationResult)] String
  (stages/canonical-record "native-obligation-v0"
    [(if (core/obligationresult-passed result) "pass" "fail")
     (core/obligationresult-detail result)]))

(defn layout-pending-obligations
  [(resolutions (Vec LayoutResolutionV0))
   (digest String)]
  (Vec core/ReceiptObligationV0)
  (loop [(index Int) 0 (obligations (Vec core/ReceiptObligationV0)) []]
    (if (>= index (count resolutions))
      obligations
      (let [(resolution LayoutResolutionV0) (nth resolutions index)]
        (if (layoutresolutionv0-closed resolution)
          (recur (+ index 1) obligations)
          (recur (+ index 1)
            (conj obligations
              (core/->ReceiptObligationV0
                (core/->ClosedLayoutsObligation true)
                "v0"
                digest
                false
                (str "TODO-NATIVE-LAYOUT-"
                  (id-value
                    (core/layoutdef-type-id
                      (layoutresolutionv0-layout resolution)))
                  ": "
                  (layoutresolutionv0-detail resolution))))))))))

(defn native-receipt-obligations
  [(digest String)
   (core-valid Bool)
   (layouts-closed Bool)
   (legal-abi Bool)
   (tokens-discharged Bool)
   (clean Bool)
   (epoch-sound Bool)
   (leak-free Bool)
   (parallel-deterministic Bool)]
  (Vec core/ReceiptObligationV0)
  [(core/->ReceiptObligationV0
     (core/->ValidSsaObligation true) "v0" digest core-valid
     "Native Core validator accepts all SSA definitions and references")
   (core/->ReceiptObligationV0
     (core/->ExhaustiveMatchesObligation true) "v0" digest true
     "the implemented A5 fixture operations contain no partial closed-union switch")
   (core/->ReceiptObligationV0
     (core/->ClosedLayoutsObligation true) "v0" digest layouts-closed
     "all reachable type shapes have exact size, alignment, and field offsets")
   (core/->ReceiptObligationV0
     (core/->CheckedOperationsObligation true) "v0" digest true
     "the implemented integer operation lowers to CheckedOperationV0")
   (core/->ReceiptObligationV0
     (core/->LegalAbiObligation true) "v0" digest legal-abi
     "every implemented probe function carries an explicit ABI declaration")
   (core/->ReceiptObligationV0
     (core/->DischargedTokensObligation true) "v0" digest tokens-discharged
     "implemented functions do not leak an affine capability token")
   (core/->ReceiptObligationV0
     (core/->BoundedEffectsObligation true) "v0" digest core-valid
     "implemented function effects stay inside program declarations")
   (core/->ReceiptObligationV0
     (core/->EpochSoundnessObligation true) "v0" digest epoch-sound
     "no reference points from an older epoch into a younger one")
   (core/->ReceiptObligationV0
     (core/->LeakFreedomObligation true) "v0" digest leak-free
     "every opened epoch region provably closes on all paths in tree order")
   (core/->ReceiptObligationV0
     (core/->DeterministicParallelismObligationV0 true) "v0" digest
     parallel-deterministic
     "parallel plans use stable partitions, leaf kernels, and fixed reductions")
   (core/->ReceiptObligationV0
     (core/->ValidSsaObligation true) "v0" digest clean
     "native Terms contain no raw Any, host exception, host collection, or target syntax")])

(defn all-functions-ready? [(functions (Vec TypedFunctionV0))] Bool
  (every?
    (fn [(function TypedFunctionV0)] Bool (ready-function? function))
    functions))

(defn native-diagnostics
  [(layouts-closed Bool)
   (legal-abi Bool)
   (functions-ready Bool)]
  (Vec core/DiagnosticV0)
  (let [(layout-diagnostics (Vec core/DiagnosticV0))
        (if layouts-closed
          []
          [(core/->DiagnosticV0
             "TODO-NATIVE-RECURSIVE-LAYOUT"
             "one or more recursive value shapes still require an explicit reference edge")])
        (abi-diagnostics (Vec core/DiagnosticV0))
        (if legal-abi
          []
          [(core/->DiagnosticV0
             "TODO-NATIVE-PROBE-ABI"
             "no implemented probe entry point is available for ABI declaration")])]
    (if functions-ready
      (vec (concat layout-diagnostics abi-diagnostics))
      (vec (concat layout-diagnostics abi-diagnostics
             [(core/->DiagnosticV0
                "TODO-NATIVE-SLICE-BODIES"
                "typed source functions with unimplemented bodies remain explicit obligations")])))))

(defn lower-native-stage
  [(frozen-typed stages/FrozenTypedStageV0)
   (slice TypedSliceV0)
   (compiler-commit String)
   (configuration (Vec String))
   (abi core/AbiProfileV0)]
  NativeLoweringResultV0
  (let [(typed-digest String) (stages/frozentypedstagev0-digest frozen-typed)
        (types (Vec core/TypeDef))
        (append-type-def (typedslicev0-types slice) (union-tag-type))
        (layout-resolutions (Vec LayoutResolutionV0)) (resolve-layouts types abi)
        (layouts (Vec core/LayoutDef)) (collect-layouts layout-resolutions)
        (typed-functions (Vec TypedFunctionV0)) (typedslicev0-functions slice)
        (functions (Vec core/FunctionDef)) (lower-ready-functions typed-functions)
        (abis (Vec core/AbiDeclV0))
        (slice-abis typed-functions functions types layouts)
        (effects (Vec core/EffectDef)) (typedslicev0-effects slice)
        (regions (Vec core/RegionDef)) (typedslicev0-regions slice)
        (capabilities (Vec core/CapabilityDef)) (typedslicev0-capabilities slice)
        (program-id core/NativeId) (lower-id "native-program" [typed-digest])
        (program core/NativeCoreProgram)
        (core/->NativeCoreProgram
          program-id
          (lower-id "typed-stage" [typed-digest])
          "typed-to-native-v0"
          types
          effects
          regions
          capabilities
          layouts
          functions
          (mapv (fn [(effect core/EffectDef)] core/NativeId
                  (core/effectdef-id effect)) effects)
          (mapv (fn [(region core/RegionDef)] core/NativeId
                  (core/regiondef-id region)) regions)
          (mapv (fn [(capability core/CapabilityDef)] core/NativeId
                  (core/capabilitydef-id capability)) capabilities)
          abis
          [])
        (validation core/ValidationReport) (core/validate-program program)
        (core-valid Bool) (core/validationreport-passed validation)
        (closed-layouts Bool) (layouts-closed? layout-resolutions)
        (functions-ready Bool) (all-functions-ready? typed-functions)
        (legal-abi Bool)
        (and (> (count functions) 0)
          (= (+ (count (public-ready-functions typed-functions functions))
               (if (any-function-uses-environment? typed-functions) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-context-abi-id "system-hostname")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-context-abi-id "system-platform")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-context-abi-id "terminal-stdout-tty")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-stdout-write-abi-id)) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-stdout-abi-id)) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-stderr-write-abi-id)) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-stderr-write-line-abi-id)) 1 0)
               (if (or
                     (any-function-calls-abi? typed-functions
                       (host-filesystem-abi-id "read-text-bounded"))
                     (any-function-calls-abi? typed-functions
                       (host-filesystem-abi-id "list-directory-bounded"))
                     (any-function-calls-abi? typed-functions
                       (host-filesystem-abi-id "path-kind"))
                     (any-function-calls-abi? typed-functions
                       (host-filesystem-abi-id "write-text-atomic")))
                 4 0)
               (if (any-function-calls-abi? typed-functions
                     (host-filesystem-abi-id "make-parent-directories")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-filesystem-abi-id "append-text")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-filesystem-abi-id "lock-exclusive")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-filesystem-abi-id "unlock")) 1 0)
               (count
                 (filterv
                   (fn [(abi core/AbiDeclV0)] Bool
                     (any-function-calls-abi? typed-functions
                       (core/abideclv0-id abi)))
                   (host-process-abis (layout-digest layouts))))
               (if (any-function-calls-abi? typed-functions
                     (host-time-sleep-abi-id)) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-clock-abi-id)) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-wall-clock-abi-id "wall-nanoseconds")) 1 0)
               (if (any-function-calls-abi? typed-functions
                     (host-wall-clock-abi-id "format-iso8601")) 1 0)
               (if (any-function-uses-host-socket? typed-functions) 5 0))
            (count abis)))
        (tokens-discharged Bool)
        (every?
          (fn [(function core/FunctionDef)] Bool
            (function-tokens-discharged? function))
          functions)
        ;; Typed-to-native emits the degenerate two-root region set and no
        ;; epoch instructions, so obligations 8/9 hold by construction; this
        ;; is the witness of that construction, not a re-derivation.
        (epoch-inert Bool) (core/program-epoch-0? program)
        (parallel-deterministic Bool)
        (obligations/obligation-passed?
          (obligations/deterministic-parallelism program))
        (obligation-results (Vec core/ObligationResult))
        (native-obligation-results core-valid true closed-layouts true legal-abi
          tokens-discharged core-valid epoch-inert epoch-inert
          parallel-deterministic)
        (root core/NativeId) (lower-id "native-terms" [typed-digest])
        (obligation-roots (Vec core/NativeId))
        (mapv
          (fn [(result core/ObligationResult)] core/NativeId
            (lower-id "obligation" [(core/obligationresult-detail result)]))
          obligation-results)
        (nodes (Vec stages/TermNodeV0))
        (native-term-nodes types effects capabilities layouts functions abis
          obligation-results)
        (terms stages/TermGraphV0)
        (stages/->TermGraphV0 root
          (conj nodes
            (stages/->TermNodeV0 root
              (stages/->TextTermV0 "native-stage-v0"))))
        (clean Bool) (term-graph-clean? terms)
        (stage stages/NativeStageV0)
        (stages/->NativeStageV0 terms typed-digest program obligation-roots)
        (encoding String) (stages/encode-native-stage stage)
        (digest String) (stages/content-digest encoding)
        (frozen stages/FrozenNativeStageV0)
        (stages/->FrozenNativeStageV0 stage encoding digest)
        (pending-layouts (Vec core/ReceiptObligationV0))
        (layout-pending-obligations layout-resolutions digest)
        (pending-functions (Vec core/ReceiptObligationV0))
        (function-todo-obligations typed-functions digest)
        (obligations (Vec core/ReceiptObligationV0))
        (vec (concat
               (native-receipt-obligations digest core-valid closed-layouts
                 legal-abi tokens-discharged clean epoch-inert epoch-inert
                 parallel-deterministic)
               pending-layouts
               pending-functions))
        (diagnostics (Vec core/DiagnosticV0))
        (native-diagnostics closed-layouts legal-abi functions-ready)
        (receipt core/PassReceiptV0)
        (make-receipt typed-digest compiler-commit "typed-to-native"
          configuration diagnostics obligations digest)
        (complete Bool)
        (and core-valid closed-layouts functions-ready legal-abi
          tokens-discharged clean parallel-deterministic)]
    (if complete
      (->NativeLoweringCompleteV0 frozen receipt)
      (->NativeLoweringPendingV0 frozen receipt
        (vec (concat pending-layouts pending-functions))))))

(defn native-program-host-erased? [(frozen stages/FrozenNativeStageV0)] Bool
  (term-graph-clean?
    (stages/nativestagev0-terms
      (stages/frozennativestagev0-stage frozen))))

;; --- The epoch stage: a fourth pass, program -> program, between native
;; lowering and every materializer. It mints the region tree (one local epoch
;; per function whose escape closure leaves interior allocations), retargets
;; those allocations' arena operands, inserts the epoch open and its
;; ArenaCloseInstructionV0 on every exit path, and re-freezes under
;; compiler-pass "native-to-epoch-v0". An underivable site keeps the parent
;; epoch — sound, merely unreclaimed — and is named with a TODO-EPOCH-* code.

(defunion EpochLoweringResultV0
  (EpochLoweringCompleteV0
    [(frozen stages/FrozenNativeStageV0) (receipt core/PassReceiptV0)])
  (EpochLoweringPendingV0
    [(frozen stages/FrozenNativeStageV0)
     (receipt core/PassReceiptV0)
     (obligations (Vec core/ReceiptObligationV0))]))

;; The assignment the stage runs under. EpochIdentityV0 assigns every
;; allocation to epoch-0 — the root arena it already names — so the stage
;; mints no region, retargets no operand, inserts no close, and the program it
;; freezes is the one it was handed under a new identity. EpochDerivedV0 is
;; the inference of §2. Every materializer path runs the stage under identity
;; until the emitters can open and close a minted epoch.
(defunion EpochAssignmentV0
  (EpochIdentityV0 [(token Bool)])
  (EpochDerivedV0 [(token Bool)]))

(defn find-block-with-id
  [(blocks (Vec core/BasicBlock))
   (block-id core/NativeId)]
  (U core/BasicBlock Nil)
  (loop [(position Int) 0]
    (cond
      (>= position (count blocks)) nil
      (same-id? (core/basicblock-id (nth blocks position)) block-id)
      (nth blocks position)
      :else (recur (+ position 1)))))

(defn epoch-mark-ids
  [(marks (Map String Bool)) (ids (Vec core/NativeId))] (Map String Bool)
  (loop [(position Int) 0 (current (Map String Bool)) marks]
    (if (>= position (count ids))
      current
      (recur (+ position 1)
        (assoc current (id-value (nth ids position)) true)))))

(defn epoch-marked? [(marks (Map String Bool)) (value-id core/NativeId)] Bool
  (= true (get marks (id-value value-id))))

;; Escape seeds: values a function hands past its own frame. Store operands,
;; atom-cell traffic, call and extern arguments (a missing callee summary
;; means retained — the v2 lesson), returns, and trap payloads.
(defn epoch-escape-seeds [(function core/FunctionDef)] (Map String Bool)
  (loop [(block-position Int) 0
         (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
         (marks (Map String Bool)) {}]
    (if (>= block-position (count blocks))
      marks
      (let [(block core/BasicBlock) (nth blocks block-position)
            (with-instructions (Map String Bool))
            (loop [(position Int) 0
                   (instructions (Vec core/Instruction))
                   (core/basicblock-instructions block)
                   (current (Map String Bool)) marks]
              (if (>= position (count instructions))
                current
                (let [(instruction core/Instruction) (nth instructions position)]
                  (recur (+ position 1) instructions
                    (cond
                      ;; Buffer v0 is explicitly root-region-owned. Marking its
                      ;; identity as escaping prevents the derived epoch pass
                      ;; from silently retargeting only the arena operand while
                      ;; leaving its frozen region/capability contract behind.
                      (instance? native.core.BufferAllocateInstructionV0
                        instruction)
                      (epoch-mark-ids current
                        [(core/instruction-result-id instruction)])

                      (instance? native.core.StoreInstruction instruction)
                      (epoch-mark-ids current
                        (core/instruction-ssa-refs instruction))

                      (or (instance? native.core.AtomCreateInstruction instruction)
                        (instance? native.core.AtomDerefInstruction instruction)
                        (instance? native.core.AtomResetInstruction instruction)
                        (instance? native.core.AtomCompareExchangeInstruction
                          instruction)
                        (instance? native.core.AtomSwapInstruction instruction))
                      (epoch-mark-ids current
                        (conj (core/instruction-ssa-refs instruction)
                          (core/instruction-result-id instruction)))

                      (instance? native.core.CallInstruction instruction)
                      (epoch-mark-ids current
                        (core/callinstruction-arguments instruction))

                      (instance? native.core.ExternCallInstruction instruction)
                      (epoch-mark-ids current
                        (core/externcallinstruction-arguments instruction))

                      :else current)))))
            (with-terminators (Map String Bool))
            (loop [(position Int) 0
                   (terminators (Vec core/Terminator))
                   (core/basicblock-terminators block)
                   (current (Map String Bool)) with-instructions]
              (if (>= position (count terminators))
                current
                (let [(terminator core/Terminator) (nth terminators position)]
                  (recur (+ position 1) terminators
                    (cond
                      (instance? native.core.ReturnTerminator terminator)
                      (let [(value (U core/NativeId Nil))
                            (core/returnterminator-value terminator)]
                        (if (nil? value)
                          current
                          (epoch-mark-ids current [value])))
                      (instance? native.core.TrapTerminator terminator)
                      (epoch-mark-ids current
                        [(core/trapterminator-failure-id terminator)])
                      :else current)))))]
        (recur (+ block-position 1) blocks with-terminators)))))

(defn epoch-flow-arguments
  [(function core/FunctionDef)
   (marks (Map String Bool))
   (target-id core/NativeId)
   (arguments (Vec core/NativeId))]
  (Map String Bool)
  (let [(target (U core/BasicBlock Nil))
        (find-block-with-id (core/functiondef-blocks function) target-id)]
    (if (nil? target)
      marks
      (let [(parameters (Vec core/Parameter))
            (core/basicblock-parameters target)]
        (loop [(position Int) 0 (current (Map String Bool)) marks]
          (if (or (>= position (count parameters))
                (>= position (count arguments)))
            current
            (recur (+ position 1)
              (if (epoch-marked? current
                    (core/parameter-id (nth parameters position)))
                (epoch-mark-ids current [(nth arguments position)])
                current))))))))

(defn epoch-escape-pass
  [(function core/FunctionDef) (marks (Map String Bool))] (Map String Bool)
  (loop [(block-position Int) 0
         (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
         (current (Map String Bool)) marks]
    (if (>= block-position (count blocks))
      current
      (let [(block core/BasicBlock) (nth blocks block-position)
            (with-instructions (Map String Bool))
            (loop [(position Int) 0
                   (instructions (Vec core/Instruction))
                   (core/basicblock-instructions block)
                   (inner (Map String Bool)) current]
              (if (>= position (count instructions))
                inner
                (let [(instruction core/Instruction) (nth instructions position)]
                  (recur (+ position 1) instructions
                    ;; promote is the one copying barrier in the walk: what
                    ;; leaves the frame is the copy, so the source keeps its
                    ;; own escape status and stays eligible for an epoch.
                    (if (and (epoch-marked? inner
                               (core/instruction-result-id instruction))
                          (not (instance? native.core.PromoteInstructionV0
                                 instruction)))
                      (epoch-mark-ids inner
                        (core/instruction-ssa-refs instruction))
                      inner)))))
            (with-terminators (Map String Bool))
            (loop [(position Int) 0
                   (terminators (Vec core/Terminator))
                   (core/basicblock-terminators block)
                   (inner (Map String Bool)) with-instructions]
              (if (>= position (count terminators))
                inner
                (let [(terminator core/Terminator) (nth terminators position)]
                  (recur (+ position 1) terminators
                    (cond
                      (instance? native.core.JumpTerminator terminator)
                      (epoch-flow-arguments function inner
                        (core/jumpterminator-block-id terminator)
                        (core/jumpterminator-arguments terminator))
                      (instance? native.core.SwitchTerminator terminator)
                      (loop [(case-position Int) 0
                             (cases (Vec core/SwitchCaseV0))
                             (core/switchterminator-cases terminator)
                             (case-marks (Map String Bool)) inner]
                        (if (>= case-position (count cases))
                          case-marks
                          (let [(switch-case core/SwitchCaseV0)
                                (nth cases case-position)]
                            (recur (+ case-position 1) cases
                              (epoch-flow-arguments function case-marks
                                (core/switchcasev0-block-id switch-case)
                                (core/switchcasev0-arguments switch-case))))))
                      :else inner)))))]
        (recur (+ block-position 1) blocks with-terminators)))))

;; Marks only grow, so the closure is a monotone fixpoint over a finite set.
(defn function-escape-set [(function core/FunctionDef)] (Map String Bool)
  (loop [(marks (Map String Bool)) (epoch-escape-seeds function)]
    (let [(next (Map String Bool)) (epoch-escape-pass function marks)]
      (if (= (count next) (count marks))
        next
        (recur next)))))

;; --- Rule E3, caller ownership. A function is EPOCH-SAFE when nothing it
;; allocates through the arena it was handed outlives the call: no allocating
;; instruction naming that arena has its result in the function's escape set,
;; and every region-declaring callee is itself epoch-safe. A caller may then
;; pass such a callee one of ITS epoch arenas instead of the root — which is
;; the whole content of the caller-arena generalization, and the reason the
;; arena is a per-call operand rather than a per-function singleton.
;;
;; The fixpoint decreases from "all safe": a call-graph cycle whose members are
;; each locally safe is safe, because local safety says a frame's allocations
;; never leave that frame, which composes over any call depth including cyclic
;; ones. Nothing here needs the missing-summary default, because a missing
;; callee (an id no FunctionDef in the program owns) is simply not safe.
(defn function-callee-ids [(function core/FunctionDef)] (Vec core/NativeId)
  (loop [(block-position Int) 0
         (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
         (collected (Vec core/NativeId)) []]
    (if (>= block-position (count blocks))
      collected
      (recur (+ block-position 1) blocks
        (loop [(position Int) 0
               (instructions (Vec core/Instruction))
               (core/basicblock-instructions (nth blocks block-position))
               (inner (Vec core/NativeId)) collected]
          (if (>= position (count instructions))
            inner
            (let [(instruction core/Instruction) (nth instructions position)]
              (recur (+ position 1) instructions
                (if (instance? native.core.CallInstruction instruction)
                  (conj inner (core/callinstruction-function-id instruction))
                  inner)))))))))

(defn function-allocations-die-locally?
  [(function core/FunctionDef) (escaped (Map String Bool))] Bool
  (every?
    (fn [(block core/BasicBlock)] Bool
      (every?
        (fn [(instruction core/Instruction)] Bool
          (or (not (allocating-instruction? instruction))
            (not (epoch-marked? escaped
                   (core/instruction-result-id instruction)))))
        (core/basicblock-instructions block)))
    (core/functiondef-blocks function)))

(defn epoch-safe-locally? [(function core/FunctionDef)] Bool
  (function-allocations-die-locally? function (function-escape-set function)))

(defn find-function-by-id
  [(functions (Vec core/FunctionDef))
   (target core/NativeId)]
  (U core/FunctionDef Nil)
  (loop [(position Int) 0]
    (cond
      (>= position (count functions)) nil
      (same-id? (core/functiondef-id (nth functions position)) target)
      (nth functions position)
      :else (recur (+ position 1)))))

(defn epoch-safe-pass
  [(functions (Vec core/FunctionDef))
   (safe (Map String Bool))]
  (Map String Bool)
  (loop [(position Int) 0 (current (Map String Bool)) safe]
    (if (>= position (count functions))
      current
      (let [(function core/FunctionDef) (nth functions position)
            (key String) (id-value (core/functiondef-id function))]
        (recur (+ position 1)
          (if (not (= true (get current key)))
            current
            (let [(callees (Vec core/NativeId)) (function-callee-ids function)
                  (callees-safe Bool)
                  (every?
                    (fn [(callee-id core/NativeId)] Bool
                      (let [(callee (U core/FunctionDef Nil))
                            (find-function-by-id functions callee-id)]
                        (or (nil? callee)
                          (= 0 (count (core/functiondef-regions callee)))
                          (= true (get current (id-value callee-id))))))
                    callees)]
              (if callees-safe current (assoc current key false)))))))))

(defn epoch-safe-functions
  [(functions (Vec core/FunctionDef))] (Map String Bool)
  (loop [(safe (Map String Bool))
         (loop [(position Int) 0 (seeded (Map String Bool)) {}]
           (if (>= position (count functions))
             seeded
             (recur (+ position 1)
               (assoc seeded
                 (id-value (core/functiondef-id (nth functions position)))
                 (epoch-safe-locally? (nth functions position))))))
         (budget Int) (+ 1 (count functions))]
    (let [(next (Map String Bool)) (epoch-safe-pass functions safe)]
      (if (or (= next safe) (<= budget 0))
        next
        (recur next (- budget 1))))))

;; Retargetable: an allocating instruction or redirectable call with an arena
;; SSA operand, wherever the instruction family keeps it — top level, or
;; nested inside a text-builtin or codec operation record
;; (obligations/instruction-arena-operand resolves both). Atom cells stay
;; pinned to the root (TODO-EPOCH-ATOM-STORE), and an allocation with no
;; arena operand at any level addresses its region directly, so the stage has
;; nothing to redirect and keeps the parent epoch
;; (TODO-EPOCH-NO-ARENA-OPERAND). A promote is excluded on different grounds:
;; its arena operand is the DESTINATION the author asked for, not a site with
;; an open choice.
(defn epoch-retargetable? [(instruction core/Instruction)] Bool
  (and (or (allocating-instruction? instruction)
         (instance? native.core.CallInstruction instruction))
    (not (instance? native.core.AtomCreateInstruction instruction))
    (not (instance? native.core.PromoteInstructionV0 instruction))
    (some? (obligations/instruction-arena-operand instruction))))

(defn retarget-text-builtin-arena
  [(operation core/TextBuiltinOpV0)
   (epoch-arena core/NativeId)]
  core/TextBuiltinOpV0
  (cond
    (instance? native.core.TextTrimV0 operation)
    (core/->TextTrimV0 epoch-arena (core/texttrimv0-source-id operation))
    (instance? native.core.TextLowerV0 operation)
    (core/->TextLowerV0 epoch-arena (core/textlowerv0-source-id operation))
    (instance? native.core.TextLetterDecimalRunsV0 operation)
    (core/->TextLetterDecimalRunsV0 epoch-arena
      (core/textletterdecimalrunsv0-source-id operation)
      (core/textletterdecimalrunsv0-pattern-id operation))
    (instance? native.core.TextRegexReplaceV0 operation)
    (core/->TextRegexReplaceV0 epoch-arena
      (core/textregexreplacev0-source-id operation)
      (core/textregexreplacev0-pattern-id operation)
      (core/textregexreplacev0-replacement-id operation))
    (instance? native.core.TextRegexFindV0 operation)
    (core/->TextRegexFindV0 epoch-arena
      (core/textregexfindv0-source-id operation)
      (core/textregexfindv0-pattern-id operation))
    (instance? native.core.TextSplitV0 operation)
    (core/->TextSplitV0 epoch-arena
      (core/textsplitv0-source-id operation)
      (core/textsplitv0-pattern-id operation))
    (instance? native.core.TextVectorTrimV0 operation)
    (core/->TextVectorTrimV0 epoch-arena
      (core/textvectortrimv0-source-id operation))
    (instance? native.core.TextVectorRemoveBlankV0 operation)
    (core/->TextVectorRemoveBlankV0 epoch-arena
      (core/textvectorremoveblankv0-source-id operation))
    (instance? native.core.TextJoinV0 operation)
    (core/->TextJoinV0 epoch-arena
      (core/textjoinv0-separator-id operation)
      (core/textjoinv0-source-id operation))
    (instance? native.core.TextRepeatV0 operation)
    (core/->TextRepeatV0 epoch-arena
      (core/textrepeatv0-source-id operation)
      (core/textrepeatv0-count-id operation))
    :else operation))

(defn retarget-codec-primitive-arena
  [(operation core/CodecPrimitiveOpV0)
   (epoch-arena core/NativeId)]
  core/CodecPrimitiveOpV0
  (cond
    (instance? native.core.Utf8EncodeV0 operation)
    (core/->Utf8EncodeV0 epoch-arena (core/utf8encodev0-source-id operation))
    (instance? native.core.Utf8DecodeV0 operation)
    (core/->Utf8DecodeV0 epoch-arena (core/utf8decodev0-source-id operation))
    (instance? native.core.Utf8DecodeSourceV0 operation)
    (core/->Utf8DecodeSourceV0 epoch-arena
      (core/utf8decodesourcev0-source-id operation))
    (instance? native.core.NativeBytesFromIntsBoundedV0 operation)
    (core/->NativeBytesFromIntsBoundedV0 epoch-arena
      (core/nativebytesfromintsboundedv0-source-id operation)
      (core/nativebytesfromintsboundedv0-max-bytes-id operation))
    (instance? native.core.Sha256BytesV0 operation)
    (core/->Sha256BytesV0 epoch-arena (core/sha256bytesv0-source-id operation))
    :else operation))

(defn retarget-arena-operand
  [(instruction core/Instruction) (epoch-arena core/NativeId)] core/Instruction
  (cond
    (instance? native.core.CallInstruction instruction)
    (core/->CallInstruction
      (core/callinstruction-result instruction)
      (core/callinstruction-function-id instruction)
      (core/callinstruction-arguments instruction)
      epoch-arena
      (core/callinstruction-tokens instruction))

    (instance? native.core.RecordAssocInstructionV0 instruction)
    (core/->RecordAssocInstructionV0
      (core/recordassocinstructionv0-result instruction)
      (core/recordassocinstructionv0-source-id instruction)
      (core/recordassocinstructionv0-field-id instruction)
      (core/recordassocinstructionv0-value-id instruction)
      epoch-arena)
    (instance? native.core.BoxRecordInstruction instruction)
    (core/->BoxRecordInstruction
      (core/boxrecordinstruction-result instruction)
      (core/boxrecordinstruction-source-id instruction)
      epoch-arena)
    (instance? native.core.VecAssocInstructionV0 instruction)
    (core/->VecAssocInstructionV0
      (core/vecassocinstructionv0-result instruction)
      (core/vecassocinstructionv0-source-id instruction)
      (core/vecassocinstructionv0-index-id instruction)
      (core/vecassocinstructionv0-value-id instruction)
      epoch-arena)
    (instance? native.core.VecPushInstruction instruction)
    (core/->VecPushInstruction
      (core/vecpushinstruction-result instruction)
      (core/vecpushinstruction-source-id instruction)
      (core/vecpushinstruction-value-id instruction)
      epoch-arena)
    (instance? native.core.VecEmptyInstruction instruction)
    (core/->VecEmptyInstruction
      (core/vecemptyinstruction-result instruction)
      (core/vecemptyinstruction-capacity-id instruction)
      epoch-arena)
    (instance? native.core.VecConcatInstruction instruction)
    (core/->VecConcatInstruction
      (core/vecconcatinstruction-result instruction)
      (core/vecconcatinstruction-left-id instruction)
      (core/vecconcatinstruction-right-id instruction)
      epoch-arena)
    (instance? native.core.VecSliceInstructionV0 instruction)
    (core/->VecSliceInstructionV0
      (core/vecsliceinstructionv0-result instruction)
      (core/vecsliceinstructionv0-source-id instruction)
      (core/vecsliceinstructionv0-start-id instruction)
      (core/vecsliceinstructionv0-end-id instruction)
      epoch-arena)
    (instance? native.core.VecReverseInstructionV0 instruction)
    (core/->VecReverseInstructionV0
      (core/vecreverseinstructionv0-result instruction)
      (core/vecreverseinstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.ByteSourceSliceInstructionV0 instruction)
    (core/->ByteSourceSliceInstructionV0
      (core/bytesourcesliceinstructionv0-result instruction)
      (core/bytesourcesliceinstructionv0-source-id instruction)
      (core/bytesourcesliceinstructionv0-start-id instruction)
      (core/bytesourcesliceinstructionv0-end-id instruction)
      epoch-arena)
    (instance? native.core.VecSortInstructionV0 instruction)
    (core/->VecSortInstructionV0
      (core/vecsortinstructionv0-result instruction)
      (core/vecsortinstructionv0-source-id instruction)
      epoch-arena
      (core/vecsortinstructionv0-element-type instruction))
    (instance? native.core.MapLiteralInstructionV0 instruction)
    (core/->MapLiteralInstructionV0
      (core/mapliteralinstructionv0-result instruction)
      (core/mapliteralinstructionv0-key-ids instruction)
      (core/mapliteralinstructionv0-value-ids instruction)
      epoch-arena
      (core/mapliteralinstructionv0-key-equality instruction))
    (instance? native.core.SetLiteralInstructionV0 instruction)
    (core/->SetLiteralInstructionV0
      (core/setliteralinstructionv0-result instruction)
      (core/setliteralinstructionv0-value-ids instruction)
      epoch-arena
      (core/setliteralinstructionv0-element-equality instruction))
    (instance? native.core.MapAssocInstructionV0 instruction)
    (core/->MapAssocInstructionV0
      (core/mapassocinstructionv0-result instruction)
      (core/mapassocinstructionv0-source-id instruction)
      (core/mapassocinstructionv0-key-id instruction)
      (core/mapassocinstructionv0-value-id instruction)
      epoch-arena
      (core/mapassocinstructionv0-key-equality instruction))
    (instance? native.core.MapDissocInstructionV0 instruction)
    (core/->MapDissocInstructionV0
      (core/mapdissocinstructionv0-result instruction)
      (core/mapdissocinstructionv0-source-id instruction)
      (core/mapdissocinstructionv0-key-id instruction)
      epoch-arena
      (core/mapdissocinstructionv0-key-equality instruction))
    (instance? native.core.MapKeysInstructionV0 instruction)
    (core/->MapKeysInstructionV0
      (core/mapkeysinstructionv0-result instruction)
      (core/mapkeysinstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.MapValuesInstructionV0 instruction)
    (core/->MapValuesInstructionV0
      (core/mapvaluesinstructionv0-result instruction)
      (core/mapvaluesinstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.SetConjInstructionV0 instruction)
    (core/->SetConjInstructionV0
      (core/setconjinstructionv0-result instruction)
      (core/setconjinstructionv0-source-id instruction)
      (core/setconjinstructionv0-value-id instruction)
      epoch-arena
      (core/setconjinstructionv0-element-equality instruction))
    (instance? native.core.SetDisjInstructionV0 instruction)
    (core/->SetDisjInstructionV0
      (core/setdisjinstructionv0-result instruction)
      (core/setdisjinstructionv0-source-id instruction)
      (core/setdisjinstructionv0-value-id instruction)
      epoch-arena
      (core/setdisjinstructionv0-element-equality instruction))
    (instance? native.core.SetVectorInstructionV0 instruction)
    (core/->SetVectorInstructionV0
      (core/setvectorinstructionv0-result instruction)
      (core/setvectorinstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.CollectionTransientOpenInstructionV0 instruction)
    (core/->CollectionTransientOpenInstructionV0
      (core/collectiontransientopeninstructionv0-result instruction)
      (core/collectiontransientopeninstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.CollectionPersistentCloseInstructionV0 instruction)
    (core/->CollectionPersistentCloseInstructionV0
      (core/collectionpersistentcloseinstructionv0-result instruction)
      (core/collectionpersistentcloseinstructionv0-source-id instruction)
      epoch-arena)
    (instance? native.core.TransientMapAssocInstructionV0 instruction)
    (core/->TransientMapAssocInstructionV0
      (core/transientmapassocinstructionv0-result instruction)
      (core/transientmapassocinstructionv0-source-id instruction)
      (core/transientmapassocinstructionv0-key-id instruction)
      (core/transientmapassocinstructionv0-value-id instruction)
      epoch-arena
      (core/transientmapassocinstructionv0-key-equality instruction))
    (instance? native.core.TransientSetConjInstructionV0 instruction)
    (core/->TransientSetConjInstructionV0
      (core/transientsetconjinstructionv0-result instruction)
      (core/transientsetconjinstructionv0-source-id instruction)
      (core/transientsetconjinstructionv0-value-id instruction)
      epoch-arena
      (core/transientsetconjinstructionv0-element-equality instruction))
    (instance? native.core.TransientVecPushInstructionV0 instruction)
    (core/->TransientVecPushInstructionV0
      (core/transientvecpushinstructionv0-result instruction)
      (core/transientvecpushinstructionv0-source-id instruction)
      (core/transientvecpushinstructionv0-value-id instruction)
      (core/transientvecpushinstructionv0-element-type instruction))
    (instance? native.core.TextSliceInstruction instruction)
    (core/->TextSliceInstruction
      (core/textsliceinstruction-result instruction)
      epoch-arena
      (core/textsliceinstruction-source-id instruction)
      (core/textsliceinstruction-start-id instruction)
      (core/textsliceinstruction-end-id instruction)
      (core/textsliceinstruction-failure-code instruction))
    (instance? native.core.TextConcatInstruction instruction)
    (core/->TextConcatInstruction
      (core/textconcatinstruction-result instruction)
      epoch-arena
      (core/textconcatinstruction-operand-ids instruction))
    (instance? native.core.ValueToTextInstructionV0 instruction)
    (core/->ValueToTextInstructionV0
      (core/valuetotextinstructionv0-result instruction)
      (core/valuetotextinstructionv0-mode instruction)
      (core/valuetotextinstructionv0-domain-type instruction)
      (core/valuetotextinstructionv0-value-id instruction)
      epoch-arena)
    (instance? native.core.TextBuiltinInstruction instruction)
    (core/->TextBuiltinInstruction
      (core/textbuiltininstruction-result instruction)
      (retarget-text-builtin-arena
        (core/textbuiltininstruction-builtin instruction) epoch-arena))
    (instance? native.core.CodecPrimitiveInstructionV0 instruction)
    (core/->CodecPrimitiveInstructionV0
      (core/codecprimitiveinstructionv0-result instruction)
      (retarget-codec-primitive-arena
        (core/codecprimitiveinstructionv0-operation instruction) epoch-arena))
    :else instruction))

(defrecord EpochRootArenaV0
  [(value-id core/NativeId)
   (region core/NativeId)
   (capability core/NativeId)
   (arena-type core/NativeId)])

(defn entry-arena-instruction
  [(function core/FunctionDef)] (U EpochRootArenaV0 Nil)
  (let [(entry (U core/BasicBlock Nil))
        (find-block-with-id (core/functiondef-blocks function)
          (core/functiondef-entry-block function))]
    (if (nil? entry)
      nil
      (loop [(position Int) 0
             (instructions (Vec core/Instruction))
             (core/basicblock-instructions entry)]
        (if (>= position (count instructions))
          nil
          (let [(instruction core/Instruction) (nth instructions position)]
            (if (instance? native.core.ArenaInstruction instruction)
              (->EpochRootArenaV0
                (core/instruction-result-id instruction)
                (core/arenainstruction-region instruction)
                (core/arenainstruction-capability instruction)
                (core/ssavaluev0-type-id
                  (core/arenainstruction-result instruction)))
              (recur (+ position 1) instructions))))))))

(defn exit-block? [(block core/BasicBlock)] Bool
  (and (= 1 (count (core/basicblock-terminators block)))
    (let [(terminator core/Terminator) (nth (core/basicblock-terminators block) 0)]
      (or (instance? native.core.ReturnTerminator terminator)
        (instance? native.core.TrapTerminator terminator)))))

(defrecord EpochRewriteV0
  [(function core/FunctionDef)
   (regions (Vec core/RegionDef))
   (effects (Vec core/EffectDef))
   (pendings (Vec String))])

(defn optional-same-id? [(candidate Any) (target core/NativeId)] Bool
  (and (some? candidate) (= (get candidate :value "") (id-value target))))

(defn epoch-pending-detail
  [(code String)
   (function core/FunctionDef)
   (instruction core/Instruction)]
  String
  (str code ": " (id-value (core/instruction-result-id instruction))
    " keeps the parent epoch in " (id-value (core/functiondef-id function))))

(defn function-uses-buffer-v0? [(function core/FunctionDef)] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (or
                (instance? native.core.BufferAllocateInstructionV0 instruction)
                (or
                  (instance? native.core.BufferLengthInstructionV0 instruction)
                  (or
                    (instance? native.core.BufferGetCheckedInstructionV0 instruction)
                    (or (instance? native.core.BufferSetCheckedInstructionV0
                          instruction)
                      (or (instance? native.core.TiledStepF64InstructionV0
                            instruction)
                        (instance? native.core.F64BufferSumInstructionV0
                          instruction)))))))
            (core/basicblock-instructions block))))
      (core/functiondef-blocks function))))

;; A Buffer handle is bound to the durable root arena that created it. Because
;; every internal call forwards its current arena unless the epoch stage
;; redirects that call, this requirement propagates through callers: a frame
;; with no direct Buffer instruction still requires the root when one of its
;; callees uses a Buffer.
(defn root-arena-required-pass
  [(functions (Vec core/FunctionDef))
   (required (Map String Bool))]
  (Map String Bool)
  (loop [(position Int) 0 (current (Map String Bool)) required]
    (if (>= position (count functions))
      current
      (let [(function core/FunctionDef) (nth functions position)
            (key String) (id-value (core/functiondef-id function))]
        (recur (+ position 1)
          (if (= true (get current key))
            current
            (if (some?
                  (some
                    (fn [(callee-id core/NativeId)] Bool
                      (= true (get current (id-value callee-id))))
                    (function-callee-ids function)))
              (assoc current key true)
              current)))))))

(defn root-arena-required-functions
  [(functions (Vec core/FunctionDef))] (Map String Bool)
  (loop [(required (Map String Bool))
         (loop [(position Int) 0 (seeded (Map String Bool)) {}]
           (if (>= position (count functions))
             seeded
             (let [(function core/FunctionDef) (nth functions position)]
               (recur (+ position 1)
                 (assoc seeded
                   (id-value (core/functiondef-id function))
                   (function-uses-buffer-v0? function))))))]
    (let [(next (Map String Bool))
          (root-arena-required-pass functions required)]
      (if (= next required) next (recur next)))))

;; An epoch-safe callee that declares a region may take one of the caller's
;; epoch arenas: its allocations then die at that epoch's close. The call's own
;; result must stay interior too — a call whose value leaves the function keeps
;; the root arena, so obligation 8 has nothing to refuse.
(defn epoch-redirectable-call?
  [(instruction core/Instruction)
   (functions (Vec core/FunctionDef))
   (safe (Map String Bool))
   (root-required (Map String Bool))]
  Bool
  (and (instance? native.core.CallInstruction instruction)
    (let [(callee (U core/FunctionDef Nil))
          (find-function-by-id functions
            (core/callinstruction-function-id instruction))]
      (and (some? callee)
        (> (count (core/functiondef-regions callee)) 0)
        ;; Buffer v0's explicit ownership contract is root-only. Redirecting a
        ;; direct or transitive Buffer user's arena to a child epoch would make
        ;; the runtime handle disagree with its frozen region/capability
        ;; operands.
        (not (= true
               (get root-required
                 (id-value (core/functiondef-id callee)))))
        (= true
          (get safe
            (id-value
              (core/functiondef-id callee))))))))

(defn epoch-rewrite-function
  [(function core/FunctionDef)
   (functions (Vec core/FunctionDef))
   (safe (Map String Bool))
   (root-required (Map String Bool))]
  EpochRewriteV0
  (let [(root-arena (U EpochRootArenaV0 Nil)) (entry-arena-instruction function)]
    (if (nil? root-arena)
      (->EpochRewriteV0 function [] [] [])
      (let [(root-arena-value core/NativeId)
            (epochrootarenav0-value-id root-arena)
            (escaped (Map String Bool)) (function-escape-set function)
            (function-id core/NativeId) (core/functiondef-id function)
            (interior (Vec core/Instruction))
            (loop [(block-position Int) 0
                   (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
                   (collected (Vec core/Instruction)) []]
              (if (>= block-position (count blocks))
                collected
                (recur (+ block-position 1) blocks
                  (loop [(position Int) 0
                         (instructions (Vec core/Instruction))
                         (core/basicblock-instructions (nth blocks block-position))
                         (inner (Vec core/Instruction)) collected]
                    (if (>= position (count instructions))
                      inner
                      (let [(instruction core/Instruction) (nth instructions position)]
                        (recur (+ position 1) instructions
                          (if (and
                                (or (allocating-instruction? instruction)
                                  (epoch-redirectable-call? instruction
                                    functions safe root-required))
                                ;; A promote already names the epoch it wants,
                                ;; so it is never a reason to mint one.
                                (not (instance? native.core.PromoteInstructionV0
                                       instruction))
                                (not (epoch-marked? escaped
                                       (core/instruction-result-id instruction))))
                            (conj inner instruction)
                            inner))))))))
            (pendings (Vec String))
            (loop [(position Int) 0 (collected (Vec String)) []]
              (if (>= position (count interior))
                collected
                (let [(instruction core/Instruction) (nth interior position)]
                  (recur (+ position 1)
                    (cond
                      (instance? native.core.AtomCreateInstruction instruction)
                      (conj collected
                        (epoch-pending-detail "TODO-EPOCH-ATOM-STORE" function
                          instruction))
                      (not (epoch-retargetable? instruction))
                      (conj collected
                        (epoch-pending-detail "TODO-EPOCH-NO-ARENA-OPERAND"
                          function instruction))
                      (not (optional-same-id?
                             (obligations/instruction-arena-operand instruction)
                             root-arena-value))
                      (conj collected
                        (epoch-pending-detail "TODO-EPOCH-AMBIGUOUS-ESCAPE"
                          function instruction))
                      :else collected)))))
            (retarget (Map String Bool))
            (loop [(position Int) 0 (marked (Map String Bool)) {}]
              (if (>= position (count interior))
                marked
                (let [(instruction core/Instruction) (nth interior position)]
                  (recur (+ position 1)
                    (if (and (epoch-retargetable? instruction)
                          (optional-same-id?
                            (obligations/instruction-arena-operand instruction)
                            root-arena-value))
                      (assoc marked
                        (id-value (core/instruction-result-id instruction))
                        true)
                      marked)))))]
        (if (= 0 (count retarget))
          (->EpochRewriteV0 function [] [] pendings)
          (let [(region-id core/NativeId)
                (lower-id "region" ["epoch" (id-value function-id) "0"])
                (effect-id core/NativeId)
                (lower-id "effect" ["epoch" (id-value function-id) "0"])
                (epoch-arena core/NativeId)
                (lower-id "epoch-arena" [(id-value function-id) "0"])
                (token-id core/NativeId)
                (lower-id "epoch-token" [(id-value function-id) "0"])
                (arena-type core/NativeId)
                (epochrootarenav0-arena-type root-arena)
                (open core/Instruction)
                (core/->ArenaInstruction
                  (core/->SsaValueV0 epoch-arena arena-type)
                  region-id
                  (epochrootarenav0-capability root-arena)
                  (core/->TokenFlowV0 [region-id]
                    [(core/->ResourceTokenV0 token-id
                       (core/->RegionTokenV0 region-id))]))
                (entry-id core/NativeId) (core/functiondef-entry-block function)
                (blocks (Vec core/BasicBlock))
                (mapv
                  (fn [(block core/BasicBlock)] core/BasicBlock
                    (let [(retargeted (Vec core/Instruction))
                          (mapv
                            (fn
                              [(instruction core/Instruction)] core/Instruction
                              (if (= true
                                    (get retarget
                                      (id-value
                                        (core/instruction-result-id instruction))))
                                (retarget-arena-operand instruction epoch-arena)
                                instruction))
                            (core/basicblock-instructions block))
                          (with-open (Vec core/Instruction))
                          (if (same-id? (core/basicblock-id block) entry-id)
                            (loop [(position Int) 0
                                   (rebuilt (Vec core/Instruction)) []]
                              (if (>= position (count retargeted))
                                rebuilt
                                (let [(instruction core/Instruction)
                                      (nth retargeted position)]
                                  (recur (+ position 1)
                                    (if (same-id?
                                          (core/instruction-result-id instruction)
                                          root-arena-value)
                                      (conj (conj rebuilt instruction) open)
                                      (conj rebuilt instruction))))))
                            retargeted)
                          (with-close (Vec core/Instruction))
                          (if (exit-block? block)
                            (conj with-open
                              (core/->ArenaCloseInstructionV0
                                (core/->SsaValueV0
                                  (lower-id "epoch-close"
                                    [(id-value function-id) "0"
                                     (id-value (core/basicblock-id block))])
                                  arena-type)
                                epoch-arena
                                (core/->TokenFlowV0 [token-id] [])))
                            with-open)]
                      (with block [:instructions with-close])))
                  (core/functiondef-blocks function))]
            (->EpochRewriteV0
              (with function
                [:blocks blocks]
                [:regions (conj (core/functiondef-regions function) region-id)]
                [:effects (conj (core/functiondef-effects function) effect-id)])
              [(core/->RegionDef region-id (core/->ArenaRegion true)
                 (epochrootarenav0-region root-arena))]
              [(core/->EffectDef effect-id (core/->AllocateEffect region-id))]
              pendings)))))))

;; The no-op promote. Once the assignment is known, a promote whose source
;; already outlives its destination arena is a plain copy — the same test
;; obligation 8 uses for every other write, run for its answer instead of its
;; verdict. Under identity assignment nothing is younger than the root, so
;; every promote collapses and the seam stays a relabelling even for a program
;; that wrote the surface form.
(defn promote-noop?
  [(regions (Vec core/RegionDef))
   (function core/FunctionDef)
   (epochs (Map String core/NativeId))
   (source-id core/NativeId)
   (arena-id core/NativeId)]
  Bool
  (obligations/epoch-write-legal? regions
    (obligations/epoch-of epochs source-id)
    (obligations/function-arena-region function arena-id)))

(defn epoch-collapse-promotes
  [(regions (Vec core/RegionDef))
   (types (Vec core/TypeDef))
   (function core/FunctionDef)]
  core/FunctionDef
  (let [(result obligations/EpochMapResultV0)
        (obligations/function-epoch-map regions types function)]
    (if (not (obligations/epochmapresultv0-converged result))
      function
      (let [(epochs (Map String core/NativeId))
            (obligations/epochmapresultv0-epochs result)]
        (with function
          [:blocks
           (mapv
             (fn [(block core/BasicBlock)] core/BasicBlock
               (with block
                 [:instructions
                  (mapv
                    (fn [(instruction core/Instruction)] core/Instruction
                      (if (instance? native.core.PromoteInstructionV0
                            instruction)
                        (if (promote-noop? regions function epochs
                              (core/promoteinstructionv0-source-id instruction)
                              (core/promoteinstructionv0-arena-id instruction))
                          (core/->CopyInstruction
                            (core/promoteinstructionv0-result instruction)
                            (core/promoteinstructionv0-source-id instruction))
                          instruction)
                        instruction))
                    (core/basicblock-instructions block))]))
             (core/functiondef-blocks function))])))))

(defn epoch-receipt-obligations
  [(digest String)
   (verdicts (Vec obligations/ObligationVerdictV0))]
  (Vec core/ReceiptObligationV0)
  (let [(codes (Vec core/ObligationCode))
        [(core/->ValidSsaObligation true)
         (core/->ExhaustiveMatchesObligation true)
         (core/->ClosedLayoutsObligation true)
         (core/->CheckedOperationsObligation true)
         (core/->LegalAbiObligation true)
         (core/->DischargedTokensObligation true)
         (core/->BoundedEffectsObligation true)
         (core/->EpochSoundnessObligation true)
         (core/->LeakFreedomObligation true)
         (core/->DeterministicParallelismObligationV0 true)]]
    (loop [(position Int) 0 (rows (Vec core/ReceiptObligationV0)) []]
      (if (or (>= position (count verdicts)) (>= position (count codes)))
        rows
        (recur (+ position 1)
          (conj rows
            (core/->ReceiptObligationV0
              (nth codes position) "v0" digest
              (obligations/obligation-passed? (nth verdicts position))
              (str "epoch-stage obligation "
                (obligations/verdict-tag (nth verdicts position))))))))))

(defn epoch-pending-obligations
  [(digest String) (pendings (Vec String))] (Vec core/ReceiptObligationV0)
  (mapv
    (fn [(detail String)] core/ReceiptObligationV0
      (core/->ReceiptObligationV0
        (core/->EpochSoundnessObligation true) "v0" digest false detail))
    pendings))

(defn epoch-assign-function
  [(assignment EpochAssignmentV0)
   (function core/FunctionDef)
   (functions (Vec core/FunctionDef))
   (safe (Map String Bool))
   (root-required (Map String Bool))]
  EpochRewriteV0
  (match assignment
    [(EpochIdentityV0 token) (->EpochRewriteV0 function [] [] [])]
    [(EpochDerivedV0 token)
     (epoch-rewrite-function function functions safe root-required)]))

(defn lower-epoch-stage
  [(frozen-native stages/FrozenNativeStageV0)
   (compiler-commit String)
   (configuration (Vec String))
   (abi core/AbiProfileV0)
   (assignment EpochAssignmentV0)]
  EpochLoweringResultV0
  (let [(stage stages/NativeStageV0)
        (stages/frozennativestagev0-stage frozen-native)
        (input-digest String) (stages/frozennativestagev0-digest frozen-native)
        (program core/NativeCoreProgram) (stages/nativestagev0-program stage)
        (safe (Map String Bool))
        (epoch-safe-functions (core/nativecoreprogram-functions program))
        (root-required (Map String Bool))
        (root-arena-required-functions
          (core/nativecoreprogram-functions program))
        (rewrites (Vec EpochRewriteV0))
        (mapv
          (fn [(function core/FunctionDef)] EpochRewriteV0
            (epoch-assign-function assignment function
              (core/nativecoreprogram-functions program) safe root-required))
          (core/nativecoreprogram-functions program))
        (functions (Vec core/FunctionDef))
        (mapv
          (fn [(rewrite EpochRewriteV0)] core/FunctionDef
            (epochrewritev0-function rewrite))
          rewrites)
        (minted-regions (Vec core/RegionDef))
        (loop [(position Int) 0 (collected (Vec core/RegionDef)) []]
          (if (>= position (count rewrites))
            collected
            (recur (+ position 1)
              (vec (concat collected
                     (epochrewritev0-regions (nth rewrites position)))))))
        (all-regions (Vec core/RegionDef))
        (vec (concat (core/nativecoreprogram-regions program) minted-regions))
        (collapsed (Vec core/FunctionDef))
        (mapv
          (fn [(function core/FunctionDef)] core/FunctionDef
            (epoch-collapse-promotes all-regions
              (core/nativecoreprogram-types program) function))
          functions)
        (minted-effects (Vec core/EffectDef))
        (loop [(position Int) 0 (collected (Vec core/EffectDef)) []]
          (if (>= position (count rewrites))
            collected
            (recur (+ position 1)
              (vec (concat collected
                     (epochrewritev0-effects (nth rewrites position)))))))
        (pendings (Vec String))
        (loop [(position Int) 0 (collected (Vec String)) []]
          (if (>= position (count rewrites))
            collected
            (recur (+ position 1)
              (vec (concat collected
                     (epochrewritev0-pendings (nth rewrites position)))))))
        (rewritten core/NativeCoreProgram)
        (with program
          [:id (lower-id "epoch-program" [input-digest])]
          [:parent (core/nativecoreprogram-id program)]
          [:compiler-pass "native-to-epoch-v0"]
          [:functions collapsed]
          [:regions all-regions]
          [:effects (vec (concat (core/nativecoreprogram-effects program)
                           minted-effects))]
          [:allowed-regions
           (vec (concat (core/nativecoreprogram-allowed-regions program)
                  (mapv (fn [(region core/RegionDef)] core/NativeId
                          (core/regiondef-id region))
                    minted-regions)))]
          [:allowed-effects
           (vec (concat (core/nativecoreprogram-allowed-effects program)
                  (mapv (fn [(effect core/EffectDef)] core/NativeId
                          (core/effectdef-id effect))
                    minted-effects)))])
        (verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program rewritten abi)
        (nine-pass Bool) (every? obligations/obligation-passed? verdicts)
        ;; The epoch stage never invents terms: the parent stage's term graph
        ;; rides along, and the program encoding (id, parent, compiler-pass,
        ;; region tree) carries the difference into the digest.
        (next-stage stages/NativeStageV0)
        (stages/->NativeStageV0
          (stages/nativestagev0-terms stage)
          (stages/nativestagev0-typed-digest stage)
          rewritten
          (stages/nativestagev0-obligation-roots stage))
        (encoding String) (stages/encode-native-stage next-stage)
        (digest String) (stages/content-digest encoding)
        (frozen stages/FrozenNativeStageV0)
        (stages/->FrozenNativeStageV0 next-stage encoding digest)
        (pending-rows (Vec core/ReceiptObligationV0))
        (epoch-pending-obligations digest pendings)
        (receipt core/PassReceiptV0)
        (make-receipt input-digest compiler-commit "native-to-epoch"
          configuration []
          (vec (concat (epoch-receipt-obligations digest verdicts)
                 pending-rows))
          digest)]
    (if (and nine-pass (= 0 (count pending-rows)))
      (->EpochLoweringCompleteV0 frozen receipt)
      (->EpochLoweringPendingV0 frozen receipt pending-rows))))

(defn epoch-result-frozen
  [(result EpochLoweringResultV0)] stages/FrozenNativeStageV0
  (match result
    [(EpochLoweringCompleteV0 frozen receipt) frozen]
    [(EpochLoweringPendingV0 frozen receipt obligations) frozen]))

(defn epoch-result-complete? [(result EpochLoweringResultV0)] Bool
  (match result
    [(EpochLoweringCompleteV0 frozen receipt) true]
    [(EpochLoweringPendingV0 frozen receipt obligations) false]))

;; The seam every materializer crosses. A materializer never sees the native
;; stage directly: it sees what the epoch stage froze. Under identity that is
;; the same program under a new identity, which is what makes the wiring
;; provable — the emitters must produce the same bytes or the seam leaked.
(defn epoch-identity-stage
  [(frozen-native stages/FrozenNativeStageV0)
   (compiler-commit String)
   (configuration (Vec String))
   (abi core/AbiProfileV0)]
  EpochLoweringResultV0
  (lower-epoch-stage frozen-native compiler-commit configuration abi
    (->EpochIdentityV0 true)))

(defn epoch-identity-program
  [(frozen-native stages/FrozenNativeStageV0)
   (compiler-commit String)
   (configuration (Vec String))
   (abi core/AbiProfileV0)]
  core/NativeCoreProgram
  (stages/nativestagev0-program
    (stages/frozennativestagev0-stage
      (epoch-result-frozen
        (epoch-identity-stage frozen-native compiler-commit configuration
          abi)))))

;; The derived policy: §2's inference, minting an epoch wherever a function's
;; escape closure leaves interior allocations. A materializer downstream of
;; this seam must open and close minted epochs; the QBE backend does not yet,
;; so its consumers stay on the identity seam by name.
(defn epoch-derived-stage
  [(frozen-native stages/FrozenNativeStageV0)
   (compiler-commit String)
   (configuration (Vec String))
   (abi core/AbiProfileV0)]
  EpochLoweringResultV0
  (lower-epoch-stage frozen-native compiler-commit configuration abi
    (->EpochDerivedV0 true)))

(defn fixture-id [(kind String) (label String)] core/NativeId
  (lower-id "fixture" [kind label]))

(defn fixture-text-id [(value String)] core/NativeId
  (fixture-id "text" value))

(defn fixture-marker-id [(value String)] core/NativeId
  (fixture-id "marker" value))

(defn fixture-text-node [(value String)] stages/TermNodeV0
  (stages/->TermNodeV0 (fixture-text-id value) (stages/->TextTermV0 value)))

(defn fixture-marker-node [(value String)] stages/TermNodeV0
  (stages/->TermNodeV0
    (fixture-marker-id value)
    (stages/->TextTermV0 "source-node-v0")))

(defn fixture-fact-node
  [(ordinal Int)
   (subject core/NativeId)
   (predicate String)
   (object core/NativeId)]
  stages/TermNodeV0
  (stages/->TermNodeV0
    (fixture-id "fact" (str ordinal))
    (stages/->TripleTermV0 subject (fixture-text-id predicate) object)))

(defn empty-context-id [(label String)] core/NativeId
  (lower-id "empty-context-corpus" [label]))

(def empty-context-vector-id core/NativeId
  (lower-id "vector-type" [(id-value (type-id "Int"))]))

(def empty-context-map-id core/NativeId
  (lower-id "map-type-v0"
    [(id-value (type-id "Keyword")) (id-value (type-id "Int"))]))

(def empty-context-set-id core/NativeId
  (lower-id "set-type-v0" [(id-value (type-id "String"))]))

(def empty-context-vector-type core/TypeDef
  (core/->TypeDef empty-context-vector-id "Vector"
    (core/->VectorType (type-id "Int"))))

(def empty-context-map-type core/TypeDef
  (core/->TypeDef empty-context-map-id "Map"
    (core/->MapTypeV0 (type-id "Keyword") (type-id "Int")
      (core/->InsertionOrderV0 true))))

(def empty-context-set-type core/TypeDef
  (core/->TypeDef empty-context-set-id "Set"
    (core/->SetTypeV0 (type-id "String") (core/->InsertionOrderV0 true))))

(def empty-context-record-type core/TypeDef
  (core/->TypeDef (empty-context-id "record-type") "EmptyContextRecord"
    (core/->RecordType
      [(core/->TypeField (empty-context-id "record-vector-field")
         "vector" empty-context-vector-id)
       (core/->TypeField (empty-context-id "record-map-field")
         "map" empty-context-map-id)
       (core/->TypeField (empty-context-id "record-set-field")
         "set" empty-context-set-id)])))

(def empty-context-union-id core/NativeId
  (empty-context-id "collection-union"))

(def empty-context-union-type core/TypeDef
  (core/->TypeDef empty-context-union-id "CollectionUnion"
    (core/->UnionType
      [(core/->TypeVariant (empty-context-id "union-vector")
         "vector" empty-context-vector-id)
       (core/->TypeVariant (empty-context-id "union-map")
         "map" empty-context-map-id)
       (core/->TypeVariant (empty-context-id "union-set")
         "set" empty-context-set-id)])))

(def empty-context-signature TypedFunctionV0
  (->TypedFunctionV0
    (empty-context-id "signature")
    "accept-contexts"
    "accept_contexts"
    [(core/->Parameter (empty-context-id "call-vector") empty-context-vector-id)
     (core/->Parameter (empty-context-id "call-map") empty-context-map-id)
     (core/->Parameter (empty-context-id "call-set") empty-context-set-id)]
    (type-id "Int")
    (type-id "LowerFailure")
    []
    (->NativeTodoV0 "CORPUS-ONLY" "signature supplies contextual parameter types")
    ""))

(def empty-context-vector-node core/NativeId
  (empty-context-id "empty-vector"))

(def empty-context-map-node core/NativeId
  (empty-context-id "empty-map"))

(def empty-context-set-node core/NativeId
  (empty-context-id "empty-set"))

(def empty-context-vector-annotation core/NativeId
  (empty-context-id "vector-annotation"))

(def empty-context-index SourceIndexV0
  (let [(annotation-arguments core/NativeId)
        (empty-context-id "vector-annotation-arguments")
        (int-annotation core/NativeId) (empty-context-id "int-annotation")]
    (->SourceIndexV0
      9
      {(source-index-key empty-context-vector-annotation "args") annotation-arguments
       (source-index-key annotation-arguments "f0") int-annotation}
      {(source-index-key empty-context-vector-node "form-kind") "vec"
       (source-index-key empty-context-map-node "form-kind") "map"
       (source-index-key empty-context-set-node "form-kind") "set"
       (source-index-key empty-context-vector-annotation "form-kind") "type-app"
       (source-index-key empty-context-vector-annotation "name") "Vec"
       (source-index-key int-annotation "form-kind") "type-prim"
       (source-index-key int-annotation "name") "Int"}
      {} {} {} {} {} {} [])))

(def empty-context-types (Vec core/TypeDef)
  [(i64-type) (text-type) (keyword-type) (lower-failure-type)
   empty-context-vector-type empty-context-map-type empty-context-set-type
   empty-context-record-type empty-context-union-type])

(def empty-context-env BodyEnvV0
  (->BodyEnvV0 empty-context-index empty-context-types
    [empty-context-signature] [] []))

(def empty-context-owner core/NativeId
  (empty-context-id "owner"))

(defn empty-context-state [] BodyStateV0
  (->BodyStateV0 [] (empty-context-id "entry") [] [] true 0 [] "" [] [] [] nil))

(defn contextual-result-matches?
  [(result (U ExprResultV0 Nil)) (expected (U core/NativeId Nil))] Bool
  (if (or (nil? result) (nil? expected))
    false
    (and (not (state-blocked? (exprresultv0-state result)))
      (same-id? (exprresultv0-type-id result) expected))))

(defn contextual-result-failed-with?
  [(result (U ExprResultV0 Nil)) (detail String)] Bool
  (if (nil? result)
    false
    (and (state-blocked? (exprresultv0-state result))
      (= detail (bodystatev0-failure (exprresultv0-state result))))))

(defn contextual-arguments-match?
  [(constructor (U core/TypeDef Nil)) (signature (U TypedFunctionV0 Nil))] Bool
  (let [(expected (Vec core/NativeId))
        [empty-context-vector-id empty-context-map-id empty-context-set-id]]
    (loop [(position Int) 0]
      (if (>= position (count expected))
        true
        (let [(actual (U core/NativeId Nil))
              (contextual-argument-type constructor signature
                (count expected) position)]
          (if (and (some? actual) (same-id? actual (nth expected position)))
            (recur (+ position 1))
            false))))))

(defrecord EmptyCollectionContextCorpusV0
  [(annotation-vector-accepted Bool)
   (call-map-accepted Bool)
   (record-set-accepted Bool)
   (call-types-exact Bool)
   (record-types-exact Bool)
   (ambiguous-vector-rejected Bool)
   (ambiguous-map-rejected Bool)
   (ambiguous-set-rejected Bool)
   (nonexact-context-rejected Bool)
   (wrong-arity-uncontextual Bool)])

(def empty-collection-context-corpus EmptyCollectionContextCorpusV0
  (let [(annotation-expected (U core/NativeId Nil))
        (annotation-native-type empty-context-index
          empty-context-vector-annotation)
        (call-expected (U core/NativeId Nil))
        (contextual-argument-type nil empty-context-signature 3 1)
        (record-expected (U core/NativeId Nil))
        (contextual-argument-type empty-context-record-type nil 3 2)]
    (->EmptyCollectionContextCorpusV0
      (contextual-result-matches?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-vector-node annotation-expected)
        annotation-expected)
      (contextual-result-matches?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-map-node call-expected)
        call-expected)
      (contextual-result-matches?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-set-node record-expected)
        record-expected)
      (contextual-arguments-match? nil empty-context-signature)
      (contextual-arguments-match? empty-context-record-type nil)
      (contextual-result-failed-with?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-vector-node nil)
        "TODO-NATIVE-EMPTY-VECTOR-LITERAL: an empty literal names no element type")
      (contextual-result-failed-with?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-map-node nil)
        "TODO-NATIVE-EMPTY-MAP-LITERAL: an empty literal names no key or value type")
      (contextual-result-failed-with?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-set-node nil)
        "TODO-NATIVE-EMPTY-SET-LITERAL: an empty literal names no element type")
      (contextual-result-failed-with?
        (lower-contextual-empty empty-context-env empty-context-owner
          (empty-context-state) empty-context-vector-node empty-context-union-id)
        "TODO-NATIVE-EMPTY-VECTOR-LITERAL: the contextual type is not an exact native vector type")
      (and
        (nil? (contextual-argument-type nil empty-context-signature 2 0))
        (nil? (contextual-argument-type empty-context-record-type nil 4 0))))))

(def empty-collection-context-corpus-passes? Bool
  (and
    (emptycollectioncontextcorpusv0-annotation-vector-accepted
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-call-map-accepted
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-record-set-accepted
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-call-types-exact
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-record-types-exact
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-ambiguous-vector-rejected
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-ambiguous-map-rejected
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-ambiguous-set-rejected
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-nonexact-context-rejected
      empty-collection-context-corpus)
    (emptycollectioncontextcorpusv0-wrong-arity-uncontextual
      empty-collection-context-corpus)))

(def fixture-source-program stages/SourceStageV1
  (let [(root core/NativeId) (fixture-marker-id "root")
        (record core/NativeId) (fixture-marker-id "record")
        (fields core/NativeId) (fixture-marker-id "fields")
        (field core/NativeId) (fixture-marker-id "field")
        (int-type core/NativeId) (fixture-marker-id "int-type")
        (function core/NativeId) (fixture-marker-id "function")
        (parameters core/NativeId) (fixture-marker-id "parameters")
        (parameter core/NativeId) (fixture-marker-id "parameter")
        (text-values (Vec String))
        ["form-kind" "name" "fields" "f0" "ann" "params" "ret"
         "native-op" "abi-symbol" "record" "seq" "param" "type-prim"
         "defn" "FixtureBox" "value" "Int" "fixture-probe-identity"
         "identity" "fixture_probe_identity"]
        (text-nodes (Vec stages/TermNodeV0))
        (mapv (fn [(value String)] stages/TermNodeV0 (fixture-text-node value))
          text-values)
        (marker-nodes (Vec stages/TermNodeV0))
        (mapv (fn [(value String)] stages/TermNodeV0 (fixture-marker-node value))
          ["root" "record" "fields" "field" "int-type" "function"
           "parameters" "parameter"])
        (facts (Vec stages/TermNodeV0))
        [(fixture-fact-node 0 record "form-kind" (fixture-text-id "record"))
         (fixture-fact-node 1 record "name" (fixture-text-id "FixtureBox"))
         (fixture-fact-node 2 record "fields" fields)
         (fixture-fact-node 3 fields "form-kind" (fixture-text-id "seq"))
         (fixture-fact-node 4 fields "f0" field)
         (fixture-fact-node 5 field "form-kind" (fixture-text-id "param"))
         (fixture-fact-node 6 field "name" (fixture-text-id "value"))
         (fixture-fact-node 7 field "ann" int-type)
         (fixture-fact-node 8 int-type "form-kind" (fixture-text-id "type-prim"))
         (fixture-fact-node 9 int-type "name" (fixture-text-id "Int"))
         (fixture-fact-node 10 function "form-kind" (fixture-text-id "defn"))
         (fixture-fact-node 11 function "name"
           (fixture-text-id "fixture-probe-identity"))
         (fixture-fact-node 12 function "params" parameters)
         (fixture-fact-node 13 function "ret" int-type)
         (fixture-fact-node 14 function "native-op" (fixture-text-id "identity"))
         (fixture-fact-node 15 function "abi-symbol"
           (fixture-text-id "fixture_probe_identity"))
         (fixture-fact-node 16 parameters "form-kind" (fixture-text-id "seq"))
         (fixture-fact-node 17 parameters "f0" parameter)
         (fixture-fact-node 18 parameter "form-kind" (fixture-text-id "param"))
         (fixture-fact-node 19 parameter "name" (fixture-text-id "value"))
         (fixture-fact-node 20 parameter "ann" int-type)]
        (nodes (Vec stages/TermNodeV0))
        (vec (concat marker-nodes text-nodes facts))]
    (stages/->SourceStageV1
      (stages/->TermGraphV0 root nodes)
      [(stages/->SourceModuleV1
         (fixture-id "module" "fixture")
         "native.lower.fixture"
         "native-core/fixtures/lower-fixture.bgl"
         "fixture-source-digest-v0"
         "fixture-projection-digest-v0"
         "fixture-interface-digest-v0"
         root)]
      []
      []
      [])))

;; This fold-only insurance program is the empty-input specialization of
;; fram.fold/max-sequence; the full vector loop remains outside the v0 C17 subset.
(def fold-empty-source-program stages/SourceStageV1
  (let [(root core/NativeId) (fixture-id "fold" "root")
        (function core/NativeId) (fixture-id "fold" "max-sequence")
        (parameters core/NativeId) (fixture-id "fold" "parameters")
        (int-type core/NativeId) (fixture-id "fold" "int-type")
        (text-values (Vec String))
        ["form-kind" "name" "params" "ret" "native-op" "abi-symbol"
         "source-node-v0" "defn" "seq" "type-prim" "Int"
         "max-sequence" "const-zero-i64" "fram_fold_max_sequence_empty"]
        (text-nodes (Vec stages/TermNodeV0))
        (mapv (fn [(value String)] stages/TermNodeV0
                (stages/->TermNodeV0
                  (fixture-id "fold-text" value)
                  (stages/->TextTermV0 value)))
          text-values)
        (marker-nodes (Vec stages/TermNodeV0))
        [(stages/->TermNodeV0 root (stages/->TextTermV0 "source-node-v0"))
         (stages/->TermNodeV0 function (stages/->TextTermV0 "source-node-v0"))
         (stages/->TermNodeV0 parameters (stages/->TextTermV0 "source-node-v0"))
         (stages/->TermNodeV0 int-type (stages/->TextTermV0 "source-node-v0"))]
        (text-id (Fn [String] core/NativeId))
        (fn [(value String)] core/NativeId (fixture-id "fold-text" value))
        (fact (Fn [Int core/NativeId String core/NativeId] stages/TermNodeV0))
        (fn
          [(ordinal Int)
           (subject core/NativeId)
           (predicate String)
           (object core/NativeId)]
          stages/TermNodeV0
          (stages/->TermNodeV0
            (fixture-id "fold-fact" (str ordinal))
            (stages/->TripleTermV0 subject (text-id predicate) object)))
        (facts (Vec stages/TermNodeV0))
        [(fact 0 function "form-kind" (text-id "defn"))
         (fact 1 function "name" (text-id "max-sequence"))
         (fact 2 function "params" parameters)
         (fact 3 function "ret" int-type)
         (fact 4 function "native-op" (text-id "const-zero-i64"))
         (fact 5 function "abi-symbol" (text-id "fram_fold_max_sequence_empty"))
         (fact 6 parameters "form-kind" (text-id "seq"))
         (fact 7 int-type "form-kind" (text-id "type-prim"))
         (fact 8 int-type "name" (text-id "Int"))]
        (nodes (Vec stages/TermNodeV0))
        (vec (concat marker-nodes text-nodes facts))]
    (stages/->SourceStageV1
      (stages/->TermGraphV0 root nodes)
      [(stages/->SourceModuleV1
         (fixture-id "fold" "module")
         "fram.fold"
         "src/fram/fold.bclj"
         "sha256:0c94f11f109b471808f2011ac6209a4709896c601852d79e394d1c323030a6c2"
         "sha256:1c94f11f109b471808f2011ac6209a4709896c601852d79e394d1c323030a6c2"
         "fold-empty-max-sequence-v0"
         root)]
      []
      []
      [])))

(defunion FixturePipelineResultV0
  (FixturePipelineCompleteV0 [(frozen stages/FrozenNativeStageV0)])
  (FixturePipelineFailedV0 [(stage String) (detail String)]))

(defn lower-pipeline-fixture
  [(source-program stages/SourceStageV1)
   (compiler-commit String)]
  FixturePipelineResultV0
  (let [(configuration (Vec String))
        ["profile=3"]
        (source-result SourceFreezeResultV0)
        (freeze-source-stage source-program compiler-commit configuration)]
    (match source-result
      [(SourceFreezeRejectedV0 failure receipt)
       (->FixturePipelineFailedV0 "source-freeze" "fixture source program rejected")]
      [(SourceFreezeAcceptedV0 frozen-source source-receipt)
       (let [(typing-result TypingResultV0)
             (lower-typed-stage frozen-source compiler-commit configuration)]
         (match typing-result
           [(TypingRejectedV0 failure receipt)
            (->FixturePipelineFailedV0 "source-to-typed"
              "fixture annotations did not close")]
           [(TypingAcceptedV0 frozen-typed slice typed-receipt)
            (let [(native-result NativeLoweringResultV0)
                  (lower-native-stage frozen-typed slice compiler-commit
                    configuration (core/abi-profile-lp64))]
              (match native-result
                [(NativeLoweringPendingV0 frozen receipt obligations)
                 (->FixturePipelineFailedV0 "typed-to-native"
                   "fixture retained a named native obligation")]
                [(NativeLoweringCompleteV0 frozen receipt)
                 (->FixturePipelineCompleteV0 frozen)]))]))])))

(defn lower-fixture [(compiler-commit String)] FixturePipelineResultV0
  (lower-pipeline-fixture fixture-source-program compiler-commit))

(def fixture-result FixturePipelineResultV0
  (lower-fixture "fixture-compiler-commit"))

(def fixture-native-complete? Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 frozen) true]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-host-erased? Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 frozen) (native-program-host-erased? frozen)]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-valid? Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 frozen)
     (core/validationreport-passed
       (core/validate-program
         (stages/nativestagev0-program
           (stages/frozennativestagev0-stage frozen))))]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-native-has-abi? Bool
  (match fixture-result
    [(FixturePipelineCompleteV0 frozen)
     (> (count
          (core/nativecoreprogram-abis
            (stages/nativestagev0-program
              (stages/frozennativestagev0-stage frozen))))
        0)]
    [(FixturePipelineFailedV0 stage detail) false]))

(def fixture-passes? Bool
  (and empty-collection-context-corpus-passes?
       fixture-native-complete?
       fixture-native-host-erased?
       fixture-native-valid?
       fixture-native-has-abi?
       (= (parse-int-text "-9223372036854775808")
          (- (- 0 9223372036854775807) 1))
       (= (parse-int-text "9223372036854775807") 9223372036854775807)
       (nil? (parse-int-text "-9223372036854775809"))
       (nil? (parse-int-text "9223372036854775808"))))

(def fold-empty-result FixturePipelineResultV0
  (lower-pipeline-fixture fold-empty-source-program "fold-insurance-v0"))

(def fold-empty-passes? Bool
  (match fold-empty-result
    [(FixturePipelineCompleteV0 frozen)
     (and (native-program-host-erased? frozen)
       (core/validationreport-passed
         (core/validate-program
           (stages/nativestagev0-program
             (stages/frozennativestagev0-stage frozen)))))]
    [(FixturePipelineFailedV0 stage detail) false]))

;; --- Gate G2: the epoch stage rewrite keeps every rewritten fixture program
;; green under all nine obligations (the seven legacy ones on the rewritten
;; instructions and region tree, plus epoch soundness and leak freedom), and
;; the digest chain stays honest (a rewritten program freezes to a different
;; digest with parent and compiler-pass naming the native stage it came from).

(defn epoch-rewrite-gate? [(pipeline FixturePipelineResultV0)] Bool
  (match pipeline
    [(FixturePipelineFailedV0 stage detail) false]
    [(FixturePipelineCompleteV0 frozen)
     (let [(result EpochLoweringResultV0)
           (lower-epoch-stage frozen "epoch-gate-commit" ["profile=3"]
             (core/abi-profile-lp64) (->EpochDerivedV0 true))
           (rewritten-frozen stages/FrozenNativeStageV0)
           (epoch-result-frozen result)
           (rewritten core/NativeCoreProgram)
           (stages/nativestagev0-program
             (stages/frozennativestagev0-stage rewritten-frozen))
           (verdicts (Vec obligations/ObligationVerdictV0))
           (obligations/validate-native-core-program rewritten
             (core/abi-profile-lp64))]
       (and
         (every?
           (fn [(verdict obligations/ObligationVerdictV0)] Bool
             (obligations/obligation-passed? verdict))
           verdicts)
         (= "native-to-epoch-v0" (core/nativecoreprogram-compiler-pass rewritten))
         (not (= (stages/frozennativestagev0-digest rewritten-frozen)
              (stages/frozennativestagev0-digest frozen)))))]))

(def epoch-stage-fixture-passes? Bool (epoch-rewrite-gate? fixture-result))

(def epoch-stage-fold-passes? Bool (epoch-rewrite-gate? fold-empty-result))

;; The pipeline fixtures allocate only values that escape (their products), so
;; the stage mints nothing there. This program carries one provably interior
;; allocation, making the mint-retarget-close path a non-vacuous gate: the
;; stage must mint exactly one epoch region, insert its close, and leave all
;; nine obligations green on the rewritten program.

(def epoch-mint-function core/FunctionDef
  (core/->FunctionDef
    (fixture-id "epoch-mint" "function")
    "epoch-mint"
    [(core/->Parameter (fixture-id "epoch-mint" "n") (int-type-id))]
    [(core/->BasicBlock (fixture-id "epoch-mint" "entry") []
       [(core/->ArenaInstruction
          (core/->SsaValueV0 (fixture-id "epoch-mint" "arena")
            (arena-handle-type-id))
          (arena-region-id)
          (allocate-capability-id)
          (core/->TokenFlowV0
            [(arena-region-id) (allocate-capability-id)] []))
        (core/->TextConcatInstruction
          (core/->SsaValueV0 (fixture-id "epoch-mint" "text")
            (text-type-id))
          (fixture-id "epoch-mint" "arena")
          [])]
       [(core/->ReturnTerminator (fixture-id "epoch-mint" "n"))])]
    (fixture-id "epoch-mint" "entry")
    (int-type-id)
    [(allocate-effect-id)]
    [(arena-region-id)]
    [(allocate-capability-id)]))

(def epoch-mint-program core/NativeCoreProgram
  (let [(types (Vec core/TypeDef))
        [(i64-type) (text-type) (arena-handle-type)]]
    (core/->NativeCoreProgram
      (fixture-id "epoch-mint" "program")
      nil
      "typed-to-native-v0"
      types
      [(core/->EffectDef (allocate-effect-id)
         (core/->AllocateEffect (arena-region-id)))]
      (slice-regions)
      [(core/->CapabilityDef (allocate-capability-id)
         (core/->AllocateCapability true)
         (arena-region-id)
         true)]
      (collect-layouts (resolve-layouts types (core/abi-profile-lp64)))
      [epoch-mint-function]
      [(allocate-effect-id)]
      [(arena-region-id)]
      [(allocate-capability-id)]
      []
      [])))

(def epoch-mint-frozen stages/FrozenNativeStageV0
  (let [(root core/NativeId) (fixture-id "epoch-mint" "terms")
        (stage stages/NativeStageV0)
        (stages/->NativeStageV0
          (stages/->TermGraphV0 root
            [(stages/->TermNodeV0 root
               (stages/->TextTermV0 "native-stage-v0"))])
          "sha256:epoch-mint-fixture"
          epoch-mint-program
          [])
        (encoding String) (stages/encode-native-stage stage)]
    (stages/->FrozenNativeStageV0 stage encoding
      (stages/content-digest encoding))))

(defn program-close-count [(program core/NativeCoreProgram)] Int
  (loop [(function-position Int) 0
         (functions (Vec core/FunctionDef))
         (core/nativecoreprogram-functions program)
         (total Int) 0]
    (if (>= function-position (count functions))
      total
      (recur (+ function-position 1) functions
        (loop [(block-position Int) 0
               (blocks (Vec core/BasicBlock))
               (core/functiondef-blocks (nth functions function-position))
               (inner Int) total]
          (if (>= block-position (count blocks))
            inner
            (recur (+ block-position 1) blocks
              (loop [(position Int) 0
                     (instructions (Vec core/Instruction))
                     (core/basicblock-instructions (nth blocks block-position))
                     (closes Int) inner]
                (if (>= position (count instructions))
                  closes
                  (recur (+ position 1) instructions
                    (if (instance? native.core.ArenaCloseInstructionV0
                          (nth instructions position))
                      (+ closes 1)
                      closes)))))))))))

(defn program-minted-epoch-count [(program core/NativeCoreProgram)] Int
  (loop [(position Int) 0
         (regions (Vec core/RegionDef)) (core/nativecoreprogram-regions program)
         (minted Int) 0]
    (if (>= position (count regions))
      minted
      (recur (+ position 1) regions
        (if (nil? (core/regiondef-parent (nth regions position)))
          minted
          (+ minted 1))))))

(def epoch-stage-mint-passes? Bool
  (let [(result EpochLoweringResultV0)
        (lower-epoch-stage epoch-mint-frozen "epoch-gate-commit" ["profile=3"]
          (core/abi-profile-lp64) (->EpochDerivedV0 true))
        (frozen stages/FrozenNativeStageV0) (epoch-result-frozen result)
        (rewritten core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage frozen))
        (verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program rewritten
          (core/abi-profile-lp64))]
    (and (instance? native.lower.EpochLoweringCompleteV0 result)
      (= 1 (program-minted-epoch-count rewritten))
      (= 1 (program-close-count rewritten))
      (every?
        (fn [(verdict obligations/ObligationVerdictV0)] Bool
          (obligations/obligation-passed? verdict))
        verdicts))))

;; The nested-arena-operand shape the stage admits: an interior text-builtin
;; allocation whose arena operand travels inside the builtin record (the fram
;; substring-needle-result / str-trim shape). The stage must resolve the
;; nested operand, retarget it into the minted epoch alongside the top-level
;; TextConcat, insert the close, and keep all nine obligations green.

(def epoch-nested-function core/FunctionDef
  (core/->FunctionDef
    (fixture-id "epoch-nested" "function")
    "epoch-nested"
    [(core/->Parameter (fixture-id "epoch-nested" "n") (int-type-id))]
    [(core/->BasicBlock (fixture-id "epoch-nested" "entry") []
       [(core/->ArenaInstruction
          (core/->SsaValueV0 (fixture-id "epoch-nested" "arena")
            (arena-handle-type-id))
          (arena-region-id)
          (allocate-capability-id)
          (core/->TokenFlowV0
            [(arena-region-id) (allocate-capability-id)] []))
        (core/->TextConcatInstruction
          (core/->SsaValueV0 (fixture-id "epoch-nested" "text")
            (text-type-id))
          (fixture-id "epoch-nested" "arena")
          [])
        (core/->TextBuiltinInstruction
          (core/->SsaValueV0 (fixture-id "epoch-nested" "trimmed")
            (text-type-id))
          (core/->TextTrimV0 (fixture-id "epoch-nested" "arena")
            (fixture-id "epoch-nested" "text")))]
       [(core/->ReturnTerminator (fixture-id "epoch-nested" "n"))])]
    (fixture-id "epoch-nested" "entry")
    (int-type-id)
    [(allocate-effect-id)]
    [(arena-region-id)]
    [(allocate-capability-id)]))

(def epoch-nested-program core/NativeCoreProgram
  (let [(types (Vec core/TypeDef))
        [(i64-type) (text-type) (arena-handle-type)]]
    (core/->NativeCoreProgram
      (fixture-id "epoch-nested" "program")
      nil
      "typed-to-native-v0"
      types
      [(core/->EffectDef (allocate-effect-id)
         (core/->AllocateEffect (arena-region-id)))]
      (slice-regions)
      [(core/->CapabilityDef (allocate-capability-id)
         (core/->AllocateCapability true)
         (arena-region-id)
         true)]
      (collect-layouts (resolve-layouts types (core/abi-profile-lp64)))
      [epoch-nested-function]
      [(allocate-effect-id)]
      [(arena-region-id)]
      [(allocate-capability-id)]
      []
      [])))

(def epoch-nested-frozen stages/FrozenNativeStageV0
  (let [(root core/NativeId) (fixture-id "epoch-nested" "terms")
        (stage stages/NativeStageV0)
        (stages/->NativeStageV0
          (stages/->TermGraphV0 root
            [(stages/->TermNodeV0 root
               (stages/->TextTermV0 "native-stage-v0"))])
          "sha256:epoch-nested-fixture"
          epoch-nested-program
          [])
        (encoding String) (stages/encode-native-stage stage)]
    (stages/->FrozenNativeStageV0 stage encoding
      (stages/content-digest encoding))))

(defn program-allocating-arena-operands
  [(program core/NativeCoreProgram)] (Vec core/NativeId)
  (loop [(function-position Int) 0
         (functions (Vec core/FunctionDef))
         (core/nativecoreprogram-functions program)
         (collected (Vec core/NativeId)) []]
    (if (>= function-position (count functions))
      collected
      (recur (+ function-position 1) functions
        (loop [(block-position Int) 0
               (blocks (Vec core/BasicBlock))
               (core/functiondef-blocks (nth functions function-position))
               (inner (Vec core/NativeId)) collected]
          (if (>= block-position (count blocks))
            inner
            (recur (+ block-position 1) blocks
              (loop [(position Int) 0
                     (instructions (Vec core/Instruction))
                     (core/basicblock-instructions
                       (nth blocks block-position))
                     (arenas (Vec core/NativeId)) inner]
                (if (>= position (count instructions))
                  arenas
                  (recur (+ position 1) instructions
                    (let [(instruction core/Instruction)
                          (nth instructions position)
                          (arena (U core/NativeId Nil))
                          (if (allocating-instruction? instruction)
                            (obligations/instruction-arena-operand instruction)
                            nil)]
                      (if (nil? arena)
                        arenas
                        (conj arenas arena)))))))))))))

(def epoch-stage-nested-mint-passes? Bool
  (let [(result EpochLoweringResultV0)
        (lower-epoch-stage epoch-nested-frozen "epoch-gate-commit" ["profile=3"]
          (core/abi-profile-lp64) (->EpochDerivedV0 true))
        (frozen stages/FrozenNativeStageV0) (epoch-result-frozen result)
        (rewritten core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage frozen))
        (verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program rewritten
          (core/abi-profile-lp64))]
    (and (instance? native.lower.EpochLoweringCompleteV0 result)
      (= 1 (program-minted-epoch-count rewritten))
      (= 1 (program-close-count rewritten))
      ;; Both allocations moved off the root arena, the nested trim included.
      (every?
        (fn [(arena core/NativeId)] Bool
          (not (same-id? arena (fixture-id "epoch-nested" "arena"))))
        (program-allocating-arena-operands rewritten))
      (= 2 (count (program-allocating-arena-operands rewritten)))
      (every?
        (fn [(verdict obligations/ObligationVerdictV0)] Bool
          (obligations/obligation-passed? verdict))
        verdicts))))

;; The still-refused sub-case: an interior allocation with no arena SSA
;; operand at any level. An AllocateInstruction addresses its region and
;; capability directly, so the stage has nothing to redirect — it keeps the
;; parent epoch under TODO-EPOCH-NO-ARENA-OPERAND and the program stays green.

(def epoch-no-arena-ref-type core/TypeDef
  (core/->TypeDef (fixture-id "epoch-no-arena" "ref-type") "EpochRefI64"
    (core/->ReferenceType (int-type-id))))

(def epoch-no-arena-function core/FunctionDef
  (core/->FunctionDef
    (fixture-id "epoch-no-arena" "function")
    "epoch-no-arena"
    [(core/->Parameter (fixture-id "epoch-no-arena" "n") (int-type-id))]
    [(core/->BasicBlock (fixture-id "epoch-no-arena" "entry") []
       [(core/->ArenaInstruction
          (core/->SsaValueV0 (fixture-id "epoch-no-arena" "arena")
            (arena-handle-type-id))
          (arena-region-id)
          (allocate-capability-id)
          (core/->TokenFlowV0
            [(arena-region-id) (allocate-capability-id)] []))
        (core/->AtomInstruction
          (core/->SsaValueV0 (fixture-id "epoch-no-arena" "bytes")
            (int-type-id))
          (core/->I64Atom 8))
        (core/->AllocateInstruction
          (core/->SsaValueV0 (fixture-id "epoch-no-arena" "slot")
            (fixture-id "epoch-no-arena" "ref-type"))
          (arena-region-id)
          (allocate-capability-id)
          (fixture-id "epoch-no-arena" "bytes")
          (core/->TokenFlowV0 [] []))]
       [(core/->ReturnTerminator (fixture-id "epoch-no-arena" "n"))])]
    (fixture-id "epoch-no-arena" "entry")
    (int-type-id)
    [(allocate-effect-id)]
    [(arena-region-id)]
    [(allocate-capability-id)]))

(def epoch-no-arena-program core/NativeCoreProgram
  (let [(types (Vec core/TypeDef))
        [(i64-type) (text-type) (arena-handle-type) epoch-no-arena-ref-type]]
    (core/->NativeCoreProgram
      (fixture-id "epoch-no-arena" "program")
      nil
      "typed-to-native-v0"
      types
      [(core/->EffectDef (allocate-effect-id)
         (core/->AllocateEffect (arena-region-id)))]
      (slice-regions)
      [(core/->CapabilityDef (allocate-capability-id)
         (core/->AllocateCapability true)
         (arena-region-id)
         true)]
      (collect-layouts (resolve-layouts types (core/abi-profile-lp64)))
      [epoch-no-arena-function]
      [(allocate-effect-id)]
      [(arena-region-id)]
      [(allocate-capability-id)]
      []
      [])))

(def epoch-no-arena-frozen stages/FrozenNativeStageV0
  (let [(root core/NativeId) (fixture-id "epoch-no-arena" "terms")
        (stage stages/NativeStageV0)
        (stages/->NativeStageV0
          (stages/->TermGraphV0 root
            [(stages/->TermNodeV0 root
               (stages/->TextTermV0 "native-stage-v0"))])
          "sha256:epoch-no-arena-fixture"
          epoch-no-arena-program
          [])
        (encoding String) (stages/encode-native-stage stage)]
    (stages/->FrozenNativeStageV0 stage encoding
      (stages/content-digest encoding))))

(defn pending-detail-code? [(detail String) (code String)] Bool
  (and (>= (count detail) (count code))
    (= code (subs detail 0 (count code)))))

(def epoch-stage-no-arena-refusal-passes? Bool
  (let [(result EpochLoweringResultV0)
        (lower-epoch-stage epoch-no-arena-frozen "epoch-gate-commit"
          ["profile=3"] (core/abi-profile-lp64) (->EpochDerivedV0 true))
        (frozen stages/FrozenNativeStageV0) (epoch-result-frozen result)
        (rewritten core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage frozen))
        (pendings (Vec core/ReceiptObligationV0))
        (match result
          [(EpochLoweringCompleteV0 complete-frozen receipt) []]
          [(EpochLoweringPendingV0 pending-frozen receipt obligations)
           obligations])
        (verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program rewritten
          (core/abi-profile-lp64))]
    (and (instance? native.lower.EpochLoweringPendingV0 result)
      (= 0 (program-minted-epoch-count rewritten))
      (= 0 (program-close-count rewritten))
      (= 1 (count pendings))
      (every?
        (fn [(row core/ReceiptObligationV0)] Bool
          (pending-detail-code? (core/receiptobligationv0-detail row)
            "TODO-EPOCH-NO-ARENA-OPERAND"))
        pendings)
      (every?
        (fn [(verdict obligations/ObligationVerdictV0)] Bool
          (obligations/obligation-passed? verdict))
        verdicts))))

;; --- Gate G3: under EpochIdentityV0 the stage is a relabelling and nothing
;; else, and that is stated as strongly as the encoding allows — take the
;; input program, give it the epoch program's id, parent and compiler-pass,
;; re-encode, and require the two encodings equal byte for byte. Everything a
;; materializer can read is then provably the same bytes it read before the
;; stage existed, while the digest still moves, because an epoch-annotated
;; program is a different program.

(defn epoch-identity-inert? [(frozen stages/FrozenNativeStageV0)] Bool
  (let [(result EpochLoweringResultV0)
        (epoch-identity-stage frozen "epoch-gate-commit" ["profile=3"]
          (core/abi-profile-lp64))
        (rewritten-frozen stages/FrozenNativeStageV0)
        (epoch-result-frozen result)
        (stage stages/NativeStageV0) (stages/frozennativestagev0-stage frozen)
        (program core/NativeCoreProgram) (stages/nativestagev0-program stage)
        (rewritten core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage rewritten-frozen))
        (relabelled stages/NativeStageV0)
        (stages/->NativeStageV0
          (stages/nativestagev0-terms stage)
          (stages/nativestagev0-typed-digest stage)
          (with program
            [:id (core/nativecoreprogram-id rewritten)]
            [:parent (core/nativecoreprogram-parent rewritten)]
            [:compiler-pass (core/nativecoreprogram-compiler-pass rewritten)])
          (stages/nativestagev0-obligation-roots stage))]
    (and (epoch-result-complete? result)
      (core/program-epoch-0? rewritten)
      (= 0 (program-minted-epoch-count rewritten))
      (= 0 (program-close-count rewritten))
      (= "native-to-epoch-v0" (core/nativecoreprogram-compiler-pass rewritten))
      (= (stages/encode-native-stage relabelled)
         (stages/frozennativestagev0-encoding rewritten-frozen))
      (not (= (stages/frozennativestagev0-digest rewritten-frozen)
              (stages/frozennativestagev0-digest frozen))))))

(defn epoch-identity-gate? [(pipeline FixturePipelineResultV0)] Bool
  (match pipeline
    [(FixturePipelineFailedV0 stage detail) false]
    [(FixturePipelineCompleteV0 frozen) (epoch-identity-inert? frozen)]))

(def epoch-identity-fixture-passes? Bool (epoch-identity-gate? fixture-result))

(def epoch-identity-fold-passes? Bool (epoch-identity-gate? fold-empty-result))

;; The non-vacuous half: derived assignment mints an epoch and a close on this
;; fixture (epoch-stage-mint-passes?), so identity holding it at zero and zero
;; is the assignment being honoured rather than an empty program.
(def epoch-identity-mint-passes? Bool
  (epoch-identity-inert? epoch-mint-frozen))

;; Same honour under the nested-arena-operand fixture: derived assignment
;; retargets its builtin-record operand, so identity holding it at zero mints
;; and zero closes is again the assignment, not an empty program.
(def epoch-identity-nested-passes? Bool
  (epoch-identity-inert? epoch-nested-frozen))
