  (lower-id "extern" [(str "host-filesystem-" operation "-v0")]))

(defn host-filesystem-callee? [(name String)] Bool
  (or (= name "host.fs/read-text-bounded")
      (= name "host.fs/list-directory-bounded")
      (= name "host.fs/path-kind")
      (= name "host.fs/write-text-atomic")
      (= name "host.fs/make-parent-directories")
      (= name "host.fs/append-text")
      (= name "host.fs/lock-exclusive")
      (= name "host.fs/unlock")))

(defn host-filesystem-operation [(name String)] String
  (cond
    (= name "host.fs/read-text-bounded") "read-text-bounded"
    (= name "host.fs/list-directory-bounded") "list-directory-bounded"
    (= name "host.fs/path-kind") "path-kind"
    (= name "host.fs/write-text-atomic") "write-text-atomic"
    (= name "host.fs/make-parent-directories") "make-parent-directories"
    (= name "host.fs/append-text") "append-text"
    (= name "host.fs/lock-exclusive") "lock-exclusive"
    (= name "host.fs/unlock") "unlock"
    :else ""))

(defn host-filesystem-abi-id? [(candidate core/NativeId)] Bool
  (or (same-id? candidate (host-filesystem-abi-id "read-text-bounded"))
      (same-id? candidate (host-filesystem-abi-id "list-directory-bounded"))
      (same-id? candidate (host-filesystem-abi-id "path-kind"))
      (same-id? candidate (host-filesystem-abi-id "write-text-atomic"))
      (same-id? candidate
        (host-filesystem-abi-id "make-parent-directories"))
      (same-id? candidate (host-filesystem-abi-id "append-text"))
      (same-id? candidate (host-filesystem-abi-id "lock-exclusive"))
      (same-id? candidate (host-filesystem-abi-id "unlock"))))

