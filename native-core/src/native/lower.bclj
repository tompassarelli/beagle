                            (core/->FieldInstruction
                              (core/->SsaValueV0 result-id
                                (accessorhitv0-field-type accessor))
                              (nth values 0)
                              (accessorhitv0-field-id accessor)))]
                      (lower-refined-lookup-result types owner looked-up
                        (nth values 0) (nth value-types 0)
                        (id-value (accessorhitv0-field-id accessor))
                        (accessorhitv0-field-type accessor) result-id))

                    ;; The operand's static type is the union, so the expected
                    ;; variant is known: a direct checked extract, not a Switch.
                    (narrowhitv0-found narrowing)
                    (let [(reference-id core/NativeId)
                          (state-id current owner "narrow")
                          (result-id core/NativeId) (state-id current owner "field")
                          (looked-up BodyStateV0)
                          (state-emit
                          (state-emit (state-bump current)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 reference-id
                                (narrowhitv0-reference-type narrowing))
                              (nth values 0)
                              (narrowhitv0-variant-id narrowing)))
                            (core/->FieldInstruction
                              (core/->SsaValueV0 result-id
                                (accessorhitv0-field-type accessor))
                              reference-id
                              (accessorhitv0-field-id accessor)))]
                      (lower-refined-lookup-result types owner looked-up
                        (nth values 0) (nth value-types 0)
                        (id-value (accessorhitv0-field-id accessor))
                        (accessorhitv0-field-type accessor) result-id))

                    :else
                    (fail-result current
                      (str "TODO-NATIVE-ACCESSOR-OPERAND: " callee
                        " was not applied to its own record type"))))

                (some? payloadless-constructor)
                (let [(shape core/TypeShape)
                      (core/typedef-shape payloadless-constructor)
                      (member-name String) (subs bare-callee 2 (count bare-callee))
                      (variant (U core/TypeVariant Nil))
                      (if (instance? native.core.UnionType shape)
                        (variant-named (core/uniontype-variants shape) member-name)
                        nil)]
                  (cond
                    (not (= 0 (count values)))
                    (fail-result current
                      (str "TODO-NATIVE-CONSTRUCTOR-ARGUMENTS: " callee
                        " payloadless variant takes no arguments"))

                    (nil? variant)
                    (fail-result current
                      (str "TODO-NATIVE-CONSTRUCTOR-VARIANT: " callee
                        " has no payloadless native union variant"))

                    (some? (core/typevariant-payload-type variant))
                    (fail-result current
                      (str "TODO-NATIVE-CONSTRUCTOR-VARIANT: " callee
                        " unexpectedly carries a payload"))

                    :else
                    (let [(result-id core/NativeId)
                          (state-id current owner "union-unit")]
                      (->ExprResultV0
                        (state-emit (state-bump current)
                          (core/->UnionConstructInstruction
                            (core/->SsaValueV0 result-id
                              (core/typedef-id payloadless-constructor))
                            (core/typevariant-id variant)
                            nil))
                        result-id (core/typedef-id payloadless-constructor)
                        false))))

                (some? constructor)
                (let [(shape core/TypeShape) (core/typedef-shape constructor)
                      (fields (Vec core/TypeField))
                      (if (instance? native.core.RecordType shape)
                        (core/recordtype-fields shape)
                        [])
                      (arity-ok Bool)
                      (= (count fields) (count values))
                      (parameters (Vec core/Parameter))
                      (mapv
                        (fn [(field core/TypeField)] core/Parameter
                          (core/->Parameter (core/typefield-id field)
                            (core/typefield-type-id field)))
                        fields)
                      (coerced ArgsResultV0)
                      (if arity-ok
                        (coerce-arguments types owner current values value-types
                          parameters)
                        (->ArgsResultV0 current values value-types false))
                      (settled BodyStateV0) (argsresultv0-state coerced)
                      (coerced-values (Vec core/NativeId))
                      (argsresultv0-values coerced)
                      (coerced-types (Vec core/NativeId))
                      (argsresultv0-value-types coerced)
                      (types-ok Bool)
                        (and arity-ok
                          (loop [(position Int) 0]
                            (if (>= position (count fields))
                              true
                              (if (same-id? (core/typefield-type-id (nth fields position))
                                  (nth coerced-types position))
                                (recur (+ position 1))
                                false))))
                      (guarded BodyStateV0)
                      (if types-ok
                        (guard-record-values env owner settled
                          (core/typedef-id constructor) fields coerced-values)
                        settled)
                      (result-id core/NativeId) (state-id guarded owner "record")]
                  (if (state-blocked? settled)
                    (dead-result settled)
                    (if (not types-ok)
                    (fail-result current
                      (str "TODO-NATIVE-CONSTRUCTOR-ARGUMENTS: " callee
                        " arguments do not match the record field types"))
                    (if (state-blocked? guarded)
                      (dead-result guarded)
                      (let [(constructed ExprResultV0)
                            (->ExprResultV0
                              (state-emit (state-bump guarded)
                                (core/->RecordInstruction
                                  (core/->SsaValueV0 result-id
                                    (core/typedef-id constructor))
                                  coerced-values))
                              result-id (core/typedef-id constructor) false)
                            (member-name String)
                            (if (and (> (count callee) 2)
                                  (= "->" (subs callee 0 2)))
                              (subs callee 2 (count callee)) "")
                            (source-union (U core/NativeId Nil))
                            (source-union-for-member index
                              (resolvedsourcenamev0-module-name resolved-callee)
                              member-name)]
                        (if (nil? source-union)
                          constructed
                          (lower-boundary-coerce types owner
                            (exprresultv0-state constructed)
                            (exprresultv0-value-id constructed)
                            (exprresultv0-type-id constructed)
                            (source-type-id
                              (str (source-module-name index source-union) "/"
                                (fact-text index source-union "name"))))))))))

                (some? signature)
                (let [(parameters (Vec core/Parameter))
                      (typedfunctionv0-parameters signature)
                      (arity-ok Bool) (= (count parameters) (count values))]
                  (if (not arity-ok)
                    (fail-result current
                      (str "TODO-NATIVE-CALL-ARGUMENTS: " callee
                        " arguments do not match its native parameters"))
                    (let [(coerced ArgsResultV0)
                          (coerce-arguments types owner current values value-types
                            parameters)
                          (settled BodyStateV0) (argsresultv0-state coerced)
                          (coerced-values (Vec core/NativeId))
                          (argsresultv0-values coerced)
                          (coerced-types (Vec core/NativeId))
                          (argsresultv0-value-types coerced)
                          (types-ok Bool)
                          (and (= (count parameters) (count coerced-types))
                            (loop [(position Int) 0]
                              (if (>= position (count parameters))
                                true
                                (if (same-id?
                                      (core/parameter-type-id
                                        (nth parameters position))
                                      (nth coerced-types position))
                                  (recur (+ position 1))
                                  false))))
                          (result-id core/NativeId)
                          (state-id settled owner "call")]
                      (cond
                        (state-blocked? settled) (dead-result settled)
                        (not types-ok)
                        (fail-result settled
                          (str "TODO-NATIVE-CALL-ARGUMENTS: " callee
                            " arguments do not match its native parameters"))
                        :else
                        (let [(called BodyStateV0)
                              (state-emit (state-bump settled)
                                (core/->CallInstruction
                                  (core/->SsaValueV0 result-id
                                    (typedfunctionv0-return-type signature))
                                  (typedfunctionv0-id signature)
                                  coerced-values
                                  nil
                                  (core/->TokenFlowV0 [] [])))]
                          (if (signature-traps? env signature)
                            (let [(trap-id core/NativeId)
                                  (state-id called owner "unreachable-call")
                                  (trapped BodyStateV0)
                                  (state-emit (state-bump called)
                                    (core/->AtomInstruction
                                      (core/->SsaValueV0 trap-id (int-type-id))
                                      (core/->I64Atom (trap-failure-code))))]
                              (->ExprResultV0
                                (state-close trapped (core/->TrapTerminator trap-id))
                                trap-id (type-id "LowerFailure") true))
                            (->ExprResultV0 called result-id
                              (typedfunctionv0-return-type signature) false)))))))

                :else
                (fail-result current
                  (str "TODO-NATIVE-CALL-" callee
                    ": no native lowering for this callee")))))) 

        :else
        (fail-result state
          (str "TODO-NATIVE-FORM-" kind ": no native lowering for this source form"))))))

(defn lower-expr-expected
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expr core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(contextual (U ExprResultV0 Nil))
        (lower-contextual-value env owner state expr expected
          (fn
            [(item-state BodyStateV0)
             (item-node core/NativeId)
             (item-expected core/NativeId)]
            ExprResultV0
            (lower-expr-expected env owner item-state item-node item-expected)))]
    (if (nil? contextual)
      (lower-expr-raw env owner state expr expected)
      contextual)))

(defn lower-expr
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expr core/NativeId)]
  ExprResultV0
  (lower-expr-expected env owner state expr nil))

;; Native v0 has no module-init block. A needed immutable module value is
;; hoisted once into each function entry, so aggregate allocation remains an
;; explicit effect and never occurs inside a loop merely because it is read.
(defn lower-global-bindings
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (globals (Vec GlobalBindingV0))]
  BodyStateV0
  (loop [(position Int) 0 (current BodyStateV0) state]
    (if (or (>= position (count globals)) (state-blocked? current))
      current
      (let [(global GlobalBindingV0) (nth globals position)
            (effective-type (U core/NativeId Nil))
            (globalbindingv0-effective-type global)]
        (if (nil? effective-type)
          (state-fail current
            (str "LOWER-MISSING-GLOBAL-EFFECTIVE-TYPE: "
              (globalbindingv0-name global)
              " has no checker-published effective type"))
          (let [(expected (U core/NativeId Nil))
                (annotation-native-type (bodyenvv0-index env) effective-type)
                (raw ExprResultV0)
                (lower-expr-expected env owner current
                  (globalbindingv0-value global) expected)
                (value ExprResultV0)
                (if (or (exprresultv0-terminated raw)
                        (state-blocked? (exprresultv0-state raw)))
                  raw
                  (lower-boundary-coerce (bodyenvv0-types env) owner
                    (exprresultv0-state raw)
                    (exprresultv0-value-id raw)
                    (exprresultv0-type-id raw)
                    (typeresolutionv0-type-id
                      (resolve-source-type
                        (bodyenvv0-index env) effective-type))))]
            (cond
              (state-blocked? (exprresultv0-state value))
              (exprresultv0-state value)

              (exprresultv0-terminated value)
              (state-fail (exprresultv0-state value)
                (str "TODO-NATIVE-GLOBAL-INITIALIZER: "
                  (globalbindingv0-name global) " does not produce a value"))

              :else
              (recur (+ position 1)
                (state-bind (exprresultv0-state value)
                  (global-key global)
                  (exprresultv0-value-id value)
                  (exprresultv0-type-id value))))))))))

(defn binding-default-at
  [(index SourceIndexV0)
   (target core/NativeId)
   (name String)]
  (U core/NativeId Nil)
  (let [(defaults (Vec core/NativeId))
        (binding-name-items index target "defaults")]
    (loop [(position Int) 0]
      (if (>= position (count defaults))
        nil
        (let [(entry core/NativeId) (nth defaults position)]
          (if (= name (fact-text index entry "name"))
            (index-first-object index entry "value")
            (recur (+ position 1))))))))

(defn project-map-binding
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target core/NativeId)
   (aggregate-id core/NativeId)
   (aggregate-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (keys (Vec core/NativeId)) (binding-name-items index target "keys")
        (as-name String) (fact-text index target "as")
        (initial BodyStateV0)
        (if (= "" as-name)
          state
          (state-bind state as-name aggregate-id aggregate-type))]
    (loop [(position Int) 0 (current BodyStateV0) initial]
      (if (or (>= position (count keys)) (state-blocked? current))
        current
        (let [(key-target core/NativeId) (nth keys position)
              (name String) (fact-text index key-target "name")
              (default-node (U core/NativeId Nil))
              (binding-default-at index target name)
              (field AccessorHitV0)
              (record-keyword-field types aggregate-type name)]
          (cond
            (= "" name)
            (state-fail current
              "TODO-NATIVE-DESTRUCTURE-MAP-NAME: a key binding has no name")

            (accessorhitv0-found field)
            (let [(result-id core/NativeId)
                  (state-id current owner (str "param-field-" name))
                  (projected BodyStateV0)
                  (state-emit (state-bump current)
                    (core/->FieldInstruction
                      (core/->SsaValueV0 result-id
                        (accessorhitv0-field-type field))
                      aggregate-id (accessorhitv0-field-id field)))]
              ;; A non-null nominal field makes :or unreachable.  Nullable
              ;; record defaults are rejected by the oracle checker until it
              ;; can expose the narrowed projected type on the checked wire.
              (recur (+ position 1)
                (state-bind projected name result-id
                  (accessorhitv0-field-type field))))

            (map-type? types aggregate-type)
            (let [(key-type core/NativeId) (map-key-of types aggregate-type)
                  (value-type core/NativeId) (map-value-of types aggregate-type)
                  (equality (U core/ConcreteEqualityV0 Nil))
                  (map-key-equality-for types key-type)]
              (cond
                (not (same-id? key-type (keyword-type-id)))
                (state-fail current
                  "TODO-NATIVE-DESTRUCTURE-MAP-KEY: :keys needs a Keyword-keyed native map")

                (nil? equality)
                (state-fail current
                  "TODO-NATIVE-DESTRUCTURE-MAP-EQUALITY: :keys needs closed Keyword equality")

                :else
                (let [(key-id core/NativeId)
                      (state-id current owner (str "param-key-" name))
                      (keyed BodyStateV0)
                      (state-emit (state-bump current)
                        (core/->AtomInstruction
                          (core/->SsaValueV0 key-id (keyword-type-id))
                          (core/->KeywordAtom name)))
                      (nil-default Bool) (nil? default-node)
                      (default-result (U ExprResultV0 Nil))
                      (if nil-default
                        nil
                        (if (nil? default-node)
                          nil
                          (lower-expr-expected env owner keyed default-node
                            value-type)))
                      (default-state BodyStateV0)
                      (if (nil? default-result)
                        keyed
                        (exprresultv0-state default-result))
                      (result-type core/NativeId)
                      (if nil-default
                        (nullable-map-value-type-id value-type)
                        value-type)]
                  (if (or (state-blocked? default-state)
                        (and (some? default-result)
                          (exprresultv0-terminated default-result)))
                    (state-fail default-state
                      "TODO-NATIVE-DESTRUCTURE-MAP-DEFAULT: :or default does not produce its field value")
                    (let [(settled-default (U ExprResultV0 Nil))
                          (if (or (nil? default-result)
                                (same-id? value-type
                                  (exprresultv0-type-id default-result)))
                            default-result
                            (lower-boundary-coerce types owner default-state
                              (exprresultv0-value-id default-result)
                              (exprresultv0-type-id default-result)
                              value-type))
                          (settled BodyStateV0)
                          (if (nil? settled-default)
                            default-state
                            (exprresultv0-state settled-default))
                          (result-id core/NativeId)
                          (state-id settled owner (str "param-map-" name))]
                      (if (state-blocked? settled)
                        settled
                        (recur (+ position 1)
                          (state-bind
                            (state-emit (state-bump settled)
                              (core/->MapGetInstructionV0
                                (core/->SsaValueV0 result-id result-type)
                                aggregate-id key-id
                                (if (nil? settled-default)
                                  nil
                                  (exprresultv0-value-id settled-default))
                                equality))
                            name result-id result-type))))))))

            :else
            (state-fail current
              "TODO-NATIVE-DESTRUCTURE-MAP-SHAPE: map binding needs a closed record or Map")))))))

(defn project-seq-binding
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target core/NativeId)
   (source-type core/NativeId)
   (aggregate-id core/NativeId)
   (aggregate-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (constructor (U String Nil)) (source-type-spelling index source-type)
        (components (Vec core/NativeId)) (source-type-arguments index source-type)
        (targets (Vec core/NativeId)) (binding-name-items index target "names")
        (rest-name String) (fact-text index target "rest")]
    (cond
      (not (= "HVec" constructor))
      (state-fail state
        "TODO-NATIVE-DESTRUCTURE-SEQUENCE-BOUNDS: Native Core requires an exact HVec parameter for positional destructuring")

      (not (= (count components) (count targets)))
      (state-fail state
        "TODO-NATIVE-DESTRUCTURE-SEQUENCE-ARITY: HVec parameter and pattern arities differ")

      (not (= "" rest-name))
      (state-fail state
        "TODO-NATIVE-DESTRUCTURE-SEQUENCE-REST: Native Core has no exact heterogeneous rest carrier")

      (not (vector-type? types aggregate-type))
      (state-fail state
        "TODO-NATIVE-DESTRUCTURE-SEQUENCE-SHAPE: HVec parameter has no native vector carrier")

      :else
      (loop [(position Int) 0 (current BodyStateV0) state]
        (if (or (>= position (count targets)) (state-blocked? current))
          current
          (let [(component-source core/NativeId) (nth components position)
                (resolution TypeResolutionV0)
                (resolve-source-type index component-source)]
            (if (not (typeresolutionv0-valid resolution))
              (state-fail current
                "TODO-NATIVE-DESTRUCTURE-SEQUENCE-TYPE: tuple component is not a closed native type")
              (let [(component-type core/NativeId)
                    (typeresolutionv0-type-id resolution)
                    (index-id core/NativeId)
                    (state-id current owner (str "param-index-" position))
                    (indexed BodyStateV0)
                    (state-emit (state-bump current)
                      (core/->AtomInstruction
                        (core/->SsaValueV0 index-id (int-type-id))
                        (core/->I64Atom position)))
                    (result-id core/NativeId)
                    (state-id indexed owner (str "param-item-" position))
                    (projected BodyStateV0)
                    (state-emit (state-bump indexed)
                      (core/->VecGetInstruction
                        (core/->SsaValueV0 result-id component-type)
                        aggregate-id index-id))]
                (recur (+ position 1)
                  (project-binding-target env owner projected
                    (nth targets position) component-source result-id
                    component-type))))))))))

(defn project-binding-target
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target core/NativeId)
   (source-type core/NativeId)
   (aggregate-id core/NativeId)
   (aggregate-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (kind String) (fact-text index target "form-kind")]
    (cond
      (= "binding-name" kind)
      (let [(name String) (fact-text index target "name")]
        (if (= "" name)
          (state-fail state
            "TODO-NATIVE-DESTRUCTURE-NAME: projected binding has no name")
          (state-bind state name aggregate-id aggregate-type)))

      (= "map-destructure" kind)
      (project-map-binding env owner state target aggregate-id aggregate-type)

      (= "seq-destructure" kind)
      (project-seq-binding env owner state target source-type aggregate-id
        aggregate-type)

      :else
      (state-fail state
        (str "TODO-NATIVE-DESTRUCTURE-TARGET: unsupported binding target " kind)))))

(defn project-parameter-bindings
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source-function core/NativeId)
   (source-parameters (Vec core/NativeId))
   (parameters (Vec core/Parameter))]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (signature EffectiveFunctionSignatureV0)
        (effective-function-signature index source-function source-parameters)
        (effective Bool)
        (and (effectivefunctionsignaturev0-present signature)
          (effectivefunctionsignaturev0-valid signature))
        (effective-types (Vec core/NativeId))
        (effectivefunctionsignaturev0-parameter-types signature)]
    (loop [(position Int) 0 (current BodyStateV0) state]
      (if (or (>= position (count source-parameters))
            (>= position (count parameters))
            (state-blocked? current))
        current
        (let [(source-parameter core/NativeId) (nth source-parameters position)
              (parameter core/Parameter) (nth parameters position)
              (target (U core/NativeId Nil))
              (parameter-target-at index source-parameter)
              (source-type (U core/NativeId Nil))
              (if effective
                (nth effective-types position)
                (field-type-at index source-parameter))]
          (if (or (nil? target) (nil? source-type))
            (recur (+ position 1) current)
            (recur (+ position 1)
              (project-binding-target env owner current target source-type
                (core/parameter-id parameter)
                (core/parameter-type-id parameter)))))))))

(defn guard-parameter-bindings
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source-parameters (Vec core/NativeId))
   (parameters (Vec core/Parameter))]
  BodyStateV0
  (loop [(position Int) 0 (current BodyStateV0) state]
    (if (or (>= position (count source-parameters))
          (>= position (count parameters))
          (state-blocked? current))
      current
      (let [(parameter core/Parameter) (nth parameters position)]
        (recur (+ position 1)
          (guard-binding-value env owner current
            (nth source-parameters position)
            (core/parameter-id parameter)
            (core/parameter-type-id parameter)))))))

(defn function-native-op
  [(index SourceIndexV0) (source-function core/NativeId)] (U String Nil)
  (index-first-text index source-function "native-op"))

(defn recognized-native-op? [(operation String)] Bool
  (or (= operation "identity")
      (= operation "checked-add-i64")
      (= operation "const-zero-i64")))

;; Pass one: the signature only. Bodies need every signature in the module
;; (a call names its callee), so they are lowered after this pass closes.
(defn resolve-function
  [(index SourceIndexV0) (source-function core/NativeId)] FunctionResolutionV0
  (let [(source-name (U String Nil)) (index-first-text index source-function "name")]
    (if (nil? source-name)
      (let [(id core/NativeId) (function-id source-function "unnamed")]
        (->FunctionResolutionV0
          (->TypedFunctionV0 id "unnamed" "native_unnamed" [] (type-id "LowerFailure")
            (type-id "LowerFailure") []
            (->NativeTodoV0 "TODO-NATIVE-UNNAMED-FUNCTION"
              "source function lacks a name")
            "")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-FUNCTION-MISSING-NAME"
             (str "function form has no name: " (id-value source-function)))]
          false))
      (let [(id core/NativeId) (function-id source-function source-name)
            (source-parameters (Vec core/NativeId))
            (function-parameter-items index source-function)
            (effective-signature EffectiveFunctionSignatureV0)
            (effective-function-signature index source-function source-parameters)
            (parameters ParameterResolutionV0)
            (resolve-parameters-with-signature index source-function id
              effective-signature)
            (source-return (U core/NativeId Nil))
            (if (and
                  (effectivefunctionsignaturev0-present effective-signature)
                  (effectivefunctionsignaturev0-valid effective-signature))
              (effectivefunctionsignaturev0-return-type effective-signature)
              (if (effectivefunctionsignaturev0-present effective-signature)
                nil
                (index-first-object index source-function "ret")))
            (source-abi-symbol (U String Nil))
            (index-first-text index source-function "abi-symbol")
            (abi-symbol String)
            (if (nil? source-abi-symbol) source-name source-abi-symbol)
            (return-resolution TypeResolutionV0)
            (if (and
                  (effectivefunctionsignaturev0-present effective-signature)
                  (not (effectivefunctionsignaturev0-valid effective-signature)))
              (->TypeResolutionV0
                (type-id "LowerFailure") [(lower-failure-type)] [] false)
              (if (nil? source-return)
              (->TypeResolutionV0
                (type-id "Nil")
                [(nil-type)]
                [(core/->DiagnosticV0
                   "TODO-NATIVE-SIGNATURE-FACTS"
                   (str "checked source projection omitted the return annotation for " source-name))]
                true)
                (resolve-source-type index source-return)))
            (native-op (U String Nil)) (function-native-op index source-function)
            (readiness NativeReadinessV0)
            (if (and (some? native-op) (recognized-native-op? native-op))
              (->NativeReadyV0 native-op)
              (->NativeTodoV0
                "TODO-NATIVE-FUNCTION-BODY"
                (str "native body lowering remains for " source-name)))
            (effects (Vec core/NativeId)) (function-effects source-name)]
        (->FunctionResolutionV0
          (->TypedFunctionV0
            id
            source-name
            abi-symbol
            (parameterresolutionv0-parameters parameters)
            (typeresolutionv0-type-id return-resolution)
            (type-id "LowerFailure")
            effects
            readiness
            "")
          (append-type-defs
            (parameterresolutionv0-definitions parameters)
            (typeresolutionv0-definitions return-resolution))
          (append-diagnostics
            (parameterresolutionv0-diagnostics parameters)
            (typeresolutionv0-diagnostics return-resolution))
          (and (parameterresolutionv0-valid parameters)
               (typeresolutionv0-valid return-resolution)))))))

(defn reject-multi-function
  [(index SourceIndexV0) (source-function core/NativeId)] FunctionResolutionV0
  (let [(source-name (U String Nil))
        (index-first-text index source-function "name")
        (name String)
        (if (nil? source-name) (id-value source-function) source-name)
        (id core/NativeId) (function-id source-function name)]
    (->FunctionResolutionV0
      (->TypedFunctionV0
        id name name [] (type-id "LowerFailure") (type-id "LowerFailure") []
        (->NativeTodoV0
          "LOWER-MULTI-ARITY-FUNCTION-ABI"
          (str name " has multiple arities; Native v0 has no dispatcher ABI"))
        "")
      [(lower-failure-type)]
      [(core/->DiagnosticV0
         "LOWER-MULTI-ARITY-FUNCTION-ABI"
         (str name " has multiple arities; Native v0 has no dispatcher ABI"))]
      false)))

(defn resolve-functions [(index SourceIndexV0)] (Vec FunctionResolutionV0)
  (vec
    (concat
      (mapv
        (fn [(source-function core/NativeId)] FunctionResolutionV0
          (resolve-function index source-function))
        (index-form-ids index "defn"))
      (mapv
        (fn [(source-function core/NativeId)] FunctionResolutionV0
          (reject-multi-function index source-function))
        (index-form-ids index "defn-multi")))))

(defn finish-body
  [(signature TypedFunctionV0)
   (entry-id core/NativeId)
   (blocks (Vec core/BasicBlock))]
  NativeReadinessV0
  (->NativeLoweredV0 entry-id blocks))

(defn lower-function-body
  [(env BodyEnvV0)
   (signature TypedFunctionV0)
   (source-function core/NativeId)]
  NativeReadinessV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (id core/NativeId) (typedfunctionv0-id signature)
        (name String) (typedfunctionv0-name signature)
        (body-node (U core/NativeId Nil))
        (index-first-object index source-function "body")
        (parameters (Vec core/Parameter)) (typedfunctionv0-parameters signature)
        (source-parameters (Vec core/NativeId))
        (function-parameter-items index source-function)
        (parameter-locals (Vec LocalBindingV0))
        (loop [(position Int) 0 (collected (Vec LocalBindingV0)) []]
          (if (or (>= position (count parameters))
                  (>= position (count source-parameters)))
            collected
            (recur (+ position 1)
              (conj collected
                (->LocalBindingV0
                  (parameter-name-at index (nth source-parameters position)
                    position)
                  (core/parameter-id (nth parameters position))
                  (core/parameter-type-id (nth parameters position)))))))
        (parameter-bound-names (Vec String))
        (source-parameters-bound-names index source-parameters)
        (entry-id core/NativeId) (lower-id "block-entry" [(id-value id)])]
    (if (nil? body-node)
      (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
        (str "the checked source projection carries no body form for " name))
      (let [(globalized BodyStateV0)
            (lower-global-bindings env id
              (->BodyStateV0 [] entry-id [] [] true 0 [] "" [] [] [] nil)
              (needed-globals env body-node
                parameter-bound-names))
            (guarded BodyStateV0)
            (guard-parameter-bindings env id globalized source-parameters
              parameters)
            (initialized BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) guarded]
              (if (>= position (count parameter-locals))
                current
                (let [(binding LocalBindingV0) (nth parameter-locals position)]
                  (recur (+ position 1)
                    (state-bind current
                      (localbindingv0-name binding)
                      (localbindingv0-value-id binding)
                      (localbindingv0-type-id binding))))))
            (projected BodyStateV0)
            (project-parameter-bindings env id initialized source-function
              source-parameters parameters)
            (result ExprResultV0)
            (lower-expr-expected env id projected body-node
              (typedfunctionv0-return-type signature))
            (state BodyStateV0) (exprresultv0-state result)]
        (cond
          (state-blocked? state)
          (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
            (str (bodystatev0-failure state) " [" name "]"))

          (exprresultv0-terminated result)
          (finish-body signature entry-id (bodystatev0-blocks state))

          :else
          ;; A body whose type differs from the declared return type is coerced,
          ;; never reinterpreted: identity when they agree, otherwise the widen.
          (let [(coerced ExprResultV0)
                (lower-boundary-coerce (bodyenvv0-types env) id state
                  (exprresultv0-value-id result)
                  (exprresultv0-type-id result)
                  (typedfunctionv0-return-type signature))
                (settled BodyStateV0) (exprresultv0-state coerced)]
            (if (state-blocked? settled)
              (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
                (str "TODO-NATIVE-RETURN-TYPE: the lowered body of " name
                  " does not produce its declared return type: "
                  (bodystatev0-failure settled)))
              (finish-body signature entry-id
                (bodystatev0-blocks
                  (state-close settled
                    (core/->ReturnTerminator
                      (exprresultv0-value-id coerced))))))))))))

(defn readiness-code [(readiness NativeReadinessV0)] String
  (match readiness
    [(NativeReadyV0 operation) operation]
    [(NativeLoweredV0 entry-block blocks) "native-body-v0"]
    [(NativeTodoV0 code detail) code]))

(defn readiness-blocks [(readiness NativeReadinessV0)] (Vec core/BasicBlock)
  (match readiness
    [(NativeReadyV0 operation) []]
    [(NativeLoweredV0 entry-block blocks) blocks]
    [(NativeTodoV0 code detail) []]))

(defn readiness-detail [(readiness NativeReadinessV0)] String
  (match readiness
    [(NativeReadyV0 operation) ""]
    [(NativeLoweredV0 entry-block blocks) ""]
    [(NativeTodoV0 code detail) detail]))

(defn blocks-use-checked? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (instance? native.core.CheckedInstruction instruction))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-environment? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  (host-environment-abi-id))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-stdout? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (or
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-stdout-abi-id))
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-stdout-write-abi-id)))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-stderr? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (or
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-stderr-write-abi-id))
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-stderr-write-line-abi-id)))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-call-abi?
  [(blocks (Vec core/BasicBlock)) (abi-id core/NativeId)] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  abi-id)))
            (core/basicblock-instructions block))))
      blocks)))

(defn function-calls-abi?
  [(function TypedFunctionV0) (abi-id core/NativeId)] Bool
  (blocks-call-abi? (readiness-blocks (typedfunctionv0-readiness function))
    abi-id))

(defn any-function-calls-abi?
  [(functions (Vec TypedFunctionV0)) (abi-id core/NativeId)] Bool
  (some?
    (some
      (fn [(function TypedFunctionV0)] Bool
        (function-calls-abi? function abi-id))
      functions)))

(defn blocks-use-host-filesystem? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (host-filesystem-abi-id?
                  (core/externcallinstruction-abi-id instruction))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-process? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (host-process-abi-id?
                  (core/externcallinstruction-abi-id instruction))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-socket? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (host-socket-abi-id?
                  (core/externcallinstruction-abi-id instruction))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-clock? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (or
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-clock-abi-id))
                  (same-id? (core/externcallinstruction-abi-id instruction)
                    (host-time-sleep-abi-id))
                  (host-wall-clock-abi-id?
                    (core/externcallinstruction-abi-id instruction)))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-buffer-read? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (or
                (instance? native.core.BufferLengthInstructionV0 instruction)
                (or (instance? native.core.BufferGetCheckedInstructionV0 instruction)
                  (or (instance? native.core.TiledStepF64InstructionV0 instruction)
                    (instance? native.core.F64BufferSumInstructionV0
                      instruction)))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-buffer-write? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (or (instance? native.core.BufferSetCheckedInstructionV0 instruction)
                (instance? native.core.TiledStepF64InstructionV0 instruction)))
            (core/basicblock-instructions block))))
      blocks)))

;; Checked-arithmetic types enter the program only where a body lowered a checked
;; operation, so a slice without arithmetic keeps its type set — and the C type
;; indices its committed artifacts already name.
(defn readiness-uses-checked? [(readiness NativeReadinessV0)] Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-checked? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn readiness-uses-host-socket? [(readiness NativeReadinessV0)] Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-host-socket? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn readiness-uses-host-filesystem? [(readiness NativeReadinessV0)] Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-host-filesystem? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn readiness-uses-host-process? [(readiness NativeReadinessV0)] Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-use-host-process? blocks)]
    [(NativeTodoV0 code detail) false]))

(defn readiness-calls-abi?
  [(readiness NativeReadinessV0) (abi-id core/NativeId)] Bool
  (match readiness
    [(NativeReadyV0 operation) false]
    [(NativeLoweredV0 entry-block blocks) (blocks-call-abi? blocks abi-id)]
    [(NativeTodoV0 code detail) false]))

(defn with-effect
  [(effects (Vec core/NativeId)) (effect core/NativeId)] (Vec core/NativeId)
  (if (core/id-in? effects effect) effects (conj effects effect)))

(defn function-writes? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (write-effect-id)))

(defn function-reads? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (read-effect-id)))

(defn function-allocates? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (allocate-effect-id)))

(defn function-uses-atom-state? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (atom-state-effect-id)))

(defn function-uses-environment? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function)
    (host-environment-effect-id)))

(defn function-uses-host-context? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function)
    (host-context-effect-id)))

(defn function-uses-host-clock? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (host-clock-effect-id)))

(defn function-uses-stdout? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (host-stdout-effect-id)))

(defn function-uses-stderr? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (host-stderr-effect-id)))

(defn function-uses-host-filesystem? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function)
    (host-filesystem-effect-id)))

(defn function-uses-host-process? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function)
    (host-process-effect-id)))

(defn function-uses-host-socket? [(function TypedFunctionV0)] Bool
  (core/id-in? (typedfunctionv0-effects function) (host-socket-effect-id)))

(defn any-function-allocates? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-allocates? functions)))

(defn any-function-uses-atom-state? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-atom-state? functions)))

(defn any-function-uses-environment? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-environment? functions)))

(defn any-function-uses-host-context?
  [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-host-context? functions)))

(defn any-function-uses-host-clock? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-host-clock? functions)))

(defn any-function-uses-stdout? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-stdout? functions)))

(defn any-function-uses-stderr? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-stderr? functions)))

(defn any-function-uses-host-filesystem?
  [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-host-filesystem? functions)))

(defn any-function-uses-host-process?
  [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-host-process? functions)))

(defn any-function-uses-host-socket? [(functions (Vec TypedFunctionV0))] Bool
  (some? (some function-uses-host-socket? functions)))

(defn any-function-uses-arena? [(functions (Vec TypedFunctionV0))] Bool
  (some?
    (some
      (fn [(function TypedFunctionV0)] Bool
        (or (function-reads? function)
          (or (function-writes? function) (function-allocates? function))))
      functions)))
(defn attach-body
  [(env BodyEnvV0)
   (resolution FunctionResolutionV0)
   (source-function core/NativeId)]
  FunctionResolutionV0
  (let [(signature TypedFunctionV0) (functionresolutionv0-function resolution)
        (prior NativeReadinessV0) (typedfunctionv0-readiness signature)
        (readiness NativeReadinessV0)
        (cond
          (function-signature-carries-function? (bodyenvv0-types env) signature)
          (->NativeTodoV0 "TODO-NATIVE-FUNCTION-ABI"
            (str (typedfunctionv0-name signature)
              " has a function-bearing parameter or return type; v0 has no closure ABI"))

          (ready-function? signature) prior

          :else (lower-function-body env signature source-function))
        ;; A vector allocation is discovered in the body, not the signature, so
        ;; the effect that admits it is added once the blocks exist.
        (prior-effects (Vec core/NativeId)) (typedfunctionv0-effects signature)
        (allocated-effects (Vec core/NativeId))
        (if (blocks-allocate? (readiness-blocks readiness))
          (with-effect prior-effects (allocate-effect-id))
          prior-effects)
        (read-effects (Vec core/NativeId))
        (if (blocks-use-buffer-read? (readiness-blocks readiness))
          (with-effect allocated-effects (read-effect-id))
          allocated-effects)
        (write-effects (Vec core/NativeId))
        (if (blocks-use-buffer-write? (readiness-blocks readiness))
          (with-effect read-effects (write-effect-id))
          read-effects)
        (atom-effects (Vec core/NativeId))
        (if (blocks-use-atom-state? (readiness-blocks readiness))
          (with-effect write-effects (atom-state-effect-id))
          write-effects)
        (environment-effects (Vec core/NativeId))
        (if (blocks-use-host-environment? (readiness-blocks readiness))
          (with-effect atom-effects (host-environment-effect-id))
          atom-effects)
        (context-effects (Vec core/NativeId))
        (if (blocks-use-host-context? (readiness-blocks readiness))
          (with-effect environment-effects (host-context-effect-id))
          environment-effects)
        (stdout-effects (Vec core/NativeId))
        (if (blocks-use-host-stdout? (readiness-blocks readiness))
          (with-effect context-effects (host-stdout-effect-id))
          context-effects)
        (stderr-effects (Vec core/NativeId))
        (if (blocks-use-host-stderr? (readiness-blocks readiness))
          (with-effect stdout-effects (host-stderr-effect-id))
          stdout-effects)
        (filesystem-effects (Vec core/NativeId))
        (if (blocks-use-host-filesystem? (readiness-blocks readiness))
          (with-effect stderr-effects (host-filesystem-effect-id))
          stderr-effects)
        (process-effects (Vec core/NativeId))
        (if (blocks-use-host-process? (readiness-blocks readiness))
          (with-effect filesystem-effects (host-process-effect-id))
          filesystem-effects)
        (socket-effects (Vec core/NativeId))
        (if (blocks-use-host-socket? (readiness-blocks readiness))
          (with-effect process-effects (host-socket-effect-id))
          process-effects)
        (effects (Vec core/NativeId))
        (if (blocks-use-host-clock? (readiness-blocks readiness))
          (with-effect socket-effects (host-clock-effect-id))
          socket-effects)
        (encoding String)
        (encode-typed-function
          (typedfunctionv0-id signature)
          (typedfunctionv0-name signature)
          (typedfunctionv0-abi-symbol signature)
          (typedfunctionv0-parameters signature)
          (typedfunctionv0-return-type signature)
          (typedfunctionv0-failure-type signature)
          effects
          (readiness-code readiness))
        (lowered TypedFunctionV0)
        (with
          (with (with signature [:readiness readiness]) [:effects effects])
          [:encoding encoding])]
    (->FunctionResolutionV0
      lowered
      (let [(checked-definitions (Vec core/TypeDef))
            (if (readiness-uses-checked? readiness)
              (append-type-defs (functionresolutionv0-definitions resolution)
                (checked-arithmetic-types))
              (functionresolutionv0-definitions resolution))]
        (let [(filesystem-definitions (Vec core/TypeDef))
            (if (or (readiness-uses-host-filesystem? readiness)
                    (readiness-calls-abi? readiness
                      (host-wall-clock-abi-id "format-iso8601"))
                    (readiness-calls-abi? readiness
                      (host-context-abi-id "system-hostname")))
                (append-type-defs checked-definitions
                  (filesystem-outcome-types))
                checked-definitions)]
          (let [(process-definitions (Vec core/TypeDef))
                (if (or
                      (readiness-calls-abi? readiness
                        (host-process-capture-abi-id))
                      (readiness-calls-abi? readiness
                        (host-process-lifecycle-abi-id "spawn-stdout"))
                      (readiness-calls-abi? readiness
                        (host-process-lifecycle-abi-id "read-line-bounded"))
                      (readiness-calls-abi? readiness
                        (host-process-lifecycle-abi-id "read-line-deadline")))
                  (append-type-defs filesystem-definitions
                    (process-outcome-types))
                  filesystem-definitions)]
            (if (readiness-uses-host-socket? readiness)
              (append-type-defs process-definitions (socket-outcome-types))
              process-definitions))))
      (if (ready-function? lowered)
        (functionresolutionv0-diagnostics resolution)
        (conj (functionresolutionv0-diagnostics resolution)
          (core/->DiagnosticV0 "TODO-NATIVE-FUNCTION-BODY"
            (readiness-detail readiness))))
      (functionresolutionv0-valid resolution))))

(defn attach-bodies
  [(env BodyEnvV0)
   (resolutions (Vec FunctionResolutionV0))
   (sources (Vec core/NativeId))]
  (Vec FunctionResolutionV0)
  (loop [(position Int) 0 (attached (Vec FunctionResolutionV0)) []]
    (if (>= position (count resolutions))
      attached
      (recur (+ position 1)
        (conj attached
          (if (>= position (count sources))
            (nth resolutions position)
            (attach-body env (nth resolutions position)
              (nth sources position))))))))

(defn instruction-callee [(instruction core/Instruction)] (U core/NativeId Nil)
  (cond
    (instance? native.core.CallInstruction instruction)
    (core/callinstruction-function-id instruction)
    (instance? native.core.AtomSwapInstruction instruction)
    (core/atomswapinstruction-updater-id instruction)
    (instance? native.core.TiledStepF64InstructionV0 instruction)
    (core/tiledstepf64instructionv0-kernel-id instruction)
    :else nil))

(defn body-call-targets [(function TypedFunctionV0)] (Vec core/NativeId)
  (let [(blocks (Vec core/BasicBlock)) (function-body-blocks function)]
    (loop [(position Int) 0 (targets (Vec core/NativeId)) []]
      (if (>= position (count blocks))
        targets
        (let [(instructions (Vec core/Instruction))
              (core/basicblock-instructions (nth blocks position))]
          (recur (+ position 1)
            (loop [(inner Int) 0 (collected (Vec core/NativeId)) targets]
              (if (>= inner (count instructions))
                collected
                (let [(callee (U core/NativeId Nil))
                      (instruction-callee (nth instructions inner))]
                  (recur (+ inner 1)
                    (if (nil? callee) collected (conj collected callee))))))))))))

;; The graph is constructed once in source function and instruction order.
;; Reverse caller vectors retain that order, so both worklists are deterministic.
(defrecord FunctionCallGraphV0
  [(function-count Int)
   (call-edge-count Int)
   (reverse-callers (Map String (Vec core/NativeId)))
   (unresolved-callers (Map String Bool))])

(defrecord CallGraphBuildV0
  [(reverse-callers (Map String (Vec core/NativeId)))
   (unresolved-callers (Map String Bool))
   (call-edge-count Int)])

(defrecord ReadinessSeedV0
  [(not-ready (Map String Bool)) (queue (Vec core/NativeId))])

(defrecord ReadinessPropagationV0
  [(not-ready (Map String Bool)) (queue (Vec core/NativeId)) (edge-visits Int)])

(defrecord ReadinessSettlementV0
  [(functions (Vec TypedFunctionV0)) (edge-visits Int)])

(defrecord EffectSeedV0
  [(masks (Map String (Map String Bool)))
   (pending (Map String (Map String Bool)))
   (queued (Map String Bool))
   (queue (Vec core/NativeId))])

(defrecord EffectMaskMergeV0
  [(mask (Map String Bool)) (added (Map String Bool)) (changed Bool)])

(defrecord EffectPropagationV0
  [(masks (Map String (Map String Bool)))
   (pending (Map String (Map String Bool)))
   (queued (Map String Bool))
   (queue (Vec core/NativeId))
   (edge-visits Int)])

(defrecord EffectSettlementV0
  [(functions (Vec TypedFunctionV0)) (edge-visits Int)])

(defrecord FunctionClosureMetricsV0
  [(function-count Int)
   (call-edge-count Int)
   (effect-kind-count Int)
   (readiness-edge-visits Int)
   (effect-edge-visits Int)])

(defrecord FunctionClosureSettlementV0
  [(functions (Vec TypedFunctionV0)) (metrics FunctionClosureMetricsV0)])

(defn function-id-index [(functions (Vec TypedFunctionV0))] (Map String Bool)
  (loop [(position Int) 0 (ids (Map String Bool)) {}]
    (if (>= position (count functions))
      ids
      (recur (+ position 1)
        (assoc ids
          (id-value (typedfunctionv0-id (nth functions position))) true)))))

(defn reverse-callers-at
  [(graph FunctionCallGraphV0) (callee core/NativeId)] (Vec core/NativeId)
  (let [(found (U (Vec core/NativeId) Nil))
        (get (functioncallgraphv0-reverse-callers graph) (id-value callee))]
    (if (nil? found) [] found)))

(defn build-function-call-graph
  [(functions (Vec TypedFunctionV0))] FunctionCallGraphV0
  (let [(known (Map String Bool)) (function-id-index functions)
        (built CallGraphBuildV0)
        (loop [(position Int) 0
               (reverse-callers (Map String (Vec core/NativeId))) {}
               (unresolved-callers (Map String Bool)) {}
               (call-edge-count Int) 0]
          (if (>= position (count functions))
            (->CallGraphBuildV0 reverse-callers unresolved-callers
              call-edge-count)
            (let [(caller TypedFunctionV0) (nth functions position)
                  (caller-id core/NativeId) (typedfunctionv0-id caller)
                  (targets (Vec core/NativeId)) (body-call-targets caller)
                  (next CallGraphBuildV0)
                  (loop [(target-position Int) 0
                         (current-reverse (Map String (Vec core/NativeId)))
                         reverse-callers
                         (current-unresolved (Map String Bool))
                         unresolved-callers
                         (current-count Int) call-edge-count]
                    (if (>= target-position (count targets))
                      (->CallGraphBuildV0 current-reverse current-unresolved
                        current-count)
                      (let [(target core/NativeId) (nth targets target-position)
                            (target-key String) (id-value target)
                            (internal Bool) (= true (get known target-key))
                            (prior (U (Vec core/NativeId) Nil))
                            (get current-reverse target-key)
                            (callers (Vec core/NativeId))
                            (if (nil? prior) [] prior)]
                        (recur (+ target-position 1)
                          (if internal
                            (assoc current-reverse target-key
                              (conj callers caller-id))
                            current-reverse)
                          (if internal
                            current-unresolved
                            (assoc current-unresolved (id-value caller-id) true))
                          (if internal (+ current-count 1) current-count)))))]
              (recur (+ position 1)
                (callgraphbuildv0-reverse-callers next)
                (callgraphbuildv0-unresolved-callers next)
                (callgraphbuildv0-call-edge-count next)))))]
    (->FunctionCallGraphV0 (count functions)
      (callgraphbuildv0-call-edge-count built)
      (callgraphbuildv0-reverse-callers built)
      (callgraphbuildv0-unresolved-callers built))))

(defn seed-not-ready
  [(functions (Vec TypedFunctionV0))
   (graph FunctionCallGraphV0)]
  ReadinessSeedV0
  (loop [(position Int) 0
         (not-ready (Map String Bool)) {}
         (queue (Vec core/NativeId)) []]
    (if (>= position (count functions))
      (->ReadinessSeedV0 not-ready queue)
      (let [(function TypedFunctionV0) (nth functions position)
            (function-id core/NativeId) (typedfunctionv0-id function)
            (key String) (id-value function-id)
            (seed Bool)
            (or (not (ready-function? function))
              (= true
                (get (functioncallgraphv0-unresolved-callers graph) key)))]
        (recur (+ position 1)
          (if seed (assoc not-ready key true) not-ready)
          (if seed (conj queue function-id) queue))))))

(defn propagate-not-ready
  [(graph FunctionCallGraphV0) (seed ReadinessSeedV0)] ReadinessPropagationV0
  (loop [(cursor Int) 0
         (not-ready (Map String Bool)) (readinessseedv0-not-ready seed)
         (queue (Vec core/NativeId)) (readinessseedv0-queue seed)
         (edge-visits Int) 0]
    (if (>= cursor (count queue))
      (->ReadinessPropagationV0 not-ready queue edge-visits)
      (let [(callers (Vec core/NativeId))
            (reverse-callers-at graph (nth queue cursor))
            (next ReadinessPropagationV0)
            (loop [(position Int) 0
                   (current-not-ready (Map String Bool)) not-ready
                   (current-queue (Vec core/NativeId)) queue
                   (current-visits Int) edge-visits]
              (if (>= position (count callers))
                (->ReadinessPropagationV0 current-not-ready current-queue
                  current-visits)
                (let [(caller core/NativeId) (nth callers position)
                      (key String) (id-value caller)
                      (already Bool) (= true (get current-not-ready key))]
                  (recur (+ position 1)
                    (if already current-not-ready
                      (assoc current-not-ready key true))
                    (if already current-queue (conj current-queue caller))
                    (+ current-visits 1)))))]
        (recur (+ cursor 1)
          (readinesspropagationv0-not-ready next)
          (readinesspropagationv0-queue next)
          (readinesspropagationv0-edge-visits next))))))

(defn apply-readiness-closure
  [(functions (Vec TypedFunctionV0))
   (not-ready (Map String Bool))]
  (Vec TypedFunctionV0)
  (mapv
    (fn [(function TypedFunctionV0)] TypedFunctionV0
      (if (and (ready-function? function)
            (= true
              (get not-ready (id-value (typedfunctionv0-id function)))))
        (with function
          [:readiness
           (->NativeTodoV0 "TODO-NATIVE-FUNCTION-BODY"
             (str "TODO-NATIVE-CALLEE: " (typedfunctionv0-name function)
               " calls a function whose own body is not lowered"))])
        function))
    functions))

(defn settle-readiness-on-graph
  [(functions (Vec TypedFunctionV0))
   (graph FunctionCallGraphV0)]
  ReadinessSettlementV0
  (let [(propagated ReadinessPropagationV0)
        (propagate-not-ready graph (seed-not-ready functions graph))]
    (->ReadinessSettlementV0
      (apply-readiness-closure functions
        (readinesspropagationv0-not-ready propagated))
      (readinesspropagationv0-edge-visits propagated))))

;; Pure remains the first serialized marker. The structural metric counts the
;; twelve transitive effect bits that authorize reads, writes, allocation and
;; host capabilities; C123's host-context bit is included.
(defn closure-effect-order [] (Vec core/NativeId)
  [(pure-effect-id)
   (read-effect-id)
   (write-effect-id)
   (allocate-effect-id)
   (atom-state-effect-id)
   (host-environment-effect-id)
   (host-context-effect-id)
   (host-stdout-effect-id)
   (host-stderr-effect-id)
   (host-filesystem-effect-id)
   (host-process-effect-id)
   (host-socket-effect-id)
   (host-clock-effect-id)])

(defn closure-effect-kind-count [] Int 12)

(defn function-effect-mask [(function TypedFunctionV0)] (Map String Bool)
  (let [(order (Vec core/NativeId)) (closure-effect-order)]
    (loop [(position Int) 0 (mask (Map String Bool)) {}]
      (if (>= position (count order))
        mask
        (let [(effect core/NativeId) (nth order position)]
          (recur (+ position 1)
            (if (core/id-in? (typedfunctionv0-effects function) effect)
              (assoc mask (id-value effect) true)
              mask)))))))

(defn effect-mask-at
  [(masks (Map String (Map String Bool)))
   (function-id core/NativeId)]
  (Map String Bool)
  (let [(found (U (Map String Bool) Nil)) (get masks (id-value function-id))]
    (if (nil? found) {} found)))

(defn merge-effect-mask
  [(mask (Map String Bool)) (incoming (Map String Bool))] EffectMaskMergeV0
  (let [(order (Vec core/NativeId)) (closure-effect-order)]
    (loop [(position Int) 0
           (current (Map String Bool)) mask
           (added (Map String Bool)) {}
           (changed Bool) false]
      (if (>= position (count order))
        (->EffectMaskMergeV0 current added changed)
        (let [(key String) (id-value (nth order position))
              (new Bool)
              (and (= true (get incoming key))
                (not (= true (get current key))))]
          (recur (+ position 1)
            (if new (assoc current key true) current)
            (if new (assoc added key true) added)
            (or changed new)))))))

(defn seed-effects [(functions (Vec TypedFunctionV0))] EffectSeedV0
  (loop [(position Int) 0
         (masks (Map String (Map String Bool))) {}
         (pending (Map String (Map String Bool))) {}
         (queued (Map String Bool)) {}
         (queue (Vec core/NativeId)) []]
    (if (>= position (count functions))
      (->EffectSeedV0 masks pending queued queue)
      (let [(function TypedFunctionV0) (nth functions position)
            (function-id core/NativeId) (typedfunctionv0-id function)
            (key String) (id-value function-id)
            (mask (Map String Bool)) (function-effect-mask function)
            (seed Bool) (and (ready-function? function) (> (count mask) 0))]
        (recur (+ position 1)
          (assoc masks key mask)
          (if seed (assoc pending key mask) pending)
          (if seed (assoc queued key true) queued)
          (if seed (conj queue function-id) queue))))))

(defn ready-function-index [(functions (Vec TypedFunctionV0))] (Map String Bool)
  (loop [(position Int) 0 (ready (Map String Bool)) {}]
    (if (>= position (count functions))
      ready
      (let [(function TypedFunctionV0) (nth functions position)]
        (recur (+ position 1)
          (assoc ready (id-value (typedfunctionv0-id function))
            (ready-function? function)))))))

(defn propagate-effects
  [(functions (Vec TypedFunctionV0))
   (graph FunctionCallGraphV0)]
  EffectPropagationV0
  (let [(ready (Map String Bool)) (ready-function-index functions)
        (seed EffectSeedV0) (seed-effects functions)]
    (loop [(cursor Int) 0
           (masks (Map String (Map String Bool))) (effectseedv0-masks seed)
           (pending (Map String (Map String Bool))) (effectseedv0-pending seed)
           (queued (Map String Bool)) (effectseedv0-queued seed)
           (queue (Vec core/NativeId)) (effectseedv0-queue seed)
           (edge-visits Int) 0]
      (if (>= cursor (count queue))
        (->EffectPropagationV0 masks pending queued queue edge-visits)
        (let [(callee core/NativeId) (nth queue cursor)
              (callee-key String) (id-value callee)
              (incoming (Map String Bool)) (effect-mask-at pending callee)
              (callers (Vec core/NativeId)) (reverse-callers-at graph callee)
              (base-pending (Map String (Map String Bool)))
              (assoc pending callee-key {})
              (base-queued (Map String Bool)) (assoc queued callee-key false)
              (next EffectPropagationV0)
              (loop [(position Int) 0
                     (current-masks (Map String (Map String Bool))) masks
                     (current-pending (Map String (Map String Bool))) base-pending
                     (current-queued (Map String Bool)) base-queued
                     (current-queue (Vec core/NativeId)) queue
                     (current-visits Int) edge-visits]
                (if (>= position (count callers))
                  (->EffectPropagationV0 current-masks current-pending
                    current-queued current-queue current-visits)
                  (let [(caller core/NativeId) (nth callers position)
                        (caller-key String) (id-value caller)
                        (caller-ready Bool) (= true (get ready caller-key))
                        (prior-mask (Map String Bool))
                        (effect-mask-at current-masks caller)
                        (merged EffectMaskMergeV0)
                        (if caller-ready
                          (merge-effect-mask prior-mask incoming)
                          (->EffectMaskMergeV0 prior-mask {} false))
                        (changed Bool) (effectmaskmergev0-changed merged)
                        (prior-pending (Map String Bool))
                        (effect-mask-at current-pending caller)
                        (pending-merged EffectMaskMergeV0)
                        (merge-effect-mask prior-pending
                          (effectmaskmergev0-added merged))
                        (already-queued Bool)
                        (= true (get current-queued caller-key))]
                    (recur (+ position 1)
                      (if changed
                        (assoc current-masks caller-key
                          (effectmaskmergev0-mask merged))
                        current-masks)
                      (if changed
                        (assoc current-pending caller-key
                          (effectmaskmergev0-mask pending-merged))
                        current-pending)
                      (if (and changed (not already-queued))
                        (assoc current-queued caller-key true)
                        current-queued)
                      (if (and changed (not already-queued))
                        (conj current-queue caller)
                        current-queue)
                      (+ current-visits 1)))))]
          (recur (+ cursor 1)
            (effectpropagationv0-masks next)
            (effectpropagationv0-pending next)
            (effectpropagationv0-queued next)
            (effectpropagationv0-queue next)
            (effectpropagationv0-edge-visits next)))))))

(defn apply-effect-mask
  [(function TypedFunctionV0) (mask (Map String Bool))] TypedFunctionV0
  (let [(order (Vec core/NativeId)) (closure-effect-order)
        (prior-effects (Vec core/NativeId)) (typedfunctionv0-effects function)
        (effects (Vec core/NativeId))
        (loop [(position Int) 0 (current (Vec core/NativeId)) prior-effects]
          (if (>= position (count order))
            current
            (let [(effect core/NativeId) (nth order position)]
              (recur (+ position 1)
                (if (= true (get mask (id-value effect)))
                  (with-effect current effect)
                  current)))))]
    (if (= (count prior-effects) (count effects))
      function
      (with
        (with function [:effects effects])
        [:encoding
         (encode-typed-function
           (typedfunctionv0-id function)
           (typedfunctionv0-name function)
           (typedfunctionv0-abi-symbol function)
           (typedfunctionv0-parameters function)
           (typedfunctionv0-return-type function)
           (typedfunctionv0-failure-type function)
           effects
           (readiness-code (typedfunctionv0-readiness function)))]))))

(defn settle-effects-on-graph
  [(functions (Vec TypedFunctionV0))
   (graph FunctionCallGraphV0)]
  EffectSettlementV0
  (let [(propagated EffectPropagationV0) (propagate-effects functions graph)]
    (->EffectSettlementV0
      (mapv
        (fn [(function TypedFunctionV0)] TypedFunctionV0
          (apply-effect-mask function
            (effect-mask-at (effectpropagationv0-masks propagated)
              (typedfunctionv0-id function))))
        functions)
      (effectpropagationv0-edge-visits propagated))))

(defn settle-function-closures-with-metrics
  [(functions (Vec TypedFunctionV0))] FunctionClosureSettlementV0
  (let [(graph FunctionCallGraphV0) (build-function-call-graph functions)
        (readiness ReadinessSettlementV0)
        (settle-readiness-on-graph functions graph)
        (effects EffectSettlementV0)
        (settle-effects-on-graph
          (readinesssettlementv0-functions readiness) graph)]
    (->FunctionClosureSettlementV0
      (effectsettlementv0-functions effects)
      (->FunctionClosureMetricsV0
        (functioncallgraphv0-function-count graph)
        (functioncallgraphv0-call-edge-count graph)
        (closure-effect-kind-count)
        (readinesssettlementv0-edge-visits readiness)
        (effectsettlementv0-edge-visits effects)))))

(defn settle-function-closures
  [(functions (Vec TypedFunctionV0))] (Vec TypedFunctionV0)
  (functionclosuresettlementv0-functions
    (settle-function-closures-with-metrics functions)))

(defn slice-regions [] (Vec core/RegionDef)
  [(core/->RegionDef (arena-region-id) (core/->ArenaRegion true) nil)
   (core/->RegionDef (atom-state-region-id) (core/->ExternalRegion true) nil)])

(defn slice-capabilities
  [(include-environment Bool)
   (include-context Bool)
   (include-stdout Bool)
   (include-stderr Bool)
   (include-filesystem Bool)
   (include-process Bool)
   (include-socket Bool)
   (include-clock Bool)]
  (Vec core/CapabilityDef)
  (let [(base (Vec core/CapabilityDef))
        [(core/->CapabilityDef
           (read-capability-id)
           (core/->ReadCapability true)
           (arena-region-id)
           true)
         (core/->CapabilityDef
           (write-capability-id)
           (core/->WriteCapability true)
           (arena-region-id)
           true)
         (core/->CapabilityDef
           (allocate-capability-id)
           (core/->AllocateCapability true)
           (arena-region-id)
           true)
         (core/->CapabilityDef
           (atom-state-capability-id)
           (core/->WriteCapability true)
           (atom-state-region-id)
           true)]
        (with-environment (Vec core/CapabilityDef))
        (if include-environment
          (conj base
            (core/->CapabilityDef
              (host-environment-capability-id)
              (core/->HostCapability true)
              nil
              false))
          base)
        (with-context (Vec core/CapabilityDef))
        (if include-context
          (conj with-environment
            (core/->CapabilityDef
              (host-context-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-environment)
        (with-stdout (Vec core/CapabilityDef))
        (if include-stdout
          (conj with-context
            (core/->CapabilityDef
              (host-stdout-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-context)
        (with-stderr (Vec core/CapabilityDef))
        (if include-stderr
          (conj with-stdout
            (core/->CapabilityDef
              (host-stderr-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-stdout)
        (with-filesystem (Vec core/CapabilityDef))
        (if include-filesystem
          (conj with-stderr
            (core/->CapabilityDef
              (host-filesystem-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-stderr)
        (with-process (Vec core/CapabilityDef))
        (if include-process
          (conj with-filesystem
            (core/->CapabilityDef
              (host-process-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-filesystem)
        (with-socket (Vec core/CapabilityDef))
        (if include-socket
          (conj with-process
            (core/->CapabilityDef
              (host-socket-capability-id)
              (core/->HostCapability true)
              nil
              false))
          with-process)]
    (if include-clock
      (conj with-socket
        (core/->CapabilityDef
          (host-clock-capability-id)
          (core/->HostCapability true)
          nil
          false))
      with-socket)))

(defn slice-capability-ids
  [(include-environment Bool)
   (include-context Bool)
   (include-stdout Bool)
   (include-stderr Bool)
   (include-filesystem Bool)
   (include-process Bool)
   (include-socket Bool)
   (include-clock Bool)]
  (Vec core/NativeId)
  (let [(base (Vec core/NativeId))
        [(read-capability-id) (write-capability-id) (allocate-capability-id)
         (atom-state-capability-id)]
        (with-environment (Vec core/NativeId))
        (if include-environment
          (conj base (host-environment-capability-id))
          base)
        (with-context (Vec core/NativeId))
        (if include-context
          (conj with-environment (host-context-capability-id))
          with-environment)
        (with-stdout (Vec core/NativeId))
        (if include-stdout
          (conj with-context (host-stdout-capability-id))
          with-context)
        (with-stderr (Vec core/NativeId))
        (if include-stderr
          (conj with-stdout (host-stderr-capability-id))
          with-stdout)
        (with-filesystem (Vec core/NativeId))
        (if include-filesystem
          (conj with-stderr (host-filesystem-capability-id))
          with-stderr)
        (with-process (Vec core/NativeId))
        (if include-process
          (conj with-filesystem (host-process-capability-id))
          with-filesystem)
        (with-socket (Vec core/NativeId))
        (if include-socket
          (conj with-process (host-socket-capability-id))
          with-process)]
    (if include-clock
      (conj with-socket (host-clock-capability-id))
      with-socket)))

(defn collect-record-types
  [(record-keys (Vec String))
   (resolutions (Vec RecordResolutionV0))]
  (Vec core/TypeDef)
  (loop [(index Int) 0 (definitions (Vec core/TypeDef)) (builtin-types record-keys)]
    (if (>= index (count resolutions))
      definitions
      (let [(resolution RecordResolutionV0) (nth resolutions index)]
        (recur (+ index 1)
          (append-type-defs
            (append-type-def definitions
              (recordresolutionv0-definition resolution))
            (recordresolutionv0-supporting-definitions resolution)))))))

(defn collect-function-types
  [(definitions (Vec core/TypeDef))
   (resolutions (Vec FunctionResolutionV0))]
  (Vec core/TypeDef)
  (loop [(index Int) 0 (current (Vec core/TypeDef)) definitions]
    (if (>= index (count resolutions))
      current
      (recur (+ index 1)
        (append-type-defs current
          (functionresolutionv0-definitions (nth resolutions index)))))))

(defn collect-functions
  [(resolutions (Vec FunctionResolutionV0))] (Vec TypedFunctionV0)
  (mapv
    (fn [(resolution FunctionResolutionV0)] TypedFunctionV0
      (functionresolutionv0-function resolution))
    resolutions))

(defn collect-typing-diagnostics
  [(records (Vec RecordResolutionV0))
   (functions (Vec FunctionResolutionV0))]
  (Vec core/DiagnosticV0)
  (let [(record-diagnostics (Vec core/DiagnosticV0))
        (loop [(index Int) 0 (diagnostics (Vec core/DiagnosticV0)) []]
          (if (>= index (count records))
            diagnostics
            (recur (+ index 1)
              (append-diagnostics diagnostics
                (recordresolutionv0-diagnostics (nth records index))))))]
    (loop [(index Int) 0 (diagnostics (Vec core/DiagnosticV0)) record-diagnostics]
      (if (>= index (count functions))
        diagnostics
        (recur (+ index 1)
          (append-diagnostics diagnostics
            (functionresolutionv0-diagnostics (nth functions index))))))))

(defn typing-resolutions-valid?
  [(records (Vec RecordResolutionV0))
   (functions (Vec FunctionResolutionV0))]
  Bool
  (and
    (every?
      (fn [(resolution RecordResolutionV0)] Bool
        (recordresolutionv0-valid resolution))
      records)
    (every?
      (fn [(resolution FunctionResolutionV0)] Bool
        (functionresolutionv0-valid resolution))
      functions)))

(defn encode-atom-kind [(kind core/AtomKind)] String
  (cond
    (instance? native.core.BoolKind kind) "bool"
    (instance? native.core.I64Kind kind) "i64"
    (instance? native.core.F64Kind kind) "f64"
    (instance? native.core.TextKind kind) "text"
    (instance? native.core.BytesKind kind) "bytes"
    (instance? native.core.KeywordKind kind) "keyword"
    :else (stages/canonical-record "reference-kind"
            [(id-value (core/refkind-target kind))])))

(defn encode-type-field [(field core/TypeField)] String
  (stages/canonical-record "field"
    [(id-value (core/typefield-id field))
     (core/typefield-name field)
     (id-value (core/typefield-type-id field))]))

(defn encode-type-variant [(variant core/TypeVariant)] String
  (let [(payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)]
    (stages/canonical-record "variant"
      [(id-value (core/typevariant-id variant))
       (core/typevariant-name variant)
       (if (nil? payload) "unit" (id-value payload))])))

(defn encode-type-shape [(shape core/TypeShape)] String
  (cond
    (instance? native.core.AtomType shape)
    (stages/canonical-record "atom"
      [(encode-atom-kind (core/atomtype-kind shape))])

    (instance? native.core.RecordType shape)
    (stages/canonical-record "record"
      (mapv
        (fn [(field core/TypeField)] String (encode-type-field field))
        (core/recordtype-fields shape)))

    (instance? native.core.UnionType shape)
    (stages/canonical-record "closed-union"
      (mapv
        (fn [(variant core/TypeVariant)] String (encode-type-variant variant))
        (core/uniontype-variants shape)))

    (instance? native.core.VectorType shape)
    (stages/canonical-record "vector"
      [(id-value (core/vectortype-element-type shape))])

    (instance? native.core.BufferTypeV0 shape)
    (stages/canonical-record "buffer-v0"
      [(id-value (core/buffertypev0-element-type shape))])

    (instance? native.core.MapTypeV0 shape)
    (stages/canonical-record "map-v0"
      [(id-value (core/maptypev0-key-type shape))
       (id-value (core/maptypev0-value-type shape))
       "insertion-order-v0"])

    (instance? native.core.SetTypeV0 shape)
    (stages/canonical-record "set-v0"
      [(id-value (core/settypev0-element-type shape))
       "insertion-order-v0"])

    (instance? native.core.ReferenceType shape)
    (stages/canonical-record "reference"
      [(id-value (core/referencetype-target-type shape))])

    (instance? native.core.FunctionType shape)
    (stages/canonical-record "function"
      [(stages/canonical-record "parameters"
         (mapv
           (fn [(parameter core/NativeId)] String (id-value parameter))
           (core/functiontype-parameter-types shape)))
       (let [(rest-type (U core/NativeId Nil))
             (core/functiontype-rest-type shape)]
         (if (nil? rest-type) "fixed" (id-value rest-type)))
       (id-value (core/functiontype-return-type shape))])

    (instance? native.core.AtomCellTypeV0 shape)
    (stages/canonical-record "atom-cell"
      [(id-value (core/atomcelltypev0-content-type shape))])

    (instance? native.core.OutcomeType shape)
    (stages/canonical-record "outcome"
      [(id-value (core/outcometype-value-type shape))
       (id-value (core/outcometype-failure-type shape))])

    :else "invalid-type-shape"))

(defn encode-type-def [(definition core/TypeDef)] String
  (stages/canonical-record "closed-type-v0"
    [(id-value (core/typedef-id definition))
     (core/typedef-name definition)
     (encode-type-shape (core/typedef-shape definition))]))

(defn encode-effect [(effect core/EffectDef)] String
  (let [(kind core/EffectKind) (core/effectdef-kind effect)
        (kind-encoding String)
        (cond
          (instance? native.core.PureEffect kind) "pure"
          (instance? native.core.AllocateEffect kind)
          (stages/canonical-record "allocate"
            [(id-value (core/allocateeffect-region kind))])
          (instance? native.core.ReadEffect kind)
          (stages/canonical-record "read"
            [(id-value (core/readeffect-region kind))])
          (instance? native.core.WriteEffect kind)
          (stages/canonical-record "write"
            [(id-value (core/writeeffect-region kind))])
          (instance? native.core.CapabilityEffect kind)
          (stages/canonical-record "capability"
            [(id-value (core/capabilityeffect-capability kind))])
          (instance? native.core.IoEffect kind)
          (stages/canonical-record "io"
            [(id-value (core/ioeffect-capability kind))])
          (instance? native.core.SocketEffect kind)
          (stages/canonical-record "socket"
            [(id-value (core/socketeffect-capability kind))])
          (instance? native.core.ClockEffect kind)
          (stages/canonical-record "clock"
            [(id-value (core/clockeffect-capability kind))])
          :else
          (stages/canonical-record "atomic"
            [(id-value (core/atomiceffect-region kind))
             (id-value (core/atomiceffect-capability kind))]))]
    (stages/canonical-record "effect-v0"
      [(id-value (core/effectdef-id effect)) kind-encoding])))

(defn typed-term-nodes
  [(types (Vec core/TypeDef))
   (functions (Vec TypedFunctionV0))
   (effects (Vec core/EffectDef))
   (include-environment Bool)
   (include-context Bool)
   (include-stdout Bool)
   (include-stderr Bool)
   (include-filesystem Bool)
   (include-process Bool)
   (include-socket Bool)
   (include-clock Bool)]
  (Vec stages/TermNodeV0)
  (let [(type-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(definition core/TypeDef)] stages/TermNodeV0
            (stages/->TermNodeV0
              (core/typedef-id definition)
              (stages/->TextTermV0 (encode-type-def definition))))
          types)
        (function-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(function TypedFunctionV0)] stages/TermNodeV0
            (stages/->TermNodeV0
              (typedfunctionv0-id function)
              (stages/->TextTermV0 (typedfunctionv0-encoding function))))
          functions)
        (effect-nodes (Vec stages/TermNodeV0))
        (mapv
          (fn [(effect core/EffectDef)] stages/TermNodeV0
            (stages/->TermNodeV0
              (core/effectdef-id effect)
              (stages/->TextTermV0 (encode-effect effect))))
          effects)
        (region-node stages/TermNodeV0)
        (stages/->TermNodeV0 (arena-region-id)
          (stages/->TextTermV0
            (stages/canonical-record "region-v0"
              [(id-value (arena-region-id)) "arena"])))
        (capability-node stages/TermNodeV0)
        (stages/->TermNodeV0 (write-capability-id)
          (stages/->TextTermV0
            (stages/canonical-record "capability-v0"
              [(id-value (write-capability-id))
               (id-value (arena-region-id))
               "affine-write"])))
        (environment-capability-nodes (Vec stages/TermNodeV0))
        (if include-environment
          [(stages/->TermNodeV0 (host-environment-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-environment-capability-id))
                  "host-environment"
                  "non-affine"])))]
          [])
        (context-capability-nodes (Vec stages/TermNodeV0))
        (if include-context
          [(stages/->TermNodeV0 (host-context-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-context-capability-id))
                  "host-context-read-v0"
                  "non-affine"])))]
          [])
        (stdout-capability-nodes (Vec stages/TermNodeV0))
        (if include-stdout
          [(stages/->TermNodeV0 (host-stdout-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-stdout-capability-id))
                  "host-stdout"
                  "non-affine"])))]
          [])
        (stderr-capability-nodes (Vec stages/TermNodeV0))
        (if include-stderr
          [(stages/->TermNodeV0 (host-stderr-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-stderr-capability-id))
                  "host-stderr"
                  "non-affine"])))]
          [])
        (filesystem-capability-nodes (Vec stages/TermNodeV0))
        (if include-filesystem
          [(stages/->TermNodeV0 (host-filesystem-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-filesystem-capability-id))
                  "host-filesystem-v0"
                  "non-affine"])))]
          [])
        (process-capability-nodes (Vec stages/TermNodeV0))
        (if include-process
          [(stages/->TermNodeV0 (host-process-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-process-capability-id))
                  "host-process-run-inherit-v0"
                  "non-affine"])))]
          [])
        (socket-capability-nodes (Vec stages/TermNodeV0))
        (if include-socket
          [(stages/->TermNodeV0 (host-socket-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-socket-capability-id))
                  "host-socket-peer-lifecycle-v0"
                  "non-affine"])))]
          [])
        (clock-capability-nodes (Vec stages/TermNodeV0))
        (if include-clock
          [(stages/->TermNodeV0 (host-clock-capability-id)
             (stages/->TextTermV0
               (stages/canonical-record "capability-v0"
                 [(id-value (host-clock-capability-id))
                  "host-monotonic-clock-v0"
                  "non-affine"])))]
          [])]
    (vec (concat type-nodes function-nodes effect-nodes
           [region-node capability-node] environment-capability-nodes
           context-capability-nodes
           stdout-capability-nodes stderr-capability-nodes
           filesystem-capability-nodes process-capability-nodes
           socket-capability-nodes
           clock-capability-nodes))))

(defn hosted-only-text? [(value String)] Bool
  (or (= value "Any")
      (= value "Atom")
      (= value "Map")
      (= value "Set")
      (= value "throw")
      (= value "ex-info")
      (= value "#lang")
      (= value "clj")
      (= value "js")
      (= value "nix")))

(defn term-is-clean? [(term stages/TermV0)] Bool
  (if (instance? native.stages.TextTermV0 term)
    (not (hosted-only-text? (stages/texttermv0-value term)))
    true))

(defn term-graph-clean? [(graph stages/TermGraphV0)] Bool
  (every?
    (fn [(node stages/TermNodeV0)] Bool
      (term-is-clean? (stages/termnodev0-term node)))
    (stages/termgraphv0-nodes graph)))

(defn encode-id-roots [(tag String) (roots (Vec core/NativeId))] String
  (stages/canonical-set tag
    (mapv (fn [(id core/NativeId)] String (id-value id)) roots)))

(defn function-todo-obligations
  [(functions (Vec TypedFunctionV0))
   (subject-digest String)]
  (Vec core/ReceiptObligationV0)
  (loop [(index Int) 0 (obligations (Vec core/ReceiptObligationV0)) []]
    (if (>= index (count functions))
      obligations
      (let [(function TypedFunctionV0) (nth functions index)
            (readiness NativeReadinessV0) (typedfunctionv0-readiness function)]
        (match readiness
          [(NativeReadyV0 operation) (recur (+ index 1) obligations)]
          [(NativeLoweredV0 entry-block blocks) (recur (+ index 1) obligations)]
          [(NativeTodoV0 code detail)
           (recur (+ index 1)
             (conj obligations
               (core/->ReceiptObligationV0
                 (core/->ValidSsaObligation true)
                 "v0" subject-digest false (str code ": " detail))))])))))

(defn type-closure-obligations
  [(digest String) (closed Bool) (clean Bool)] (Vec core/ReceiptObligationV0)
  [(core/->ReceiptObligationV0
     (core/->ClosedLayoutsObligation true) "v0" digest closed
     "every reachable type is a closed Native Core TypeShape")
   (core/->ReceiptObligationV0
     (core/->BoundedEffectsObligation true) "v0" digest clean
     "typed Terms contain no raw Any, host exception, host collection, or target syntax")])

;; The shared setup every function body reads and no function body produces.
;; A body may only be attached against a prelude that is already complete, so
;; the cut is exactly at the body environment: index, resolutions, and every
;; declaration, global, and literal support type close here, and the types a
;; body itself contributes close after.
(defrecord TypingPreludeV0
  [(env BodyEnvV0)
   (record-resolutions (Vec RecordResolutionV0))
   (signature-resolutions (Vec FunctionResolutionV0))
   (record-keys (Vec String))
   (source-digest String)])

(defn prepare-typing-prelude
  [(frozen-source stages/FrozenSourceStageV1)] TypingPreludeV0
  (let [(source stages/SourceStageV1)
        (stages/frozensourcestagev1-stage frozen-source)
        (source-digest String) (stages/frozensourcestagev1-digest frozen-source)
        (graph stages/TermGraphV0) (stages/sourcestagev1-terms source)
        (index SourceIndexV0)
        (build-source-index graph (stages/sourcestagev1-modules source))
        (record-keys (Vec String)) (sourceindexv0-record-keys index)
        (record-resolutions (Vec RecordResolutionV0)) (resolve-records index)
        (function-sources (Vec core/NativeId)) (index-form-ids index "defn")
        (signature-resolutions (Vec FunctionResolutionV0)) (resolve-functions index)
        (base-record-types (Vec core/TypeDef))
        (collect-record-types record-keys record-resolutions)
        (declared-union-types (Vec core/TypeDef))
        (source-union-types index)
        (record-types (Vec core/TypeDef))
        (if (index-has-callee? index "re-find")
          (append-type-def
            (append-type-defs base-record-types declared-union-types)
            (regex-match-type))
          (append-type-defs base-record-types declared-union-types))
        (globals (Vec GlobalBindingV0)) (source-globals index)
        (declared-types (Vec core/TypeDef))
        (append-type-defs
          (append-type-defs
            (append-type-defs record-types (global-type-definitions index globals))
            (binding-type-definitions index))
          (literal-vector-type-definitions index))
        (base-source-types (Vec core/TypeDef))
        (collect-function-types declared-types signature-resolutions)
        ;; Text search lowers through an optional index even when the authored
        ;; result is Bool, so its hidden result type must precede body lowering.
        (text-index-source-types (Vec core/TypeDef))
        (if (or
              (index-has-callee? index "str/index-of")
              (index-has-callee? index "str/includes?"))
          (append-type-def base-source-types
            (nullable-map-value-type (int-type-id)))
          base-source-types)
        (source-types (Vec core/TypeDef))
        (if (or
              (index-has-callee? index "host.fs/path-kind")
              (index-has-callee? index "host.fs/read-text-bounded")
              (index-has-callee? index "host.fs/list-directory-bounded")
              (index-has-callee? index "host.fs/write-text-atomic")
              (index-has-callee? index "host.fs/make-parent-directories")
              (index-has-callee? index "host.fs/append-text")
              (index-has-callee? index "host.fs/lock-exclusive")
              (index-has-callee? index "host.fs/unlock")
              (index-has-callee? index "host.clock/format-iso8601")
              (index-has-callee? index "host.system/hostname"))
          (append-type-defs text-index-source-types (filesystem-outcome-types))
          text-index-source-types)
        (process-source-types (Vec core/TypeDef))
        (if (or
              (index-has-callee? index "host.process/run-capture")
              (index-has-callee? index "host.process/spawn-stdout")
              (index-has-callee? index "host.process/read-line-bounded")
              (index-has-callee? index "host.process/read-line-deadline"))
          (append-type-defs source-types (process-outcome-types))
          source-types)
        (signatures (Vec TypedFunctionV0)) (collect-functions signature-resolutions)]
    (->TypingPreludeV0
      (->BodyEnvV0 index process-source-types signatures function-sources
        globals)
      record-resolutions signature-resolutions record-keys source-digest)))

(defn lower-typed-stage
  [(frozen-source stages/FrozenSourceStageV1)
   (compiler-commit String)
   (configuration (Vec String))]
  TypingResultV0
  (let [(source stages/SourceStageV1)
        (stages/frozensourcestagev1-stage frozen-source)
        (graph stages/TermGraphV0) (stages/sourcestagev1-terms source)
        (prelude TypingPreludeV0) (prepare-typing-prelude frozen-source)
        (source-digest String) (typingpreludev0-source-digest prelude)
        (env BodyEnvV0) (typingpreludev0-env prelude)
        (record-resolutions (Vec RecordResolutionV0))
        (typingpreludev0-record-resolutions prelude)
        (signature-resolutions (Vec FunctionResolutionV0))
        (typingpreludev0-signature-resolutions prelude)
        (function-sources (Vec core/NativeId)) (bodyenvv0-signature-sources env)
        (process-source-types (Vec core/TypeDef)) (bodyenvv0-types env)
        (function-resolutions (Vec FunctionResolutionV0))
        (attach-bodies env signature-resolutions function-sources)
        (functions (Vec TypedFunctionV0))
        (settle-function-closures (collect-functions function-resolutions))
        (uses-environment Bool) (any-function-uses-environment? functions)
        (uses-context Bool) (any-function-uses-host-context? functions)
        (uses-stdout Bool) (any-function-uses-stdout? functions)
        (uses-stderr Bool) (any-function-uses-stderr? functions)
        (uses-filesystem Bool) (any-function-uses-host-filesystem? functions)
        (uses-process Bool) (any-function-uses-host-process? functions)
        (sockets Bool) (any-function-uses-host-socket? functions)
        (clock Bool) (any-function-uses-host-clock? functions)
        ;; Bodies contribute types of their own (checked arithmetic answers an
        ;; Outcome), so the program's type set closes only after they lower.
        (body-types (Vec core/TypeDef))
        (collect-function-types process-source-types function-resolutions)
        (arena-types (Vec core/TypeDef))
        (if (any-function-uses-arena? functions)
          (append-type-def body-types (arena-handle-type))
          body-types)
        (types (Vec core/TypeDef))
        (if (any-function-uses-atom-state? functions)
          (append-type-def arena-types (atom-state-handle-type))
          arena-types)
        (effects (Vec core/EffectDef))
        (slice-effects uses-environment uses-context uses-stdout uses-stderr
          uses-filesystem uses-process
          sockets clock)
        (regions (Vec core/RegionDef)) (slice-regions)
        (capabilities (Vec core/CapabilityDef))
        (slice-capabilities uses-environment uses-context uses-stdout uses-stderr
          uses-filesystem uses-process sockets clock)
        (root core/NativeId) (lower-id "typed-stage" [source-digest])
        (nodes (Vec stages/TermNodeV0))
        (typed-term-nodes types functions effects uses-environment uses-context uses-stdout
          uses-stderr uses-filesystem uses-process sockets clock)
        (terms stages/TermGraphV0)
        (stages/->TermGraphV0 root
          (conj nodes
            (stages/->TermNodeV0 root
              (stages/->TextTermV0 "typed-stage-v0"))))
        (typed-stage stages/TypedStageV0)
        (stages/->TypedStageV0
          terms
          source-digest
          (mapv (fn [(definition core/TypeDef)] core/NativeId
                  (core/typedef-id definition)) types)
          (mapv (fn [(function TypedFunctionV0)] core/NativeId
                  (typedfunctionv0-id function)) functions)
          (mapv (fn [(effect core/EffectDef)] core/NativeId
                  (core/effectdef-id effect)) effects)
          [(arena-region-id) (atom-state-region-id)]
        (slice-capability-ids uses-environment uses-context uses-stdout uses-stderr
          uses-filesystem uses-process sockets clock)
          [(type-id "LowerFailure")])
        (encoding String) (stages/encode-typed-stage typed-stage)
        (digest String) (stages/content-digest encoding)
        (resolutions-valid Bool)
        (typing-resolutions-valid? record-resolutions function-resolutions)
        (types-closed Bool) (core/types-refs-closed? types)
        (clean Bool) (term-graph-clean? terms)
        (valid Bool)
        (and resolutions-valid types-closed clean)
        (diagnostics (Vec core/DiagnosticV0))
        (collect-typing-diagnostics record-resolutions function-resolutions)
        (obligations (Vec core/ReceiptObligationV0))
        (vec (concat (type-closure-obligations digest types-closed clean)
               (function-todo-obligations functions digest)))]
    (if valid
      (->TypingAcceptedV0
        (stages/->FrozenTypedStageV0 typed-stage encoding digest)
        (->TypedSliceV0 types functions effects regions capabilities
          [(type-id "LowerFailure")])
        (make-receipt source-digest compiler-commit "source-to-typed"
          configuration diagnostics obligations digest))
      (->TypingRejectedV0
        (->UnresolvedSourceTypeV0
          (stages/termgraphv0-root graph)
          "one or more source annotations do not close over Native Core types")
        (make-receipt source-digest compiler-commit "source-to-typed"
          configuration diagnostics obligations "")))))

(defrecord LayoutMeasureV0
  [(size-bytes Int) (align-bytes Int) (closed Bool) (detail String)])

(defrecord LayoutResolutionV0
  [(layout core/LayoutDef) (closed Bool) (detail String)])

(defunion NativeLoweringResultV0
  (NativeLoweringCompleteV0
    [(frozen stages/FrozenNativeStageV0) (receipt core/PassReceiptV0)])
  (NativeLoweringPendingV0
    [(frozen stages/FrozenNativeStageV0)
     (receipt core/PassReceiptV0)
     (obligations (Vec core/ReceiptObligationV0))]))

(defn align-up [(offset Int) (alignment Int)] Int
  (if (= 0 alignment)
    offset
    (let [(remainder Int) (mod offset alignment)]
      (if (= 0 remainder) offset (+ offset (- alignment remainder))))))

(defn max-int [(left Int) (right Int)] Int
  (if (> left right) left right))

(defn find-type-def
  [(types (Vec core/TypeDef)) (target core/NativeId)] (U core/TypeDef Nil)
  (loop [(index Int) 0]
    (if (>= index (count types))
      nil
      (let [(definition core/TypeDef) (nth types index)]
        (if (same-id? target (core/typedef-id definition))
          definition
          (recur (+ index 1)))))))

;; The alternatives an Outcome dispatches on: its failure union's variants.
(defn outcome-variants
  [(types (Vec core/TypeDef))
   (failure-type core/NativeId)]
  (Vec core/TypeVariant)
  (let [(definition (U core/TypeDef Nil)) (find-type-def types failure-type)
        (shape core/TypeShape)
        (if (nil? definition) (core/->UnionType []) (core/typedef-shape definition))]
    (if (instance? native.core.UnionType shape)
      (core/uniontype-variants shape)
      [])))

;; Every width the target ABI owns enters layout measurement here; scalar bit
;; widths and the i64 union tag are target-neutral and stay literal.
(defn measure-type
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (depth Int)
   (abi core/AbiProfileV0)]
  LayoutMeasureV0
  (let [(pointer-bytes Int) (core/abiprofilev0-pointer-bytes abi)
        (pointer-align Int) (core/abiprofilev0-pointer-align abi)]
    (if (> depth 32)
      (->LayoutMeasureV0 pointer-bytes pointer-align false
        (str "recursive value layout requires an explicit reference edge: "
          (id-value target)))
      (let [(definition (U core/TypeDef Nil)) (find-type-def types target)]
        (if (nil? definition)
          (->LayoutMeasureV0 pointer-bytes pointer-align false
            (str "layout target has no TypeDef: " (id-value target)))
          (let [(shape core/TypeShape) (core/typedef-shape definition)]
            (cond
              (instance? native.core.AtomType shape)
              (let [(kind core/AtomKind) (core/atomtype-kind shape)]
                (cond
                  (instance? native.core.BoolKind kind)
                  (->LayoutMeasureV0 1 1 true "bool")
                  (instance? native.core.I64Kind kind)
                  (let [(name String) (core/typedef-name definition)
                        (width Int) (fixed-integer-bit-width name)
                        (bytes Int) (if (> width 0) (quot width 8) 8)]
                    (->LayoutMeasureV0 bytes bytes true
                      (if (> width 0) name "i64")))
                  (instance? native.core.F64Kind kind)
                  (->LayoutMeasureV0 8 8 true "f64")
                  (instance? native.core.TextKind kind)
                  (->LayoutMeasureV0 8 8 true "text handle")
                  (instance? native.core.BytesKind kind)
                  (->LayoutMeasureV0 (core/abi-bytes-span-size abi)
                    (core/abi-bytes-span-align abi) true "owned byte span")
                  (instance? native.core.KeywordKind kind)
                  (->LayoutMeasureV0 8 8 true "keyword handle")
                  :else
                  (->LayoutMeasureV0 pointer-bytes pointer-align true
                    "reference-sized atom")))

              (instance? native.core.ReferenceType shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align true "reference")

              (instance? native.core.AtomCellTypeV0 shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align true
                "atom cell handle")

              ;; A vector value is a reference to its {elements, length, capacity}
              ;; header, so its size never depends on the element type — that is
              ;; what closes the layout of a record with a (Vec Record) field.
              (instance? native.core.VectorType shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align true
                "vector header reference")

              (instance? native.core.BufferTypeV0 shape)
              (let [(element-measure LayoutMeasureV0)
                    (measure-type types (core/buffertypev0-element-type shape)
                      (+ depth 1) abi)]
                (->LayoutMeasureV0 pointer-bytes pointer-align
                  (layoutmeasurev0-closed element-measure)
                  "mutable buffer header reference"))

              (instance? native.core.FunctionType shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align false
                "TODO-NATIVE-FUNCTION-LAYOUT: callable signatures have no closure layout or indirect-call ABI")

              (instance? native.core.MapTypeV0 shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align true
                "map header reference")

              (instance? native.core.SetTypeV0 shape)
              (->LayoutMeasureV0 pointer-bytes pointer-align true
                "set header reference")

              (instance? native.core.RecordType shape)
              (let [(fields (Vec core/TypeField)) (core/recordtype-fields shape)]
                (loop [(index Int) 0 (offset Int) 0 (alignment Int) 1 (closed Bool) true]
                  (if (>= index (count fields))
                    (->LayoutMeasureV0 (align-up offset alignment) alignment closed
                      (if closed "record" "record contains an unclosed field layout"))
                    (let [(field core/TypeField) (nth fields index)
                          (measure LayoutMeasureV0)
                          (measure-type types (core/typefield-type-id field)
                            (+ depth 1) abi)
                          (field-align Int) (layoutmeasurev0-align-bytes measure)
                          (field-offset Int) (align-up offset field-align)]
                      (recur (+ index 1)
                        (+ field-offset (layoutmeasurev0-size-bytes measure))
                        (max-int alignment field-align)
                        (and closed (layoutmeasurev0-closed measure)))))))

              (instance? native.core.UnionType shape)
              (let [(variants (Vec core/TypeVariant)) (core/uniontype-variants shape)]
                (loop [(index Int) 0 (payload-size Int) 0 (payload-align Int) 1 (closed Bool) true]
                  (if (>= index (count variants))
                    (let [(alignment Int) (max-int 8 payload-align)
                          (payload-offset Int) (align-up 8 payload-align)]
                      (->LayoutMeasureV0
                        (align-up (+ payload-offset payload-size) alignment)
                        alignment
                        closed
                        (if closed "closed union" "union contains an unclosed payload layout")))
                    (let [(variant core/TypeVariant) (nth variants index)
                          (payload (U core/NativeId Nil))
                          (core/typevariant-payload-type variant)]
                      (if (nil? payload)
                        (recur (+ index 1) payload-size payload-align closed)
                        (let [(measure LayoutMeasureV0)
                              (measure-type types payload (+ depth 1) abi)]
                          (recur (+ index 1)
                            (max-int payload-size (layoutmeasurev0-size-bytes measure))
                            (max-int payload-align (layoutmeasurev0-align-bytes measure))
                            (and closed (layoutmeasurev0-closed measure)))))))))

              ;; Measured over the failure union's payloads, not its boxed size:
              ;; layout-shape-for flattens those alternatives into the Outcome.
              (instance? native.core.OutcomeType shape)
              (let [(value-measure LayoutMeasureV0)
                    (measure-type types (core/outcometype-value-type shape)
                      (+ depth 1) abi)
                    (variants (Vec core/TypeVariant))
                    (outcome-variants types (core/outcometype-failure-type shape))
                    (payloads LayoutMeasureV0)
                    (loop [(index Int) 0 (size Int) 0 (alignment Int) 1 (closed Bool) true]
                      (if (>= index (count variants))
                        (->LayoutMeasureV0 size alignment closed "outcome payloads")
                        (let [(payload (U core/NativeId Nil))
                              (core/typevariant-payload-type (nth variants index))]
                          (if (nil? payload)
                            (recur (+ index 1) size alignment closed)
                            (let [(measure LayoutMeasureV0)
                                  (measure-type types payload (+ depth 1) abi)]
                              (recur (+ index 1)
                                (max-int size (layoutmeasurev0-size-bytes measure))
                                (max-int alignment
                                  (layoutmeasurev0-align-bytes measure))
                                (and closed (layoutmeasurev0-closed measure))))))))
                    (payload-align Int)
                    (max-int (layoutmeasurev0-align-bytes value-measure)
                      (layoutmeasurev0-align-bytes payloads))
                    (payload-size Int)
                    (max-int (layoutmeasurev0-size-bytes value-measure)
                      (layoutmeasurev0-size-bytes payloads))
                    (alignment Int) (max-int 8 payload-align)
                    (payload-offset Int) (align-up 8 payload-align)]
                (->LayoutMeasureV0
                  (align-up (+ payload-offset payload-size) alignment)
                  alignment
                  (and (layoutmeasurev0-closed value-measure)
                       (layoutmeasurev0-closed payloads))
                  "outcome"))

              :else
              (->LayoutMeasureV0 pointer-bytes pointer-align false
                "unknown native type shape"))))))))

(defn field-layouts
  [(types (Vec core/TypeDef))
   (fields (Vec core/TypeField))
   (abi core/AbiProfileV0)]
  (Vec core/FieldLayoutV0)
  (loop [(index Int) 0 (offset Int) 0 (layouts (Vec core/FieldLayoutV0)) []]
    (if (>= index (count fields))
      layouts
      (let [(field core/TypeField) (nth fields index)
            (measure LayoutMeasureV0)
            (measure-type types (core/typefield-type-id field) 0 abi)
            (field-offset Int) (align-up offset (layoutmeasurev0-align-bytes measure))]
        (recur (+ index 1)
          (+ field-offset (layoutmeasurev0-size-bytes measure))
          (conj layouts
            (core/->FieldLayoutV0
              (core/typefield-id field)
              (core/typefield-type-id field)
              field-offset
              (layoutmeasurev0-align-bytes measure))))))))

(defn variant-layouts
  [(types (Vec core/TypeDef))
   (variants (Vec core/TypeVariant))
   (abi core/AbiProfileV0)]
  (Vec core/UnionVariantLayoutV0)
  (loop [(index Int) 0 (layouts (Vec core/UnionVariantLayoutV0)) []]
    (if (>= index (count variants))
      layouts
      (let [(variant core/TypeVariant) (nth variants index)
            (payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)
            (payload-align Int)
            (if (nil? payload)
              1
              (layoutmeasurev0-align-bytes (measure-type types payload 0 abi)))]
        (recur (+ index 1)
          (conj layouts
            (core/->UnionVariantLayoutV0
              (core/typevariant-id variant)
              index
              payload
              (align-up 8 payload-align))))))))

(defn layout-shape-for
  [(types (Vec core/TypeDef))
   (definition core/TypeDef)
   (abi core/AbiProfileV0)]
  core/LayoutShapeV0
  (let [(shape core/TypeShape) (core/typedef-shape definition)]
    (cond
      (instance? native.core.AtomType shape)
      (let [(kind core/AtomKind) (core/atomtype-kind shape)]
        (cond
          (instance? native.core.BoolKind kind) (core/->ScalarShapeV0 (core/->BoolReprV0 8))
          (instance? native.core.I64Kind kind)
          (let [(name String) (core/typedef-name definition)
                (width Int) (fixed-integer-bit-width name)
                (bits Int) (if (> width 0) width 64)]
            (core/->ScalarShapeV0
              (if (fixed-integer-unsigned? name)
                (core/->UnsignedIntReprV0 bits)
                (core/->SignedIntReprV0 bits))))
          (instance? native.core.F64Kind kind) (core/->ScalarShapeV0 (core/->FloatReprV0 64))
          ;; Text and Keyword are handles: the bytes live outside the value, so
          ;; the value itself is an exact 64-bit scalar.
          (instance? native.core.TextKind kind)
          (core/->ScalarShapeV0 (core/->UnsignedIntReprV0 64))
          (instance? native.core.BytesKind kind)
          (core/->BytesShapeV0 true)
          (instance? native.core.KeywordKind kind)
          (core/->ScalarShapeV0 (core/->UnsignedIntReprV0 64))
          :else (core/->ReferenceShapeV0 (core/typedef-id definition))))

      (instance? native.core.RecordType shape)
      (core/->RecordShapeV0
        (field-layouts types (core/recordtype-fields shape) abi))

      (instance? native.core.UnionType shape)
      (core/->UnionShapeV0
        (type-id "UnionTag")
        0
        (variant-layouts types (core/uniontype-variants shape) abi))

      (instance? native.core.VectorType shape)
      (let [(element core/NativeId) (core/vectortype-element-type shape)
            (measure LayoutMeasureV0) (measure-type types element 0 abi)]
        (core/->VectorShapeV0 element (layoutmeasurev0-size-bytes measure)))

      (instance? native.core.BufferTypeV0 shape)
      (let [(element core/NativeId) (core/buffertypev0-element-type shape)
            (measure LayoutMeasureV0) (measure-type types element 0 abi)]
        (core/->BufferShapeV0 element
          (layoutmeasurev0-size-bytes measure)
          (layoutmeasurev0-align-bytes measure)))

      (instance? native.core.MapTypeV0 shape)
      (let [(key-type core/NativeId) (core/maptypev0-key-type shape)
            (value-type core/NativeId) (core/maptypev0-value-type shape)
            (key-measure LayoutMeasureV0) (measure-type types key-type 0 abi)
            (value-measure LayoutMeasureV0) (measure-type types value-type 0 abi)]
        (core/->MapShapeV0
          key-type
          (layoutmeasurev0-size-bytes key-measure)
          (layoutmeasurev0-align-bytes key-measure)
          value-type
          (layoutmeasurev0-size-bytes value-measure)
          (layoutmeasurev0-align-bytes value-measure)
          (core/maptypev0-iteration-order shape)))

      (instance? native.core.SetTypeV0 shape)
      (let [(element core/NativeId) (core/settypev0-element-type shape)
            (measure LayoutMeasureV0) (measure-type types element 0 abi)]
        (core/->SetShapeV0 element
          (layoutmeasurev0-size-bytes measure)
          (layoutmeasurev0-align-bytes measure)
          (core/settypev0-iteration-order shape)))

      (instance? native.core.ReferenceType shape)
      (core/->ReferenceShapeV0 (core/referencetype-target-type shape))

      ;; Placeholder only: resolve-layout marks FunctionType unclosed, so this
      ;; reference-sized shape can never authorize a closure ABI.
      (instance? native.core.FunctionType shape)
      (core/->ReferenceShapeV0 (core/typedef-id definition))

      (instance? native.core.AtomCellTypeV0 shape)
      (core/->AtomCellShapeV0 (core/atomcelltypev0-content-type shape))

      (instance? native.core.OutcomeType shape)
      (core/->UnionShapeV0
        (type-id "UnionTag")
        0
        (variant-layouts types
          (outcome-variants types (core/outcometype-failure-type shape)) abi))

      :else
      (core/->ReferenceShapeV0 (core/typedef-id definition)))))

(defn resolve-layout
  [(types (Vec core/TypeDef))
   (definition core/TypeDef)
   (abi core/AbiProfileV0)]
  LayoutResolutionV0
  (let [(measure LayoutMeasureV0)
        (measure-type types (core/typedef-id definition) 0 abi)]
    (->LayoutResolutionV0
      (core/->LayoutDef
        (lower-id "layout" [(id-value (core/typedef-id definition))])
        (core/typedef-id definition)
        (layoutmeasurev0-size-bytes measure)
        (layoutmeasurev0-align-bytes measure)
        (layout-shape-for types definition abi))
      (layoutmeasurev0-closed measure)
      (layoutmeasurev0-detail measure))))

(defn resolve-layouts
  [(types (Vec core/TypeDef)) (abi core/AbiProfileV0)] (Vec LayoutResolutionV0)
  (mapv
    (fn [(definition core/TypeDef)] LayoutResolutionV0
      (resolve-layout types definition abi))
    types))

(defn collect-layouts
  [(resolutions (Vec LayoutResolutionV0))] (Vec core/LayoutDef)
  (mapv
    (fn [(resolution LayoutResolutionV0)] core/LayoutDef
      (layoutresolutionv0-layout resolution))
    resolutions))

(defn layouts-closed? [(resolutions (Vec LayoutResolutionV0))] Bool
  (every?
    (fn [(resolution LayoutResolutionV0)] Bool
      (layoutresolutionv0-closed resolution))
    resolutions))

(defn union-tag-type [] core/TypeDef
  (core/->TypeDef (type-id "UnionTag") "UnionTag"
    (core/->AtomType (core/->I64Kind true))))


(defn ready-functions [(functions (Vec TypedFunctionV0))] (Vec TypedFunctionV0)
  (filterv
    (fn [(function TypedFunctionV0)] Bool (ready-function? function))
    functions))


(defn function-capabilities [(function TypedFunctionV0)] (Vec core/NativeId)
  (let [(read (Vec core/NativeId))
        (if (function-reads? function) [(read-capability-id)] [])
        (written (Vec core/NativeId))
        (if (function-writes? function)
          (conj read (write-capability-id))
          read)
        (allocated (Vec core/NativeId))
        (if (function-allocates? function)
          (conj written (allocate-capability-id))
          written)
        (with-atom (Vec core/NativeId))
        (if (function-uses-atom-state? function)
          (conj allocated (atom-state-capability-id))
          allocated)
        (with-environment (Vec core/NativeId))
        (if (function-uses-environment? function)
          (conj with-atom (host-environment-capability-id))
          with-atom)
        (with-context (Vec core/NativeId))
        (if (function-uses-host-context? function)
          (conj with-environment (host-context-capability-id))
          with-environment)
        (with-stdout (Vec core/NativeId))
        (if (function-uses-stdout? function)
          (conj with-context (host-stdout-capability-id))
          with-context)
        (with-stderr (Vec core/NativeId))
        (if (function-uses-stderr? function)
          (conj with-stdout (host-stderr-capability-id))
          with-stdout)
        (with-filesystem (Vec core/NativeId))
        (if (function-uses-host-filesystem? function)
          (conj with-stderr (host-filesystem-capability-id))
          with-stderr)
        (with-process (Vec core/NativeId))
        (if (function-uses-host-process? function)
          (conj with-filesystem (host-process-capability-id))
          with-filesystem)
        (with-socket (Vec core/NativeId))
        (if (function-uses-host-socket? function)
          (conj with-process (host-socket-capability-id))
          with-process)]
    (if (function-uses-host-clock? function)
      (conj with-socket (host-clock-capability-id))
      with-socket)))

(defn host-capability-id? [(capability core/NativeId)] Bool
  (or (same-id? capability (host-environment-capability-id))
      (same-id? capability (host-context-capability-id))
      (same-id? capability (host-stdout-capability-id))
      (same-id? capability (host-stderr-capability-id))
      (same-id? capability (host-filesystem-capability-id))
      (same-id? capability (host-process-capability-id))
      (same-id? capability (host-socket-capability-id))
      (same-id? capability (host-clock-capability-id))))

(defn function-affine-capabilities
  [(function TypedFunctionV0)] (Vec core/NativeId)
  (filterv
    (fn [(capability core/NativeId)] Bool
      (not (host-capability-id? capability)))
    (function-capabilities function)))

(defn function-regions [(function TypedFunctionV0)] (Vec core/NativeId)
  (let [(arena (Vec core/NativeId))
        (if (or (function-reads? function)
              (or (function-writes? function) (function-allocates? function)))
          [(arena-region-id)]
          [])]
    (if (function-uses-atom-state? function)
      (conj arena (atom-state-region-id))
      arena)))

(defn arena-function-tokens [(function TypedFunctionV0)] (Vec core/NativeId)
  (let [(read (Vec core/NativeId))
        (if (function-reads? function) [(read-capability-id)] [])
        (written (Vec core/NativeId))
        (if (function-writes? function)
          (conj read (write-capability-id))
          read)
        (capabilities (Vec core/NativeId))
        (if (function-allocates? function)
          (conj written (allocate-capability-id))
          written)]
    (into [(arena-region-id)] capabilities)))

;; The acquisition consumes exactly the function's affine set, so every path out
;; of the entry block leaves it empty.
(defn arena-acquire-instruction [(function TypedFunctionV0)] core/Instruction
  (core/->ArenaInstruction
    (core/->SsaValueV0 (arena-value-id (typedfunctionv0-id function))
      (arena-handle-type-id))
    (arena-region-id)
    (if (function-allocates? function)
      (allocate-capability-id)
      (if (function-writes? function)
        (write-capability-id)
        (read-capability-id)))
    (core/->TokenFlowV0 (arena-function-tokens function) [])))

(defn atom-state-acquire-instruction
  [(function TypedFunctionV0)] core/Instruction
  (core/->AtomStateInstruction
    (core/->SsaValueV0 (atom-state-value-id (typedfunctionv0-id function))
      (atom-state-handle-type-id))
    (atom-state-region-id)
    (atom-state-capability-id)
    (core/->TokenFlowV0
      [(atom-state-region-id) (atom-state-capability-id)] [])))

(defn with-arena-acquire
  [(entry-id core/NativeId)
   (acquire core/Instruction)
   (blocks (Vec core/BasicBlock))]
  (Vec core/BasicBlock)
  (mapv
    (fn [(block core/BasicBlock)] core/BasicBlock
      (if (same-id? (core/basicblock-id block) entry-id)
        (with block
          [:instructions
           (into [acquire] (core/basicblock-instructions block))])
        block))
    blocks))

(defn lower-function-instructions
  [(function TypedFunctionV0)] (Vec core/Instruction)
  (let [(operation String) (function-operation function)
        (parameters (Vec core/Parameter)) (typedfunctionv0-parameters function)
        (result-id core/NativeId)
        (lower-id "ssa-result" [(id-value (typedfunctionv0-id function))])]
    (cond
      (= operation "checked-add-i64")
      [(core/->CheckedInstruction
         (core/->SsaValueV0 result-id (typedfunctionv0-return-type function))
         (core/->CheckedAddI64V0
           (core/parameter-id (nth parameters 0))
           (core/parameter-id (nth parameters 1))))]

      (= operation "const-zero-i64")
      [(core/->AtomInstruction
         (core/->SsaValueV0 result-id (typedfunctionv0-return-type function))
         (core/->I64Atom 0))]

      :else [])))

(defn lower-function-return [(function TypedFunctionV0)] (U core/NativeId Nil)
  (let [(operation String) (function-operation function)
        (parameters (Vec core/Parameter)) (typedfunctionv0-parameters function)]
    (cond
      (= operation "identity")
      (if (= 0 (count parameters)) nil (core/parameter-id (nth parameters 0)))

      (or (= operation "checked-add-i64") (= operation "const-zero-i64"))
      (lower-id "ssa-result" [(id-value (typedfunctionv0-id function))])

      :else nil)))

;; What the C emitters used to recover from the caller's single
;; ArenaInstruction is written down as an operand instead, so a caller with
;; more than one arena has a per-call-site answer for the epoch stage to
;; retarget. A function that acquires no arena leaves the operand nil.
(defn attach-call-arena
  [(instruction core/Instruction) (arena-id core/NativeId)] core/Instruction
  (if (instance? native.core.CallInstruction instruction)
    (core/->CallInstruction
      (core/callinstruction-result instruction)
      (core/callinstruction-function-id instruction)
      (core/callinstruction-arguments instruction)
      arena-id
      (core/callinstruction-tokens instruction))
    instruction))

(defn attach-call-arenas
  [(blocks (Vec core/BasicBlock))
   (arena-id core/NativeId)]
  (Vec core/BasicBlock)
  (mapv
    (fn [(block core/BasicBlock)] core/BasicBlock
      (with block
        [:instructions
         (mapv
           (fn [(instruction core/Instruction)] core/Instruction
             (attach-call-arena instruction arena-id))
           (core/basicblock-instructions block))]))
    blocks))

(defn lower-ready-function [(function TypedFunctionV0)] core/FunctionDef
  (let [(entry-id core/NativeId)
        (lower-id "block-entry" [(id-value (typedfunctionv0-id function))])
        (lowered-blocks (Vec core/BasicBlock)) (function-body-blocks function)
        (body-blocks (Vec core/BasicBlock))
        (if (> (count lowered-blocks) 0)
          lowered-blocks
          [(core/->BasicBlock
             entry-id
             []
             (lower-function-instructions function)
             [(core/->ReturnTerminator (lower-function-return function))])])
        (arena-blocks (Vec core/BasicBlock))
        (if (or (function-reads? function)
              (or (function-writes? function) (function-allocates? function)))
          (with-arena-acquire entry-id (arena-acquire-instruction function)
            body-blocks)
          body-blocks)
        (blocks (Vec core/BasicBlock))
        (if (function-uses-atom-state? function)
          (with-arena-acquire entry-id
            (atom-state-acquire-instruction function) arena-blocks)
          arena-blocks)
        (with-call-arenas (Vec core/BasicBlock))
        (if (or (function-reads? function)
              (or (function-writes? function) (function-allocates? function)))
          (attach-call-arenas blocks
            (arena-value-id (typedfunctionv0-id function)))
          blocks)]
    (core/->FunctionDef
      (typedfunctionv0-id function)
      (typedfunctionv0-name function)
      (typedfunctionv0-parameters function)
      with-call-arenas
      entry-id
      (typedfunctionv0-return-type function)
      (typedfunctionv0-effects function)
      (function-regions function)
      (function-capabilities function))))

(defn lower-ready-functions
  [(functions (Vec TypedFunctionV0))] (Vec core/FunctionDef)
  (mapv
    (fn [(function TypedFunctionV0)] core/FunctionDef
      (lower-ready-function function))
    (ready-functions functions)))

(defn instruction-consumed-tokens
  [(instruction core/Instruction)] (Vec core/NativeId)
  (let [(flow (U core/TokenFlowV0 Nil)) (get instruction :tokens nil)]
    (if (nil? flow) [] (core/tokenflowv0-consumed flow))))

(defn function-consumed-tokens [(function core/FunctionDef)] (Vec core/NativeId)
  (loop [(position Int) 0
         (blocks (Vec core/BasicBlock)) (core/functiondef-blocks function)
         (consumed (Vec core/NativeId)) []]
    (if (>= position (count blocks))
      consumed
      (recur (+ position 1) blocks
        (loop [(inner Int) 0
               (instructions (Vec core/Instruction))
               (core/basicblock-instructions (nth blocks position))
               (collected (Vec core/NativeId)) consumed]
          (if (>= inner (count instructions))
            collected
            (recur (+ inner 1) instructions
              (core/append-ids collected
                (instruction-consumed-tokens (nth instructions inner))))))))))

(defn function-tokens-discharged? [(function core/FunctionDef)] Bool
  (let [(affine-capabilities (Vec core/NativeId))
        (filterv
          (fn [(capability core/NativeId)] Bool
            (not (host-capability-id? capability)))
          (core/functiondef-capabilities function))
        (required (Vec core/NativeId))
        (core/append-ids (core/functiondef-regions function)
          affine-capabilities)
        (consumed (Vec core/NativeId)) (function-consumed-tokens function)]
    (and (core/unique-ids? consumed)
      (core/ids-in? required consumed)
      (core/ids-in? consumed required))))

(defn layout-digest [(layouts (Vec core/LayoutDef))] String
  (stages/content-digest
    (stages/canonical-set "layout-set-v0"
      (mapv
        (fn [(layout core/LayoutDef)] String
          (stages/canonical-record "layout"
            [(id-value (core/layoutdef-id layout))
             (id-value (core/layoutdef-type-id layout))
             (str (core/layoutdef-size-bytes layout))
             (str (core/layoutdef-align-bytes layout))]))
        layouts))))

(defn abi-parameters [(parameters (Vec core/Parameter))] (Vec core/AbiValueV0)
  (mapv
    (fn [(parameter core/Parameter)] core/AbiValueV0
      (core/->AbiValueV0
        (id-value (core/parameter-id parameter))
        (core/parameter-type-id parameter)
        (core/->BorrowedV0 true)
        nil))
    parameters))

(defn function-abi
  [(function TypedFunctionV0) (layouts-digest String)] core/AbiDeclV0
  (core/->AbiDeclV0
    (lower-id "abi" [(id-value (typedfunctionv0-id function))])
    (typedfunctionv0-id function)
    (typedfunctionv0-abi-symbol function)
    (core/->AbiExportV0 true)
    (core/->RestrictedCAbiV0 true)
    (abi-parameters (typedfunctionv0-parameters function))
    (core/->AbiValueV0
      "result"
      (typedfunctionv0-return-type function)
      (core/->OwnedV0 true)
      nil)
    (typedfunctionv0-failure-type function)
    (typedfunctionv0-effects function)
    (function-capabilities function)
    "v0"
    layouts-digest))

(defn function-id-is-tiled-kernel?
  [(functions (Vec core/FunctionDef)) (target core/NativeId)] Bool
  (some?
    (some
      (fn [(function core/FunctionDef)] Bool
        (some?
          (some
            (fn [(block core/BasicBlock)] Bool
              (some?
                (some
                  (fn [(instruction core/Instruction)] Bool
                    (and
                      (instance? native.core.TiledStepF64InstructionV0
                        instruction)
                      (core/native-id=
                        (core/tiledstepf64instructionv0-kernel-id instruction)
                        target)))
                  (core/basicblock-instructions block))))
            (core/functiondef-blocks function))))
      functions)))

(defn public-ready-functions
  [(typed-functions (Vec TypedFunctionV0))
   (functions (Vec core/FunctionDef))]
  (Vec TypedFunctionV0)
  (filterv
    (fn [(function TypedFunctionV0)] Bool
      (and (ready-function? function)
        (not (function-id-is-tiled-kernel? functions
               (typedfunctionv0-id function)))))
    typed-functions))

(defn function-abis
  [(functions (Vec TypedFunctionV0))
   (native-functions (Vec core/FunctionDef))
   (layouts (Vec core/LayoutDef))]
  (Vec core/AbiDeclV0)
  (let [(digest String) (layout-digest layouts)]
    (mapv
      (fn [(function TypedFunctionV0)] core/AbiDeclV0
        (function-abi function digest))
      (public-ready-functions functions native-functions))))

(defn host-environment-abi
  [(result-type core/NativeId) (layouts-digest String)] core/AbiDeclV0
  (core/->AbiDeclV0
    (host-environment-abi-id)
    (host-environment-function-id)
    "native_host_environment_lookup_v0"
    (core/->AbiImportV0 true)
    (core/->RestrictedCOptionalOutAbiV0 true)
    [(core/->AbiValueV0 "name" (text-type-id)
       (core/->BorrowedV0 true) nil)]
    (core/->AbiValueV0 "result" result-type
      (core/->ArenaOwnedV0 (arena-region-id))
      (arena-region-id))
    (type-id "LowerFailure")
    [(allocate-effect-id) (host-environment-effect-id)]
    [(allocate-capability-id) (host-environment-capability-id)]
    "v0"
    layouts-digest))

(defn host-context-abis [(layouts-digest String)] (Vec core/AbiDeclV0)
  [(core/->AbiDeclV0
     (host-context-abi-id "system-hostname")
     (host-context-function-id "system-hostname")
     "native_host_system_hostname_v0"
     (core/->AbiImportV0 true)
