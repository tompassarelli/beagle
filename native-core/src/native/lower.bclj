(defn host-socket-function-id [(operation String)] core/NativeId
  (lower-id "extern" [(str "host-socket-" operation "-v0")]))

(defn host-socket-callee? [(name String)] Bool
  (or (= name "host.socket/inherited-listener")
      (= name "host.socket/accept")
      (= name "host.socket/read-bounded")
      (= name "host.socket/write-bounded")
      (= name "host.socket/close")))

(defn host-socket-operation [(name String)] String
  (cond
    (= name "host.socket/inherited-listener") "inherited-listener"
    (= name "host.socket/accept") "accept"
    (= name "host.socket/read-bounded") "read-bounded"
    (= name "host.socket/write-bounded") "write-bounded"
    (= name "host.socket/close") "close"
    :else ""))

(defn host-socket-abi-id? [(candidate core/NativeId)] Bool
  (or (same-id? candidate (host-socket-abi-id "inherited-listener"))
      (same-id? candidate (host-socket-abi-id "accept"))
      (same-id? candidate (host-socket-abi-id "read-bounded"))
      (same-id? candidate (host-socket-abi-id "write-bounded"))
      (same-id? candidate (host-socket-abi-id "close"))))

(defn slice-effects
  [(include-environment Bool)
   (include-context Bool)
   (include-stdout Bool)
   (include-stderr Bool)
   (include-filesystem Bool)
   (include-process Bool)
   (include-socket Bool)
   (include-clock Bool)]
  (Vec core/EffectDef)
  (let [(base (Vec core/EffectDef))
        [(core/->EffectDef (pure-effect-id) (core/->PureEffect true))
         (core/->EffectDef (read-effect-id) (core/->ReadEffect (arena-region-id)))
         (core/->EffectDef (write-effect-id) (core/->WriteEffect (arena-region-id)))
         (core/->EffectDef (allocate-effect-id)
           (core/->AllocateEffect (arena-region-id)))
         (core/->EffectDef (atom-state-effect-id)
           (core/->AtomicEffect (atom-state-region-id)
             (atom-state-capability-id)))]
        (with-environment (Vec core/EffectDef))
        (if include-environment
          (conj base
            (core/->EffectDef (host-environment-effect-id)
              (core/->CapabilityEffect (host-environment-capability-id))))
          base)
        (with-context (Vec core/EffectDef))
        (if include-context
          (conj with-environment
            (core/->EffectDef (host-context-effect-id)
              (core/->CapabilityEffect (host-context-capability-id))))
          with-environment)
        (with-stdout (Vec core/EffectDef))
        (if include-stdout
          (conj with-context
            (core/->EffectDef (host-stdout-effect-id)
              (core/->IoEffect (host-stdout-capability-id))))
          with-context)
        (with-stderr (Vec core/EffectDef))
        (if include-stderr
          (conj with-stdout
            (core/->EffectDef (host-stderr-effect-id)
              (core/->IoEffect (host-stderr-capability-id))))
          with-stdout)
        (with-filesystem (Vec core/EffectDef))
        (if include-filesystem
          (conj with-stderr
            (core/->EffectDef (host-filesystem-effect-id)
              (core/->IoEffect (host-filesystem-capability-id))))
          with-stderr)
        (with-process (Vec core/EffectDef))
        (if include-process
          (conj with-filesystem
            (core/->EffectDef (host-process-effect-id)
              (core/->IoEffect (host-process-capability-id))))
          with-filesystem)
        (with-socket (Vec core/EffectDef))
        (if include-socket
          (conj with-process
            (core/->EffectDef (host-socket-effect-id)
              (core/->SocketEffect (host-socket-capability-id))))
          with-process)]
      (if include-clock
        (conj with-socket
          (core/->EffectDef (host-clock-effect-id)
            (core/->ClockEffect (host-clock-capability-id))))
        with-socket)))

;; RULING (v0): a pure-named function MAY allocate. v0 source carries no effect
;; annotation, so the Allocate effect is inferred from the lowered body and from
;; every callee, then declared in the function, its regions, its capabilities
;; and its ABI. Inferred, never hidden.
(defn function-effects [(name String)] (Vec core/NativeId)
  (if (ends-with? name "!") [(write-effect-id)] [(pure-effect-id)]))

(defn encode-parameter [(parameter core/Parameter)] String
  (stages/canonical-record "parameter"
    [(id-value (core/parameter-id parameter))
     (id-value (core/parameter-type-id parameter))]))

(defn encode-typed-function
  [(id core/NativeId)
   (name String)
   (abi-symbol String)
   (parameters (Vec core/Parameter))
   (return-type core/NativeId)
   (failure-type core/NativeId)
   (effects (Vec core/NativeId))
   (readiness-code String)]
  String
  (stages/canonical-record "typed-function-v0"
    [(id-value id)
     name
     abi-symbol
     (stages/canonical-record "parameters"
       (mapv
         (fn [(parameter core/Parameter)] String
           (encode-parameter parameter))
         parameters))
     (id-value return-type)
     (id-value failure-type)
     (stages/canonical-record "effects"
       (mapv (fn [(effect core/NativeId)] String (id-value effect)) effects))
     readiness-code]))

(defn ascii-lower [(value String)] String
  (let [(upper String) "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        (lower String) "abcdefghijklmnopqrstuvwxyz"]
    (loop [(position Int) 0 (result String) ""]
      (if (>= position (count value))
        result
        (let [(character String) (subs value position (+ position 1))
              (hit Int)
              (loop [(scan Int) 0]
                (cond
                  (>= scan 26) -1
                  (= character (subs upper scan (+ scan 1))) scan
                  :else (recur (+ scan 1))))]
          (recur (+ position 1)
            (str result (if (< hit 0) character (subs lower hit (+ hit 1))))))))))

(defn digit-value [(character String)] Int
  (let [(digits String) "0123456789"]
    (loop [(scan Int) 0]
      (cond
        (>= scan 10) -1
        (= character (subs digits scan (+ scan 1))) scan
        :else (recur (+ scan 1))))))

(defn parse-int-text [(value String)] (U Int Nil)
  (let [(negative Bool) (and (> (count value) 0) (= "-" (subs value 0 1)))
        (start Int) (if negative 1 0)
        (maximum Int) 9223372036854775807
        (minimum Int) (- (- 0 maximum) 1)
        (limit Int) (if negative minimum (- 0 maximum))
        (multiply-limit Int) (quot limit 10)]
    (if (>= start (count value))
      nil
      ;; Keep the accumulator negative so Int's asymmetric range needs no +2^63.
      (loop [(position Int) start (result Int) 0]
        (if (>= position (count value))
          (if negative result (- 0 result))
          (let [(digit Int) (digit-value (subs value position (+ position 1)))]
            (cond
              (< digit 0) nil
              (< result multiply-limit) nil
              :else
              (let [(shifted Int) (* result 10)]
                (if (< shifted (+ limit digit))
                  nil
                  (recur (+ position 1) (- shifted digit)))))))))))

(defrecord GlobalBindingV0
  [(module-name String)
   (name String)
   (value core/NativeId)
   (effective-type (U core/NativeId Nil))])

(defn source-globals [(index SourceIndexV0)] (Vec GlobalBindingV0)
  (let [(forms (Vec core/NativeId)) (index-form-ids index "def")]
    (loop [(position Int) 0 (globals (Vec GlobalBindingV0)) []]
      (if (>= position (count forms))
        globals
        (let [(form core/NativeId) (nth forms position)
              (name String) (fact-text index form "name")
              (value (U core/NativeId Nil)) (index-first-object index form "value")]
          (recur (+ position 1)
            (if (or (= "" name) (nil? value))
              globals
              (conj globals
                (->GlobalBindingV0 (source-module-name index form) name value
                  (index-first-object index form "effective-type"))))))))))

(defn global-key [(global GlobalBindingV0)] String
  (str (globalbindingv0-module-name global) "/" (globalbindingv0-name global)))

(defn global-type-definitions
  [(index SourceIndexV0) (globals (Vec GlobalBindingV0))] (Vec core/TypeDef)
  (loop [(position Int) 0 (definitions (Vec core/TypeDef)) []]
    (if (>= position (count globals))
      definitions
      (let [(global GlobalBindingV0) (nth globals position)
            (effective-type (U core/NativeId Nil))
            (globalbindingv0-effective-type global)]
        (recur (+ position 1)
          (if (nil? effective-type)
            definitions
            (let [(resolution TypeResolutionV0)
                  (resolve-source-type index effective-type)
                  (resolved-type core/NativeId)
                  (typeresolutionv0-type-id resolution)
                  (resolved-definitions (Vec core/TypeDef))
                  (typeresolutionv0-definitions resolution)
                  ;; A ref-valued Function is a transparent direct-call alias,
                  ;; including the aliases injected by macro hygiene. Its
                  ;; callable signature belongs to the resolved FunctionDef;
                  ;; adding it here would invent a runtime closure obligation.
                  (materialized-definitions (Vec core/TypeDef))
                  (if (= "ref"
                        (fact-text index (globalbindingv0-value global)
                          "form-kind"))
                    (filterv
                      (fn [(definition core/TypeDef)] Bool
                        (not
                          (and
                            (same-id? resolved-type
                              (core/typedef-id definition))
                            (instance? native.core.FunctionType
                              (core/typedef-shape definition)))))
                      resolved-definitions)
                    resolved-definitions)]
              (append-type-defs definitions materialized-definitions))))))))

;; Local annotations participate in body typing just as signatures and globals
;; do. Collect them before lowering so a body's first nullable value already
;; names a closed program type instead of minting one after the fact.
(defn binding-type-definitions [(index SourceIndexV0)] (Vec core/TypeDef)
  (let [(bindings (Vec core/NativeId)) (index-form-ids index "binding")]
    (loop [(position Int) 0 (definitions (Vec core/TypeDef)) []]
      (if (>= position (count bindings))
        definitions
        (let [(annotation (U core/NativeId Nil))
              (index-first-object index (nth bindings position) "ann")]
          (recur (+ position 1)
            (if (nil? annotation)
              definitions
              (append-type-defs definitions
                (typeresolutionv0-definitions
                  (resolve-source-type index annotation))))))))))

;; A vector literal made of scalar literals names its element type by itself.
;; Mint the closed vector TypeDef up front so such a literal lowers in a
;; module that never spells (Vec T) in any annotation.
(defn scalar-literal-kind-type [(kind String)] (U core/NativeId Nil)
  (cond
    (= "int" kind) (type-id "Int")
    (= "number" kind) (type-id "Int")
    (= "float" kind) (type-id "Float")
    (= "bool" kind) (type-id "Bool")
    (= "string" kind) (type-id "String")
    (= "keyword" kind) (type-id "Keyword")
    :else nil))

(defn literal-vector-element-type
  [(index SourceIndexV0) (literal core/NativeId)] (U core/NativeId Nil)
  (let [(items-node (U core/NativeId Nil))
        (index-first-object index literal "items")
        (items (Vec core/NativeId))
        (if (nil? items-node) [] (index-sequence-items index items-node))]
    (if (= 0 (count items))
      nil
      (loop [(position Int) 0 (agreed (U core/NativeId Nil)) nil]
        (if (>= position (count items))
          agreed
          (let [(item core/NativeId) (nth items position)
                (item-type (U core/NativeId Nil))
                (if (= "literal" (fact-text index item "form-kind"))
                  (scalar-literal-kind-type (fact-text index item "literal-kind"))
                  nil)]
            (cond
              (nil? item-type) nil
              (and (some? agreed) (not (same-id? agreed item-type))) nil
              :else (recur (+ position 1) item-type))))))))

(defn literal-vector-type-definitions [(index SourceIndexV0)] (Vec core/TypeDef)
  (let [(literals (Vec core/NativeId)) (index-form-ids index "vec")]
    (loop [(position Int) 0 (definitions (Vec core/TypeDef)) []]
      (if (>= position (count literals))
        definitions
        (let [(element (U core/NativeId Nil))
              (literal-vector-element-type index (nth literals position))]
          (recur (+ position 1)
            (if (nil? element)
              definitions
              (append-type-def definitions (closed-vector-type element)))))))))

(defn lookup-type
  [(types (Vec core/TypeDef)) (target core/NativeId)] (U core/TypeDef Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)]
        (if (same-id? target (core/typedef-id definition))
          definition
          (recur (+ position 1)))))))

(defn type-carries-function?
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (visited (Vec core/NativeId))
   (fuel Int)]
  Bool
  (if (or (<= fuel 0) (core/id-in? visited target))
    false
    (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [(shape core/TypeShape) (core/typedef-shape definition)
              (next-visited (Vec core/NativeId)) (conj visited target)
              (references (Vec core/NativeId))
              ;; Only inline payloads inherit callable ABI requirements.
              (cond
                (instance? native.core.AtomType shape)
                []

                (instance? native.core.RecordType shape)
                (mapv
                  (fn [(field core/TypeField)] core/NativeId
                    (core/typefield-type-id field))
                  (core/recordtype-fields shape))

                (instance? native.core.UnionType shape)
                (loop [(position Int) 0
                       (variants (Vec core/TypeVariant))
                       (core/uniontype-variants shape)
                       (collected (Vec core/NativeId)) []]
                  (if (>= position (count variants))
                    collected
                    (let [(payload (U core/NativeId Nil))
                          (core/typevariant-payload-type
                            (nth variants position))]
                      (recur (+ position 1) variants
                        (if (nil? payload) collected
                          (conj collected payload))))))

                (instance? native.core.OutcomeType shape)
                [(core/outcometype-value-type shape)
                 (core/outcometype-failure-type shape)]

                :else [])]
          (or (instance? native.core.FunctionType shape)
            (some?
              (some
                (fn [(reference core/NativeId)] Bool
                  (type-carries-function? types reference next-visited
                    (- fuel 1)))
                references))))))))

(defn function-signature-carries-function?
  [(types (Vec core/TypeDef)) (function TypedFunctionV0)] Bool
  (let [(fuel Int) (+ 1 (count types))]
    (or
      (type-carries-function? types (typedfunctionv0-return-type function) [] fuel)
      (some?
        (some
          (fn [(parameter core/Parameter)] Bool
            (type-carries-function? types (core/parameter-type-id parameter) [] fuel))
          (typedfunctionv0-parameters function))))))

(defrecord LocalBindingV0
  [(name String) (value-id core/NativeId) (type-id core/NativeId)])

;; A branch fact is keyed by one immutable map SSA and one fixed keyword
;; identity; another map of the same type is never interchangeable.
(defrecord KeywordFlowRefinementV0
  [(source-id core/NativeId)
   (source-type core/NativeId)
   (keyword String)
   (lookup-type core/NativeId)
   (result-type core/NativeId)])

(defrecord KeywordLookupSiteV0
  [(source-id core/NativeId)
   (source-type core/NativeId)
   (keyword String)
   (lookup-type core/NativeId)])

;; A predicate over one immutable SSA can restrict the alternatives reachable
;; on a branch without changing the value carried by the source union.
(defrecord ValueFlowRefinementV0
  [(source-id core/NativeId)
   (source-type core/NativeId)
   (possible-types (Vec core/NativeId))])

(defrecord ValueFlowSiteV0
  [(name String)
   (source-id core/NativeId)
   (source-type core/NativeId)
   (accepted-types (Vec core/NativeId))])

(defrecord VariantPathV0 [(matches Int) (variants (Vec core/TypeVariant))])

;; One live `loop`: the SSA header block whose block-parameters ARE the typed
;; accumulators. `recur` is a Jump back to this header, so the innermost frame
;; is the lexical recur target and a nested loop shadows its parent.
(defrecord LoopFrameV0
  [(header-id core/NativeId)
   (parameters (Vec core/Parameter))
   (bindings (Vec core/NativeId))])

;; One in-flight function body: finished blocks, the open block being filled,
;; the lexical environment, and the first refusal that made lowering stop.
(defrecord BodyStateV0
  [(blocks (Vec core/BasicBlock))
   (block-id core/NativeId)
   (block-parameters (Vec core/Parameter))
   (instructions (Vec core/Instruction))
   (open Bool)
   (counter Int)
   (locals (Vec LocalBindingV0))
   (failure String)
   (loop-frames (Vec LoopFrameV0))
   (keyword-refinements (Vec KeywordFlowRefinementV0))
   (value-refinements (Vec ValueFlowRefinementV0))
   (transient-type (U core/NativeId Nil))])

(defrecord ExprResultV0
  [(state BodyStateV0)
   (value-id core/NativeId)
   (type-id core/NativeId)
   (terminated Bool)])

(defrecord LogicArmV0 [(start Int) (end Int) (type-id core/NativeId)])

(defrecord ArgsResultV0
  [(state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))
   (terminated Bool)])

(defrecord MapItemsResultV0
  [(state BodyStateV0)
   (key-ids (Vec core/NativeId))
   (key-types (Vec core/NativeId))
   (value-ids (Vec core/NativeId))
   (value-types (Vec core/NativeId))
   (terminated Bool)])

(defrecord BodyEnvV0
  [(index SourceIndexV0)
   (types (Vec core/TypeDef))
   (signatures (Vec TypedFunctionV0))
   (signature-sources (Vec core/NativeId))
   (globals (Vec GlobalBindingV0))])

(defn state-blocked? [(state BodyStateV0)] Bool
  (> (count (bodystatev0-failure state)) 0))

(defn state-fail [(state BodyStateV0) (detail String)] BodyStateV0
  (if (state-blocked? state) state (with state [:failure detail])))

(defn dead-result [(state BodyStateV0)] ExprResultV0
  (->ExprResultV0 state (lower-id "body" ["unreachable"])
    (type-id "LowerFailure") true))

(defn fail-result [(state BodyStateV0) (detail String)] ExprResultV0
  (dead-result (state-fail state detail)))

(defn state-id
  [(state BodyStateV0) (owner core/NativeId) (label String)] core/NativeId
  (lower-id "body"
    [(id-value owner) label (str (bodystatev0-counter state))]))

(defn state-bump [(state BodyStateV0)] BodyStateV0
  (with state [:counter (+ 1 (bodystatev0-counter state))]))

(defn state-emit
  [(state BodyStateV0) (instruction core/Instruction)] BodyStateV0
  (with state
    [:instructions (conj (bodystatev0-instructions state) instruction)]))

(defn state-close [(state BodyStateV0) (terminator core/Terminator)] BodyStateV0
  (if (not (bodystatev0-open state))
    state
    (with
      (with state
        [:blocks
         (conj (bodystatev0-blocks state)
           (core/->BasicBlock
             (bodystatev0-block-id state)
             (bodystatev0-block-parameters state)
             (bodystatev0-instructions state)
             [terminator]))])
      [:open false])))

(defn state-open-block
  [(state BodyStateV0)
   (block-id core/NativeId)
   (parameters (Vec core/Parameter))]
  BodyStateV0
  (with
    (with
      (with (with state [:block-id block-id]) [:block-parameters parameters])
      [:instructions []])
    [:open true]))

(defn retarget-jump
  [(block core/BasicBlock)
   (from core/NativeId)
   (to core/NativeId)]
  core/BasicBlock
  (let [(terminators (Vec core/Terminator)) (core/basicblock-terminators block)]
    (if (not (= 1 (count terminators)))
      block
      (let [(terminator core/Terminator) (nth terminators 0)]
        (if (and (instance? native.core.JumpTerminator terminator)
              (same-id? (core/jumpterminator-block-id terminator) from))
          (core/->BasicBlock
            (core/basicblock-id block)
            (core/basicblock-parameters block)
            (core/basicblock-instructions block)
            [(core/->JumpTerminator to
               (core/jumpterminator-arguments terminator))])
          block)))))

(defn retarget-jumps-between
  [(state BodyStateV0)
   (start Int)
   (end Int)
   (from core/NativeId)
   (to core/NativeId)]
  BodyStateV0
  (let [(blocks (Vec core/BasicBlock)) (bodystatev0-blocks state)]
    (loop [(position Int) 0 (collected (Vec core/BasicBlock)) []]
      (if (>= position (count blocks))
        (with state [:blocks collected])
        (recur (+ position 1)
          (conj collected
            (if (and (>= position start) (< position end))
              (retarget-jump (nth blocks position) from to)
              (nth blocks position))))))))

(defn state-bind
  [(state BodyStateV0)
   (name String)
   (value-id core/NativeId)
   (type-id core/NativeId)]
  BodyStateV0
  (with state
    [:locals (conj (bodystatev0-locals state)
               (->LocalBindingV0 name value-id type-id))]))

(declare project-binding-target guard-binding-value)

(defn bind-source-parameter-value
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source-parameter core/NativeId)
   (position Int)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (target (U core/NativeId Nil))
        (parameter-target-at index source-parameter)
        (source-type (U core/NativeId Nil))
        (field-type-at index source-parameter)
        (guarded BodyStateV0)
        (guard-binding-value env owner state source-parameter value-id value-type)]
    (if (state-blocked? guarded)
      guarded
      (if (nil? target)
        (state-bind guarded (parameter-name-at index source-parameter position)
          value-id value-type)
        (if (nil? source-type)
          (state-fail guarded
            "TODO-NATIVE-DESTRUCTURE-PARAMETER-TYPE: aggregate parameter has no source type")
          (project-binding-target env owner guarded target source-type value-id
            value-type))))))

(defn state-with-keyword-refinements
  [(state BodyStateV0) (refinements (Vec KeywordFlowRefinementV0))] BodyStateV0
  (with state [:keyword-refinements refinements]))

(defn state-add-keyword-refinement
  [(state BodyStateV0) (refinement KeywordFlowRefinementV0)] BodyStateV0
  (state-with-keyword-refinements state
    (conj (bodystatev0-keyword-refinements state) refinement)))

(defn state-with-value-refinements
  [(state BodyStateV0) (refinements (Vec ValueFlowRefinementV0))] BodyStateV0
  (with state [:value-refinements refinements]))

(defn state-add-value-refinement
  [(state BodyStateV0) (refinement ValueFlowRefinementV0)] BodyStateV0
  (state-with-value-refinements state
    (conj (bodystatev0-value-refinements state) refinement)))

(defn state-with-flow-context
  [(state BodyStateV0)
   (locals (Vec LocalBindingV0))
   (keyword-refinements (Vec KeywordFlowRefinementV0))
   (value-refinements (Vec ValueFlowRefinementV0))]
  BodyStateV0
  (with
    (with
      (with state [:locals locals])
      [:keyword-refinements keyword-refinements])
    [:value-refinements value-refinements]))

(defn state-push-loop [(state BodyStateV0) (frame LoopFrameV0)] BodyStateV0
  (with state [:loop-frames (conj (bodystatev0-loop-frames state) frame)]))

(defn current-loop [(state BodyStateV0)] (U LoopFrameV0 Nil)
  (let [(frames (Vec LoopFrameV0)) (bodystatev0-loop-frames state)]
    (if (= 0 (count frames)) nil (nth frames (- (count frames) 1)))))

(defn find-local
  [(locals (Vec LocalBindingV0)) (name String)] (U LocalBindingV0 Nil)
  (loop [(position Int) (- (count locals) 1)]
    (if (< position 0)
      nil
      (let [(binding LocalBindingV0) (nth locals position)]
        (if (= name (localbindingv0-name binding))
          binding
          (recur (- position 1)))))))

(defn find-keyword-refinement
  [(state BodyStateV0)
   (source-id core/NativeId)
   (source-type core/NativeId)
   (keyword String)
   (lookup-type core/NativeId)]
  (U KeywordFlowRefinementV0 Nil)
  (let [(refinements (Vec KeywordFlowRefinementV0))
        (bodystatev0-keyword-refinements state)]
    (loop [(position Int) (- (count refinements) 1)]
      (if (< position 0)
        nil
        (let [(refinement KeywordFlowRefinementV0)
              (nth refinements position)]
          (if (and
                (same-id? source-id
                  (keywordflowrefinementv0-source-id refinement))
                (same-id? source-type
                  (keywordflowrefinementv0-source-type refinement))
                (= keyword (keywordflowrefinementv0-keyword refinement))
                (same-id? lookup-type
                  (keywordflowrefinementv0-lookup-type refinement)))
            refinement
            (recur (- position 1))))))))

(defn find-value-refinement
  [(state BodyStateV0)
   (source-id core/NativeId)
   (source-type core/NativeId)]
  (U ValueFlowRefinementV0 Nil)
  (let [(refinements (Vec ValueFlowRefinementV0))
        (bodystatev0-value-refinements state)]
    (loop [(position Int) (- (count refinements) 1)]
      (if (< position 0)
        nil
        (let [(refinement ValueFlowRefinementV0) (nth refinements position)]
          (if (and
                (same-id? source-id
                  (valueflowrefinementv0-source-id refinement))
                (same-id? source-type
                  (valueflowrefinementv0-source-type refinement)))
            refinement
            (recur (- position 1))))))))
(defn source-ref-binding
  [(env BodyEnvV0)
   (state BodyStateV0)
   (source core/NativeId)]
  (U LocalBindingV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (not (= "ref" (fact-text index source "form-kind")))
      nil
      (let [(name String) (fact-text index source "name")
            (direct (U LocalBindingV0 Nil))
            (find-local (bodystatev0-locals state) name)
            (canonical String)
            (resolved-source-key
              (resolve-source-name index (source-module-name index source) name))]
        (if (some? direct)
          direct
          (find-local (bodystatev0-locals state) canonical))))))

(defn signature-position-at
  [(env BodyEnvV0) (resolved ResolvedSourceNameV0)] (U Int Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (signatures (Vec TypedFunctionV0)) (bodyenvv0-signatures env)
        (sources (Vec core/NativeId)) (bodyenvv0-signature-sources env)]
    (if (not (resolvedsourcenamev0-visible resolved))
      nil
      (loop [(position Int) 0]
        (if (or (>= position (count signatures)) (>= position (count sources)))
          nil
          (let [(signature TypedFunctionV0) (nth signatures position)
                (source core/NativeId) (nth sources position)]
            (if (and
                  (= (resolvedsourcenamev0-local-name resolved)
                    (typedfunctionv0-name signature))
                  (= (resolvedsourcenamev0-module-name resolved)
                    (source-module-name index source)))
              position
              (recur (+ position 1)))))))))

(defn global-at
  [(env BodyEnvV0) (resolved ResolvedSourceNameV0)] (U GlobalBindingV0 Nil)
  (let [(globals (Vec GlobalBindingV0)) (bodyenvv0-globals env)]
    (if (not (resolvedsourcenamev0-visible resolved))
      nil
      (loop [(position Int) 0]
        (if (>= position (count globals))
          nil
          (let [(global GlobalBindingV0) (nth globals position)]
            (if (and
                  (= (resolvedsourcenamev0-module-name resolved)
                    (globalbindingv0-module-name global))
                  (= (resolvedsourcenamev0-local-name resolved)
                    (globalbindingv0-name global)))
              global
              (recur (+ position 1)))))))))

;; Immutable top-level refs are transparent function aliases. Resolve them
;; before body lowering so every call still targets the canonical FunctionDef.
(defn function-signature-position
  [(env BodyEnvV0) (source core/NativeId) (spelling String)] (U Int Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (globals (Vec GlobalBindingV0)) (bodyenvv0-globals env)
        (initial ResolvedSourceNameV0)
        (resolve-source-name index (source-module-name index source) spelling)]
    (loop [(resolved ResolvedSourceNameV0) initial
           (fuel Int) (+ 1 (count globals))]
      (let [(position (U Int Nil)) (signature-position-at env resolved)]
        (cond
          (some? position) position
          (<= fuel 0) nil
          :else
          (let [(global (U GlobalBindingV0 Nil)) (global-at env resolved)]
            (if (nil? global)
              nil
              (let [(value core/NativeId) (globalbindingv0-value global)
                    (target String) (fact-text index value "name")]
                (if (or (not (= "ref" (fact-text index value "form-kind")))
                        (= "" target))
                  nil
                  (recur
                    (resolve-source-name index
                      (globalbindingv0-module-name global) target)
                    (- fuel 1)))))))))))

(defn find-signature
  [(env BodyEnvV0)
   (source core/NativeId)
   (spelling String)]
  (U TypedFunctionV0 Nil)
  (let [(position (U Int Nil))
        (function-signature-position env source spelling)]
    (if (nil? position)
      nil
      (nth (bodyenvv0-signatures env) position))))

(defn find-signature-source
  [(env BodyEnvV0)
   (source core/NativeId)
   (spelling String)]
  (U core/NativeId Nil)
  (let [(position (U Int Nil))
        (function-signature-position env source spelling)]
    (if (nil? position)
      nil
      (nth (bodyenvv0-signature-sources env) position))))

(defn signature-traps? [(env BodyEnvV0) (signature TypedFunctionV0)] Bool
  (let [(signatures (Vec TypedFunctionV0)) (bodyenvv0-signatures env)
        (sources (Vec core/NativeId)) (bodyenvv0-signature-sources env)
        (index SourceIndexV0) (bodyenvv0-index env)]
    (loop [(position Int) 0]
      (if (or (>= position (count signatures)) (>= position (count sources)))
        false
        (if (not (same-id? (typedfunctionv0-id signature)
                  (typedfunctionv0-id (nth signatures position))))
          (recur (+ position 1))
          (let [(body (U core/NativeId Nil))
                (index-first-object index (nth sources position) "body")]
            (and (some? body)
              (= "call" (fact-text index body "form-kind"))
              (= "throw" (fact-text index body "callee")))))))))

(defn tail-parameters [(parameters (Vec core/Parameter))] (Vec core/Parameter)
  (loop [(position Int) 1 (collected (Vec core/Parameter)) []]
    (if (>= position (count parameters))
      collected
      (recur (+ position 1) (conj collected (nth parameters position))))))

(defn pure-updater-signature?
  [(signature TypedFunctionV0)
   (content-type core/NativeId)
   (extra-count Int)]
  Bool
  (let [(parameters (Vec core/Parameter))
        (typedfunctionv0-parameters signature)
        (effects (Vec core/NativeId)) (typedfunctionv0-effects signature)]
    (and (= (+ extra-count 1) (count parameters))
      (> (count parameters) 0)
      (same-id? content-type
        (core/parameter-type-id (nth parameters 0)))
      (same-id? content-type (typedfunctionv0-return-type signature))
      (= 1 (count effects))
      (same-id? (pure-effect-id) (nth effects 0)))))

;; A Beagle record accessor is spelled <lowercased record name>-<field>.
(defrecord AccessorHitV0
  [(found Bool)
   (owner-type core/NativeId)
   (field-id core/NativeId)
   (field-type core/NativeId)])

(defn accessor-miss [] AccessorHitV0
  (->AccessorHitV0 false (type-id "LowerFailure") (type-id "LowerFailure")
    (type-id "LowerFailure")))

(defn record-accessor
  [(types (Vec core/TypeDef)) (resolved ResolvedSourceNameV0)] AccessorHitV0
  (let [(callee String) (resolvedsourcenamev0-local-name resolved)
        (module-name String) (resolvedsourcenamev0-module-name resolved)]
   (loop [(position Int) 0]
    (if (>= position (count types))
      (accessor-miss)
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (or (not (resolvedsourcenamev0-visible resolved))
              (not (instance? native.core.RecordType shape))
              (not
                (same-id? (core/typedef-id definition)
                  (source-type-id
                    (str module-name "/" (core/typedef-name definition))))))
          (recur (+ position 1))
          (let [(prefix String) (str (ascii-lower (core/typedef-name definition)) "-")
                (fields (Vec core/TypeField)) (core/recordtype-fields shape)
                (hit AccessorHitV0)
                (loop [(field-position Int) 0]
                  (if (>= field-position (count fields))
                    (accessor-miss)
                    (let [(field core/TypeField) (nth fields field-position)]
                      (if (= callee (str prefix (core/typefield-name field)))
                        (->AccessorHitV0 true (core/typedef-id definition)
                          (core/typefield-id field) (core/typefield-type-id field))
                        (recur (+ field-position 1))))))]
            (if (accessorhitv0-found hit) hit (recur (+ position 1))))))))))

(defn record-constructor
  [(types (Vec core/TypeDef))
   (resolved ResolvedSourceNameV0)]
  (U core/TypeDef Nil)
  (let [(local-name String) (resolvedsourcenamev0-local-name resolved)]
    (if (or (not (resolvedsourcenamev0-visible resolved))
          (<= (count local-name) 2)
          (not (= "->" (subs local-name 0 2))))
      nil
      (lookup-type types
        (source-type-id
          (str (resolvedsourcenamev0-module-name resolved) "/"
            (subs local-name 2 (count local-name))))))))

(defn source-union-for-member
  [(index SourceIndexV0)
   (module-name String)
   (member-name String)]
  (U core/NativeId Nil)
  (let [(unions (Vec core/NativeId))
        (vec (concat (index-form-ids index "defunion")
               (index-form-ids index "deferror")))]
    (loop [(position Int) 0]
      (if (>= position (count unions))
        nil
        (let [(source-union core/NativeId) (nth unions position)
              (groups (Vec core/NativeId))
              (union-member-group-items index source-union)]
          (if (and (= module-name (source-module-name index source-union))
                (some?
                  (some
                    (fn [(group core/NativeId)] Bool
                      (= member-name (fact-text index group "name")))
                    groups)))
            source-union
            (recur (+ position 1))))))))

(defn union-member-constructor
  [(env BodyEnvV0) (resolved ResolvedSourceNameV0)] (U core/TypeDef Nil)
  (let [(name String) (resolvedsourcenamev0-local-name resolved)]
    (if (or (not (resolvedsourcenamev0-visible resolved))
          (<= (count name) 2) (not (= "->" (subs name 0 2))))
      nil
      (let [(member String) (subs name 2 (count name))
            (index SourceIndexV0) (bodyenvv0-index env)
            (source-union (U core/NativeId Nil))
            (source-union-for-member index
              (resolvedsourcenamev0-module-name resolved) member)]
        (if (nil? source-union)
          nil
          (lookup-type (bodyenvv0-types env)
            (source-type-id
              (str (resolvedsourcenamev0-module-name resolved) "/" member))))))))

(defn record-keyword-field
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (keyword String)]
  AccessorHitV0
  (let [(target-definition (U core/TypeDef Nil)) (lookup-type types target)
        (owner (U core/NativeId Nil))
        (if (nil? target-definition)
          nil
          (let [(shape core/TypeShape) (core/typedef-shape target-definition)]
            (cond
              (instance? native.core.RecordType shape) target
              (instance? native.core.ReferenceType shape)
              (core/referencetype-target-type shape)
              :else nil)))]
    (if (nil? owner)
      (accessor-miss)
      (let [(definition (U core/TypeDef Nil)) (lookup-type types owner)]
        (if (nil? definition)
          (accessor-miss)
          (let [(shape core/TypeShape) (core/typedef-shape definition)]
            (if (not (instance? native.core.RecordType shape))
              (accessor-miss)
              (loop [(position Int) 0
                     (fields (Vec core/TypeField)) (core/recordtype-fields shape)]
                (if (>= position (count fields))
                  (accessor-miss)
                  (let [(field core/TypeField) (nth fields position)]
                    (if (= keyword (core/typefield-name field))
                      (->AccessorHitV0 true owner (core/typefield-id field)
                        (core/typefield-type-id field))
                      (recur (+ position 1) fields))))))))))))

(defn union-variants-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] (Vec core/TypeVariant)
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      []
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (cond
          (instance? native.core.UnionType shape)
          (core/uniontype-variants shape)

          (instance? native.core.OutcomeType shape)
          (union-variants-of types (core/outcometype-failure-type shape))

          :else [])))))

(defn variant-named
  [(variants (Vec core/TypeVariant)) (name String)] (U core/TypeVariant Nil)
  (loop [(position Int) 0]
    (if (>= position (count variants))
      nil
      (let [(variant core/TypeVariant) (nth variants position)]
        (if (= name (core/typevariant-name variant))
          variant
          (recur (+ position 1)))))))

(defn payloadless-union-member-constructor
  [(env BodyEnvV0) (resolved ResolvedSourceNameV0)] (U core/TypeDef Nil)
  (let [(name String) (resolvedsourcenamev0-local-name resolved)]
    (if (or (not (resolvedsourcenamev0-visible resolved))
          (<= (count name) 2) (not (= "->" (subs name 0 2))))
      nil
      (let [(member String) (subs name 2 (count name))
            (index SourceIndexV0) (bodyenvv0-index env)
            (source-union (U core/NativeId Nil))
            (source-union-for-member index
              (resolvedsourcenamev0-module-name resolved) member)]
        (if (nil? source-union)
          nil
          (let [(definition (U core/TypeDef Nil))
                (lookup-type (bodyenvv0-types env)
                  (source-type-id
                    (str (resolvedsourcenamev0-module-name resolved) "/"
                      (fact-text index source-union "name"))))]
            (if (nil? definition)
              nil
              (let [(shape core/TypeShape) (core/typedef-shape definition)
                    (variant (U core/TypeVariant Nil))
                    (if (instance? native.core.UnionType shape)
                      (variant-named (core/uniontype-variants shape) member)
                      nil)]
                (if (or (nil? variant)
                      (some? (core/typevariant-payload-type variant)))
                  nil
                  definition)))))))))

(defn compare-op-for [(callee String)] (U core/CompareOpV0 Nil)
  (cond
    (= "=" callee) (core/->CompareEqI64V0 true)
    (= "<" callee) (core/->CompareLtI64V0 true)
    (= "<=" callee) (core/->CompareLeI64V0 true)
    (= ">" callee) (core/->CompareLtI64V0 true)
    (= ">=" callee) (core/->CompareLeI64V0 true)
    :else nil))

(defn compare-swaps? [(callee String)] Bool
  (or (= ">" callee) (= ">=" callee)))

(defn bool-type-id [] core/NativeId (type-id "Bool"))

(defn int-type-id [] core/NativeId (type-id "Int"))

(defn float-type-id [] core/NativeId (type-id "Float"))

(defn float-compare-op-for [(callee String)] core/CompareOpV0
  (cond
    (= "=" callee) (core/->CompareEqF64V0 true)
    (or (= "<" callee) (= ">" callee)) (core/->CompareLtF64V0 true)
    :else (core/->CompareLeF64V0 true)))

;; v0 traps carry an i64 failure code, not a payload: the closed LowerFailure
;; union names the codes, and the host exception argument is discarded.
(defn trap-failure-code [] Int 1)

;; NATIVE_TRAP_OVERFLOW in native-core/shim/native_shim.h.
(defn overflow-failure-code [] Int 2)

;; v0 integer arithmetic is checked, never wrapping and never bare: every
;; operation answers an Outcome the caller has to dispatch on.
(defn checked-arith-op? [(callee String)] Bool
  (or (= "+" callee) (= "-" callee) (= "*" callee)))

(defn checked-division-op? [(callee String)] Bool
  (or (= "quot" callee) (= "rem" callee) (= "mod" callee)))

(defn refused-arith-op? [(callee String)] Bool
  (= "/" callee))

(defn exact-binary-float-values? [(value-types (Vec core/NativeId))] Bool
  (and (= 2 (count value-types))
       (same-id? (nth value-types 0) (float-type-id))
       (same-id? (nth value-types 1) (float-type-id))))

(defn lower-f64-binary
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (left core/NativeId)
   (right core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "f64-arith")
        (instruction core/Instruction)
        (cond
          (= "+" callee)
          (core/->AddF64Instruction
            (core/->SsaValueV0 result-id (float-type-id)) left right)

          (= "-" callee)
          (core/->SubF64InstructionV0
            (core/->SsaValueV0 result-id (float-type-id)) left right)

          (= "*" callee)
          (core/->MulF64InstructionV0
            (core/->SsaValueV0 result-id (float-type-id)) left right)

          :else
          (core/->DivF64InstructionV0
            (core/->SsaValueV0 result-id (float-type-id)) left right))]
    (->ExprResultV0
     (state-emit (state-bump state) instruction)
     result-id (float-type-id) false)))

(defn checked-arith-operation
  [(callee String)
   (left core/NativeId)
   (right core/NativeId)]
  core/CheckedOperationV0
  (cond
    (= "+" callee) (core/->CheckedAddI64V0 left right)
    (= "-" callee) (core/->CheckedSubI64V0 left right)
    :else (core/->CheckedMulI64V0 left right)))

(defn checked-division-operation
  [(callee String)
   (left core/NativeId)
   (right core/NativeId)]
  core/CheckedOperationV0
  (cond
    (= "quot" callee) (core/->CheckedQuotI64V0 left right)
    (= "rem" callee) (core/->CheckedRemI64V0 left right)
    :else (core/->CheckedModI64V0 left right)))

;; The trap-on-overflow variant is not a second instruction: it is the ordinary
;; dispatch, with the overflow arm closing on a trap and the ok arm reading the
;; value out of the alternative whose tag it has just proved.
(defn lower-checked-arith
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (left core/NativeId)
   (right core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "arith")
        (ok-id core/NativeId) (state-id state owner "arith-ok")
        (overflow-id core/NativeId) (state-id state owner "arith-overflow")
        (carried core/NativeId) (state-id state owner "arith-outcome")
        (value-id core/NativeId) (state-id state owner "arith-value")
        (code-id core/NativeId) (state-id state owner "arith-trap")
        (outcome-type core/NativeId) (core/checked-i64-type-id)
        (switched BodyStateV0)
        (state-close
          (state-emit (state-bump state)
            (core/->CheckedInstruction
              (core/->SsaValueV0 result-id outcome-type)
              (checked-arith-operation callee left right)))
          (core/->SwitchTerminator result-id
            [(core/->SwitchCaseV0 (core/checked-ok-variant-id) ok-id [result-id])
             (core/->SwitchCaseV0 (core/checked-overflow-variant-id)
               overflow-id [])]))
        (trapped BodyStateV0)
        (state-close
          (state-emit (state-open-block switched overflow-id [])
            (core/->AtomInstruction
              (core/->SsaValueV0 code-id (int-type-id))
              (core/->I64Atom (overflow-failure-code))))
          (core/->TrapTerminator code-id))]
    (->ExprResultV0
      (state-emit
        (state-open-block trapped ok-id
          [(core/->Parameter carried outcome-type)])
        (core/->VariantValueInstruction
          (core/->SsaValueV0 value-id (int-type-id))
          carried (core/checked-ok-variant-id)))
      value-id (int-type-id) false)))

(defn lower-checked-arith-values
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (values (Vec core/NativeId))]
  ExprResultV0
  (cond
    (= 0 (count values))
    (let [(result-id core/NativeId) (state-id state owner "arith-identity")]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->AtomInstruction
            (core/->SsaValueV0 result-id (int-type-id))
            (core/->I64Atom (if (= "*" callee) 1 0))))
        result-id (int-type-id) false))

    (and (= "-" callee) (= 1 (count values)))
    (let [(zero-id core/NativeId) (state-id state owner "arith-zero")
          (with-zero BodyStateV0)
          (state-emit (state-bump state)
            (core/->AtomInstruction
              (core/->SsaValueV0 zero-id (int-type-id))
              (core/->I64Atom 0)))]
      (lower-checked-arith with-zero owner callee zero-id (nth values 0)))

    (= 1 (count values))
    (->ExprResultV0 state (nth values 0) (int-type-id) false)

    :else
    (loop [(position Int) 1
           (current BodyStateV0) state
           (left core/NativeId) (nth values 0)]
      (let [(step ExprResultV0)
            (lower-checked-arith current owner callee left
              (nth values position))
            (settled BodyStateV0) (exprresultv0-state step)]
        (cond
          (state-blocked? settled) (dead-result settled)
          (= (+ position 1) (count values)) step
          :else
          (recur (+ position 1) settled (exprresultv0-value-id step)))))))

(defn lower-checked-division
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (left core/NativeId)
   (right core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "division")
        (ok-id core/NativeId) (state-id state owner "division-ok")
        (zero-id core/NativeId) (state-id state owner "division-zero")
        (carried core/NativeId) (state-id state owner "division-outcome")
        (value-id core/NativeId) (state-id state owner "division-value")
        (code-id core/NativeId) (state-id state owner "division-trap")
        (outcome-type core/NativeId) (core/checked-division-i64-type-id)
        (switched BodyStateV0)
        (state-close
          (state-emit (state-bump state)
            (core/->CheckedInstruction
              (core/->SsaValueV0 result-id outcome-type)
              (checked-division-operation callee left right)))
          (core/->SwitchTerminator result-id
            [(core/->SwitchCaseV0
               (core/checked-division-ok-variant-id) ok-id [result-id])
             (core/->SwitchCaseV0
               (core/checked-division-zero-variant-id) zero-id [])]))
        (trapped BodyStateV0)
        (state-close
          (state-emit (state-open-block switched zero-id [])
            (core/->AtomInstruction
              (core/->SsaValueV0 code-id (int-type-id))
              (core/->I64Atom (trap-failure-code))))
          (core/->TrapTerminator code-id))]
    (->ExprResultV0
      (state-emit
        (state-open-block trapped ok-id
          [(core/->Parameter carried outcome-type)])
        (core/->VariantValueInstruction
          (core/->SsaValueV0 value-id (int-type-id))
          carried (core/checked-division-ok-variant-id)))
      value-id (int-type-id) false)))

;; One accumulator's init, lowered: the name it binds, its value and the type
;; that init fixes for the whole loop.
(defrecord LoopInitsV0
  [(state BodyStateV0)
   (bindings (Vec core/NativeId))
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))
   (terminated Bool)])

(defn index-child-nodes
  [(index SourceIndexV0) (subject core/NativeId)] (Vec core/NativeId)
  (let [(children (U (Vec core/NativeId) Nil))
        (get (sourceindexv0-child-nodes index) (id-value subject))]
    (if (nil? children) [] children)))

(defn string-member? [(values (Vec String)) (target String)] Bool
  (some?
    (some (fn [(value String)] Bool (= value target)) values)))

(defn append-unique-strings
  [(values (Vec String)) (additions (Vec String))] (Vec String)
  (loop [(position Int) 0 (current (Vec String)) values]
    (if (>= position (count additions))
      current
      (let [(addition String) (nth additions position)]
        (recur (+ position 1)
          (if (string-member? current addition)
            current
            (conj current addition)))))))

(defn binding-name-items
  [(index SourceIndexV0)
   (target core/NativeId)
   (predicate String)]
  (Vec core/NativeId)
  (let [(items (U core/NativeId Nil))
        (index-first-object index target predicate)]
    (if (nil? items) [] (index-sequence-items index items))))

(defn binding-target-bound-names
  [(index SourceIndexV0) (target core/NativeId)] (Vec String)
  (let [(kind String) (fact-text index target "form-kind")]
    (cond
      (= "binding-name" kind)
      (let [(name String) (fact-text index target "name")]
        (if (= "" name) [] [name]))

      (= "map-destructure" kind)
      (let [(keys (Vec core/NativeId)) (binding-name-items index target "keys")
            (as-name String) (fact-text index target "as")
            (names (Vec String))
            (loop [(position Int) 0 (collected (Vec String)) []]
              (if (>= position (count keys))
                collected
                (let [(name String) (fact-text index (nth keys position) "name")]
                  (recur (+ position 1)
                    (if (= "" name) collected (conj collected name))))))]
        (if (= "" as-name) names (conj names as-name)))

      (= "seq-destructure" kind)
      (let [(items (Vec core/NativeId))
            (binding-name-items index target "names")
            (rest-name String) (fact-text index target "rest")
            (names (Vec String))
            (loop [(position Int) 0 (collected (Vec String)) []]
              (if (>= position (count items))
                collected
                (recur (+ position 1)
                  (append-unique-strings collected
                    (binding-target-bound-names index (nth items position))))))]
        (if (= "" rest-name) names (conj names rest-name)))

      :else [])))

(defn source-parameter-bound-names
  [(index SourceIndexV0) (source-parameter core/NativeId)] (Vec String)
  (let [(name (U String Nil)) (index-first-text index source-parameter "name")
        (target (U core/NativeId Nil))
        (parameter-target-at index source-parameter)]
    (cond
      (some? target) (binding-target-bound-names index target)
      (some? name) [name]
      :else [])))

(defn source-parameters-bound-names
  [(index SourceIndexV0) (source-parameters (Vec core/NativeId))] (Vec String)
  (loop [(position Int) 0 (collected (Vec String)) []]
    (if (>= position (count source-parameters))
      collected
      (recur (+ position 1)
        (append-unique-strings collected
          (source-parameter-bound-names index
            (nth source-parameters position)))))))

(defn match-clause-items
  [(index SourceIndexV0) (match-node core/NativeId)] (Vec core/NativeId)
  (let [(clauses (U core/NativeId Nil))
        (index-first-object index match-node "clauses")]
    (if (nil? clauses) [] (index-sequence-items index clauses))))

(defn match-pattern-binding-items
  [(index SourceIndexV0) (pattern core/NativeId)] (Vec core/NativeId)
  (let [(bindings (U core/NativeId Nil))
        (index-first-object index pattern "bindings")]
    (if (nil? bindings) [] (index-sequence-items index bindings))))

(defn match-pattern-bound-names
  [(index SourceIndexV0) (pattern core/NativeId)] (Vec String)
  (let [(kind String) (fact-text index pattern "pattern-kind")]
    (cond
      (= "var" kind)
      (let [(name String) (fact-text index pattern "name")]
        (if (or (= "" name) (= "_" name)) [] [name]))

      (= "record" kind)
      (loop [(position Int) 0
             (bindings (Vec core/NativeId))
             (match-pattern-binding-items index pattern)
             (names (Vec String)) []]
        (if (>= position (count bindings))
          names
          (let [(name String)
                (fact-text index (nth bindings position) "name")]
            (recur (+ position 1) bindings
              (if (or (= "" name) (= "_" name)) names
                (conj names name))))))

      :else [])))

(defn source-free-names
  [(index SourceIndexV0)
   (node core/NativeId)
   (bound (Vec String))
   (include-callees Bool)
   (fuel Int)]
  (Vec String)
  (if (<= fuel 0)
    []
    (let [(kind String) (fact-text index node "form-kind")]
      (cond
        (= "ref" kind)
        (let [(name String) (fact-text index node "name")]
          (if (or (= "" name) (= "else" name) (string-member? bound name)) [] [name]))

        (or (= "call" kind) (= "static-call" kind))
        (let [(callee String) (fact-text index node "callee")
              (own (Vec String))
              (if (or (not include-callees) (= "" callee)
                      (string-member? bound callee))
                [] [callee])
              (children (Vec core/NativeId)) (index-child-nodes index node)]
          (loop [(position Int) 0 (names (Vec String)) own]
            (if (>= position (count children))
              names
              (recur (+ position 1)
                (append-unique-strings names
                  (source-free-names index (nth children position) bound
                    include-callees (- fuel 1)))))))

        (or (= "defn" kind) (= "fn" kind) (= "arity-clause" kind)
            (= "protocol-method" kind) (= "impl-method" kind))
        (let [(parameters (Vec core/NativeId))
              (function-parameter-items index node)
              (constraint-refs (Vec String))
              (loop [(position Int) 0 (names (Vec String)) []]
                (if (>= position (count parameters))
                  names
                  (let [(constraint (U core/NativeId Nil))
                        (index-first-object index (nth parameters position)
                          "constraint")]
                    (recur (+ position 1)
                      (if (nil? constraint)
                        names
                        (append-unique-strings names
                          (source-free-names index constraint bound include-callees
                            (- fuel 1))))))))
              (body-bound (Vec String))
              (append-unique-strings bound
                (source-parameters-bound-names index parameters))
              (body (U core/NativeId Nil))
              (index-first-object index node "body")]
          (if (nil? body)
            constraint-refs
            (append-unique-strings constraint-refs
              (source-free-names index body body-bound include-callees
                (- fuel 1)))))

        (or (= "let" kind) (= "loop" kind))
        (let [(bindings-node (U core/NativeId Nil))
              (index-first-object index node "bindings")
              (items (Vec core/NativeId))
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              (binding-refs (Vec String))
              (loop [(position Int) 0
                     (current-bound (Vec String)) bound
                     (names (Vec String)) []]
                (if (>= position (count items))
                  names
                  (let [(binding core/NativeId) (nth items position)
                        (value (U core/NativeId Nil))
                        (index-first-object index binding "value")
                        (constraint (U core/NativeId Nil))
                        (index-first-object index binding "constraint")
                        (found (Vec String))
                        (append-unique-strings
                          (if (nil? constraint) []
                            (source-free-names index constraint current-bound
                              include-callees (- fuel 1)))
                          (if (nil? value) []
                            (source-free-names index value current-bound
                              include-callees (- fuel 1))))
                        (binding-names (Vec String))
                        (source-parameter-bound-names index binding)]
                    (recur (+ position 1)
                      (append-unique-strings current-bound binding-names)
                      (append-unique-strings names found)))))
              (body-bound (Vec String))
              (loop [(position Int) 0 (current (Vec String)) bound]
                (if (>= position (count items))
                  current
                  (let [(binding-names (Vec String))
                        (source-parameter-bound-names index
                          (nth items position))]
                    (recur (+ position 1)
                      (append-unique-strings current binding-names)))))
              (body (U core/NativeId Nil)) (index-first-object index node "body")]
          (if (nil? body)
            binding-refs
            (append-unique-strings binding-refs
              (source-free-names index body body-bound include-callees
                (- fuel 1)))))

        (= "doseq" kind)
        (let [(clauses-node (U core/NativeId Nil))
              (index-first-object index node "clauses")
              (clauses (Vec core/NativeId))
              (if (nil? clauses-node) []
                (index-sequence-items index clauses-node))
              (binding-names (Vec String))
              (if (and (= 1 (count clauses))
                    (= "binding" (fact-text index (nth clauses 0) "clause-kind")))
                (source-parameter-bound-names index (nth clauses 0))
                [])
              (clause-refs (Vec String))
              (loop [(position Int) 0 (names (Vec String)) []]
                (if (>= position (count clauses))
                  names
                  (let [(value (U core/NativeId Nil))
                        (index-first-object index (nth clauses position) "value")
                        (constraint (U core/NativeId Nil))
                        (index-first-object index (nth clauses position)
                          "constraint")]
                    (recur (+ position 1)
                      (append-unique-strings names
                        (append-unique-strings
                          (if (nil? constraint) []
                            (source-free-names index constraint bound include-callees
                              (- fuel 1)))
                          (if (nil? value) []
                            (source-free-names index value bound include-callees
                              (- fuel 1)))))))))
              (body-node (U core/NativeId Nil))
              (index-first-object index node "body")
              (bodies (Vec core/NativeId))
              (if (nil? body-node) [] (index-sequence-items index body-node))
              (body-bound (Vec String))
              (append-unique-strings bound binding-names)]
          (loop [(position Int) 0 (names (Vec String)) clause-refs]
            (if (>= position (count bodies))
              names
              (recur (+ position 1)
                (append-unique-strings names
                  (source-free-names index (nth bodies position) body-bound
                    include-callees (- fuel 1)))))))

        (= "match" kind)
        (let [(target (U core/NativeId Nil))
              (index-first-object index node "target")
              (clauses (Vec core/NativeId)) (match-clause-items index node)
              (target-refs (Vec String))
              (if (nil? target) []
                (source-free-names index target bound include-callees
                  (- fuel 1)))]
          (loop [(position Int) 0 (names (Vec String)) target-refs]
            (if (>= position (count clauses))
              names
              (let [(clause core/NativeId) (nth clauses position)
                    (pattern (U core/NativeId Nil))
                    (index-first-object index clause "pattern")
                    (body (U core/NativeId Nil))
                    (index-first-object index clause "body")
                    (arm-bound (Vec String))
                    (if (nil? pattern) bound
                      (append-unique-strings bound
                        (match-pattern-bound-names index pattern)))
                    (arm-refs (Vec String))
                    (if (nil? body) []
                      (source-free-names index body arm-bound include-callees
                        (- fuel 1)))]
                (recur (+ position 1)
                  (append-unique-strings names arm-refs))))))

        :else
        (let [(children (Vec core/NativeId)) (index-child-nodes index node)]
          (loop [(position Int) 0 (names (Vec String)) []]
            (if (>= position (count children))
              names
              (recur (+ position 1)
                (append-unique-strings names
                  (source-free-names index (nth children position) bound
                    include-callees (- fuel 1)))))))))))

(defn source-free-ref-names
  [(index SourceIndexV0)
   (node core/NativeId)
   (bound (Vec String))
   (fuel Int)]
  (Vec String)
  (source-free-names index node bound false fuel))

(defn source-direct-ref-names
  [(index SourceIndexV0)
   (node core/NativeId)
   (bound (Vec String))
   (fuel Int)]
  (Vec String)
  (source-free-names index node bound true fuel))

(defn source-ref-keys
  [(index SourceIndexV0)
   (module-name String)
   (node core/NativeId)
   (bound (Vec String))
   (fuel Int)]
  (Vec String)
  (let [(names (Vec String)) (source-free-ref-names index node bound fuel)]
    (loop [(position Int) 0 (keys (Vec String)) []]
      (if (>= position (count names))
        keys
        (let [(key String)
              (resolved-source-key
                (resolve-source-name index module-name (nth names position)))]
          (recur (+ position 1)
            (if (or (= "" key) (string-member? keys key)) keys (conj keys key))))))))

(defn close-global-keys
  [(index SourceIndexV0)
   (globals (Vec GlobalBindingV0))
   (seeds (Vec String))]
  (Vec String)
  (loop [(round Int) 0 (keys (Vec String)) seeds]
    (if (>= round (count globals))
      keys
      (let [(expanded (Vec String))
            (loop [(position Int) 0 (current (Vec String)) keys]
              (if (>= position (count globals))
                current
                (let [(global GlobalBindingV0) (nth globals position)]
                  (recur (+ position 1)
                    (if (string-member? current (global-key global))
                      (append-unique-strings current
                        (source-ref-keys index (globalbindingv0-module-name global)
                          (globalbindingv0-value global) []
                          (+ 1 (index-facts index))))
                      current)))))]
        (if (= (count expanded) (count keys))
          keys
          (recur (+ round 1) expanded))))))

(defn needed-globals
  [(env BodyEnvV0)
   (body core/NativeId)
   (bound (Vec String))]
  (Vec GlobalBindingV0)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (globals (Vec GlobalBindingV0)) (bodyenvv0-globals env)
        (keys (Vec String))
        (close-global-keys index globals
          (source-ref-keys index (source-module-name index body) body bound
            (+ 1 (index-facts index))))]
    (loop [(position Int) 0 (selected (Vec GlobalBindingV0)) []]
      (if (>= position (count globals))
        selected
        (let [(global GlobalBindingV0) (nth globals position)]
          (recur (+ position 1)
            (if (string-member? keys (global-key global))
              (conj selected global)
              selected)))))))

;; A nested loop's body belongs to its own header (its init forms do not), and
;; an unknown form kind is walked as non-tail so a `recur` reachable through
;; another arm's form is refused rather than mislowered.
(defn recur-tail-only?
  [(index SourceIndexV0) (node core/NativeId) (tail Bool) (fuel Int)] Bool
  (if (<= fuel 0)
    false
    (let [(kind String) (fact-text index node "form-kind")]
      (cond
        (= "recur" kind)
        (let [(args-node (U core/NativeId Nil)) (index-first-object index node "args")
              (args (Vec core/NativeId))
              (if (nil? args-node) [] (index-sequence-items index args-node))]
          (and tail
            (loop [(position Int) 0]
              (if (>= position (count args))
                true
                (if (recur-tail-only? index (nth args position) false (- fuel 1))
                  (recur (+ position 1))
                  false)))))

        (= "loop" kind)
        (let [(bindings-node (U core/NativeId Nil))
              (index-first-object index node "bindings")
              (items (Vec core/NativeId))
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))]
          (loop [(position Int) 0]
            (if (>= position (count items))
              true
              (let [(value-node (U core/NativeId Nil))
                    (index-first-object index (nth items position) "value")]
                (if (or (nil? value-node)
                        (recur-tail-only? index value-node false (- fuel 1)))
                  (recur (+ position 1))
                  false)))))

        (= "if" kind)
        (let [(condition-node (U core/NativeId Nil))
              (index-first-object index node "cond")
              (then-node (U core/NativeId Nil)) (index-first-object index node "then")
              (else-node (U core/NativeId Nil)) (index-first-object index node "else")]
          (and
            (or (nil? condition-node)
                (recur-tail-only? index condition-node false (- fuel 1)))
            (or (nil? then-node)
                (recur-tail-only? index then-node tail (- fuel 1)))
            (or (nil? else-node)
                (recur-tail-only? index else-node tail (- fuel 1)))))

        (= "cond" kind)
        (let [(clauses-node (U core/NativeId Nil))
              (index-first-object index node "clauses")
              (clauses (Vec core/NativeId))
              (if (nil? clauses-node) []
                (index-sequence-items index clauses-node))]
          (loop [(position Int) 0]
            (if (>= position (count clauses))
              true
              (let [(clause core/NativeId) (nth clauses position)
                    (test-node (U core/NativeId Nil))
                    (index-first-object index clause "test")
                    (body-node (U core/NativeId Nil))
                    (index-first-object index clause "body")]
                (if (and
                      (or (nil? test-node)
                        (recur-tail-only? index test-node false (- fuel 1)))
                      (or (nil? body-node)
                        (recur-tail-only? index body-node tail (- fuel 1))))
                  (recur (+ position 1))
                  false)))))

        (= "match" kind)
        (let [(target (U core/NativeId Nil))
              (index-first-object index node "target")
              (clauses (Vec core/NativeId)) (match-clause-items index node)]
          (and
            (or (nil? target)
              (recur-tail-only? index target false (- fuel 1)))
            (loop [(position Int) 0]
              (if (>= position (count clauses))
                true
                (let [(body (U core/NativeId Nil))
                      (index-first-object index (nth clauses position) "body")]
                  (if (or (nil? body)
                        (recur-tail-only? index body tail (- fuel 1)))
                    (recur (+ position 1))
                    false))))))

        (= "do" kind)
        (let [(body-node (U core/NativeId Nil))
              (index-first-object index node "body")
              (forms (Vec core/NativeId))
              (if (nil? body-node) [] (index-sequence-items index body-node))]
          (loop [(position Int) 0]
            (if (>= position (count forms))
              true
              (if (recur-tail-only? index (nth forms position)
                    (and tail (= (+ position 1) (count forms))) (- fuel 1))
                (recur (+ position 1))
                false))))

        (= "let" kind)
        (let [(bindings-node (U core/NativeId Nil))
              (index-first-object index node "bindings")
              (items (Vec core/NativeId))
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              (body-node (U core/NativeId Nil)) (index-first-object index node "body")]
          (and
            (loop [(position Int) 0]
              (if (>= position (count items))
                true
                (let [(value-node (U core/NativeId Nil))
                      (index-first-object index (nth items position) "value")]
                  (if (or (nil? value-node)
                          (recur-tail-only? index value-node false (- fuel 1)))
                    (recur (+ position 1))
                    false))))
            (or (nil? body-node)
                (recur-tail-only? index body-node tail (- fuel 1)))))

        :else
        (let [(children (Vec core/NativeId)) (index-child-nodes index node)]
          (loop [(position Int) 0]
            (if (>= position (count children))
              true
              (if (recur-tail-only? index (nth children position) false (- fuel 1))
                (recur (+ position 1))
                false))))))))

(defn recur-type-mismatch
  [(parameters (Vec core/Parameter)) (value-types (Vec core/NativeId))] Int
  (loop [(position Int) 0]
    (cond
      (>= position (count parameters)) -1
      (same-id? (core/parameter-type-id (nth parameters position))
        (nth value-types position))
      (recur (+ position 1))
      :else position)))

(defn header-parameter?
  [(parameters (Vec core/Parameter)) (value core/NativeId)] Bool
  (loop [(position Int) 0]
    (if (>= position (count parameters))
      false
      (if (same-id? (core/parameter-id (nth parameters position)) value)
        true
        (recur (+ position 1))))))

;; A back edge whose arguments are materialized as sequential copies into the
;; header parameters corrupts any argument that IS a header parameter, so the
;; recur arm routes every argument through a fresh value when one aliases.
(defn recur-aliases-header?
  [(parameters (Vec core/Parameter)) (values (Vec core/NativeId))] Bool
  (loop [(position Int) 0]
    (if (>= position (count values))
      false
      (if (header-parameter? parameters (nth values position))
        true
        (recur (+ position 1))))))

;; Coercion rule (ratified, North thread 019fbd6c): widen = free tag inject,
;; narrow = checked extract trapping to LowerFailure/union-variant-mismatch.
;; SliceValue is confined to one frozen program, never a cross-program ABI type.
(defn variant-for-payload
  [(variants (Vec core/TypeVariant))
   (payload core/NativeId)]
  (U core/TypeVariant Nil)
  (loop [(position Int) 0]
    (if (>= position (count variants))
      nil
      (let [(variant core/TypeVariant) (nth variants position)
            (declared (U core/NativeId Nil)) (core/typevariant-payload-type variant)]
          (if (nil? declared)
            (recur (+ position 1))
            (if (same-id? declared payload) variant (recur (+ position 1))))))))

(defn variant-for-record-reference
  [(types (Vec core/TypeDef))
   (variants (Vec core/TypeVariant))
   (record-type core/NativeId)]
  (U core/TypeVariant Nil)
  (loop [(position Int) 0]
    (if (>= position (count variants))
      nil
      (let [(variant core/TypeVariant) (nth variants position)
            (payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)
            (definition (U core/TypeDef Nil))
            (if (nil? payload) nil (lookup-type types payload))]
        (if (nil? definition)
          (recur (+ position 1))
          (let [(shape core/TypeShape) (core/typedef-shape definition)]
            (if (and (instance? native.core.ReferenceType shape)
                  (same-id? (core/referencetype-target-type shape) record-type))
              variant
              (recur (+ position 1)))))))))

(defn payloadless-variants
  [(variants (Vec core/TypeVariant))] (Vec core/TypeVariant)
  (loop [(position Int) 0 (collected (Vec core/TypeVariant)) []]
    (if (>= position (count variants))
      collected
      (let [(variant core/TypeVariant) (nth variants position)]
        (recur (+ position 1)
          (if (nil? (core/typevariant-payload-type variant))
            (conj collected variant)
            collected))))))

;; A recursive union must be refused, not looped over.
(defn widen-budget [] Int 4)

(defn variant-path-to-payload-with-budget
  [(types (Vec core/TypeDef))
   (current core/NativeId)
   (target core/NativeId)
   (budget Int)]
  VariantPathV0
  (cond
    (same-id? current target) (->VariantPathV0 1 [])
    (< budget 0) (->VariantPathV0 0 [])
    :else
    (let [(variants (Vec core/TypeVariant)) (union-variants-of types current)]
      (loop [(position Int) 0
             (matches Int) 0
             (chosen (Vec core/TypeVariant)) []]
        (if (>= position (count variants))
          (->VariantPathV0 matches chosen)
          (let [(variant core/TypeVariant) (nth variants position)
                (payload (U core/NativeId Nil))
                (core/typevariant-payload-type variant)
                (nested VariantPathV0)
                (if (nil? payload)
                  (->VariantPathV0 0 [])
                  (variant-path-to-payload-with-budget types payload target
                    (- budget 1)))
                (nested-matches Int) (variantpathv0-matches nested)]
            (recur (+ position 1) (+ matches nested-matches)
              (if (and (= 0 matches) (> nested-matches 0))
                (into [variant] (variantpathv0-variants nested))
                chosen))))))))

(defn variant-path-to-payload
  [(types (Vec core/TypeDef))
   (current core/NativeId)
   (target core/NativeId)]
  VariantPathV0
  (variant-path-to-payload-with-budget types current target (widen-budget)))

(defn extract-variant-path
  [(owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (label String)
   (path (Vec core/TypeVariant))]
  ExprResultV0
  (loop [(position Int) 0
         (current BodyStateV0) state
         (current-id core/NativeId) value-id
         (current-type core/NativeId) value-type]
    (if (>= position (count path))
      (->ExprResultV0 current current-id current-type false)
      (let [(variant core/TypeVariant) (nth path position)
            (payload (U core/NativeId Nil))
            (core/typevariant-payload-type variant)]
        (if (nil? payload)
          (fail-result current
            "TODO-NATIVE-VARIANT-PATH: checked path reached a unit variant")
          (let [(result-id core/NativeId)
                (state-id current owner (str label "-" position))]
            (recur (+ position 1)
              (state-emit (state-bump current)
                (core/->UnionExtractInstruction
                  (core/->SsaValueV0 result-id payload)
                  current-id (core/typevariant-id variant)))
              result-id payload)))))))

(defn lower-refined-lookup-result
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (source-id core/NativeId)
   (source-type core/NativeId)
   (keyword String)
   (lookup-type core/NativeId)
   (result-id core/NativeId)]
  ExprResultV0
  (let [(refinement (U KeywordFlowRefinementV0 Nil))
        (find-keyword-refinement state source-id source-type keyword lookup-type)]
    (if (nil? refinement)
      (->ExprResultV0 state result-id lookup-type false)
      (let [(refined-type core/NativeId)
            (keywordflowrefinementv0-result-type refinement)
            (path VariantPathV0)
            (variant-path-to-payload types lookup-type refined-type)]
        (if (not (= 1 (variantpathv0-matches path)))
          (->ExprResultV0 state result-id lookup-type false)
          (extract-variant-path owner state result-id lookup-type
            "lookup-refined" (variantpathv0-variants path)))))))

(defn arena-value-id [(owner core/NativeId)] core/NativeId
  (lower-id "arena-handle" [(id-value owner)]))

(defn atom-state-value-id [(owner core/NativeId)] core/NativeId
  (lower-id "atom-state-handle" [(id-value owner)]))

(defn nil-variant? [(variant core/TypeVariant)] Bool
  (let [(payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)]
    (if (nil? payload)
      (= "nil" (core/typevariant-name variant))
      (same-id? payload (type-id "Nil")))))

(defn lower-nil-union-value
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (target core/NativeId)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types target)
        (nil-variants (Vec core/TypeVariant))
        (loop [(position Int) 0 (collected (Vec core/TypeVariant)) []]
          (if (>= position (count variants))
            collected
            (recur (+ position 1)
              (if (nil-variant? (nth variants position))
                (conj collected (nth variants position))
                collected))))]
    (if (not (= 1 (count nil-variants)))
      (fail-result state
        "TODO-NATIVE-NIL-INJECTION: target union needs exactly one nil alternative")
      (let [(variant core/TypeVariant) (nth nil-variants 0)
            (payload-type (U core/NativeId Nil))
            (core/typevariant-payload-type variant)
            (result-id core/NativeId) (state-id state owner "nil-inject")]
        (if (nil? payload-type)
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionConstructInstruction
                (core/->SsaValueV0 result-id target)
                (core/typevariant-id variant) nil))
            result-id target false)
          (let [(payload-variants (Vec core/TypeVariant))
                (payloadless-variants (union-variants-of types payload-type))]
            (if (not (= 1 (count payload-variants)))
              (fail-result state
                "TODO-NATIVE-NIL-INJECTION: carried Nil needs one unit alternative")
              (let [(payload-id core/NativeId)
                    (state-id state owner "nil-payload")]
                (->ExprResultV0
                  (state-emit
                    (state-emit (state-bump (state-bump state))
                      (core/->UnionConstructInstruction
                        (core/->SsaValueV0 payload-id payload-type)
                        (core/typevariant-id (nth payload-variants 0)) nil))
                    (core/->UnionConstructInstruction
                      (core/->SsaValueV0 result-id target)
                      (core/typevariant-id variant) payload-id))
                  result-id target false)))))))))

;; A payloadless source absence may target either a direct nil arm or an arm
;; carrying the canonical Nil union.
(defn widen-unit-arm
  [(types (Vec core/TypeDef))
   (state BodyStateV0)
   (owner core/NativeId)
   (to core/NativeId)
   (join-id core/NativeId)]
  BodyStateV0
  (let [(injected ExprResultV0)
        (lower-nil-union-value types owner state to)
        (settled BodyStateV0) (exprresultv0-state injected)]
    (if (state-blocked? settled)
      settled
      (state-close settled
        (core/->JumpTerminator join-id
          [(exprresultv0-value-id injected)])))))

;; A nested target path is ordered outer-to-inner, so construction reverses it.
(defn inject-variant-path
  [(owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (target core/NativeId)
   (path (Vec core/TypeVariant))]
  ExprResultV0
  (loop [(position Int) (- (count path) 1)
         (current BodyStateV0) state
         (current-id core/NativeId) value-id]
    (if (< position 0)
      (->ExprResultV0 current current-id target false)
      (let [(variant core/TypeVariant) (nth path position)
            (wrapper-type (U core/NativeId Nil))
            (if (= 0 position)
              target
              (core/typevariant-payload-type (nth path (- position 1))))]
        (if (nil? wrapper-type)
          (fail-result current
            "TODO-NATIVE-WIDEN-TARGET-PATH: nested target path reached a unit variant")
          (let [(result-id core/NativeId)
                (state-id current owner (str "inject-nested-" position))]
            (recur (- position 1)
              (state-emit (state-bump current)
                (core/->UnionConstructInstruction
                  (core/->SsaValueV0 result-id wrapper-type)
                  (core/typevariant-id variant)
                  current-id))
              result-id)))))))

(defn lower-widen
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (from core/NativeId)
   (to core/NativeId)
   (budget Int)]
  ExprResultV0
  (cond
    (state-blocked? state) (dead-result state)

    (same-id? from to) (->ExprResultV0 state value-id to false)

    (< budget 0)
    (fail-result state
      "TODO-NATIVE-WIDEN-DEPTH: closed-union coercion nested past the v0 budget")

    :else
    (let [(target-variants (Vec core/TypeVariant)) (union-variants-of types to)
          (direct (U core/TypeVariant Nil))
          (variant-for-payload target-variants from)
          (boxed (U core/TypeVariant Nil))
          (variant-for-record-reference types target-variants from)
          (nested-target VariantPathV0)
          (variant-path-to-payload-with-budget types to from budget)
          (source-variants (Vec core/TypeVariant)) (union-variants-of types from)]
      (cond
        (= 0 (count target-variants))
        (fail-result state
          "TODO-NATIVE-WIDEN-TARGET: the declared type is not a closed union")

        (same-id? from (type-id "Nil"))
        (lower-nil-union-value types owner state to)

        (some? direct)
        (let [(result-id core/NativeId) (state-id state owner "inject")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionConstructInstruction
                (core/->SsaValueV0 result-id to)
                (core/typevariant-id direct)
                value-id))
            result-id to false))

        (some? boxed)
        (let [(reference-type (U core/NativeId Nil))
              (core/typevariant-payload-type boxed)]
          (if (nil? reference-type)
            (fail-result state
              "TODO-NATIVE-BOX-RECORD: reference-backed variant has no payload")
            (let [(reference-id core/NativeId) (state-id state owner "box-record")
                  (result-id core/NativeId)
                  (state-id (state-bump state) owner "inject-record")]
              (->ExprResultV0
                (state-emit
                  (state-emit (state-bump (state-bump state))
                    (core/->BoxRecordInstruction
                      (core/->SsaValueV0 reference-id reference-type)
                      value-id (arena-value-id owner)))
                  (core/->UnionConstructInstruction
                    (core/->SsaValueV0 result-id to)
                    (core/typevariant-id boxed)
                    reference-id))
                result-id to false))))

        (and (= 1 (variantpathv0-matches nested-target))
          (> (count (variantpathv0-variants nested-target)) 0))
        (inject-variant-path owner state value-id to
          (variantpathv0-variants nested-target))

        (= 0 (count source-variants))
        (fail-result state
          "TODO-NATIVE-WIDEN-SOURCE: no target alternative carries this type and the source is not a closed union")

        :else
        (let [(join-id core/NativeId) (state-id state owner "widen-join")
              (join-parameter core/NativeId) (state-id state owner "widen-value")
              (cases (Vec core/SwitchCaseV0))
              (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
                (if (>= position (count source-variants))
                  collected
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id (nth source-variants position))
                        (state-id state owner (str "widen-arm-" position))
                        [])))))
              (switched BodyStateV0)
              (state-close (state-bump state)
                (core/->SwitchTerminator value-id cases))
              (armed BodyStateV0)
              (loop [(position Int) 0 (current BodyStateV0) switched]
                (if (or (>= position (count source-variants))
                        (state-blocked? current))
                  current
                  (let [(variant core/TypeVariant) (nth source-variants position)
                        (arm-id core/NativeId)
                        (state-id state owner (str "widen-arm-" position))
                        (payload-type (U core/NativeId Nil))
                        (core/typevariant-payload-type variant)
                        (opened BodyStateV0) (state-open-block current arm-id [])]
                    (if (nil? payload-type)
                      (recur (+ position 1)
                        (widen-unit-arm types opened owner to join-id))
                      (let [(extract-id core/NativeId)
                            (state-id opened owner (str "widen-extract-" position))
                            (extracted BodyStateV0)
                            (state-emit (state-bump opened)
                              (core/->UnionExtractInstruction
                                (core/->SsaValueV0 extract-id payload-type)
                                value-id
                                (core/typevariant-id variant)))
                            (widened ExprResultV0)
                            (lower-widen types owner extracted extract-id
                              payload-type to (- budget 1))]
                        (if (state-blocked? (exprresultv0-state widened))
                          (exprresultv0-state widened)
                          (recur (+ position 1)
                            (state-close (exprresultv0-state widened)
                              (core/->JumpTerminator join-id
                                [(exprresultv0-value-id widened)])))))))))]
          (if (state-blocked? armed)
            (dead-result armed)
            (->ExprResultV0
              (state-open-block armed join-id
                [(core/->Parameter join-parameter to)])
              join-parameter to false)))))))

;; A narrowed reference borrows from the union value it came out of; it must not
;; outlive that value's region. Vacuous while every payload is program-confined.
(defrecord NarrowHitV0
  [(found Bool) (variant-id core/NativeId) (reference-type core/NativeId)])

(defn narrow-miss [] NarrowHitV0
  (->NarrowHitV0 false (type-id "LowerFailure") (type-id "LowerFailure")))

(defn reference-variant-for
  [(types (Vec core/TypeDef))
   (union-id core/NativeId)
   (target core/NativeId)]
  NarrowHitV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types union-id)]
    (loop [(position Int) 0]
      (if (>= position (count variants))
        (narrow-miss)
        (let [(variant core/TypeVariant) (nth variants position)
              (payload (U core/NativeId Nil))
              (core/typevariant-payload-type variant)]
          (if (nil? payload)
            (recur (+ position 1))
            (let [(definition (U core/TypeDef Nil)) (lookup-type types payload)]
              (if (nil? definition)
                (recur (+ position 1))
                (let [(shape core/TypeShape) (core/typedef-shape definition)]
                  (if (and (instance? native.core.ReferenceType shape)
                        (same-id? (core/referencetype-target-type shape) target))
                    (->NarrowHitV0 true (core/typevariant-id variant) payload)
                    (recur (+ position 1))))))))))))

(defn reference-targets?
  [(types (Vec core/TypeDef))
   (reference core/NativeId)
   (target core/NativeId)]
  Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types reference)]
    (if (nil? definition)
      false
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (and (instance? native.core.ReferenceType shape)
          (same-id? (core/referencetype-target-type shape) target))))))

(defn semantic-reference-target
  [(types (Vec core/TypeDef)) (target core/NativeId)] (U core/NativeId Nil)
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      nil
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.ReferenceType shape)
          (core/referencetype-target-type shape)
          nil)))))

(defn append-unique-id
  [(values (Vec core/NativeId)) (value core/NativeId)] (Vec core/NativeId)
  (if (core/id-in? values value) values (conj values value)))

;; Flow facts name semantic source types. Record alternatives are represented
;; by references in unions, but a proved record is materialized for source use.
(defn possible-value-types-with-budget
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (budget Int)]
  (Vec core/NativeId)
  (cond
    (same-id? target (type-id "Nil")) [(type-id "Nil")]
    (< budget 0) []
    :else
    (let [(reference-target (U core/NativeId Nil))
          (semantic-reference-target types target)
          (variants (Vec core/TypeVariant)) (union-variants-of types target)]
      (cond
        (some? reference-target) [reference-target]
        (= 0 (count variants)) [target]
        :else
        (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
          (if (>= position (count variants))
            collected
            (let [(variant core/TypeVariant) (nth variants position)
                  (payload (U core/NativeId Nil))
                  (core/typevariant-payload-type variant)]
              (cond
                (or (= "nil" (core/typevariant-name variant))
                  (and (some? payload)
                    (same-id? payload (type-id "Nil"))))
                (recur (+ position 1)
                  (append-unique-id collected (type-id "Nil")))

                (nil? payload)
                (recur (+ position 1) collected)

                :else
                (let [(nested (Vec core/NativeId))
                      (possible-value-types-with-budget types payload
                        (- budget 1))]
                  (recur (+ position 1)
                    (loop [(nested-position Int) 0
                           (current (Vec core/NativeId)) collected]
                      (if (>= nested-position (count nested))
                        current
                        (recur (+ nested-position 1)
                          (append-unique-id current
                            (nth nested nested-position)))))))))))))))

(defn possible-value-types
  [(types (Vec core/TypeDef)) (target core/NativeId)] (Vec core/NativeId)
  (possible-value-types-with-budget types target (widen-budget)))

(defn boundary-record-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (some? definition)
      (instance? native.core.RecordType (core/typedef-shape definition)))))

(defn variant-path-to-record-reference-with-budget
  [(types (Vec core/TypeDef))
   (current core/NativeId)
   (target core/NativeId)
   (budget Int)]
  VariantPathV0
  (cond
    (reference-targets? types current target) (->VariantPathV0 1 [])
    (< budget 0) (->VariantPathV0 0 [])
    :else
    (let [(variants (Vec core/TypeVariant)) (union-variants-of types current)]
      (loop [(position Int) 0
             (matches Int) 0
             (chosen (Vec core/TypeVariant)) []]
        (if (>= position (count variants))
          (->VariantPathV0 matches chosen)
          (let [(variant core/TypeVariant) (nth variants position)
                (payload (U core/NativeId Nil))
                (core/typevariant-payload-type variant)
                (nested VariantPathV0)
                (if (nil? payload)
                  (->VariantPathV0 0 [])
                  (variant-path-to-record-reference-with-budget types payload
                    target (- budget 1)))
                (nested-matches Int) (variantpathv0-matches nested)]
            (recur (+ position 1) (+ matches nested-matches)
              (if (and (= 0 matches) (> nested-matches 0))
                (into [variant] (variantpathv0-variants nested))
                chosen))))))))

(defn variant-path-to-record-reference
  [(types (Vec core/TypeDef))
   (current core/NativeId)
   (target core/NativeId)]
  VariantPathV0
  (variant-path-to-record-reference-with-budget types current target
    (widen-budget)))

(defn materialize-boundary-record
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (reference-id core/NativeId)
   (reference-type core/NativeId)
   (record-type core/NativeId)]
  ExprResultV0
  (if (not (reference-targets? types reference-type record-type))
    (fail-result state
      "TODO-NATIVE-BOUNDARY-RECORD: narrowed value is not the record reference")
    (let [(result-id core/NativeId) (state-id state owner "boundary-record")]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->RecordMaterializeInstructionV0
            (core/->SsaValueV0 result-id record-type)
            reference-id))
        result-id record-type false))))

(declare failure-code)

;; A source alternative the target cannot spell carries nothing across, so the
;; arm traps on the LowerFailure ordinal rather than reinterpreting its bytes.
(defn narrow-mismatch-arm
  [(owner core/NativeId) (state BodyStateV0) (position Int)] BodyStateV0
  (let [(code-id core/NativeId)
        (state-id state owner (str "narrow-trap-" position))]
    (state-close
      (state-emit (state-bump state)
        (core/->AtomInstruction
          (core/->SsaValueV0 code-id (int-type-id))
          (core/->I64Atom (failure-code "union-variant-mismatch"))))
      (core/->TrapTerminator code-id))))

(defrecord NarrowArmsV0 [(state BodyStateV0) (crossed Int)])

;; A refused widen IS the "alternative not in the target" test, so the arm loop
;; drops the attempt and traps from the untouched state; `fallback` keeps the
;; widen refusal when nothing crosses at all.
(defn lower-union-narrow
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (from core/NativeId)
   (to core/NativeId)
   (fallback ExprResultV0)]
  ExprResultV0
  (let [(source-variants (Vec core/TypeVariant)) (union-variants-of types from)
        (join-id core/NativeId) (state-id state owner "narrow-join")
        (join-parameter core/NativeId) (state-id state owner "narrow-value")
        (cases (Vec core/SwitchCaseV0))
        (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
          (if (>= position (count source-variants))
            collected
            (recur (+ position 1)
              (conj collected
                (core/->SwitchCaseV0
                  (core/typevariant-id (nth source-variants position))
                  (state-id state owner (str "narrow-arm-" position))
                  [])))))
        (switched BodyStateV0)
        (state-close (state-bump state)
          (core/->SwitchTerminator value-id cases))
        (narrowed NarrowArmsV0)
        (loop [(position Int) 0
               (current BodyStateV0) switched
               (crossed Int) 0]
          (if (or (>= position (count source-variants))
                  (state-blocked? current))
            (->NarrowArmsV0 current crossed)
            (let [(variant core/TypeVariant) (nth source-variants position)
                  (arm-id core/NativeId)
                  (state-id state owner (str "narrow-arm-" position))
                  (payload-type (U core/NativeId Nil))
                  (core/typevariant-payload-type variant)
                  (opened BodyStateV0) (state-open-block current arm-id [])
                  (carried BodyStateV0)
                  (if (nil? payload-type)
                    (widen-unit-arm types opened owner to join-id)
                    (let [(extract-id core/NativeId)
                          (state-id opened owner
                            (str "narrow-extract-" position))
                          (extracted BodyStateV0)
                          (state-emit (state-bump opened)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 extract-id payload-type)
                              value-id (core/typevariant-id variant)))
                          (widened ExprResultV0)
                          (lower-widen types owner extracted extract-id
                            payload-type to (widen-budget))]
                      (if (state-blocked? (exprresultv0-state widened))
                        (exprresultv0-state widened)
                        (state-close (exprresultv0-state widened)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id widened)])))))]
              (if (state-blocked? carried)
                (recur (+ position 1)
                  (narrow-mismatch-arm owner opened position) crossed)
                (recur (+ position 1) carried (+ crossed 1))))))
        (armed BodyStateV0) (narrowarmsv0-state narrowed)]
    (cond
      (state-blocked? armed) (dead-result armed)
      (= 0 (narrowarmsv0-crossed narrowed)) fallback
      :else
      (->ExprResultV0
        (state-open-block armed join-id
          [(core/->Parameter join-parameter to)])
        join-parameter to false))))

;; Source annotations and calls are semantic boundaries: widen into their
;; declared union, or checked-extract the named alternative. A reference-backed
;; record alternative is materialized before crossing a direct-record boundary.
(defn lower-boundary-coerce
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (from core/NativeId)
   (to core/NativeId)]
  ExprResultV0
  (if (same-id? from to)
    (->ExprResultV0 state value-id to false)
    (if (and (integer-type-id? from) (integer-type-id? to))
      (let [(result-id core/NativeId) (state-id state owner "integer-coerce")]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->CopyInstruction
              (core/->SsaValueV0 result-id to) value-id))
          result-id to false))
      (let [(source-variants (Vec core/TypeVariant)) (union-variants-of types from)
          (scalar (U core/TypeVariant Nil)) (variant-for-payload source-variants to)
          (record NarrowHitV0) (reference-variant-for types from to)
          (nested VariantPathV0) (variant-path-to-payload types from to)
          (nested-record VariantPathV0)
          (if (boundary-record-type? types to)
            (variant-path-to-record-reference types from to)
            (->VariantPathV0 0 []))]
      (cond
        (some? scalar)
        (let [(result-id core/NativeId) (state-id state owner "boundary-extract")]
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->UnionExtractInstruction
                (core/->SsaValueV0 result-id to)
                value-id (core/typevariant-id scalar)))
            result-id to false))

        (narrowhitv0-found record)
        (let [(reference-id core/NativeId)
              (state-id state owner "boundary-reference")
              (extracted BodyStateV0)
              (state-emit (state-bump state)
                (core/->UnionExtractInstruction
                  (core/->SsaValueV0 reference-id
                    (narrowhitv0-reference-type record))
                  value-id (narrowhitv0-variant-id record)))]
          (materialize-boundary-record types owner extracted reference-id
            (narrowhitv0-reference-type record) to))

        (= 1 (variantpathv0-matches nested-record))
        (let [(reference ExprResultV0)
              (extract-variant-path owner state value-id from
                "boundary-record-nested"
                (variantpathv0-variants nested-record))]
          (if (state-blocked? (exprresultv0-state reference))
            reference
            (materialize-boundary-record types owner
              (exprresultv0-state reference)
              (exprresultv0-value-id reference)
              (exprresultv0-type-id reference) to)))

        (= 1 (variantpathv0-matches nested))
        (extract-variant-path owner state value-id from "boundary-nested"
          (variantpathv0-variants nested))
        :else
        ;; Widening runs first, so every program that already lowers keeps its
        ;; program; only a refused widen is reconsidered as a narrowing.
        (let [(widened ExprResultV0)
              (lower-widen types owner state value-id from to (widen-budget))]
          (if (or (not (state-blocked? (exprresultv0-state widened)))
                  (= 0 (count source-variants))
                  (= 0 (count (union-variants-of types to))))
            widened
            (lower-union-narrow types owner state value-id from to
              widened))))))))

(defn coerce-arguments
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))
   (parameters (Vec core/Parameter))]
  ArgsResultV0
  (loop [(position Int) 0
         (current BodyStateV0) state
         (coerced-values (Vec core/NativeId)) []
         (coerced-types (Vec core/NativeId)) []]
    (if (or (>= position (count values)) (state-blocked? current))
      (->ArgsResultV0 current coerced-values coerced-types false)
      (let [(coerced ExprResultV0)
            (lower-boundary-coerce types owner current
              (nth values position)
              (nth value-types position)
              (core/parameter-type-id (nth parameters position)))]
        (recur (+ position 1)
          (exprresultv0-state coerced)
          (conj coerced-values (exprresultv0-value-id coerced))
          (conj coerced-types (exprresultv0-type-id coerced)))))))

(defn coerce-values-to-type
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))
   (target core/NativeId)]
  ArgsResultV0
  (loop [(position Int) 0
         (current BodyStateV0) state
         (coerced-values (Vec core/NativeId)) []
         (coerced-types (Vec core/NativeId)) []]
    (if (or (>= position (count values)) (state-blocked? current))
      (->ArgsResultV0 current coerced-values coerced-types false)
      (let [(coerced ExprResultV0)
            (lower-boundary-coerce types owner current
              (nth values position) (nth value-types position) target)]
        (recur (+ position 1)
          (exprresultv0-state coerced)
          (conj coerced-values (exprresultv0-value-id coerced))
          (conj coerced-types (exprresultv0-type-id coerced)))))))

(defn build-vector-literal
  [(owner core/NativeId)
   (state BodyStateV0)
   (vector-type core/NativeId)
   (values (Vec core/NativeId))]
  ExprResultV0
  (let [(capacity-id core/NativeId) (state-id state owner "vec-cap")
        (empty-id core/NativeId)
        (state-id (state-bump state) owner "vec-lit")
        (seeded BodyStateV0)
        (state-emit
          (state-emit (state-bump (state-bump state))
            (core/->AtomInstruction
              (core/->SsaValueV0 capacity-id (int-type-id))
              (core/->I64Atom (count values))))
          (core/->VecEmptyInstruction
            (core/->SsaValueV0 empty-id vector-type)
            capacity-id (arena-value-id owner)))]
    (loop [(position Int) 0
           (built BodyStateV0) seeded
           (holder core/NativeId) empty-id]
      (if (>= position (count values))
        (->ExprResultV0 built holder vector-type false)
        (let [(push-id core/NativeId)
              (state-id built owner "vec-lit-push")]
          (recur (+ position 1)
            (state-emit (state-bump built)
              (core/->VecPushInstruction
                (core/->SsaValueV0 push-id vector-type)
                holder (nth values position)
                (arena-value-id owner)))
            push-id))))))

(defn vector-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.VectorType (core/typedef-shape definition)))))

(defn buffer-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.BufferTypeV0 (core/typedef-shape definition)))))

(defn record-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.RecordType (core/typedef-shape definition)))))

(defn source-ref-type
  [(env BodyEnvV0)
   (state BodyStateV0)
   (expr core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (not (= "ref" (fact-text index expr "form-kind")))
      nil
      (let [(name String) (fact-text index expr "name")
            (direct (U LocalBindingV0 Nil))
            (find-local (bodystatev0-locals state) name)
            (canonical String)
            (resolved-source-key
              (resolve-source-name index (source-module-name index expr) name))
            (binding (U LocalBindingV0 Nil))
            (if (some? direct)
              direct
              (find-local (bodystatev0-locals state) canonical))]
        (if (nil? binding) nil (localbindingv0-type-id binding))))))

(defn source-ref-record?
  [(env BodyEnvV0) (state BodyStateV0) (expr core/NativeId)] Bool
  (let [(source-type (U core/NativeId Nil))
        (source-ref-type env state expr)]
    (and (not (nil? source-type))
      (record-type? (bodyenvv0-types env) source-type))))

(defn vector-element-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] core/NativeId
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.VectorType shape)
          (core/vectortype-element-type shape)
          (type-id "LowerFailure"))))))

(defn buffer-element-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] core/NativeId
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.BufferTypeV0 shape)
          (core/buffertypev0-element-type shape)
          (type-id "LowerFailure"))))))

(defn map-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.MapTypeV0 (core/typedef-shape definition)))))

(defn insertion-order-map-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      false
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (not (instance? native.core.MapTypeV0 shape))
          false
          (let [(order core/CollectionOrderV0)
                (core/maptypev0-iteration-order shape)]
            (and (instance? native.core.InsertionOrderV0 order)
              (core/insertionorderv0-token order))))))))

(defn map-key-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] core/NativeId
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.MapTypeV0 shape)
          (core/maptypev0-key-type shape)
          (type-id "LowerFailure"))))))

(defn map-value-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] core/NativeId
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.MapTypeV0 shape)
          (core/maptypev0-value-type shape)
          (type-id "LowerFailure"))))))

(defn set-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (not (nil? definition))
      (instance? native.core.SetTypeV0 (core/typedef-shape definition)))))

(defn insertion-order-set-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      false
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (not (instance? native.core.SetTypeV0 shape))
          false
          (let [(order core/CollectionOrderV0)
                (core/settypev0-iteration-order shape)]
            (and (instance? native.core.InsertionOrderV0 order)
              (core/insertionorderv0-token order))))))))

(defn set-element-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] core/NativeId
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (type-id "LowerFailure")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.SetTypeV0 shape)
          (core/settypev0-element-type shape)
          (type-id "LowerFailure"))))))

(defn value-semantics-atom-kind? [(kind core/AtomKind)] Bool
  (or (instance? native.core.BoolKind kind)
    (or (instance? native.core.I64Kind kind)
      (or (instance? native.core.F64Kind kind)
        (or (instance? native.core.TextKind kind)
          (or (instance? native.core.BytesKind kind)
            (instance? native.core.KeywordKind kind)))))))

(defrecord ValueSemanticsStatusV0 [(admitted Bool) (reason String)])

(defn value-semantics-pass [] ValueSemanticsStatusV0
  (->ValueSemanticsStatusV0 true ""))

(defn value-semantics-dynamic [] ValueSemanticsStatusV0
  (->ValueSemanticsStatusV0 true "dynamic"))

(defn value-semantics-refuse [(reason String)] ValueSemanticsStatusV0
  (->ValueSemanticsStatusV0 false reason))

(defn merge-value-semantics-status
  [(left ValueSemanticsStatusV0)
   (right ValueSemanticsStatusV0)]
  ValueSemanticsStatusV0
  (cond
    (and (valuesemanticsstatusv0-admitted left)
      (valuesemanticsstatusv0-admitted right))
    (if (or (= "dynamic" (valuesemanticsstatusv0-reason left))
          (= "dynamic" (valuesemanticsstatusv0-reason right)))
      (value-semantics-dynamic)
      (value-semantics-pass))
    (or (= "buffer" (valuesemanticsstatusv0-reason left))
      (= "buffer" (valuesemanticsstatusv0-reason right)))
    (value-semantics-refuse "buffer")
    :else (value-semantics-refuse "unsupported")))

;; Structural operations are admitted only when the complete descriptor graph
;; has faithful value semantics. A semantic record reference may close a type
;; cycle through Any; revisiting that already-checked edge is safe and prevents
;; compiler recursion. Opaque self-references, cells, maps, sets, functions and
;; mutable Buffer identities are not value leaves. Raw Any's SliceValue is the
;; dynamic boundary: its active tag selects the descriptor walked at runtime,
;; so unrelated record alternatives do not invalidate every Any operation.
(defn value-semantics-type-inner
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (visiting (Vec core/NativeId))]
  ValueSemanticsStatusV0
  (if (same-id? target (type-id "SliceValue"))
    (value-semantics-dynamic)
    (if (core/id-in? visiting target)
      (value-semantics-pass)
    (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
      (if (nil? definition)
        (value-semantics-refuse "unsupported")
        (let [(shape core/TypeShape) (core/typedef-shape definition)
              (next (Vec core/NativeId)) (conj visiting target)]
          (cond
            (instance? native.core.AtomType shape)
            (if (value-semantics-atom-kind? (core/atomtype-kind shape))
              (value-semantics-pass)
              (value-semantics-refuse "unsupported"))

            (instance? native.core.BufferTypeV0 shape)
            (value-semantics-refuse "buffer")

            (instance? native.core.RecordType shape)
            (let [(fields (Vec core/TypeField)) (core/recordtype-fields shape)]
              (loop [(index Int) 0
                     (status ValueSemanticsStatusV0) (value-semantics-pass)]
                (if (>= index (count fields))
                  status
                  (recur (+ index 1)
                    (merge-value-semantics-status status
                      (value-semantics-type-inner types
                        (core/typefield-type-id (nth fields index))
                        next))))))

            (instance? native.core.UnionType shape)
            (let [(variants (Vec core/TypeVariant))
                  (core/uniontype-variants shape)]
              (loop [(index Int) 0
                     (status ValueSemanticsStatusV0) (value-semantics-pass)]
                (if (>= index (count variants))
                  status
                  (let [(payload (U core/NativeId Nil))
                        (core/typevariant-payload-type (nth variants index))]
                    (recur (+ index 1)
                      (merge-value-semantics-status status
                        (if (nil? payload)
                          (value-semantics-pass)
                          (value-semantics-type-inner types payload
                            next))))))))

            (instance? native.core.VectorType shape)
            (value-semantics-type-inner types
              (core/vectortype-element-type shape) next)

            (instance? native.core.ReferenceType shape)
            (let [(pointee core/NativeId)
                  (core/referencetype-target-type shape)
                  (pointee-definition (U core/TypeDef Nil))
                  (lookup-type types pointee)]
              (if (and (not (nil? pointee-definition))
                    (instance? native.core.RecordType
                      (core/typedef-shape pointee-definition)))
                (value-semantics-type-inner types pointee next)
                (value-semantics-refuse "unsupported")))

            :else (value-semantics-refuse "unsupported"))))))))

(defn value-semantics-status
  [(types (Vec core/TypeDef)) (target core/NativeId)] ValueSemanticsStatusV0
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      (value-semantics-refuse "unsupported")
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if
          (or (instance? native.core.RecordType shape)
            (or (instance? native.core.UnionType shape)
              (instance? native.core.VectorType shape)))
          (value-semantics-type-inner types target [])
          (if (instance? native.core.BufferTypeV0 shape)
            (value-semantics-refuse "buffer")
            (value-semantics-refuse "unsupported")))))))

(defn value-semantics-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (valuesemanticsstatusv0-admitted (value-semantics-status types target)))

(defn value-semantics-dynamic?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (= "dynamic"
    (valuesemanticsstatusv0-reason (value-semantics-status types target))))

(defn value-equal-operation
  [(domain-type core/NativeId)
   (left-id core/NativeId)
   (right-id core/NativeId)
   (dynamic Bool)]
  core/ValueSemanticsOpV0
  (if dynamic
    (core/->DynamicValueEqualV0 domain-type left-id right-id)
    (core/->ValueEqualV0 domain-type left-id right-id)))

(defn value-hash-operation
  [(domain-type core/NativeId)
   (value-id core/NativeId)
   (dynamic Bool)]
  core/ValueSemanticsOpV0
  (if dynamic
    (core/->DynamicValueHashV0 domain-type value-id)
    (core/->ValueHashV0 domain-type value-id)))

(defn value-compare-operation
  [(domain-type core/NativeId)
   (left-id core/NativeId)
   (right-id core/NativeId)
   (dynamic Bool)]
  core/ValueSemanticsOpV0
  (if dynamic
    (core/->DynamicValueCompareV0 domain-type left-id right-id)
    (core/->ValueCompareV0 domain-type left-id right-id)))

(defn value-semantics-refusal-reason
  [(types (Vec core/TypeDef)) (target core/NativeId)] String
  (valuesemanticsstatusv0-reason (value-semantics-status types target)))

(defn nil-value-variant?
  [(definition core/TypeDef) (variant core/TypeVariant)] Bool
  (and (nil? (core/typevariant-payload-type variant))
    (or (= "nil" (core/typevariant-name variant))
      (and (= "Unit" (core/typedef-name definition))
        (= "unit" (core/typevariant-name variant))))))

(defn value-to-text-type-inner?
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (visiting (Vec core/NativeId))]
  Bool
  (if (core/id-in? visiting target)
    false
    (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [(shape core/TypeShape) (core/typedef-shape definition)
              (next (Vec core/NativeId)) (conj visiting target)]
          (cond
            (instance? native.core.AtomType shape)
            (let [(kind core/AtomKind) (core/atomtype-kind shape)]
              (or (instance? native.core.BoolKind kind)
                (instance? native.core.I64Kind kind)
                (instance? native.core.F64Kind kind)
                (instance? native.core.TextKind kind)
                (instance? native.core.KeywordKind kind)))

            (instance? native.core.VectorType shape)
            (value-to-text-type-inner? types
              (core/vectortype-element-type shape) next)

            (instance? native.core.MapTypeV0 shape)
            (and
              (instance? native.core.InsertionOrderV0
                (core/maptypev0-iteration-order shape))
              (value-to-text-type-inner? types
                (core/maptypev0-key-type shape) next)
              (value-to-text-type-inner? types
                (core/maptypev0-value-type shape) next))

            (instance? native.core.UnionType shape)
            (let [(variants (Vec core/TypeVariant))
                  (core/uniontype-variants shape)]
              (and (> (count variants) 0)
                (every?
                  (fn [(variant core/TypeVariant)] Bool
                    (let [(payload (U core/NativeId Nil))
                          (core/typevariant-payload-type variant)]
                      (if (nil? payload)
                        (nil-value-variant? definition variant)
                        (value-to-text-type-inner? types payload next))))
                  variants)))

            :else false))))))

(defn value-to-text-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (value-to-text-type-inner? types target []))

;; Sort order is derived only from a sealed, acyclic descriptor graph. Maps,
;; sets, cells, callables, and outcomes have no implicit collection order.
(defn comparable-type-inner?
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (visiting (Vec core/NativeId))]
  Bool
  (if (core/id-in? visiting target)
    false
    (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [(shape core/TypeShape) (core/typedef-shape definition)
              (next (Vec core/NativeId)) (conj visiting target)]
          (cond
            (instance? native.core.AtomType shape)
            (let [(kind core/AtomKind) (core/atomtype-kind shape)]
              (or (instance? native.core.BoolKind kind)
                (instance? native.core.I64Kind kind)
                (instance? native.core.F64Kind kind)
                (instance? native.core.TextKind kind)
                (instance? native.core.BytesKind kind)
                (instance? native.core.KeywordKind kind)))

            (instance? native.core.RecordType shape)
            (every?
              (fn [(field core/TypeField)] Bool
                (comparable-type-inner? types
                  (core/typefield-type-id field) next))
              (core/recordtype-fields shape))

            (instance? native.core.UnionType shape)
            (every?
              (fn [(variant core/TypeVariant)] Bool
                (let [(payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (nil? payload)
                    true
                    (comparable-type-inner? types payload next))))
              (core/uniontype-variants shape))

            (instance? native.core.VectorType shape)
            (comparable-type-inner? types
              (core/vectortype-element-type shape) next)

            (instance? native.core.ReferenceType shape)
            (comparable-type-inner? types
              (core/referencetype-target-type shape) next)

            :else false))))))

(defn comparable-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (comparable-type-inner? types target []))

;; The domain native_value_promote's descriptor walk can copy: scalars, text,
;; bytes, keywords, and any acyclic composition of them through records,
;; unions, outcomes, vectors and references. Maps, sets, atom cells, callables
;; and recursive types are refused HERE, where the compiler still has the type
;; to name in a diagnostic — the runtime walk has no map case and no depth
;; bound, and a trap is not a diagnostic.
(defn promote-domain-type-inner?
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (visiting (Vec core/NativeId))]
  Bool
  (if (core/id-in? visiting target)
    false
    (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
      (if (nil? definition)
        false
        (let [(shape core/TypeShape) (core/typedef-shape definition)
              (next (Vec core/NativeId)) (conj visiting target)]
          (cond
            (instance? native.core.AtomType shape)
            (let [(kind core/AtomKind) (core/atomtype-kind shape)]
              (or (instance? native.core.BoolKind kind)
                (instance? native.core.I64Kind kind)
                (instance? native.core.F64Kind kind)
                (instance? native.core.TextKind kind)
                (instance? native.core.BytesKind kind)
                (instance? native.core.KeywordKind kind)))

            (instance? native.core.RecordType shape)
            (every?
              (fn [(field core/TypeField)] Bool
                (promote-domain-type-inner? types
                  (core/typefield-type-id field) next))
              (core/recordtype-fields shape))

            (instance? native.core.UnionType shape)
            (every?
              (fn [(variant core/TypeVariant)] Bool
                (let [(payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (nil? payload)
                    true
                    (promote-domain-type-inner? types payload next))))
              (core/uniontype-variants shape))

            (instance? native.core.OutcomeType shape)
            (and
              (promote-domain-type-inner? types
                (core/outcometype-value-type shape) next)
              (promote-domain-type-inner? types
                (core/outcometype-failure-type shape) next))

            (instance? native.core.VectorType shape)
            (promote-domain-type-inner? types
              (core/vectortype-element-type shape) next)

            (instance? native.core.ReferenceType shape)
            (promote-domain-type-inner? types
              (core/referencetype-target-type shape) next)

            :else false))))))

(defn promote-domain-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (promote-domain-type-inner? types target []))

;; The vector TypeDef for an element type exists when some annotation named
;; (Vec T) or a scalar-literal vector pre-minted it (literal-vector-type-
;; definitions); body lowering cannot mint one, so it looks one up.
(defn vector-type-of
  [(types (Vec core/TypeDef)) (element core/NativeId)] (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.VectorType shape)
              (= "Vector" (core/typedef-name definition))
              (same-id? (core/vectortype-element-type shape) element))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn buffer-type-of
  [(types (Vec core/TypeDef)) (element core/NativeId)] (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.BufferTypeV0 shape)
              (same-id? (core/buffertypev0-element-type shape) element))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn text-vector-type-of [(types (Vec core/TypeDef))] (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.VectorType shape)
              (= "Vector" (core/typedef-name definition))
              (same-id? (core/vectortype-element-type shape)
                (type-id "String")))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn map-value? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (some? definition)
      (= "MapEntries" (core/typedef-name definition)))))

(defn text-builtin-allocates? [(operation core/TextBuiltinOpV0)] Bool
  (not (or (instance? native.core.TextCompareV0 operation)
           (instance? native.core.TextEndsWithV0 operation)
           (instance? native.core.TextRegexMatchesV0 operation))))

(defn map-type-of
  [(types (Vec core/TypeDef))
   (key-type core/NativeId)
   (value-type core/NativeId)]
  (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.MapTypeV0 shape)
              (same-id? (core/maptypev0-key-type shape) key-type)
              (same-id? (core/maptypev0-value-type shape) value-type))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn set-type-of
  [(types (Vec core/TypeDef))
   (element-type core/NativeId)]
  (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.SetTypeV0 shape)
              (same-id? (core/settypev0-element-type shape) element-type))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn concrete-equality-for
  [(target core/NativeId)] (U core/ConcreteEqualityV0 Nil)
  (cond
    (same-id? target (type-id "Bool")) (core/->BoolEqualityV0 true)
    (same-id? target (type-id "Int")) (core/->I64EqualityV0 true)
    (same-id? target (type-id "Float")) (core/->F64EqualityV0 true)
    (same-id? target (type-id "String")) (core/->TextEqualityV0 true)
    (same-id? target (type-id "Keyword")) (core/->KeywordEqualityV0 true)
    :else nil))

(defn map-key-equality-for
  [(types (Vec core/TypeDef))
   (target core/NativeId)]
  (U core/ConcreteEqualityV0 Nil)
  (let [(scalar (U core/ConcreteEqualityV0 Nil))
        (concrete-equality-for target)]
    (if (some? scalar)
      scalar
      (let [(status ValueSemanticsStatusV0)
            (value-semantics-status types target)]
        (if (valuesemanticsstatusv0-admitted status)
          (if (= "dynamic" (valuesemanticsstatusv0-reason status))
            (core/->DynamicStructuralEqualityV0 target)
            (core/->StructuralEqualityV0 target))
          nil)))))

(defn set-element-equality-for
  [(types (Vec core/TypeDef))
   (target core/NativeId)]
  (U core/ConcreteEqualityV0 Nil)
  (map-key-equality-for types target))

(defn atom-cell-content-of
  [(types (Vec core/TypeDef)) (target core/NativeId)] (U core/NativeId Nil)
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      nil
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.AtomCellTypeV0 shape)
          (core/atomcelltypev0-content-type shape)
          nil)))))

(defn atom-cell-type-of
  [(types (Vec core/TypeDef)) (content core/NativeId)] (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (and (instance? native.core.AtomCellTypeV0 shape)
              (same-id? (core/atomcelltypev0-content-type shape) content))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn instruction-defines-empty-collection?
  [(instruction core/Instruction)
   (source-id core/NativeId)
   (collection-kind String)]
  Bool
  (and (same-id? source-id (core/instruction-result-id instruction))
    (if (= "map" collection-kind)
      (and (instance? native.core.MapLiteralInstructionV0 instruction)
        (= 0 (count
          (core/mapliteralinstructionv0-key-ids instruction)))
        (= 0 (count
          (core/mapliteralinstructionv0-value-ids instruction))))
      (and (= "set" collection-kind)
        (instance? native.core.SetLiteralInstructionV0 instruction)
        (= 0 (count
          (core/setliteralinstructionv0-value-ids instruction)))))))

(defn instructions-define-empty-collection?
  [(instructions (Vec core/Instruction))
   (source-id core/NativeId)
   (collection-kind String)]
  Bool
  (loop [(position Int) 0]
    (if (>= position (count instructions))
      false
      (if (instruction-defines-empty-collection?
            (nth instructions position) source-id collection-kind)
        true
        (recur (+ position 1))))))

(defn state-defines-empty-collection?
  [(state BodyStateV0) (source-id core/NativeId) (collection-kind String)] Bool
  (if (instructions-define-empty-collection?
        (bodystatev0-instructions state) source-id collection-kind)
    true
    (let [(blocks (Vec core/BasicBlock)) (bodystatev0-blocks state)]
      (loop [(position Int) 0]
        (if (>= position (count blocks))
          false
          (if (instructions-define-empty-collection?
                (core/basicblock-instructions (nth blocks position))
                source-id collection-kind)
            true
            (recur (+ position 1))))))))

(defn allocating-instruction? [(instruction core/Instruction)] Bool
  (or (instance? native.core.VecAssocInstructionV0 instruction)
      (instance? native.core.BufferAllocateInstructionV0 instruction)
      (instance? native.core.VecPushInstruction instruction)
      (instance? native.core.VecEmptyInstruction instruction)
      (instance? native.core.VecConcatInstruction instruction)
      (instance? native.core.VecSliceInstructionV0 instruction)
      (instance? native.core.ByteSourceSliceInstructionV0 instruction)
      (instance? native.core.VecReverseInstructionV0 instruction)
      (instance? native.core.VecSortInstructionV0 instruction)
      (instance? native.core.MapLiteralInstructionV0 instruction)
      (instance? native.core.SetLiteralInstructionV0 instruction)
      (instance? native.core.MapAssocInstructionV0 instruction)
      (instance? native.core.MapDissocInstructionV0 instruction)
      (instance? native.core.MapKeysInstructionV0 instruction)
      (instance? native.core.MapValuesInstructionV0 instruction)
      (instance? native.core.SetConjInstructionV0 instruction)
      (instance? native.core.SetDisjInstructionV0 instruction)
      (instance? native.core.SetVectorInstructionV0 instruction)
      (instance? native.core.CollectionTransientOpenInstructionV0 instruction)
      (instance? native.core.CollectionPersistentCloseInstructionV0 instruction)
      (instance? native.core.TransientVecPushInstructionV0 instruction)
      (instance? native.core.TransientMapAssocInstructionV0 instruction)
      (instance? native.core.TransientSetConjInstructionV0 instruction)
      (instance? native.core.RecordAssocInstructionV0 instruction)
      (instance? native.core.BoxRecordInstruction instruction)
      (instance? native.core.AllocateInstruction instruction)
      (instance? native.core.AtomCreateInstruction instruction)
      (instance? native.core.TextSliceInstruction instruction)
      (instance? native.core.TextConcatInstruction instruction)
      (instance? native.core.ValueToTextInstructionV0 instruction)
      ;; A promote's copy is an allocation into its destination arena: the
      ;; function must declare the allocate effect and acquire an arena for
      ;; it, and rule E3 must count it against a caller handing this frame an
      ;; epoch it will destroy.
      (instance? native.core.PromoteInstructionV0 instruction)
      (and (instance? native.core.CodecPrimitiveInstructionV0 instruction)
        (let [(operation core/CodecPrimitiveOpV0)
              (core/codecprimitiveinstructionv0-operation instruction)]
          (or (instance? native.core.Utf8EncodeV0 operation)
            (instance? native.core.Utf8DecodeV0 operation)
            (instance? native.core.Utf8DecodeSourceV0 operation)
            (instance? native.core.NativeBytesFromIntsBoundedV0 operation)
            (instance? native.core.Sha256BytesV0 operation))))
      (and (instance? native.core.ExternCallInstruction instruction)
        (some? (core/externcallinstruction-arena-id instruction)))
      (and (instance? native.core.TextBuiltinInstruction instruction)
        (text-builtin-allocates?
          (core/textbuiltininstruction-builtin instruction)))))

(defn atom-state-instruction? [(instruction core/Instruction)] Bool
  (or (instance? native.core.AtomCreateInstruction instruction)
      (instance? native.core.AtomDerefInstruction instruction)
      (instance? native.core.AtomResetInstruction instruction)
      (instance? native.core.AtomCompareExchangeInstruction instruction)
      (instance? native.core.AtomSwapInstruction instruction)))

(defn blocks-use-atom-state? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some? (some atom-state-instruction?
                 (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-environment? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (same-id? (core/externcallinstruction-abi-id instruction)
                  (host-environment-abi-id))))
            (core/basicblock-instructions block))))
      blocks)))

(defn blocks-use-host-context? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some
      (fn [(block core/BasicBlock)] Bool
        (some?
          (some
            (fn [(instruction core/Instruction)] Bool
              (and (instance? native.core.ExternCallInstruction instruction)
                (host-context-abi-id?
                  (core/externcallinstruction-abi-id instruction))))
            (core/basicblock-instructions block))))
      blocks)))

(defn instructions-allocate? [(instructions (Vec core/Instruction))] Bool
  (some?
    (some (fn [(instruction core/Instruction)] Bool
            (allocating-instruction? instruction))
      instructions)))

(defn blocks-allocate? [(blocks (Vec core/BasicBlock))] Bool
  (some?
    (some (fn [(block core/BasicBlock)] Bool
            (instructions-allocate? (core/basicblock-instructions block)))
      blocks)))

(defn empty-vector-form? [(index SourceIndexV0) (node core/NativeId)] Bool
  (if (not (= "vec" (fact-text index node "form-kind")))
    false
    (let [(items-node (U core/NativeId Nil)) (index-first-object index node "items")]
      (if (nil? items-node)
        true
        (= 0 (count (index-sequence-items index items-node)))))))

(defn source-ref-named?
  [(index SourceIndexV0) (node core/NativeId) (expected String)] Bool
  (and (= "ref" (fact-text index node "form-kind"))
    (= expected (fact-text index node "name"))))

(defn source-call-named?
  [(index SourceIndexV0) (node core/NativeId) (expected String)] Bool
  (and (= "call" (fact-text index node "form-kind"))
    (= expected (fact-text index node "callee"))))

(defn source-call-arguments
  [(index SourceIndexV0) (node core/NativeId)] (Vec core/NativeId)
  (let [(args (U core/NativeId Nil)) (index-first-object index node "args")]
    (if (nil? args) [] (index-sequence-items index args))))

(defn source-contains-ref-named?
  [(index SourceIndexV0) (node core/NativeId) (name String) (fuel Int)] Bool
  (if (<= fuel 0)
    true
    (if (source-ref-named? index node name)
      true
      (let [(children (Vec core/NativeId)) (index-child-nodes index node)]
        (loop [(position Int) 0]
          (if (>= position (count children))
            false
            (if (source-contains-ref-named? index (nth children position)
                  name (- fuel 1))
              true
              (recur (+ position 1)))))))))

(defn source-excludes-ref-named?
  [(index SourceIndexV0) (node core/NativeId) (name String)] Bool
  (not (source-contains-ref-named? index node name
    (+ 1 (index-facts index)))))

(defn source-contains-transient-operator?
  [(index SourceIndexV0) (node core/NativeId) (fuel Int)] Bool
  (if (<= fuel 0)
    true
    (let [(operator Bool)
          (or (source-call-named? index node "transient")
            (source-call-named? index node "persistent!")
            (source-call-named? index node "assoc!")
            (source-call-named? index node "conj!"))]
      (if operator
        true
        (let [(children (Vec core/NativeId)) (index-child-nodes index node)]
          (loop [(position Int) 0]
            (if (>= position (count children))
              false
              (if (source-contains-transient-operator? index
                    (nth children position) (- fuel 1))
                true
                (recur (+ position 1))))))))))

(defn closed-transient-neutral-expression?
  [(index SourceIndexV0) (node core/NativeId) (owner String)] Bool
  (and (source-excludes-ref-named? index node owner)
    (not (source-contains-transient-operator? index node
      (+ 1 (index-facts index))))))

(defn source-any-annotation? [(index SourceIndexV0) (owner core/NativeId)] Bool
  (let [(annotation (U core/NativeId Nil))
        (index-first-object index owner "ann")]
    (and (some? annotation)
      (= "type-prim" (fact-text index annotation "form-kind"))
      (= "Any" (fact-text index annotation "name")))))

(defn source-transient-vector-type?
  [(index SourceIndexV0) (annotation core/NativeId)] Bool
  (= "TransientVec" (source-type-spelling index annotation)))

(defn source-transient-owner-annotation?
  [(index SourceIndexV0)
   (owner core/NativeId)
   (collection-kind String)]
  Bool
  (let [(annotation (U core/NativeId Nil))
        (index-first-object index owner "ann")]
    (and (some? annotation)
      (or (source-any-annotation? index owner)
        (and (= "vector" collection-kind)
          (source-transient-vector-type? index annotation))))))

;; A transient map may be borrowed only by exact `get`; every other occurrence
;; of its accumulator must remain on the single update thread.
(defn closed-transient-read-expression?
  [(index SourceIndexV0)
   (node core/NativeId)
   (accumulator String)
   (fuel Int)]
  Bool
  (if (<= fuel 0)
    false
    (cond
      (source-ref-named? index node accumulator) false

      (source-call-named? index node "get")
      (let [(args (Vec core/NativeId)) (source-call-arguments index node)]
        (and (or (= 2 (count args)) (= 3 (count args)))
          (source-ref-named? index (nth args 0) accumulator)
          (loop [(position Int) 1]
            (if (>= position (count args))
              true
              (if (closed-transient-neutral-expression? index
                    (nth args position)
                    accumulator)
                (recur (+ position 1))
                false)))))

      (or (source-call-named? index node "transient")
        (source-call-named? index node "persistent!")
        (source-call-named? index node "assoc!")
        (source-call-named? index node "conj!"))
      false

      :else
      (let [(children (Vec core/NativeId)) (index-child-nodes index node)]
        (loop [(position Int) 0]
          (if (>= position (count children))
            true
            (if (closed-transient-read-expression? index
                  (nth children position) accumulator (- fuel 1))
              (recur (+ position 1))
              false)))))))

(defn closed-transient-bang-body?
  [(index SourceIndexV0)
   (body core/NativeId)
   (collection-kind String)
   (accumulator String)]
  Bool
  (let [(args (Vec core/NativeId)) (source-call-arguments index body)]
    (cond
      (= "set" collection-kind)
      (and (source-call-named? index body "conj!")
        (= 2 (count args))
        (source-ref-named? index (nth args 0) accumulator)
        (closed-transient-neutral-expression? index (nth args 1) accumulator))

      (= "vector" collection-kind)
      (and (source-call-named? index body "conj!")
        (= 2 (count args))
        (source-ref-named? index (nth args 0) accumulator)
        (closed-transient-neutral-expression? index (nth args 1) accumulator))

      (= "map" collection-kind)
      (and (source-call-named? index body "assoc!")
        (= 3 (count args))
        (source-ref-named? index (nth args 0) accumulator)
        (closed-transient-neutral-expression? index (nth args 1) accumulator)
        (closed-transient-read-expression? index (nth args 2) accumulator
          (+ 1 (index-facts index))))

      :else false)))

(defn closed-transient-reduce?
  [(index SourceIndexV0)
   (node core/NativeId)
   (collection-kind String)
   (initial-owner String)]
  Bool
  (if (not (source-call-named? index node "reduce"))
    false
    (let [(args (Vec core/NativeId)) (source-call-arguments index node)]
      (if (not (= 3 (count args)))
        false
        (let [(callback core/NativeId) (nth args 0)
              (initial core/NativeId) (nth args 1)
              (collection core/NativeId) (nth args 2)
              (parameters (Vec core/NativeId))
              (function-parameter-items index callback)
              (body (U core/NativeId Nil))
              (index-first-object index callback "body")
              (callback-return (U core/NativeId Nil))
              (index-first-object index callback "ret")]
          (if (or (not (= "fn" (fact-text index callback "form-kind")))
                (not (nil? (index-first-object index callback "rest")))
                (not (= 2 (count parameters)))
                (nil? body)
                (nil? callback-return))
            false
            (let [(accumulator-node core/NativeId) (nth parameters 0)
                  (accumulator String)
                  (parameter-name-at index accumulator-node 0)
                  (initial-valid Bool)
                  (if (= "" initial-owner)
                    (and (source-call-named? index initial "transient")
                      (= 1 (count (source-call-arguments index initial))))
                    (source-ref-named? index initial initial-owner))]
              (and (> (count accumulator) 0)
                (source-transient-owner-annotation? index accumulator-node
                  collection-kind)
                (or
                  (and (= "type-prim"
                         (fact-text index callback-return "form-kind"))
                    (= "Any" (fact-text index callback-return "name")))
                  (and (= "vector" collection-kind)
                    (source-transient-vector-type? index callback-return)))
                initial-valid
                (closed-transient-neutral-expression? index collection
                  accumulator)
                (or (= "" initial-owner)
                  (closed-transient-neutral-expression? index collection
                    initial-owner))
                (closed-transient-bang-body? index body collection-kind
                  accumulator)))))))))

(defn closed-transient-thread-expression?
  [(index SourceIndexV0)
   (node core/NativeId)
   (collection-kind String)
   (owner String)]
  Bool
  (let [(kind String) (fact-text index node "form-kind")]
    (cond
      (source-ref-named? index node owner) true

      (= "if" kind)
      (let [(condition (U core/NativeId Nil))
            (index-first-object index node "cond")
            (then-node (U core/NativeId Nil))
            (index-first-object index node "then")
            (else-node (U core/NativeId Nil))
            (index-first-object index node "else")]
        (and (some? condition) (some? then-node) (some? else-node)
          (closed-transient-neutral-expression? index condition owner)
          (closed-transient-thread-expression? index then-node collection-kind
            owner)
          (closed-transient-thread-expression? index else-node collection-kind
            owner)))

      (source-call-named? index node "reduce")
      (closed-transient-reduce? index node collection-kind owner)

      :else false)))

(declare closed-transient-loop-tail?)

(defn closed-transient-let-tail?
  [(index SourceIndexV0)
   (node core/NativeId)
   (collection-kind String)
   (owner String)
   (binding-count Int)
   (owner-position Int)]
  Bool
  (let [(bindings-node (U core/NativeId Nil))
        (index-first-object index node "bindings")
        (bindings (Vec core/NativeId))
        (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
        (body (U core/NativeId Nil)) (index-first-object index node "body")]
    (and (some? body)
      (loop [(position Int) 0]
        (if (>= position (count bindings))
          true
          (let [(binding core/NativeId) (nth bindings position)
                (value (U core/NativeId Nil))
                (index-first-object index binding "value")]
            (if (and (not (= owner (fact-text index binding "name")))
                  (some? value)
                  (closed-transient-neutral-expression? index value owner))
              (recur (+ position 1))
              false))))
      (closed-transient-loop-tail? index body collection-kind owner
        binding-count owner-position))))

(defn closed-transient-loop-tail?
  [(index SourceIndexV0)
   (node core/NativeId)
   (collection-kind String)
   (owner String)
   (binding-count Int)
   (owner-position Int)]
  Bool
  (let [(kind String) (fact-text index node "form-kind")]
    (cond
      (source-ref-named? index node owner) true

      (= "if" kind)
      (let [(condition (U core/NativeId Nil))
            (index-first-object index node "cond")
            (then-node (U core/NativeId Nil))
            (index-first-object index node "then")
            (else-node (U core/NativeId Nil))
            (index-first-object index node "else")]
        (and (some? condition) (some? then-node) (some? else-node)
          (closed-transient-neutral-expression? index condition owner)
          (closed-transient-loop-tail? index then-node collection-kind owner
            binding-count owner-position)
          (closed-transient-loop-tail? index else-node collection-kind owner
            binding-count owner-position)))

      (= "let" kind)
      (closed-transient-let-tail? index node collection-kind owner
        binding-count owner-position)

      (= "recur" kind)
      (let [(args-node (U core/NativeId Nil))
            (index-first-object index node "args")
            (args (Vec core/NativeId))
            (if (nil? args-node) [] (index-sequence-items index args-node))]
        (and (= binding-count (count args))
          (loop [(position Int) 0]
            (if (>= position (count args))
              true
              (let [(argument core/NativeId) (nth args position)]
                (if (if (= position owner-position)
                      (closed-transient-thread-expression? index argument
                        collection-kind owner)
                      (closed-transient-neutral-expression? index argument
                        owner))
                  (recur (+ position 1))
                  false))))))

      :else false)))

(defn transient-loop-binding-position
  [(index SourceIndexV0) (bindings (Vec core/NativeId))] Int
  (loop [(position Int) 0 (found Int) -1]
    (if (>= position (count bindings))
      found
      (let [(value (U core/NativeId Nil))
            (index-first-object index (nth bindings position) "value")]
        (if (and (some? value) (source-call-named? index value "transient"))
          (if (>= found 0)
            -2
            (recur (+ position 1) position))
          (recur (+ position 1) found))))))

(defn closed-transient-loop?
  [(index SourceIndexV0) (node core/NativeId) (collection-kind String)] Bool
  (if (not (= "loop" (fact-text index node "form-kind")))
    false
    (let [(bindings-node (U core/NativeId Nil))
          (index-first-object index node "bindings")
          (bindings (Vec core/NativeId))
          (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
          (owner-position Int) (transient-loop-binding-position index bindings)
          (body (U core/NativeId Nil)) (index-first-object index node "body")]
      (if (or (< owner-position 0) (nil? body))
        false
        (let [(owner-binding core/NativeId) (nth bindings owner-position)
              (owner String) (fact-text index owner-binding "name")
              (initial (U core/NativeId Nil))
              (index-first-object index owner-binding "value")]
          (and (> (count owner) 0)
            (source-transient-owner-annotation? index owner-binding
              collection-kind)
            (some? initial)
            (= 1 (count (source-call-arguments index initial)))
            (loop [(position Int) 0]
              (if (>= position (count bindings))
                true
                (if (= position owner-position)
                  (recur (+ position 1))
                  (let [(binding core/NativeId) (nth bindings position)
                        (value (U core/NativeId Nil))
                        (index-first-object index binding "value")]
                    (if (and (not (= owner (fact-text index binding "name")))
                          (some? value)
                          (closed-transient-neutral-expression? index value
                            owner))
                      (recur (+ position 1))
                      false)))))
            (closed-transient-loop-tail? index body collection-kind owner
              (count bindings) owner-position)))))))

(defn closed-transient-source?
  [(index SourceIndexV0) (node core/NativeId) (collection-kind String)] Bool
  (or (closed-transient-reduce? index node collection-kind "")
    (closed-transient-loop? index node collection-kind)))

(defn active-transient-reduce?
  [(index SourceIndexV0) (node core/NativeId) (collection-kind String)] Bool
  (let [(args (Vec core/NativeId)) (source-call-arguments index node)]
    (if (not (= 3 (count args)))
      false
      (let [(initial core/NativeId) (nth args 1)]
        (if (source-call-named? index initial "transient")
          (closed-transient-reduce? index node collection-kind "")
          (if (= "ref" (fact-text index initial "form-kind"))
            (closed-transient-reduce? index node collection-kind
              (fact-text index initial "name"))
            false))))))

(defn source-string-literal-value
  [(index SourceIndexV0) (node core/NativeId)] (U String Nil)
  (if (and (= "literal" (fact-text index node "form-kind"))
           (= "string" (fact-text index node "literal-kind")))
    (fact-text index node "value")
    nil))

(defn source-regex-literal-value
  [(index SourceIndexV0) (node core/NativeId)] (U String Nil)
  (if (and (= "literal" (fact-text index node "form-kind"))
           (= "regex" (fact-text index node "literal-kind")))
    (fact-text index node "value")
    nil))

(defn source-int-literal-value
  [(index SourceIndexV0) (node core/NativeId)] (U Int Nil)
  (if (and (= "literal" (fact-text index node "form-kind"))
        (or (= "int" (fact-text index node "literal-kind"))
          (= "number" (fact-text index node "literal-kind"))))
    (parse-int-text (fact-text index node "value"))
    nil))

(defn source-keyword-literal-value
  [(index SourceIndexV0) (node core/NativeId)] (U String Nil)
  (if (and (= "literal" (fact-text index node "form-kind"))
        (= "keyword" (fact-text index node "literal-kind")))
    (fact-text index node "value")
    nil))

(defn f64-buffer-type? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (and (buffer-type? types target)
    (same-id? (buffer-element-of types target) (float-type-id))))

(defn tiled-kernel-signature?
  [(types (Vec core/TypeDef)) (signature TypedFunctionV0)] Bool
  (let [(parameters (Vec core/Parameter))
        (typedfunctionv0-parameters signature)]
    (and (= 5 (count parameters))
      (f64-buffer-type? types
        (core/parameter-type-id (nth parameters 0)))
      (f64-buffer-type? types
        (core/parameter-type-id (nth parameters 1)))
      (same-id? (core/parameter-type-id (nth parameters 2)) (int-type-id))
      (same-id? (core/parameter-type-id (nth parameters 3)) (int-type-id))
      (same-id? (core/parameter-type-id (nth parameters 4)) (int-type-id))
      (same-id? (typedfunctionv0-return-type signature) (type-id "Nil")))))

(defn text-vector-value?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (and (vector-type? types target)
    (same-id? (vector-element-of types target) (type-id "String"))))

(defn int-vector-value?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (and (vector-type? types target)
    (same-id? (vector-element-of types target) (type-id "Int"))))

(defn int-vector-value? [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (and (vector-type? types target)
    (same-id? (vector-element-of types target) (int-type-id))))

(defn empty-map-form? [(index SourceIndexV0) (node core/NativeId)] Bool
  (if (not (= "map" (fact-text index node "form-kind")))
    false
    (let [(pairs-node (U core/NativeId Nil)) (index-first-object index node "pairs")]
      (if (nil? pairs-node)
        true
        (= 0 (count (index-sequence-items index pairs-node)))))))

(defn empty-set-form? [(index SourceIndexV0) (node core/NativeId)] Bool
  (if (not (= "set" (fact-text index node "form-kind")))
    false
    (let [(items-node (U core/NativeId Nil)) (index-first-object index node "items")]
      (if (nil? items-node)
        true
        (= 0 (count (index-sequence-items index items-node)))))))

(defn annotation-native-type
  [(index SourceIndexV0)
   (annotation (U core/NativeId Nil))]
  (U core/NativeId Nil)
  (if (nil? annotation)
    nil
    (typeresolutionv0-type-id (resolve-source-type index annotation))))

(defn checked-expression-type
  [(env BodyEnvV0) (state BodyStateV0) (expression core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (inferred (U core/NativeId Nil))
        (annotation-native-type index
          (index-first-object index expression "inferred-type"))]
    (if (some? inferred) inferred (source-ref-type env state expression))))

(defn contextual-argument-type
  [(constructor (U core/TypeDef Nil))
   (signature (U TypedFunctionV0 Nil))
   (arity Int)
   (position Int)]
  (U core/NativeId Nil)
  (if (some? constructor)
    (let [(shape core/TypeShape) (core/typedef-shape constructor)
          (fields (Vec core/TypeField))
          (if (instance? native.core.RecordType shape)
            (core/recordtype-fields shape)
            [])]
      (if (and (= arity (count fields))
               (>= position 0)
               (< position (count fields)))
        (core/typefield-type-id (nth fields position))
        nil))
    (if (some? signature)
      (let [(parameters (Vec core/Parameter))
            (typedfunctionv0-parameters signature)]
        (if (and (= arity (count parameters))
                 (>= position 0)
                 (< position (count parameters)))
          (core/parameter-type-id (nth parameters position))
          nil))
      nil)))

;; Empty literals carry no member evidence. Only an exact closed type supplied
;; by a surrounding boundary may choose their native program shape.
(defn lower-empty-vector
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (if (nil? expected)
    (fail-result state
      "TODO-NATIVE-EMPTY-VECTOR-LITERAL: an empty literal names no element type")
    (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)]
      (if (not (vector-type? types expected))
        (fail-result state
          "TODO-NATIVE-EMPTY-VECTOR-LITERAL: the contextual type is not an exact native vector type")
        (let [(capacity-id core/NativeId) (state-id state owner "vec-cap")
              (result-id core/NativeId) (state-id (state-bump state) owner "vec-lit")]
          (->ExprResultV0
            (state-emit
              (state-emit (state-bump (state-bump state))
                (core/->AtomInstruction
                  (core/->SsaValueV0 capacity-id (int-type-id))
                  (core/->I64Atom 0)))
              (core/->VecEmptyInstruction
                (core/->SsaValueV0 result-id expected)
                capacity-id (arena-value-id owner)))
            result-id expected false))))))

(defn lower-empty-map
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (if (nil? expected)
    (fail-result state
      "TODO-NATIVE-EMPTY-MAP-LITERAL: an empty literal names no key or value type")
    (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)]
      (if (not (map-type? types expected))
        (fail-result state
          "TODO-NATIVE-EMPTY-MAP-LITERAL: the contextual type is not an exact native map type")
        (let [(equality (U core/ConcreteEqualityV0 Nil))
              (map-key-equality-for types (map-key-of types expected))]
          (if (nil? equality)
            (fail-result state
              "TODO-NATIVE-MAP-KEY-EQUALITY: the key type has no closed concrete equality")
            (let [(result-id core/NativeId) (state-id state owner "map-lit")]
              (->ExprResultV0
                (state-emit (state-bump state)
                  (core/->MapLiteralInstructionV0
                    (core/->SsaValueV0 result-id expected)
                    [] [] (arena-value-id owner) equality))
                result-id expected false))))))))

(defn lower-empty-set
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (if (nil? expected)
    (fail-result state
      "TODO-NATIVE-EMPTY-SET-LITERAL: an empty literal names no element type")
    (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)]
      (if (not (set-type? types expected))
        (fail-result state
          "TODO-NATIVE-EMPTY-SET-LITERAL: the contextual type is not an exact native set type")
        (let [(equality (U core/ConcreteEqualityV0 Nil))
              (set-element-equality-for types
                (set-element-of types expected))]
          (if (nil? equality)
            (fail-result state
              "TODO-NATIVE-SET-ELEMENT-EQUALITY: the element type has no closed concrete equality")
            (let [(result-id core/NativeId) (state-id state owner "set-lit")]
              (->ExprResultV0
                (state-emit (state-bump state)
                  (core/->SetLiteralInstructionV0
                    (core/->SsaValueV0 result-id expected)
                    [] (arena-value-id owner) equality))
                result-id expected false))))))))

(defn expected-collection-argument-type
  [(types (Vec core/TypeDef))
   (callee String)
   (position Int)
   (prior-types (Vec core/NativeId))]
  (U core/NativeId Nil)
  (if (= 0 (count prior-types))
    nil
    (let [(receiver core/NativeId) (nth prior-types 0)]
      (cond
        (and (= position 1) (map-type? types receiver)
          (or (= "get" callee) (= "assoc" callee) (= "dissoc" callee)
            (= "contains?" callee)))
        (map-key-of types receiver)

        (and (= position 2) (map-type? types receiver)
          (or (= "get" callee) (= "assoc" callee)))
        (map-value-of types receiver)

        (and (>= position 1) (set-type? types receiver)
          (or (= "contains?" callee) (= "conj" callee) (= "disj" callee)))
        (set-element-of types receiver)

        (and (= position 1) (vector-type? types receiver) (= "assoc" callee))
        (int-type-id)

        (and (= position 2) (vector-type? types receiver) (= "assoc" callee))
        (vector-element-of types receiver)

        (and (>= position 1) (vector-type? types receiver) (= "conj" callee))
        (vector-element-of types receiver)

        (and (= position 1) (vector-type? types receiver) (= "into" callee))
        receiver

        :else nil))))

(defn preserved-collection-argument-type
  [(types (Vec core/TypeDef))
   (callee String)
   (arity Int)
   (position Int)
   (expected (U core/NativeId Nil))]
  (U core/NativeId Nil)
  (if (and (= arity 1)
           (= position 0)
           (some? expected)
           (or (vector-type? types expected)
               (map-type? types expected)
               (set-type? types expected))
           (or (= "persistent!" callee) (= "transient" callee)))
    expected
    nil))

;; Equality is heterogeneous, so only an empty collection may borrow the exact
;; type of an already-evaluated peer. Non-empty operands keep their own inferred
;; type and therefore preserve Clojure equality between unlike values.
(defn equality-empty-argument-type
  [(types (Vec core/TypeDef))
   (index SourceIndexV0)
   (env BodyEnvV0)
   (state BodyStateV0)
   (callee String)
   (position Int)
   (prior-types (Vec core/NativeId))
   (arguments (Vec core/NativeId))
   (argument core/NativeId)]
  (U core/NativeId Nil)
  (if (or (= "=" callee) (= "not=" callee))
    (let [(peer (U core/NativeId Nil))
          (cond
            (and (= position 1) (= 1 (count prior-types)))
            (nth prior-types 0)

            (and (= position 0) (= 2 (count arguments)))
            (checked-expression-type env state (nth arguments 1))

            :else nil)]
      (cond
        (nil? peer) nil
        (and (empty-vector-form? index argument) (vector-type? types peer)) peer
        (and (empty-map-form? index argument) (map-type? types peer)) peer
        (and (empty-set-form? index argument) (set-type? types peer)) peer
        :else nil))
    nil))

(defn lower-contextual-empty
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)
   (expected (U core/NativeId Nil))]
  (U ExprResultV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (cond
      (empty-vector-form? index expression)
      (lower-empty-vector env owner state expected)

      (empty-map-form? index expression)
      (lower-empty-map env owner state expected)

      (empty-set-form? index expression)
      (lower-empty-set env owner state expected)

      :else nil)))

;; An expected Vec owns the element carrier, including nested empty literals.
(defn lower-contextual-vector
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)
   (expected (U core/NativeId Nil))
   (lower-item (Fn [BodyStateV0 core/NativeId core/NativeId] ExprResultV0))]
  (U ExprResultV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (items-node (U core/NativeId Nil))
        (index-first-object index expression "items")
        (items (Vec core/NativeId))
        (if (nil? items-node) [] (index-sequence-items index items-node))]
    (if (or (not (= "vec" (fact-text index expression "form-kind")))
            (nil? expected)
            (not (vector-type? types expected))
            (= 0 (count items)))
      nil
      (let [(element-type core/NativeId) (vector-element-of types expected)
            (lowered ArgsResultV0)
                (loop [(position Int) 0
                       (current BodyStateV0) state
                       (values (Vec core/NativeId)) []
                       (value-types (Vec core/NativeId)) []]
                  (if (or (>= position (count items))
                          (state-blocked? current))
                    (->ArgsResultV0 current values value-types false)
                    (let [(item ExprResultV0)
                          (lower-item current (nth items position) element-type)]
                      (if (exprresultv0-terminated item)
                        (->ArgsResultV0 (exprresultv0-state item) values
                          value-types true)
                        (recur (+ position 1) (exprresultv0-state item)
                          (conj values (exprresultv0-value-id item))
                          (conj value-types (exprresultv0-type-id item)))))))
                (current BodyStateV0) (argsresultv0-state lowered)]
            (cond
              (argsresultv0-terminated lowered)
              (->ExprResultV0 current (lower-id "body" ["unreachable"])
                (type-id "LowerFailure") true)

              (state-blocked? current) (dead-result current)

              :else
              (let [(coerced ArgsResultV0)
                    (coerce-values-to-type types owner current
                      (argsresultv0-values lowered)
                      (argsresultv0-value-types lowered)
                      element-type)
                    (settled BodyStateV0) (argsresultv0-state coerced)]
                (if (state-blocked? settled)
                  (dead-result settled)
                  (build-vector-literal owner settled expected
                    (argsresultv0-values coerced)))))))))

(defn lower-contextual-value
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)
   (expected (U core/NativeId Nil))
   (lower-item (Fn [BodyStateV0 core/NativeId core/NativeId] ExprResultV0))]
  (U ExprResultV0 Nil)
  (let [(empty (U ExprResultV0 Nil))
        (lower-contextual-empty env owner state expression expected)]
    (if (some? empty)
      empty
      (lower-contextual-vector env owner state expression expected lower-item))))

(defn text-type-id [] core/NativeId (type-id "String"))

(defn keyword-type-id [] core/NativeId (type-id "Keyword"))

(defn exact-closed-type?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (some? definition)
      (not (instance? native.core.UnionType (core/typedef-shape definition))))))

(defn static-type-predicate? [(callee String)] Bool
  (or (= "sequential?" callee)
    (= "vector?" callee)
    (= "map?" callee)
    (= "set?" callee)
    (= "string?" callee)
    (= "integer?" callee)
    (= "int?" callee)))

(defn static-collection-predicate? [(callee String)] Bool
  (or (= "sequential?" callee) (= "vector?" callee)
    (= "map?" callee) (= "set?" callee)))

(defn static-type-predicate-value
  [(types (Vec core/TypeDef))
   (callee String)
   (value-type core/NativeId)]
  (U Bool Nil)
  (if (not (and (static-type-predicate? callee)
             (exact-closed-type? types value-type)))
    nil
    (cond
      (= "sequential?" callee)
      (and (vector-type? types value-type)
        (not (map-value? types value-type)))
      (= "vector?" callee) (vector-type? types value-type)
      (= "map?" callee)
      (or (map-type? types value-type) (map-value? types value-type))
      (= "set?" callee) (set-type? types value-type)
      (= "string?" callee) (same-id? value-type (text-type-id))
      (or (= "integer?" callee) (= "int?" callee))
      (same-id? value-type (int-type-id))
      :else nil)))

;; The trap code IS the LowerFailure variant ordinal, read off the union rather
;; than spelled twice.
(defn failure-code [(name String)] Int
  (let [(shape core/TypeShape) (core/typedef-shape (lower-failure-type))
        (variants (Vec core/TypeVariant))
        (if (instance? native.core.UnionType shape)
          (core/uniontype-variants shape)
          [])]
    (loop [(position Int) 0]
      (cond
        (>= position (count variants)) (trap-failure-code)
        (= name (core/typevariant-name (nth variants position))) position
        :else (recur (+ position 1))))))

(defn guard-binding-value
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (binding core/NativeId)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (constraint (U core/NativeId Nil))
        (index-first-object index binding "constraint")]
    (if (nil? constraint)
      state
      (let [(synchronous String)
            (fact-text index binding "constraint-synchronous")
            (kind String) (fact-text index constraint "form-kind")
            (predicate String) (fact-text index constraint "name")]
        (cond
          (not (= "true" synchronous))
          (state-fail state
            "LOWER-CONSTRAINT-SYNC-PROOF: constraint lacks checker-owned synchronous proof")

          (or (not (= "ref" kind)) (= "" predicate))
          (state-fail state
            (str "LOWER-CONSTRAINT-PREDICATE-VALUE-ABI: Native Core has no function-value ABI for "
              (if (= "" kind) "unknown constraint form" kind)))

          :else
          (let [(signature (U TypedFunctionV0 Nil))
                (find-signature env constraint predicate)]
            (if (nil? signature)
              (state-fail state
                (str "LOWER-CONSTRAINT-PREDICATE: no native signature for " predicate))
              (let [(parameters (Vec core/Parameter))
                    (typedfunctionv0-parameters signature)]
                (cond
                  (not (= 1 (count parameters)))
                  (state-fail state
                    (str "LOWER-CONSTRAINT-PREDICATE-ARITY: " predicate
                      " must take exactly one value"))

                  (not (same-id? (typedfunctionv0-return-type signature)
                         (bool-type-id)))
                  (state-fail state
                    (str "LOWER-CONSTRAINT-PREDICATE-RESULT: " predicate
                      " must return Bool"))

                  :else
                  (let [(coerced ExprResultV0)
                        (lower-boundary-coerce (bodyenvv0-types env) owner state
                          value-id value-type
                          (core/parameter-type-id (nth parameters 0)))
                        (current BodyStateV0) (exprresultv0-state coerced)]
                    (if (or (state-blocked? current)
                          (not (same-id? (exprresultv0-type-id coerced)
                                 (core/parameter-type-id (nth parameters 0)))))
                      (state-fail current
                        (str "LOWER-CONSTRAINT-PREDICATE-INPUT: " predicate
                          " cannot accept the complete binding value"))
                      (let [(result-id core/NativeId)
                            (state-id current owner "binding-constraint-result")
                            (called BodyStateV0)
                            (state-emit (state-bump current)
                              (core/->CallInstruction
                                (core/->SsaValueV0 result-id (bool-type-id))
                                (typedfunctionv0-id signature)
                                [(exprresultv0-value-id coerced)] nil
                                (core/->TokenFlowV0 [] [])))
                            (pass-id core/NativeId)
                            (state-id called owner "binding-constraint-pass")
                            (failure-id core/NativeId)
                            (state-id (state-bump called) owner
                              "binding-constraint-failure")
                            (branched BodyStateV0)
                            (state-close (state-bump (state-bump called))
                              (core/->BranchTerminator result-id pass-id failure-id))
                            (failure-state BodyStateV0)
                            (state-open-block branched failure-id [])
                            (code-id core/NativeId)
                            (state-id failure-state owner
                              "binding-constraint-trap")
                            (trapped BodyStateV0)
                            (state-close
                              (state-emit (state-bump failure-state)
                                (core/->AtomInstruction
                                  (core/->SsaValueV0 code-id (int-type-id))
                                  (core/->I64Atom
                                    (failure-code "binding-constraint"))))
                              (core/->TrapTerminator code-id))]
                        (state-open-block trapped pass-id [])))))))))))))

(defn source-record-for-type
  [(index SourceIndexV0) (record-type core/NativeId)] (U core/NativeId Nil)
  (let [(records (Vec core/NativeId))
        (vec (concat (index-form-ids index "record")
               (filterv
                 (fn [(group core/NativeId)] Bool
                   (= "true" (fact-text index group "inline")))
                 (index-form-ids index "member-field-group"))))]
    (loop [(position Int) 0]
      (if (>= position (count records))
        nil
        (let [(record core/NativeId) (nth records position)
              (name String) (fact-text index record "name")
              (candidate core/NativeId)
              (source-type-id (str (source-module-name index record) "/" name))]
          (if (same-id? candidate record-type)
            record
            (recur (+ position 1))))))))

(defn source-record-field
  [(index SourceIndexV0)
   (source-record core/NativeId)
   (field-name String)]
  (U core/NativeId Nil)
  (let [(fields (Vec core/NativeId))
        (record-field-items index source-record)]
    (loop [(position Int) 0]
      (if (>= position (count fields))
        nil
        (let [(field core/NativeId) (nth fields position)
              (name (U String Nil)) (field-name-at index field)]
          (if (= field-name name) field (recur (+ position 1))))))))

(defn guard-record-field-value
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (record-type core/NativeId)
   (field-name String)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (record (U core/NativeId Nil))
        (source-record-for-type index record-type)]
    (if (nil? record)
      state
      (let [(field (U core/NativeId Nil))
            (source-record-field index record field-name)]
        (if (nil? field)
          (state-fail state
            (str "LOWER-RECORD-FIELD-CONTRACT: source record has no field "
              field-name))
          (guard-binding-value env owner state field value-id value-type))))))

(defn guard-record-values
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (record-type core/NativeId)
   (fields (Vec core/TypeField))
   (values (Vec core/NativeId))]
  BodyStateV0
  (loop [(position Int) 0 (current BodyStateV0) state]
    (if (or (>= position (count fields))
          (>= position (count values))
          (state-blocked? current))
      current
      (let [(field core/TypeField) (nth fields position)]
        (recur (+ position 1)
          (guard-record-field-value env owner current record-type
            (core/typefield-name field) (nth values position)
            (core/typefield-type-id field)))))))

(defn text-operand? [(type-id-value core/NativeId)] Bool
  (same-id? type-id-value (text-type-id)))

(defn concat-operands-native? [(value-types (Vec core/NativeId))] Bool
  (loop [(position Int) 0]
    (if (>= position (count value-types))
      true
      (let [(operand core/NativeId) (nth value-types position)]
        (if (or (text-operand? operand) (same-id? operand (int-type-id)))
          (recur (+ position 1))
          false)))))

(defn str-operands-compatible?
  [(types (Vec core/TypeDef)) (value-types (Vec core/NativeId))] Bool
  (loop [(position Int) 0]
    (if (>= position (count value-types))
      true
      (let [(operand core/NativeId) (nth value-types position)]
        (if (or (text-operand? operand)
              (same-id? operand (int-type-id))
              (value-to-text-type? types operand))
          (recur (+ position 1))
          false)))))

(defn render-str-operands
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ArgsResultV0
  (loop [(position Int) 0
         (current BodyStateV0) state
         (rendered-values (Vec core/NativeId)) []
         (rendered-types (Vec core/NativeId)) []]
    (if (or (>= position (count values)) (state-blocked? current))
      (->ArgsResultV0 current rendered-values rendered-types false)
      (let [(value-id core/NativeId) (nth values position)
            (value-type core/NativeId) (nth value-types position)]
        (if (or (text-operand? value-type)
              (same-id? value-type (int-type-id)))
          (recur (+ position 1) current
            (conj rendered-values value-id)
            (conj rendered-types value-type))
          (let [(result-id core/NativeId)
                (state-id current owner (str "str-value-" position))
                (rendered BodyStateV0)
                (state-emit (state-bump current)
                  (core/->ValueToTextInstructionV0
                    (core/->SsaValueV0 result-id (text-type-id))
                    (core/->ValueStrV0 true)
                    value-type
                    value-id
                    (arena-value-id owner)))]
            (recur (+ position 1) rendered
              (conj rendered-values result-id)
              (conj rendered-types (text-type-id)))))))))

(defn scalar-predicate? [(callee String)] Bool
  (or (= "string?" callee)
    (= "integer?" callee)
    (= "int?" callee)
    (= "number?" callee)
    (= "boolean?" callee)
    (= "keyword?" callee)))

(defn scalar-predicate-types [(callee String)] (Vec core/NativeId)
  (cond
    (= "string?" callee) [(text-type-id)]
    (or (= "integer?" callee) (= "int?" callee)) [(int-type-id)]
    (= "number?" callee) [(int-type-id) (type-id "Float")]
    (= "boolean?" callee) [(bool-type-id)]
    (= "keyword?" callee) [(keyword-type-id)]
    :else []))

(defn bool-constant-result
  [(state BodyStateV0)
   (owner core/NativeId)
   (label String)
   (value Bool)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner label)]
    (->ExprResultV0
      (state-emit (state-bump state)
        (core/->AtomInstruction
          (core/->SsaValueV0 result-id (bool-type-id))
          (core/->BoolAtom value)))
      result-id (bool-type-id) false)))

(defn nil-constant-result
  [(types (Vec core/TypeDef))
   (state BodyStateV0)
   (owner core/NativeId)
   (label String)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant))
        (union-variants-of types (type-id "Nil"))]
    (if (not (and (= 1 (count variants))
              (nil? (core/typevariant-payload-type (nth variants 0)))))
      (fail-result state
        "TODO-NATIVE-LITERAL-NIL-TYPE: Nil has no closed unit variant")
      (let [(result-id core/NativeId) (state-id state owner label)]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->UnionConstructInstruction
              (core/->SsaValueV0 result-id (type-id "Nil"))
              (core/typevariant-id (nth variants 0))
              nil))
          result-id (type-id "Nil") false)))))

(defn static-predicate-condition-value
  [(index SourceIndexV0)
   (owner core/NativeId)
   (condition-node core/NativeId)
   (condition ExprResultV0)]
  (U Bool Nil)
  (let [(state BodyStateV0) (exprresultv0-state condition)
        (instructions (Vec core/Instruction)) (bodystatev0-instructions state)
        (callee String) (fact-text index condition-node "callee")]
    (if (not (and (= "call" (fact-text index condition-node "form-kind"))
               (static-type-predicate? callee)
               (= 1 (count (source-call-arguments index condition-node)))
               (> (bodystatev0-counter state) 0)
               (> (count instructions) 0)))
      nil
      (let [(instruction core/Instruction)
            (nth instructions (- (count instructions) 1))
            (prior BodyStateV0)
            (with state [:counter (- (bodystatev0-counter state) 1)])]
        (if (not (instance? native.core.AtomInstruction instruction))
          nil
          (let [(atom core/NativeAtom) (core/atominstruction-atom instruction)]
            (cond
              (not (same-id? (exprresultv0-value-id condition)
                     (state-id prior owner "static-predicate"))) nil
              (not (same-id? (exprresultv0-value-id condition)
                     (core/ssavaluev0-id
                       (core/atominstruction-result instruction)))) nil
              (instance? native.core.BoolAtom atom) (core/boolatom-value atom)
              :else nil)))))))

(defn drop-static-predicate-result [(state BodyStateV0)] BodyStateV0
  (let [(instructions (Vec core/Instruction)) (bodystatev0-instructions state)]
    (loop [(position Int) 0 (kept (Vec core/Instruction)) []]
      (if (>= (+ position 1) (count instructions))
        (with state [:instructions kept])
        (recur (+ position 1) (conj kept (nth instructions position)))))))

(defn lower-scalar-predicate-with-budget
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (budget Int)]
  ExprResultV0
  (let [(accepted (Vec core/NativeId)) (scalar-predicate-types callee)
        (variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (cond
      (= 0 (count variants))
      (bool-constant-result state owner "scalar-predicate"
        (core/id-in? accepted value-type))

      (< budget 0)
      (fail-result state
        "TODO-NATIVE-PREDICATE-DEPTH: scalar predicate nested past the v0 budget")

      :else
      (let [(true-id core/NativeId) (state-id state owner "predicate-true")
            (false-id core/NativeId) (state-id state owner "predicate-false")
            (join-id core/NativeId) (state-id state owner "predicate-join")
            (join-parameter core/NativeId)
            (state-id state owner "predicate-value")
            (true-value core/NativeId) (state-id state owner "predicate-yes")
            (false-value core/NativeId) (state-id state owner "predicate-no")
            (cases (Vec core/SwitchCaseV0))
            (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
              (if (>= position (count variants))
                collected
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)
                      (target core/NativeId)
                      (cond
                        (nil? payload) false-id
                        (core/id-in? accepted payload) true-id
                        (> (count (union-variants-of types payload)) 0)
                        (state-id state owner (str "predicate-arm-" position))
                        :else false-id)]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id variant) target []))))))
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (armed BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (or (nil? payload)
                        (core/id-in? accepted payload)
                        (= 0 (count (union-variants-of types payload))))
                    (recur (+ position 1) current)
                    (let [(arm-id core/NativeId)
                          (state-id state owner (str "predicate-arm-" position))
                          (opened BodyStateV0) (state-open-block current arm-id [])
                          (extracted-id core/NativeId)
                          (state-id opened owner
                            (str "predicate-payload-" position))
                          (extracted BodyStateV0)
                          (state-emit (state-bump opened)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 extracted-id payload)
                              value-id (core/typevariant-id variant)))
                          (nested ExprResultV0)
                          (lower-scalar-predicate-with-budget types owner extracted
                            callee extracted-id payload (- budget 1))]
                      (if (state-blocked? (exprresultv0-state nested))
                        (exprresultv0-state nested)
                        (recur (+ position 1)
                          (state-close (exprresultv0-state nested)
                            (core/->JumpTerminator join-id
                              [(exprresultv0-value-id nested)])))))))))
            (true-block BodyStateV0)
            (state-close
              (state-emit (state-open-block armed true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            (false-block BodyStateV0)
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn record-predicate-type?
  [(types (Vec core/TypeDef))
   (target core/NativeId)
   (record-type core/NativeId)]
  Bool
  (or (same-id? target record-type)
    (reference-targets? types target record-type)))

;; Optional map values nest their declared union under Nil. Record tests follow
;; that sealed union path instead of requiring the record at the outermost tag.
(defn lower-record-predicate-with-budget
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (record-type core/NativeId)
   (budget Int)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (cond
      (= 0 (count variants))
      (bool-constant-result state owner "record-predicate"
        (record-predicate-type? types value-type record-type))

      (< budget 0)
      (fail-result state
        "TODO-NATIVE-INSTANCE-DEPTH: record test nested past the v0 budget")

      :else
      (let [(true-id core/NativeId) (state-id state owner "record-true")
            (false-id core/NativeId) (state-id state owner "record-false")
            (join-id core/NativeId) (state-id state owner "record-join")
            (join-parameter core/NativeId)
            (state-id state owner "record-value")
            (true-value core/NativeId) (state-id state owner "record-yes")
            (false-value core/NativeId) (state-id state owner "record-no")
            (cases (Vec core/SwitchCaseV0))
            (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
              (if (>= position (count variants))
                collected
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)
                      (target core/NativeId)
                      (cond
                        (nil? payload) false-id
                        (record-predicate-type? types payload record-type) true-id
                        (> (count (union-variants-of types payload)) 0)
                        (state-id state owner (str "record-arm-" position))
                        :else false-id)]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id variant) target []))))))
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (armed BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (or (nil? payload)
                        (record-predicate-type? types payload record-type)
                        (= 0 (count (union-variants-of types payload))))
                    (recur (+ position 1) current)
                    (let [(arm-id core/NativeId)
                          (state-id state owner (str "record-arm-" position))
                          (opened BodyStateV0) (state-open-block current arm-id [])
                          (extracted-id core/NativeId)
                          (state-id opened owner
                            (str "record-payload-" position))
                          (extracted BodyStateV0)
                          (state-emit (state-bump opened)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 extracted-id payload)
                              value-id (core/typevariant-id variant)))
                          (nested ExprResultV0)
                          (lower-record-predicate-with-budget types owner extracted
                            extracted-id payload record-type (- budget 1))]
                      (if (state-blocked? (exprresultv0-state nested))
                        (exprresultv0-state nested)
                        (recur (+ position 1)
                          (state-close (exprresultv0-state nested)
                            (core/->JumpTerminator join-id
                              [(exprresultv0-value-id nested)])))))))))
            (true-block BodyStateV0)
            (state-close
              (state-emit (state-open-block armed true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            (false-block BodyStateV0)
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn collection-predicate? [(callee String)] Bool
  (or (= "map?" callee)
    (= "set?" callee)
    (= "vector?" callee)
    (= "sequential?" callee)))

(defn collection-predicate-type?
  [(types (Vec core/TypeDef)) (callee String) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (if (nil? definition)
      false
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (cond
          (= "map?" callee) (instance? native.core.MapTypeV0 shape)
          (= "set?" callee) (instance? native.core.SetTypeV0 shape)
          (= "vector?" callee) (instance? native.core.VectorType shape)
          (= "sequential?" callee) (instance? native.core.VectorType shape)
          :else false)))))

(defn collection-variant-matches?
  [(types (Vec core/TypeDef)) (callee String) (variant core/TypeVariant)] Bool
  (let [(payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)]
    (if (nil? payload)
      false
      (collection-predicate-type? types callee payload))))

(defn lower-collection-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (if (= 0 (count variants))
      (bool-constant-result state owner "collection-predicate"
        (collection-predicate-type? types callee value-type))
      (let [(true-id core/NativeId) (state-id state owner "collection-true")
            (false-id core/NativeId) (state-id state owner "collection-false")
            (join-id core/NativeId) (state-id state owner "collection-join")
            (join-parameter core/NativeId)
            (state-id state owner "collection-value")
            (true-value core/NativeId) (state-id state owner "collection-yes")
            (false-value core/NativeId) (state-id state owner "collection-no")
            (cases (Vec core/SwitchCaseV0))
            (mapv
              (fn [(variant core/TypeVariant)] core/SwitchCaseV0
                (core/->SwitchCaseV0 (core/typevariant-id variant)
                  (if (collection-variant-matches? types callee variant)
                    true-id false-id)
                  []))
              variants)
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (true-block BodyStateV0)
            (state-close
              (state-emit (state-open-block switched true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            (false-block BodyStateV0)
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn nil-variant-count [(variants (Vec core/TypeVariant))] Int
  (loop [(position Int) 0 (found Int) 0]
    (if (>= position (count variants))
      found
      (recur (+ position 1)
        (+ found (if (nil-variant? (nth variants position)) 1 0))))))

(defn optional-scalar-type-of
  [(types (Vec core/TypeDef)) (scalar core/NativeId)] (U core/NativeId Nil)
  (loop [(position Int) 0]
    (if (>= position (count types))
      nil
      (let [(definition core/TypeDef) (nth types position)
            (variants (Vec core/TypeVariant))
            (union-variants-of types (core/typedef-id definition))]
        (if (and (= 2 (count variants))
              (= 1 (nil-variant-count variants))
              (some? (variant-for-payload variants scalar)))
          (core/typedef-id definition)
          (recur (+ position 1)))))))

(defn regex-match-value?
  [(types (Vec core/TypeDef)) (target core/NativeId)] Bool
  (let [(definition (U core/TypeDef Nil)) (lookup-type types target)]
    (and (some? definition)
      (= "RegexMatch" (core/typedef-name definition)))))

(defn nullable-value-type-of
  [(types (Vec core/TypeDef)) (value-type core/NativeId)] (U core/NativeId Nil)
  (let [(direct (Vec core/TypeVariant)) (union-variants-of types value-type)
        (wrapper core/NativeId) (nullable-map-value-type-id value-type)]
    (cond
      (> (nil-variant-count direct) 0) value-type
      (some? (lookup-type types wrapper)) wrapper
      :else (optional-scalar-type-of types value-type))))

(defn lower-presence-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (want-present Bool)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (cond
      (regex-match-value? types value-type)
      (let [(length-id core/NativeId) (state-id state owner "match-length")
            (zero-id core/NativeId)
            (state-id (state-bump state) owner "match-zero")
            (result-id core/NativeId)
            (state-id (state-bump (state-bump state)) owner "match-present")]
        (->ExprResultV0
          (state-emit
            (state-emit
              (state-emit
                (state-bump (state-bump (state-bump state)))
                (core/->VecLengthInstruction
                  (core/->SsaValueV0 length-id (int-type-id)) value-id))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (if want-present
                (core/->CompareLtI64V0 true)
                (core/->CompareEqI64V0 true))
              zero-id length-id))
          result-id (bool-type-id) false))

      (same-id? value-type (type-id "Nil"))
      (bool-constant-result state owner "presence-direct" (not want-present))

      (= 0 (count variants))
      (bool-constant-result state owner "presence-direct" want-present)

      (not (= 1 (nil-variant-count variants)))
      (fail-result state
        "TODO-NATIVE-PRESENCE-TYPE: nil?/some? needs one closed nil alternative")

      :else
      (let [(true-id core/NativeId) (state-id state owner "presence-true")
            (false-id core/NativeId) (state-id state owner "presence-false")
            (join-id core/NativeId) (state-id state owner "presence-join")
            (join-parameter core/NativeId)
            (state-id state owner "presence-value")
            (true-value core/NativeId) (state-id state owner "presence-yes")
            (false-value core/NativeId) (state-id state owner "presence-no")
            (cases (Vec core/SwitchCaseV0))
            (mapv
              (fn [(variant core/TypeVariant)] core/SwitchCaseV0
                (let [(present Bool) (not (nil-variant? variant))]
                  (core/->SwitchCaseV0 (core/typevariant-id variant)
                    (if (= present want-present) true-id false-id) [])))
              variants)
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (true-block BodyStateV0)
            (state-close
              (state-emit (state-open-block switched true-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            (false-block BodyStateV0)
            (state-close
              (state-emit (state-open-block true-block false-id [])
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (->ExprResultV0
          (state-open-block false-block join-id
            [(core/->Parameter join-parameter (bool-type-id))])
          join-parameter (bool-type-id) false)))))

(defn lower-truthy-with-budget
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (budget Int)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (cond
      (same-id? value-type (bool-type-id))
      (->ExprResultV0 state value-id (bool-type-id) false)

      (same-id? value-type (type-id "Nil"))
      (bool-constant-result state owner "truthy-nil" false)

      (= 0 (count variants))
      (bool-constant-result state owner "truthy-value" true)

      (< budget 0)
      (fail-result state
        "TODO-NATIVE-TRUTHY-DEPTH: closed-union truthiness nested past the v0 budget")

      :else
      (let [(true-id core/NativeId) (state-id state owner "truthy-true")
            (false-id core/NativeId) (state-id state owner "truthy-false")
            (join-id core/NativeId) (state-id state owner "truthy-join")
            (join-parameter core/NativeId)
            (state-id state owner "truthy-result")
            (cases (Vec core/SwitchCaseV0))
            (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
              (if (>= position (count variants))
                collected
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)
                      (target core/NativeId)
                      (if (nil-variant? variant)
                        false-id
                        (if (nil? payload)
                          true-id
                          (if (or (same-id? payload (bool-type-id))
                                (> (count (union-variants-of types payload)) 0))
                            (state-id state owner
                              (str "truthy-arm-" position))
                            true-id)))]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id variant) target []))))))
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (armed BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (or (nil? payload)
                        (nil-variant? variant)
                        (and (not (same-id? payload (bool-type-id)))
                          (= 0 (count (union-variants-of types payload)))))
                    (recur (+ position 1) current)
                    (let [(arm-id core/NativeId)
                          (state-id state owner (str "truthy-arm-" position))
                          (opened BodyStateV0) (state-open-block current arm-id [])
                          (extracted-id core/NativeId)
                          (state-id opened owner (str "truthy-payload-" position))
                          (extracted BodyStateV0)
                          (state-emit (state-bump opened)
                            (core/->UnionExtractInstruction
                              (core/->SsaValueV0 extracted-id payload)
                              value-id (core/typevariant-id variant)))
                          (truthy ExprResultV0)
                          (lower-truthy-with-budget types owner extracted
                            extracted-id payload (- budget 1))]
                      (if (state-blocked? (exprresultv0-state truthy))
                        (exprresultv0-state truthy)
                        (recur (+ position 1)
                          (state-close (exprresultv0-state truthy)
                            (core/->JumpTerminator join-id
                              [(exprresultv0-value-id truthy)])))))))))
            (true-value core/NativeId) (state-id armed owner "truthy-yes")
            (true-block BodyStateV0)
            (state-close
              (state-emit (state-bump (state-open-block armed true-id []))
                (core/->AtomInstruction
                  (core/->SsaValueV0 true-value (bool-type-id))
                  (core/->BoolAtom true)))
              (core/->JumpTerminator join-id [true-value]))
            (false-value core/NativeId) (state-id true-block owner "truthy-no")
            (false-block BodyStateV0)
            (state-close
              (state-emit (state-bump (state-open-block true-block false-id []))
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-value (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->JumpTerminator join-id [false-value]))]
        (if (state-blocked? false-block)
          (dead-result false-block)
          (->ExprResultV0
            (state-open-block false-block join-id
              [(core/->Parameter join-parameter (bool-type-id))])
            join-parameter (bool-type-id) false))))))

(defn lower-truthy
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (lower-truthy-with-budget types owner state value-id value-type (widen-budget)))

(defn lower-text-index
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (source-id core/NativeId)
   (needle-id core/NativeId)]
  ExprResultV0
  (let [(optional (U core/NativeId Nil))
        (optional-scalar-type-of types (int-type-id))]
    (if (nil? optional)
      (fail-result state
        "TODO-NATIVE-TEXT-INDEX-TYPE: the source program declares no nullable Int")
      (let [(result-id core/NativeId) (state-id state owner "text-index")]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->TextIndexOfInstruction
              (core/->SsaValueV0 result-id optional) source-id needle-id))
          result-id optional false)))))

(defn lower-text-ends-with
  [(owner core/NativeId)
   (state BodyStateV0)
   (source-id core/NativeId)
   (suffix-id core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "text-ends-with")]
    (->ExprResultV0
      (state-emit (state-bump state)
        (core/->TextBuiltinInstruction
          (core/->SsaValueV0 result-id (bool-type-id))
          (core/->TextEndsWithV0 source-id suffix-id)))
      result-id (bool-type-id) false)))

(defn lower-positive
  [(types (Vec core/TypeDef))
   (state BodyStateV0)
   (owner core/NativeId)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(value ExprResultV0)
        (lower-boundary-coerce types owner state value-id value-type (int-type-id))]
    (if (state-blocked? (exprresultv0-state value))
      (dead-result (exprresultv0-state value))
      (let [(base BodyStateV0) (exprresultv0-state value)
            (zero-id core/NativeId) (state-id base owner "positive-zero")
            (result-id core/NativeId) (state-id (state-bump base) owner "positive")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump base))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (core/->CompareLtI64V0 true)
              zero-id (exprresultv0-value-id value)))
          result-id (bool-type-id) false)))))

(defn lower-negative
  [(types (Vec core/TypeDef))
   (state BodyStateV0)
   (owner core/NativeId)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(value ExprResultV0)
        (lower-boundary-coerce types owner state value-id value-type (int-type-id))]
    (if (state-blocked? (exprresultv0-state value))
      (dead-result (exprresultv0-state value))
      (let [(base BodyStateV0) (exprresultv0-state value)
            (zero-id core/NativeId) (state-id base owner "negative-zero")
            (result-id core/NativeId) (state-id (state-bump base) owner "negative")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump base))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (core/->CompareLtI64V0 true)
              (exprresultv0-value-id value) zero-id))
          result-id (bool-type-id) false)))))

(defn lower-zero
  [(state BodyStateV0)
   (owner core/NativeId)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (if (not (same-id? value-type (int-type-id)))
    (fail-result state "TODO-NATIVE-ZERO-OPERAND: zero? needs a native Int")
    (let [(zero-id core/NativeId) (state-id state owner "zero-value")
          (result-id core/NativeId) (state-id (state-bump state) owner "zero")]
      (->ExprResultV0
        (state-emit
          (state-emit (state-bump (state-bump state))
            (core/->AtomInstruction
              (core/->SsaValueV0 zero-id (int-type-id))
              (core/->I64Atom 0)))
          (core/->CompareInstruction
            (core/->SsaValueV0 result-id (bool-type-id))
            (core/->CompareEqI64V0 true) value-id zero-id))
        result-id (bool-type-id) false))))

(defn lower-int-to-float
  [(state BodyStateV0)
   (owner core/NativeId)
   (source-id core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "double-int")]
    (->ExprResultV0
      (state-emit (state-bump state)
        (core/->I64ToF64InstructionV0
          (core/->SsaValueV0 result-id (float-type-id)) source-id))
      result-id (float-type-id) false)))

(defn lower-float-to-int
  [(state BodyStateV0)
   (owner core/NativeId)
   (source-id core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "long-float")]
    (->ExprResultV0
      (state-emit (state-bump state)
        (core/->F64ToI64InstructionV0
          (core/->SsaValueV0 result-id (int-type-id)) source-id))
      result-id (int-type-id) false)))

(defn double-payload-id? [(payload core/NativeId)] Bool
  (or (same-id? payload (int-type-id))
      (same-id? payload (float-type-id))))

(defn double-payload? [(payload (U core/NativeId Nil))] Bool
  (if (nil? payload)
    false
    (double-payload-id? payload)))

(defn double-union-has-numeric? [(variants (Vec core/TypeVariant))] Bool
  (loop [(position Int) 0]
    (if (>= position (count variants))
      false
      (if (double-payload? (core/typevariant-payload-type (nth variants position)))
        true
        (recur (+ position 1))))))

(defn double-union-has-invalid? [(variants (Vec core/TypeVariant))] Bool
  (loop [(position Int) 0]
    (if (>= position (count variants))
      false
      (if (double-payload? (core/typevariant-payload-type (nth variants position)))
        (recur (+ position 1))
        true))))

;; `double` accepts the closed numeric alternatives of Any. Other runtime tags
;; take the same fail-closed boundary as an invalid JVM numeric cast.
(defn lower-double-union
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (if (not (double-union-has-numeric? variants))
      (fail-result state
        "TODO-NATIVE-DOUBLE-OPERAND: double needs a closed Int or Float alternative")
      (let [(failure-id core/NativeId) (state-id state owner "double-invalid")
            (join-id core/NativeId) (state-id state owner "double-join")
            (join-value core/NativeId) (state-id state owner "double-value")
            (cases (Vec core/SwitchCaseV0))
            (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
              (if (>= position (count variants))
                collected
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0 (core/typevariant-id variant)
                        (if (double-payload? payload)
                          (state-id state owner (str "double-arm-" position))
                          failure-id)
                        []))))))
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator value-id cases))
            (converted BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (nil? payload)
                    (recur (+ position 1) current)
                    (if (not (double-payload-id? payload))
                      (recur (+ position 1) current)
                      (let [(arm-id core/NativeId)
                            (state-id state owner (str "double-arm-" position))
                            (opened BodyStateV0) (state-open-block current arm-id [])
                            (extracted-id core/NativeId)
                            (state-id opened owner (str "double-payload-" position))
                            (extracted BodyStateV0)
                            (state-emit (state-bump opened)
                              (core/->UnionExtractInstruction
                                (core/->SsaValueV0 extracted-id payload)
                                value-id (core/typevariant-id variant)))
                            (value ExprResultV0)
                            (if (same-id? payload (int-type-id))
                              (lower-int-to-float extracted owner extracted-id)
                              (->ExprResultV0 extracted extracted-id
                                (float-type-id) false))]
                        (recur (+ position 1)
                          (state-close (exprresultv0-state value)
                            (core/->JumpTerminator join-id
                              [(exprresultv0-value-id value)])))))))))
            (settled BodyStateV0)
            (if (not (double-union-has-invalid? variants))
              converted
              (let [(opened BodyStateV0)
                    (state-open-block converted failure-id [])
                    (code-id core/NativeId) (state-id opened owner "double-trap")
                    (emitted BodyStateV0)
                    (state-emit (state-bump opened)
                      (core/->AtomInstruction
                        (core/->SsaValueV0 code-id (int-type-id))
                        (core/->I64Atom (trap-failure-code))))]
                (state-close emitted (core/->TrapTerminator code-id))))]
        (if (state-blocked? settled)
          (dead-result settled)
          (->ExprResultV0
            (state-open-block settled join-id
              [(core/->Parameter join-value (float-type-id))])
            join-value (float-type-id) false))))))

(defn lower-double
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (cond
    (same-id? value-type (float-type-id))
    (->ExprResultV0 state value-id (float-type-id) false)

    (same-id? value-type (int-type-id))
    (lower-int-to-float state owner value-id)

    (> (count (union-variants-of types value-type)) 0)
    (lower-double-union types owner state value-id value-type)

    :else
    (fail-result state
      "TODO-NATIVE-DOUBLE-OPERAND: double takes one closed Int or Float value")))

(defn int-value-types? [(value-types (Vec core/NativeId))] Bool
  (every?
    (fn [(value-type core/NativeId)] Bool
      (same-id? value-type (int-type-id)))
    value-types))

(defn lower-int-extreme-pair
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (left-id core/NativeId)
   (right-id core/NativeId)]
  ExprResultV0
  (let [(compare-id core/NativeId)
        (state-id state owner (str callee "-compare"))
        (true-id core/NativeId)
        (state-id (state-bump state) owner (str callee "-true"))
        (false-id core/NativeId)
        (state-id (state-bump (state-bump state)) owner (str callee "-false"))
        (join-id core/NativeId)
        (state-id (state-bump (state-bump (state-bump state)))
          owner (str callee "-join"))
        (join-value core/NativeId)
        (state-id
          (state-bump (state-bump (state-bump (state-bump state))))
          owner (str callee "-value"))
        (true-value core/NativeId) (if (= "min" callee) left-id right-id)
        (false-value core/NativeId) (if (= "min" callee) right-id left-id)
        (compared BodyStateV0)
        (state-emit
          (state-bump (state-bump (state-bump (state-bump (state-bump state)))))
          (core/->CompareInstruction
            (core/->SsaValueV0 compare-id (bool-type-id))
            (core/->CompareLeI64V0 true) left-id right-id))
        (branched BodyStateV0)
        (state-close compared
          (core/->BranchTerminator compare-id true-id false-id))
        (true-block BodyStateV0)
        (state-close (state-open-block branched true-id [])
          (core/->JumpTerminator join-id [true-value]))
        (false-block BodyStateV0)
        (state-close (state-open-block true-block false-id [])
          (core/->JumpTerminator join-id [false-value]))]
    (->ExprResultV0
      (state-open-block false-block join-id
        [(core/->Parameter join-value (int-type-id))])
      join-value (int-type-id) false)))

(defn lower-int-extreme
  [(state BodyStateV0)
   (owner core/NativeId)
   (callee String)
   (values (Vec core/NativeId))]
  ExprResultV0
  (loop [(position Int) 1
         (current BodyStateV0) state
         (selected core/NativeId) (nth values 0)]
    (if (>= position (count values))
      (->ExprResultV0 current selected (int-type-id) false)
      (let [(pair ExprResultV0)
            (lower-int-extreme-pair current owner callee selected
              (nth values position))]
        (recur (+ position 1)
          (exprresultv0-state pair)
          (exprresultv0-value-id pair))))))

(defn equality-comparison
  [(type-id-value core/NativeId)] (U core/CompareOpV0 Nil)
  (cond
    (same-id? type-id-value (int-type-id)) (core/->CompareEqI64V0 true)
    (same-id? type-id-value (float-type-id)) (core/->CompareEqF64V0 true)
    (same-id? type-id-value (keyword-type-id)) (core/->CompareEqTextV0 true)
    (same-id? type-id-value (bool-type-id)) (core/->CompareEqBoolV0 true)
    (same-id? type-id-value (text-type-id)) (core/->CompareEqTextV0 true)
    :else nil))

;; Equality is total across a scalar and a union: another tag is false, while
;; the matching tag is extracted and compared with its scalar semantics.
(defn lower-scalar-union-equality-with-budget
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (scalar-id core/NativeId)
   (scalar-type core/NativeId)
   (union-id core/NativeId)
   (union-type core/NativeId)
   (budget Int)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types union-type)
        (path VariantPathV0)
        (variant-path-to-payload-with-budget types union-type scalar-type budget)
        (comparison (U core/CompareOpV0 Nil)) (equality-comparison scalar-type)]
    (cond
      (nil? comparison)
      (fail-result state
        "TODO-NATIVE-EQUALITY-SCALAR: the scalar has no native equality")

      (= 0 (variantpathv0-matches path))
      (bool-constant-result state owner "equality-miss" false)

      (< budget 0)
      (fail-result state
        "TODO-NATIVE-EQUALITY-DEPTH: scalar equality nested past the v0 budget")

      :else
      (let [(miss-id core/NativeId) (state-id state owner "equality-miss")
            (join-id core/NativeId) (state-id state owner "equality-join")
            (join-parameter core/NativeId) (state-id state owner "equality-value")
            (false-id core/NativeId) (state-id state owner "equality-false")
            (cases (Vec core/SwitchCaseV0))
            (loop [(position Int) 0 (collected (Vec core/SwitchCaseV0)) []]
              (if (>= position (count variants))
                collected
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)
                      (nested VariantPathV0)
                      (if (nil? payload)
                        (->VariantPathV0 0 [])
                        (variant-path-to-payload-with-budget types payload
                          scalar-type (- budget 1)))
                      (target core/NativeId)
                      (if (> (variantpathv0-matches nested) 0)
                        (state-id state owner (str "equality-arm-" position))
                        miss-id)]
                  (recur (+ position 1)
                    (conj collected
                      (core/->SwitchCaseV0
                        (core/typevariant-id variant) target []))))))
            (switched BodyStateV0)
            (state-close (state-bump state)
              (core/->SwitchTerminator union-id cases))
            (armed BodyStateV0)
            (loop [(position Int) 0 (current BodyStateV0) switched]
              (if (or (>= position (count variants)) (state-blocked? current))
                current
                (let [(variant core/TypeVariant) (nth variants position)
                      (payload (U core/NativeId Nil))
                      (core/typevariant-payload-type variant)]
                  (if (nil? payload)
                    (recur (+ position 1) current)
                    (let [(nested VariantPathV0)
                          (variant-path-to-payload-with-budget types payload
                            scalar-type (- budget 1))]
                      (if (= 0 (variantpathv0-matches nested))
                        (recur (+ position 1) current)
                        (let [(arm-id core/NativeId)
                              (state-id state owner (str "equality-arm-" position))
                              (opened BodyStateV0) (state-open-block current arm-id [])
                              (extracted-id core/NativeId)
                              (state-id opened owner
                                (str "equality-payload-" position))
                              (extracted BodyStateV0)
                              (state-emit (state-bump opened)
                                (core/->UnionExtractInstruction
                                  (core/->SsaValueV0 extracted-id payload)
                                  union-id (core/typevariant-id variant)))
                              (result ExprResultV0)
                              (if (same-id? payload scalar-type)
                                (let [(compared-id core/NativeId)
                                      (state-id extracted owner
                                        (str "equality-compared-" position))]
                                  (->ExprResultV0
                                    (state-emit (state-bump extracted)
                                      (core/->CompareInstruction
                                        (core/->SsaValueV0 compared-id
                                          (bool-type-id))
                                        comparison scalar-id extracted-id))
                                    compared-id (bool-type-id) false))
                                (lower-scalar-union-equality-with-budget types owner
                                  extracted scalar-id scalar-type extracted-id payload
                                  (- budget 1)))]
                          (if (state-blocked? (exprresultv0-state result))
                            (exprresultv0-state result)
                            (recur (+ position 1)
                              (state-close (exprresultv0-state result)
                                (core/->JumpTerminator join-id
                                  [(exprresultv0-value-id result)])))))))))))]
        (if (state-blocked? armed)
          (dead-result armed)
          (let [(missed BodyStateV0)
                (state-emit (state-open-block armed miss-id [])
                  (core/->AtomInstruction
                    (core/->SsaValueV0 false-id (bool-type-id))
                    (core/->BoolAtom false)))
                (after-miss BodyStateV0)
                (state-close missed (core/->JumpTerminator join-id [false-id]))]
            (->ExprResultV0
              (state-open-block after-miss join-id
                [(core/->Parameter join-parameter (bool-type-id))])
              join-parameter (bool-type-id) false)))))))

(defn lower-scalar-union-equality
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (scalar-id core/NativeId)
   (scalar-type core/NativeId)
   (union-id core/NativeId)
   (union-type core/NativeId)]
  ExprResultV0
  (let [(status ValueSemanticsStatusV0)
        (value-semantics-status types union-type)]
    (cond
      (not (valuesemanticsstatusv0-admitted status))
      (fail-result state
        "TODO-NATIVE-EQUALITY-UNION-VALUE-SEMANTICS: equality union contains a value without structural semantics")

      (and (= "dynamic" (valuesemanticsstatusv0-reason status))
        (or (some? (equality-comparison scalar-type))
          (value-semantics-type? types scalar-type)))
      (let [(widened ExprResultV0)
            (lower-boundary-coerce types owner state scalar-id scalar-type
              union-type)
            (current BodyStateV0) (exprresultv0-state widened)]
        (if (state-blocked? current)
          (dead-result current)
          (let [(result-id core/NativeId)
                (state-id current owner "dynamic-union-equal")]
            (->ExprResultV0
              (state-emit (state-bump current)
                (core/->ValueSemanticsInstruction
                  (core/->SsaValueV0 result-id (bool-type-id))
                  (value-equal-operation union-type
                    (exprresultv0-value-id widened) union-id true)))
              result-id (bool-type-id) false))))

      :else
      (lower-scalar-union-equality-with-budget types owner state scalar-id
        scalar-type union-id union-type (widen-budget)))))

(defn lower-scalar-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (lower-scalar-predicate-with-budget types owner state callee value-id
    value-type (widen-budget)))

(defn lower-text-search-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (source-id core/NativeId)
   (needle-id core/NativeId)]
  ExprResultV0
  (let [(found ExprResultV0)
        (lower-text-index types owner state source-id needle-id)
        (current BodyStateV0) (exprresultv0-state found)]
    (cond
      (state-blocked? current) (dead-result current)
      (= "str/includes?" callee)
      (lower-presence-predicate types owner current
        (exprresultv0-value-id found) (exprresultv0-type-id found) true)
      :else
      (let [(zero-id core/NativeId) (state-id current owner "text-index-zero")
            (with-zero BodyStateV0)
            (state-emit (state-bump current)
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))]
        (lower-scalar-union-equality types owner with-zero zero-id
          (int-type-id) (exprresultv0-value-id found)
          (exprresultv0-type-id found))))))

(defn lower-ordered-union-comparison
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (let [(left-union Bool)
        (> (count (union-variants-of types (nth value-types 0))) 0)
        (scalar-position Int) (if left-union 1 0)
        (union-position Int) (if left-union 0 1)
        (scalar-type core/NativeId) (nth value-types scalar-position)
        (extracted ExprResultV0)
        (lower-boundary-coerce types owner state
          (nth values union-position) (nth value-types union-position) scalar-type)
        (settled BodyStateV0) (exprresultv0-state extracted)
        (ordered-values (Vec core/NativeId))
        (if left-union
          [(exprresultv0-value-id extracted) (nth values 1)]
          [(nth values 0) (exprresultv0-value-id extracted)])
        (comparison (U core/CompareOpV0 Nil)) (compare-op-for callee)
        (swap Bool) (compare-swaps? callee)
        (result-id core/NativeId) (state-id settled owner "ordered-compare")]
    (cond
      (state-blocked? settled) (dead-result settled)
      (or (nil? comparison) (not (same-id? scalar-type (int-type-id))))
      (fail-result settled
        "TODO-NATIVE-ORDERED-UNION: ordered comparison needs an Int alternative")
      :else
      (->ExprResultV0
        (state-emit (state-bump settled)
          (core/->CompareInstruction
            (core/->SsaValueV0 result-id (bool-type-id))
            comparison
            (nth ordered-values (if swap 1 0))
            (nth ordered-values (if swap 0 1))))
        result-id (bool-type-id) false))))

(defn type-widens-to?
  [(types (Vec core/TypeDef))
   (from core/NativeId)
   (to core/NativeId)
   (budget Int)]
  Bool
  (cond
    (same-id? from to) true
    (< budget 0) false
    :else
    (let [(targets (Vec core/TypeVariant)) (union-variants-of types to)
          (sources (Vec core/TypeVariant)) (union-variants-of types from)
          (nested-target VariantPathV0)
          (variant-path-to-payload-with-budget types to from budget)]
      (cond
        (= 0 (count targets)) false
        (some? (variant-for-payload targets from)) true
        (some? (variant-for-record-reference types targets from)) true
        (same-id? from (type-id "Nil"))
        (some? (some nil-variant? targets))
        (and (= 1 (variantpathv0-matches nested-target))
          (> (count (variantpathv0-variants nested-target)) 0)) true
        (= 0 (count sources)) false
        :else
        (every?
          (fn [(variant core/TypeVariant)] Bool
            (let [(payload (U core/NativeId Nil))
                  (core/typevariant-payload-type variant)]
              (if (or (nil? payload) (same-id? payload (type-id "Nil")))
                (some? (some nil-variant? targets))
                (type-widens-to? types payload to (- budget 1)))))
          sources)))))

(defn values-widen-to?
  [(types (Vec core/TypeDef))
   (value-types (Vec core/NativeId))
   (target core/NativeId)]
  Bool
  (loop [(position Int) 0]
    (if (>= position (count value-types))
      true
      (if (type-widens-to? types (nth value-types position) target
            (widen-budget))
        (recur (+ position 1))
        false))))

;; A heterogeneous map literal has no intrinsic value type. Close it only when
;; one declared map union is the unique narrowest carrier of every value.
(defn map-type-for-widened-values
  [(types (Vec core/TypeDef))
   (key-type core/NativeId)
   (value-types (Vec core/NativeId))]
  (U core/NativeId Nil)
  (loop [(position Int) 0
         (chosen (U core/NativeId Nil)) nil
         (chosen-width Int) 2147483647
         (ambiguous Bool) false]
    (if (>= position (count types))
      (if ambiguous nil chosen)
      (let [(definition core/TypeDef) (nth types position)
            (shape core/TypeShape) (core/typedef-shape definition)]
        (if (not (instance? native.core.MapTypeV0 shape))
          (recur (+ position 1) chosen chosen-width ambiguous)
          (let [(candidate core/NativeId) (core/typedef-id definition)
                (candidate-key core/NativeId) (core/maptypev0-key-type shape)
                (candidate-value core/NativeId) (core/maptypev0-value-type shape)
                (width Int) (count (union-variants-of types candidate-value))
                (carries Bool)
                (and (same-id? candidate-key key-type)
                  (> width 0)
                  (values-widen-to? types value-types candidate-value))]
            (cond
              (not carries)
              (recur (+ position 1) chosen chosen-width ambiguous)

              (< width chosen-width)
              (recur (+ position 1) candidate width false)

              (and (= width chosen-width) (some? chosen)
                (not (same-id? candidate chosen)))
              (recur (+ position 1) chosen chosen-width true)

              :else
              (recur (+ position 1) chosen chosen-width ambiguous))))))))

(defn lower-vector-to-set
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (source-id core/NativeId)
   (vector-type core/NativeId)]
  ExprResultV0
  (let [(element-type core/NativeId) (vector-element-of types vector-type)
        (set-type (U core/NativeId Nil)) (set-type-of types element-type)
        (equality (U core/ConcreteEqualityV0 Nil))
        (set-element-equality-for types element-type)]
    (cond
      (nil? set-type)
      (fail-result state
        "TODO-NATIVE-SET-VECTOR-TYPE: the program declares no set of the vector element type")

      (nil? equality)
      (fail-result state
        "TODO-NATIVE-SET-ELEMENT-EQUALITY: set needs closed concrete element equality")

      :else
      (let [(length-id core/NativeId)
            (state-id state owner "set-from-vector-length")
            (with-length BodyStateV0)
            (state-emit (state-bump state)
              (core/->VecLengthInstruction
                (core/->SsaValueV0 length-id (int-type-id)) source-id))
            (zero-id core/NativeId)
            (state-id with-length owner "set-from-vector-zero")
            (with-zero BodyStateV0)
            (state-emit (state-bump with-length)
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (empty-id core/NativeId)
            (state-id with-zero owner "set-from-vector-empty")
            (prepared BodyStateV0)
            (state-emit (state-bump with-zero)
              (core/->SetLiteralInstructionV0
                (core/->SsaValueV0 empty-id set-type)
                [] (arena-value-id owner) equality))
            (header-id core/NativeId)
            (state-id prepared owner "set-from-vector-header")
            (body-id core/NativeId)
            (state-id prepared owner "set-from-vector-body")
            (exit-id core/NativeId)
            (state-id prepared owner "set-from-vector-exit")
            (header-index core/NativeId)
            (state-id prepared owner "set-from-vector-index")
            (header-set core/NativeId)
            (state-id prepared owner "set-from-vector-set")
            (entered BodyStateV0)
            (state-open-block
              (state-close (state-bump prepared)
                (core/->JumpTerminator header-id [zero-id empty-id]))
              header-id
              [(core/->Parameter header-index (int-type-id))
               (core/->Parameter header-set set-type)])
            (has-item core/NativeId)
            (state-id entered owner "set-from-vector-has-item")
            (compared BodyStateV0)
            (state-emit (state-bump entered)
              (core/->CompareInstruction
                (core/->SsaValueV0 has-item (bool-type-id))
                (core/->CompareLtI64V0 true) header-index length-id))
            (body-state BodyStateV0)
            (state-open-block
              (state-close compared
                (core/->BranchTerminator has-item body-id exit-id))
              body-id [])
            (item-id core/NativeId)
            (state-id body-state owner "set-from-vector-item")
            (with-item BodyStateV0)
            (state-emit (state-bump body-state)
              (core/->VecGetInstruction
                (core/->SsaValueV0 item-id element-type)
                source-id header-index))
            (next-set core/NativeId)
            (state-id with-item owner "set-from-vector-conj")
            (with-set BodyStateV0)
            (state-emit (state-bump with-item)
              (core/->SetConjInstructionV0
                (core/->SsaValueV0 next-set set-type)
                header-set item-id (arena-value-id owner) equality))
            (one-id core/NativeId)
            (state-id with-set owner "set-from-vector-one")
            (with-one BodyStateV0)
            (state-emit (state-bump with-set)
              (core/->AtomInstruction
                (core/->SsaValueV0 one-id (int-type-id))
                (core/->I64Atom 1)))
            (next-index ExprResultV0)
            (lower-checked-arith with-one owner "+" header-index one-id)
            (settled BodyStateV0) (exprresultv0-state next-index)]
        (if (state-blocked? settled)
          (dead-result settled)
          (->ExprResultV0
            (state-open-block
              (state-close settled
                (core/->JumpTerminator header-id
                  [(exprresultv0-value-id next-index) next-set]))
              exit-id [])
            header-set set-type false))))))

(defn lower-set-equality
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (left-id core/NativeId)
   (right-id core/NativeId)
   (set-type core/NativeId)]
  ExprResultV0
  (let [(element-type core/NativeId) (set-element-of types set-type)
        (vector-type (U core/NativeId Nil))
        (vector-type-of types element-type)
        (equality (U core/ConcreteEqualityV0 Nil))
        (set-element-equality-for types element-type)]
    (cond
      (nil? vector-type)
      (fail-result state
        "TODO-NATIVE-SET-EQUALITY-TYPE: the program declares no vector of the set element type")

      (nil? equality)
      (fail-result state
        "TODO-NATIVE-SET-EQUALITY: set equality needs closed concrete element equality")

      :else
      (let [(left-count core/NativeId)
            (state-id state owner "set-equal-left-count")
            (with-left-count BodyStateV0)
            (state-emit (state-bump state)
              (core/->SetCountInstructionV0
                (core/->SsaValueV0 left-count (int-type-id)) left-id))
            (right-count core/NativeId)
            (state-id with-left-count owner "set-equal-right-count")
            (with-counts BodyStateV0)
            (state-emit (state-bump with-left-count)
              (core/->SetCountInstructionV0
                (core/->SsaValueV0 right-count (int-type-id)) right-id))
            (same-count core/NativeId)
            (state-id with-counts owner "set-equal-same-count")
            (with-comparison BodyStateV0)
            (state-emit (state-bump with-counts)
              (core/->CompareInstruction
                (core/->SsaValueV0 same-count (bool-type-id))
                (core/->CompareEqI64V0 true) left-count right-count))
            (left-vector core/NativeId)
            (state-id with-comparison owner "set-equal-vector")
            (with-vector BodyStateV0)
            (state-emit (state-bump with-comparison)
              (core/->SetVectorInstructionV0
                (core/->SsaValueV0 left-vector vector-type)
                left-id (arena-value-id owner)))
            (zero-id core/NativeId)
            (state-id with-vector owner "set-equal-zero")
            (prepared BodyStateV0)
            (state-emit (state-bump with-vector)
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (header-id core/NativeId)
            (state-id prepared owner "set-equal-header")
            (check-id core/NativeId)
            (state-id prepared owner "set-equal-check")
            (body-id core/NativeId)
            (state-id prepared owner "set-equal-body")
            (advance-id core/NativeId)
            (state-id prepared owner "set-equal-advance")
            (false-id core/NativeId)
            (state-id prepared owner "set-equal-false")
            (true-id core/NativeId)
            (state-id prepared owner "set-equal-true")
            (join-id core/NativeId)
            (state-id prepared owner "set-equal-join")
            (join-value core/NativeId)
            (state-id prepared owner "set-equal-value")
            (header-index core/NativeId)
            (state-id prepared owner "set-equal-index")
            (entered BodyStateV0)
            (state-open-block
              (state-close (state-bump prepared)
                (core/->JumpTerminator header-id [zero-id]))
              header-id
              [(core/->Parameter header-index (int-type-id))])
            (has-item core/NativeId)
            (state-id entered owner "set-equal-has-item")
            (compared BodyStateV0)
            (state-emit (state-bump entered)
              (core/->CompareInstruction
                (core/->SsaValueV0 has-item (bool-type-id))
                (core/->CompareLtI64V0 true) header-index left-count))
            (checked BodyStateV0)
            (state-open-block
              (state-close compared
                (core/->BranchTerminator same-count check-id false-id))
              check-id [])
            (body-state BodyStateV0)
            (state-open-block
              (state-close checked
                (core/->BranchTerminator has-item body-id true-id))
              body-id [])
            (item-id core/NativeId)
            (state-id body-state owner "set-equal-item")
            (with-item BodyStateV0)
            (state-emit (state-bump body-state)
              (core/->VecGetInstruction
                (core/->SsaValueV0 item-id element-type)
                left-vector header-index))
            (present-id core/NativeId)
            (state-id with-item owner "set-equal-present")
            (with-present BodyStateV0)
            (state-emit (state-bump with-item)
              (core/->SetContainsInstructionV0
                (core/->SsaValueV0 present-id (bool-type-id))
                right-id item-id equality))
            (advance BodyStateV0)
            (state-open-block
              (state-close with-present
                (core/->BranchTerminator present-id advance-id false-id))
              advance-id [])
            (one-id core/NativeId)
            (state-id advance owner "set-equal-one")
            (with-one BodyStateV0)
            (state-emit (state-bump advance)
              (core/->AtomInstruction
                (core/->SsaValueV0 one-id (int-type-id))
                (core/->I64Atom 1)))
            (next-index ExprResultV0)
            (lower-checked-arith with-one owner "+" header-index one-id)
            (looped BodyStateV0) (exprresultv0-state next-index)]
        (if (state-blocked? looped)
          (dead-result looped)
          (let [(false-value core/NativeId)
                (state-id looped owner "set-equal-no")
                (false-block BodyStateV0)
                (state-close
                  (state-emit
                    (state-open-block
                      (state-close looped
                        (core/->JumpTerminator header-id
                          [(exprresultv0-value-id next-index)]))
                      false-id [])
                    (core/->AtomInstruction
                      (core/->SsaValueV0 false-value (bool-type-id))
                      (core/->BoolAtom false)))
                  (core/->JumpTerminator join-id [false-value]))
                (true-value core/NativeId)
                (state-id false-block owner "set-equal-yes")
                (true-block BodyStateV0)
                (state-close
                  (state-emit (state-open-block false-block true-id [])
                    (core/->AtomInstruction
                      (core/->SsaValueV0 true-value (bool-type-id))
                      (core/->BoolAtom true)))
                  (core/->JumpTerminator join-id [true-value]))]
            (->ExprResultV0
              (state-open-block true-block join-id
                [(core/->Parameter join-value (bool-type-id))])
              join-value (bool-type-id) false)))))))

(defn strict-widen-subtype?
  [(types (Vec core/TypeDef))
   (narrower core/NativeId)
   (wider core/NativeId)]
  Bool
  (and (type-widens-to? types narrower wider (widen-budget))
    (not (type-widens-to? types wider narrower (widen-budget)))))

(defn join-candidate-dominated?
  [(types (Vec core/TypeDef))
   (candidate core/NativeId)
   (minima (Vec core/NativeId))]
  Bool
  (loop [(position Int) 0]
    (if (>= position (count minima))
      false
      (if (strict-widen-subtype? types (nth minima position) candidate)
        true
        (recur (+ position 1))))))

(defn remove-dominated-join-candidates
  [(types (Vec core/TypeDef))
   (candidate core/NativeId)
   (minima (Vec core/NativeId))]
  (Vec core/NativeId)
  (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
    (if (>= position (count minima))
      collected
      (let [(current core/NativeId) (nth minima position)]
        (recur (+ position 1)
          (if (strict-widen-subtype? types candidate current)
            collected
            (conj collected current)))))))

(defn join-type-for
  [(types (Vec core/TypeDef))
   (left core/NativeId)
   (right core/NativeId)]
  (U core/NativeId Nil)
  (if (same-id? left right)
    left
    (loop [(position Int) 0
           (minima (Vec core/NativeId)) []]
      (if (>= position (count types))
        (if (= 1 (count minima)) (nth minima 0) nil)
        (let [(candidate core/NativeId) (core/typedef-id (nth types position))
              (variants (Vec core/TypeVariant)) (union-variants-of types candidate)
              (common Bool)
              (and (> (count variants) 0)
                (type-widens-to? types left candidate (widen-budget))
                (type-widens-to? types right candidate (widen-budget)))]
          (cond
            (or (not common) (core/id-in? minima candidate)
              (join-candidate-dominated? types candidate minima))
            (recur (+ position 1) minima)

            :else
            (recur (+ position 1)
              (conj (remove-dominated-join-candidates types candidate minima)
                candidate))))))))

;; A join with no computable arm type falls back to the declared type the arms
;; are being produced for; a computable join keeps its existing type.
(defn bridge-join-arms
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (left-start Int)
   (left-end Int)
   (right-start Int)
   (right-end Int)
   (join-id core/NativeId)
   (join-parameter core/NativeId)
   (left-type core/NativeId)
   (right-type core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(computed (U core/NativeId Nil)) (join-type-for types left-type right-type)
        (target (U core/NativeId Nil))
        (if (some? computed) computed expected)]
    (if (nil? target)
      (fail-result state
        "TODO-NATIVE-JOIN-TYPE: live arms have no declared native union")
      (let [(left-id core/NativeId) (state-id state owner "join-left-coerce")
            (right-id core/NativeId) (state-id state owner "join-right-coerce")
            (left-value core/NativeId) (state-id state owner "join-left-value")
            (right-value core/NativeId) (state-id state owner "join-right-value")
            (rewired-left BodyStateV0)
            (retarget-jumps-between state left-start left-end join-id left-id)
            (rewired BodyStateV0)
            (retarget-jumps-between rewired-left
              right-start right-end join-id right-id)
            (left-open BodyStateV0)
            (state-open-block rewired left-id
              [(core/->Parameter left-value left-type)])
            (left ExprResultV0)
            (lower-boundary-coerce types owner left-open
              left-value left-type target)]
        (if (state-blocked? (exprresultv0-state left))
          (dead-result (exprresultv0-state left))
          (let [(left-closed BodyStateV0)
                (state-close (exprresultv0-state left)
                  (core/->JumpTerminator join-id
                    [(exprresultv0-value-id left)]))
                (right-open BodyStateV0)
                (state-open-block left-closed right-id
                  [(core/->Parameter right-value right-type)])
                (right ExprResultV0)
                (lower-boundary-coerce types owner right-open
                  right-value right-type target)]
            (if (state-blocked? (exprresultv0-state right))
              (dead-result (exprresultv0-state right))
              (->ExprResultV0
                (state-open-block
                  (state-close (exprresultv0-state right)
                    (core/->JumpTerminator join-id
                      [(exprresultv0-value-id right)]))
                  join-id [(core/->Parameter join-parameter target)])
                join-parameter target false))))))))

(defn logic-result-type
  [(types (Vec core/TypeDef)) (arms (Vec LogicArmV0))] (U core/NativeId Nil)
  (loop [(position Int) 0
         (chosen (U core/NativeId Nil)) nil]
    (if (>= position (count arms))
      chosen
      (let [(arm-type core/NativeId)
            (logicarmv0-type-id (nth arms position))
            (joined (U core/NativeId Nil))
            (if (nil? chosen)
              arm-type
              (join-type-for types chosen arm-type))]
        (if (nil? joined)
          nil
          (recur (+ position 1) joined))))))

(defn bridge-logic-arms
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (arms (Vec LogicArmV0))
   (join-id core/NativeId)
   (join-parameter core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(target (U core/NativeId Nil))
        (if (some? expected) expected (logic-result-type types arms))]
    (if (nil? target)
      (fail-result state
        "TODO-NATIVE-JOIN-TYPE: live arms have no declared native union")
      (loop [(position Int) 0 (current BodyStateV0) state]
        (if (>= position (count arms))
          (->ExprResultV0
            (state-open-block current join-id
              [(core/->Parameter join-parameter target)])
            join-parameter target false)
          (let [(arm LogicArmV0) (nth arms position)
                (arm-type core/NativeId) (logicarmv0-type-id arm)
                (bridge-id core/NativeId)
                (state-id current owner (str "logic-coerce-" position))
                (bridge-value core/NativeId)
                (state-id current owner (str "logic-arm-" position))
                (rewired BodyStateV0)
                (retarget-jumps-between current
                  (logicarmv0-start arm) (logicarmv0-end arm)
                  join-id bridge-id)
                (opened BodyStateV0)
                (state-open-block (state-bump rewired) bridge-id
                  [(core/->Parameter bridge-value arm-type)])
                (coerced ExprResultV0)
                (lower-boundary-coerce types owner opened
                  bridge-value arm-type target)]
            (if (state-blocked? (exprresultv0-state coerced))
              (dead-result (exprresultv0-state coerced))
              (recur (+ position 1)
                (state-close (exprresultv0-state coerced)
                  (core/->JumpTerminator join-id
                    [(exprresultv0-value-id coerced)]))))))))))

(defn finish-flow-logic-join
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (arms (Vec LogicArmV0))
   (join-id core/NativeId)
   (join-parameter core/NativeId)
   (outer-locals (Vec LocalBindingV0))
   (outer-keywords (Vec KeywordFlowRefinementV0))
   (outer-values (Vec ValueFlowRefinementV0))
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(settled BodyStateV0)
        (state-with-flow-context state
          outer-locals outer-keywords outer-values)]
    (cond
      (state-blocked? settled) (dead-result settled)
      (= 0 (count arms))
      (->ExprResultV0 settled (lower-id "body" ["logic-terminated"])
        (type-id "LowerFailure") true)
      :else
      ;; bridge-logic-arms lets a supplied expectation win outright, so the
      ;; declared type is handed over only when the arms alone cannot join.
      (bridge-logic-arms types owner settled arms join-id join-parameter
        (if (nil? (logic-result-type types arms)) expected nil)))))

(defn host-socket-operands-valid?
  [(callee String) (value-types (Vec core/NativeId))] Bool
  (cond
    (or (= callee "host.socket/inherited-listener")
        (= callee "host.socket/accept")
        (= callee "host.socket/close"))
    (and (= 1 (count value-types))
      (same-id? (nth value-types 0) (int-type-id)))

    (= callee "host.socket/read-bounded")
    (and (= 2 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (int-type-id)))

    (= callee "host.socket/write-bounded")
    (and (= 3 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (bytes-type-id))
      (same-id? (nth value-types 2) (int-type-id)))

    :else false))

(defn host-socket-result-type [(callee String)] core/NativeId
  (cond
    (= callee "host.socket/read-bounded") (socket-bytes-outcome-type-id)
    (= callee "host.socket/close") (socket-close-outcome-type-id)
    :else (socket-int-outcome-type-id)))

(defn lower-host-socket-call
  [(owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (host-socket-operands-valid? callee value-types))
    (fail-result state
      (str "TODO-NATIVE-HOST-SOCKET-OPERANDS: " callee
        " needs explicit Int descriptors; read takes a bound and write takes NativeBytes plus a bound"))
    (let [(result-id core/NativeId) (state-id state owner "host-socket")
          (result-type core/NativeId) (host-socket-result-type callee)
          (operation String) (host-socket-operation callee)
          (arena (U core/NativeId Nil))
          (if (= callee "host.socket/read-bounded")
            (arena-value-id owner)
            nil)]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id result-type)
            (host-socket-abi-id operation)
            values
            arena
            (core/->TokenFlowV0 [] [])))
        result-id result-type false))))

(defn host-filesystem-operands-valid?
  [(callee String) (value-types (Vec core/NativeId))] Bool
  (cond
    (or (= callee "host.fs/read-text-bounded")
        (= callee "host.fs/list-directory-bounded"))
    (and (= 2 (count value-types))
      (text-operand? (nth value-types 0))
      (same-id? (nth value-types 1) (int-type-id)))

    (or (= callee "host.fs/path-kind")
        (= callee "host.fs/make-parent-directories")
        (= callee "host.fs/lock-exclusive"))
    (and (= 1 (count value-types))
      (text-operand? (nth value-types 0)))

    (or (= callee "host.fs/write-text-atomic")
        (= callee "host.fs/append-text"))
    (and (= 2 (count value-types))
      (text-operand? (nth value-types 0))
      (text-operand? (nth value-types 1)))

    (= callee "host.fs/unlock")
    (and (= 1 (count value-types))
      (same-id? (nth value-types 0) (int-type-id)))

    :else false))

(defn host-filesystem-result-type [(callee String)] core/NativeId
  (cond
    (= callee "host.fs/read-text-bounded")
    (filesystem-text-outcome-type-id)
    (= callee "host.fs/list-directory-bounded")
    (filesystem-paths-outcome-type-id)
    (or (= callee "host.fs/path-kind")
        (= callee "host.fs/lock-exclusive"))
    (filesystem-int-outcome-type-id)
    :else (filesystem-nil-outcome-type-id)))

(defn lower-host-filesystem-call
  [(owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (host-filesystem-operands-valid? callee value-types))
    (fail-result state
      (str "TODO-NATIVE-HOST-FILESYSTEM-OPERANDS: " callee
        " needs Text paths and payloads; bounded reads and listings also need an Int bound, and unlock needs an Int descriptor"))
    (let [(result-id core/NativeId)
          (state-id state owner "host-filesystem")
          (result-type core/NativeId) (host-filesystem-result-type callee)
          (operation String) (host-filesystem-operation callee)
          (arena (U core/NativeId Nil))
          (if (or (= callee "host.fs/read-text-bounded")
                (= callee "host.fs/list-directory-bounded"))
            (arena-value-id owner)
            nil)]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id result-type)
            (host-filesystem-abi-id operation)
            values
            arena
            (core/->TokenFlowV0 [] [])))
        result-id result-type false))))

(defn lower-host-text-output-call
  [(owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (abi-id core/NativeId)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (and (= 1 (count values))
        (text-operand? (nth value-types 0)))
    (let [(result-id core/NativeId)
          (state-id state owner (str "host-output-" callee))]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id (type-id "Nil"))
            abi-id
            values
            nil
            (core/->TokenFlowV0 [] [])))
        result-id (type-id "Nil") false))
    (fail-result state
      (str "TODO-NATIVE-HOST-OUTPUT-OPERAND: " callee
        " takes one native Text value"))))

(defn lower-host-context-call
  [(owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))]
  ExprResultV0
  (if (not (= 0 (count values)))
    (fail-result state
      (str "TODO-NATIVE-HOST-CONTEXT-OPERANDS: " callee
        " takes no operands"))
    (let [(result-id core/NativeId) (state-id state owner "host-context")
          (hostname Bool) (= callee "host.system/hostname")
          (result-type core/NativeId)
          (cond
            hostname (filesystem-text-outcome-type-id)
            (= callee "host.system/platform") (text-type-id)
            :else (bool-type-id))]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id result-type)
            (host-context-abi-id (host-context-operation callee))
            []
            (if hostname (arena-value-id owner) nil)
            (core/->TokenFlowV0 [] [])))
        result-id result-type false))))

(defn host-process-operands-valid?
  [(types (Vec core/TypeDef))
   (callee String)
   (value-types (Vec core/NativeId))]
  Bool
  (cond
    (or (= callee "host.process/run-inherit")
        (= callee "host.process/spawn-stdout")
        (= callee "host.process/exec-replace"))
    (and (= 1 (count value-types))
      (text-vector-value? types (nth value-types 0)))

    (= callee "host.process/run-capture")
    (and (= 3 (count value-types))
      (text-vector-value? types (nth value-types 0))
      (text-operand? (nth value-types 1))
      (same-id? (nth value-types 2) (int-type-id)))

    (= callee "host.process/read-line-bounded")
    (and (= 2 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (int-type-id)))

    (= callee "host.process/read-line-deadline")
    (and (= 3 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (int-type-id))
      (same-id? (nth value-types 2) (int-type-id)))

    (or (= callee "host.process/fifo-create")
        (= callee "host.process/fifo-open-read"))
    (and (= 1 (count value-types))
      (text-operand? (nth value-types 0)))

    (= callee "host.process/fifo-write-deadline")
    (and (= 3 (count value-types))
      (text-operand? (nth value-types 0))
      (text-operand? (nth value-types 1))
      (same-id? (nth value-types 2) (int-type-id)))

    (= callee "host.process/poll-readable")
    (and (= 2 (count value-types))
      (int-vector-value? types (nth value-types 0))
      (same-id? (nth value-types 1) (int-type-id)))

    (= callee "host.process/current-pid")
    (= 0 (count value-types))

    (= callee "host.process/alive?")
    (and (= 1 (count value-types))
      (same-id? (nth value-types 0) (int-type-id)))

    (or (= callee "host.process/signal")
        (= callee "host.process/wait-not-alive"))
    (and (= 2 (count value-types))
      (same-id? (nth value-types 0) (int-type-id))
      (same-id? (nth value-types 1) (int-type-id)))

    (or (= callee "host.process/wait")
        (= callee "host.process/close"))
    (and (= 1 (count value-types))
      (same-id? (nth value-types 0) (int-type-id)))

    :else false))

(defn host-process-call-result-type [(callee String)] core/NativeId
  (cond
    (= callee "host.process/run-capture")
    (process-capture-outcome-type-id)
    (= callee "host.process/spawn-stdout")
    (process-spawn-stdout-outcome-type-id)
    (= callee "host.process/read-line-bounded")
    (process-read-line-outcome-type-id)
    (= callee "host.process/read-line-deadline")
    (process-read-line-outcome-type-id)
    (= callee "host.process/alive?")
    (bool-type-id)
    :else (int-type-id)))

(defn host-process-call-abi-id [(callee String)] core/NativeId
  (cond
    (= callee "host.process/run-inherit") (host-process-abi-id)
    (= callee "host.process/run-capture") (host-process-capture-abi-id)
    (= callee "host.process/spawn-stdout")
    (host-process-lifecycle-abi-id "spawn-stdout")
    (= callee "host.process/read-line-bounded")
    (host-process-lifecycle-abi-id "read-line-bounded")
    (= callee "host.process/read-line-deadline")
    (host-process-lifecycle-abi-id "read-line-deadline")
    (= callee "host.process/wait")
    (host-process-lifecycle-abi-id "wait")
    (= callee "host.process/close")
    (host-process-lifecycle-abi-id "close")
    (= callee "host.process/exec-replace")
    (host-process-lifecycle-abi-id "exec-replace")
    (= callee "host.process/fifo-create")
    (host-process-lifecycle-abi-id "fifo-create")
    (= callee "host.process/fifo-open-read")
    (host-process-lifecycle-abi-id "fifo-open-read")
    (= callee "host.process/fifo-write-deadline")
    (host-process-lifecycle-abi-id "fifo-write-deadline")
    (= callee "host.process/poll-readable")
    (host-process-lifecycle-abi-id "poll-readable")
    (= callee "host.process/current-pid")
    (host-process-lifecycle-abi-id "current-pid")
    (= callee "host.process/alive?")
    (host-process-lifecycle-abi-id "alive")
    (= callee "host.process/signal")
    (host-process-lifecycle-abi-id "signal")
    :else (host-process-lifecycle-abi-id "wait-not-alive")))

(defn host-process-call-arena? [(callee String)] Bool
  (or (= callee "host.process/run-capture")
      (= callee "host.process/spawn-stdout")
      (= callee "host.process/read-line-bounded")
      (= callee "host.process/read-line-deadline")))

(defn lower-host-process-call
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (host-process-operands-valid? types callee value-types))
    (fail-result state
      (str "TODO-NATIVE-HOST-PROCESS-OPERANDS: unsupported operands for "
        callee))
    (let [(result-id core/NativeId) (state-id state owner "host-process")
          (result-type core/NativeId) (host-process-call-result-type callee)
          (arena-owned Bool) (host-process-call-arena? callee)]
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ExternCallInstruction
            (core/->SsaValueV0 result-id result-type)
            (host-process-call-abi-id callee)
            values
            (if arena-owned (arena-value-id owner) nil)
            (core/->TokenFlowV0 [] [])))
         result-id result-type false))))

(defn lower-int-step
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (value core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(coerced ArgsResultV0)
        (coerce-values-to-type types owner state [value] [value-type]
          (int-type-id))
        (settled BodyStateV0) (argsresultv0-state coerced)]
    (if (state-blocked? settled)
      (fail-result settled
        (str "TODO-NATIVE-" callee "-OPERAND: " callee
          " needs a value safely narrowable to Int"))
      (let [(one-id core/NativeId) (state-id settled owner (str callee "-one"))
            (with-one BodyStateV0)
            (state-emit (state-bump settled)
              (core/->AtomInstruction
                (core/->SsaValueV0 one-id (int-type-id))
                (core/->I64Atom 1)))]
        (lower-checked-arith with-one owner (if (= "inc" callee) "+" "-")
          (nth (argsresultv0-values coerced) 0) one-id)))))

(defn bitwise-operation
  [(callee String)
   (left core/NativeId)
   (right core/NativeId)]
  core/BitwiseOperationV0
  (cond
    (= "bit-and" callee) (core/->BitAndI64V0 left right)
    (= "bit-or" callee) (core/->BitOrI64V0 left right)
    (= "bit-xor" callee) (core/->BitXorI64V0 left right)
    (= "bit-shift-left" callee) (core/->BitShiftLeftI64V0 left right)
    :else (core/->UnsignedBitShiftRightI64V0 left right)))

(defn lower-bitwise
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (let [(shift Bool)
        (or (= "bit-shift-left" callee)
          (= "unsigned-bit-shift-right" callee))
        (arity-ok Bool) (if shift (= 2 (count values)) (>= (count values) 2))]
    (if (not arity-ok)
      (fail-result state
        (str "TODO-NATIVE-BITWISE-ARITY: " callee
          (if shift " takes two operands" " takes two or more operands")))
      (let [(coerced ArgsResultV0)
            (coerce-values-to-type types owner state values value-types
              (int-type-id))
            (settled BodyStateV0) (argsresultv0-state coerced)
            (operands (Vec core/NativeId)) (argsresultv0-values coerced)]
        (if (state-blocked? settled)
          (fail-result settled
            (str "TODO-NATIVE-BITWISE-OPERANDS: " callee
              " needs values safely narrowable to Int"))
          (loop [(position Int) 1
                 (current BodyStateV0) settled
                 (left core/NativeId) (nth operands 0)]
            (if (>= position (count operands))
              (->ExprResultV0 current left (int-type-id) false)
              (let [(result-id core/NativeId)
                    (state-id current owner (str callee "-" position))]
                (recur (+ position 1)
                  (state-emit (state-bump current)
                    (core/->BitwiseInstructionV0
                      (core/->SsaValueV0 result-id (int-type-id))
                      (bitwise-operation callee left (nth operands position))))
                  result-id)))))))))

(defn lower-native-equality
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (left-id core/NativeId)
   (left-type core/NativeId)
   (right-id core/NativeId)
   (right-type core/NativeId)]
  ExprResultV0
  (let [(same-type Bool) (same-id? left-type right-type)
        (left-union Bool) (> (count (union-variants-of types left-type)) 0)
        (right-union Bool) (> (count (union-variants-of types right-type)) 0)
        (comparison (U core/CompareOpV0 Nil))
        (if same-type (equality-comparison left-type) nil)]
    (cond
      (and same-type (set-type? types left-type))
      (lower-set-equality types owner state left-id right-id left-type)

      (and same-type (value-semantics-type? types left-type))
      (let [(result-id core/NativeId) (state-id state owner "value-equal")]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->ValueSemanticsInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (value-equal-operation left-type left-id right-id
                (value-semantics-dynamic? types left-type))))
          result-id (bool-type-id) false))

      (and left-union (not right-union))
      (lower-scalar-union-equality types owner state
        right-id right-type left-id left-type)

      (and (not left-union) right-union)
      (lower-scalar-union-equality types owner state
        left-id left-type right-id right-type)

      (some? comparison)
      (let [(result-id core/NativeId) (state-id state owner "equal")]
        (->ExprResultV0
          (state-emit (state-bump state)
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              comparison left-id right-id))
          result-id (bool-type-id) false))

      :else
      (fail-result state
        "TODO-NATIVE-NOT-EQUAL-OPERANDS: not= has no native equality for these operand types"))))

(defn lower-exact-bool-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)]
    (cond
      (or (same-id? value-type (bool-type-id)) (> (count variants) 0))
      (let [(target ExprResultV0)
            (bool-constant-result state owner "exact-bool-target"
              (= "true?" callee))]
        (lower-native-equality types owner (exprresultv0-state target)
          (exprresultv0-value-id target) (bool-type-id)
          value-id value-type))

      (exact-closed-type? types value-type)
      (bool-constant-result state owner "exact-bool-miss" false)

      :else
      (fail-result state
        (str "TODO-NATIVE-EXACT-BOOL-TYPE: " callee
          " needs a known closed native value")))))

(defn lower-not-equal
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (= 2 (count values)))
    (fail-result state "TODO-NATIVE-NOT-EQUAL-ARITY: not= lowers two operands")
    (let [(equal ExprResultV0)
          (lower-native-equality types owner state
            (nth values 0) (nth value-types 0)
            (nth values 1) (nth value-types 1))
          (current BodyStateV0) (exprresultv0-state equal)]
      (if (state-blocked? current)
        (dead-result current)
        (let [(false-id core/NativeId) (state-id current owner "not-equal-false")
              (result-id core/NativeId)
              (state-id (state-bump current) owner "not-equal")]
          (->ExprResultV0
            (state-emit
              (state-emit (state-bump (state-bump current))
                (core/->AtomInstruction
                  (core/->SsaValueV0 false-id (bool-type-id))
                  (core/->BoolAtom false)))
              (core/->CompareInstruction
                (core/->SsaValueV0 result-id (bool-type-id))
                (core/->CompareEqBoolV0 true)
                (exprresultv0-value-id equal) false-id))
            result-id (bool-type-id) false))))))

(defn lower-native-count
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(result-id core/NativeId) (state-id state owner "collection-count")]
    (cond
      (vector-type? types value-type)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->VecLengthInstruction
            (core/->SsaValueV0 result-id (int-type-id)) value-id))
        result-id (int-type-id) false)

      (map-type? types value-type)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->MapCountInstructionV0
            (core/->SsaValueV0 result-id (int-type-id)) value-id))
        result-id (int-type-id) false)

      (set-type? types value-type)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->SetCountInstructionV0
            (core/->SsaValueV0 result-id (int-type-id)) value-id))
        result-id (int-type-id) false)

      (text-operand? value-type)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->TextLengthInstruction
            (core/->SsaValueV0 result-id (int-type-id)) value-id))
        result-id (int-type-id) false)

      (same-id? value-type (byte-source-type-id))
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->ByteSourceLengthInstructionV0
            (core/->SsaValueV0 result-id (int-type-id)) value-id))
        result-id (int-type-id) false)

      :else
      (fail-result state
        "TODO-NATIVE-EMPTY-OPERAND: empty? needs a native vector, map, set, Text, or ByteSource"))))

(defn lower-empty-predicate
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)]
  ExprResultV0
  (let [(measured ExprResultV0)
        (lower-native-count types owner state value-id value-type)
        (current BodyStateV0) (exprresultv0-state measured)]
    (if (state-blocked? current)
      (dead-result current)
      (let [(zero-id core/NativeId) (state-id current owner "empty-zero")
            (result-id core/NativeId) (state-id (state-bump current) owner "empty")]
        (->ExprResultV0
          (state-emit
            (state-emit (state-bump (state-bump current))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (core/->CompareInstruction
              (core/->SsaValueV0 result-id (bool-type-id))
              (core/->CompareEqI64V0 true)
              (exprresultv0-value-id measured) zero-id))
          result-id (bool-type-id) false)))))

(defn lower-byte-source-slice
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (let [(open-ended Bool) (= 2 (count values))
        (bounds (Vec core/NativeId))
        (if open-ended [(nth values 1)] [(nth values 1) (nth values 2)])
        (bound-types (Vec core/NativeId))
        (if open-ended [(nth value-types 1)]
          [(nth value-types 1) (nth value-types 2)])
        (coerced ArgsResultV0)
        (coerce-values-to-type types owner state bounds bound-types
          (int-type-id))
        (settled BodyStateV0) (argsresultv0-state coerced)]
    (if (state-blocked? settled)
      (fail-result settled
        "TODO-NATIVE-SUBVEC-OPERANDS: subvec bounds are not safely narrowable to Int")
      (let [(length-id core/NativeId) (state-id settled owner "byte-subvec-end")
            (measured BodyStateV0)
            (if open-ended
              (state-emit (state-bump settled)
                (core/->ByteSourceLengthInstructionV0
                  (core/->SsaValueV0 length-id (int-type-id))
                  (nth values 0)))
              settled)
            (end-id core/NativeId)
            (if open-ended length-id (nth (argsresultv0-values coerced) 1))
            (result-id core/NativeId) (state-id measured owner "byte-subvec")]
        (->ExprResultV0
          (state-emit (state-bump measured)
            (core/->ByteSourceSliceInstructionV0
              (core/->SsaValueV0 result-id (byte-source-type-id))
              (nth values 0)
              (nth (argsresultv0-values coerced) 0)
              end-id
              (arena-value-id owner)))
          result-id (byte-source-type-id) false)))))

(defn lower-vector-slice
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (and (or (= 2 (count values)) (= 3 (count values)))
        (same-id? (nth value-types 0) (byte-source-type-id)))
    (lower-byte-source-slice types owner state values value-types)
    (if (not (and (or (= 2 (count values)) (= 3 (count values)))
               (vector-type? types (nth value-types 0))))
    (fail-result state
      "TODO-NATIVE-SUBVEC-OPERANDS: subvec takes a native vector and one or two Int bounds")
    (let [(open-ended Bool) (= 2 (count values))
          (bounds (Vec core/NativeId))
          (if open-ended [(nth values 1)] [(nth values 1) (nth values 2)])
          (bound-types (Vec core/NativeId))
          (if open-ended [(nth value-types 1)]
            [(nth value-types 1) (nth value-types 2)])
          (coerced ArgsResultV0)
          (coerce-values-to-type types owner state bounds bound-types
            (int-type-id))
          (settled BodyStateV0) (argsresultv0-state coerced)]
      (if (state-blocked? settled)
        (fail-result settled
          "TODO-NATIVE-SUBVEC-OPERANDS: subvec bounds are not safely narrowable to Int")
        (let [(length-id core/NativeId) (state-id settled owner "subvec-end")
              (measured BodyStateV0)
              (if open-ended
                (state-emit (state-bump settled)
                  (core/->VecLengthInstruction
                    (core/->SsaValueV0 length-id (int-type-id))
                    (nth values 0)))
                settled)
              (end-id core/NativeId)
              (if open-ended length-id (nth (argsresultv0-values coerced) 1))
              (result-id core/NativeId) (state-id measured owner "subvec")]
          (->ExprResultV0
            (state-emit (state-bump measured)
              (core/->VecSliceInstructionV0
                (core/->SsaValueV0 result-id (nth value-types 0))
                (nth values 0)
                (nth (argsresultv0-values coerced) 0)
                end-id
                (arena-value-id owner)))
            result-id (nth value-types 0) false)))))))

(defn lower-vector-edge
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (and (= 1 (count values))
             (vector-type? types (nth value-types 0))))
    (fail-result state
      (str "TODO-NATIVE-VECTOR-EDGE-OPERAND: " callee
        " takes one closed native vector"))
    (let [(vector-type core/NativeId) (nth value-types 0)
          (element-type core/NativeId) (vector-element-of types vector-type)]
      (if (= "first" callee)
        (let [(zero-id core/NativeId) (state-id state owner "first-index")
              (result-id core/NativeId)
              (state-id (state-bump state) owner "first-value")]
          (->ExprResultV0
            (state-emit
              (state-emit (state-bump (state-bump state))
                (core/->AtomInstruction
                  (core/->SsaValueV0 zero-id (int-type-id))
                  (core/->I64Atom 0)))
              (core/->VecGetInstruction
                (core/->SsaValueV0 result-id element-type)
                (nth values 0) zero-id))
            result-id element-type false))
        (let [(length-id core/NativeId)
              (state-id state owner (str callee "-length"))
              (one-id core/NativeId)
              (state-id (state-bump state) owner (str callee "-one"))
              (prepared BodyStateV0)
              (state-emit
                (state-emit (state-bump (state-bump state))
                  (core/->VecLengthInstruction
                    (core/->SsaValueV0 length-id (int-type-id))
                    (nth values 0)))
                (core/->AtomInstruction
                  (core/->SsaValueV0 one-id (int-type-id))
                  (core/->I64Atom 1)))
              (index ExprResultV0)
              (lower-checked-arith prepared owner "-" length-id one-id)
              (settled BodyStateV0) (exprresultv0-state index)
              (result-id core/NativeId)
              (state-id settled owner (str callee "-value"))]
          (if (state-blocked? settled)
            (dead-result settled)
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->VecGetInstruction
                  (core/->SsaValueV0 result-id element-type)
                  (nth values 0) (exprresultv0-value-id index)))
              result-id element-type false)))))))

(defn lower-vector-take-drop
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (and (= 2 (count values))
             (same-id? (nth value-types 0) (int-type-id))
             (vector-type? types (nth value-types 1))))
    (fail-result state
      (str "TODO-NATIVE-VECTOR-SLICE-OPERANDS: " callee
        " takes an Int count and one closed native vector"))
    (let [(length-id core/NativeId)
          (state-id state owner (str callee "-length"))
          (zero-id core/NativeId)
          (state-id (state-bump state) owner (str callee "-zero"))
          (prepared BodyStateV0)
          (state-emit
            (state-emit (state-bump (state-bump state))
              (core/->VecLengthInstruction
                (core/->SsaValueV0 length-id (int-type-id))
                (nth values 1)))
            (core/->AtomInstruction
              (core/->SsaValueV0 zero-id (int-type-id))
              (core/->I64Atom 0)))
          (nonnegative ExprResultV0)
          (lower-int-extreme-pair prepared owner "max"
            (nth values 0) zero-id)
          (bounded ExprResultV0)
          (lower-int-extreme-pair (exprresultv0-state nonnegative) owner "min"
            (exprresultv0-value-id nonnegative) length-id)
          (settled BodyStateV0) (exprresultv0-state bounded)
          (result-id core/NativeId)
          (state-id settled owner (str callee "-vector"))
          (taking Bool) (= "take" callee)]
      (->ExprResultV0
        (state-emit (state-bump settled)
          (core/->VecSliceInstructionV0
            (core/->SsaValueV0 result-id (nth value-types 1))
            (nth values 1)
            (if taking zero-id (exprresultv0-value-id bounded))
            (if taking (exprresultv0-value-id bounded) length-id)
            (arena-value-id owner)))
        result-id (nth value-types 1) false))))

(defn lower-vector-rest
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (and (= 1 (count values))
             (vector-type? types (nth value-types 0))))
    (fail-result state
      "TODO-NATIVE-REST-OPERAND: rest takes one closed native vector")
    (let [(one-id core/NativeId) (state-id state owner "rest-one")
          (prepared BodyStateV0)
          (state-emit (state-bump state)
            (core/->AtomInstruction
              (core/->SsaValueV0 one-id (int-type-id))
              (core/->I64Atom 1)))]
      (lower-vector-take-drop types owner prepared "drop"
        [one-id (nth values 0)]
        [(int-type-id) (nth value-types 0)]))))

(defn lower-vector-pop
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (and (= 1 (count values))
             (vector-type? types (nth value-types 0))))
    (fail-result state
      "TODO-NATIVE-POP-OPERAND: pop takes one closed native vector")
    (let [(vector-type core/NativeId) (nth value-types 0)
          (length-id core/NativeId) (state-id state owner "pop-length")
          (with-length BodyStateV0)
          (state-emit (state-bump state)
            (core/->VecLengthInstruction
              (core/->SsaValueV0 length-id (int-type-id))
              (nth values 0)))
          (one-id core/NativeId) (state-id with-length owner "pop-one")
          (with-one BodyStateV0)
          (state-emit (state-bump with-length)
            (core/->AtomInstruction
              (core/->SsaValueV0 one-id (int-type-id))
              (core/->I64Atom 1)))
          (end ExprResultV0)
          (lower-checked-arith with-one owner "-" length-id one-id)
          (settled BodyStateV0) (exprresultv0-state end)]
      (if (state-blocked? settled)
        (dead-result settled)
        (let [(zero-id core/NativeId) (state-id settled owner "pop-zero")
              (with-zero BodyStateV0)
              (state-emit (state-bump settled)
                (core/->AtomInstruction
                  (core/->SsaValueV0 zero-id (int-type-id))
                  (core/->I64Atom 0)))
              (result-id core/NativeId) (state-id with-zero owner "pop-vector")]
          (->ExprResultV0
            (state-emit (state-bump with-zero)
              (core/->VecSliceInstructionV0
                (core/->SsaValueV0 result-id vector-type)
                (nth values 0) zero-id (exprresultv0-value-id end)
                (arena-value-id owner)))
            result-id vector-type false))))))

(defn lower-int-range
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (or (= 1 (count values)) (= 2 (count values))))
    (fail-result state
      "TODO-NATIVE-RANGE-ARITY: range lowers its one- or two-Int finite form")
    (let [(coerced ArgsResultV0)
          (coerce-values-to-type types owner state values value-types
            (int-type-id))
          (settled BodyStateV0) (argsresultv0-state coerced)
          (vector-type (U core/NativeId Nil))
          (vector-type-of types (int-type-id))]
      (cond
        (state-blocked? settled)
        (fail-result settled
          "TODO-NATIVE-RANGE-OPERANDS: range bounds must be safely narrowable to Int")

        (nil? vector-type)
        (fail-result settled
          "TODO-NATIVE-RANGE-TYPE: range needs a closed (Vec Int) result type")

        :else
        (let [(zero-id core/NativeId) (state-id settled owner "range-zero")
              (with-zero BodyStateV0)
              (state-emit (state-bump settled)
                (core/->AtomInstruction
                  (core/->SsaValueV0 zero-id (int-type-id))
                  (core/->I64Atom 0)))
              (one-id core/NativeId) (state-id with-zero owner "range-one")
              (with-one BodyStateV0)
              (state-emit (state-bump with-zero)
                (core/->AtomInstruction
                  (core/->SsaValueV0 one-id (int-type-id))
                  (core/->I64Atom 1)))
              (empty-id core/NativeId) (state-id with-one owner "range-empty")
              (prepared BodyStateV0)
              (state-emit (state-bump with-one)
                (core/->VecEmptyInstruction
                  (core/->SsaValueV0 empty-id vector-type)
                  zero-id (arena-value-id owner)))
              (operands (Vec core/NativeId)) (argsresultv0-values coerced)
              (start-id core/NativeId)
              (if (= 1 (count operands)) zero-id (nth operands 0))
              (end-id core/NativeId)
              (if (= 1 (count operands)) (nth operands 0) (nth operands 1))
              (header-id core/NativeId) (state-id prepared owner "range-header")
              (body-id core/NativeId) (state-id prepared owner "range-body")
              (exit-id core/NativeId) (state-id prepared owner "range-exit")
              (header-value core/NativeId)
              (state-id prepared owner "range-current")
              (header-vector core/NativeId)
              (state-id prepared owner "range-vector")
              (entered BodyStateV0)
              (state-open-block
                (state-close (state-bump prepared)
                  (core/->JumpTerminator header-id [start-id empty-id]))
                header-id
                [(core/->Parameter header-value (int-type-id))
                 (core/->Parameter header-vector vector-type)])
              (has-item core/NativeId)
              (state-id entered owner "range-has-item")
              (compared BodyStateV0)
              (state-emit (state-bump entered)
                (core/->CompareInstruction
                  (core/->SsaValueV0 has-item (bool-type-id))
                  (core/->CompareLtI64V0 true) header-value end-id))
              (body-state BodyStateV0)
              (state-open-block
                (state-close compared
                  (core/->BranchTerminator has-item body-id exit-id))
                body-id [])
              (pushed-id core/NativeId)
              (state-id body-state owner "range-push")
              (with-push BodyStateV0)
              (state-emit (state-bump body-state)
                (core/->VecPushInstruction
                  (core/->SsaValueV0 pushed-id vector-type)
                  header-vector header-value (arena-value-id owner)))
              (advanced ExprResultV0)
              (lower-checked-arith with-push owner "+" header-value one-id)
              (looped BodyStateV0) (exprresultv0-state advanced)]
          (if (state-blocked? looped)
            (dead-result looped)
            (->ExprResultV0
              (state-open-block
                (state-close looped
                  (core/->JumpTerminator header-id
                    [(exprresultv0-value-id advanced) pushed-id]))
                exit-id [])
              header-vector vector-type false)))))))

(defn lower-vector-sort
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (values (Vec core/NativeId))
   (value-types (Vec core/NativeId))]
  ExprResultV0
  (if (not (= 1 (count values)))
    (fail-result state
      "TODO-NATIVE-SORT-OPERAND: sort takes one closed native collection")
    (let [(source-type core/NativeId) (nth value-types 0)]
      (cond
        (vector-type? types source-type)
        (let [(element-type core/NativeId)
              (vector-element-of types source-type)]
          (if (not (comparable-type? types element-type))
            (fail-result state
              "TODO-NATIVE-SORT-ELEMENT: sort needs sealed comparable element semantics")
            (let [(result-id core/NativeId) (state-id state owner "vec-sort")]
              (->ExprResultV0
                (state-emit (state-bump state)
                  (core/->VecSortInstructionV0
                    (core/->SsaValueV0 result-id source-type)
                    (nth values 0) (arena-value-id owner) element-type))
                result-id source-type false))))

        (insertion-order-set-type? types source-type)
        (let [(element-type core/NativeId) (set-element-of types source-type)
              (vector-type (U core/NativeId Nil))
              (vector-type-of types element-type)]
          (if (nil? vector-type)
            (fail-result state
              "TODO-NATIVE-SORT-VECTOR-TYPE: the Set element has no declared Vec carrier")
            (let [(vector-id core/NativeId)
                  (state-id state owner "sort-set-vector")
                  (converted BodyStateV0)
                  (state-emit (state-bump state)
                    (core/->SetVectorInstructionV0
                      (core/->SsaValueV0 vector-id vector-type)
                      (nth values 0) (arena-value-id owner)))]
              (lower-vector-sort types owner converted
                [vector-id] [vector-type]))))

        :else
        (fail-result state
          "TODO-NATIVE-SORT-OPERAND: sort needs a closed Vec or insertion-order Set")))))

;; A repeated immutable lookup is keyed by its receiver SSA and fixed field/key
;; identity. Map keyword access and generated record accessors share that proof.
(defn keyword-lookup-site
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source core/NativeId)]
  (U KeywordLookupSiteV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (kind String) (fact-text index source "form-kind")]
    (cond
      (= "kw-access" kind)
      (let [(keyword String) (fact-text index source "keyword")
            (target (U core/NativeId Nil))
            (index-first-object index source "target")
            (binding (U LocalBindingV0 Nil))
            (if (nil? target) nil
              (source-ref-binding env state target))]
        (if (or (= "" keyword) (nil? binding))
          nil
          (let [(source-type core/NativeId) (localbindingv0-type-id binding)]
            (if (or (not (map-type? types source-type))
                    (not (same-id? (map-key-of types source-type)
                           (keyword-type-id))))
              nil
              (let [(lookup-type (U core/NativeId Nil))
                    (nullable-value-type-of types
                      (map-value-of types source-type))]
                (if (nil? lookup-type)
                  nil
                  (->KeywordLookupSiteV0
                    (localbindingv0-value-id binding)
                    source-type keyword lookup-type)))))))

      (= "call" kind)
      (let [(args (Vec core/NativeId)) (source-call-arguments index source)
            (resolved ResolvedSourceNameV0)
            (resolve-source-name index (source-module-name index source)
              (fact-text index source "callee"))
            (accessor AccessorHitV0) (record-accessor types resolved)
            (binding (U LocalBindingV0 Nil))
            (if (= 1 (count args))
              (source-ref-binding env state (nth args 0))
              nil)]
        (if (or (not (accessorhitv0-found accessor)) (nil? binding))
          nil
          (let [(source-type core/NativeId) (localbindingv0-type-id binding)
                (owner-type core/NativeId) (accessorhitv0-owner-type accessor)
                (direct Bool)
                (or (same-id? source-type owner-type)
                  (reference-targets? types source-type owner-type))
                (narrowing NarrowHitV0)
                (if direct (narrow-miss)
                  (reference-variant-for types source-type owner-type))]
            (if (or direct (narrowhitv0-found narrowing))
              (->KeywordLookupSiteV0
                (localbindingv0-value-id binding)
                source-type
                (id-value (accessorhitv0-field-id accessor))
                (accessorhitv0-field-type accessor))
              nil))))

      :else nil)))

(defn exact-scalar-predicate-type [(callee String)] (U core/NativeId Nil)
  (cond
    (= "integer?" callee) (int-type-id)
    (= "string?" callee) (text-type-id)
    (= "boolean?" callee) (bool-type-id)
    (= "keyword?" callee) (keyword-type-id)
    :else nil))

(defn exact-scalar-source-type
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (kind String) (fact-text index source "form-kind")]
    (cond
      (= "literal" kind)
      (let [(literal-kind String) (fact-text index source "literal-kind")]
        (cond
          (or (= "int" literal-kind) (= "number" literal-kind)) (int-type-id)
          (= "bool" literal-kind) (bool-type-id)
          (= "string" literal-kind) (text-type-id)
          (= "regex" literal-kind) (text-type-id)
          (= "keyword" literal-kind) (keyword-type-id)
          :else nil))

      (= "ref" kind)
      (let [(binding (U LocalBindingV0 Nil))
            (source-ref-binding env state source)]
        (if (nil? binding)
          nil
          (let [(type-id-value core/NativeId) (localbindingv0-type-id binding)]
            (if (nil? (equality-comparison type-id-value))
              nil
              type-id-value))))

      :else nil)))

(defn keyword-refinement-for-source
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (source core/NativeId)
   (result-type core/NativeId)]
  (U KeywordFlowRefinementV0 Nil)
  (let [(site (U KeywordLookupSiteV0 Nil))
        (keyword-lookup-site env owner state source)]
    (if (nil? site)
      nil
      (let [(path VariantPathV0)
            (variant-path-to-payload (bodyenvv0-types env)
              (keywordlookupsitev0-lookup-type site) result-type)]
        (if (not (= 1 (variantpathv0-matches path)))
          nil
          (->KeywordFlowRefinementV0
            (keywordlookupsitev0-source-id site)
            (keywordlookupsitev0-source-type site)
            (keywordlookupsitev0-keyword site)
            (keywordlookupsitev0-lookup-type site)
            result-type))))))

(defn equality-keyword-refinement
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (lookup-source core/NativeId)
   (scalar-source core/NativeId)]
  (U KeywordFlowRefinementV0 Nil)
  (let [(scalar-type (U core/NativeId Nil))
        (exact-scalar-source-type env owner state scalar-source)]
    (if (nil? scalar-type)
      nil
      (keyword-refinement-for-source env owner state lookup-source scalar-type))))

(defn condition-keyword-refinement
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (condition core/NativeId)]
  (U KeywordFlowRefinementV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (not (= "call" (fact-text index condition "form-kind")))
      nil
      (let [(callee String) (fact-text index condition "callee")
            (args-node (U core/NativeId Nil))
            (index-first-object index condition "args")
            (args (Vec core/NativeId))
            (if (nil? args-node) [] (index-sequence-items index args-node))]
        (cond
          (= 1 (count args))
          (let [(result-type (U core/NativeId Nil))
                (exact-scalar-predicate-type callee)]
            (if (nil? result-type)
              nil
              (keyword-refinement-for-source env owner state
                (nth args 0) result-type)))

          (and (= "=" callee) (= 2 (count args)))
          (let [(left (U KeywordFlowRefinementV0 Nil))
                (equality-keyword-refinement env owner state
                  (nth args 0) (nth args 1))]
            (if (some? left)
              left
              (equality-keyword-refinement env owner state
                (nth args 1) (nth args 0))))

          :else nil)))))

(defn intersect-id-vectors
  [(left (Vec core/NativeId)) (right (Vec core/NativeId))] (Vec core/NativeId)
  (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
    (if (>= position (count left))
      collected
      (let [(value core/NativeId) (nth left position)]
        (recur (+ position 1)
          (if (core/id-in? right value)
            (append-unique-id collected value)
            collected))))))

(defn subtract-id-vectors
  [(left (Vec core/NativeId)) (right (Vec core/NativeId))] (Vec core/NativeId)
  (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
    (if (>= position (count left))
      collected
      (let [(value core/NativeId) (nth left position)]
        (recur (+ position 1)
          (if (core/id-in? right value)
            collected
            (append-unique-id collected value)))))))

(defn source-record-type
  [(env BodyEnvV0)
   (module-name String)
   (source core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (not (= "ref" (fact-text index source "form-kind")))
      nil
      (let [(resolved ResolvedSourceNameV0)
            (resolve-source-name index module-name (fact-text index source "name"))
            (target core/NativeId) (source-type-id (resolved-source-key resolved))]
        (if (and (resolvedsourcenamev0-visible resolved)
              (record-type? (bodyenvv0-types env) target))
          target
          nil)))))

(defn direct-instance-record-type
  [(env BodyEnvV0)
   (module-name String)
   (call core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (args (Vec core/NativeId)) (source-call-arguments index call)]
    (if (and (= "call" (fact-text index call "form-kind"))
          (= "instance?" (fact-text index call "callee"))
          (= 2 (count args)))
      (source-record-type env module-name (nth args 0))
      nil)))

;; A one-argument predicate whose entire body is `instance?` carries the same
;; closed proof as the primitive, resolved in the predicate owner's module.
(defn wrapper-instance-record-type
  [(env BodyEnvV0)
   (source-call core/NativeId)
   (callee String)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (signature (U TypedFunctionV0 Nil))
        (find-signature env source-call callee)
        (source (U core/NativeId Nil))
        (find-signature-source env source-call callee)]
    (if (or (nil? signature) (nil? source)
          (not (same-id? (typedfunctionv0-return-type signature) (bool-type-id))))
      nil
      (let [(params-node (U core/NativeId Nil))
            (index-first-object index source "params")
            (params (Vec core/NativeId))
            (if (nil? params-node) [] (index-sequence-items index params-node))
            (body (U core/NativeId Nil)) (index-first-object index source "body")]
        (if (or (not (= 1 (count params))) (nil? body))
          nil
          (let [(args (Vec core/NativeId)) (source-call-arguments index body)
                (parameter-name String) (fact-text index (nth params 0) "name")]
            (if (and (= "call" (fact-text index body "form-kind"))
                  (= "instance?" (fact-text index body "callee"))
                  (= 2 (count args))
                  (source-ref-named? index (nth args 1) parameter-name))
              (source-record-type env (source-module-name index source)
                (nth args 0))
              nil)))))))

(defn value-flow-site
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (condition core/NativeId)]
  (U ValueFlowSiteV0 Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (not (= "call" (fact-text index condition "form-kind")))
      nil
      (let [(callee String) (fact-text index condition "callee")
            (args (Vec core/NativeId)) (source-call-arguments index condition)
            (instance-type (U core/NativeId Nil))
            (direct-instance-record-type env
              (source-module-name index condition) condition)
            (wrapper-type (U core/NativeId Nil))
            (if (= 1 (count args))
              (wrapper-instance-record-type env condition callee)
              nil)
            (source (U core/NativeId Nil))
            (cond
              (and (some? instance-type) (= 2 (count args))) (nth args 1)
              (= 1 (count args)) (nth args 0)
              :else nil)]
        (if (nil? source)
          nil
          (let [(binding (U LocalBindingV0 Nil))
                (source-ref-binding env state source)]
            (if (nil? binding)
              nil
              (let [(source-type core/NativeId) (localbindingv0-type-id binding)
                    (current-refinement (U ValueFlowRefinementV0 Nil))
                    (find-value-refinement state
                      (localbindingv0-value-id binding) source-type)
                    (possible (Vec core/NativeId))
                    (if (nil? current-refinement)
                      (possible-value-types (bodyenvv0-types env) source-type)
                      (valueflowrefinementv0-possible-types current-refinement))
                    (accepted (Vec core/NativeId))
                    (cond
                      (scalar-predicate? callee) (scalar-predicate-types callee)
                      (= "nil?" callee) [(type-id "Nil")]
                      (= "some?" callee)
                      (subtract-id-vectors possible [(type-id "Nil")])
                      (some? instance-type) [instance-type]
                      (some? wrapper-type) [wrapper-type]
                      :else [])]
                (if (= 0 (count accepted))
                  nil
                  (->ValueFlowSiteV0
                    (fact-text index source "name")
                    (localbindingv0-value-id binding)
                    source-type accepted))))))))))

(defn state-refine-value-site
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (site ValueFlowSiteV0)
   (truth Bool)]
  BodyStateV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (prior (U ValueFlowRefinementV0 Nil))
        (find-value-refinement state
          (valueflowsitev0-source-id site)
          (valueflowsitev0-source-type site))
        (possible (Vec core/NativeId))
        (if (nil? prior)
          (possible-value-types types (valueflowsitev0-source-type site))
          (valueflowrefinementv0-possible-types prior))
        (refined (Vec core/NativeId))
        (if truth
          (intersect-id-vectors possible (valueflowsitev0-accepted-types site))
          (subtract-id-vectors possible (valueflowsitev0-accepted-types site)))
        (recorded BodyStateV0)
        (state-add-value-refinement state
          (->ValueFlowRefinementV0
            (valueflowsitev0-source-id site)
            (valueflowsitev0-source-type site)
            refined))]
    (if (not (= 1 (count refined)))
      recorded
      (let [(target core/NativeId) (nth refined 0)
            (narrowed ExprResultV0)
            (if (same-id? target (type-id "Nil"))
              (nil-constant-result types recorded owner "refined-nil")
              (lower-boundary-coerce types owner recorded
                (valueflowsitev0-source-id site)
                (valueflowsitev0-source-type site)
                target))]
        (if (state-blocked? (exprresultv0-state narrowed))
          (exprresultv0-state narrowed)
          (state-bind (exprresultv0-state narrowed)
            (valueflowsitev0-name site)
            (exprresultv0-value-id narrowed)
            (exprresultv0-type-id narrowed)))))))

(defn state-refine-for-condition
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (condition core/NativeId)
   (truth Bool)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (kind String) (fact-text index condition "form-kind")]
    (if (not (= "call" kind))
      state
      (let [(callee String) (fact-text index condition "callee")
            (args (Vec core/NativeId)) (source-call-arguments index condition)]
        (cond
          (and (= "and" callee) truth)
          (loop [(position Int) 0 (current BodyStateV0) state]
            (if (or (>= position (count args)) (state-blocked? current))
              current
              (recur (+ position 1)
                (state-refine-for-condition env owner current
                  (nth args position) true))))

          (and (= "or" callee) (not truth))
          (loop [(position Int) 0 (current BodyStateV0) state]
            (if (or (>= position (count args)) (state-blocked? current))
              current
              (recur (+ position 1)
                (state-refine-for-condition env owner current
                  (nth args position) false))))

          (and (= "not" callee) (= 1 (count args)))
          (state-refine-for-condition env owner state (nth args 0) (not truth))

          :else
          (let [(keyword-refinement (U KeywordFlowRefinementV0 Nil))
                (if truth
                  (condition-keyword-refinement env owner state condition)
                  nil)
                (keyword-state BodyStateV0)
                (if (nil? keyword-refinement)
                  state
                  (state-add-keyword-refinement state keyword-refinement))
                (value-site (U ValueFlowSiteV0 Nil))
                (value-flow-site env owner keyword-state condition)]
            (if (nil? value-site)
              keyword-state
              (state-refine-value-site env owner keyword-state value-site truth))))))))

(declare lower-expr lower-expr-expected)

;; Conditions consume truth values, not Clojure's operand-valued `and`/`or`
;; result. Lowering them contextually preserves short-circuiting without forcing
;; unrelated operand types through a value join.
(defn lower-condition
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (kind String) (fact-text index expression "form-kind")
        (callee String) (fact-text index expression "callee")
        (args (Vec core/NativeId))
        (if (= "call" kind) (source-call-arguments index expression) [])]
    (cond
      (and (= "call" kind) (or (= "and" callee) (= "or" callee)))
      (let [(arity Int) (count args)]
        (cond
          (= 0 arity)
          (bool-constant-result state owner "condition-empty" (= "and" callee))

          (= 1 arity)
          (lower-condition env owner state (nth args 0))

          :else
          (let [(outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
                (outer-keywords (Vec KeywordFlowRefinementV0))
                (bodystatev0-keyword-refinements state)
                (outer-values (Vec ValueFlowRefinementV0))
                (bodystatev0-value-refinements state)
                (join-id core/NativeId) (state-id state owner "condition-join")
                (join-parameter core/NativeId)
                (state-id state owner "condition-value")
                ;; Reserve this short-circuit node's coordinate before lowering
                ;; an operand. A nested and/or otherwise sees the same counter
                ;; and mints the same condition join and parameter identities.
                (operand-state BodyStateV0) (state-bump state)]
            (loop [(position Int) 0 (current BodyStateV0) operand-state]
              (let [(operand-node core/NativeId) (nth args position)
                    (operand ExprResultV0)
                    (lower-condition env owner current operand-node)
                    (operand-state BodyStateV0) (exprresultv0-state operand)]
                (cond
                  (state-blocked? operand-state) (dead-result operand-state)

                  (exprresultv0-terminated operand)
                  (if (= 0 position)
                    operand
                    (->ExprResultV0
                      (state-open-block
                        (state-with-flow-context operand-state
                          outer-locals outer-keywords outer-values)
                        join-id
                        [(core/->Parameter join-parameter (bool-type-id))])
                      join-parameter (bool-type-id) false))

                  (not (same-id? (exprresultv0-type-id operand) (bool-type-id)))
                  (fail-result operand-state
                    "TODO-NATIVE-CONDITION-OPERAND: condition operand is not Bool")

                  (= (+ position 1) arity)
                  (->ExprResultV0
                    (state-open-block
                      (state-with-flow-context
                        (state-close operand-state
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id operand)]))
                        outer-locals outer-keywords outer-values)
                      join-id
                      [(core/->Parameter join-parameter (bool-type-id))])
                    join-parameter (bool-type-id) false)

                  :else
                  (let [(next-id core/NativeId)
                        (state-id operand-state owner
                          (str "condition-rest-" position))
                        (shortcut-id core/NativeId)
                        (state-id operand-state owner
                          (str "condition-shortcut-" position))
                        (branched BodyStateV0)
                        (state-close (state-bump operand-state)
                          (if (= "and" callee)
                            (core/->BranchTerminator
                              (exprresultv0-value-id operand)
                              next-id shortcut-id)
                            (core/->BranchTerminator
                              (exprresultv0-value-id operand)
                              shortcut-id next-id)))
                        (shortcut ExprResultV0)
                        (bool-constant-result
                          (state-open-block branched shortcut-id [])
                          owner "condition-shortcut" (= "or" callee))
                        (after-shortcut BodyStateV0)
                        (state-close (exprresultv0-state shortcut)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id shortcut)]))
                        (path-state BodyStateV0)
                        (state-with-flow-context
                          (state-open-block after-shortcut next-id [])
                          (bodystatev0-locals operand-state)
                          (bodystatev0-keyword-refinements operand-state)
                          (bodystatev0-value-refinements operand-state))
                        (continued BodyStateV0)
                        (state-refine-for-condition env owner path-state
                          operand-node (= "and" callee))]
                    (recur (+ position 1) continued))))))))

      (and (= "call" kind) (= "not" callee) (= 1 (count args)))
      (let [(operand ExprResultV0)
            (lower-condition env owner state (nth args 0))
            (current BodyStateV0) (exprresultv0-state operand)]
        (cond
          (exprresultv0-terminated operand) operand
          (state-blocked? current) (dead-result current)
          :else
          (let [(false-id core/NativeId) (state-id current owner "condition-false")
                (result-id core/NativeId)
                (state-id (state-bump current) owner "condition-not")]
            (->ExprResultV0
              (state-emit
                (state-emit (state-bump (state-bump current))
                  (core/->AtomInstruction
                    (core/->SsaValueV0 false-id (bool-type-id))
                    (core/->BoolAtom false)))
                (core/->CompareInstruction
                  (core/->SsaValueV0 result-id (bool-type-id))
                  (core/->CompareEqBoolV0 true)
                  (exprresultv0-value-id operand) false-id))
              result-id (bool-type-id) false))))

      :else
      (let [(raw ExprResultV0) (lower-expr env owner state expression)]
        (if (or (exprresultv0-terminated raw)
              (state-blocked? (exprresultv0-state raw)))
          raw
          (lower-truthy types owner
            (exprresultv0-state raw)
            (exprresultv0-value-id raw)
            (exprresultv0-type-id raw)))))))

;; Captured SSA locals remain dominated, but recur cannot cross an fn boundary.
(defn state-enter-inline-callback [(state BodyStateV0)] BodyStateV0
  (with state [:loop-frames []]))

;; Callback annotations own empty-literal shapes and every value crossing them.
(defn lower-contextual-boundary
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)
   (shape-expected (U core/NativeId Nil))
   (boundary-expected core/NativeId)]
  ExprResultV0
  (let [(raw ExprResultV0)
        (lower-expr-expected env owner state expression shape-expected)]
    (if (or (exprresultv0-terminated raw)
            (state-blocked? (exprresultv0-state raw)))
      raw
      (lower-boundary-coerce (bodyenvv0-types env) owner
        (exprresultv0-state raw)
        (exprresultv0-value-id raw)
        (exprresultv0-type-id raw)
        boundary-expected))))

(defn lower-reduce-collection
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expression core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (source ExprResultV0)
        (lower-expr-expected env owner state expression expected)
        (settled BodyStateV0) (exprresultv0-state source)
        (source-type core/NativeId) (exprresultv0-type-id source)]
    (cond
      (exprresultv0-terminated source) source
      (state-blocked? settled) (dead-result settled)
      (vector-type? types source-type) source

      (insertion-order-set-type? types source-type)
      (let [(element-type core/NativeId) (set-element-of types source-type)
            (vector-type (U core/NativeId Nil))
            (vector-type-of types element-type)]
        (if (nil? vector-type)
          (fail-result settled
            "TODO-NATIVE-REDUCE-COLLECTION: insertion-order Set has no declared Vec carrier")
          (let [(result-id core/NativeId)
                (state-id settled owner "reduce-set-vector")]
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->SetVectorInstructionV0
                  (core/->SsaValueV0 result-id vector-type)
                  (exprresultv0-value-id source) (arena-value-id owner)))
              result-id vector-type false))))

      :else
      (fail-result settled
        "TODO-NATIVE-REDUCE-COLLECTION: reduce needs a native Vec or closed insertion-order Set"))))

(defn lower-eager-vector-collect
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (callback-body (U core/NativeId Nil))
   (callback-source-parameter (U core/NativeId Nil))
   (callback-accessor AccessorHitV0)
   (callback-return core/NativeId)
   (element-type core/NativeId)
   (collection-id core/NativeId)
   (collection-type core/NativeId)]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (mapping Bool) (= "mapv" callee)
        (result-vector-type (U core/NativeId Nil))
        (if mapping
          (vector-type-of types callback-return)
          collection-type)]
    (if (nil? result-vector-type)
      (fail-result state
        "TODO-NATIVE-MAPV-RESULT: the module declares no Vec of the callback return type")
      (let [(outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
            (outer-frames (Vec LoopFrameV0)) (bodystatev0-loop-frames state)
            (outer-refinements (Vec KeywordFlowRefinementV0))
            (bodystatev0-keyword-refinements state)
            (outer-values (Vec ValueFlowRefinementV0))
            (bodystatev0-value-refinements state)
            (length-id core/NativeId) (state-id state owner (str callee "-length"))
            (zero-id core/NativeId) (state-id state owner (str callee "-zero"))
            (empty-id core/NativeId) (state-id state owner (str callee "-empty"))
            (header-id core/NativeId) (state-id state owner (str callee "-header"))
            (body-id core/NativeId) (state-id state owner (str callee "-body"))
            (exit-id core/NativeId) (state-id state owner (str callee "-exit"))
            (header-index core/NativeId) (state-id state owner (str callee "-index"))
            (header-output core/NativeId) (state-id state owner (str callee "-output"))
            (prepared BodyStateV0)
            (state-emit
              (state-emit
                (state-emit (state-bump state)
                  (core/->VecLengthInstruction
                    (core/->SsaValueV0 length-id (int-type-id))
                    collection-id))
                (core/->AtomInstruction
                  (core/->SsaValueV0 zero-id (int-type-id))
                  (core/->I64Atom 0)))
              (core/->VecEmptyInstruction
                (core/->SsaValueV0 empty-id result-vector-type)
                length-id (arena-value-id owner)))
            (entered BodyStateV0)
            (state-open-block
              (state-close (state-bump prepared)
                (core/->JumpTerminator header-id [zero-id empty-id]))
              header-id
              [(core/->Parameter header-index (int-type-id))
               (core/->Parameter header-output result-vector-type)])
            (has-item core/NativeId)
            (state-id entered owner (str callee "-has-item"))
            (compared BodyStateV0)
            (state-emit (state-bump entered)
              (core/->CompareInstruction
                (core/->SsaValueV0 has-item (bool-type-id))
                (core/->CompareLtI64V0 true)
                header-index length-id))
            (branched BodyStateV0)
            (state-open-block
              (state-close compared
                (core/->BranchTerminator has-item body-id exit-id))
              body-id [])
            (item-id core/NativeId)
            (state-id branched owner (str callee "-item"))
            (isolated BodyStateV0)
            (state-enter-inline-callback
              (state-emit (state-bump branched)
                (core/->VecGetInstruction
                  (core/->SsaValueV0 item-id element-type)
                  collection-id header-index)))
            (callback-result ExprResultV0)
            (if (accessorhitv0-found callback-accessor)
              (let [(result-id core/NativeId)
                    (state-id isolated owner "mapv-accessor")]
                (->ExprResultV0
                  (state-emit (state-bump isolated)
                    (core/->FieldInstruction
                      (core/->SsaValueV0 result-id callback-return)
                      item-id (accessorhitv0-field-id callback-accessor)))
                  result-id callback-return false))
              (if (or (nil? callback-body)
                      (nil? callback-source-parameter))
                (fail-result isolated
                  (str "TODO-NATIVE-VECTOR-HOF-CALLBACK: " callee
                    " has no statically known callback body"))
                (let [(callback-state BodyStateV0)
                      (bind-source-parameter-value env owner isolated
                        callback-source-parameter 0 item-id element-type)]
                  (lower-contextual-boundary env owner callback-state callback-body
                    callback-return callback-return))))
            (restored BodyStateV0)
            (with
              (state-with-flow-context (exprresultv0-state callback-result)
                outer-locals outer-refinements outer-values)
              [:loop-frames outer-frames])]
        (cond
          (state-blocked? restored) (dead-result restored)

          (exprresultv0-terminated callback-result)
          (fail-result restored
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-DIVERGES: " callee
              " callback does not produce a value"))

          (not (same-id? callback-return
                 (exprresultv0-type-id callback-result)))
          (fail-result restored
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-RESULT: " callee
              " callback body does not produce its declared type"))

          :else
          (let [(one-id core/NativeId)
                (state-id restored owner (str callee "-one"))
                (with-one BodyStateV0)
                (state-emit (state-bump restored)
                  (core/->AtomInstruction
                    (core/->SsaValueV0 one-id (int-type-id))
                    (core/->I64Atom 1)))
                (next-index ExprResultV0)
                (lower-checked-arith with-one owner "+" header-index one-id)
                (next-state BodyStateV0) (exprresultv0-state next-index)]
            (if (state-blocked? next-state)
              (dead-result next-state)
              (if mapping
                (let [(next-output core/NativeId)
                      (state-id next-state owner "mapv-next-output")
                      (pushed BodyStateV0)
                      (state-emit (state-bump next-state)
                        (core/->VecPushInstruction
                          (core/->SsaValueV0 next-output result-vector-type)
                          header-output
                          (exprresultv0-value-id callback-result)
                          (arena-value-id owner)))]
                  (->ExprResultV0
                    (state-open-block
                      (state-close pushed
                        (core/->JumpTerminator header-id
                          [(exprresultv0-value-id next-index) next-output]))
                      exit-id [])
                    header-output result-vector-type false))
                (let [(keep-id core/NativeId)
                      (state-id next-state owner "filterv-keep")
                      (skip-id core/NativeId)
                      (state-id next-state owner "filterv-skip")
                      (next-output core/NativeId)
                      (state-id next-state owner "filterv-next-output")
                      (selected BodyStateV0)
                      (state-close (state-bump next-state)
                        (core/->BranchTerminator
                          (exprresultv0-value-id callback-result)
                          keep-id skip-id))
                      (kept BodyStateV0)
                      (state-close
                        (state-emit (state-open-block selected keep-id [])
                          (core/->VecPushInstruction
                            (core/->SsaValueV0 next-output result-vector-type)
                            header-output item-id (arena-value-id owner)))
                        (core/->JumpTerminator header-id
                          [(exprresultv0-value-id next-index) next-output]))
                      (skipped BodyStateV0)
                      (state-close
                        (state-open-block kept skip-id [])
                        (core/->JumpTerminator header-id
                          [(exprresultv0-value-id next-index) header-output]))]
                  (->ExprResultV0
                    (state-open-block skipped exit-id [])
                    header-output result-vector-type false))))))))))

(defn lower-eager-vector-predicate
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (callback-body core/NativeId)
   (callback-source-parameter core/NativeId)
   (callback-return core/NativeId)
   (element-type core/NativeId)
   (collection-id core/NativeId)]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (every-mode Bool) (= "every?" callee)
        (callback-variants (Vec core/TypeVariant))
        (union-variants-of types callback-return)
        (optional-result (U core/NativeId Nil))
        (if every-mode
          nil
          (if (= 1 (nil-variant-count callback-variants))
            callback-return
            (optional-scalar-type-of types callback-return)))
        (result-type core/NativeId)
        (if every-mode
          (bool-type-id)
          (if (nil? optional-result)
            (type-id "LowerFailure")
            optional-result))
        (result-variants (Vec core/TypeVariant))
        (if every-mode [] (union-variants-of types result-type))]
    (cond
      (and (not every-mode) (nil? optional-result))
      (fail-result state
        "TODO-NATIVE-SOME-RESULT-TYPE: the callback type has no nullable native result")

      (and (not every-mode) (not (= 1 (nil-variant-count result-variants))))
      (fail-result state
        "TODO-NATIVE-SOME-RESULT-TYPE: the result needs one nil alternative")

      :else
      (let [(outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
            (outer-frames (Vec LoopFrameV0)) (bodystatev0-loop-frames state)
            (outer-refinements (Vec KeywordFlowRefinementV0))
            (bodystatev0-keyword-refinements state)
            (outer-values (Vec ValueFlowRefinementV0))
            (bodystatev0-value-refinements state)
            (length-id core/NativeId) (state-id state owner (str callee "-length"))
            (zero-id core/NativeId) (state-id state owner (str callee "-zero"))
            (header-id core/NativeId) (state-id state owner (str callee "-header"))
            (body-id core/NativeId) (state-id state owner (str callee "-body"))
            (exhausted-id core/NativeId)
            (state-id state owner (str callee "-exhausted"))
            (continue-id core/NativeId)
            (state-id state owner (str callee "-continue"))
            (terminal-id core/NativeId)
            (state-id state owner (str callee "-terminal"))
            (join-id core/NativeId) (state-id state owner (str callee "-join"))
            (join-value core/NativeId) (state-id state owner (str callee "-result"))
            (header-index core/NativeId) (state-id state owner (str callee "-index"))
            (prepared BodyStateV0)
            (state-emit
              (state-emit (state-bump state)
                (core/->VecLengthInstruction
                  (core/->SsaValueV0 length-id (int-type-id)) collection-id))
              (core/->AtomInstruction
                (core/->SsaValueV0 zero-id (int-type-id))
                (core/->I64Atom 0)))
            (entered BodyStateV0)
            (state-open-block
              (state-close (state-bump prepared)
                (core/->JumpTerminator header-id [zero-id]))
              header-id [(core/->Parameter header-index (int-type-id))])
            (has-item core/NativeId)
            (state-id entered owner (str callee "-has-item"))
            (compared BodyStateV0)
            (state-emit (state-bump entered)
              (core/->CompareInstruction
                (core/->SsaValueV0 has-item (bool-type-id))
                (core/->CompareLtI64V0 true) header-index length-id))
            (branched BodyStateV0)
            (state-open-block
              (state-close compared
                (core/->BranchTerminator has-item body-id exhausted-id))
              body-id [])
            (item-id core/NativeId)
            (state-id branched owner (str callee "-item"))
            (isolated BodyStateV0)
            (state-enter-inline-callback
              (state-emit (state-bump branched)
                (core/->VecGetInstruction
                  (core/->SsaValueV0 item-id element-type)
                  collection-id header-index)))
            (callback-state BodyStateV0)
            (bind-source-parameter-value env owner isolated
              callback-source-parameter 0 item-id element-type)
            (callback-result ExprResultV0)
            (lower-contextual-boundary env owner callback-state callback-body
              callback-return callback-return)
            (callback-outer-state BodyStateV0)
            (with
              (state-with-flow-context (exprresultv0-state callback-result)
                outer-locals outer-refinements outer-values)
              [:loop-frames outer-frames])]
        (cond
          (state-blocked? callback-outer-state) (dead-result callback-outer-state)

          (exprresultv0-terminated callback-result)
          (fail-result callback-outer-state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-DIVERGES: " callee
              " callback does not produce a value"))

          (not (same-id? callback-return
                 (exprresultv0-type-id callback-result)))
          (fail-result callback-outer-state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-RESULT: " callee
              " callback body does not produce its declared type"))

          :else
          (let [(condition ExprResultV0)
                (if every-mode
                  callback-result
                  (lower-truthy types owner
                    (exprresultv0-state callback-result)
                    (exprresultv0-value-id callback-result)
                    (exprresultv0-type-id callback-result)))
                (restored BodyStateV0)
                (with
                  (state-with-flow-context (exprresultv0-state condition)
                    outer-locals outer-refinements outer-values)
                  [:loop-frames outer-frames])]
            (if (state-blocked? restored)
              (dead-result restored)
              (let [(one-id core/NativeId)
                    (state-id restored owner (str callee "-one"))
                    (with-one BodyStateV0)
                    (state-emit (state-bump restored)
                      (core/->AtomInstruction
                        (core/->SsaValueV0 one-id (int-type-id))
                        (core/->I64Atom 1)))
                    (next-index ExprResultV0)
                    (lower-checked-arith with-one owner "+" header-index one-id)
                    (next-state BodyStateV0)
                    (exprresultv0-state next-index)]
                (if (state-blocked? next-state)
                  (dead-result next-state)
                  (let [(selected BodyStateV0)
                    (state-close (state-bump next-state)
                      (core/->BranchTerminator
                        (exprresultv0-value-id condition)
                        (if every-mode continue-id terminal-id)
                        (if every-mode terminal-id continue-id)))
                    (continued BodyStateV0)
                    (state-close
                      (state-open-block selected continue-id [])
                      (core/->JumpTerminator header-id
                        [(exprresultv0-value-id next-index)]))]
                (if every-mode
                  (let [(false-id core/NativeId)
                        (state-id continued owner "every-false")
                        (terminal BodyStateV0)
                        (state-close
                          (state-emit
                            (state-open-block continued terminal-id [])
                            (core/->AtomInstruction
                              (core/->SsaValueV0 false-id (bool-type-id))
                              (core/->BoolAtom false)))
                          (core/->JumpTerminator join-id [false-id]))
                        (true-id core/NativeId)
                        (state-id terminal owner "every-true")
                        (exhausted BodyStateV0)
                        (state-close
                          (state-emit
                            (state-open-block terminal exhausted-id [])
                            (core/->AtomInstruction
                              (core/->SsaValueV0 true-id (bool-type-id))
                              (core/->BoolAtom true)))
                          (core/->JumpTerminator join-id [true-id]))]
                    (->ExprResultV0
                      (state-open-block exhausted join-id
                        [(core/->Parameter join-value result-type)])
                      join-value result-type false))
                  (let [(terminal-open BodyStateV0)
                        (state-open-block continued terminal-id [])
                        (hit ExprResultV0)
                        (lower-boundary-coerce types owner terminal-open
                          (exprresultv0-value-id callback-result)
                          callback-return result-type)
                        (hit-state BodyStateV0) (exprresultv0-state hit)]
                    (if (state-blocked? hit-state)
                      (dead-result hit-state)
                      (let [(terminal BodyStateV0)
                            (state-close hit-state
                              (core/->JumpTerminator join-id
                                [(exprresultv0-value-id hit)]))
                            (miss ExprResultV0)
                            (lower-nil-union-value types owner
                              (state-open-block terminal exhausted-id [])
                              result-type)
                            (miss-state BodyStateV0) (exprresultv0-state miss)]
                        (if (state-blocked? miss-state)
                          (dead-result miss-state)
                          (let [(exhausted BodyStateV0)
                                (state-close miss-state
                                  (core/->JumpTerminator join-id
                                    [(exprresultv0-value-id miss)]))]
                            (->ExprResultV0
                              (state-open-block exhausted join-id
                                [(core/->Parameter join-value result-type)])
                              join-value result-type false)))))))))))))))))

(defn lower-eager-vector-accessor-map
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (collection-node core/NativeId)
   (accessor AccessorHitV0)]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (element-type core/NativeId) (accessorhitv0-owner-type accessor)
        (return-type core/NativeId) (accessorhitv0-field-type accessor)
        (collection-type (U core/NativeId Nil))
        (vector-type-of types element-type)]
    (cond
      (not (= "mapv" callee))
      (fail-result state
        (str "TODO-NATIVE-VECTOR-HOF-CALLBACK: " callee
          " requires an anonymous function literal"))

      (nil? collection-type)
      (fail-result state
        (str "TODO-NATIVE-VECTOR-HOF-COLLECTION-TYPE: " callee
          " callback element has no declared Vec carrier"))

      :else
      (let [(collection ExprResultV0)
            (lower-contextual-boundary env owner state collection-node
              collection-type collection-type)
            (collection-state BodyStateV0) (exprresultv0-state collection)]
        (cond
          (exprresultv0-terminated collection) collection
          (state-blocked? collection-state) (dead-result collection-state)

          (not (vector-type? types (exprresultv0-type-id collection)))
          (fail-result collection-state
            (str "TODO-NATIVE-VECTOR-HOF-COLLECTION: " callee
              " requires a closed native Vec"))

          (not (same-id? element-type
                 (vector-element-of types (exprresultv0-type-id collection))))
          (fail-result collection-state
            (str "TODO-NATIVE-VECTOR-HOF-ELEMENT: " callee
              " vector element must match its callback parameter"))

          :else
          (lower-eager-vector-collect env owner collection-state callee
            nil nil accessor return-type element-type
            (exprresultv0-value-id collection)
            (exprresultv0-type-id collection)))))))

(defn lower-eager-vector-hof
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (callee String)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)]
    (if (not (= 2 (count args)))
      (fail-result state
        (str "TODO-NATIVE-VECTOR-HOF-ARITY: " callee
          " lowers only as (" callee " fn vector)"))
      (let [(callback-node core/NativeId) (nth args 0)
            (callback-kind String) (fact-text index callback-node "form-kind")
            (callback-name String) (fact-text index callback-node "name")
            (callback-accessor AccessorHitV0)
            (if (= "ref" callback-kind)
              (record-accessor types
                (resolve-source-name index
                  (source-module-name index callback-node) callback-name))
              (accessor-miss))
            (callback-variadic Bool)
            (not (nil? (index-first-object index callback-node "rest")))
            (callback-body (U core/NativeId Nil))
            (index-first-object index callback-node "body")
            (callback-return-source (U core/NativeId Nil))
            (index-first-object index callback-node "ret")
            (callback-source-parameters (Vec core/NativeId))
            (function-parameter-items index callback-node)
            (callback-owner core/NativeId)
            (state-id state owner (str callee "-callback"))
            (callback-resolution ParameterResolutionV0)
            (resolve-parameters index callback-node callback-owner)
            (callback-parameters (Vec core/Parameter))
            (parameterresolutionv0-parameters callback-resolution)]
        (cond
          (accessorhitv0-found callback-accessor)
          (lower-eager-vector-accessor-map env owner state callee
            (nth args 1) callback-accessor)

          (not (= "fn" callback-kind))
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK: " callee
              " requires an anonymous function literal"))

          callback-variadic
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-VARIADIC: " callee
              " callbacks must have fixed arity"))

          (or (not (= 1 (count callback-source-parameters)))
              (not (= 1 (count callback-parameters))))
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-ARITY: " callee
              " callbacks take exactly one vector element"))

          (not (parameterresolutionv0-valid callback-resolution))
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-TYPES: " callee
              " callback parameters need closed native types"))

          (nil? callback-body)
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-BODY: " callee
              " callback needs exactly one body form"))

          (nil? callback-return-source)
          (fail-result state
            (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-RETURN: " callee
              " callback needs a closed return annotation"))

          :else
          (let [(callback-return-resolution TypeResolutionV0)
                (resolve-source-type index callback-return-source)
                (callback-return core/NativeId)
                (typeresolutionv0-type-id callback-return-resolution)
                (element-type core/NativeId)
                (core/parameter-type-id (nth callback-parameters 0))]
            (cond
              (not (typeresolutionv0-valid callback-return-resolution))
              (fail-result state
                (str "TODO-NATIVE-VECTOR-HOF-CALLBACK-RETURN: " callee
                  " callback return is not a closed native type"))

              (and (or (= "filterv" callee) (= "every?" callee))
                (not (same-id? callback-return (bool-type-id))))
              (fail-result state
                (str "TODO-NATIVE-VECTOR-HOF-PREDICATE: " callee
                  " callback must declare Bool"))

              :else
              (let [(collection-type (U core/NativeId Nil))
                    (vector-type-of types element-type)]
                (if (nil? collection-type)
                  (fail-result state
                    (str "TODO-NATIVE-VECTOR-HOF-COLLECTION-TYPE: " callee
                      " callback element has no declared Vec carrier"))
                  (let [(collection ExprResultV0)
                        (lower-contextual-boundary env owner state (nth args 1)
                          collection-type collection-type)
                        (collection-state BodyStateV0)
                        (exprresultv0-state collection)]
                    (cond
                      (exprresultv0-terminated collection) collection

                      (state-blocked? collection-state)
                      (dead-result collection-state)

                      (not (vector-type? types (exprresultv0-type-id collection)))
                      (fail-result collection-state
                        (str "TODO-NATIVE-VECTOR-HOF-COLLECTION: " callee
                          " requires a closed native Vec"))

                      (not (same-id? element-type
                             (vector-element-of types
                               (exprresultv0-type-id collection))))
                      (fail-result collection-state
                        (str "TODO-NATIVE-VECTOR-HOF-ELEMENT: " callee
                          " vector element must match its callback parameter"))

                      (or (= "mapv" callee) (= "filterv" callee))
                      (lower-eager-vector-collect env owner collection-state callee
                        callback-body (nth callback-source-parameters 0)
                        (accessor-miss) callback-return
                        element-type (exprresultv0-value-id collection)
                        (exprresultv0-type-id collection))

                      :else
                      (lower-eager-vector-predicate env owner collection-state callee
                        callback-body (nth callback-source-parameters 0)
                        callback-return
                        element-type
                        (exprresultv0-value-id collection)))))))))))))

(defn lower-static-update-value
  [(env BodyEnvV0)
   (owner core/NativeId)
   (container ExprResultV0)
   (key-node core/NativeId)
   (updater-node core/NativeId)]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (state BodyStateV0) (exprresultv0-state container)
        (updater-kind String) (fact-text index updater-node "form-kind")
        (updater-variadic Bool)
        (not (nil? (index-first-object index updater-node "rest")))
        (updater-body (U core/NativeId Nil))
        (index-first-object index updater-node "body")
        (updater-return-source (U core/NativeId Nil))
        (index-first-object index updater-node "ret")
        (updater-source-parameters (Vec core/NativeId))
        (function-parameter-items index updater-node)
        (updater-owner core/NativeId)
        (state-id state owner "update-callback")
        (updater-resolution ParameterResolutionV0)
        (resolve-parameters index updater-node updater-owner)
        (updater-parameters (Vec core/Parameter))
        (parameterresolutionv0-parameters updater-resolution)]
    (cond
      (exprresultv0-terminated container) container
      (state-blocked? state) (dead-result state)

      (not (= "fn" updater-kind))
      (fail-result state
        "TODO-NATIVE-UPDATE-UPDATER: update requires an inline statically known function literal")

      updater-variadic
      (fail-result state
        "TODO-NATIVE-UPDATE-VARIADIC: update functions must have fixed arity")

      (or (not (= 1 (count updater-source-parameters)))
          (not (= 1 (count updater-parameters))))
      (fail-result state
        "TODO-NATIVE-UPDATE-UPDATER-ARITY: the update function takes the current value")

      (not (parameterresolutionv0-valid updater-resolution))
      (fail-result state
        "TODO-NATIVE-UPDATE-UPDATER-TYPES: the update parameter needs a closed native type")

      (nil? updater-body)
      (fail-result state
        "TODO-NATIVE-UPDATE-UPDATER-BODY: the update function needs exactly one body form")

      (nil? updater-return-source)
      (fail-result state
        "TODO-NATIVE-UPDATE-UPDATER-RETURN: the update function needs a closed return annotation")

      :else
      (let [(updater-return TypeResolutionV0)
            (resolve-source-type index updater-return-source)
            (container-type core/NativeId) (exprresultv0-type-id container)
            (map-container Bool) (map-type? types container-type)
            (record-container Bool) (record-type? types container-type)
            (key ExprResultV0)
            (if record-container
              (->ExprResultV0 state
                (state-id state owner "update-record-key")
                (keyword-type-id) false)
              (lower-expr env owner state key-node))
            (current BodyStateV0) (exprresultv0-state key)
            (keyword-literal Bool)
            (and (= "literal" (fact-text index key-node "form-kind"))
              (= "keyword" (fact-text index key-node "literal-kind")))
            (accessor AccessorHitV0)
            (if (and record-container keyword-literal)
              (record-keyword-field types container-type
                (fact-text index key-node "value"))
              (accessor-miss))
            (key-type core/NativeId)
            (if map-container
              (map-key-of types container-type)
              (keyword-type-id))
            (value-type core/NativeId)
            (cond
              map-container (map-value-of types container-type)
              (accessorhitv0-found accessor)
              (accessorhitv0-field-type accessor)
              :else (type-id "LowerFailure"))
            (updater-input (U core/NativeId Nil))
            (if map-container
              (nullable-value-type-of types value-type)
              (if (accessorhitv0-found accessor) value-type nil))
            (equality (U core/ConcreteEqualityV0 Nil))
            (if map-container
              (map-key-equality-for types key-type)
              (core/->KeywordEqualityV0 true))]
        (cond
          (not (typeresolutionv0-valid updater-return))
          (fail-result current
            "TODO-NATIVE-UPDATE-UPDATER-RETURN: the update return is not a closed native type")

          (exprresultv0-terminated key) key
          (state-blocked? current) (dead-result current)

          (not (or map-container record-container))
          (fail-result current
            "TODO-NATIVE-UPDATE-CONTAINER: update lowers a closed Map or Record")

          (and record-container (not keyword-literal))
          (fail-result current
            "TODO-NATIVE-UPDATE-RECORD-KEY: record update needs a literal keyword field")

          (and record-container (not (accessorhitv0-found accessor)))
          (fail-result current
            "TODO-NATIVE-UPDATE-RECORD-FIELD: the keyword is not a field of the closed record")

          (and map-container
            (not (same-id? key-type (exprresultv0-type-id key))))
          (fail-result current
            "TODO-NATIVE-UPDATE-KEY: the key does not match the map key type")

          (nil? equality)
          (fail-result current
            "TODO-NATIVE-MAP-KEY-EQUALITY: update needs closed concrete key equality")

          (and map-container (record-type? types value-type))
          (fail-result current
            "TODO-NATIVE-UPDATE-RECORD-VALUE: nullable record values need an explicit borrow or arena boxing seam")

          (nil? updater-input)
          (fail-result current
            "TODO-NATIVE-UPDATE-ABSENCE: map update needs a closed value-or-nil input type")

          (not (same-id?
                 (core/parameter-type-id (nth updater-parameters 0))
                 updater-input))
          (fail-result current
            (if map-container
              "TODO-NATIVE-UPDATE-UPDATER-INPUT: map update takes exactly (U Value Nil)"
              "TODO-NATIVE-UPDATE-UPDATER-INPUT: record update takes exactly the field type"))

          (not (same-id?
                 (typeresolutionv0-type-id updater-return)
                 value-type))
          (fail-result current
            "TODO-NATIVE-UPDATE-UPDATER-RESULT: the update return must exactly match the stored value type")

          :else
          (let [(current-id core/NativeId)
                (state-id current owner "update-current")
                (read BodyStateV0)
                (if map-container
                  (state-emit (state-bump current)
                    (core/->MapGetInstructionV0
                      (core/->SsaValueV0 current-id updater-input)
                      (exprresultv0-value-id container)
                      (exprresultv0-value-id key) nil equality))
                  (state-emit (state-bump current)
                    (core/->FieldInstruction
                      (core/->SsaValueV0 current-id updater-input)
                      (exprresultv0-value-id container)
                      (accessorhitv0-field-id accessor))))
                (outer-locals (Vec LocalBindingV0)) (bodystatev0-locals read)
                (outer-frames (Vec LoopFrameV0)) (bodystatev0-loop-frames read)
                (outer-refinements (Vec KeywordFlowRefinementV0))
                (bodystatev0-keyword-refinements read)
                (outer-values (Vec ValueFlowRefinementV0))
                (bodystatev0-value-refinements read)
                (updater-state BodyStateV0)
                (bind-source-parameter-value env owner
                  (state-enter-inline-callback read)
                  (nth updater-source-parameters 0) 0 current-id updater-input)
                (updater-result ExprResultV0)
                (lower-expr env owner updater-state updater-body)
                (restored BodyStateV0)
                (with
                  (state-with-flow-context (exprresultv0-state updater-result)
                    outer-locals outer-refinements outer-values)
                  [:loop-frames outer-frames])]
            (cond
              (state-blocked? restored) (dead-result restored)

              (exprresultv0-terminated updater-result)
              (fail-result restored
                "TODO-NATIVE-UPDATE-UPDATER-DIVERGES: the inline updater does not produce a value")

              (not (same-id? value-type
                     (exprresultv0-type-id updater-result)))
              (fail-result restored
                "TODO-NATIVE-UPDATE-UPDATER-BODY-RESULT: the update body does not produce its declared stored value type")

              :else
              (let [(result-id core/NativeId)
                    (state-id restored owner "update-result")
                    (guarded BodyStateV0)
                    (if record-container
                      (guard-record-field-value env owner restored container-type
                        (fact-text index key-node "value")
                        (exprresultv0-value-id updater-result)
                        (exprresultv0-type-id updater-result))
                      restored)]
                (if (state-blocked? guarded)
                  (dead-result guarded)
                  (->ExprResultV0
                    (state-emit (state-bump guarded)
                      (if map-container
                        (core/->MapAssocInstructionV0
                          (core/->SsaValueV0 result-id container-type)
                          (exprresultv0-value-id container)
                          (exprresultv0-value-id key)
                          (exprresultv0-value-id updater-result)
                          (arena-value-id owner) equality)
                        (core/->RecordAssocInstructionV0
                          (core/->SsaValueV0 result-id container-type)
                          (exprresultv0-value-id container)
                          (accessorhitv0-field-id accessor)
                          (exprresultv0-value-id updater-result)
                          (arena-value-id owner))))
                    result-id container-type false))))))))))

(defn match-pattern-kind [(index SourceIndexV0) (pattern core/NativeId)] String
  (fact-text index pattern "pattern-kind"))

(defn match-clause-pattern
  [(index SourceIndexV0) (clause core/NativeId)] (U core/NativeId Nil)
  (index-first-object index clause "pattern"))

(defn match-clause-body
  [(index SourceIndexV0) (clause core/NativeId)] (U core/NativeId Nil)
  (index-first-object index clause "body"))

(defn match-pattern-irrefutable?
  [(index SourceIndexV0) (pattern core/NativeId)] Bool
  (let [(kind String) (match-pattern-kind index pattern)]
    (or (= "wildcard" kind) (= "var" kind))))

(defn match-literal-supported?
  [(index SourceIndexV0) (pattern core/NativeId)] Bool
  (let [(kind String) (fact-text index pattern "literal-kind")]
    (or (= "number" kind) (= "int" kind) (= "bool" kind)
      (= "string" kind) (= "keyword" kind) (= "nil" kind))))

(defn match-pattern-supported?
  [(index SourceIndexV0) (pattern core/NativeId)] Bool
  (let [(kind String) (match-pattern-kind index pattern)]
    (cond
      (= "literal" kind) (match-literal-supported? index pattern)
      (= "record" kind) (> (count (fact-text index pattern "name")) 0)
      (= "wildcard" kind) true
      (= "var" kind) (> (count (fact-text index pattern "name")) 0)
      :else false)))

(defn match-record-type-id
  [(env BodyEnvV0)
   (owner core/NativeId)
   (pattern core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (spelling String) (fact-text index pattern "name")
        (resolved ResolvedSourceNameV0)
        (resolve-source-name index (source-module-name index pattern) spelling)
        (candidate core/NativeId) (source-type-id (resolved-source-key resolved))
        (definition (U core/TypeDef Nil))
        (if (resolvedsourcenamev0-visible resolved)
          (lookup-type (bodyenvv0-types env) candidate)
          nil)]
    (if (and (some? definition)
          (instance? native.core.RecordType (core/typedef-shape definition)))
      candidate
      nil)))

(defn union-variant-named
  [(types (Vec core/TypeDef))
   (target-type core/NativeId)
   (name String)]
  (U core/TypeVariant Nil)
  (let [(wanted String) (source-host-variant-role target-type name)
        (variants (Vec core/TypeVariant))
        (union-variants-of types target-type)]
    (loop [(position Int) 0]
      (if (>= position (count variants))
        nil
        (if (= wanted (core/typevariant-name (nth variants position)))
          (nth variants position)
          (recur (+ position 1)))))))

(defn variant-record-type-id
  [(types (Vec core/TypeDef)) (variant core/TypeVariant)] (U core/NativeId Nil)
  (let [(payload (U core/NativeId Nil)) (core/typevariant-payload-type variant)
        (definition (U core/TypeDef Nil))
        (if (nil? payload) nil (lookup-type types payload))]
    (if (nil? definition)
      nil
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.ReferenceType shape)
          (core/referencetype-target-type shape)
          nil)))))

(defn match-record-type-id-for-target
  [(env BodyEnvV0)
   (owner core/NativeId)
   (target-type core/NativeId)
   (pattern core/NativeId)]
  (U core/NativeId Nil)
  (let [(resolved (U core/NativeId Nil))
        (match-record-type-id env owner pattern)]
    (if (some? resolved)
      resolved
      (let [(index SourceIndexV0) (bodyenvv0-index env)
            (variant (U core/TypeVariant Nil))
            (union-variant-named (bodyenvv0-types env) target-type
              (fact-text index pattern "name"))]
        (if (nil? variant)
          nil
          (variant-record-type-id (bodyenvv0-types env) variant))))))

(defn match-record-variant-id
  [(env BodyEnvV0)
   (owner core/NativeId)
   (target-type core/NativeId)
   (pattern core/NativeId)]
  (U core/NativeId Nil)
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (named (U core/TypeVariant Nil))
        (union-variant-named (bodyenvv0-types env) target-type
          (fact-text index pattern "name"))]
    (if (some? named)
      (core/typevariant-id named)
      (let [(record-type (U core/NativeId Nil))
            (match-record-type-id env owner pattern)]
        (if (nil? record-type)
          nil
          (let [(hit NarrowHitV0)
                (reference-variant-for
                  (bodyenvv0-types env) target-type record-type)]
            (if (narrowhitv0-found hit)
              (narrowhitv0-variant-id hit)
              nil)))))))

(defn native-id-count [(ids (Vec core/NativeId)) (target core/NativeId)] Int
  (loop [(position Int) 0 (found Int) 0]
    (if (>= position (count ids))
      found
      (recur (+ position 1)
        (+ found (if (same-id? target (nth ids position)) 1 0))))))

;; Without an irrefutable arm, every sealed tag must name exactly one record arm.
(defn match-record-patterns-exhaustive?
  [(env BodyEnvV0)
   (owner core/NativeId)
   (target-type core/NativeId)
   (clauses (Vec core/NativeId))]
  Bool
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (variants (Vec core/TypeVariant))
        (union-variants-of (bodyenvv0-types env) target-type)
        (direct-record Bool)
        (record-type? (bodyenvv0-types env) target-type)]
    (if direct-record
      (and (= 1 (count clauses))
        (let [(pattern (U core/NativeId Nil))
              (match-clause-pattern index (nth clauses 0))]
          (and (some? pattern)
            (= "record" (match-pattern-kind index pattern))
            (let [(record-type (U core/NativeId Nil))
                  (match-record-type-id-for-target
                    env owner target-type pattern)]
              (and (some? record-type) (same-id? target-type record-type))))))
      (if (= 0 (count variants))
        false
        (let [(pattern-variants (Vec core/NativeId))
              (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
                (if (>= position (count clauses))
                  collected
                  (let [(pattern (U core/NativeId Nil))
                        (match-clause-pattern index (nth clauses position))]
                    (if (or (nil? pattern)
                          (not (= "record" (match-pattern-kind index pattern))))
                      []
                      (let [(variant (U core/NativeId Nil))
                            (match-record-variant-id env owner target-type pattern)]
                        (if (nil? variant)
                          []
                          (recur (+ position 1) (conj collected variant))))))))]
          (and (= (count pattern-variants) (count variants))
            (loop [(position Int) 0]
              (if (>= position (count variants))
                true
                (if (= 1 (native-id-count pattern-variants
                           (core/typevariant-id (nth variants position))))
                  (recur (+ position 1))
                  false)))))))))

(defn match-structure-failure
  [(env BodyEnvV0)
   (owner core/NativeId)
   (target-type core/NativeId)
   (clauses (Vec core/NativeId))]
  String
  (let [(index SourceIndexV0) (bodyenvv0-index env)]
    (if (= 0 (count clauses))
      "TODO-NATIVE-MATCH-CLAUSES: match needs at least one clause"
      (loop [(position Int) 0]
        (if (>= position (count clauses))
          (let [(last-pattern (U core/NativeId Nil))
                (match-clause-pattern index (nth clauses (- (count clauses) 1)))]
            (if (or
                  (and (some? last-pattern)
                    (match-pattern-irrefutable? index last-pattern))
                  (match-record-patterns-exhaustive? env owner target-type clauses))
              ""
              "TODO-NATIVE-MATCH-NONEXHAUSTIVE: patterns do not cover the sealed target type"))
          (let [(clause core/NativeId) (nth clauses position)
                (pattern (U core/NativeId Nil))
                (match-clause-pattern index clause)
                (body (U core/NativeId Nil)) (match-clause-body index clause)]
            (cond
              (or (nil? pattern) (nil? body))
              "TODO-NATIVE-MATCH-CLAUSE: every match clause needs a pattern and body"

              (not (match-pattern-supported? index pattern))
              (str "TODO-NATIVE-MATCH-PATTERN: no native lowering for "
                (match-pattern-kind index pattern))

              (and (< (+ position 1) (count clauses))
                (match-pattern-irrefutable? index pattern))
              "TODO-NATIVE-MATCH-IRREFUTABLE-ORDER: wildcard or variable pattern must be final"

              :else (recur (+ position 1)))))))))

(defn lower-match-literal
  [(index SourceIndexV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (pattern core/NativeId)]
  ExprResultV0
  (let [(kind String) (fact-text index pattern "literal-kind")
        (text String) (fact-text index pattern "value")
        (result-id core/NativeId) (state-id state owner "match-literal")]
    (cond
      (or (= "number" kind) (= "int" kind))
      (let [(parsed (U Int Nil)) (parse-int-text text)]
        (if (nil? parsed)
          (fail-result state
            "TODO-NATIVE-MATCH-LITERAL: number pattern is not an exact Int")
          (->ExprResultV0
            (state-emit (state-bump state)
              (core/->AtomInstruction
                (core/->SsaValueV0 result-id (int-type-id))
                (core/->I64Atom parsed)))
            result-id (int-type-id) false)))

      (= "bool" kind)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->AtomInstruction
            (core/->SsaValueV0 result-id (bool-type-id))
            (core/->BoolAtom (= "true" text))))
        result-id (bool-type-id) false)

      (= "string" kind)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->AtomInstruction
            (core/->SsaValueV0 result-id (text-type-id))
            (core/->TextAtom text)))
        result-id (text-type-id) false)

      (= "keyword" kind)
      (->ExprResultV0
        (state-emit (state-bump state)
          (core/->AtomInstruction
            (core/->SsaValueV0 result-id (keyword-type-id))
            (core/->KeywordAtom text)))
        result-id (keyword-type-id) false)

      (= "nil" kind)
      (fail-result state
        "TODO-NATIVE-MATCH-LITERAL: nil is tested by its sealed union tag")

      :else
      (fail-result state
        (str "TODO-NATIVE-MATCH-LITERAL: no native literal for " kind)))))

(defn lower-union-variant-test
  [(types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (value-id core/NativeId)
   (value-type core/NativeId)
   (expected core/NativeId)]
  ExprResultV0
  (let [(variants (Vec core/TypeVariant)) (union-variants-of types value-type)
        (true-id core/NativeId) (state-id state owner "match-record-true")
        (false-id core/NativeId) (state-id state owner "match-record-false")
        (join-id core/NativeId) (state-id state owner "match-record-join")
        (join-parameter core/NativeId) (state-id state owner "match-record-value")
        (true-value core/NativeId) (state-id state owner "match-record-yes")
        (false-value core/NativeId) (state-id state owner "match-record-no")
        (cases (Vec core/SwitchCaseV0))
        (mapv
          (fn [(variant core/TypeVariant)] core/SwitchCaseV0
            (core/->SwitchCaseV0 (core/typevariant-id variant)
              (if (same-id? expected (core/typevariant-id variant))
                true-id false-id)
              []))
          variants)
        (switched BodyStateV0)
        (state-close (state-bump state)
          (core/->SwitchTerminator value-id cases))
        (true-block BodyStateV0)
        (state-close
          (state-emit (state-open-block switched true-id [])
            (core/->AtomInstruction
              (core/->SsaValueV0 true-value (bool-type-id))
              (core/->BoolAtom true)))
          (core/->JumpTerminator join-id [true-value]))
        (false-block BodyStateV0)
        (state-close
          (state-emit (state-open-block true-block false-id [])
            (core/->AtomInstruction
              (core/->SsaValueV0 false-value (bool-type-id))
              (core/->BoolAtom false)))
          (core/->JumpTerminator join-id [false-value]))]
    (if (= 0 (count variants))
      (fail-result state
        "TODO-NATIVE-MATCH-RECORD-TARGET: record pattern needs a sealed union target")
      (->ExprResultV0
        (state-open-block false-block join-id
          [(core/->Parameter join-parameter (bool-type-id))])
        join-parameter (bool-type-id) false))))

(defn lower-match-test
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target-id core/NativeId)
   (target-type core/NativeId)
   (pattern core/NativeId)]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (kind String) (match-pattern-kind index pattern)]
    (cond
      (= "literal" kind)
      (if (= "nil" (fact-text index pattern "literal-kind"))
        (lower-presence-predicate types owner state target-id target-type false)
        (let [(literal ExprResultV0)
              (lower-match-literal index owner state pattern)
              (current BodyStateV0) (exprresultv0-state literal)]
          (if (state-blocked? current)
            (dead-result current)
            (lower-native-equality types owner current target-id target-type
              (exprresultv0-value-id literal)
              (exprresultv0-type-id literal)))))

      (= "record" kind)
      (let [(variant (U core/TypeVariant Nil))
            (union-variant-named types target-type
              (fact-text index pattern "name"))]
        (if (some? variant)
          (lower-union-variant-test types owner state target-id target-type
            (core/typevariant-id variant))
          (let [(record-type (U core/NativeId Nil))
                (match-record-type-id-for-target env owner target-type pattern)]
            (cond
              (nil? record-type)
              (fail-result state
                (str "TODO-NATIVE-MATCH-RECORD: unknown closed record "
                  (fact-text index pattern "name")))

              (same-id? target-type record-type)
              (bool-constant-result state owner "match-record-direct" true)

              :else
              (let [(fallback-variant (U core/NativeId Nil))
                    (match-record-variant-id env owner target-type pattern)]
                (if (nil? fallback-variant)
                  (fail-result state
                    "TODO-NATIVE-MATCH-RECORD: record is not a target union alternative")
                  (lower-union-variant-test types owner state target-id target-type
                    fallback-variant)))))))

      :else
      (fail-result state
        (str "TODO-NATIVE-MATCH-PATTERN: no refutable test for " kind)))))

(defn record-fields-of
  [(types (Vec core/TypeDef)) (record-type core/NativeId)] (Vec core/TypeField)
  (let [(definition (U core/TypeDef Nil)) (lookup-type types record-type)]
    (if (nil? definition)
      []
      (let [(shape core/TypeShape) (core/typedef-shape definition)]
        (if (instance? native.core.RecordType shape)
          (core/recordtype-fields shape)
          [])))))

(defn record-field-named
  [(fields (Vec core/TypeField)) (name String)] (U core/TypeField Nil)
  (loop [(position Int) 0]
    (if (>= position (count fields))
      nil
      (if (= name (core/typefield-name (nth fields position)))
        (nth fields position)
        (recur (+ position 1))))))

(defn match-binding-field
  [(index SourceIndexV0)
   (fields (Vec core/TypeField))
   (binding core/NativeId)
   (position Int)]
  (U core/TypeField Nil)
  (let [(named String) (fact-text index binding "field")]
    (if (= "" named)
      (if (< position (count fields)) (nth fields position) nil)
      (record-field-named fields named))))

(defn bind-match-record-fields
  [(index SourceIndexV0)
   (types (Vec core/TypeDef))
   (owner core/NativeId)
   (state BodyStateV0)
   (target-id core/NativeId)
   (target-type core/NativeId)
   (record-type core/NativeId)
   (bindings (Vec core/NativeId))]
  BodyStateV0
  (if (= 0 (count bindings))
    state
    (let [(record ExprResultV0)
          (lower-boundary-coerce types owner state target-id target-type
            record-type)
          (current BodyStateV0) (exprresultv0-state record)
          (fields (Vec core/TypeField)) (record-fields-of types record-type)]
      (if (state-blocked? current)
        current
        (loop [(position Int) 0 (bound BodyStateV0) current]
          (if (or (>= position (count bindings)) (state-blocked? bound))
            bound
            (let [(binding core/NativeId) (nth bindings position)
                  (name String) (fact-text index binding "name")
                  (field (U core/TypeField Nil))
                  (match-binding-field index fields binding position)]
              (if (or (= "" name) (nil? field))
                (state-fail bound
                  "TODO-NATIVE-MATCH-BINDING: record binding does not name a declared field")
                (if (= "_" name)
                  (recur (+ position 1) bound)
                  (let [(value-id core/NativeId)
                        (state-id bound owner "match-field")]
                    (recur (+ position 1)
                      (state-bind
                        (state-emit (state-bump bound)
                          (core/->FieldInstruction
                            (core/->SsaValueV0 value-id
                              (core/typefield-type-id field))
                            (exprresultv0-value-id record)
                            (core/typefield-id field)))
                        name value-id
                        (core/typefield-type-id field)))))))))))))

(defn bind-match-direct-variant
  [(index SourceIndexV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target-id core/NativeId)
   (variant core/TypeVariant)
   (bindings (Vec core/NativeId))]
  BodyStateV0
  (let [(payload (U core/NativeId Nil))
        (core/typevariant-payload-type variant)]
    (cond
      (= 0 (count bindings)) state

      (nil? payload)
      (state-fail state
        "TODO-NATIVE-MATCH-BINDING: unit variant does not carry a binding")

      (not (= 1 (count bindings)))
      (state-fail state
        "TODO-NATIVE-MATCH-BINDING: scalar variant requires exactly one binding")

      :else
      (let [(binding core/NativeId) (nth bindings 0)
            (name String) (fact-text index binding "name")]
        (if (= "" name)
          (state-fail state
            "TODO-NATIVE-MATCH-BINDING: scalar variant binding needs a name")
          (if (= "_" name)
            state
            (let [(value-id core/NativeId)
                  (state-id state owner "match-variant-payload")]
              (state-bind
                (state-emit (state-bump state)
                  (core/->UnionExtractInstruction
                    (core/->SsaValueV0 value-id payload)
                    target-id (core/typevariant-id variant)))
                name value-id payload))))))))

(defn bind-match-pattern
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (target-id core/NativeId)
   (target-type core/NativeId)
   (pattern core/NativeId)]
  BodyStateV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (kind String) (match-pattern-kind index pattern)]
    (cond
      (= "var" kind)
      (let [(name String) (fact-text index pattern "name")]
        (if (= "_" name) state (state-bind state name target-id target-type)))

      (= "record" kind)
      (let [(bindings (Vec core/NativeId))
            (match-pattern-binding-items index pattern)
            (variant (U core/TypeVariant Nil))
            (union-variant-named types target-type
              (fact-text index pattern "name"))]
        (if (some? variant)
          (let [(record-type (U core/NativeId Nil))
                (variant-record-type-id types variant)]
            (if (nil? record-type)
              (bind-match-direct-variant index owner state target-id
                variant bindings)
              (bind-match-record-fields index types owner state target-id
                target-type record-type bindings)))
          (let [(record-type (U core/NativeId Nil))
                (match-record-type-id-for-target env owner target-type pattern)]
            (if (nil? record-type)
              (state-fail state
                (str "TODO-NATIVE-MATCH-RECORD: unknown closed record "
                  (fact-text index pattern "name")))
              (bind-match-record-fields index types owner state target-id
                target-type record-type bindings)))))

      :else state)))

(defn lower-eager-map-reduce-kv
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)]
    (if (not (= 3 (count args)))
      (fail-result state
        "TODO-NATIVE-REDUCE-KV-ARITY: reduce-kv lowers only as (reduce-kv fn init map)")
      (let [(callback-node core/NativeId) (nth args 0)
            (callback-kind String) (fact-text index callback-node "form-kind")
            (callback-variadic Bool)
            (not (nil? (index-first-object index callback-node "rest")))
            (callback-body (U core/NativeId Nil))
            (index-first-object index callback-node "body")
            (callback-return-source (U core/NativeId Nil))
            (index-first-object index callback-node "ret")
            (callback-source-parameters (Vec core/NativeId))
            (function-parameter-items index callback-node)
            (callback-owner core/NativeId)
            (state-id state owner "reduce-kv-callback")
            (callback-resolution ParameterResolutionV0)
            (resolve-parameters index callback-node callback-owner)
            (callback-parameters (Vec core/Parameter))
            (parameterresolutionv0-parameters callback-resolution)]
        (cond
          (not (= "fn" callback-kind))
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-CALLBACK: reduce-kv requires an anonymous function literal")

          callback-variadic
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-VARIADIC: reduce-kv callbacks must have fixed arity")

          (or (not (= 3 (count callback-source-parameters)))
              (not (= 3 (count callback-parameters))))
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-CALLBACK-ARITY: reduce-kv callbacks take accumulator, key, and value")

          (not (parameterresolutionv0-valid callback-resolution))
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-CALLBACK-TYPES: callback parameters need closed native types")

          (nil? callback-body)
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-CALLBACK-BODY: callback needs exactly one body form")

          (nil? callback-return-source)
          (fail-result state
            "TODO-NATIVE-REDUCE-KV-CALLBACK-RETURN: callback needs a closed return annotation")

          :else
          (let [(callback-return TypeResolutionV0)
                (resolve-source-type index callback-return-source)
                (accumulator-type core/NativeId)
                (core/parameter-type-id (nth callback-parameters 0))
                (key-type core/NativeId)
                (core/parameter-type-id (nth callback-parameters 1))
                (value-type core/NativeId)
                (core/parameter-type-id (nth callback-parameters 2))]
            (cond
              (not (typeresolutionv0-valid callback-return))
              (fail-result state
                "TODO-NATIVE-REDUCE-KV-CALLBACK-RETURN: callback return is not a closed native type")

              (not (same-id? accumulator-type
                     (typeresolutionv0-type-id callback-return)))
              (fail-result state
                "TODO-NATIVE-REDUCE-KV-ACCUMULATOR: callback return must match its accumulator parameter")

              :else
                (let [(initial ExprResultV0)
                      (lower-contextual-boundary env owner state
                      (nth args 1) accumulator-type accumulator-type)]
                (cond
                  (exprresultv0-terminated initial) initial
                  (state-blocked? (exprresultv0-state initial))
                  (dead-result (exprresultv0-state initial))
                  :else
                  (let [(source ExprResultV0)
                        (lower-expr env owner (exprresultv0-state initial)
                          (nth args 2))
                        (source-state BodyStateV0) (exprresultv0-state source)
                        (source-type core/NativeId) (exprresultv0-type-id source)
                        (key-vector-type (U core/NativeId Nil))
                        (vector-type-of types key-type)
                        (value-vector-type (U core/NativeId Nil))
                        (vector-type-of types value-type)]
                    (cond
                      (exprresultv0-terminated source) source
                      (state-blocked? source-state) (dead-result source-state)

                      (not (same-id? accumulator-type
                             (exprresultv0-type-id initial)))
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-INIT: initial value must match the callback accumulator")

                      (not (insertion-order-map-type? types source-type))
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-COLLECTION: reduce-kv needs a closed insertion-order Map")

                      (not (same-id? key-type (map-key-of types source-type)))
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-KEY: callback key must match the map key type")

                      (not (same-id? value-type (map-value-of types source-type)))
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-VALUE: callback value must match the map value type")

                      (nil? key-vector-type)
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-KEY-VECTOR: the program declares no Vec carrier for map keys")

                      (nil? value-vector-type)
                      (fail-result source-state
                        "TODO-NATIVE-REDUCE-KV-VALUE-VECTOR: the program declares no Vec carrier for map values")

                      :else
                      (let [(key-vector-id core/NativeId)
                            (state-id source-state owner "reduce-kv-keys")
                            (with-keys BodyStateV0)
                            (state-emit (state-bump source-state)
                              (core/->MapKeysInstructionV0
                                (core/->SsaValueV0 key-vector-id key-vector-type)
                                (exprresultv0-value-id source)
                                (arena-value-id owner)))
                            (value-vector-id core/NativeId)
                            (state-id with-keys owner "reduce-kv-values")
                            (with-vectors BodyStateV0)
                            (state-emit (state-bump with-keys)
                              (core/->MapValuesInstructionV0
                                (core/->SsaValueV0 value-vector-id value-vector-type)
                                (exprresultv0-value-id source)
                                (arena-value-id owner)))
                            (outer-locals (Vec LocalBindingV0))
                            (bodystatev0-locals with-vectors)
                            (outer-frames (Vec LoopFrameV0))
                            (bodystatev0-loop-frames with-vectors)
                            (outer-refinements (Vec KeywordFlowRefinementV0))
                            (bodystatev0-keyword-refinements with-vectors)
                            (outer-values (Vec ValueFlowRefinementV0))
                            (bodystatev0-value-refinements with-vectors)
                            (length-id core/NativeId)
                            (state-id with-vectors owner "reduce-kv-length")
                            (zero-id core/NativeId)
                            (state-id with-vectors owner "reduce-kv-zero")
                            (header-id core/NativeId)
                            (state-id with-vectors owner "reduce-kv-header")
                            (body-id core/NativeId)
                            (state-id with-vectors owner "reduce-kv-body")
                            (exit-id core/NativeId)
                            (state-id with-vectors owner "reduce-kv-exit")
                            (header-index core/NativeId)
                            (state-id with-vectors owner "reduce-kv-index")
                            (header-accumulator core/NativeId)
                            (state-id with-vectors owner "reduce-kv-accumulator")
                            (prepared BodyStateV0)
                            (state-emit
                              (state-emit (state-bump with-vectors)
                                (core/->VecLengthInstruction
                                  (core/->SsaValueV0 length-id (int-type-id))
                                  key-vector-id))
                              (core/->AtomInstruction
                                (core/->SsaValueV0 zero-id (int-type-id))
                                (core/->I64Atom 0)))
                            (entered BodyStateV0)
                            (state-open-block
                              (state-close (state-bump prepared)
                                (core/->JumpTerminator header-id
                                  [zero-id (exprresultv0-value-id initial)]))
                              header-id
                              [(core/->Parameter header-index (int-type-id))
                               (core/->Parameter header-accumulator
                                 accumulator-type)])
                            (has-item core/NativeId)
                            (state-id entered owner "reduce-kv-has-item")
                            (compared BodyStateV0)
                            (state-emit (state-bump entered)
                              (core/->CompareInstruction
                                (core/->SsaValueV0 has-item (bool-type-id))
                                (core/->CompareLtI64V0 true)
                                header-index length-id))
                            (branched BodyStateV0)
                            (state-open-block
                              (state-close compared
                                (core/->BranchTerminator has-item body-id exit-id))
                              body-id [])
                            (key-id core/NativeId)
                            (state-id branched owner "reduce-kv-key")
                            (with-key BodyStateV0)
                            (state-emit (state-bump branched)
                              (core/->VecGetInstruction
                                (core/->SsaValueV0 key-id key-type)
                                key-vector-id header-index))
                            (value-id core/NativeId)
                            (state-id with-key owner "reduce-kv-value")
                            (isolated BodyStateV0)
                            (state-enter-inline-callback
                              (state-emit (state-bump with-key)
                                (core/->VecGetInstruction
                                  (core/->SsaValueV0 value-id value-type)
                                  value-vector-id header-index)))
                            (callback-state BodyStateV0)
                            (bind-source-parameter-value env owner
                              (bind-source-parameter-value env owner
                                (bind-source-parameter-value env owner isolated
                                  (nth callback-source-parameters 0) 0
                                  header-accumulator accumulator-type)
                                (nth callback-source-parameters 1) 1 key-id
                                key-type)
                              (nth callback-source-parameters 2) 2 value-id
                              value-type)
                            (callback-result ExprResultV0)
                            (lower-contextual-boundary env owner callback-state
                              callback-body accumulator-type accumulator-type)
                            (restored BodyStateV0)
                            (with
                              (state-with-flow-context
                                (exprresultv0-state callback-result)
                                outer-locals outer-refinements outer-values)
                              [:loop-frames outer-frames])]
                        (cond
                          (state-blocked? restored) (dead-result restored)

                          (exprresultv0-terminated callback-result)
                          (fail-result restored
                            "TODO-NATIVE-REDUCE-KV-CALLBACK-DIVERGES: callback does not produce the next accumulator")

                          (not (same-id? accumulator-type
                                 (exprresultv0-type-id callback-result)))
                          (fail-result restored
                            "TODO-NATIVE-REDUCE-KV-CALLBACK-RESULT: callback body does not produce its declared accumulator type")

                          :else
                          (let [(one-id core/NativeId)
                                (state-id restored owner "reduce-kv-one")
                                (with-one BodyStateV0)
                                (state-emit (state-bump restored)
                                  (core/->AtomInstruction
                                    (core/->SsaValueV0 one-id (int-type-id))
                                    (core/->I64Atom 1)))
                                (next-index ExprResultV0)
                                (lower-checked-arith with-one owner "+"
                                  header-index one-id)
                                (next-state BodyStateV0)
                                (exprresultv0-state next-index)]
                            (if (state-blocked? next-state)
                              (dead-result next-state)
                              (->ExprResultV0
                                (state-open-block
                                  (state-close next-state
                                    (core/->JumpTerminator header-id
                                      [(exprresultv0-value-id next-index)
                                       (exprresultv0-value-id callback-result)]))
                                  exit-id [])
                                header-accumulator accumulator-type
                                false))))))))))))))))

(defn lower-match-expr
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expr core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (target-node (U core/NativeId Nil))
        (index-first-object index expr "target")
        (clauses (Vec core/NativeId)) (match-clause-items index expr)]
    (if (nil? target-node)
      (fail-result state "TODO-NATIVE-MATCH-TARGET: match has no target")
      (let [(target ExprResultV0) (lower-expr env owner state target-node)
            (target-state BodyStateV0) (exprresultv0-state target)]
        (cond
          (exprresultv0-terminated target) target
          (state-blocked? target-state) (dead-result target-state)
          (nil? (lookup-type types (exprresultv0-type-id target)))
          (fail-result target-state
            "TODO-NATIVE-MATCH-TARGET: target type is not closed in the native program")
          :else
          (let [(failure String)
                (match-structure-failure env owner
                  (exprresultv0-type-id target) clauses)]
            (if (> (count failure) 0)
              (fail-result target-state failure)
              (let [(join-id core/NativeId)
                    (state-id target-state owner "match-join")
                    (join-parameter core/NativeId)
                    (state-id target-state owner "match-value")
                    (outer-locals (Vec LocalBindingV0))
                    (bodystatev0-locals target-state)
                    (outer-refinements (Vec KeywordFlowRefinementV0))
                    (bodystatev0-keyword-refinements target-state)
                    (outer-values (Vec ValueFlowRefinementV0))
                    (bodystatev0-value-refinements target-state)]
                (loop [(position Int) 0
                       (current BodyStateV0) target-state
                       (result-type (U core/NativeId Nil)) nil
                       (arms (Vec LogicArmV0)) []
                       (uniform Bool) true]
                  (if (>= position (count clauses))
                    (cond
                      (state-blocked? current) (dead-result current)
                      (nil? result-type)
                      (->ExprResultV0 current
                        (lower-id "body" ["match-terminated"])
                        (type-id "LowerFailure") true)
                      uniform
                      (->ExprResultV0
                        (state-open-block current join-id
                          [(core/->Parameter join-parameter result-type)])
                        join-parameter result-type false)
                      :else
                      (finish-flow-logic-join types owner current arms
                        join-id join-parameter
                        outer-locals outer-refinements outer-values expected))
                    (let [(clause core/NativeId) (nth clauses position)
                          (pattern (U core/NativeId Nil))
                          (match-clause-pattern index clause)
                          (body-node (U core/NativeId Nil))
                          (match-clause-body index clause)
                          (final Bool) (= (+ position 1) (count clauses))
                          (body-id core/NativeId)
                          (state-id current owner (str "match-body-" position))
                          (next-id core/NativeId)
                          (state-id current owner (str "match-next-" position))]
                      (if (or (nil? pattern) (nil? body-node))
                        (fail-result current
                          "TODO-NATIVE-MATCH-CLAUSE: every match clause needs a pattern and body")
                        (let [(body-start BodyStateV0)
                              (if final
                                current
                                (let [(test ExprResultV0)
                                      (lower-match-test env owner current
                                        (exprresultv0-value-id target)
                                        (exprresultv0-type-id target) pattern)
                                      (tested BodyStateV0) (exprresultv0-state test)]
                                  (if (state-blocked? tested)
                                    tested
                                    (state-open-block
                                      (state-close
                                        (state-bump (state-bump tested))
                                        (core/->BranchTerminator
                                          (exprresultv0-value-id test)
                                          body-id next-id))
                                      body-id []))))
                              (bound BodyStateV0)
                              (if (state-blocked? body-start)
                                body-start
                                (bind-match-pattern env owner body-start
                                  (exprresultv0-value-id target)
                                  (exprresultv0-type-id target) pattern))
                              (arm-start Int) (count (bodystatev0-blocks bound))
                              (body ExprResultV0)
                              (if (state-blocked? bound)
                                (dead-result bound)
                                (lower-expr-expected env owner bound body-node
                                  expected))
                              (body-state BodyStateV0) (exprresultv0-state body)
                              (body-live Bool) (not (exprresultv0-terminated body))]
                          (cond
                            (state-blocked? body-state) (dead-result body-state)

                            (not body-live)
                            (if final
                              (recur (count clauses)
                                (state-with-flow-context body-state
                                  outer-locals outer-refinements outer-values)
                                result-type arms uniform)
                              (recur (+ position 1)
                                (state-with-flow-context
                                  (state-open-block body-state next-id [])
                                  outer-locals outer-refinements outer-values)
                                result-type arms uniform))

                            :else
                            (let [(closed BodyStateV0)
                                  (state-close body-state
                                    (core/->JumpTerminator join-id
                                      [(exprresultv0-value-id body)]))
                                  (body-type core/NativeId)
                                  (exprresultv0-type-id body)
                                  (next-result-type core/NativeId)
                                  (if (nil? result-type)
                                    body-type result-type)
                                  (live-arms (Vec LogicArmV0))
                                  (conj arms
                                    (->LogicArmV0 arm-start
                                      (count (bodystatev0-blocks closed))
                                      body-type))
                                  (all-uniform Bool)
                                  (and uniform
                                    (or (nil? result-type)
                                      (same-id? result-type body-type)))]
                              (if final
                                (recur (count clauses)
                                  (state-with-flow-context closed
                                    outer-locals outer-refinements outer-values)
                                  next-result-type live-arms all-uniform)
                                (recur (+ position 1)
                                  (state-with-flow-context
                                    (state-open-block closed next-id [])
                                    outer-locals outer-refinements outer-values)
                                  next-result-type live-arms
                                  all-uniform)))))))))))))))))

(defn lower-static-update-call
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (if (not (= 3 (count args)))
    (fail-result state
      "TODO-NATIVE-UPDATE-ARITY: update lowers only as (update container key fn)")
    (let [(container ExprResultV0)
          (lower-expr env owner state (nth args 0))]
      (lower-static-update-value env owner container
        (nth args 1) (nth args 2)))))

(defn lower-atom-cas-retry
  [(owner core/NativeId)
   (state BodyStateV0)
   (cell-id core/NativeId)
   (content core/NativeId)
   (lower-replacement (Fn [ExprResultV0] ExprResultV0))]
  ExprResultV0
  (let [(header-id core/NativeId) (state-id state owner "atom-cas-header")
        (success-id core/NativeId) (state-id state owner "atom-cas-success")
        (entered BodyStateV0)
        (state-open-block
          (state-close (state-bump state)
            (core/->JumpTerminator header-id []))
          header-id [])
        (current-id core/NativeId) (state-id entered owner "atom-cas-current")
        (loaded BodyStateV0)
        (state-emit (state-bump entered)
          (core/->AtomDerefInstruction
            (core/->SsaValueV0 current-id content)
            cell-id (atom-state-value-id owner)))
        (replacement ExprResultV0)
        (lower-replacement
          (->ExprResultV0 loaded current-id content false))
        (settled BodyStateV0) (exprresultv0-state replacement)]
    (cond
      (state-blocked? settled) (dead-result settled)

      (exprresultv0-terminated replacement)
      (fail-result settled
        "TODO-NATIVE-ATOM-SWAP-UPDATER-DIVERGES: static updater does not produce a value")

      (not (same-id? content (exprresultv0-type-id replacement)))
      (fail-result settled
        "TODO-NATIVE-ATOM-SWAP-UPDATER-RESULT: static updater does not preserve the Atom content type")

      :else
      (let [(exchanged-id core/NativeId)
            (state-id settled owner "atom-cas-exchanged")
            (compared BodyStateV0)
            (state-emit (state-bump settled)
              (core/->AtomCompareExchangeInstruction
                (core/->SsaValueV0 exchanged-id (bool-type-id))
                cell-id (atom-state-value-id owner) current-id
                (exprresultv0-value-id replacement)))
            (branched BodyStateV0)
            (state-close (state-bump compared)
              (core/->BranchTerminator exchanged-id success-id header-id))]
        (->ExprResultV0
          (state-open-block branched success-id [])
          (exprresultv0-value-id replacement) content false)))))

(defn static-atom-builtin-updater? [(callee String)] Bool
  (or (= "assoc" callee) (= "update" callee) (= "conj" callee)
    (= "into" callee)))

(defn lower-static-atom-assoc-swap
  [(env BodyEnvV0)
   (owner core/NativeId)
   (cell ExprResultV0)
   (content core/NativeId)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (state BodyStateV0) (exprresultv0-state cell)
        (cell-id core/NativeId) (exprresultv0-value-id cell)]
    (cond
      (not (= 4 (count args)))
      (fail-result state
        "TODO-NATIVE-ATOM-SWAP-ASSOC-ARITY: swap! assoc takes one key/value pair")

      (record-type? types content)
      (let [(key-node core/NativeId) (nth args 2)
            (literal-key Bool)
            (and (= "literal" (fact-text index key-node "form-kind"))
              (= "keyword" (fact-text index key-node "literal-kind")))
            (field AccessorHitV0)
            (if literal-key
              (record-keyword-field types content
                (fact-text index key-node "value"))
              (accessor-miss))]
        (cond
          (not literal-key)
          (fail-result state
            "TODO-NATIVE-ATOM-SWAP-ASSOC-RECORD-KEY: record swap! assoc requires a literal keyword")

          (or (not (accessorhitv0-found field))
            (not (same-id? content (accessorhitv0-owner-type field))))
          (fail-result state
            "TODO-NATIVE-ATOM-SWAP-ASSOC-RECORD-FIELD: keyword is not a field of the Atom record")

          :else
          (let [(field-type core/NativeId) (accessorhitv0-field-type field)
                (raw ExprResultV0)
                (lower-expr-expected env owner state (nth args 3) field-type)]
            (cond
              (exprresultv0-terminated raw) raw
              (state-blocked? (exprresultv0-state raw))
              (dead-result (exprresultv0-state raw))
              :else
              (let [(replacement ExprResultV0)
                    (lower-boundary-coerce types owner
                      (exprresultv0-state raw)
                      (exprresultv0-value-id raw)
                      (exprresultv0-type-id raw) field-type)
                    (settled BodyStateV0) (exprresultv0-state replacement)]
                (cond
                  (state-blocked? settled) (dead-result settled)
                  (not (same-id? field-type
                         (exprresultv0-type-id replacement)))
                  (fail-result settled
                    "TODO-NATIVE-ATOM-SWAP-ASSOC-RECORD-VALUE: replacement does not match the record field type")
                  :else
                  (let [(guarded BodyStateV0)
                        (guard-record-field-value env owner settled content
                          (fact-text index key-node "value")
                          (exprresultv0-value-id replacement)
                          (exprresultv0-type-id replacement))]
                    (if (state-blocked? guarded)
                      (dead-result guarded)
                      (lower-atom-cas-retry owner guarded cell-id content
                        (fn [(current ExprResultV0)] ExprResultV0
                          (let [(result-id core/NativeId)
                                (state-id (exprresultv0-state current) owner
                                  "atom-record-assoc")]
                            (->ExprResultV0
                              (state-emit
                                (state-bump (exprresultv0-state current))
                                (core/->RecordAssocInstructionV0
                                  (core/->SsaValueV0 result-id content)
                                  (exprresultv0-value-id current)
                                  (accessorhitv0-field-id field)
                                  (exprresultv0-value-id replacement)
                                  (arena-value-id owner)))
                              result-id content false))))))))))))

      (map-type? types content)
      (let [(key-type core/NativeId) (map-key-of types content)
            (value-type core/NativeId) (map-value-of types content)
            (equality (U core/ConcreteEqualityV0 Nil))
            (map-key-equality-for types key-type)]
        (if (nil? equality)
          (fail-result state
            "TODO-NATIVE-ATOM-SWAP-ASSOC-MAP-EQUALITY: map key needs closed concrete equality")
          (let [(raw-key ExprResultV0)
                (lower-expr-expected env owner state (nth args 2) key-type)]
            (cond
              (exprresultv0-terminated raw-key) raw-key
              (state-blocked? (exprresultv0-state raw-key))
              (dead-result (exprresultv0-state raw-key))
              :else
              (let [(key ExprResultV0)
                    (lower-boundary-coerce types owner
                      (exprresultv0-state raw-key)
                      (exprresultv0-value-id raw-key)
                      (exprresultv0-type-id raw-key) key-type)
                    (keyed BodyStateV0) (exprresultv0-state key)]
                (cond
                  (state-blocked? keyed) (dead-result keyed)
                  (not (same-id? key-type (exprresultv0-type-id key)))
                  (fail-result keyed
                    "TODO-NATIVE-ATOM-SWAP-ASSOC-MAP-KEY: key does not match the map key type")
                  :else
                  (let [(raw-value ExprResultV0)
                        (lower-expr-expected env owner keyed
                          (nth args 3) value-type)]
                    (cond
                      (exprresultv0-terminated raw-value) raw-value
                      (state-blocked? (exprresultv0-state raw-value))
                      (dead-result (exprresultv0-state raw-value))
                      :else
                      (let [(value ExprResultV0)
                            (lower-boundary-coerce types owner
                              (exprresultv0-state raw-value)
                              (exprresultv0-value-id raw-value)
                              (exprresultv0-type-id raw-value) value-type)
                            (settled BodyStateV0) (exprresultv0-state value)]
                        (cond
                          (state-blocked? settled) (dead-result settled)
                          (not (same-id? value-type
                                 (exprresultv0-type-id value)))
                          (fail-result settled
                            "TODO-NATIVE-ATOM-SWAP-ASSOC-MAP-VALUE: value does not match the map value type")
                          :else
                          (lower-atom-cas-retry owner settled cell-id content
                            (fn [(current ExprResultV0)] ExprResultV0
                              (let [(result-id core/NativeId)
                                    (state-id
                                      (exprresultv0-state current) owner
                                      "atom-map-assoc")]
                                (->ExprResultV0
                                  (state-emit
                                    (state-bump
                                      (exprresultv0-state current))
                                    (core/->MapAssocInstructionV0
                                      (core/->SsaValueV0 result-id content)
                                      (exprresultv0-value-id current)
                                      (exprresultv0-value-id key)
                                      (exprresultv0-value-id value)
                                      (arena-value-id owner) equality))
                                  result-id content false))))))))))))))

      :else
      (fail-result state
        "TODO-NATIVE-ATOM-SWAP-ASSOC-TYPE: static Atom assoc requires a closed map or record"))))

(defn lower-static-atom-builtin-swap
  [(env BodyEnvV0)
   (owner core/NativeId)
   (cell ExprResultV0)
   (content core/NativeId)
   (updater String)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (state BodyStateV0) (exprresultv0-state cell)
        (cell-id core/NativeId) (exprresultv0-value-id cell)]
    (cond
      (= "assoc" updater)
      (lower-static-atom-assoc-swap env owner cell content args)

      (= "update" updater)
      (cond
        (not (= 4 (count args)))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-UPDATE-ARITY: swap! update takes a key and inline updater")

        (not (record-type? types content))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-UPDATE-TYPE: static Atom update currently requires a closed record")

        :else
        (lower-atom-cas-retry owner state cell-id content
          (fn [(current ExprResultV0)] ExprResultV0
            (lower-static-update-value env owner current
              (nth args 2) (nth args 3)))))

      (= "conj" updater)
      (cond
        (not (= 3 (count args)))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-CONJ-ARITY: swap! conj takes one value")

        (not (vector-type? types content))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-CONJ-TYPE: static Atom conj currently requires a closed vector")

        :else
        (let [(element-type core/NativeId) (vector-element-of types content)
              (raw ExprResultV0)
              (lower-expr env owner state (nth args 2))
              (argument ExprResultV0)
              (if (or (exprresultv0-terminated raw)
                    (state-blocked? (exprresultv0-state raw)))
                raw
                (lower-boundary-coerce types owner
                  (exprresultv0-state raw)
                  (exprresultv0-value-id raw)
                  (exprresultv0-type-id raw) element-type))
              (settled BodyStateV0) (exprresultv0-state argument)]
          (cond
            (exprresultv0-terminated argument) argument
            (state-blocked? settled) (dead-result settled)
            (not (same-id? element-type (exprresultv0-type-id argument)))
            (fail-result settled
              "TODO-NATIVE-ATOM-SWAP-CONJ-VALUE: conj value does not match the vector element type")
            :else
            (lower-atom-cas-retry owner settled cell-id content
              (fn [(current ExprResultV0)] ExprResultV0
                (let [(result-id core/NativeId)
                      (state-id (exprresultv0-state current) owner
                        "atom-conj")]
                  (->ExprResultV0
                    (state-emit (state-bump (exprresultv0-state current))
                      (core/->VecPushInstruction
                        (core/->SsaValueV0 result-id content)
                        (exprresultv0-value-id current)
                        (exprresultv0-value-id argument)
                        (arena-value-id owner)))
                    result-id content false)))))))

      :else
      (cond
        (not (= 3 (count args)))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-INTO-ARITY: swap! into takes one collection")

        (not (vector-type? types content))
        (fail-result state
          "TODO-NATIVE-ATOM-SWAP-INTO-TYPE: static Atom into currently requires a closed vector")

        :else
        (let [(raw ExprResultV0) (lower-expr env owner state (nth args 2))
              (source ExprResultV0)
              (if (or (exprresultv0-terminated raw)
                    (state-blocked? (exprresultv0-state raw)))
                raw
                (lower-boundary-coerce types owner
                  (exprresultv0-state raw)
                  (exprresultv0-value-id raw)
                  (exprresultv0-type-id raw) content))
              (settled BodyStateV0) (exprresultv0-state source)]
          (cond
            (exprresultv0-terminated source) source
            (state-blocked? settled) (dead-result settled)
            (not (same-id? content (exprresultv0-type-id source)))
            (fail-result settled
              "TODO-NATIVE-ATOM-SWAP-INTO-SOURCE: into source does not match the Atom vector type")
            :else
            (lower-atom-cas-retry owner settled cell-id content
              (fn [(current ExprResultV0)] ExprResultV0
                (let [(result-id core/NativeId)
                      (state-id (exprresultv0-state current) owner
                        "atom-into")]
                  (->ExprResultV0
                    (state-emit (state-bump (exprresultv0-state current))
                      (core/->VecConcatInstruction
                        (core/->SsaValueV0 result-id content)
                        (exprresultv0-value-id current)
                        (exprresultv0-value-id source)
                        (arena-value-id owner)))
                    result-id content false))))))))))

(defn transient-collection-kind
  [(types (Vec core/TypeDef)) (target core/NativeId)] String
  (cond
    (vector-type? types target) "vector"
    (map-type? types target) "map"
    (set-type? types target) "set"
    :else ""))

(defn transient-value-type
  [(types (Vec core/TypeDef)) (persistent-type core/NativeId)] core/NativeId
  persistent-type)

(defn lower-transient-open
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (active (U core/NativeId Nil)) (bodystatev0-transient-type state)]
    (cond
      (nil? active)
      (fail-result state
        "TODO-NATIVE-TRANSIENT-SCOPE: transient must be owned by one closed persistent! boundary")

      (not (= 1 (count args)))
      (fail-result state "TODO-NATIVE-TRANSIENT-ARITY: transient takes one seed")

      :else
      (let [(seed ExprResultV0)
            (lower-contextual-boundary env owner state (nth args 0) active active)
            (settled BodyStateV0) (exprresultv0-state seed)
            (collection-kind String) (transient-collection-kind types active)]
        (cond
          (exprresultv0-terminated seed) seed
          (state-blocked? settled) (dead-result settled)
          (not (same-id? active (exprresultv0-type-id seed)))
          (fail-result settled
            "TODO-NATIVE-TRANSIENT-SEED-TYPE: seed does not match its closed collection")
          (and (not (= "vector" collection-kind))
            (not (state-defines-empty-collection? settled
              (exprresultv0-value-id seed) collection-kind)))
          (fail-result settled
            "TODO-NATIVE-TRANSIENT-SEED-OWNERSHIP: v0 transient builders require a proven fresh empty seed")
          :else
          (let [(result-id core/NativeId)
                (state-id settled owner "transient-open")]
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->CollectionTransientOpenInstructionV0
                  (core/->SsaValueV0 result-id active)
                  (exprresultv0-value-id seed) (arena-value-id owner)))
              result-id active false)))))))

(defn lower-transient-vector-conj
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (active (U core/NativeId Nil)) (bodystatev0-transient-type state)]
    (cond
      (or (nil? active) (not (vector-type? types active)))
      (fail-result state
        "TODO-NATIVE-CONJ!-SCOPE: conj! requires one closed TransientVec owner")
      (not (= 2 (count args)))
      (fail-result state "TODO-NATIVE-CONJ!-ARITY: conj! takes one value")
      :else
      (let [(element-type core/NativeId) (vector-element-of types active)
            (source ExprResultV0)
            (lower-contextual-boundary env owner state (nth args 0)
              active active)
            (value ExprResultV0)
            (if (or (exprresultv0-terminated source)
                  (state-blocked? (exprresultv0-state source)))
              source
              (lower-contextual-boundary env owner
                (exprresultv0-state source) (nth args 1)
                element-type element-type))
            (settled BodyStateV0) (exprresultv0-state value)]
        (cond
          (exprresultv0-terminated value) value
          (state-blocked? settled) (dead-result settled)
          (or (not (same-id? active (exprresultv0-type-id source)))
            (not (same-id? element-type (exprresultv0-type-id value))))
          (fail-result settled
            "TODO-NATIVE-CONJ!-OPERANDS: TransientVec operands do not match their closed types")
          :else
          (let [(result-id core/NativeId)
                (state-id settled owner "transient-vec-push")]
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->TransientVecPushInstructionV0
                  (core/->SsaValueV0 result-id active)
                  (exprresultv0-value-id source)
                  (exprresultv0-value-id value) element-type))
              result-id active false)))))))

(defn lower-transient-set-conj
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (active (U core/NativeId Nil)) (bodystatev0-transient-type state)]
    (cond
      (or (nil? active) (not (set-type? types active)))
      (fail-result state
        "TODO-NATIVE-CONJ!-SCOPE: conj! requires one closed transient Set owner")
      (not (= 2 (count args)))
      (fail-result state "TODO-NATIVE-CONJ!-ARITY: conj! takes one value")
      :else
      (let [(element-type core/NativeId) (set-element-of types active)
            (equality (U core/ConcreteEqualityV0 Nil))
            (set-element-equality-for types element-type)
            (source ExprResultV0)
            (lower-contextual-boundary env owner state (nth args 0) active active)
            (value ExprResultV0)
            (if (or (exprresultv0-terminated source)
                  (state-blocked? (exprresultv0-state source)))
              source
              (lower-contextual-boundary env owner
                (exprresultv0-state source) (nth args 1)
                element-type element-type))
            (settled BodyStateV0) (exprresultv0-state value)]
        (cond
          (exprresultv0-terminated value) value
          (state-blocked? settled) (dead-result settled)
          (nil? equality)
          (fail-result settled
            "TODO-NATIVE-CONJ!-EQUALITY: transient Set element needs closed equality")
          (or (not (same-id? active (exprresultv0-type-id source)))
            (not (same-id? element-type (exprresultv0-type-id value))))
          (fail-result settled
            "TODO-NATIVE-CONJ!-OPERANDS: transient Set operands do not match their closed types")
          :else
          (let [(result-id core/NativeId)
                (state-id settled owner "transient-set-conj")]
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->TransientSetConjInstructionV0
                  (core/->SsaValueV0 result-id active)
                  (exprresultv0-value-id source)
                  (exprresultv0-value-id value)
                  (arena-value-id owner) equality))
              result-id active false)))))))

(defn lower-transient-map-assoc
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))]
  ExprResultV0
  (let [(types (Vec core/TypeDef)) (bodyenvv0-types env)
        (active (U core/NativeId Nil)) (bodystatev0-transient-type state)]
    (cond
      (or (nil? active) (not (map-type? types active)))
      (fail-result state
        "TODO-NATIVE-ASSOC!-SCOPE: assoc! requires one closed transient Map owner")
      (not (= 3 (count args)))
      (fail-result state "TODO-NATIVE-ASSOC!-ARITY: assoc! takes one key/value pair")
      :else
      (let [(key-type core/NativeId) (map-key-of types active)
            (value-type core/NativeId) (map-value-of types active)
            (equality (U core/ConcreteEqualityV0 Nil))
            (map-key-equality-for types key-type)
            (source ExprResultV0)
            (lower-contextual-boundary env owner state (nth args 0) active active)
            (key ExprResultV0)
            (if (or (exprresultv0-terminated source)
                  (state-blocked? (exprresultv0-state source)))
              source
              (lower-contextual-boundary env owner
                (exprresultv0-state source) (nth args 1) key-type key-type))
            (value ExprResultV0)
            (if (or (exprresultv0-terminated key)
                  (state-blocked? (exprresultv0-state key)))
              key
              (lower-contextual-boundary env owner
                (exprresultv0-state key) (nth args 2) value-type value-type))
            (settled BodyStateV0) (exprresultv0-state value)]
        (cond
          (exprresultv0-terminated value) value
          (state-blocked? settled) (dead-result settled)
          (nil? equality)
          (fail-result settled
            "TODO-NATIVE-ASSOC!-EQUALITY: transient Map key needs closed equality")
          (or (not (same-id? active (exprresultv0-type-id source)))
            (not (same-id? key-type (exprresultv0-type-id key)))
            (not (same-id? value-type (exprresultv0-type-id value))))
          (fail-result settled
            "TODO-NATIVE-ASSOC!-OPERANDS: transient Map operands do not match their closed types")
          :else
          (let [(result-id core/NativeId)
                (state-id settled owner "transient-map-assoc")]
            (->ExprResultV0
              (state-emit (state-bump settled)
                (core/->TransientMapAssocInstructionV0
                  (core/->SsaValueV0 result-id active)
                  (exprresultv0-value-id source)
                  (exprresultv0-value-id key)
                  (exprresultv0-value-id value)
                  (arena-value-id owner) equality))
              result-id active false)))))))

(defn lower-closed-persistent
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (args (Vec core/NativeId))
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (let [(index SourceIndexV0) (bodyenvv0-index env)
        (types (Vec core/TypeDef)) (bodyenvv0-types env)
        (prior (U core/NativeId Nil)) (bodystatev0-transient-type state)]
    (cond
      (some? prior)
      (fail-result state
        "TODO-NATIVE-PERSISTENT!-NESTED: transient ownership cannot nest")
      (not (= 1 (count args)))
      (fail-result state "TODO-NATIVE-PERSISTENT!-ARITY: persistent! takes one builder")
      (nil? expected)
      (fail-result state
        "TODO-NATIVE-PERSISTENT!-TYPE: persistent! needs an exact collection boundary")
      :else
      (let [(collection-kind String) (transient-collection-kind types expected)
            (builder-type core/NativeId) (transient-value-type types expected)]
        (if (or (= "" collection-kind)
              (not (closed-transient-source? index (nth args 0)
                     collection-kind)))
          (fail-result state
            "TODO-NATIVE-PERSISTENT!-OWNERSHIP: transient builder escapes, aliases, or has a dynamic updater")
          (let [(scoped BodyStateV0) (with state [:transient-type expected])
                (source ExprResultV0)
                (lower-contextual-boundary env owner scoped (nth args 0)
                  builder-type builder-type)
                (restored BodyStateV0)
                (with (exprresultv0-state source) [:transient-type prior])]
            (cond
              (exprresultv0-terminated source)
              (->ExprResultV0 restored (exprresultv0-value-id source)
                (exprresultv0-type-id source) true)
              (state-blocked? restored) (dead-result restored)
              (not (same-id? builder-type (exprresultv0-type-id source)))
              (fail-result restored
                "TODO-NATIVE-PERSISTENT!-RESULT: builder does not match its exact collection boundary")
              :else
              (let [(result-id core/NativeId)
                    (state-id restored owner "persistent-close")]
                (->ExprResultV0
                  (state-emit (state-bump restored)
                    (core/->CollectionPersistentCloseInstructionV0
                      (core/->SsaValueV0 result-id expected)
                      (exprresultv0-value-id source) (arena-value-id owner)))
                  result-id expected false)))))))))

(defn lower-expr-raw
  [(env BodyEnvV0)
   (owner core/NativeId)
   (state BodyStateV0)
   (expr core/NativeId)
   (expected (U core/NativeId Nil))]
  ExprResultV0
  (if (state-blocked? state)
    (dead-result state)
    (let [(index SourceIndexV0) (bodyenvv0-index env)
          (types (Vec core/TypeDef)) (bodyenvv0-types env)
          (kind String) (fact-text index expr "form-kind")]
      (cond
        (= "literal" kind)
        (let [(literal-kind String) (fact-text index expr "literal-kind")
              (text String) (fact-text index expr "value")
              (result-id core/NativeId) (state-id state owner "lit")
              (bumped BodyStateV0) (state-bump state)]
          (cond
            (or (= "int" literal-kind) (= "number" literal-kind))
            (let [(parsed (U Int Nil)) (parse-int-text text)]
              (if (nil? parsed)
                (fail-result state
                  (str "TODO-NATIVE-LITERAL-INT: " text
                    " is not an exact native integer"))
                (->ExprResultV0
                  (state-emit bumped
                    (core/->AtomInstruction
                      (core/->SsaValueV0 result-id (int-type-id))
                      (core/->I64Atom parsed)))
                  result-id (int-type-id) false)))

            (= "float" literal-kind)
            (let [(parsed (U Float Nil)) (parse-double text)]
              (if (nil? parsed)
                (fail-result state
                  (str "TODO-NATIVE-LITERAL-FLOAT: " text
                    " is not an exact native Float"))
                (->ExprResultV0
                  (state-emit bumped
                    (core/->AtomInstruction
                      (core/->SsaValueV0 result-id (float-type-id))
                      (core/->F64Atom parsed)))
                  result-id (float-type-id) false)))

            (= "bool" literal-kind)
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (bool-type-id))
                  (core/->BoolAtom (= "true" text))))
              result-id (bool-type-id) false)

            (or (= "string" literal-kind) (= "regex" literal-kind))
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (text-type-id))
                  (core/->TextAtom text)))
              result-id (text-type-id) false)

            (= "keyword" literal-kind)
            (->ExprResultV0
              (state-emit bumped
                (core/->AtomInstruction
                  (core/->SsaValueV0 result-id (keyword-type-id))
                  (core/->KeywordAtom text)))
              result-id (keyword-type-id) false)

            (= "nil" literal-kind)
            (let [(variants (Vec core/TypeVariant))
                  (union-variants-of types (type-id "Nil"))]
              (if (and (= 1 (count variants))
                    (nil? (core/typevariant-payload-type (nth variants 0))))
                (->ExprResultV0
                  (state-emit bumped
                    (core/->UnionConstructInstruction
                      (core/->SsaValueV0 result-id (type-id "Nil"))
                      (core/typevariant-id (nth variants 0))
                      nil))
                  result-id (type-id "Nil") false)
                (fail-result state
                  "TODO-NATIVE-LITERAL-NIL-TYPE: Nil has no closed unit variant")))

            :else
            (fail-result state
              (str "TODO-NATIVE-LITERAL-" literal-kind
                ": no native atom for this literal kind"))))

        (= "ref" kind)
        (let [(name String) (fact-text index expr "name")
              (binding (U LocalBindingV0 Nil))
              (source-ref-binding env state expr)]
          (if (nil? binding)
            (fail-result state
              (str "TODO-NATIVE-FREE-REFERENCE: " name
                " is not a parameter or local binding"))
            (->ExprResultV0 state (localbindingv0-value-id binding)
              (localbindingv0-type-id binding) false)))

        (= "fn" kind)
        (fail-result state
          "TODO-NATIVE-FN-ESCAPES: anonymous functions lower only as an eager inline callback")

        (= "do" kind)
        (let [(body-node (U core/NativeId Nil))
              (index-first-object index expr "body")
              (forms (Vec core/NativeId))
              (if (nil? body-node) [] (index-sequence-items index body-node))]
          (cond
            (nil? body-node)
            (fail-result state "TODO-NATIVE-DO-BODY: do form has no body sequence")

            (= 0 (count forms))
            (fail-result state "TODO-NATIVE-DO-EMPTY: empty do is outside the native slice")

            :else
            (loop [(position Int) 0 (current BodyStateV0) state]
              (let [(form-expected (U core/NativeId Nil))
                    (if (= (+ position 1) (count forms)) expected nil)
                    (result ExprResultV0)
                    (lower-expr-expected env owner current
                      (nth forms position) form-expected)]
                (cond
                  (or (state-blocked? (exprresultv0-state result))
                      (exprresultv0-terminated result)
                      (= (+ position 1) (count forms)))
                  result

                  :else
                  (recur (+ position 1) (exprresultv0-state result)))))))

        (= "let" kind)
        (let [(outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
              (bindings-node (U core/NativeId Nil))
              (index-first-object index expr "bindings")
              (items (Vec core/NativeId))
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              (bound ExprResultV0)
              (loop [(position Int) 0 (current BodyStateV0) state]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ExprResultV0 current (lower-id "body" ["let"])
                    (type-id "LowerFailure") false)
                  (let [(item core/NativeId) (nth items position)
                        (name String) (fact-text index item "name")
                        (annotation (U core/NativeId Nil))
                        (index-first-object index item "ann")
                        (value-node (U core/NativeId Nil))
                        (index-first-object index item "value")]
                    (if (nil? value-node)
                      (->ExprResultV0
                        (state-fail current
                          (str "TODO-NATIVE-BINDING-VALUE: " name " has no value form"))
                        (lower-id "body" ["let"]) (type-id "LowerFailure") false)
                      (let [(expected (U core/NativeId Nil))
                            (annotation-native-type index annotation)
                            (raw ExprResultV0)
                            (lower-expr-expected env owner current value-node expected)
                            (value ExprResultV0)
                            (if (or (nil? annotation)
                                  (exprresultv0-terminated raw)
                                  (state-blocked? (exprresultv0-state raw)))
                              raw
                              (lower-boundary-coerce types owner
                                (exprresultv0-state raw)
                                (exprresultv0-value-id raw)
                                (exprresultv0-type-id raw)
                                (typeresolutionv0-type-id
                                  (resolve-source-type index annotation))))]
                        (if (exprresultv0-terminated value)
                          value
                          (let [(guarded BodyStateV0)
                                (guard-binding-value env owner
                                  (exprresultv0-state value) item
                                  (exprresultv0-value-id value)
                                  (exprresultv0-type-id value))
                                (target (U core/NativeId Nil))
                                (parameter-target-at index item)
                                (next-state BodyStateV0)
                                (if (state-blocked? guarded)
                                  guarded
                                  (if (nil? target)
                                    (state-bind guarded name
                                      (exprresultv0-value-id value)
                                      (exprresultv0-type-id value))
                                    (if (nil? annotation)
                                      (state-fail guarded
                                        "TODO-NATIVE-DESTRUCTURE-BINDING-TYPE: aggregate binding has no source type")
                                      (project-binding-target env owner guarded
                                        target annotation
                                        (exprresultv0-value-id value)
                                        (exprresultv0-type-id value)))))]
                            (recur (+ position 1) next-state))))))))
              (body-node (U core/NativeId Nil)) (index-first-object index expr "body")]
          (cond
            (exprresultv0-terminated bound) bound
            (state-blocked? (exprresultv0-state bound))
            (dead-result (exprresultv0-state bound))
            (nil? body-node)
            (fail-result (exprresultv0-state bound)
              "TODO-NATIVE-LET-BODY: let form has no body")
            :else
            (let [(body ExprResultV0)
                  (lower-expr-expected env owner
                    (exprresultv0-state bound) body-node expected)]
              (->ExprResultV0
                (with (exprresultv0-state body) [:locals outer-locals])
                (exprresultv0-value-id body)
                (exprresultv0-type-id body)
                (exprresultv0-terminated body)))))

        (= "match" kind)
        (lower-match-expr env owner state expr expected)

        (= "if" kind)
        (let [(condition-node (U core/NativeId Nil))
              (index-first-object index expr "cond")
              (then-node (U core/NativeId Nil)) (index-first-object index expr "then")
              (else-node (U core/NativeId Nil)) (index-first-object index expr "else")]
          (if (or (nil? condition-node) (nil? then-node) (nil? else-node))
            (fail-result state
              "TODO-NATIVE-IF-ARMS: if form needs a condition and both arms")
            (let [(condition ExprResultV0)
                  (lower-condition env owner state condition-node)]
              (cond
                (exprresultv0-terminated condition) condition
                (state-blocked? (exprresultv0-state condition))
                (dead-result (exprresultv0-state condition))
                (not (same-id? (exprresultv0-type-id condition) (bool-type-id)))
                (fail-result (exprresultv0-state condition)
                  "TODO-NATIVE-IF-CONDITION: condition is not a native Bool")
                :else
                (let [(static-condition (U Bool Nil))
                      (static-predicate-condition-value index owner
                        condition-node condition)]
                  (if (some? static-condition)
                    ;; Operand instructions are already in state; discard only the predicate atom.
                    (lower-expr-expected env owner
                      (drop-static-predicate-result
                        (exprresultv0-state condition))
                      (if static-condition then-node else-node) expected)
                    (let [(base BodyStateV0) (exprresultv0-state condition)
                      (outer-locals (Vec LocalBindingV0))
                      (bodystatev0-locals base)
                      (outer-keywords (Vec KeywordFlowRefinementV0))
                      (bodystatev0-keyword-refinements base)
                      (outer-values (Vec ValueFlowRefinementV0))
                      (bodystatev0-value-refinements base)
                      (then-id core/NativeId) (state-id base owner "then")
                      (else-id core/NativeId) (state-id base owner "else")
                      (join-id core/NativeId) (state-id base owner "join")
                      (join-parameter core/NativeId) (state-id base owner "join-value")
                      (branched BodyStateV0)
                      (state-refine-for-condition env owner
                        (state-open-block
                          (state-close (state-bump base)
                            (core/->BranchTerminator
                              (exprresultv0-value-id condition) then-id else-id))
                          then-id [])
                        condition-node true)
                      (then-start Int) (count (bodystatev0-blocks branched))
                      (then-result ExprResultV0)
                      (lower-expr-expected env owner branched then-node expected)
                      (after-then BodyStateV0)
                      (if (exprresultv0-terminated then-result)
                        (exprresultv0-state then-result)
                        (state-close (exprresultv0-state then-result)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id then-result)])))
                      (then-end Int) (count (bodystatev0-blocks after-then))
                      (else-start BodyStateV0)
                      (state-refine-for-condition env owner
                        (state-with-flow-context
                          (state-open-block after-then else-id [])
                          outer-locals outer-keywords outer-values)
                        condition-node false)
                      (else-block-start Int) (count (bodystatev0-blocks else-start))
                      (else-expected (U core/NativeId Nil))
                      (if (some? expected)
                        expected
                        (if (or (exprresultv0-terminated then-result)
                                (state-blocked? (exprresultv0-state then-result)))
                          nil
                          (exprresultv0-type-id then-result)))
                      (else-result ExprResultV0)
                      (lower-expr-expected env owner else-start else-node
                        else-expected)
                      (after-else BodyStateV0)
                      (if (exprresultv0-terminated else-result)
                        (exprresultv0-state else-result)
                        (state-close (exprresultv0-state else-result)
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id else-result)])))
                      (else-end Int) (count (bodystatev0-blocks after-else))
                      (settled BodyStateV0)
                      (state-with-flow-context after-else
                        outer-locals outer-keywords outer-values)
                      (then-live Bool) (not (exprresultv0-terminated then-result))
                      (else-live Bool) (not (exprresultv0-terminated else-result))
                      (result-type core/NativeId)
                      (if then-live
                        (exprresultv0-type-id then-result)
                        (exprresultv0-type-id else-result))]
                  (cond
                    (state-blocked? settled) (dead-result settled)
                    (and (not then-live) (not else-live))
                    (->ExprResultV0 settled (lower-id "body" ["unreachable"])
                      result-type true)
                    (and then-live else-live
                      (not (same-id? (exprresultv0-type-id then-result)
                             (exprresultv0-type-id else-result))))
                    (bridge-join-arms types owner settled
                      then-start then-end else-block-start else-end
                      join-id join-parameter
                      (exprresultv0-type-id then-result)
                      (exprresultv0-type-id else-result)
                      expected)
                    :else
                    (->ExprResultV0
                      (state-open-block settled join-id
                        [(core/->Parameter join-parameter result-type)])
                      join-parameter result-type false)))))))))

        (= "cond" kind)
        (let [(clauses-node (U core/NativeId Nil))
              (index-first-object index expr "clauses")
              (clauses (Vec core/NativeId))
              (if (nil? clauses-node) []
                (index-sequence-items index clauses-node))
              (join-id core/NativeId) (state-id state owner "cond-join")
              (join-parameter core/NativeId)
              (state-id state owner "cond-value")
              (outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
              (outer-keywords (Vec KeywordFlowRefinementV0))
              (bodystatev0-keyword-refinements state)
              (outer-values (Vec ValueFlowRefinementV0))
              (bodystatev0-value-refinements state)]
          (loop [(position Int) 0
                 (current BodyStateV0) state
                 (arms (Vec LogicArmV0)) []]
            (if (>= position (count clauses))
              (let [(arm-start Int) (count (bodystatev0-blocks current))
                    (implicit ExprResultV0)
                    (nil-constant-result types current owner "cond-nil")
                    (implicit-state BodyStateV0) (exprresultv0-state implicit)]
                (if (state-blocked? implicit-state)
                  (dead-result implicit-state)
                  (let [(closed BodyStateV0)
                        (state-close implicit-state
                          (core/->JumpTerminator join-id
                            [(exprresultv0-value-id implicit)]))]
                    (finish-flow-logic-join types owner closed
                      (conj arms
                        (->LogicArmV0 arm-start
                          (count (bodystatev0-blocks closed))
                          (exprresultv0-type-id implicit)))
                      join-id join-parameter
                      outer-locals outer-keywords outer-values expected))))
              (let [(clause core/NativeId) (nth clauses position)
                    (test-node (U core/NativeId Nil))
                    (index-first-object index clause "test")
                    (body-node (U core/NativeId Nil))
                    (index-first-object index clause "body")
                    (fallback Bool)
                    (and (some? test-node)
                      (= "ref" (fact-text index test-node "form-kind"))
                      (= "else" (fact-text index test-node "name")))]
                (cond
                  (or (nil? test-node) (nil? body-node))
                  (fail-result current
                    "TODO-NATIVE-COND-CLAUSE: cond clauses need one test and one body")

                  fallback
                  (let [(arm-start Int) (count (bodystatev0-blocks current))
                        (body-expected (U core/NativeId Nil))
                        (if (some? expected)
                          expected
                          (logic-result-type types arms))
                        (body ExprResultV0)
                        (lower-expr-expected env owner current body-node
                          body-expected)
                        (body-state BodyStateV0) (exprresultv0-state body)]
                    (cond
                      (state-blocked? body-state) (dead-result body-state)
                      (exprresultv0-terminated body)
                      (finish-flow-logic-join types owner body-state arms
                        join-id join-parameter
                        outer-locals outer-keywords outer-values expected)
                      :else
                      (let [(closed BodyStateV0)
                            (state-close body-state
                              (core/->JumpTerminator join-id
                                [(exprresultv0-value-id body)]))]
                        (finish-flow-logic-join types owner closed
                          (conj arms
                            (->LogicArmV0 arm-start
                              (count (bodystatev0-blocks closed))
                              (exprresultv0-type-id body)))
                          join-id join-parameter
                          outer-locals outer-keywords outer-values expected))))

                  :else
                  (let [(condition ExprResultV0)
                        (lower-condition env owner current test-node)
                        (condition-state BodyStateV0)
                        (exprresultv0-state condition)]
                    (cond
                      (state-blocked? condition-state)
                      (dead-result condition-state)
                      (exprresultv0-terminated condition)
                      (if (= 0 (count arms))
                        condition
                        (finish-flow-logic-join types owner condition-state arms
                          join-id join-parameter
                          outer-locals outer-keywords outer-values expected))
                      (not (same-id? (exprresultv0-type-id condition)
                             (bool-type-id)))
                      (fail-result condition-state
                        "TODO-NATIVE-COND-CONDITION: cond tests must lower to Bool")
                      :else
                      (let [(body-id core/NativeId)
                            (state-id condition-state owner "cond-body")
                            (next-id core/NativeId)
                            (state-id (state-bump condition-state) owner "cond-next")
                            (chain-locals (Vec LocalBindingV0))
                            (bodystatev0-locals condition-state)
                            (chain-keywords (Vec KeywordFlowRefinementV0))
                            (bodystatev0-keyword-refinements condition-state)
                            (chain-values (Vec ValueFlowRefinementV0))
                            (bodystatev0-value-refinements condition-state)
                            (branched BodyStateV0)
                            (state-refine-for-condition env owner
                              (state-open-block
                                (state-close (state-bump (state-bump condition-state))
                                  (core/->BranchTerminator
                                    (exprresultv0-value-id condition)
                                    body-id next-id))
                                body-id [])
                              test-node true)
                            (arm-start Int) (count (bodystatev0-blocks branched))
                            (body-expected (U core/NativeId Nil))
                            (if (some? expected)
                              expected
                              (logic-result-type types arms))
                            (body ExprResultV0)
                            (lower-expr-expected env owner branched body-node
                              body-expected)
                            (body-state BodyStateV0) (exprresultv0-state body)
                            (body-live Bool)
                            (not (exprresultv0-terminated body))
                            (after-body BodyStateV0)
                            (if body-live
                              (state-close body-state
                                (core/->JumpTerminator join-id
                                  [(exprresultv0-value-id body)]))
                              body-state)
                            (live-arms (Vec LogicArmV0))
                            (if body-live
                              (conj arms
                                (->LogicArmV0 arm-start
                                  (count (bodystatev0-blocks after-body))
                                  (exprresultv0-type-id body)))
                              arms)
                            (next-state BodyStateV0)
                            (state-refine-for-condition env owner
                              (state-with-flow-context
                                (state-open-block after-body next-id [])
                                chain-locals chain-keywords chain-values)
                              test-node false)]
                        (if (state-blocked? body-state)
                          (dead-result body-state)
                          (recur (+ position 1) next-state live-arms))))))))))

        (= "loop" kind)
        (let [(bindings-node (U core/NativeId Nil))
              (index-first-object index expr "bindings")
              (items (Vec core/NativeId))
              (if (nil? bindings-node) [] (index-sequence-items index bindings-node))
              (body-node (U core/NativeId Nil)) (index-first-object index expr "body")
              (outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
              (outer-frames (Vec LoopFrameV0)) (bodystatev0-loop-frames state)]
          (cond
            (nil? body-node)
            (fail-result state "TODO-NATIVE-LOOP-BODY: loop form has no body")

            (not (recur-tail-only? index body-node true (+ 1 (index-facts index))))
            (fail-result state
              "TODO-NATIVE-RECUR-NON-TAIL: recur is not in tail position of its loop")

            :else
            (let [(inits LoopInitsV0)
                  (loop [(position Int) 0
                         (accumulated LoopInitsV0)
                         (->LoopInitsV0 state [] [] [] false)]
                    (if (or (>= position (count items))
                            (state-blocked? (loopinitsv0-state accumulated))
                            (loopinitsv0-terminated accumulated))
                      accumulated
                      (let [(item core/NativeId) (nth items position)
                            (name String) (fact-text index item "name")
                            (annotation (U core/NativeId Nil))
                            (index-first-object index item "ann")
                            (value-node (U core/NativeId Nil))
                            (index-first-object index item "value")]
                        (if (nil? value-node)
                          (->LoopInitsV0
                            (state-fail (loopinitsv0-state accumulated)
                              (str "TODO-NATIVE-LOOP-INIT: accumulator " name
                                " has no init form"))
                            (loopinitsv0-bindings accumulated)
                            (loopinitsv0-values accumulated)
                            (loopinitsv0-value-types accumulated) false)
                          (let [(current BodyStateV0)
                                (loopinitsv0-state accumulated)
                                (active-transient (U core/NativeId Nil))
                                (bodystatev0-transient-type current)
                                (transient-owner Bool)
                                (and (some? active-transient)
                                  (source-any-annotation? index item)
                                  (source-call-named? index value-node
                                    "transient"))
                                (expected (U core/NativeId Nil))
                                (if transient-owner active-transient
                                  (annotation-native-type index annotation))
                                (raw ExprResultV0)
                                (lower-expr-expected env owner current value-node expected)
                                (value ExprResultV0)
                                (if (or (nil? expected)
                                      (exprresultv0-terminated raw)
                                      (state-blocked? (exprresultv0-state raw)))
                                  raw
                                  (lower-boundary-coerce types owner
                                    (exprresultv0-state raw)
                                    (exprresultv0-value-id raw)
                                    (exprresultv0-type-id raw)
                                    expected))]
                            (if (exprresultv0-terminated value)
                              (->LoopInitsV0 (exprresultv0-state value)
                                (loopinitsv0-bindings accumulated)
                                (loopinitsv0-values accumulated)
                                (loopinitsv0-value-types accumulated) true)
                              (let [(guarded BodyStateV0)
                                    (guard-binding-value env owner
                                      (exprresultv0-state value) item
                                      (exprresultv0-value-id value)
                                      (exprresultv0-type-id value))
                                    (target (U core/NativeId Nil))
                                    (parameter-target-at index item)
                                    (bound BodyStateV0)
                                    (if (state-blocked? guarded)
                                      guarded
                                      (if (nil? target)
                                        (state-bind guarded name
                                          (exprresultv0-value-id value)
                                          (exprresultv0-type-id value))
                                        (if (nil? annotation)
                                          (state-fail guarded
                                            "TODO-NATIVE-DESTRUCTURE-LOOP-TYPE: aggregate loop binding has no source type")
                                          (project-binding-target env owner guarded
                                            target annotation
                                            (exprresultv0-value-id value)
                                            (exprresultv0-type-id value)))))]
                                (recur (+ position 1)
                                  (->LoopInitsV0
                                    ;; Each init sees prior validated bindings.
                                    bound
                                    (conj (loopinitsv0-bindings accumulated) item)
                                    (conj (loopinitsv0-values accumulated)
                                      (exprresultv0-value-id value))
                                    (conj (loopinitsv0-value-types accumulated)
                                      (exprresultv0-type-id value))
                                    false)))))))))
                  (base BodyStateV0) (loopinitsv0-state inits)]
              (cond
                (loopinitsv0-terminated inits)
                (->ExprResultV0 base (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? base) (dead-result base)

                :else
                (let [(header-id core/NativeId) (state-id base owner "loop-header")
                      (parameters (Vec core/Parameter))
                      (loop [(position Int) 0 (collected (Vec core/Parameter)) []]
                        (if (>= position (count (loopinitsv0-bindings inits)))
                          collected
                          (recur (+ position 1)
                            (conj collected
                              (core/->Parameter
                                (state-id base owner (str "loop-param-" position))
                                (nth (loopinitsv0-value-types inits) position))))))
                      (entered BodyStateV0)
                      (state-open-block
                        (state-close (state-bump base)
                          (core/->JumpTerminator header-id
                            (loopinitsv0-values inits)))
                        header-id parameters)
                      (bound BodyStateV0)
                      (loop [(position Int) 0 (current BodyStateV0) entered]
                        (if (>= position (count parameters))
                          current
                          (recur (+ position 1)
                            (let [(binding core/NativeId)
                                  (nth (loopinitsv0-bindings inits) position)
                                  (target (U core/NativeId Nil))
                                  (parameter-target-at index binding)
                                  (parameter core/Parameter)
                                  (nth parameters position)]
                              (if (nil? target)
                                (state-bind current
                                  (fact-text index binding "name")
                                  (core/parameter-id parameter)
                                  (core/parameter-type-id parameter))
                                (let [(annotation (U core/NativeId Nil))
                                      (index-first-object index binding "ann")]
                                  (if (nil? annotation)
                                    (state-fail current
                                      "TODO-NATIVE-DESTRUCTURE-LOOP-TYPE: aggregate loop binding has no source type")
                                    (project-binding-target env owner current target
                                      annotation (core/parameter-id parameter)
                                      (core/parameter-type-id parameter)))))))))
                      (body ExprResultV0)
                      (lower-expr-expected env owner
                        (state-push-loop bound
                          (->LoopFrameV0 header-id parameters
                            (loopinitsv0-bindings inits)))
                        body-node expected)]
                  ;; the loop's value is the join value of the body exiting
                  ;; without recur, in whatever block that exit left open
                  (->ExprResultV0
                    (with (with (exprresultv0-state body) [:locals outer-locals])
                      [:loop-frames outer-frames])
                    (exprresultv0-value-id body)
                    (exprresultv0-type-id body)
                    (exprresultv0-terminated body)))))))

        (= "recur" kind)
        (let [(frame (U LoopFrameV0 Nil)) (current-loop state)]
          (if (nil? frame)
            (fail-result state
              "TODO-NATIVE-RECUR-OUTSIDE-LOOP: recur has no enclosing loop header")
            (let [(args-node (U core/NativeId Nil))
                  (index-first-object index expr "args")
                  (args (Vec core/NativeId))
                  (if (nil? args-node) [] (index-sequence-items index args-node))
                  (parameters (Vec core/Parameter)) (loopframev0-parameters frame)
                  (lowered ArgsResultV0)
                  (loop [(position Int) 0
                         (current BodyStateV0) state
                         (values (Vec core/NativeId)) []
                         (value-types (Vec core/NativeId)) []]
                    (if (or (>= position (count args)) (state-blocked? current))
                      (->ArgsResultV0 current values value-types false)
                      (let [(argument ExprResultV0)
                            (lower-expr env owner current (nth args position))]
                        (if (exprresultv0-terminated argument)
                          (->ArgsResultV0 (exprresultv0-state argument) values
                            value-types true)
                          (recur (+ position 1) (exprresultv0-state argument)
                            (conj values (exprresultv0-value-id argument))
                            (conj value-types (exprresultv0-type-id argument)))))))
                  (current BodyStateV0) (argsresultv0-state lowered)
                  (values (Vec core/NativeId)) (argsresultv0-values lowered)
                  (value-types (Vec core/NativeId)) (argsresultv0-value-types lowered)]
              (cond
                (argsresultv0-terminated lowered)
                (->ExprResultV0 current (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? current) (dead-result current)

                (not (= (count parameters) (count values)))
                (fail-result current
                  (str "TODO-NATIVE-RECUR-ARITY: recur passes "
                    (str (count values)) " arguments to a loop with "
                    (str (count parameters)) " accumulators"))

                (>= (recur-type-mismatch parameters value-types) 0)
                (fail-result current
                  (str "TODO-NATIVE-RECUR-TYPES: recur argument "
                    (str (recur-type-mismatch parameters value-types))
                    " is not the native type its accumulator's init fixed"))

                :else
                (let [(copied ArgsResultV0)
                      (if (not (recur-aliases-header? parameters values))
                        (->ArgsResultV0 current values value-types false)
                        (loop [(position Int) 0
                               (accumulated ArgsResultV0)
                               (->ArgsResultV0 (state-bump current) []
                                 value-types false)]
                          (if (>= position (count values))
                            accumulated
                            (let [(copy-id core/NativeId)
                                  (state-id current owner
                                    (str "recur-copy-" position))]
                              (recur (+ position 1)
                                (->ArgsResultV0
                                  (state-emit (argsresultv0-state accumulated)
                                    (core/->CopyInstruction
                                      (core/->SsaValueV0 copy-id
                                        (nth value-types position))
                                      (nth values position)))
                                  (conj (argsresultv0-values accumulated) copy-id)
                                  value-types false))))))]
                  (let [(guarded BodyStateV0)
                        (loop [(position Int) 0
                               (guard-state BodyStateV0)
                               (argsresultv0-state copied)]
                          (if (or (>= position (count (argsresultv0-values copied)))
                                (state-blocked? guard-state))
                            guard-state
                            (recur (+ position 1)
                              (guard-binding-value env owner guard-state
                                (nth (loopframev0-bindings frame) position)
                                (nth (argsresultv0-values copied) position)
                                (nth value-types position)))))]
                    (if (state-blocked? guarded)
                      (dead-result guarded)
                      (->ExprResultV0
                        (state-close guarded
                          (core/->JumpTerminator (loopframev0-header-id frame)
                            (argsresultv0-values copied)))
                        (lower-id "body" ["recur"])
                        (type-id "LowerFailure") true))))))))

        (= "doseq" kind)
        (let [(clauses-node (U core/NativeId Nil))
              (index-first-object index expr "clauses")
              (clauses (Vec core/NativeId))
              (if (nil? clauses-node) []
                (index-sequence-items index clauses-node))
              (body-node (U core/NativeId Nil))
              (index-first-object index expr "body")
              (bodies (Vec core/NativeId))
              (if (nil? body-node) [] (index-sequence-items index body-node))
              (modifier-position Int)
              (loop [(position Int) 0]
                (cond
                  (>= position (count clauses)) -1
                  (= "binding"
                    (fact-text index (nth clauses position) "clause-kind"))
                  (recur (+ position 1))
                  :else position))
              (outer-locals (Vec LocalBindingV0)) (bodystatev0-locals state)
              (outer-frames (Vec LoopFrameV0)) (bodystatev0-loop-frames state)
              (outer-refinements (Vec KeywordFlowRefinementV0))
              (bodystatev0-keyword-refinements state)
              (outer-values (Vec ValueFlowRefinementV0))
              (bodystatev0-value-refinements state)]
          (cond
            (>= modifier-position 0)
            (fail-result state
              "TODO-NATIVE-DOSEQ-MODIFIER: v0 accepts no :let, :when, or :while clause")

            (not (= 1 (count clauses)))
            (fail-result state
              "TODO-NATIVE-DOSEQ-CLAUSES: v0 accepts exactly one binding clause")

            (not (= 1 (count bodies)))
            (fail-result state
              "TODO-NATIVE-DOSEQ-BODY: v0 accepts exactly one body form")

            :else
            (let [(clause core/NativeId) (nth clauses 0)
                  (name String) (fact-text index clause "name")
                  (target (U core/NativeId Nil))
                  (parameter-target-at index clause)
                  (annotation (U core/NativeId Nil))
                  (index-first-object index clause "ann")
                  (collection-node (U core/NativeId Nil))
                  (index-first-object index clause "value")]
              (cond
                (and (nil? target) (= "" name))
                (fail-result state
                  "TODO-NATIVE-DOSEQ-BINDING: binding has no target")

                (and (some? target) (nil? annotation))
                (fail-result state
                  "TODO-NATIVE-DESTRUCTURE-DOSEQ-TYPE: aggregate binding has no source type")

                (nil? collection-node)
                (fail-result state
                  "TODO-NATIVE-DOSEQ-COLLECTION: the binding has no collection expression")

                :else
                (let [(collection ExprResultV0)
                      (lower-expr env owner state collection-node)
                      (collection-state BodyStateV0) (exprresultv0-state collection)]
                  (cond
                    (exprresultv0-terminated collection) collection
                    (state-blocked? collection-state) (dead-result collection-state)
                    (not (vector-type? types (exprresultv0-type-id collection)))
                    (fail-result collection-state
                      "TODO-NATIVE-DOSEQ-COLLECTION: v0 iterates one closed native Vec")

                    :else
                    (let [(element-type core/NativeId)
                          (vector-element-of types (exprresultv0-type-id collection))
                          (annotation-resolution (U TypeResolutionV0 Nil))
                          (if (nil? annotation) nil
                            (resolve-source-type index annotation))]
                      (cond
                        (and (some? annotation-resolution)
                          (not (typeresolutionv0-valid annotation-resolution)))
                        (fail-result collection-state
                          "TODO-NATIVE-DOSEQ-BINDING-TYPE: the binding annotation is not a closed native type")

                        (and (some? annotation-resolution)
                          (not (same-id? element-type
                                 (typeresolutionv0-type-id annotation-resolution))))
                        (fail-result collection-state
                          "TODO-NATIVE-DOSEQ-BINDING-TYPE: the binding annotation does not match the Vec element type")

                        :else
                        (let [(length-id core/NativeId)
                              (state-id collection-state owner "doseq-length")
                              (zero-id core/NativeId)
                              (state-id collection-state owner "doseq-zero")
                              (header-id core/NativeId)
                              (state-id collection-state owner "doseq-header")
                              (body-id core/NativeId)
                              (state-id collection-state owner "doseq-body")
                              (exit-id core/NativeId)
                              (state-id collection-state owner "doseq-exit")
                              (header-index core/NativeId)
                              (state-id collection-state owner "doseq-index")
                              (prepared BodyStateV0)
                              (state-emit
                                (state-emit (state-bump collection-state)
                                  (core/->VecLengthInstruction
                                    (core/->SsaValueV0 length-id (int-type-id))
                                    (exprresultv0-value-id collection)))
                                (core/->AtomInstruction
                                  (core/->SsaValueV0 zero-id (int-type-id))
                                  (core/->I64Atom 0)))
                              (entered BodyStateV0)
                              (state-open-block
                                (state-close (state-bump prepared)
                                  (core/->JumpTerminator header-id [zero-id]))
                                header-id
                                [(core/->Parameter header-index (int-type-id))])
                              (has-item core/NativeId)
                              (state-id entered owner "doseq-has-item")
                              (compared BodyStateV0)
                              (state-emit (state-bump entered)
                                (core/->CompareInstruction
                                  (core/->SsaValueV0 has-item (bool-type-id))
                                  (core/->CompareLtI64V0 true)
                                  header-index length-id))
                              (branched BodyStateV0)
                              (state-open-block
                                (state-close compared
                                  (core/->BranchTerminator has-item body-id exit-id))
                                body-id [])
                              (item-id core/NativeId)
                              (state-id branched owner "doseq-item")
                              (item-state BodyStateV0)
                              (state-emit (state-bump branched)
                                (core/->VecGetInstruction
                                  (core/->SsaValueV0 item-id element-type)
                                  (exprresultv0-value-id collection)
                                  header-index))
                              (guarded BodyStateV0)
                              (guard-binding-value env owner item-state clause
                                item-id element-type)
                              (body-state BodyStateV0)
                              (if (state-blocked? guarded)
                                guarded
                                (if (nil? target)
                                  (state-bind guarded name item-id element-type)
                                  (if (nil? annotation)
                                    (state-fail guarded
                                      "TODO-NATIVE-DESTRUCTURE-DOSEQ-TYPE: aggregate binding has no source type")
                                    (project-binding-target env owner guarded target
                                      annotation item-id element-type))))
                              (body ExprResultV0)
                              (lower-expr env owner body-state (nth bodies 0))
                              (restored BodyStateV0)
                              (with
                                (state-with-flow-context (exprresultv0-state body)
                                  outer-locals outer-refinements outer-values)
                                [:loop-frames outer-frames])]
                          (cond
                            (state-blocked? restored) (dead-result restored)
                            (exprresultv0-terminated body)
                            (fail-result restored
                              "TODO-NATIVE-DOSEQ-BODY-CONTROL: the body must return to the doseq back edge")
                            :else
                            (let [(one-id core/NativeId)
                                  (state-id restored owner "doseq-one")
                                  (with-one BodyStateV0)
                                  (state-emit (state-bump restored)
                                    (core/->AtomInstruction
                                      (core/->SsaValueV0 one-id (int-type-id))
                                      (core/->I64Atom 1)))
                                  (next-index ExprResultV0)
                                  (lower-checked-arith with-one owner "+"
                                    header-index one-id)
                                  (next-state BodyStateV0)
                                  (exprresultv0-state next-index)]
                              (if (state-blocked? next-state)
                                (dead-result next-state)
                                (let [(exited BodyStateV0)
                                      (state-open-block
                                        (state-close next-state
                                          (core/->JumpTerminator header-id
                                            [(exprresultv0-value-id next-index)]))
                                        exit-id [])
                                      (unit-id core/NativeId)
                                      (state-id exited owner "doseq-unit")]
                                  (->ExprResultV0
                                    (state-emit (state-bump exited)
                                      (core/->UnionConstructInstruction
                                        (core/->SsaValueV0 unit-id (type-id "Nil"))
                                        (variant-id "Unit" "unit") nil))
                                    unit-id (type-id "Nil") false))))))))))))))

        (= "vec" kind)
        (let [(items-node (U core/NativeId Nil)) (index-first-object index expr "items")
              (items (Vec core/NativeId))
              (if (nil? items-node) [] (index-sequence-items index items-node))
              (lowered ArgsResultV0)
              (loop [(position Int) 0
                     (current BodyStateV0) state
                     (values (Vec core/NativeId)) []
                     (value-types (Vec core/NativeId)) []]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ArgsResultV0 current values value-types false)
                  (let [(item ExprResultV0)
                        (lower-expr env owner current (nth items position))]
                    (if (exprresultv0-terminated item)
                      (->ArgsResultV0 (exprresultv0-state item) values value-types
                        true)
                      (recur (+ position 1) (exprresultv0-state item)
                        (conj values (exprresultv0-value-id item))
                        (conj value-types (exprresultv0-type-id item)))))))
              (current BodyStateV0) (argsresultv0-state lowered)
              (values (Vec core/NativeId)) (argsresultv0-values lowered)
              (value-types (Vec core/NativeId)) (argsresultv0-value-types lowered)]
          (cond
            (argsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count values))
            (fail-result current
              "TODO-NATIVE-EMPTY-VECTOR-LITERAL: an empty literal names no element type")

            :else
            (let [(element core/NativeId) (nth value-types 0)
                  (uniform Bool)
                  (loop [(position Int) 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) element)
                      (recur (+ position 1))
                      :else false))
                  (vector-type (U core/NativeId Nil)) (vector-type-of types element)]
              (cond
                (not uniform)
                (fail-result current
                  "TODO-NATIVE-VECTOR-LITERAL-ELEMENTS: the items do not share one native type")

                (nil? vector-type)
                (fail-result current
                  "TODO-NATIVE-VECTOR-LITERAL-TYPE: the module declares no vector of this element type")

                :else
                (build-vector-literal owner current vector-type values)))))

        (= "set" kind)
        (let [(items-node (U core/NativeId Nil)) (index-first-object index expr "items")
              (items (Vec core/NativeId))
              (if (nil? items-node) [] (index-sequence-items index items-node))
              (lowered ArgsResultV0)
              (loop [(position Int) 0
                     (current BodyStateV0) state
                     (values (Vec core/NativeId)) []
                     (value-types (Vec core/NativeId)) []]
                (if (or (>= position (count items)) (state-blocked? current))
                  (->ArgsResultV0 current values value-types false)
                  (let [(item ExprResultV0)
                        (lower-expr env owner current (nth items position))]
                    (if (exprresultv0-terminated item)
                      (->ArgsResultV0 (exprresultv0-state item) values value-types true)
                      (recur (+ position 1) (exprresultv0-state item)
                        (conj values (exprresultv0-value-id item))
                        (conj value-types (exprresultv0-type-id item)))))))
              (current BodyStateV0) (argsresultv0-state lowered)
              (values (Vec core/NativeId)) (argsresultv0-values lowered)
              (value-types (Vec core/NativeId)) (argsresultv0-value-types lowered)]
          (cond
            (argsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count values))
            (fail-result current
              "TODO-NATIVE-EMPTY-SET-LITERAL: an empty literal names no element type")

            :else
            (let [(element-type core/NativeId) (nth value-types 0)
                  (uniform Bool)
                  (loop [(position Int) 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) element-type)
                      (recur (+ position 1))
                      :else false))
                  (set-type (U core/NativeId Nil)) (set-type-of types element-type)
                  (equality (U core/ConcreteEqualityV0 Nil))
                  (set-element-equality-for types element-type)]
              (cond
                (not uniform)
                (fail-result current
                  "TODO-NATIVE-SET-LITERAL-ELEMENTS: the items do not share one native type")

                (nil? set-type)
                (fail-result current
                  "TODO-NATIVE-SET-LITERAL-TYPE: the module declares no set of this element type")

                (nil? equality)
                (fail-result current
                  "TODO-NATIVE-SET-ELEMENT-EQUALITY: the element type has no closed concrete equality")

                :else
                (let [(result-id core/NativeId) (state-id current owner "set-lit")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->SetLiteralInstructionV0
                        (core/->SsaValueV0 result-id set-type)
                        values (arena-value-id owner) equality))
                    result-id set-type false))))))

        (= "map" kind)
        (let [(pairs-node (U core/NativeId Nil)) (index-first-object index expr "pairs")
              (pairs (Vec core/NativeId))
              (if (nil? pairs-node) [] (index-sequence-items index pairs-node))
              (lowered MapItemsResultV0)
              (loop [(position Int) 0
                     (current BodyStateV0) state
                     (key-ids (Vec core/NativeId)) []
                     (key-types (Vec core/NativeId)) []
                     (value-ids (Vec core/NativeId)) []
                     (value-types (Vec core/NativeId)) []]
                (if (or (>= position (count pairs)) (state-blocked? current))
                  (->MapItemsResultV0 current key-ids key-types value-ids value-types false)
                  (let [(pair core/NativeId) (nth pairs position)
                        (key-node (U core/NativeId Nil)) (index-first-object index pair "key")
                        (value-node (U core/NativeId Nil)) (index-first-object index pair "value")]
                    (if (or (nil? key-node) (nil? value-node))
                      (->MapItemsResultV0
                        (state-fail current
                          "TODO-NATIVE-MAP-LITERAL-PAIR: every pair needs a key and value")
                        key-ids key-types value-ids value-types false)
                      (let [(entry-left ExprResultV0)
                            (lower-expr env owner current key-node)]
                        (if (exprresultv0-terminated entry-left)
                          (->MapItemsResultV0 (exprresultv0-state entry-left)
                            key-ids key-types value-ids value-types true)
                          (let [(lowered-value ExprResultV0)
                                (lower-expr env owner
                                  (exprresultv0-state entry-left) value-node)]
                            (if (exprresultv0-terminated lowered-value)
                              (->MapItemsResultV0 (exprresultv0-state lowered-value)
                                key-ids key-types value-ids value-types true)
                              (recur (+ position 1)
                                (exprresultv0-state lowered-value)
                                (conj key-ids (exprresultv0-value-id entry-left))
                                (conj key-types (exprresultv0-type-id entry-left))
                                (conj value-ids (exprresultv0-value-id lowered-value))
                                (conj value-types (exprresultv0-type-id lowered-value)))))))))))
              (current BodyStateV0) (mapitemsresultv0-state lowered)
              (key-ids (Vec core/NativeId)) (mapitemsresultv0-key-ids lowered)
              (key-types (Vec core/NativeId)) (mapitemsresultv0-key-types lowered)
              (value-ids (Vec core/NativeId)) (mapitemsresultv0-value-ids lowered)
              (value-types (Vec core/NativeId)) (mapitemsresultv0-value-types lowered)]
          (cond
            (mapitemsresultv0-terminated lowered)
            (->ExprResultV0 current (lower-id "body" ["unreachable"])
              (type-id "LowerFailure") true)

            (state-blocked? current) (dead-result current)

            (= 0 (count key-ids))
            (fail-result current
              "TODO-NATIVE-EMPTY-MAP-LITERAL: an empty literal names no key or value type")

            :else
            (let [(key-type core/NativeId) (nth key-types 0)
                  (value-type core/NativeId) (nth value-types 0)
                  (uniform-keys Bool)
                  (loop [(position Int) 1]
                    (cond
                      (>= position (count key-types)) true
                      (same-id? (nth key-types position) key-type) (recur (+ position 1))
                      :else false))
                  (uniform-values Bool)
                  (loop [(position Int) 1]
                    (cond
                      (>= position (count value-types)) true
                      (same-id? (nth value-types position) value-type) (recur (+ position 1))
                      :else false))
                  (exact-map-type (U core/NativeId Nil))
                  (if uniform-values
                    (map-type-of types key-type value-type)
                    nil)
                  (map-type (U core/NativeId Nil))
                  (if (some? exact-map-type)
                    exact-map-type
                    (map-type-for-widened-values types key-type value-types))
                  (equality (U core/ConcreteEqualityV0 Nil))
                  (map-key-equality-for types key-type)]
              (cond
                (not uniform-keys)
                (fail-result current
                  "TODO-NATIVE-MAP-LITERAL-ITEMS: keys must share one native type")

                (nil? map-type)
                (fail-result current
                  "TODO-NATIVE-MAP-LITERAL-ITEMS: values have no unique declared closed union")

                (nil? equality)
                (fail-result current
                  "TODO-NATIVE-MAP-KEY-EQUALITY: the key type has no closed concrete equality")

                :else
                (let [(target-value core/NativeId)
                      (map-value-of types map-type)
                      (coerced ArgsResultV0)
                      (coerce-values-to-type types owner current value-ids
                        value-types target-value)
                      (settled BodyStateV0) (argsresultv0-state coerced)]
                  (if (state-blocked? settled)
                    (fail-result settled
                      "TODO-NATIVE-MAP-LITERAL-ITEMS: a value cannot widen to the declared map union")
                    (let [(result-id core/NativeId)
                          (state-id settled owner "map-lit")]
                      (->ExprResultV0
                        (state-emit (state-bump settled)
                          (core/->MapLiteralInstructionV0
                            (core/->SsaValueV0 result-id map-type)
                            key-ids (argsresultv0-values coerced)
                            (arena-value-id owner) equality))
                        result-id map-type false))))))))

        (= "kw-access" kind)
        (let [(keyword String) (fact-text index expr "keyword")
              (target-node (U core/NativeId Nil))
              (index-first-object index expr "target")]
          (if (or (= "" keyword) (nil? target-node))
            (fail-result state
              "TODO-NATIVE-KEYWORD-ACCESS-SOURCE: keyword access needs a literal key and target")
            (let [(target ExprResultV0)
                  (lower-expr env owner state target-node)
                  (current BodyStateV0) (exprresultv0-state target)
                  (target-type core/NativeId) (exprresultv0-type-id target)
                  (field AccessorHitV0)
                  (record-keyword-field types target-type keyword)]
              (cond
                (exprresultv0-terminated target) target

                (state-blocked? current) (dead-result current)

                (accessorhitv0-found field)
                (let [(result-id core/NativeId)
                      (state-id current owner "keyword-field")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->FieldInstruction
                        (core/->SsaValueV0 result-id
                          (accessorhitv0-field-type field))
                        (exprresultv0-value-id target)
                        (accessorhitv0-field-id field)))
                    result-id (accessorhitv0-field-type field) false))

                (map-type? types target-type)
                (let [(key-type core/NativeId) (map-key-of types target-type)
                      (value-type core/NativeId) (map-value-of types target-type)
                      (result-type (U core/NativeId Nil))
                      (nullable-value-type-of types value-type)
                      (equality (U core/ConcreteEqualityV0 Nil))
                      (map-key-equality-for types key-type)]
                  (cond
                    (not (same-id? key-type (keyword-type-id)))
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-KEY: keyword access needs a Keyword-keyed map")

                    (nil? result-type)
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-RESULT: keyword access needs the map's closed nullable value type")

                    (nil? equality)
                    (fail-result current
                      "TODO-NATIVE-KEYWORD-MAP-EQUALITY: keyword access needs closed Keyword equality")

                    :else
                    (let [(refinement (U KeywordFlowRefinementV0 Nil))
                          (find-keyword-refinement current
                            (exprresultv0-value-id target) target-type keyword
                            result-type)
                          (key-id core/NativeId)
                          (state-id current owner "keyword-key")
                          (keyed BodyStateV0)
                          (state-emit (state-bump current)
                            (core/->AtomInstruction
                              (core/->SsaValueV0 key-id (keyword-type-id))
                              (core/->KeywordAtom keyword)))
                          (result-id core/NativeId)
                          (state-id keyed owner "keyword-get")
                          (looked-up BodyStateV0)
                          (state-emit (state-bump keyed)
                            (core/->MapGetInstructionV0
                              (core/->SsaValueV0 result-id result-type)
                              (exprresultv0-value-id target) key-id nil equality))]
                      ;; The proof authorizes only a checked extraction; the
                      ;; repeated lookup still produces and checks its union tag.
                      (if (nil? refinement)
                        (->ExprResultV0 looked-up result-id result-type false)
                        (let [(refined-type core/NativeId)
                              (keywordflowrefinementv0-result-type refinement)
                              (path VariantPathV0)
                              (variant-path-to-payload types result-type
                                refined-type)]
                          (if (not (= 1 (variantpathv0-matches path)))
                            (->ExprResultV0 looked-up result-id result-type false)
                            (extract-variant-path owner looked-up result-id
                              result-type "keyword-refined"
                              (variantpathv0-variants path))))))))

                :else
                (fail-result current
                  "TODO-NATIVE-KEYWORD-ACCESS-TARGET: keyword access needs a closed map or known record field")))))

        (= "method-call" kind)
        (let [(method String) (fact-text index expr "method")
              (target-node (U core/NativeId Nil))
              (index-first-object index expr "target")
              (args-node (U core/NativeId Nil)) (index-first-object index expr "args")
              (args (Vec core/NativeId))
              (if (nil? args-node) [] (index-sequence-items index args-node))]
          (if (or (not (= ".toLowerCase" method))
                (nil? target-node)
                (not (= 1 (count args)))
                (not (source-ref-named? index (nth args 0)
                       "java.util.Locale/ROOT")))
            (fail-result state
              "TODO-NATIVE-METHOD-CALL: v0 lowers only String.toLowerCase(Locale.ROOT)")
            (let [(target ExprResultV0)
                  (lower-expr env owner state target-node)
                  (current BodyStateV0) (exprresultv0-state target)]
              (cond
                (exprresultv0-terminated target) target
                (state-blocked? current) (dead-result current)
                (not (text-operand? (exprresultv0-type-id target)))
                (fail-result current
                  "TODO-NATIVE-TEXT-LOWER-OPERAND: toLowerCase(Locale.ROOT) needs one native Text target")
                :else
                (let [(result-id core/NativeId)
                      (state-id current owner "text-lower-root")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id (text-type-id))
                        (core/->TextLowerV0 (arena-value-id owner)
                          (exprresultv0-value-id target))))
                    result-id (text-type-id) false))))))

        (or (= "call" kind)
          (and (= "static-call" kind)
            (or (host-environment-callee? (fact-text index expr "callee"))
                (host-context-callee? (fact-text index expr "callee"))
                (host-filesystem-callee? (fact-text index expr "callee"))
                (host-process-callee? (fact-text index expr "callee"))
                (host-socket-callee? (fact-text index expr "callee"))
                (host-clock-callee? (fact-text index expr "callee"))
                (host-time-callee? (fact-text index expr "callee")))))
        (let [(callee String) (fact-text index expr "callee")
              (callee-form (U core/NativeId Nil))
              (index-first-object index expr "callee-form")
              (args-node (U core/NativeId Nil)) (index-first-object index expr "args")
              (args (Vec core/NativeId))
              (if (nil? args-node) [] (index-sequence-items index args-node))]
          (cond
            (and (= "" callee) (some? callee-form))
            (fail-result state
              "TODO-NATIVE-INDIRECT-CALL: v0 has no closure or function-pointer ABI")

            (and (= "apply" callee)
              (not (and (= 2 (count args))
                (source-ref-named? index (nth args 0) "str")
                (source-call-named? index (nth args 1) "repeat"))))
            (fail-result state
              "TODO-NATIVE-APPLY: no frozen Fram function requires dynamic argument spreading")

            (and (= "assoc" callee) (> (count args) 0)
              (or (source-ref-record? env state (nth args 0))
                  (and (some? expected) (record-type? types expected))))
            (let [(record-contract String)
                  (fact-text index expr "record-update-contract")
                  (record-name String)
                  (fact-text index expr "record-update-name")]
            (if (or (< (count args) 3) (= 0 (mod (count args) 2)))
              (fail-result state
                "TODO-NATIVE-RECORD-ASSOC-ARITY: assoc takes a record and one or more key/value pairs")
              (if (and (= "true" record-contract) (= "" record-name))
                (fail-result state
                  "LOWER-RECORD-UPDATE-CONTRACT: checked record update has no record identity")
              (let [(source ExprResultV0)
                    (lower-expr env owner state (nth args 0))]
                (cond
                  (exprresultv0-terminated source) source
                  (state-blocked? (exprresultv0-state source))
                  (dead-result (exprresultv0-state source))
                  (not (record-type? types (exprresultv0-type-id source)))
                  (fail-result (exprresultv0-state source)
                    "TODO-NATIVE-RECORD-ASSOC-SOURCE: assoc lowers only for a closed record source")
                  :else
                  (loop [(position Int) 1
                         (current BodyStateV0) (exprresultv0-state source)
                         (current-id core/NativeId) (exprresultv0-value-id source)
                         (record-type core/NativeId) (exprresultv0-type-id source)]
                    (if (or (>= position (count args)) (state-blocked? current))
                      (if (state-blocked? current)
                        (dead-result current)
                        (->ExprResultV0 current current-id record-type false))
                      (let [(key core/NativeId) (nth args position)
                            (literal-key Bool)
                            (and (= "literal" (fact-text index key "form-kind"))
                              (= "keyword" (fact-text index key "literal-kind")))]
                        (if (not literal-key)
                          (fail-result current
                            "TODO-NATIVE-RECORD-ASSOC-KEY: record assoc requires a literal keyword")
                          (let [(keyword String) (fact-text index key "value")
                                (field AccessorHitV0)
                                (record-keyword-field types record-type keyword)]
                            (if (or (not (accessorhitv0-found field))
                                  (not (same-id? record-type
                                    (accessorhitv0-owner-type field))))
                              (fail-result current
                                (str "TODO-NATIVE-RECORD-ASSOC-FIELD: " keyword
                                  " is not a field of the source record"))
                              (let [(replacement ExprResultV0)
                                    (lower-expr env owner current
                                      (nth args (+ position 1)))]
                                (cond
                                  (exprresultv0-terminated replacement) replacement
                                  (state-blocked? (exprresultv0-state replacement))
                                  (dead-result (exprresultv0-state replacement))
                                  :else
                                  (let [(coerced ExprResultV0)
                                        (lower-boundary-coerce types owner
                                          (exprresultv0-state replacement)
                                          (exprresultv0-value-id replacement)
                                          (exprresultv0-type-id replacement)
                                          (accessorhitv0-field-type field))
                                        (settled BodyStateV0)
                                        (exprresultv0-state coerced)]
                                    (if (or (state-blocked? settled)
                                          (not (same-id?
                                            (exprresultv0-type-id coerced)
                                            (accessorhitv0-field-type field))))
                                      (fail-result settled
                                        (str "TODO-NATIVE-RECORD-ASSOC-TYPE: " keyword
                                          " replacement does not match its declared field type"))
                                      (let [(result-id core/NativeId)
                                            (state-id settled owner "record-assoc")
                                            (guarded BodyStateV0)
                                            (guard-record-field-value env owner settled
                                              record-type keyword
                                              (exprresultv0-value-id coerced)
                                              (exprresultv0-type-id coerced))
                                            (next-state BodyStateV0)
                                            (if (state-blocked? guarded)
                                              guarded
                                              (state-emit (state-bump guarded)
                                                (core/->RecordAssocInstructionV0
                                                  (core/->SsaValueV0 result-id record-type)
                                                  current-id
                                                  (accessorhitv0-field-id field)
                                                  (exprresultv0-value-id coerced)
                                                  (arena-value-id owner))))]
                                        (if (state-blocked? next-state)
                                          (dead-result next-state)
                                          (recur (+ position 2) next-state result-id
                                            record-type))))))))))))))))))

            (= "persistent!" callee)
            (lower-closed-persistent env owner state args expected)

            (= "transient" callee)
            (lower-transient-open env owner state args)

            (= "conj!" callee)
            (let [(active (U core/NativeId Nil))
                  (bodystatev0-transient-type state)]
              (if (and (some? active) (vector-type? types active))
                (lower-transient-vector-conj env owner state args)
                (lower-transient-set-conj env owner state args)))

            (= "assoc!" callee)
            (lower-transient-map-assoc env owner state args)

            (= "update" callee)
            (lower-static-update-call env owner state args)

            (and (= "vec" callee) (= 1 (count args))
              (source-call-named? index (nth args 0) "filter"))
            (lower-eager-vector-hof env owner state "filterv"
              (source-call-arguments index (nth args 0)))

            (or (= "mapv" callee) (= "filterv" callee)
                (= "every?" callee) (= "some" callee))
            (lower-eager-vector-hof env owner state callee args)

            (= "reduce-kv" callee)
            (lower-eager-map-reduce-kv env owner state args)

            (= "reduce" callee)
            (if (not (= 3 (count args)))
              (fail-result state
                "TODO-NATIVE-REDUCE-ARITY: reduce lowers only as (reduce fn init collection)")
              (let [(callback-node core/NativeId) (nth args 0)
                    (callback-kind String)
                    (fact-text index callback-node "form-kind")
                    (callback-variadic Bool)
                    (not
                      (nil? (index-first-object index callback-node "rest")))
                    (callback-body (U core/NativeId Nil))
                    (index-first-object index callback-node "body")
                    (callback-return-source (U core/NativeId Nil))
                    (index-first-object index callback-node "ret")
                    (callback-source-parameters (Vec core/NativeId))
                    (function-parameter-items index callback-node)
                    (callback-owner core/NativeId)
                    (state-id state owner "reduce-callback")
                    (callback-resolution ParameterResolutionV0)
                    (resolve-parameters index callback-node callback-owner)
                    (callback-parameters (Vec core/Parameter))
                    (parameterresolutionv0-parameters callback-resolution)]
                (cond
                  (not (= "fn" callback-kind))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK: v0 requires an anonymous function literal")

                  callback-variadic
                  (fail-result state
                    "TODO-NATIVE-REDUCE-VARIADIC: reduce callbacks must have fixed arity")

                  (or (not (= 2 (count callback-source-parameters)))
                      (not (= 2 (count callback-parameters))))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-ARITY: reduce callbacks take accumulator and element")

                  (not (parameterresolutionv0-valid callback-resolution))
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-TYPES: both callback parameters need closed native types")

                  (nil? callback-body)
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-BODY: callback needs exactly one body form")

                  (nil? callback-return-source)
                  (fail-result state
                    "TODO-NATIVE-REDUCE-CALLBACK-RETURN: callback needs a closed return annotation")

                  :else
                  (let [(callback-return TypeResolutionV0)
                        (resolve-source-type index callback-return-source)
                        (active-transient (U core/NativeId Nil))
                        (bodystatev0-transient-type state)
                        (active-kind String)
                        (if (nil? active-transient) ""
                          (transient-collection-kind types active-transient))
                        (transient-reducer Bool)
                        (and (some? active-transient)
                          (active-transient-reduce? index expr active-kind))
                        (accumulator-type core/NativeId)
                        (if (and transient-reducer (some? active-transient))
                          active-transient
                          (core/parameter-type-id (nth callback-parameters 0)))
                        (callback-return-type core/NativeId)
                        (if (and transient-reducer (some? active-transient))
                          active-transient
                          (typeresolutionv0-type-id callback-return))
                        (element-type core/NativeId)
                        (core/parameter-type-id (nth callback-parameters 1))]
                    (if (not (typeresolutionv0-valid callback-return))
                      (fail-result state
                        "TODO-NATIVE-REDUCE-CALLBACK-RETURN: callback return is not a closed native type")
                      (if (not (same-id? accumulator-type
                                 callback-return-type))
                        (fail-result state
                          "TODO-NATIVE-REDUCE-ACCUMULATOR: callback return must match its accumulator parameter")
                        (let [(initial-expected (U core/NativeId Nil))
                              (if (or (vector-type? types accumulator-type)
                                      (map-type? types accumulator-type)
                                      (set-type? types accumulator-type))
                                accumulator-type
                                (if (and (some? expected)
                                         (or (vector-type? types expected)
                                             (map-type? types expected)
                                             (set-type? types expected)))
                                  expected
                                  nil))
                              (initial ExprResultV0)
                              (lower-contextual-boundary env owner state
                                (nth args 1) initial-expected accumulator-type)]
                          (cond
                            (exprresultv0-terminated initial) initial
                            (state-blocked? (exprresultv0-state initial))
                            (dead-result (exprresultv0-state initial))
                            :else
                            (let [(collection-expected (U core/NativeId Nil))
                                  (vector-type-of types element-type)
                                  (collection ExprResultV0)
                                  (lower-reduce-collection env owner
                                    (exprresultv0-state initial) (nth args 2)
                                    collection-expected)
                                  (collection-state BodyStateV0)
                                  (exprresultv0-state collection)]
                              (cond
                                (exprresultv0-terminated collection) collection
                                (state-blocked? collection-state)
                                (dead-result collection-state)
                                (not (same-id? accumulator-type
                                       (exprresultv0-type-id initial)))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-INIT: initial value must match the callback accumulator")
                                (not (vector-type? types
                                       (exprresultv0-type-id collection)))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-COLLECTION: reduce needs a native Vec or closed insertion-order Set")
                                (not (same-id? element-type
                                       (vector-element-of types
                                         (exprresultv0-type-id collection))))
                                (fail-result collection-state
                                  "TODO-NATIVE-REDUCE-ELEMENT: vector element must match the callback element parameter")
                                :else
                                (let [(outer-locals (Vec LocalBindingV0))
                                      (bodystatev0-locals collection-state)
                                      (outer-frames (Vec LoopFrameV0))
                                      (bodystatev0-loop-frames collection-state)
                                      (outer-refinements (Vec KeywordFlowRefinementV0))
                                      (bodystatev0-keyword-refinements collection-state)
                                      (outer-values (Vec ValueFlowRefinementV0))
                                      (bodystatev0-value-refinements collection-state)
                                      (length-id core/NativeId)
                                      (state-id collection-state owner "reduce-length")
                                      (zero-id core/NativeId)
                                      (state-id collection-state owner "reduce-zero")
                                      (header-id core/NativeId)
                                      (state-id collection-state owner "reduce-header")
                                      (body-id core/NativeId)
                                      (state-id collection-state owner "reduce-body")
                                      (exit-id core/NativeId)
                                      (state-id collection-state owner "reduce-exit")
                                      (header-index core/NativeId)
                                      (state-id collection-state owner "reduce-index")
                                      (header-accumulator core/NativeId)
                                      (state-id collection-state owner
                                        "reduce-accumulator")
                                      (prepared BodyStateV0)
                                      (state-emit
                                        (state-emit (state-bump collection-state)
                                          (core/->VecLengthInstruction
                                            (core/->SsaValueV0 length-id
                                              (int-type-id))
                                            (exprresultv0-value-id collection)))
                                        (core/->AtomInstruction
                                          (core/->SsaValueV0 zero-id
                                            (int-type-id))
                                          (core/->I64Atom 0)))
                                      (entered BodyStateV0)
                                      (state-open-block
                                        (state-close (state-bump prepared)
                                          (core/->JumpTerminator header-id
                                            [zero-id
                                             (exprresultv0-value-id initial)]))
                                        header-id
                                        [(core/->Parameter header-index
                                           (int-type-id))
                                         (core/->Parameter header-accumulator
                                           accumulator-type)])
                                      (has-item core/NativeId)
                                      (state-id entered owner "reduce-has-item")
                                      (compared BodyStateV0)
                                      (state-emit (state-bump entered)
                                        (core/->CompareInstruction
                                          (core/->SsaValueV0 has-item
                                            (bool-type-id))
                                          (core/->CompareLtI64V0 true)
                                          header-index length-id))
                                      (branched BodyStateV0)
                                      (state-open-block
                                        (state-close compared
                                          (core/->BranchTerminator has-item
                                            body-id exit-id))
                                        body-id [])
                                      (item-id core/NativeId)
                                      (state-id branched owner "reduce-item")
                                      (isolated BodyStateV0)
                                      (state-enter-inline-callback
                                        (state-emit (state-bump branched)
                                          (core/->VecGetInstruction
                                            (core/->SsaValueV0 item-id
                                              element-type)
                                            (exprresultv0-value-id collection)
                                            header-index)))
                                      (callback-state BodyStateV0)
                                      (bind-source-parameter-value env owner
                                        (bind-source-parameter-value env owner
                                          isolated
                                          (nth callback-source-parameters 0) 0
                                          header-accumulator accumulator-type)
                                        (nth callback-source-parameters 1) 1
                                        item-id element-type)
                                      (callback-result ExprResultV0)
                                      (lower-contextual-boundary env owner
                                        callback-state callback-body accumulator-type
                                        accumulator-type)
                                      (restored BodyStateV0)
                                      (with
                                        (state-with-flow-context
                                          (exprresultv0-state callback-result)
                                          outer-locals outer-refinements outer-values)
                                        [:loop-frames outer-frames])]
                                  (cond
                                    (state-blocked? restored) (dead-result restored)
                                    (exprresultv0-terminated callback-result)
                                    (fail-result restored
                                      "TODO-NATIVE-REDUCE-CALLBACK-DIVERGES: callback does not produce the next accumulator")
                                    (not (same-id? accumulator-type
                                           (exprresultv0-type-id callback-result)))
                                    (fail-result restored
                                      "TODO-NATIVE-REDUCE-CALLBACK-RESULT: callback body does not produce its declared accumulator type")
                                    :else
                                    (let [(one-id core/NativeId)
                                          (state-id restored owner "reduce-one")
                                          (with-one BodyStateV0)
                                          (state-emit (state-bump restored)
                                            (core/->AtomInstruction
                                              (core/->SsaValueV0 one-id
                                                (int-type-id))
                                              (core/->I64Atom 1)))
                                          (next-index ExprResultV0)
                                          (lower-checked-arith with-one owner "+"
                                            header-index one-id)
                                          (next-state BodyStateV0)
                                          (exprresultv0-state next-index)]
                                      (if (state-blocked? next-state)
                                        (dead-result next-state)
                                        (->ExprResultV0
                                          (state-open-block
                                            (state-close next-state
                                              (core/->JumpTerminator header-id
                                                [(exprresultv0-value-id next-index)
                                                 (exprresultv0-value-id
                                                   callback-result)]))
                                            exit-id [])
                                          header-accumulator accumulator-type
                                          false)))))))))))))))

            (and (= "map" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str"))
            (let [(source ExprResultV0)
                  (lower-expr env owner state (nth args 1))]
              (if (or (exprresultv0-terminated source)
                      (state-blocked? (exprresultv0-state source)))
                source
                (if (text-vector-value? types (exprresultv0-type-id source))
                  source
                  (fail-result (exprresultv0-state source)
                    "TODO-NATIVE-TEXT-MAP-OPERAND: map str needs a vector of Text"))))

            (and (= "map" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str/trim"))
            (let [(source ExprResultV0)
                  (lower-expr env owner state (nth args 1))]
              (cond
                (exprresultv0-terminated source) source
                (state-blocked? (exprresultv0-state source))
                (dead-result (exprresultv0-state source))
                (not (text-vector-value? types (exprresultv0-type-id source)))
                (fail-result (exprresultv0-state source)
                  "TODO-NATIVE-TEXT-MAP-OPERAND: map str/trim needs a vector of Text")
                :else
                (let [(base BodyStateV0) (exprresultv0-state source)
                      (result-id core/NativeId)
                      (state-id base owner "text-vector-trim")]
                  (->ExprResultV0
                    (state-emit (state-bump base)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id
                          (exprresultv0-type-id source))
                        (core/->TextVectorTrimV0 (arena-value-id owner)
                          (exprresultv0-value-id source))))
                    result-id (exprresultv0-type-id source) false))))

            (and (= "remove" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str/blank?"))
            (let [(source ExprResultV0)
                  (lower-expr env owner state (nth args 1))]
              (cond
                (exprresultv0-terminated source) source
                (state-blocked? (exprresultv0-state source))
                (dead-result (exprresultv0-state source))
                (not (text-vector-value? types (exprresultv0-type-id source)))
                (fail-result (exprresultv0-state source)
                  "TODO-NATIVE-TEXT-REMOVE-OPERAND: remove str/blank? needs a vector of Text")
                :else
                (let [(base BodyStateV0) (exprresultv0-state source)
                      (result-id core/NativeId)
                      (state-id base owner "text-vector-nonblank")]
                  (->ExprResultV0
                    (state-emit (state-bump base)
                      (core/->TextBuiltinInstruction
                        (core/->SsaValueV0 result-id
                          (exprresultv0-type-id source))
                        (core/->TextVectorRemoveBlankV0 (arena-value-id owner)
                          (exprresultv0-value-id source))))
                    result-id (exprresultv0-type-id source) false))))

            (and (= "apply" callee) (= 2 (count args))
              (source-ref-named? index (nth args 0) "str")
              (source-call-named? index (nth args 1) "repeat"))
            (let [(repeat-args (Vec core/NativeId))
                  (source-call-arguments index (nth args 1))]
              (if (not (= 2 (count repeat-args)))
                (fail-result state
                  "TODO-NATIVE-TEXT-REPEAT-ARITY: repeat needs a count and Text")
                (let [(count-value ExprResultV0)
                      (lower-expr env owner state (nth repeat-args 0))
                      (source ExprResultV0)
                      (if (or (exprresultv0-terminated count-value)
                              (state-blocked? (exprresultv0-state count-value)))
                        count-value
                        (lower-expr env owner
                          (exprresultv0-state count-value)
                          (nth repeat-args 1)))]
                  (cond
                    (exprresultv0-terminated source) source
                    (state-blocked? (exprresultv0-state source))
                    (dead-result (exprresultv0-state source))
                    (not (and (same-id? (exprresultv0-type-id count-value)
                                (int-type-id))
                           (text-operand? (exprresultv0-type-id source))))
                    (fail-result (exprresultv0-state source)
                      "TODO-NATIVE-TEXT-REPEAT-OPERANDS: repeat needs Int and Text")
                    :else
                    (let [(base BodyStateV0) (exprresultv0-state source)
                          (result-id core/NativeId)
                          (state-id base owner "text-repeat")]
                      (->ExprResultV0
                        (state-emit (state-bump base)
                          (core/->TextBuiltinInstruction
                            (core/->SsaValueV0 result-id (text-type-id))
                            (core/->TextRepeatV0 (arena-value-id owner)
                              (exprresultv0-value-id source)
                              (exprresultv0-value-id count-value))))
                        result-id (text-type-id) false))))))

            (= "throw" callee)
            (let [(code-id core/NativeId) (state-id state owner "trap")
                  (emitted BodyStateV0)
                  (state-emit (state-bump state)
                    (core/->AtomInstruction
                      (core/->SsaValueV0 code-id (int-type-id))
                      (core/->I64Atom (trap-failure-code))))]
              (->ExprResultV0
                (state-close emitted (core/->TrapTerminator code-id))
                code-id (type-id "LowerFailure") true))

            (or (= "and" callee) (= "or" callee))
            (let [(arity Int) (count args)]
              (if (= 0 arity)
                (if (= "and" callee)
                  (bool-constant-result state owner "logic-empty" true)
                  ;; The checker's Any result lets a Bool boundary own empty-or's carrier.
                  (if (and (some? expected)
                           (same-id? expected (bool-type-id)))
                    (bool-constant-result state owner "logic-empty" false)
                    (nil-constant-result types state owner "logic-empty")))
                (if (= 1 arity)
                  (let [(only ExprResultV0)
                        (lower-expr-expected env owner state
                          (nth args 0) expected)]
                    (cond
                      (exprresultv0-terminated only) only
                      (state-blocked? (exprresultv0-state only))
                      (dead-result (exprresultv0-state only))
                      :else only))
                  (let [(join-id core/NativeId) (state-id state owner "logic-join")
                        (join-parameter core/NativeId)
                        (state-id state owner "logic-value")]
                    (loop [(position Int) 0
                           (current BodyStateV0) (state-bump state)
                           (arms (Vec LogicArmV0)) []]
                      (let [(operand-expected (U core/NativeId Nil))
                            (if (= (+ position 1) arity) expected nil)
                            (operand ExprResultV0)
                            (lower-expr-expected env owner current
                              (nth args position) operand-expected)]
                        (cond
                          (state-blocked? (exprresultv0-state operand))
                          (dead-result (exprresultv0-state operand))
                          (exprresultv0-terminated operand)
                          (if (= 0 position)
                            operand
                            (bridge-logic-arms types owner
                              (exprresultv0-state operand) arms
                              join-id join-parameter expected))
                          (= (+ position 1) arity)
                          (let [(arm-start Int)
                                (count (bodystatev0-blocks
                                         (exprresultv0-state operand)))
                                (after-value BodyStateV0)
                                (state-close (exprresultv0-state operand)
                                  (core/->JumpTerminator join-id
                                    [(exprresultv0-value-id operand)]))
                                (live-arms (Vec LogicArmV0))
                                (conj arms
                                  (->LogicArmV0 arm-start
                                    (count (bodystatev0-blocks after-value))
                                    (exprresultv0-type-id operand)))]
                            (bridge-logic-arms types owner after-value live-arms
                              join-id join-parameter expected))
                          :else
                          (let [(truthy ExprResultV0)
                                (lower-truthy types owner
                                  (exprresultv0-state operand)
                                  (exprresultv0-value-id operand)
                                  (exprresultv0-type-id operand))
                                (condition-state BodyStateV0)
                                (exprresultv0-state truthy)
                                (next-id core/NativeId)
                                (state-id condition-state owner
                                  (str "logic-rest-" position))
                                (shortcut-id core/NativeId)
                                (state-id condition-state owner
                                  (str "logic-shortcut-" position))
                                (branched BodyStateV0)
                                (state-close (state-bump condition-state)
                                  (if (= "and" callee)
                                    (core/->BranchTerminator
                                      (exprresultv0-value-id truthy)
                                      next-id shortcut-id)
                                    (core/->BranchTerminator
                                      (exprresultv0-value-id truthy)
                                      shortcut-id next-id)))]
                            (if (state-blocked? condition-state)
                              (dead-result condition-state)
                              (let [(shortcut-start Int)
                                    (count (bodystatev0-blocks branched))
                                    (after-shortcut BodyStateV0)
                                    (state-close
                                      (state-open-block branched shortcut-id [])
                                      (core/->JumpTerminator join-id
                                        [(exprresultv0-value-id operand)]))
                                    (live-arms (Vec LogicArmV0))
                                    (conj arms
                                      (->LogicArmV0 shortcut-start
                                        (count (bodystatev0-blocks after-shortcut))
                                        (exprresultv0-type-id operand)))]
                                (recur (+ position 1)
                                  (state-open-block after-shortcut next-id [])
                                  live-arms)))))))))))

            (= "not" callee)
            (if (not (= 1 (count args)))
              (fail-result state "TODO-NATIVE-NOT-ARITY: not takes one operand")
              (let [(raw-operand ExprResultV0)
                    (lower-expr env owner state (nth args 0))
                    (operand ExprResultV0)
                    (if (or (exprresultv0-terminated raw-operand)
                            (state-blocked? (exprresultv0-state raw-operand)))
                      raw-operand
                      (lower-truthy types owner
                        (exprresultv0-state raw-operand)
                        (exprresultv0-value-id raw-operand)
                        (exprresultv0-type-id raw-operand)))]
                (cond
                  (exprresultv0-terminated operand) operand
                  (state-blocked? (exprresultv0-state operand))
                  (dead-result (exprresultv0-state operand))
                  (not (same-id? (exprresultv0-type-id operand) (bool-type-id)))
                  (fail-result (exprresultv0-state operand)
                    "TODO-NATIVE-BOOL-OPERAND: not needs a native Bool operand")
                  :else
                  (let [(base BodyStateV0) (exprresultv0-state operand)
                        (false-id core/NativeId) (state-id base owner "not-const")
                        (result-id core/NativeId) (state-id base owner "not")]
                    (->ExprResultV0
                      (state-emit
                        (state-emit (state-bump base)
                          (core/->AtomInstruction
                            (core/->SsaValueV0 false-id (bool-type-id))
                            (core/->BoolAtom false)))
                        (core/->CompareInstruction
                          (core/->SsaValueV0 result-id (bool-type-id))
                          (core/->CompareEqBoolV0 true)
                          (exprresultv0-value-id operand) false-id))
                      result-id (bool-type-id) false)))))

            (= "instance?" callee)
            (if (not (= 2 (count args)))
              (fail-result state
                "TODO-NATIVE-INSTANCE-ARITY: instance? takes a type and a value")
              (let [(record-spelling String) (fact-text index (nth args 0) "name")
                    (value ExprResultV0) (lower-expr env owner state (nth args 1))
                    (record-type (U core/NativeId Nil))
                    (match-record-type-id-for-target env owner
                      (exprresultv0-type-id value) (nth args 0))]
                (cond
                  (exprresultv0-terminated value) value
                  (state-blocked? (exprresultv0-state value))
                  (dead-result (exprresultv0-state value))
                  (nil? record-type)
                  (fail-result (exprresultv0-state value)
                    (str "TODO-NATIVE-INSTANCE-TYPE: " record-spelling
                      " is not a visible closed record"))
                  :else
                  (lower-record-predicate-with-budget types owner
                    (exprresultv0-state value)
                    (exprresultv0-value-id value)
                    (exprresultv0-type-id value)
                    record-type (widen-budget)))))

            (= "native/tiled-step!" callee)
            (if (not (= 7 (count args)))
              (fail-result state
                "TODO-NATIVE-TILED-STEP-ARITY: native/tiled-step! takes current, next, tile width, left/right halo, boundary, and a named kernel")
              (let [(current ExprResultV0)
                    (lower-expr env owner state (nth args 0))
                    (next ExprResultV0)
                    (if (or (exprresultv0-terminated current)
                          (state-blocked? (exprresultv0-state current)))
                      current
                      (lower-expr env owner (exprresultv0-state current)
                        (nth args 1)))
                    (settled BodyStateV0) (exprresultv0-state next)
                    (tile-width (U Int Nil))
                    (source-int-literal-value index (nth args 2))
                    (left-halo (U Int Nil))
                    (source-int-literal-value index (nth args 3))
                    (right-halo (U Int Nil))
                    (source-int-literal-value index (nth args 4))
                    (boundary-name (U String Nil))
                    (source-keyword-literal-value index (nth args 5))
                    (kernel-node core/NativeId) (nth args 6)
                    (kernel-name String) (fact-text index kernel-node "name")
                    (signature (U TypedFunctionV0 Nil))
                    (if (= "ref" (fact-text index kernel-node "form-kind"))
                      (find-signature env kernel-node kernel-name)
                      nil)]
                (cond
                  (exprresultv0-terminated current) current
                  (exprresultv0-terminated next) next
                  (state-blocked? settled) (dead-result settled)
                  (or (not (f64-buffer-type? types
                             (exprresultv0-type-id current)))
                    (not (f64-buffer-type? types
                           (exprresultv0-type-id next))))
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-BUFFER: current and next must be (Buffer Float)")
                  (nil? tile-width)
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-TILE: tile width must be a positive compile-time Int literal")
                  (<= tile-width 0)
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-TILE: tile width must be positive")
                  (or (nil? left-halo) (nil? right-halo)
                    (< left-halo 0) (< right-halo 0))
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-HALO: halo widths must be nonnegative compile-time Int literals")
                  (and (not (= boundary-name "bounded"))
                    (not (= boundary-name "periodic")))
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-BOUNDARY: boundary must be :bounded or :periodic")
                  (nil? signature)
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-KERNEL: tile kernel must be a statically named native function")
                  (not (tiled-kernel-signature? types signature))
                  (fail-result settled
                    "TODO-NATIVE-TILED-STEP-KERNEL: tile kernel signature must be [(Buffer Float) (Buffer Float) Int Int Int -> Nil]")
                  :else
                  (let [(result-id core/NativeId)
                        (state-id settled owner "tiled-step-f64")]
                    (->ExprResultV0
                      (state-emit (state-bump settled)
                        (core/->TiledStepF64InstructionV0
                          (core/->SsaValueV0 result-id (bool-type-id))
                          (exprresultv0-value-id current)
                          (exprresultv0-value-id next)
                          tile-width left-halo right-halo
                          (if (= boundary-name "periodic")
                            (core/->ParallelPeriodicV0 true)
                            (core/->ParallelBoundedV0 true))
                          (typedfunctionv0-id signature)
                          (arena-region-id)
                          (read-capability-id)
                          (write-capability-id)))
                      result-id (bool-type-id) false)))))

            (= "native/f64-buffer-sum" callee)
            (if (not (= 2 (count args)))
              (fail-result state
                "TODO-NATIVE-F64-SUM-ARITY: native/f64-buffer-sum takes a Buffer and compile-time tile width")
              (let [(source ExprResultV0)
                    (lower-expr env owner state (nth args 0))
                    (settled BodyStateV0) (exprresultv0-state source)
                    (tile-width (U Int Nil))
                    (source-int-literal-value index (nth args 1))]
                (cond
                  (exprresultv0-terminated source) source
                  (state-blocked? settled) (dead-result settled)
                  (not (f64-buffer-type? types (exprresultv0-type-id source)))
                  (fail-result settled
                    "TODO-NATIVE-F64-SUM-BUFFER: native/f64-buffer-sum requires (Buffer Float)")
                  (or (nil? tile-width) (<= tile-width 0))
                  (fail-result settled
                    "TODO-NATIVE-F64-SUM-TILE: tile width must be a positive compile-time Int literal")
                  :else
                  (let [(result-id core/NativeId)
                        (state-id settled owner "f64-buffer-sum")]
                    (->ExprResultV0
                      (state-emit (state-bump settled)
                        (core/->F64BufferSumInstructionV0
                          (core/->SsaValueV0 result-id (float-type-id))
                          (exprresultv0-value-id source)
                          tile-width
                          (core/->F64AdjacentPairwiseV0 true)
                          (arena-region-id)
                          (read-capability-id)))
                      result-id (float-type-id) false)))))

            (= "swap!" (unqualified-name callee))
            (if (< (count args) 2)
              (fail-result state
                "TODO-NATIVE-ATOM-SWAP-ARITY: swap! takes an Atom, a named updater, and optional updater arguments")
              (let [(cell ExprResultV0)
                    (lower-expr env owner state (nth args 0))
                    (cell-state BodyStateV0) (exprresultv0-state cell)]
                (cond
                  (exprresultv0-terminated cell) cell
                  (state-blocked? cell-state) (dead-result cell-state)
                  (not (= "ref" (fact-text index (nth args 1) "form-kind")))
                  (fail-result cell-state
                    "TODO-NATIVE-ATOM-SWAP-UPDATER: swap! requires a statically named pure native updater")
                  :else
                  (let [(updater-name String)
                        (fact-text index (nth args 1) "name")
                        (bare-updater String) (unqualified-name updater-name)
                        (signature (U TypedFunctionV0 Nil))
                        (find-signature env (nth args 1) updater-name)
                        (content (U core/NativeId Nil))
                        (atom-cell-content-of types (exprresultv0-type-id cell))]
                    (cond
                      (nil? content)
                      (fail-result cell-state
                        "TODO-NATIVE-ATOM-SWAP-CELL: swap! first operand is not an Atom")
                      (static-atom-builtin-updater? bare-updater)
                      (lower-static-atom-builtin-swap env owner cell content
                        bare-updater args)
                      (nil? signature)
                      (fail-result cell-state
                        (str "TODO-NATIVE-ATOM-SWAP-UPDATER: " updater-name
                          " is not a statically named native function"))
                      (not (pure-updater-signature? signature content
                             (- (count args) 2)))
                      (fail-result cell-state
                        (str "TODO-NATIVE-ATOM-SWAP-UPDATER: " updater-name
                          " must be pure, take the Atom value first, and return that same type"))
                      :else
                      (let [(lowered ArgsResultV0)
                            (loop [(position Int) 2
                                   (current BodyStateV0) cell-state
                                   (values (Vec core/NativeId)) []
                                   (value-types (Vec core/NativeId)) []]
                              (if (or (>= position (count args))
                                    (state-blocked? current))
                                (->ArgsResultV0 current values value-types false)
                                (let [(argument ExprResultV0)
                                      (lower-expr env owner current
                                        (nth args position))]
                                  (if (exprresultv0-terminated argument)
                                    (->ArgsResultV0
                                      (exprresultv0-state argument)
                                      values value-types true)
                                    (recur (+ position 1)
                                      (exprresultv0-state argument)
                                      (conj values
                                        (exprresultv0-value-id argument))
                                      (conj value-types
                                        (exprresultv0-type-id argument)))))))
                            (current BodyStateV0) (argsresultv0-state lowered)]
                        (cond
                          (argsresultv0-terminated lowered)
                          (->ExprResultV0 current
                            (lower-id "body" ["unreachable"])
                            (type-id "LowerFailure") true)
                          (state-blocked? current) (dead-result current)
                          :else
                          (let [(coerced ArgsResultV0)
                                (coerce-arguments types owner current
                                  (argsresultv0-values lowered)
                                  (argsresultv0-value-types lowered)
                                  (tail-parameters
                                    (typedfunctionv0-parameters signature)))
                                (settled BodyStateV0)
                                (argsresultv0-state coerced)
                                (result-id core/NativeId)
                                (state-id settled owner "atom-swap")]
                            (if (state-blocked? settled)
                              (fail-result settled
                                "TODO-NATIVE-ATOM-SWAP-ARGUMENTS: updater arguments do not match its native parameters")
                              (->ExprResultV0
                                (state-emit (state-bump settled)
                                  (core/->AtomSwapInstruction
                                    (core/->SsaValueV0 result-id content)
                                    (exprresultv0-value-id cell)
                                    (atom-state-value-id owner)
                                    (typedfunctionv0-id signature)
                                    (argsresultv0-values coerced)))
                                result-id content false))))))))))

            :else
            (let [(resolved-callee ResolvedSourceNameV0)
                  (resolve-source-name index (source-module-name index expr) callee)
                  (accessor AccessorHitV0)
                  (record-accessor types resolved-callee)
                  (bare-callee String) (unqualified-name callee)
                  (constructor (U core/TypeDef Nil))
                  (let [(record (U core/TypeDef Nil))
                        (record-constructor types resolved-callee)]
                    (if (nil? record)
                      (union-member-constructor env resolved-callee)
                      record))
                  (payloadless-constructor (U core/TypeDef Nil))
                  (payloadless-union-member-constructor env resolved-callee)
                  (signature (U TypedFunctionV0 Nil))
                  (find-signature env expr callee)
                  (lowered ArgsResultV0)
                  (loop [(position Int) 0
                         (current BodyStateV0) state
                         (values (Vec core/NativeId)) []
                         (value-types (Vec core/NativeId)) []]
                    (if (or (>= position (count args)) (state-blocked? current))
                      (->ArgsResultV0 current values value-types false)
                      (let [(argument-node core/NativeId) (nth args position)
                            (declared-expected (U core/NativeId Nil))
                            (contextual-argument-type constructor signature
                              (count args) position)
                            (receiver-expected (U core/NativeId Nil))
                            (expected-collection-argument-type
                              types callee position value-types)
                            (preserved-expected (U core/NativeId Nil))
                            (preserved-collection-argument-type types bare-callee
                              (count args) position expected)
                            (equality-expected (U core/NativeId Nil))
                            (equality-empty-argument-type types index env current
                              bare-callee position value-types args argument-node)
                            (argument-expected (U core/NativeId Nil))
                            (if (some? declared-expected)
                              declared-expected
                              (if (some? receiver-expected)
                                receiver-expected
                                (if (some? preserved-expected)
                                  preserved-expected equality-expected)))
                            (argument ExprResultV0)
                            (lower-expr-expected env owner current argument-node
                              argument-expected)]
                        (if (exprresultv0-terminated argument)
                          (->ArgsResultV0 (exprresultv0-state argument) values
                            value-types true)
                          (recur (+ position 1) (exprresultv0-state argument)
                            (conj values (exprresultv0-value-id argument))
                            (conj value-types (exprresultv0-type-id argument)))))))
                  (current BodyStateV0) (argsresultv0-state lowered)
                  (values (Vec core/NativeId)) (argsresultv0-values lowered)
                  (value-types (Vec core/NativeId)) (argsresultv0-value-types lowered)
                  (comparison (U core/CompareOpV0 Nil)) (compare-op-for callee)
                  (static-predicate (U Bool Nil))
                  (if (= 1 (count values))
                    (static-type-predicate-value types callee
                      (nth value-types 0))
                    nil)
                  (static-keyword (U String Nil))
                  (if (and (= "keyword" callee) (= 1 (count args)))
                    (source-string-literal-value index (nth args 0))
                    nil)]
              (cond
                (argsresultv0-terminated lowered)
                (->ExprResultV0 current (lower-id "body" ["unreachable"])
                  (type-id "LowerFailure") true)

                (state-blocked? current) (dead-result current)

                (some? static-predicate)
                (bool-constant-result current owner "static-predicate"
                  static-predicate)

                (and (static-collection-predicate? callee)
                  (= 1 (count values))
                  (= 0 (count
                    (union-variants-of types (nth value-types 0)))))
                (fail-result current
                  (str "TODO-NATIVE-PREDICATE-TYPE: " callee
                    " needs a known exact native type"))

                (and (static-collection-predicate? callee)
                  (not (= 1 (count values))))
                (fail-result current
                  (str "TODO-NATIVE-PREDICATE-ARITY: " callee
                    " takes one operand"))

                (some? static-keyword)
                (let [(spelling String) static-keyword
                      (result-id core/NativeId)
                      (state-id current owner "keyword-literal")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->AtomInstruction
                        (core/->SsaValueV0 result-id (keyword-type-id))
                        (core/->KeywordAtom spelling)))
                    result-id (keyword-type-id) false))

                (and (= "keyword" callee) (= 1 (count values))
                  (text-operand? (nth value-types 0)))
                (let [(result-id core/NativeId)
                      (state-id current owner "keyword")]
                  (->ExprResultV0
                    (state-emit (state-bump current)
                      (core/->CopyInstruction
                        (core/->SsaValueV0 result-id (keyword-type-id))
