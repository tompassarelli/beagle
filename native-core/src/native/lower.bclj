(defn source-host-variant-role
  [(target-type core/NativeId) (name String)] String
  (cond
    (and (same-id? target-type (filesystem-int-outcome-type-id))
      (= name "host.fs/PathKindOk")) "ok"
    (and (same-id? target-type (filesystem-int-outcome-type-id))
      (= name "host.fs/PathKindError")) "error"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.fs/ReadTextBoundedOk")) "ok"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.fs/ReadTextBoundedError")) "error"
    (and (same-id? target-type (filesystem-paths-outcome-type-id))
      (= name "host.fs/ListDirectoryBoundedOk")) "ok"
    (and (same-id? target-type (filesystem-paths-outcome-type-id))
      (= name "host.fs/ListDirectoryBoundedError")) "error"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/WriteTextAtomicOk")) "ok"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/WriteTextAtomicError")) "error"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/MakeParentDirectoriesOk")) "ok"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/MakeParentDirectoriesError")) "error"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/AppendTextOk")) "ok"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/AppendTextError")) "error"
    (and (same-id? target-type (filesystem-int-outcome-type-id))
      (= name "host.fs/LockExclusiveOk")) "ok"
    (and (same-id? target-type (filesystem-int-outcome-type-id))
      (= name "host.fs/LockExclusiveError")) "error"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/UnlockOk")) "ok"
    (and (same-id? target-type (filesystem-nil-outcome-type-id))
      (= name "host.fs/UnlockError")) "error"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.clock/FormatIso8601Ok")) "ok"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.clock/FormatIso8601Error")) "error"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.system/HostnameOk")) "ok"
    (and (same-id? target-type (filesystem-text-outcome-type-id))
      (= name "host.system/HostnameError")) "error"
    (and (same-id? target-type (process-capture-outcome-type-id))
      (= name "host.process/CaptureOk")) "ok"
    (and (same-id? target-type (process-capture-outcome-type-id))
      (= name "host.process/CaptureError")) "error"
    (and (same-id? target-type (process-spawn-stdout-outcome-type-id))
      (= name "host.process/SpawnStdoutOk")) "ok"
    (and (same-id? target-type (process-spawn-stdout-outcome-type-id))
      (= name "host.process/SpawnStdoutError")) "error"
    (and (same-id? target-type (process-read-line-outcome-type-id))
      (= name "host.process/ReadLineOk")) "ok"
    (and (same-id? target-type (process-read-line-outcome-type-id))
      (= name "host.process/ReadLineError")) "error"
    :else name))

(defn type-def-in? [(definitions (Vec core/TypeDef)) (id core/NativeId)] Bool
  (loop [(index Int) 0]
    (if (>= index (count definitions))
      false
      (if (same-id? id (core/typedef-id (nth definitions index)))
        true
        (recur (+ index 1))))))

(defn append-type-def
  [(definitions (Vec core/TypeDef))
   (definition core/TypeDef)]
  (Vec core/TypeDef)
  (if (type-def-in? definitions (core/typedef-id definition))
    definitions
    (conj definitions definition)))

(defn append-type-defs
  [(definitions (Vec core/TypeDef))
   (additions (Vec core/TypeDef))]
  (Vec core/TypeDef)
  (loop [(index Int) 0 (current (Vec core/TypeDef)) definitions]
    (if (>= index (count additions))
      current
      (recur (+ index 1) (append-type-def current (nth additions index))))))

(defn union-member-definitions
  [(record-keys (Vec String))
   (ids (Vec core/NativeId))
   (definitions (Vec core/TypeDef))]
  (Vec core/TypeDef)
  (loop [(position Int) 0 (current (Vec core/TypeDef)) definitions]
    (if (>= position (count record-keys))
      current
      (let [(key String) (nth record-keys position)]
        (recur (+ position 1)
          (if (core/id-in? ids (source-type-id key))
            (append-type-def current (record-reference-type key))
            current))))))

(defn builtin-types [(record-keys (Vec String))] (Vec core/TypeDef)
  (append-type-defs
    [(bool-type) (i64-type) (f64-type) (text-type) (keyword-type)
     (nil-type) (lower-failure-type)]
    (slice-value-definitions record-keys)))

(defn append-diagnostics
  [(left (Vec core/DiagnosticV0))
   (right (Vec core/DiagnosticV0))]
  (Vec core/DiagnosticV0)
  (vec (concat left right)))

(defn source-type-kind
  [(index SourceIndexV0) (source-type core/NativeId)] (U String Nil)
  (let [(kind (U String Nil)) (index-first-text index source-type "type-kind")]
    (if (some? kind) kind (index-first-text index source-type "form-kind"))))

(defn source-type-spelling
  [(index SourceIndexV0) (source-type core/NativeId)] (U String Nil)
  (index-first-text index source-type "name"))

(defn primitive-resolution
  [(index SourceIndexV0)
   (source-type core/NativeId)
   (spelling String)]
  TypeResolutionV0
  (cond
    (= "Bool" spelling)
    (->TypeResolutionV0 (type-id "Bool") [(bool-type)] [] true)

    (= "Int" spelling)
    (->TypeResolutionV0 (type-id "Int") [(i64-type)] [] true)

    (fixed-integer-name? spelling)
    (->TypeResolutionV0 (type-id spelling) [(fixed-integer-type spelling)] [] true)

    (= "Float" spelling)
    (->TypeResolutionV0 (type-id "Float") [(f64-type)] [] true)

    (= "String" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    ;; Regex values stay as their uninterpreted pattern text until a regex operation
    ;; consumes them; compilation belongs to the materializer/runtime boundary.
    (= "Regex" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    (= "SpaceId" spelling)
    (->TypeResolutionV0 (type-id "String") [(text-type)] [] true)

    (= "ByteSource" spelling)
    (->TypeResolutionV0 (byte-source-type-id) [(byte-source-type)] [] true)

    (= "NativeBytes" spelling)
    (->TypeResolutionV0 (bytes-type-id) [(bytes-type)] [] true)

    (= "Keyword" spelling)
    (->TypeResolutionV0 (type-id "Keyword") [(keyword-type)] [] true)

    (= "Nil" spelling)
    (->TypeResolutionV0 (type-id "Nil") [(nil-type)] [] true)

    (= "host.fs/PathKindResult" spelling)
    (->TypeResolutionV0 (filesystem-int-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/ReadTextBoundedResult" spelling)
    (->TypeResolutionV0 (filesystem-text-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/ListDirectoryBoundedResult" spelling)
    (->TypeResolutionV0 (filesystem-paths-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/WriteTextAtomicResult" spelling)
    (->TypeResolutionV0 (filesystem-nil-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/MakeParentDirectoriesResult" spelling)
    (->TypeResolutionV0 (filesystem-nil-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/AppendTextResult" spelling)
    (->TypeResolutionV0 (filesystem-nil-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/LockExclusiveResult" spelling)
    (->TypeResolutionV0 (filesystem-int-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.fs/UnlockResult" spelling)
    (->TypeResolutionV0 (filesystem-nil-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.clock/FormatIso8601Result" spelling)
    (->TypeResolutionV0 (filesystem-text-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.system/HostnameResult" spelling)
    (->TypeResolutionV0 (filesystem-text-outcome-type-id)
      (filesystem-outcome-types) [] true)

    (= "host.process/CaptureResult" spelling)
    (->TypeResolutionV0 (process-capture-outcome-type-id)
      (process-outcome-types) [] true)

    (= "host.process/SpawnStdoutResult" spelling)
    (->TypeResolutionV0 (process-spawn-stdout-outcome-type-id)
      (process-outcome-types) [] true)

    (= "host.process/ReadLineResult" spelling)
    (->TypeResolutionV0 (process-read-line-outcome-type-id)
      (process-outcome-types) [] true)

    (= "Any" spelling)
    (->TypeResolutionV0
      (type-id "SliceValue")
      (slice-value-definitions (sourceindexv0-record-keys index))
      [(core/->DiagnosticV0
         "LOWER-CLOSED-RAW-ANY"
         "raw Any was closed to the finite SliceValue union")]
      true)

    :else
    (let [(module-name String) (source-module-name index source-type)
          (resolved ResolvedSourceNameV0)
          (resolve-source-name index module-name spelling)]
      (if (resolvedsourcenamev0-visible resolved)
        (->TypeResolutionV0
          (source-type-id (resolved-source-key resolved)) [] [] true)
        (->TypeResolutionV0
          (type-id "LowerFailure")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-UNRESOLVED-TYPE-OWNER"
             (str "source type is not visible from " module-name ": " spelling))]
          false)))))

(defn source-type-arguments
  [(index SourceIndexV0) (source-type core/NativeId)] (Vec core/NativeId)
  (let [(arguments (U core/NativeId Nil))
        (index-first-object index source-type "args")]
    (if (nil? arguments) [] (index-sequence-items index arguments))))

(defn resolution-ids [(resolutions (Vec TypeResolutionV0))] (Vec core/NativeId)
  (mapv
    (fn [(resolution TypeResolutionV0)] core/NativeId
      (typeresolutionv0-type-id resolution))
    resolutions))

(defn resolution-definitions
  [(resolutions (Vec TypeResolutionV0))] (Vec core/TypeDef)
  (loop [(index Int) 0 (definitions (Vec core/TypeDef)) []]
    (if (>= index (count resolutions))
      definitions
      (recur (+ index 1)
        (append-type-defs definitions
          (typeresolutionv0-definitions (nth resolutions index)))))))

(defn resolution-diagnostics
  [(resolutions (Vec TypeResolutionV0))] (Vec core/DiagnosticV0)
  (loop [(index Int) 0 (diagnostics (Vec core/DiagnosticV0)) []]
    (if (>= index (count resolutions))
      diagnostics
      (recur (+ index 1)
        (append-diagnostics diagnostics
          (typeresolutionv0-diagnostics (nth resolutions index)))))))

(defn union-variants
  [(owner String) (type-ids (Vec core/NativeId))] (Vec core/TypeVariant)
  (loop [(index Int) 0 (variants (Vec core/TypeVariant)) []]
    (if (>= index (count type-ids))
      variants
      (recur (+ index 1)
        (conj variants
          (core/->TypeVariant
            (variant-id owner (str index))
            (str "case-" index)
            (nth type-ids index)))))))

(defn nullable-map-value-type-id [(value-type core/NativeId)] core/NativeId
  (lower-id "closed-union-type"
    [(id-value value-type) (id-value (type-id "Nil"))]))

(defn nullable-map-value-type [(value-type core/NativeId)] core/TypeDef
  (let [(id core/NativeId) (nullable-map-value-type-id value-type)
        (owner String) (id-value id)]
    (core/->TypeDef id "ClosedUnion"
      (core/->UnionType
        (union-variants owner [value-type (type-id "Nil")])))))

(defn closed-vector-type-id [(element-type core/NativeId)] core/NativeId
  (lower-id "vector-type" [(id-value element-type)]))

(defn closed-vector-type [(element-type core/NativeId)] core/TypeDef
  (core/->TypeDef (closed-vector-type-id element-type) "Vector"
    (core/->VectorType element-type)))

(defn closed-buffer-type-id [(element-type core/NativeId)] core/NativeId
  (lower-id "buffer-type-v0" [(id-value element-type)]))

(defn closed-buffer-type [(element-type core/NativeId)] core/TypeDef
  (core/->TypeDef (closed-buffer-type-id element-type) "Buffer"
    (core/->BufferTypeV0 element-type)))

(defn homogeneous-type-ids? [(ids (Vec core/NativeId))] Bool
  (if (= 0 (count ids))
    false
    (loop [(position Int) 1]
      (if (>= position (count ids))
        true
        (if (same-id? (nth ids 0) (nth ids position))
          (recur (+ position 1))
          false)))))

(defn closed-hvec-type-id [(elements (Vec core/NativeId))] core/NativeId
  (lower-id "hvec-type"
    (mapv (fn [(element core/NativeId)] String (id-value element)) elements)))

(defn closed-hvec-type [(elements (Vec core/NativeId))] core/TypeDef
  (core/->TypeDef (closed-hvec-type-id elements) "HVec"
    (core/->VectorType (nth elements 0))))

(defn application-resolution
  [(source-type core/NativeId)
   (constructor String)
   (record-keys (Vec String))
   (resolutions (Vec TypeResolutionV0))]
  TypeResolutionV0
  (let [(ids (Vec core/NativeId)) (resolution-ids resolutions)
        (definitions (Vec core/TypeDef)) (resolution-definitions resolutions)
        (diagnostics (Vec core/DiagnosticV0)) (resolution-diagnostics resolutions)]
    (cond
      (and (= "Vec" constructor) (= 1 (count ids)))
      (let [(id core/NativeId) (closed-vector-type-id (nth ids 0))]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (closed-vector-type (nth ids 0)))
          diagnostics
          true))

      (and (= "TransientVec" constructor) (= 1 (count ids)))
      (let [(id core/NativeId) (closed-vector-type-id (nth ids 0))]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (closed-vector-type (nth ids 0)))
          diagnostics
          true))

      (and (= "Buffer" constructor)
        (= 1 (count ids))
        (same-id? (nth ids 0) (type-id "Float")))
      (let [(id core/NativeId) (closed-buffer-type-id (nth ids 0))]
        (->TypeResolutionV0 id
          (append-type-def definitions (closed-buffer-type (nth ids 0)))
          diagnostics
          true))

      (= "Buffer" constructor)
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        (conj diagnostics
          (core/->DiagnosticV0
            "LOWER-BUFFER-ELEMENT-V0"
            "Native Buffer v0 requires exactly one Float element type"))
        false)

      ;; Native Core's vector carrier is homogeneous.  A homogeneous HVec
      ;; retains its positional source identity while sharing that carrier;
      ;; heterogeneous tuples are refused instead of being reinterpreted.
      (and (= "HVec" constructor) (homogeneous-type-ids? ids))
      (let [(id core/NativeId) (closed-hvec-type-id ids)]
        (->TypeResolutionV0 id
          (append-type-def definitions (closed-hvec-type ids))
          diagnostics
          true))

      (= "HVec" constructor)
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        (conj diagnostics
          (core/->DiagnosticV0
            "LOWER-HVEC-NATIVE-SHAPE"
            "Native Core currently requires a non-empty homogeneous HVec carrier"))
        false)

      (and (= "Atom" constructor) (= 1 (count ids)))
      (let [(id core/NativeId)
            (lower-id "atom-cell-type" [(id-value (nth ids 0))])]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (core/->TypeDef id "AtomCell"
              (core/->AtomCellTypeV0 (nth ids 0))))
          diagnostics
          true))

      (and (= "Map" constructor) (= 2 (count ids)))
      (let [(key-type core/NativeId) (nth ids 0)
            (value-type core/NativeId) (nth ids 1)
            (id core/NativeId)
            (lower-id "map-type-v0"
              [(id-value key-type) (id-value value-type)])]
        (->TypeResolutionV0 id
          (append-type-def
            (append-type-def
              (append-type-defs definitions
                [(closed-vector-type key-type)
                 (closed-vector-type value-type)])
              (nullable-map-value-type value-type))
            (core/->TypeDef id "Map"
              (core/->MapTypeV0 key-type value-type
                (core/->InsertionOrderV0 true))))
          diagnostics
          true))

      (and (= "Set" constructor) (= 1 (count ids)))
      (let [(id core/NativeId)
            (lower-id "set-type-v0" [(id-value (nth ids 0))])]
        (->TypeResolutionV0 id
          (append-type-def definitions
            (core/->TypeDef id "Set"
              (core/->SetTypeV0 (nth ids 0) (core/->InsertionOrderV0 true))))
          diagnostics
          true))

      (or (= "Dyn" constructor) (= "U" constructor))
      (let [(members (Vec core/NativeId)) (union-member-ids record-keys ids)
            (id core/NativeId)
            (lower-id "closed-union-type"
              (mapv (fn [(part core/NativeId)] String (id-value part)) members))]
        (->TypeResolutionV0 id
          (append-type-def
            (union-member-definitions record-keys ids definitions)
            (core/->TypeDef id "ClosedUnion"
              (core/->UnionType (union-variants (id-value id) members))))
          diagnostics
          true))

      :else
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        (conj diagnostics
          (core/->DiagnosticV0
            "LOWER-UNSUPPORTED-TYPE-APPLICATION"
            (str "unsupported closed type constructor: " constructor)))
        false))))

(defn resolve-source-type
  [(index SourceIndexV0) (source-type core/NativeId)] TypeResolutionV0
  (let [(kind (U String Nil)) (source-type-kind index source-type)
        (spelling (U String Nil)) (source-type-spelling index source-type)]
    (cond
      (nil? kind)
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-MISSING-TYPE-KIND"
           (str "source type has no kind: " (id-value source-type)))]
        false)

      (or (= "type-prim" kind) (= "prim" kind))
      (if (nil? spelling)
        (->TypeResolutionV0
          (type-id "LowerFailure")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-MISSING-TYPE-NAME"
             (str "primitive type has no spelling: " (id-value source-type)))]
          false)
        (primitive-resolution index source-type spelling))

      (or (= "type-app" kind) (= "app" kind))
      (if (nil? spelling)
        (->TypeResolutionV0
          (type-id "LowerFailure")
          [(lower-failure-type)]
          [(core/->DiagnosticV0
             "LOWER-MISSING-TYPE-CONSTRUCTOR"
             (str "type application has no constructor: " (id-value source-type)))]
          false)
        (let [(arguments (Vec core/NativeId)) (source-type-arguments index source-type)
              (resolutions (Vec TypeResolutionV0))
              (mapv
                (fn [(argument core/NativeId)] TypeResolutionV0
                  (resolve-source-type index argument))
                arguments)]
          (application-resolution source-type spelling
            (sourceindexv0-record-keys index) resolutions)))

      (or (= "type-union" kind) (= "union" kind))
      (let [(arguments (Vec core/NativeId)) (source-type-arguments index source-type)
            (resolutions (Vec TypeResolutionV0))
            (mapv
              (fn [(argument core/NativeId)] TypeResolutionV0
                (resolve-source-type index argument))
              arguments)]
        (application-resolution source-type "U"
          (sourceindexv0-record-keys index) resolutions))

      (= "type-fn" kind)
      (let [(parameters-node (U core/NativeId Nil))
            (index-first-object index source-type "params")
            (parameter-sources (Vec core/NativeId))
            (if (nil? parameters-node)
              []
              (index-sequence-items index parameters-node))
            (rest-source (U core/NativeId Nil))
            (index-first-object index source-type "rest")
            (return-source (U core/NativeId Nil))
            (index-first-object index source-type "ret")
            (component-sources (Vec core/NativeId))
            (vec (concat parameter-sources
                   (if (nil? rest-source) [] [rest-source])
                   (if (nil? return-source) [] [return-source])))
            (resolutions (Vec TypeResolutionV0))
            (mapv
              (fn [(component core/NativeId)] TypeResolutionV0
                (resolve-source-type index component))
              component-sources)
            (parameter-count Int) (count parameter-sources)
            (parameter-types (Vec core/NativeId))
            (loop [(position Int) 0 (collected (Vec core/NativeId)) []]
              (if (>= position parameter-count)
                collected
                (recur (+ position 1)
                  (conj collected
                    (typeresolutionv0-type-id (nth resolutions position))))))
            (rest-position Int) parameter-count
            (return-position Int)
            (+ parameter-count (if (nil? rest-source) 0 1))
            (rest-type (U core/NativeId Nil))
            (if (nil? rest-source)
              nil
              (typeresolutionv0-type-id (nth resolutions rest-position)))
            (return-type core/NativeId)
            (if (nil? return-source)
              (type-id "LowerFailure")
              (typeresolutionv0-type-id (nth resolutions return-position)))
            (parts (Vec String))
            (vec (concat
                   (mapv
                     (fn [(parameter core/NativeId)] String
                       (id-value parameter))
                     parameter-types)
                   [(if (nil? rest-type)
                      "fixed"
                      (str "rest:" (id-value rest-type)))
                    "returns"
                    (id-value return-type)]))
            (id core/NativeId) (lower-id "function-type" parts)
            (definitions (Vec core/TypeDef))
            (append-type-def
              (resolution-definitions resolutions)
              (core/->TypeDef id "Function"
                (core/->FunctionType parameter-types rest-type return-type)))
            (diagnostics (Vec core/DiagnosticV0))
            (resolution-diagnostics resolutions)
            (valid Bool)
            (and (some? return-source)
              (every?
                (fn [(resolution TypeResolutionV0)] Bool
                  (typeresolutionv0-valid resolution))
                resolutions))]
        (->TypeResolutionV0 id definitions
          (if (some? return-source)
            diagnostics
            (conj diagnostics
              (core/->DiagnosticV0
                "LOWER-FUNCTION-TYPE-RETURN"
                "function type has no return annotation")))
          valid))

      :else
      (->TypeResolutionV0
        (type-id "LowerFailure")
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-UNSUPPORTED-TYPE-KIND"
           (str "unsupported source type kind: " kind))]
        false))))

(defrecord RecordResolutionV0
  [(definition core/TypeDef)
   (supporting-definitions (Vec core/TypeDef))
   (diagnostics (Vec core/DiagnosticV0))
   (valid Bool)])

(defrecord ParameterResolutionV0
  [(parameters (Vec core/Parameter))
   (definitions (Vec core/TypeDef))
   (diagnostics (Vec core/DiagnosticV0))
   (valid Bool)])

(defrecord EffectiveFunctionSignatureV0
  [(present Bool)
   (parameter-types (Vec core/NativeId))
   (return-type (U core/NativeId Nil))
   (diagnostics (Vec core/DiagnosticV0))
   (valid Bool)])

(defrecord FunctionResolutionV0
  [(function TypedFunctionV0)
   (definitions (Vec core/TypeDef))
   (diagnostics (Vec core/DiagnosticV0))
   (valid Bool)])

(defn field-name-at
  [(index SourceIndexV0) (source-field core/NativeId)] (U String Nil)
  (index-first-text index source-field "name"))

(defn field-type-at
  [(index SourceIndexV0) (source-field core/NativeId)] (U core/NativeId Nil)
  (index-first-object index source-field "ann"))

(defn record-field-items
  [(index SourceIndexV0) (source-record core/NativeId)] (Vec core/NativeId)
  (let [(fields (U core/NativeId Nil))
        (index-first-object index source-record "fields")]
    (if (nil? fields) [] (index-sequence-items index fields))))

(defn resolve-record
  [(index SourceIndexV0) (source-record core/NativeId)] RecordResolutionV0
  (let [(record-name (U String Nil)) (index-first-text index source-record "name")
        (module-name String) (source-module-name index source-record)]
    (if (or (nil? record-name) (= "" module-name))
      (->RecordResolutionV0
        (core/->TypeDef (type-id "LowerFailure") "LowerFailure"
          (core/->ReferenceType (type-id "LowerFailure")))
        [(lower-failure-type)]
        [(core/->DiagnosticV0
           "LOWER-RECORD-MISSING-NAME"
           (str "record form has no module-qualified name: "
             (id-value source-record)))]
        false)
      (let [(record-key String) (str module-name "/" record-name)
            (source-fields (Vec core/NativeId)) (record-field-items index source-record)]
        (loop [(position Int) 0
               (fields (Vec core/TypeField)) []
               (definitions (Vec core/TypeDef)) []
               (diagnostics (Vec core/DiagnosticV0)) []
               (valid Bool) true]
          (if (>= position (count source-fields))
            (->RecordResolutionV0
              (core/->TypeDef (source-type-id record-key) record-name
                (core/->RecordType fields))
              definitions
              diagnostics
              valid)
            (let [(source-field core/NativeId) (nth source-fields position)
                  (name (U String Nil)) (field-name-at index source-field)
                  (source-type (U core/NativeId Nil)) (field-type-at index source-field)]
              (if (or (nil? name) (nil? source-type))
                (recur (+ position 1)
                  fields
                  definitions
                  (conj diagnostics
                    (core/->DiagnosticV0
                      "LOWER-FIELD-MISSING-ANNOTATION"
                      (str "record field is missing a name or type: "
                        (id-value source-field))))
                  false)
                (let [(resolution TypeResolutionV0)
                      (resolve-source-type index source-type)]
                  (recur (+ position 1)
                    (conj fields
                      (core/->TypeField
                        (field-id record-key name)
                        name
                        (typeresolutionv0-type-id resolution)))
                    (append-type-defs definitions
                      (typeresolutionv0-definitions resolution))
                    (append-diagnostics diagnostics
                      (typeresolutionv0-diagnostics resolution))
                    (and valid (typeresolutionv0-valid resolution))))))))))))

(defn record-fields-same?
  [(left (Vec core/TypeField)) (right (Vec core/TypeField))] Bool
  (and (= (count left) (count right))
    (loop [(position Int) 0]
      (if (>= position (count left))
        true
        (let [(left-field core/TypeField) (nth left position)
              (right-field core/TypeField) (nth right position)]
          (if (and
                (= (core/typefield-name left-field)
                  (core/typefield-name right-field))
                (same-id? (core/typefield-id left-field)
                  (core/typefield-id right-field))
                (same-id? (core/typefield-type-id left-field)
                  (core/typefield-type-id right-field)))
            (recur (+ position 1))
            false))))))

(defn record-definitions-same-shape?
  [(left core/TypeDef) (right core/TypeDef)] Bool
  (let [(left-shape core/TypeShape) (core/typedef-shape left)
        (right-shape core/TypeShape) (core/typedef-shape right)]
    (and (instance? native.core.RecordType left-shape)
      (instance? native.core.RecordType right-shape)
      (record-fields-same? (core/recordtype-fields left-shape)
        (core/recordtype-fields right-shape)))))

(defn record-definition-conflicts?
  [(definitions (Vec core/TypeDef)) (candidate core/TypeDef)] Bool
  (loop [(position Int) 0]
    (if (>= position (count definitions))
      false
      (let [(prior core/TypeDef) (nth definitions position)]
        (if (same-id? (core/typedef-id prior) (core/typedef-id candidate))
          (not (record-definitions-same-shape? prior candidate))
          (recur (+ position 1)))))))

(defn resolve-records [(index SourceIndexV0)] (Vec RecordResolutionV0)
  (let [(source-records (Vec core/NativeId))
        (vec (concat (index-form-ids index "record")
               (filterv
                 (fn [(group core/NativeId)] Bool
                   (= "true" (fact-text index group "inline")))
                 (index-form-ids index "member-field-group"))))]
    (loop [(position Int) 0
           (definitions (Vec core/TypeDef)) []
           (resolutions (Vec RecordResolutionV0)) []]
      (if (>= position (count source-records))
        resolutions
        (let [(resolution RecordResolutionV0)
              (resolve-record index (nth source-records position))
              (definition core/TypeDef) (recordresolutionv0-definition resolution)
              (conflict Bool) (record-definition-conflicts? definitions definition)
              (settled RecordResolutionV0)
              (if conflict
                (with
                  (with resolution
                    [:diagnostics
                     (conj (recordresolutionv0-diagnostics resolution)
                       (core/->DiagnosticV0
                         "LOWER-RECORD-ID-SHAPE-COLLISION"
                         (str "record identity has incompatible shapes: "
                           (id-value (core/typedef-id definition)))))])
                  [:valid false])
                resolution)]
          (recur (+ position 1)
            (append-type-def definitions definition)
            (conj resolutions settled)))))))

(defn union-member-group-items
  [(index SourceIndexV0) (source-union core/NativeId)] (Vec core/NativeId)
  (let [(groups (U core/NativeId Nil))
        (index-first-object index source-union "members")]
    (if (nil? groups) [] (index-sequence-items index groups))))

(defn resolve-source-union
  [(index SourceIndexV0) (source-union core/NativeId)] core/TypeDef
  (let [(name String) (fact-text index source-union "name")
        (module-name String) (source-module-name index source-union)
        (owner String) (str module-name "/" name)
        (groups (Vec core/NativeId))
        (union-member-group-items index source-union)
        (variants (Vec core/TypeVariant))
        (loop [(position Int) 0 (collected (Vec core/TypeVariant)) []]
          (if (>= position (count groups))
            collected
            (let [(group core/NativeId) (nth groups position)
                  (member String) (fact-text index group "name")
                  (inline Bool) (= "true" (fact-text index group "inline"))
                  (payload (U core/NativeId Nil))
                  (if inline
                    (record-reference-type-id (str module-name "/" member))
                    nil)]
              (recur (+ position 1)
                (conj collected
                  (core/->TypeVariant (variant-id owner member) member payload))))))]
    (core/->TypeDef (source-type-id owner) name (core/->UnionType variants))))

(defn source-union-types [(index SourceIndexV0)] (Vec core/TypeDef)
  (mapv
    (fn [(source-union core/NativeId)] core/TypeDef
      (resolve-source-union index source-union))
    (vec (concat (index-form-ids index "defunion")
           (index-form-ids index "deferror")))))

(defn parameter-target-at
  [(index SourceIndexV0) (source-parameter core/NativeId)] (U core/NativeId Nil)
  (let [(target (U core/NativeId Nil))
        (index-first-object index source-parameter "name")]
    (if (nil? target)
      nil
      (let [(kind (U String Nil))
            (index-first-text index target "form-kind")]
        (if (or (= "map-destructure" kind) (= "seq-destructure" kind))
          target
          nil)))))

(defn aggregate-parameter-name [(position Int)] String
  (str "$beagle$param$" position))

(defn parameter-name-at
  [(index SourceIndexV0) (source-parameter core/NativeId) (position Int)] String
  (let [(name (U String Nil)) (index-first-text index source-parameter "name")
        (target (U core/NativeId Nil))
        (parameter-target-at index source-parameter)]
    (cond
      (some? target) (aggregate-parameter-name position)
      (some? name) name
      :else (str "parameter-" (id-value source-parameter)))))

(defn function-parameter-items
  [(index SourceIndexV0) (source-function core/NativeId)] (Vec core/NativeId)
  (let [(parameters (U core/NativeId Nil))
        (index-first-object index source-function "params")]
    (if (nil? parameters) [] (index-sequence-items index parameters))))

(defn effective-function-signature
  [(index SourceIndexV0)
   (source-function core/NativeId)
   (source-parameters (Vec core/NativeId))]
  EffectiveFunctionSignatureV0
  (let [(effective-type (U core/NativeId Nil))
        (index-first-object index source-function "effective-type")
        (source-name (U String Nil))
        (index-first-text index source-function "name")
        (name String)
        (if (nil? source-name) (id-value source-function) source-name)]
    (if (nil? effective-type)
      (->EffectiveFunctionSignatureV0 false [] nil [] true)
      (let [(kind (U String Nil)) (source-type-kind index effective-type)]
        (cond
          (= "type-poly" kind)
          (->EffectiveFunctionSignatureV0
            true [] nil
            [(core/->DiagnosticV0
               "LOWER-POLYMORPHIC-FUNCTION-ABI"
               (str name " has a generalized effective signature; Native requires a closed monomorphic ABI"))]
            false)

          (not (= "type-fn" kind))
          (->EffectiveFunctionSignatureV0
            true [] nil
            [(core/->DiagnosticV0
               "LOWER-EFFECTIVE-FUNCTION-TYPE"
               (str name " has a non-function effective signature: " kind))]
            false)

          :else
          (let [(parameters-node (U core/NativeId Nil))
                (index-first-object index effective-type "params")
                (parameter-types (Vec core/NativeId))
                (if (nil? parameters-node)
                  []
                  (index-sequence-items index parameters-node))
                (rest-type (U core/NativeId Nil))
                (index-first-object index effective-type "rest")
                (source-rest (U core/NativeId Nil))
                (index-first-object index source-function "rest")
                (return-type (U core/NativeId Nil))
                (index-first-object index effective-type "ret")]
            (cond
              (or (some? rest-type) (some? source-rest))
              (->EffectiveFunctionSignatureV0
                true parameter-types return-type
                [(core/->DiagnosticV0
                   "LOWER-VARIADIC-FUNCTION-ABI"
                   (str name " has a rest parameter; Native v0 has no call-site packing ABI"))]
                false)

              (not (= (count parameter-types) (count source-parameters)))
              (->EffectiveFunctionSignatureV0
                true parameter-types return-type
                [(core/->DiagnosticV0
                   "LOWER-EFFECTIVE-PARAMETER-COUNT"
                   (str name " has " (count source-parameters)
                     " source parameters but its effective signature has "
                     (count parameter-types)))]
                false)

              (nil? return-type)
              (->EffectiveFunctionSignatureV0
                true parameter-types nil
                [(core/->DiagnosticV0
                   "LOWER-EFFECTIVE-FUNCTION-RETURN"
                   (str name " has an effective function signature without a return type"))]
                false)

              :else
              (->EffectiveFunctionSignatureV0
                true parameter-types return-type [] true))))))))

(defn resolve-parameters-with-signature
  [(index SourceIndexV0)
   (source-function core/NativeId)
   (owner-id core/NativeId)
   (signature EffectiveFunctionSignatureV0)]
  ParameterResolutionV0
  (let [(source-parameters (Vec core/NativeId))
        (function-parameter-items index source-function)
        (effective Bool) (effectivefunctionsignaturev0-present signature)
        (signature-valid Bool) (effectivefunctionsignaturev0-valid signature)
        (effective-types (Vec core/NativeId))
        (effectivefunctionsignaturev0-parameter-types signature)]
    (if (and effective (not signature-valid))
      (->ParameterResolutionV0 [] [(lower-failure-type)]
        (effectivefunctionsignaturev0-diagnostics signature) false)
      (loop [(position Int) 0
             (parameters (Vec core/Parameter)) []
             (definitions (Vec core/TypeDef)) []
             (diagnostics (Vec core/DiagnosticV0))
             (effectivefunctionsignaturev0-diagnostics signature)
             (valid Bool) signature-valid]
        (if (>= position (count source-parameters))
          (->ParameterResolutionV0 parameters definitions diagnostics valid)
          (let [(source-parameter core/NativeId) (nth source-parameters position)
                (name String) (parameter-name-at index source-parameter position)
                (source-type (U core/NativeId Nil))
                (if effective
                  (nth effective-types position)
                  (field-type-at index source-parameter))]
            (if (nil? source-type)
              (recur (+ position 1)
                parameters
                definitions
                (conj diagnostics
                  (core/->DiagnosticV0
                    "LOWER-PARAMETER-MISSING-ANNOTATION"
                    (str "function parameter has no closed type: " name)))
                false)
              (let [(resolution TypeResolutionV0)
                    (resolve-source-type index source-type)]
                (recur (+ position 1)
                  (conj parameters
                    (core/->Parameter
                      (lower-id "parameter" [(id-value owner-id) name])
                      (typeresolutionv0-type-id resolution)))
                  (append-type-defs definitions
                    (typeresolutionv0-definitions resolution))
                  (append-diagnostics diagnostics
                    (typeresolutionv0-diagnostics resolution))
                  (and valid (typeresolutionv0-valid resolution)))))))))))

(defn resolve-parameters
  [(index SourceIndexV0)
   (source-function core/NativeId)
   (owner-id core/NativeId)]
  ParameterResolutionV0
  (let [(source-parameters (Vec core/NativeId))
        (function-parameter-items index source-function)
        (signature EffectiveFunctionSignatureV0)
        (effective-function-signature index source-function source-parameters)]
    (resolve-parameters-with-signature index source-function owner-id signature)))

