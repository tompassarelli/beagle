      (= name "host.system/platform")
      (= name "host.terminal/stdout-tty?")))

(defn host-context-operation [(name String)] String
  (cond
    (= name "host.system/hostname") "system-hostname"
    (= name "host.system/platform") "system-platform"
    (= name "host.terminal/stdout-tty?") "terminal-stdout-tty"
    :else ""))

(defn host-context-abi-id? [(candidate core/NativeId)] Bool
  (or (same-id? candidate (host-context-abi-id "system-hostname"))
      (same-id? candidate (host-context-abi-id "system-platform"))
      (same-id? candidate (host-context-abi-id "terminal-stdout-tty"))))

