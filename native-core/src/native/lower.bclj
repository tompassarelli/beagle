  (lower-id "extern" ["host-process-run-capture-v0"]))

(defn host-process-lifecycle-abi-id [(operation String)] core/NativeId
  (lower-id "abi" [(str "host-process-" operation "-v0")]))

(defn host-process-lifecycle-function-id [(operation String)] core/NativeId
  (lower-id "extern" [(str "host-process-" operation "-v0")]))

(defn host-process-abi-id? [(candidate core/NativeId)] Bool
  (or (same-id? candidate (host-process-abi-id))
      (same-id? candidate (host-process-capture-abi-id))
      (same-id? candidate (host-process-lifecycle-abi-id "spawn-stdout"))
      (same-id? candidate
        (host-process-lifecycle-abi-id "read-line-bounded"))
      (same-id? candidate (host-process-lifecycle-abi-id "wait"))
      (same-id? candidate (host-process-lifecycle-abi-id "close"))
      (same-id? candidate (host-process-lifecycle-abi-id "exec-replace"))
      (same-id? candidate
        (host-process-lifecycle-abi-id "read-line-deadline"))
      (same-id? candidate (host-process-lifecycle-abi-id "fifo-create"))
      (same-id? candidate (host-process-lifecycle-abi-id "fifo-open-read"))
      (same-id? candidate
        (host-process-lifecycle-abi-id "fifo-write-deadline"))
      (same-id? candidate (host-process-lifecycle-abi-id "poll-readable"))
      (same-id? candidate (host-process-lifecycle-abi-id "current-pid"))
      (same-id? candidate (host-process-lifecycle-abi-id "alive"))
      (same-id? candidate (host-process-lifecycle-abi-id "signal"))
      (same-id? candidate
        (host-process-lifecycle-abi-id "wait-not-alive"))))

(defn host-process-callee? [(name String)] Bool
  (or (= name "host.process/run-inherit")
      (= name "host.process/run-capture")
      (= name "host.process/spawn-stdout")
      (= name "host.process/read-line-bounded")
      (= name "host.process/read-line-deadline")
      (= name "host.process/exec-replace")
      (= name "host.process/fifo-create")
      (= name "host.process/fifo-open-read")
      (= name "host.process/fifo-write-deadline")
      (= name "host.process/poll-readable")
      (= name "host.process/current-pid")
      (= name "host.process/alive?")
      (= name "host.process/signal")
      (= name "host.process/wait-not-alive")
      (= name "host.process/wait")
      (= name "host.process/close")))

(defn host-socket-effect-id [] core/NativeId
  (lower-id "effect" ["host-socket-peer-lifecycle-v0"]))

(defn host-socket-capability-id [] core/NativeId
