(defn slice-abis
  [(functions (Vec TypedFunctionV0))
   (native-functions (Vec core/FunctionDef))
   (types (Vec core/TypeDef))
   (layouts (Vec core/LayoutDef))]
  (Vec core/AbiDeclV0)
  (let [(digest String) (layout-digest layouts)
        (exports (Vec core/AbiDeclV0))
        (function-abis functions native-functions layouts)
        (with-environment (Vec core/AbiDeclV0))
        (if (not (any-function-uses-environment? functions))
          exports
          (let [(optional (U core/NativeId Nil))
                (optional-scalar-type-of types (text-type-id))]
            (if (nil? optional)
              exports
              (conj exports (host-environment-abi optional digest)))))
        (context-abis (Vec core/AbiDeclV0)) (host-context-abis digest)
        (with-context-hostname (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-context-abi-id "system-hostname"))
          (conj with-environment (nth context-abis 0))
          with-environment)
        (with-context-platform (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-context-abi-id "system-platform"))
          (conj with-context-hostname (nth context-abis 1))
          with-context-hostname)
        (with-context (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-context-abi-id "terminal-stdout-tty"))
          (conj with-context-platform (nth context-abis 2))
          with-context-platform)
        (with-stdout-write (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions (host-stdout-write-abi-id))
          (conj with-context (host-stdout-write-abi digest))
          with-context)
        (with-stdout (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions (host-stdout-abi-id))
          (conj with-stdout-write (host-stdout-abi digest))
          with-stdout-write)
        (with-stderr-write (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions (host-stderr-write-abi-id))
          (conj with-stdout (host-stderr-write-abi digest))
          with-stdout)
        (with-stderr (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-stderr-write-line-abi-id))
          (conj with-stderr-write (host-stderr-write-line-abi digest))
          with-stderr-write)
        (filesystem-abis (Vec core/AbiDeclV0))
        (host-filesystem-abis digest)
        (filesystem-base-used Bool)
        (or
          (any-function-calls-abi? functions
            (host-filesystem-abi-id "read-text-bounded"))
          (any-function-calls-abi? functions
            (host-filesystem-abi-id "list-directory-bounded"))
          (any-function-calls-abi? functions
            (host-filesystem-abi-id "path-kind"))
          (any-function-calls-abi? functions
            (host-filesystem-abi-id "write-text-atomic")))
        (with-filesystem-base (Vec core/AbiDeclV0))
        (if filesystem-base-used
          (vec (concat with-stderr
            [(nth filesystem-abis 0) (nth filesystem-abis 1)
             (nth filesystem-abis 2) (nth filesystem-abis 3)]))
          with-stderr)
        (with-filesystem-parents (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-filesystem-abi-id "make-parent-directories"))
          (conj with-filesystem-base (nth filesystem-abis 4))
          with-filesystem-base)
        (with-filesystem-append (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-filesystem-abi-id "append-text"))
          (conj with-filesystem-parents (nth filesystem-abis 5))
          with-filesystem-parents)
        (with-filesystem-lock (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-filesystem-abi-id "lock-exclusive"))
          (conj with-filesystem-append (nth filesystem-abis 6))
          with-filesystem-append)
        (with-filesystem (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-filesystem-abi-id "unlock"))
          (conj with-filesystem-lock (nth filesystem-abis 7))
          with-filesystem-lock)
        (process-abis (Vec core/AbiDeclV0)) (host-process-abis digest)
        (called-process-abis (Vec core/AbiDeclV0))
        (filterv
          (fn [(abi core/AbiDeclV0)] Bool
            (any-function-calls-abi? functions (core/abideclv0-id abi)))
          process-abis)
        (with-process (Vec core/AbiDeclV0))
        (vec (concat with-filesystem called-process-abis))
        (with-time-sleep (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions (host-time-sleep-abi-id))
          (conj with-process (host-time-sleep-abi digest))
          with-process)
        (with-monotonic-clock (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions (host-clock-abi-id))
          (conj with-time-sleep (host-clock-abi digest))
          with-time-sleep)
        (wall-clock-abis (Vec core/AbiDeclV0))
        (host-wall-clock-abis digest)
        (with-wall-clock (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-wall-clock-abi-id "wall-nanoseconds"))
          (conj with-monotonic-clock (nth wall-clock-abis 0))
          with-monotonic-clock)
        (with-clock (Vec core/AbiDeclV0))
        (if (any-function-calls-abi? functions
              (host-wall-clock-abi-id "format-iso8601"))
          (conj with-wall-clock (nth wall-clock-abis 1))
          with-wall-clock)]
    (if (any-function-uses-host-socket? functions)
      (vec (concat with-clock (host-socket-abis digest)))
      with-clock)))

(defn encode-scalar-repr [(representation core/ScalarReprV0)] String
  (cond
    (instance? native.core.BoolReprV0 representation)
    (stages/canonical-record "bool" [(str (core/boolreprv0-bit-width representation))])
    (instance? native.core.SignedIntReprV0 representation)
    (stages/canonical-record "signed-int"
      [(str (core/signedintreprv0-bit-width representation))])
    (instance? native.core.UnsignedIntReprV0 representation)
    (stages/canonical-record "unsigned-int"
      [(str (core/unsignedintreprv0-bit-width representation))])
    :else
    (stages/canonical-record "float"
      [(str (core/floatreprv0-bit-width representation))])))

(defn encode-field-layout [(field core/FieldLayoutV0)] String
  (stages/canonical-record "field-layout-v0"
    [(id-value (core/fieldlayoutv0-field-id field))
     (id-value (core/fieldlayoutv0-type-id field))
     (str (core/fieldlayoutv0-offset-bytes field))
     (str (core/fieldlayoutv0-align-bytes field))]))

(defn encode-variant-layout [(variant core/UnionVariantLayoutV0)] String
  (let [(payload (U core/NativeId Nil))
        (core/unionvariantlayoutv0-payload-type variant)]
    (stages/canonical-record "variant-layout-v0"
      [(id-value (core/unionvariantlayoutv0-variant-id variant))
       (str (core/unionvariantlayoutv0-tag variant))
       (if (nil? payload) "unit" (id-value payload))
       (str (core/unionvariantlayoutv0-payload-offset-bytes variant))])))

(defn encode-layout-shape [(shape core/LayoutShapeV0)] String
  (cond
    (instance? native.core.ScalarShapeV0 shape)
    (stages/canonical-record "scalar-layout"
      [(encode-scalar-repr (core/scalarshapev0-representation shape))])

    (instance? native.core.BytesShapeV0 shape)
    "native-bytes-layout-v0"

    (instance? native.core.RecordShapeV0 shape)
    (stages/canonical-record "record-layout"
      (mapv
        (fn [(field core/FieldLayoutV0)] String
          (encode-field-layout field))
        (core/recordshapev0-fields shape)))

    (instance? native.core.UnionShapeV0 shape)
    (stages/canonical-record "union-layout"
      [(id-value (core/unionshapev0-tag-type shape))
       (str (core/unionshapev0-tag-offset-bytes shape))
       (stages/canonical-record "variants"
         (mapv
           (fn [(variant core/UnionVariantLayoutV0)] String
             (encode-variant-layout variant))
           (core/unionshapev0-variants shape)))])

    (instance? native.core.VectorShapeV0 shape)
    (stages/canonical-record "vector-layout"
      [(id-value (core/vectorshapev0-element-type shape))
       (str (core/vectorshapev0-stride-bytes shape))])

    (instance? native.core.BufferShapeV0 shape)
    (stages/canonical-record "buffer-layout-v0"
      [(id-value (core/buffershapev0-element-type shape))
       (str (core/buffershapev0-stride-bytes shape))
       (str (core/buffershapev0-align-bytes shape))])

    (instance? native.core.MapShapeV0 shape)
    (stages/canonical-record "map-layout-v0"
      [(id-value (core/mapshapev0-key-type shape))
       (str (core/mapshapev0-key-stride-bytes shape))
       (str (core/mapshapev0-key-align-bytes shape))
       (id-value (core/mapshapev0-value-type shape))
       (str (core/mapshapev0-value-stride-bytes shape))
       (str (core/mapshapev0-value-align-bytes shape))
       "insertion-order-v0"])

    (instance? native.core.SetShapeV0 shape)
    (stages/canonical-record "set-layout-v0"
      [(id-value (core/setshapev0-element-type shape))
       (str (core/setshapev0-stride-bytes shape))
       (str (core/setshapev0-align-bytes shape))
       "insertion-order-v0"])

    (instance? native.core.AtomCellShapeV0 shape)
    (stages/canonical-record "atom-cell-layout"
      [(id-value (core/atomcellshapev0-content-type shape))])

    :else
    (stages/canonical-record "reference-layout"
      [(id-value (core/referenceshapev0-target-type shape))])))

(defn encode-layout-def [(layout core/LayoutDef)] String
  (stages/canonical-record "exact-layout-v0"
    [(id-value (core/layoutdef-id layout))
     (id-value (core/layoutdef-type-id layout))
     (str (core/layoutdef-size-bytes layout))
     (str (core/layoutdef-align-bytes layout))
     (encode-layout-shape (core/layoutdef-shape layout))]))

(defn encode-ssa-value [(value core/SsaValueV0)] String
  (stages/canonical-record "ssa-value"
    [(id-value (core/ssavaluev0-id value))
     (id-value (core/ssavaluev0-type-id value))]))

(defn encode-text-builtin-operation [(operation core/TextBuiltinOpV0)] String
  (cond
    (instance? native.core.TextCompareV0 operation)
    (stages/canonical-record "text-compare"
      [(id-value (core/textcomparev0-left-id operation))
       (id-value (core/textcomparev0-right-id operation))])
    (instance? native.core.TextEndsWithV0 operation)
    (stages/canonical-record "text-ends-with"
      [(id-value (core/textendswithv0-source-id operation))
       (id-value (core/textendswithv0-suffix-id operation))])
    (instance? native.core.TextTrimV0 operation)
    (stages/canonical-record "text-trim"
      [(id-value (core/texttrimv0-arena-id operation))
       (id-value (core/texttrimv0-source-id operation))])
    (instance? native.core.TextLowerV0 operation)
    (stages/canonical-record "text-lower"
      [(id-value (core/textlowerv0-arena-id operation))
       (id-value (core/textlowerv0-source-id operation))])
    (instance? native.core.TextLetterDecimalRunsV0 operation)
    (stages/canonical-record "text-letter-decimal-runs"
      [(id-value (core/textletterdecimalrunsv0-arena-id operation))
       (id-value (core/textletterdecimalrunsv0-source-id operation))
       (id-value (core/textletterdecimalrunsv0-pattern-id operation))])
    (instance? native.core.TextRegexReplaceV0 operation)
    (stages/canonical-record "text-regex-replace"
      [(id-value (core/textregexreplacev0-arena-id operation))
       (id-value (core/textregexreplacev0-source-id operation))
       (id-value (core/textregexreplacev0-pattern-id operation))
       (id-value (core/textregexreplacev0-replacement-id operation))])
    (instance? native.core.TextRegexMatchesV0 operation)
    (stages/canonical-record "text-regex-matches"
      [(id-value (core/textregexmatchesv0-source-id operation))
       (id-value (core/textregexmatchesv0-pattern-id operation))])
    (instance? native.core.TextRegexFindV0 operation)
    (stages/canonical-record "text-regex-find"
      [(id-value (core/textregexfindv0-arena-id operation))
       (id-value (core/textregexfindv0-source-id operation))
       (id-value (core/textregexfindv0-pattern-id operation))])
    (instance? native.core.TextSplitV0 operation)
    (stages/canonical-record "text-split"
      [(id-value (core/textsplitv0-arena-id operation))
       (id-value (core/textsplitv0-source-id operation))
       (id-value (core/textsplitv0-pattern-id operation))])
    (instance? native.core.TextVectorTrimV0 operation)
    (stages/canonical-record "text-vector-trim"
      [(id-value (core/textvectortrimv0-arena-id operation))
       (id-value (core/textvectortrimv0-source-id operation))])
    (instance? native.core.TextVectorRemoveBlankV0 operation)
    (stages/canonical-record "text-vector-remove-blank"
      [(id-value (core/textvectorremoveblankv0-arena-id operation))
       (id-value (core/textvectorremoveblankv0-source-id operation))])
    (instance? native.core.TextJoinV0 operation)
    (stages/canonical-record "text-join"
      [(id-value (core/textjoinv0-arena-id operation))
       (id-value (core/textjoinv0-separator-id operation))
       (id-value (core/textjoinv0-source-id operation))])
    :else
    (stages/canonical-record "text-repeat"
      [(id-value (core/textrepeatv0-arena-id operation))
       (id-value (core/textrepeatv0-source-id operation))
       (id-value (core/textrepeatv0-count-id operation))])))

(defn encode-concrete-equality [(equality core/ConcreteEqualityV0)] String
  (cond
    (instance? native.core.BoolEqualityV0 equality) "bool-equality-v0"
    (instance? native.core.I64EqualityV0 equality) "i64-equality-v0"
    (instance? native.core.F64EqualityV0 equality) "f64-equality-v0"
    (instance? native.core.TextEqualityV0 equality) "text-equality-v0"
    (instance? native.core.KeywordEqualityV0 equality) "keyword-equality-v0"
    (instance? native.core.StructuralEqualityV0 equality)
    (stages/canonical-record "structural-equality-v0"
      [(id-value (core/structuralequalityv0-domain-type equality))])
    :else
    (stages/canonical-record "dynamic-structural-equality-v0"
      [(id-value
         (core/dynamicstructuralequalityv0-domain-type equality))])))

(defn encode-value-semantics-operation
  [(operation core/ValueSemanticsOpV0)] String
  (match operation
    [(ValueEqualV0 domain-type left-id right-id)
     (stages/canonical-record "value-equal-v0"
       [(id-value domain-type) (id-value left-id) (id-value right-id)])]
    [(ValueHashV0 domain-type value-id)
     (stages/canonical-record "value-hash-v0"
       [(id-value domain-type) (id-value value-id)])]
    [(ValueCompareV0 domain-type left-id right-id)
     (stages/canonical-record "value-compare-v0"
       [(id-value domain-type) (id-value left-id) (id-value right-id)])]
    [(DynamicValueEqualV0 domain-type left-id right-id)
     (stages/canonical-record "dynamic-value-equal-v0"
       [(id-value domain-type) (id-value left-id) (id-value right-id)])]
    [(DynamicValueHashV0 domain-type value-id)
     (stages/canonical-record "dynamic-value-hash-v0"
       [(id-value domain-type) (id-value value-id)])]
    [(DynamicValueCompareV0 domain-type left-id right-id)
     (stages/canonical-record "dynamic-value-compare-v0"
       [(id-value domain-type) (id-value left-id) (id-value right-id)])]))

(defn encode-codec-primitive-operation
  [(operation core/CodecPrimitiveOpV0)] String
  (match operation
    [(Utf8EncodeV0 arena-id source-id)
     (stages/canonical-record "utf8-encode-v0"
       [(id-value arena-id) (id-value source-id)])]
    [(Utf8DecodeV0 arena-id source-id)
     (stages/canonical-record "utf8-decode-v0"
       [(id-value arena-id) (id-value source-id)])]
    [(Utf8DecodeSourceV0 arena-id source-id)
     (stages/canonical-record "utf8-decode-source-v0"
       [(id-value arena-id) (id-value source-id)])]
    [(NativeBytesFromIntsBoundedV0 arena-id source-id max-bytes-id)
     (stages/canonical-record "native-bytes-from-ints-bounded-v0"
       [(id-value arena-id) (id-value source-id) (id-value max-bytes-id)])]
    [(Sha256BytesV0 arena-id source-id)
     (stages/canonical-record "sha256-bytes-v0"
       [(id-value arena-id) (id-value source-id)])]
    [(FloatToBitsV0 source-id)
     (stages/canonical-record "float-to-bits-v0" [(id-value source-id)])]
    [(FloatFromBitsV0 source-id)
     (stages/canonical-record "float-from-bits-v0" [(id-value source-id)])]))

(defn encode-bitwise-operation [(operation core/BitwiseOperationV0)] String
  (match operation
    [(BitAndI64V0 left-id right-id)
     (stages/canonical-record "bit-and-i64-v0"
       [(id-value left-id) (id-value right-id)])]
    [(BitOrI64V0 left-id right-id)
     (stages/canonical-record "bit-or-i64-v0"
       [(id-value left-id) (id-value right-id)])]
    [(BitXorI64V0 left-id right-id)
     (stages/canonical-record "bit-xor-i64-v0"
       [(id-value left-id) (id-value right-id)])]
    [(BitShiftLeftI64V0 value-id distance-id)
     (stages/canonical-record "bit-shift-left-i64-v0"
       [(id-value value-id) (id-value distance-id)])]
    [(UnsignedBitShiftRightI64V0 value-id distance-id)
     (stages/canonical-record "unsigned-bit-shift-right-i64-v0"
       [(id-value value-id) (id-value distance-id)])]))

(defn encode-native-atom [(atom core/NativeAtom)] String
  (match atom
    [(BoolAtom value)
     (stages/canonical-record "native-atom-bool-v0"
       [(stages/encode-bool value)])]
    [(I64Atom value)
     (stages/canonical-record "native-atom-i64-v0"
       [(stages/encode-int value)])]
    [(F64Atom value)
     (stages/canonical-record "native-atom-f64-v0"
       [(stages/encode-int (Double/doubleToRawLongBits value))])]
    [(TextAtom value)
     (stages/canonical-record "native-atom-text-v0"
       [(stages/encode-string value)])]
    [(KeywordAtom value)
     (stages/canonical-record "native-atom-keyword-v0"
       [(stages/encode-string value)])]
    [(RefAtom target)
     (stages/canonical-record "native-atom-ref-v0"
       [(stages/encode-id target)])]))

(defn encode-instruction [(instruction core/Instruction)] String
  (cond
    (instance? native.core.AtomInstruction instruction)
    (stages/canonical-record "atom-instruction-v1"
      [(encode-ssa-value (core/atominstruction-result instruction))
       (encode-native-atom (core/atominstruction-atom instruction))])

    (instance? native.core.CopyInstruction instruction)
    (stages/canonical-record "copy-instruction"
      [(encode-ssa-value (core/copyinstruction-result instruction))
       (id-value (core/copyinstruction-source-id instruction))])

    (instance? native.core.AddF64Instruction instruction)
    (stages/canonical-record "add-f64-instruction"
      [(encode-ssa-value (core/addf64instruction-result instruction))
       (id-value (core/addf64instruction-left-id instruction))
       (id-value (core/addf64instruction-right-id instruction))])

    (instance? native.core.SubF64InstructionV0 instruction)
    (stages/canonical-record "sub-f64-instruction-v0"
      [(encode-ssa-value (core/subf64instructionv0-result instruction))
       (id-value (core/subf64instructionv0-left-id instruction))
       (id-value (core/subf64instructionv0-right-id instruction))])

    (instance? native.core.MulF64InstructionV0 instruction)
    (stages/canonical-record "mul-f64-instruction-v0"
      [(encode-ssa-value (core/mulf64instructionv0-result instruction))
       (id-value (core/mulf64instructionv0-left-id instruction))
       (id-value (core/mulf64instructionv0-right-id instruction))])

    (instance? native.core.DivF64InstructionV0 instruction)
    (stages/canonical-record "div-f64-instruction-v0"
      [(encode-ssa-value (core/divf64instructionv0-result instruction))
       (id-value (core/divf64instructionv0-left-id instruction))
       (id-value (core/divf64instructionv0-right-id instruction))])

    (instance? native.core.I64ToF64InstructionV0 instruction)
    (stages/canonical-record "i64-to-f64-instruction-v0"
      [(encode-ssa-value (core/i64tof64instructionv0-result instruction))
       (id-value (core/i64tof64instructionv0-source-id instruction))])

    (instance? native.core.F64ToI64InstructionV0 instruction)
    (stages/canonical-record "f64-to-i64-instruction-v0"
      [(encode-ssa-value (core/f64toi64instructionv0-result instruction))
       (id-value (core/f64toi64instructionv0-source-id instruction))])

    (instance? native.core.CheckedInstruction instruction)
    (let [(operation core/CheckedOperationV0)
          (core/checkedinstruction-operation instruction)
          (result String)
          (encode-ssa-value (core/checkedinstruction-result instruction))]
      (cond
        (instance? native.core.CheckedAddI64V0 operation)
        (stages/canonical-record "checked-add-i64-instruction"
          [result
           (id-value (core/checkedaddi64v0-left-id operation))
           (id-value (core/checkedaddi64v0-right-id operation))])

        (instance? native.core.CheckedSubI64V0 operation)
        (stages/canonical-record "checked-sub-i64-instruction"
          [result
           (id-value (core/checkedsubi64v0-left-id operation))
           (id-value (core/checkedsubi64v0-right-id operation))])

        (instance? native.core.CheckedMulI64V0 operation)
        (stages/canonical-record "checked-mul-i64-instruction"
          [result
           (id-value (core/checkedmuli64v0-left-id operation))
           (id-value (core/checkedmuli64v0-right-id operation))])

        (instance? native.core.CheckedQuotI64V0 operation)
        (stages/canonical-record "checked-quot-i64-instruction"
          [result
           (id-value (core/checkedquoti64v0-left-id operation))
           (id-value (core/checkedquoti64v0-right-id operation))])

        (instance? native.core.CheckedRemI64V0 operation)
        (stages/canonical-record "checked-rem-i64-instruction"
          [result
           (id-value (core/checkedremi64v0-left-id operation))
           (id-value (core/checkedremi64v0-right-id operation))])

        (instance? native.core.CheckedModI64V0 operation)
        (stages/canonical-record "checked-mod-i64-instruction"
          [result
           (id-value (core/checkedmodi64v0-left-id operation))
           (id-value (core/checkedmodi64v0-right-id operation))])

        :else
        (stages/canonical-record "checked-bounds-instruction"
          [result
           (id-value (core/checkedboundsv0-index-id operation))
           (id-value (core/checkedboundsv0-length-id operation))])))

    (instance? native.core.BitwiseInstructionV0 instruction)
    (stages/canonical-record "bitwise-instruction-v0"
      [(encode-ssa-value (core/bitwiseinstructionv0-result instruction))
       (encode-bitwise-operation
         (core/bitwiseinstructionv0-operation instruction))])

    (instance? native.core.CompareInstruction instruction)
    (let [(comparison core/CompareOpV0)
          (core/compareinstruction-comparison instruction)
          (label String)
          (cond
            (instance? native.core.CompareEqI64V0 comparison) "compare-eq-i64-instruction"
            (instance? native.core.CompareLtI64V0 comparison) "compare-lt-i64-instruction"
            (instance? native.core.CompareLeI64V0 comparison) "compare-le-i64-instruction"
            (instance? native.core.CompareEqF64V0 comparison) "compare-eq-f64-instruction"
            (instance? native.core.CompareLtF64V0 comparison) "compare-lt-f64-instruction"
            (instance? native.core.CompareLeF64V0 comparison) "compare-le-f64-instruction"
            (instance? native.core.CompareEqBoolV0 comparison) "compare-eq-bool-instruction"
            :else "compare-eq-text-instruction")]
      (stages/canonical-record label
        [(encode-ssa-value (core/compareinstruction-result instruction))
         (id-value (core/compareinstruction-left-id instruction))
         (id-value (core/compareinstruction-right-id instruction))]))

    (instance? native.core.FieldInstruction instruction)
    (stages/canonical-record "field-instruction"
      [(encode-ssa-value (core/fieldinstruction-result instruction))
       (id-value (core/fieldinstruction-source-id instruction))
       (id-value (core/fieldinstruction-field-id instruction))])

    (instance? native.core.VariantValueInstruction instruction)
    (stages/canonical-record "variant-value-instruction"
      [(encode-ssa-value (core/variantvalueinstruction-result instruction))
       (id-value (core/variantvalueinstruction-source-id instruction))
       (id-value (core/variantvalueinstruction-variant-id instruction))])

    (instance? native.core.RecordInstruction instruction)
    (stages/canonical-record "record-instruction"
      [(encode-ssa-value (core/recordinstruction-result instruction))
       (encode-id-roots "fields" (core/recordinstruction-field-ids instruction))])

    (instance? native.core.RecordAssocInstructionV0 instruction)
    (stages/canonical-record "record-assoc-instruction-v0"
      [(encode-ssa-value (core/recordassocinstructionv0-result instruction))
       (id-value (core/recordassocinstructionv0-source-id instruction))
       (id-value (core/recordassocinstructionv0-field-id instruction))
       (id-value (core/recordassocinstructionv0-value-id instruction))
       (id-value (core/recordassocinstructionv0-arena-id instruction))])

    (instance? native.core.BoxRecordInstruction instruction)
    (stages/canonical-record "box-record-instruction"
      [(encode-ssa-value (core/boxrecordinstruction-result instruction))
       (id-value (core/boxrecordinstruction-source-id instruction))
       (id-value (core/boxrecordinstruction-arena-id instruction))])

    (instance? native.core.RecordMaterializeInstructionV0 instruction)
    (stages/canonical-record "record-materialize-instruction-v0"
      [(encode-ssa-value
         (core/recordmaterializeinstructionv0-result instruction))
       (id-value
         (core/recordmaterializeinstructionv0-source-id instruction))])

    (instance? native.core.UnionConstructInstruction instruction)
    (let [(payload (U core/NativeId Nil))
          (core/unionconstructinstruction-payload-id instruction)]
      (stages/canonical-record "union-construct-instruction"
        [(encode-ssa-value (core/unionconstructinstruction-result instruction))
         (id-value (core/unionconstructinstruction-variant-id instruction))
         (if (nil? payload) "unit" (id-value payload))]))

    (instance? native.core.UnionExtractInstruction instruction)
    (stages/canonical-record "union-extract-instruction"
      [(encode-ssa-value (core/unionextractinstruction-result instruction))
       (id-value (core/unionextractinstruction-source-id instruction))
       (id-value (core/unionextractinstruction-variant-id instruction))])

    (instance? native.core.StoreInstruction instruction)
    (stages/canonical-record "store-instruction"
      [(encode-ssa-value (core/storeinstruction-result instruction))])

    (instance? native.core.AllocateInstruction instruction)
    (stages/canonical-record "allocate-instruction"
      [(encode-ssa-value (core/allocateinstruction-result instruction))
       (id-value (core/allocateinstruction-region instruction))
