#lang beagle/clj
;; Fixture programs for native.qbe. The module-0 program is byte-for-byte the
;; program native.c11-validation-corpus materializes (same id domain, same
;; constructors), so both backends read one frozen program.
(ns native.qbe-validation-corpus
  (:require [native.core :as core]
            [native.qbe :as qbe]))

(define-mode strict)

(defn fixture-id [(name String)] core/NativeId
  (core/canonical-id "native-c11-fixture-v0" [name]))

(def fixture-i64-type core/TypeDef
  (core/->TypeDef (fixture-id "type-00-i64") "I64"
    (core/atom-type-shape (core/i64-kind))))

(def fixture-left-field core/TypeField
  (core/->TypeField (fixture-id "field-00-left") "left" (fixture-id "type-00-i64")))

(def fixture-right-field core/TypeField
  (core/->TypeField (fixture-id "field-01-right") "right" (fixture-id "type-00-i64")))

(def fixture-pair-type core/TypeDef
  (core/->TypeDef (fixture-id "type-01-pair") "Pair"
    (core/->RecordType [fixture-left-field fixture-right-field])))

(def fixture-region core/RegionDef
  (core/->RegionDef (fixture-id "region-arena") (core/arena-region-kind) nil))

(def fixture-capability core/CapabilityDef
  (core/->CapabilityDef (fixture-id "capability-allocate")
    (core/->AllocateCapability true)
    (fixture-id "region-arena")
    true))

(def fixture-effect core/EffectDef
  (core/->EffectDef (fixture-id "effect-allocate")
    (core/->AllocateEffect (fixture-id "region-arena"))))

(def fixture-i64-layout core/LayoutDef
  (core/->LayoutDef (fixture-id "layout-00-i64") (fixture-id "type-00-i64") 8 8
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(def fixture-pair-layout core/LayoutDef
  (core/->LayoutDef (fixture-id "layout-01-pair") (fixture-id "type-01-pair") 16 8
    (core/->RecordShapeV0
      [(core/->FieldLayoutV0 (fixture-id "field-00-left") (fixture-id "type-00-i64") 0 8)
       (core/->FieldLayoutV0 (fixture-id "field-01-right") (fixture-id "type-00-i64") 8 8)])))

(def fixture-block core/BasicBlock
  (core/->BasicBlock (fixture-id "block-entry")
    []
    [(core/->CheckedInstruction
       (core/->SsaValueV0 (fixture-id "ssa-sum") (fixture-id "type-00-i64"))
       (core/->CheckedAddI64V0 (fixture-id "ssa-left") (fixture-id "ssa-right")))]
    [(core/return-terminator (fixture-id "ssa-sum"))]))

(def fixture-function core/FunctionDef
  (core/->FunctionDef (fixture-id "function-add") "add"
    [(core/->Parameter (fixture-id "ssa-left") (fixture-id "type-00-i64"))
     (core/->Parameter (fixture-id "ssa-right") (fixture-id "type-00-i64"))]
    [fixture-block]
    (fixture-id "block-entry")
    (fixture-id "type-00-i64")
    [(fixture-id "effect-allocate")]
    [(fixture-id "region-arena")]
    [(fixture-id "capability-allocate")]))

(def fixture-program core/NativeCoreProgram
  (core/->NativeCoreProgram (fixture-id "program") nil "native-c11-fixture-v0"
    [fixture-pair-type fixture-i64-type]
    [fixture-effect]
    [fixture-region]
    [fixture-capability]
    [fixture-pair-layout fixture-i64-layout]
    [fixture-function]
    [(fixture-id "effect-allocate")]
    [(fixture-id "region-arena")]
    [(fixture-id "capability-allocate")]
    []
    []))

(def fixture-program-permuted core/NativeCoreProgram
  (with fixture-program
    [:types [fixture-i64-type fixture-pair-type]
     :layouts [fixture-i64-layout fixture-pair-layout]]))

;; --- slice-ready program ----------------------------------------------------
;; Widens past the module-0 fixture into the shapes a real slice needs:
;; union aggregates, multi-block control flow, block parameters, arena
;; allocation, stores, and an intra-module call.

(defn slice-id [(name String)] core/NativeId
  (core/canonical-id "native-qbe-fixture-v0" [name]))

(def slice-i64-type core/TypeDef
  (core/->TypeDef (slice-id "type-0-i64") "I64"
    (core/atom-type-shape (core/i64-kind))))

(def slice-tag-type core/TypeDef
  (core/->TypeDef (slice-id "type-1-tag") "UnionTag"
    (core/atom-type-shape (core/i64-kind))))

(def slice-bool-type core/TypeDef
  (core/->TypeDef (slice-id "type-2-bit") "Bool"
    (core/atom-type-shape (core/->BoolKind true))))

(def slice-left-field core/TypeField
  (core/->TypeField (slice-id "fld-0-left") "left" (slice-id "type-0-i64")))

(def slice-right-field core/TypeField
  (core/->TypeField (slice-id "fld-1-rght") "right" (slice-id "type-0-i64")))

(def slice-pair-type core/TypeDef
  (core/->TypeDef (slice-id "type-3-par") "Pair"
    (core/->RecordType [slice-left-field slice-right-field])))

(def slice-none-variant core/TypeVariant
  (core/->TypeVariant (slice-id "var-0-none") "None" nil))

(def slice-pair-variant core/TypeVariant
  (core/->TypeVariant (slice-id "var-1-pair") "Some" (slice-id "type-3-par")))

;; Shape sorts before Pair by identity, but its QBE definition must follow Pair's.
(def slice-shape-type core/TypeDef
  (core/->TypeDef (slice-id "type-2-shp") "Shape"
    (core/->UnionType [slice-none-variant slice-pair-variant])))

(def slice-ref-type core/TypeDef
  (core/->TypeDef (slice-id "type-5-ref") "RefI64"
    (core/->ReferenceType (slice-id "type-0-i64"))))

(def slice-types (Vec core/TypeDef)
  [slice-i64-type slice-tag-type slice-bool-type slice-pair-type
   slice-shape-type slice-ref-type])

(def slice-i64-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-0-i64") (slice-id "type-0-i64") 8 8
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(def slice-tag-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-1-tag") (slice-id "type-1-tag") 4 4
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 32))))

(def slice-bool-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-2-bit") (slice-id "type-2-bit") 4 4
    (core/->ScalarShapeV0 (core/->BoolReprV0 32))))

(def slice-pair-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-3-par") (slice-id "type-3-par") 16 8
    (core/->RecordShapeV0
      [(core/->FieldLayoutV0 (slice-id "fld-0-left") (slice-id "type-0-i64") 0 8)
       (core/->FieldLayoutV0 (slice-id "fld-1-rght") (slice-id "type-0-i64") 8 8)])))

(def slice-shape-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-4-shp") (slice-id "type-2-shp") 24 8
    (core/->UnionShapeV0 (slice-id "type-1-tag") 0
      [(core/->UnionVariantLayoutV0 (slice-id "var-0-none") 0 nil 0)
       (core/->UnionVariantLayoutV0 (slice-id "var-1-pair") 1 (slice-id "type-3-par") 8)])))

(def slice-ref-layout core/LayoutDef
  (core/->LayoutDef (slice-id "lay-5-ref") (slice-id "type-5-ref") 8 8
    (core/->ReferenceShapeV0 (slice-id "type-0-i64"))))

(def slice-layouts (Vec core/LayoutDef)
  [slice-i64-layout slice-tag-layout slice-bool-layout slice-pair-layout
   slice-shape-layout slice-ref-layout])

(def slice-region core/RegionDef
  (core/->RegionDef (slice-id "reg-0-arena") (core/arena-region-kind) nil))

(def slice-alloc-capability core/CapabilityDef
  (core/->CapabilityDef (slice-id "cap-0-alloc") (core/->AllocateCapability true)
    (slice-id "reg-0-arena") true))

(def slice-write-capability core/CapabilityDef
  (core/->CapabilityDef (slice-id "cap-1-write") (core/write-capability-kind)
    (slice-id "reg-0-arena") true))

(def slice-alloc-effect core/EffectDef
  (core/->EffectDef (slice-id "eff-0-alloc")
    (core/->AllocateEffect (slice-id "reg-0-arena"))))

(def slice-write-effect core/EffectDef
  (core/->EffectDef (slice-id "eff-1-write")
    (core/write-effect-kind (slice-id "reg-0-arena"))))

(def slice-add-block core/BasicBlock
  (core/->BasicBlock (slice-id "add-b0-ent")
    []
    [(core/->CheckedInstruction
       (core/->SsaValueV0 (slice-id "add-s0-sum") (slice-id "type-0-i64"))
       (core/->CheckedAddI64V0 (slice-id "add-p0-lhs") (slice-id "add-p1-rhs")))]
    [(core/return-terminator (slice-id "add-s0-sum"))]))

(def slice-add-function core/FunctionDef
  (core/->FunctionDef (slice-id "fn-0-add") "add"
    [(core/->Parameter (slice-id "add-p0-lhs") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "add-p1-rhs") (slice-id "type-0-i64"))]
    [slice-add-block]
    (slice-id "add-b0-ent")
    (slice-id "type-0-i64")
    [(slice-id "eff-0-alloc")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc")]))

(def slice-entry-block core/BasicBlock
  (core/->BasicBlock (slice-id "sli-b0-ent")
    []
    [(core/->AtomInstruction
       (core/->SsaValueV0 (slice-id "sli-s0-siz") (slice-id "type-0-i64"))
       (core/->I64Atom 8))
     (core/->AllocateInstruction
       (core/->SsaValueV0 (slice-id "sli-s1-slt") (slice-id "type-5-ref"))
       (slice-id "reg-0-arena")
       (slice-id "cap-0-alloc")
       (slice-id "sli-s0-siz")
       (core/->TokenFlowV0 [] []))
     (core/store-instruction (slice-id "sli-s2-stw") (slice-id "type-0-i64")
       (core/store-i64-op (slice-id "sli-s1-slt") (slice-id "sli-p1-lhs")
         (slice-id "reg-0-arena") (slice-id "cap-1-write")))]
    [(core/->BranchTerminator (slice-id "sli-p0-flg")
       (slice-id "sli-b1-thn") (slice-id "sli-b2-els"))]))

(def slice-then-block core/BasicBlock
  (core/->BasicBlock (slice-id "sli-b1-thn")
    []
    [(core/->CheckedInstruction
       (core/->SsaValueV0 (slice-id "sli-s3-sum") (slice-id "type-0-i64"))
       (core/->CheckedAddI64V0 (slice-id "sli-p1-lhs") (slice-id "sli-p2-rhs")))]
    [(core/->JumpTerminator (slice-id "sli-b3-joi") [(slice-id "sli-s3-sum")])]))

(def slice-else-block core/BasicBlock
  (core/->BasicBlock (slice-id "sli-b2-els")
    []
    [(core/->CallInstruction
       (core/->SsaValueV0 (slice-id "sli-s4-cal") (slice-id "type-0-i64"))
       (slice-id "fn-0-add")
       [(slice-id "sli-p1-lhs") (slice-id "sli-p2-rhs")]
       nil
       (core/->TokenFlowV0 [] []))]
    [(core/->JumpTerminator (slice-id "sli-b3-joi") [(slice-id "sli-s4-cal")])]))

(def slice-join-block core/BasicBlock
  (core/->BasicBlock (slice-id "sli-b3-joi")
    [(core/->Parameter (slice-id "sli-b3-p0r") (slice-id "type-0-i64"))]
    []
    [(core/return-terminator (slice-id "sli-b3-p0r"))]))

(def slice-blocks (Vec core/BasicBlock)
  [slice-entry-block slice-then-block slice-else-block slice-join-block])

(def slice-function core/FunctionDef
  (core/->FunctionDef (slice-id "fn-1-sli") "slice"
    [(core/->Parameter (slice-id "sli-p0-flg") (slice-id "type-2-bit"))
     (core/->Parameter (slice-id "sli-p1-lhs") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "sli-p2-rhs") (slice-id "type-0-i64"))]
    slice-blocks
    (slice-id "sli-b0-ent")
    (slice-id "type-0-i64")
    [(slice-id "eff-0-alloc") (slice-id "eff-1-write")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc") (slice-id "cap-1-write")]))

(def slice-switch-entry-block core/BasicBlock
  (core/->BasicBlock (slice-id "swt-b0-ent")
    []
    []
    [(core/->SwitchTerminator (slice-id "swt-p0-shp")
       [(core/->SwitchCaseV0 (slice-id "var-0-none") (slice-id "swt-b1-non") [])
        (core/->SwitchCaseV0 (slice-id "var-1-pair") (slice-id "swt-b2-som") [])])]))

(def slice-switch-none-block core/BasicBlock
  (core/->BasicBlock (slice-id "swt-b1-non")
    []
    [(core/->AtomInstruction
       (core/->SsaValueV0 (slice-id "swt-s0-zro") (slice-id "type-0-i64"))
       (core/->I64Atom 0))]
    [(core/return-terminator (slice-id "swt-s0-zro"))]))

(def slice-switch-some-block core/BasicBlock
  (core/->BasicBlock (slice-id "swt-b2-som")
    []
    [(core/->AtomInstruction
       (core/->SsaValueV0 (slice-id "swt-s1-one") (slice-id "type-0-i64"))
       (core/->I64Atom 1))]
    [(core/return-terminator (slice-id "swt-s1-one"))]))

(def slice-switch-blocks (Vec core/BasicBlock)
  [slice-switch-entry-block slice-switch-none-block slice-switch-some-block])

(def slice-switch-function core/FunctionDef
  (core/->FunctionDef (slice-id "fn-2-swt") "tag"
    [(core/->Parameter (slice-id "swt-p0-shp") (slice-id "type-2-shp"))]
    slice-switch-blocks
    (slice-id "swt-b0-ent")
    (slice-id "type-0-i64")
    []
    []
    []))

(def slice-bitwise-block core/BasicBlock
  (core/->BasicBlock (slice-id "bit-b0-ent")
    []
    [(core/->BitwiseInstructionV0
       (core/->SsaValueV0 (slice-id "bit-s0-and") (slice-id "type-0-i64"))
       (core/->BitAndI64V0 (slice-id "bit-p0-lhs") (slice-id "bit-p1-rhs")))
     (core/->BitwiseInstructionV0
       (core/->SsaValueV0 (slice-id "bit-s1-shl") (slice-id "type-0-i64"))
       (core/->BitShiftLeftI64V0
         (slice-id "bit-p0-lhs") (slice-id "bit-p2-dis")))
     (core/->BitwiseInstructionV0
       (core/->SsaValueV0 (slice-id "bit-s2-xor") (slice-id "type-0-i64"))
       (core/->BitXorI64V0 (slice-id "bit-s0-and") (slice-id "bit-s1-shl")))]
    [(core/return-terminator (slice-id "bit-s2-xor"))]))

(def slice-bitwise-function core/FunctionDef
  (core/->FunctionDef (slice-id "fn-3-bit") "bitwise"
    [(core/->Parameter (slice-id "bit-p0-lhs") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "bit-p1-rhs") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "bit-p2-dis") (slice-id "type-0-i64"))]
    [slice-bitwise-block]
    (slice-id "bit-b0-ent")
    (slice-id "type-0-i64")
    []
    []
    []))

(def slice-program core/NativeCoreProgram
  (core/->NativeCoreProgram (slice-id "qbe-slice-program") nil "native-qbe-fixture-v0"
    slice-types
    [slice-alloc-effect slice-write-effect]
    [slice-region]
    [slice-alloc-capability slice-write-capability]
    slice-layouts
    [slice-add-function slice-function slice-switch-function
     slice-bitwise-function]
    [(slice-id "eff-0-alloc") (slice-id "eff-1-write")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc") (slice-id "cap-1-write")]
    []
    []))

(def slice-function-permuted core/FunctionDef
  (with slice-function
    [:blocks [slice-join-block slice-else-block slice-then-block slice-entry-block]]))

(def slice-switch-function-permuted core/FunctionDef
  (with slice-switch-function
    [:blocks [slice-switch-some-block slice-switch-none-block slice-switch-entry-block]]))

(def slice-program-permuted core/NativeCoreProgram
  (with slice-program
    [:types [slice-ref-type slice-shape-type slice-pair-type slice-bool-type
             slice-tag-type slice-i64-type]
     :layouts [slice-ref-layout slice-shape-layout slice-pair-layout
               slice-bool-layout slice-tag-layout slice-i64-layout]
     :functions [slice-bitwise-function slice-switch-function-permuted
                 slice-function-permuted slice-add-function]]))

;; --- vector concat program --------------------------------------------------

(def concat-vector-type core/TypeDef
  (core/->TypeDef (slice-id "vec-typ-i64") "I64Vector"
    (core/->VectorType (slice-id "type-0-i64"))))

(def concat-arena-type core/TypeDef
  (core/->TypeDef (slice-id "vec-typ-arn") "ArenaHandle"
    (core/->ReferenceType (slice-id "vec-typ-arn"))))

(def concat-vector-layout core/LayoutDef
  (core/->LayoutDef (slice-id "vec-lay-i64") (slice-id "vec-typ-i64") 8 8
    (core/->VectorShapeV0 (slice-id "type-0-i64") 8)))

(def concat-arena-layout core/LayoutDef
  (core/->LayoutDef (slice-id "vec-lay-arn") (slice-id "vec-typ-arn") 8 8
    (core/->ReferenceShapeV0 (slice-id "vec-typ-arn"))))

(def concat-block core/BasicBlock
  (core/->BasicBlock (slice-id "vec-b0-ent")
    []
    [(core/->ArenaInstruction
       (core/->SsaValueV0 (slice-id "vec-s0-arn") (slice-id "vec-typ-arn"))
       (slice-id "reg-0-arena")
       (slice-id "cap-0-alloc")
       (core/->TokenFlowV0
         [(slice-id "reg-0-arena") (slice-id "cap-0-alloc")]
         []))
     (core/->VecConcatInstruction
       (core/->SsaValueV0 (slice-id "vec-s1-out") (slice-id "vec-typ-i64"))
       (slice-id "vec-p0-lft")
       (slice-id "vec-p1-rgt")
       (slice-id "vec-s0-arn"))]
    [(core/return-terminator (slice-id "vec-s1-out"))]))

(def concat-function core/FunctionDef
  (core/->FunctionDef (slice-id "vec-fn-cat") "concat"
    [(core/->Parameter (slice-id "vec-p0-lft") (slice-id "vec-typ-i64"))
     (core/->Parameter (slice-id "vec-p1-rgt") (slice-id "vec-typ-i64"))]
    [concat-block]
    (slice-id "vec-b0-ent")
    (slice-id "vec-typ-i64")
    [(slice-id "eff-0-alloc")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc")]))

(def reverse-block core/BasicBlock
  (core/->BasicBlock (slice-id "vec-b1-rev")
    []
    [(core/->ArenaInstruction
       (core/->SsaValueV0 (slice-id "vec-r0-arn") (slice-id "vec-typ-arn"))
       (slice-id "reg-0-arena")
       (slice-id "cap-0-alloc")
       (core/->TokenFlowV0
         [(slice-id "reg-0-arena") (slice-id "cap-0-alloc")]
         []))
     (core/->VecReverseInstructionV0
       (core/->SsaValueV0 (slice-id "vec-r1-out") (slice-id "vec-typ-i64"))
       (slice-id "vec-rp-src")
       (slice-id "vec-r0-arn"))]
    [(core/return-terminator (slice-id "vec-r1-out"))]))

(def reverse-function core/FunctionDef
  (core/->FunctionDef (slice-id "vec-fn-rev") "reverse"
    [(core/->Parameter (slice-id "vec-rp-src") (slice-id "vec-typ-i64"))]
    [reverse-block]
    (slice-id "vec-b1-rev")
    (slice-id "vec-typ-i64")
    [(slice-id "eff-0-alloc")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc")]))

(def slice-vector-block core/BasicBlock
  (core/->BasicBlock (slice-id "vec-b2-slc")
    []
    [(core/->ArenaInstruction
       (core/->SsaValueV0 (slice-id "vec-c0-arn") (slice-id "vec-typ-arn"))
       (slice-id "reg-0-arena")
       (slice-id "cap-0-alloc")
       (core/->TokenFlowV0
         [(slice-id "reg-0-arena") (slice-id "cap-0-alloc")]
         []))
     (core/->VecSliceInstructionV0
       (core/->SsaValueV0 (slice-id "vec-c1-out") (slice-id "vec-typ-i64"))
       (slice-id "vec-cp-src")
       (slice-id "vec-cp-beg")
       (slice-id "vec-cp-end")
       (slice-id "vec-c0-arn"))]
    [(core/return-terminator (slice-id "vec-c1-out"))]))

(def slice-vector-function core/FunctionDef
  (core/->FunctionDef (slice-id "vec-fn-slc") "slice"
    [(core/->Parameter (slice-id "vec-cp-src") (slice-id "vec-typ-i64"))
     (core/->Parameter (slice-id "vec-cp-beg") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "vec-cp-end") (slice-id "type-0-i64"))]
    [slice-vector-block]
    (slice-id "vec-b2-slc")
    (slice-id "vec-typ-i64")
    [(slice-id "eff-0-alloc")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc")]))

(def concat-program core/NativeCoreProgram
  (core/->NativeCoreProgram (slice-id "qbe-concat-program") nil "native-qbe-fixture-v0"
    [slice-i64-type concat-vector-type concat-arena-type]
    [slice-alloc-effect]
    [slice-region]
    [slice-alloc-capability]
    [slice-i64-layout concat-vector-layout concat-arena-layout]
    [concat-function reverse-function slice-vector-function]
    [(slice-id "eff-0-alloc")]
    [(slice-id "reg-0-arena")]
    [(slice-id "cap-0-alloc")]
    []
    []))

(def concat-program-permuted core/NativeCoreProgram
  (with concat-program
    [:types [concat-arena-type concat-vector-type slice-i64-type]
     :layouts [concat-arena-layout concat-vector-layout slice-i64-layout]
     :functions [slice-vector-function concat-function reverse-function]]))

;; --- explicit instruction refusals ---------------------------------------
;; Core v0 validates SSA/reference closure independently of operand semantics.
;; Scalar function carriers isolate these gates from QBE's separate rejection
;; of unsupported parameter and return shapes, so each program has one cause.

(def refusal-index-block core/BasicBlock
  (core/->BasicBlock (slice-id "ref-idx-blk")
    []
    [(core/->TextIndexOfInstruction
       (core/->SsaValueV0 (slice-id "ref-idx-out") (slice-id "type-0-i64"))
       (slice-id "ref-idx-src")
       (slice-id "ref-idx-ndl"))]
    [(core/return-terminator (slice-id "ref-idx-out"))]))

(def refusal-index-function core/FunctionDef
  (core/->FunctionDef (slice-id "ref-idx-fn") "refuse-index"
    [(core/->Parameter (slice-id "ref-idx-src") (slice-id "type-0-i64"))
     (core/->Parameter (slice-id "ref-idx-ndl") (slice-id "type-0-i64"))]
    [refusal-index-block]
    (slice-id "ref-idx-blk")
    (slice-id "type-0-i64")
    []
    []
    []))

(def refusal-index-program core/NativeCoreProgram
  (core/->NativeCoreProgram (slice-id "ref-idx-wld") nil "native-qbe-fixture-v0"
