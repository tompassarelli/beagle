(defn atom-abi-value
  [(name String) (type-id core/NativeId)] core/AbiValueV0
  (core/->AbiValueV0 name type-id (core/->BorrowedV0 true) nil))

(defn atom-export-abi
  [(name String)
   (function-id core/NativeId)
   (symbol String)
   (parameters (Vec core/AbiValueV0))
   (result-type core/NativeId)
   (effects (Vec core/NativeId))
   (capabilities (Vec core/NativeId))] core/AbiDeclV0
  (core/->AbiDeclV0
    (atom-fixture-id (str "abi-" name))
    function-id
    symbol
    (core/->AbiExportV0 true)
    (core/->RestrictedCAbiV0 true)
    parameters
    (core/->AbiValueV0 "result" result-type (core/->OwnedV0 true) nil)
    (atom-fixture-id "type-failure")
    effects
    capabilities
    "v0"
    "sha256:atom-fixture-layout-v0"))

(def atom-export-abis (Vec core/AbiDeclV0)
  [(atom-export-abi "new" (atom-fixture-id "fn-1-new")
     "native_atom_new_v0"
     [(atom-abi-value "initial" (atom-fixture-id "type-i64"))]
     (atom-fixture-id "type-cell")
     [(atom-fixture-id "effect-allocate") (atom-fixture-id "effect-state")]
     [(atom-fixture-id "cap-allocate") (atom-fixture-id "cap-state")])
   (atom-export-abi "deref" (atom-fixture-id "fn-2-get")
     "native_atom_deref_v0"
     [(atom-abi-value "cell" (atom-fixture-id "type-cell"))]
     (atom-fixture-id "type-i64")
     [(atom-fixture-id "effect-state")]
     [(atom-fixture-id "cap-state")])
   (atom-export-abi "swap" (atom-fixture-id "fn-3-swp")
     "native_atom_swap_v0"
     [(atom-abi-value "cell" (atom-fixture-id "type-cell"))
      (atom-abi-value "next" (atom-fixture-id "type-i64"))]
     (atom-fixture-id "type-i64")
     [(atom-fixture-id "effect-state")]
     [(atom-fixture-id "cap-state")])
   (atom-export-abi "reset" (atom-fixture-id "fn-4-rst")
     "native_atom_reset_v0"
     [(atom-abi-value "cell" (atom-fixture-id "type-cell"))
      (atom-abi-value "next" (atom-fixture-id "type-i64"))]
     (atom-fixture-id "type-i64")
     [(atom-fixture-id "effect-state")]
     [(atom-fixture-id "cap-state")])
   (atom-export-abi "compare-exchange" (atom-fixture-id "fn-5-cas")
     "native_atom_compare_exchange_v0"
     [(atom-abi-value "cell" (atom-fixture-id "type-cell"))
      (atom-abi-value "expected" (atom-fixture-id "type-i64"))
      (atom-abi-value "replacement" (atom-fixture-id "type-i64"))]
     (atom-fixture-id "type-bool")
     [(atom-fixture-id "effect-state")]
     [(atom-fixture-id "cap-state")])])

(def atom-program core/NativeCoreProgram
  (core/->NativeCoreProgram (atom-fixture-id "program") nil "native-atom-fixture-v0"
    [atom-i64-type atom-bool-type atom-tag-type atom-failure-type atom-cell-type
     atom-state-type atom-arena-type]
    [atom-pure-effect atom-allocate-effect atom-state-effect]
    [atom-arena-region atom-state-region]
    [atom-allocate-capability atom-state-capability]
    [atom-i64-layout atom-bool-layout atom-tag-layout atom-failure-layout
     atom-cell-layout atom-state-layout atom-arena-layout]
    [atom-updater-function atom-create-function atom-deref-function
     atom-swap-function atom-reset-function atom-cas-function]
    [(atom-fixture-id "effect-pure") (atom-fixture-id "effect-allocate")
     (atom-fixture-id "effect-state")]
    [(atom-fixture-id "region-arena") (atom-fixture-id "region-state")]
    [(atom-fixture-id "cap-allocate") (atom-fixture-id "cap-state")]
    atom-export-abis
    []))

;; Scalar checked arithmetic is shared frozen-IR vocabulary. This program keeps
;; the result scalar so each materializer must implement the operation itself;
;; lowered source programs retain their Outcome-valued control-flow contract.
(defn numeric-id [(name String)] core/NativeId
  (core/canonical-id "native-qbe-numeric-v0" [name]))

(def numeric-i64-type core/TypeDef
  (core/->TypeDef (numeric-id "type-i64") "I64"
    (core/atom-type-shape (core/i64-kind))))

(def numeric-i64-layout core/LayoutDef
  (core/->LayoutDef (numeric-id "layout-i64") (numeric-id "type-i64") 8 8
    (core/->ScalarShapeV0 (core/->SignedIntReprV0 64))))

(defn numeric-operation
  [(name String)
   (left core/NativeId)
   (right core/NativeId)] core/CheckedOperationV0
  (cond
    (= name "sub") (core/->CheckedSubI64V0 left right)
    (= name "mul") (core/->CheckedMulI64V0 left right)
    (= name "quot") (core/->CheckedQuotI64V0 left right)
    (= name "rem") (core/->CheckedRemI64V0 left right)
    :else (core/->CheckedModI64V0 left right)))

(defn numeric-function
  [(position String)
   (name String)] core/FunctionDef
  (let [(left core/NativeId) (numeric-id (str position "-left"))
        (right core/NativeId) (numeric-id (str position "-right"))
        (result core/NativeId) (numeric-id (str position "-result"))
        (block core/NativeId) (numeric-id (str position "-block"))]
    (core/->FunctionDef (numeric-id (str "fn-" position)) name
      [(core/->Parameter left (numeric-id "type-i64"))
       (core/->Parameter right (numeric-id "type-i64"))]
      [(core/->BasicBlock block []
         [(core/->CheckedInstruction
            (core/->SsaValueV0 result (numeric-id "type-i64"))
            (numeric-operation name left right))]
         [(core/return-terminator result)])]
      block (numeric-id "type-i64") [] [] [])))

(def numeric-sub-function core/FunctionDef (numeric-function "0" "sub"))
(def numeric-mul-function core/FunctionDef (numeric-function "1" "mul"))
(def numeric-quot-function core/FunctionDef (numeric-function "2" "quot"))
(def numeric-rem-function core/FunctionDef (numeric-function "3" "rem"))
(def numeric-mod-function core/FunctionDef (numeric-function "4" "mod"))

(def numeric-program core/NativeCoreProgram
  (core/->NativeCoreProgram (numeric-id "program") nil "native-qbe-numeric-v0"
    [numeric-i64-type] [] [] [] [numeric-i64-layout]
    [numeric-sub-function numeric-mul-function numeric-quot-function
     numeric-rem-function numeric-mod-function]
    [] [] [] [] []))

(def numeric-program-permuted core/NativeCoreProgram
  (with numeric-program
    [:functions
     [numeric-mod-function numeric-rem-function numeric-quot-function
      numeric-mul-function numeric-sub-function]]))

;; --- materialization ------------------------------------------------------

(defn require-artifact [(result qbe/QbeMaterialization)] qbe/QbeArtifact
  (match result
    [(QbeSuccess value) (qbe/qbesuccess-artifact result)]
    [(QbeFailure value) (throw (ex-info (qbe/qbefailure-detail result) {}))]))

(defn explicitly-refused? [(program core/NativeCoreProgram)] Bool
  (and (core/validationreport-passed (core/validate-program program))
    (match (qbe/materialize-program program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "native program uses a shape outside the QBE materializer's slice"
         value)])))

(def refusal-index-proven? Bool
  (explicitly-refused? refusal-index-program))

(def refusal-blank-proven? Bool
  (explicitly-refused? refusal-blank-program))

(def refusal-parse-proven? Bool
  (explicitly-refused? refusal-parse-program))

(def refusal-text-builtin-proven? Bool
  (explicitly-refused? refusal-text-builtin-program))

(def refusal-map-proven? Bool
  (explicitly-refused? refusal-map-program))

(def refusal-set-proven? Bool
  (explicitly-refused? refusal-set-program))

(def refusal-value-equal-proven? Bool
  (and (core/validationreport-passed
         (core/validate-program refusal-value-equal-program))
    (match (qbe/materialize-program refusal-value-equal-program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "unsupported native value-semantics op: equal" value)])))

(def refusal-value-hash-proven? Bool
  (and (core/validationreport-passed
         (core/validate-program refusal-value-hash-program))
    (match (qbe/materialize-program refusal-value-hash-program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "unsupported native value-semantics op: hash" value)])))

(def refusal-value-compare-proven? Bool
  (and (core/validationreport-passed
         (core/validate-program refusal-value-compare-program))
    (match (qbe/materialize-program refusal-value-compare-program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "unsupported native value-semantics op: compare" value)])))

(def refusal-dynamic-value-hash-proven? Bool
  (and (core/validationreport-passed
         (core/validate-program refusal-dynamic-value-hash-program))
    (match (qbe/materialize-program refusal-dynamic-value-hash-program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "unsupported native value-semantics op: hash" value)])))

(def refusal-value-to-text-proven? Bool
  (and (core/validationreport-passed
         (core/validate-program refusal-value-to-text-program))
    (match (qbe/materialize-program refusal-value-to-text-program 3 "lp64")
      [(QbeSuccess value) false]
      [(QbeFailure value)
       (= "unsupported native value-semantics op: to-text" value)])))

(def atom-refusal-proven? Bool
  (explicitly-refused? atom-program))

(def fixture-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program fixture-program 0 "lp64")))

(def fixture-permuted-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program fixture-program-permuted 0 "lp64")))

(def slice-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program slice-program 1 "lp64")))

(def slice-permuted-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program slice-program-permuted 1 "lp64")))

(def concat-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program concat-program 2 "lp64")))

(def concat-permuted-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program concat-program-permuted 2 "lp64")))

(def numeric-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program numeric-program 3 "lp64")))

(def numeric-permuted-artifact qbe/QbeArtifact
  (require-artifact (qbe/materialize-program numeric-program-permuted 3 "lp64")))

(def fixture-deterministic? Bool
  (and refusal-index-proven?
    refusal-blank-proven?
    refusal-parse-proven?
    refusal-text-builtin-proven?
    refusal-map-proven?
    refusal-set-proven?
    refusal-value-equal-proven?
    refusal-value-hash-proven?
    refusal-value-compare-proven?
    refusal-dynamic-value-hash-proven?
    refusal-value-to-text-proven?
    atom-refusal-proven?
    (= (qbe/qbeartifact-module-text fixture-artifact)
         (qbe/qbeartifact-module-text fixture-permuted-artifact))
    (= (qbe/qbeartifact-module-text slice-artifact)
      (qbe/qbeartifact-module-text slice-permuted-artifact))
    (= (qbe/qbeartifact-module-text concat-artifact)
      (qbe/qbeartifact-module-text concat-permuted-artifact))
    (= (qbe/qbeartifact-module-text numeric-artifact)
      (qbe/qbeartifact-module-text numeric-permuted-artifact))))

;; Declares the QBE exports directly rather than including the C backend's
;; header: the objects are linked by the shim ABI alone.
(def fixture-main-text String
  (str "/* Generated by native.qbe-validation-corpus; do not edit. */\n"
    "#include \"native_shim.h\"\n\n"
    "#include <stdio.h>\n\n"
    "int64_t native_m0_fn_0(native_arena *arena, const native_capability *capability,\n"
    "                       int64_t left, int64_t right);\n"
    "int64_t native_m1_fn_3(int64_t left, int64_t right, int64_t distance);\n"
    "native_vec *native_m2_fn_0(native_arena *arena, const native_capability *capability,\n"
    "                           const native_vec *left, const native_vec *right);\n"
    "native_vec *native_m2_fn_1(native_arena *arena, const native_capability *capability,\n"
    "                           const native_vec *source);\n"
    "native_vec *native_m2_fn_2(native_arena *arena, const native_capability *capability,\n"
    "                           const native_vec *source, int64_t start, int64_t end);\n\n"
    "int64_t native_m3_fn_0(int64_t left, int64_t right);\n"
    "int64_t native_m3_fn_1(int64_t left, int64_t right);\n"
    "int64_t native_m3_fn_2(int64_t left, int64_t right);\n"
    "int64_t native_m3_fn_3(int64_t left, int64_t right);\n"
    "int64_t native_m3_fn_4(int64_t left, int64_t right);\n\n"
    "static void report_scalar_trap(uint32_t code) {\n"
    "  fprintf(stdout, \"qbe-scalar-trap %u\\n\", code);\n"
    "  fflush(stdout);\n"
    "}\n\n"
    "int main(int argc, char **argv) {\n"
    "  if (argc == 2) {\n"
    "    native_set_trap_reporter(report_scalar_trap);\n"
    "    if (strcmp(argv[1], \"sub-overflow\") == 0) {\n"
    "      (void)native_m3_fn_0(INT64_MIN, INT64_C(1));\n"
    "    } else if (strcmp(argv[1], \"sub-overflow-positive\") == 0) {\n"
    "      (void)native_m3_fn_0(INT64_MAX, -INT64_C(1));\n"
    "    } else if (strcmp(argv[1], \"mul-overflow\") == 0) {\n"
    "      (void)native_m3_fn_1(INT64_MAX, INT64_C(2));\n"
    "    } else if (strcmp(argv[1], \"mul-overflow-negative\") == 0) {\n"
    "      (void)native_m3_fn_1(INT64_MIN, -INT64_C(1));\n"
    "    } else if (strcmp(argv[1], \"mul-overflow-positive-negative\") == 0) {\n"
    "      (void)native_m3_fn_1(INT64_C(3037000500), -INT64_C(3037000500));\n"
    "    } else if (strcmp(argv[1], \"mul-overflow-negative-negative\") == 0) {\n"
    "      (void)native_m3_fn_1(-INT64_C(3037000500), -INT64_C(3037000500));\n"
    "    } else if (strcmp(argv[1], \"quot-zero\") == 0) {\n"
    "      (void)native_m3_fn_2(INT64_C(1), INT64_C(0));\n"
    "    } else if (strcmp(argv[1], \"rem-zero\") == 0) {\n"
    "      (void)native_m3_fn_3(INT64_C(1), INT64_C(0));\n"
    "    } else {\n"
    "      (void)native_m3_fn_4(INT64_C(1), INT64_C(0));\n"
    "    }\n"
    "    fprintf(stderr, \"qbe-scalar-trap MISSED %s\\n\", argv[1]);\n"
    "    return 99;\n"
    "  }\n"
    "  uint8_t storage[256];\n"
    "  native_arena arena;\n"
    "  native_capability capability = { UINT64_C(1) };\n"
    "  native_arena_init(&arena, storage, sizeof(storage));\n"
    "  if (native_m0_fn_0(&arena, &capability, INT64_C(20), INT64_C(22)) != INT64_C(42)) {\n"
    "    return 1;\n"
    "  }\n"
    "  int64_t *slot = native_arena_alloc(&arena, sizeof(*slot), _Alignof(int64_t));\n"
    "  *slot = native_m0_fn_0(&arena, &capability, INT64_C(-1), INT64_C(1));\n"
    "  if (*slot != INT64_C(0)) {\n"
    "    return 2;\n"
    "  }\n"
    "  if (native_m1_fn_3(INT64_C(240), INT64_C(90), INT64_C(1)) != INT64_C(432)) {\n"
    "    return 6;\n"
    "  }\n"
    "  native_arena_reset(&arena);\n"
    "  int64_t left_items[] = { INT64_C(3), INT64_C(5) };\n"
    "  int64_t right_items[] = { INT64_C(8), INT64_C(13), INT64_C(21) };\n"
    "  const int64_t expected[] = { INT64_C(3), INT64_C(5), INT64_C(8),\n"
    "                               INT64_C(13), INT64_C(21) };\n"
    "  native_vec left = { left_items, INT64_C(2), INT64_C(2), NULL };\n"
    "  native_vec right = { right_items, INT64_C(3), INT64_C(3), NULL };\n"
    "  native_vec *joined = native_m2_fn_0(&arena, &capability, &left, &right);\n"
    "  if ((joined == &left) || (joined == &right) ||\n"
    "      (joined->length != INT64_C(5)) || (joined->capacity != INT64_C(5))) {\n"
    "    return 3;\n"
    "  }\n"
    "  if (memcmp(joined->elements, expected, sizeof(expected)) != 0) {\n"
    "    return 4;\n"
    "  }\n"
    "  if ((left.length != INT64_C(2)) || (right.length != INT64_C(3))) {\n"
