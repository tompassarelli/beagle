;; --- Atom state program ----------------------------------------------------
;; This fixture is materialized by validation/atom through C17. QBE must reject
;; the same frozen program until it has a lock-aware state calling convention.

(defn atom-fixture-id [(name String)] core/NativeId
  (core/canonical-id "native-atom-fixture-v0" [name]))

(def atom-i64-type core/TypeDef
