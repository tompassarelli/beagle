#lang beagle/clj
;; Singleton unit compilation for the Phase-E branch-reuse experiment.  The
;; ordinary whole-program passes remain authoritative for assembly; this module
;; compiles exactly ONE unit per request against the signature-only typing
;; prelude and the exact dependency contracts of that unit.  It never calls a
;; whole-stage lowerer, and every whole-program fold — closures, effects,
;; capabilities, regions, term graph, encoding, digest — stays in assembly.
(ns native.unit-compile
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.unit-reuse :as unit]))


(defrecord PreparedCandidateV0
  [(frozen-source stages/FrozenSourceStageV1)
   (prelude lower/TypingPreludeV0)
   (contracts (Vec unit/UnitContractV0))
   (semantic-contracts (Vec unit/SemanticFormContractV1))
   (compiler-rule-epoch String)
   (configuration (Vec String))])

(defunion UnitPreparationResultV0
  (UnitPreparationAcceptedV0 [(prepared PreparedCandidateV0)])
  (UnitPreparationRejectedV0 [(code String) (detail String)]))

(defunion TypedUnitCompileResultV0
  (TypedUnitCompiledV0
    [(unit unit/TypedUnitV0) (result-key String) (trace (Vec core/NativeId))])
  (TypedUnitCompileRejectedV0
    [(code String) (detail String) (unit-id core/NativeId)]))

(defunion NativeUnitCompileResultV0
  (NativeUnitCompiledV0
    [(unit unit/NativeUnitV0) (result-key String) (trace (Vec core/NativeId))])
  (NativeUnitCompileRejectedV0
    [(code String) (detail String) (unit-id core/NativeId)]))

;; Body attachment pairs signature resolutions with source roots BY INDEX, and
;; the prelude hands both vectors over in that order.  The unit being compiled
;; is therefore found by identity and its source root read at that same index:
;; selection is by identity, only the pairing is positional.  The two vectors
;; are never assumed to share the source-unit ordering.
(defn signature-index-for
  [(resolutions (Vec lower/FunctionResolutionV0)) (target core/NativeId)] Int
  (loop [position Int 0]
    (cond
      (>= position (count resolutions)) -1

      (core/native-id= target
        (lower/typedfunctionv0-id
          (lower/functionresolutionv0-function (nth resolutions position))))
      position

      :else (recur (+ position 1)))))

(defn contract-for
  [(contracts (Vec unit/UnitContractV0))
   (target core/NativeId)]
  (U unit/UnitContractV0 Nil)
  (some
    (fn [(candidate unit/UnitContractV0)] (U unit/UnitContractV0 Nil)
      (if (core/native-id= target (unit/unitcontractv0-unit-id candidate))
        candidate nil))
    contracts))

(defn typed-unit-for
  [(units (Vec unit/TypedUnitV0))
   (target core/NativeId)]
  (U unit/TypedUnitV0 Nil)
  (some
    (fn [(candidate unit/TypedUnitV0)] (U unit/TypedUnitV0 Nil)
      (if (core/native-id= target (unit/typedunitv0-unit-id candidate))
        candidate nil))
    units))

;; Whole-program closure settling can only ADD unreadiness or effects to a
;; function: readiness propagates from callee to caller and the effect mask is
;; a union over the call graph.  A target that is already ready, exactly pure,
;; and region- and capability-free is therefore AT the settlement fixpoint, and
;; the whole-program fold is the identity on it.  A singleton compiler cannot
;; run that fold, and UnitContractV0 does not bind a callee's inferred effects,
;; so anything not already at the fixpoint is refused rather than compiled.
(defn at-settlement-fixpoint? [(function lower/TypedFunctionV0)] Bool
  (and (lower/ready-function? function)
    (= 1 (count (lower/typedfunctionv0-effects function)))
    (core/native-id= (lower/pure-effect-id)
      (nth (lower/typedfunctionv0-effects function) 0))
    (= 0 (count (lower/function-regions function)))
    (= 0 (count (lower/function-capabilities function)))))

;; A read set names source units; a body names the function each one defines.
(defn read-function-ids
  [(units (Vec stages/SourceUnitV0))
   (read-set (Vec core/NativeId))]
  (Vec core/NativeId)
  (loop [position Int 0 collected (Vec core/NativeId) []]
    (if (>= position (count read-set))
      collected
      (let [(read-unit (U stages/SourceUnitV0 Nil))
            (unit/source-unit-for units (nth read-set position))]
        (recur (+ position 1)
          (if (nil? read-unit)
            collected
            (conj collected
              (lower/function-id (stages/sourceunitv0-id read-unit)
                (stages/sourceunitv0-name read-unit)))))))))

;; Empty means the supplied dependency context matches the prepared candidate.
(defn dependency-context-mismatch
  [(prepared PreparedCandidateV0)
   (read-set (Vec core/NativeId))
   (read-contracts (Vec unit/UnitContractV0))]
  String
  (if (not (unit/exact-id-set? read-set (unit/contract-ids read-contracts)))
    "supplied contract rows are not exactly the direct read set"
    (loop [position Int 0]
      (if (>= position (count read-set))
        ""
        (let [(read-id core/NativeId) (nth read-set position)
              (supplied (U unit/UnitContractV0 Nil))
              (contract-for read-contracts read-id)
              (candidate (U unit/UnitContractV0 Nil))
              (contract-for (preparedcandidatev0-contracts prepared) read-id)]
          (cond
            (nil? candidate)
            (str "no candidate contract for " (core/nativeid-value read-id))

            (nil? supplied)
            (str "no supplied contract for " (core/nativeid-value read-id))

            (not= (unit/unitcontractv0-digest supplied)
              (unit/unitcontractv0-digest candidate))
            (str "stale dependency contract for "
              (core/nativeid-value read-id))

            :else (recur (+ position 1))))))))

(defn prepare-unit-compilation
  [(frozen-source stages/FrozenSourceStageV1)
   (compiler-rule-epoch String)
   (semantic-contracts (Vec unit/SemanticFormContractV1))
   (configuration (Vec String))]
  UnitPreparationResultV0
  (let [(source stages/SourceStageV1)
        (stages/frozensourcestagev1-stage frozen-source)
        (units (Vec stages/SourceUnitV0)) (stages/sourcestagev1-units source)
        (modules (Vec stages/SourceModuleV1))
        (stages/sourcestagev1-modules source)]
    (if (not (unit/source-units-supported? units))
      (->UnitPreparationRejectedV0 "UNIT-CORPUS-UNSUPPORTED"
        "preparation accepts exactly the nine defn branch corpus units")
      (let [(prelude lower/TypingPreludeV0)
            (lower/prepare-typing-prelude frozen-source configuration)
            (env lower/BodyEnvV0) (lower/typingpreludev0-env prelude)
            (index lower/SourceIndexV0) (lower/bodyenvv0-index env)
            (resolutions (Vec lower/FunctionResolutionV0))
            (lower/typingpreludev0-signature-resolutions prelude)]
        (loop [position Int 0 contracts (Vec unit/UnitContractV0) []]
          (if (>= position (count units))
            (->UnitPreparationAcceptedV0
              (->PreparedCandidateV0 frozen-source prelude contracts
                semantic-contracts compiler-rule-epoch configuration))
            (let [(source-unit stages/SourceUnitV0) (nth units position)
                  (unit-id core/NativeId) (stages/sourceunitv0-id source-unit)
                  (target-function core/NativeId)
                  (lower/function-id unit-id
                    (stages/sourceunitv0-name source-unit))
                  (signature-position Int)
                  (signature-index-for resolutions target-function)
                  (module (U stages/SourceModuleV1 Nil))
                  (unit/source-module-for modules
                    (stages/sourceunitv0-module-id source-unit))
                  (private-text String)
                  (lower/fact-text index unit-id "private")]
              (cond
                (< signature-position 0)
                (->UnitPreparationRejectedV0 "UNIT-SIGNATURE-MISSING"
                  (core/nativeid-value target-function))

                (nil? module)
                (->UnitPreparationRejectedV0 "UNIT-MODULE-MISSING"
                  (core/nativeid-value
                    (stages/sourceunitv0-module-id source-unit)))

                (not (or (= "true" private-text) (= "false" private-text)))
                (->UnitPreparationRejectedV0 "UNIT-VISIBILITY-MISSING"
                  (core/nativeid-value unit-id))

                :else
                (recur (+ position 1)
                  (conj contracts
                    (unit/make-unit-contract unit-id
                      (str (stages/sourcemodulev1-name module) "/"
                        (stages/sourceunitv0-name source-unit))
                      (if (= "true" private-text) "private" "public")
                      (lower/functionresolutionv0-function
                        (nth resolutions signature-position)))))))))))))

(defn compile-typed-unit
  [(prepared PreparedCandidateV0)
   (target-unit-id core/NativeId)
   (target-semantic-digest String)
   (target-read-set (Vec core/NativeId))
   (read-contracts (Vec unit/UnitContractV0))
   (derivation-receipt unit/UnitDerivationReceiptV1)
   (expected-result-key String)]
  TypedUnitCompileResultV0
  (let [(source stages/SourceStageV1)
        (stages/frozensourcestagev1-stage
          (preparedcandidatev0-frozen-source prepared))
        (units (Vec stages/SourceUnitV0)) (stages/sourcestagev1-units source)
        (target (U stages/SourceUnitV0 Nil))
        (unit/source-unit-for units target-unit-id)]
    (if (nil? target)
      (->TypedUnitCompileRejectedV0 "UNIT-TARGET-MISSING"
        "the requested unit is not in the frozen candidate source"
        target-unit-id)
      (let [(prelude lower/TypingPreludeV0)
            (preparedcandidatev0-prelude prepared)
            (env lower/BodyEnvV0) (lower/typingpreludev0-env prelude)
            (resolutions (Vec lower/FunctionResolutionV0))
            (lower/typingpreludev0-signature-resolutions prelude)
            (sources (Vec core/NativeId))
            (lower/bodyenvv0-signature-sources env)
            (target-function core/NativeId)
            (lower/function-id target-unit-id
              (stages/sourceunitv0-name target))
            (signature-position Int)
            (signature-index-for resolutions target-function)
            (context-detail String)
            (dependency-context-mismatch prepared target-read-set
              read-contracts)
            (result-key String)
            (unit/unit-result-key derivation-receipt)]
        (cond
          (not= target-semantic-digest
            (stages/sourceunitv0-semantic-digest target))
          (->TypedUnitCompileRejectedV0 "UNIT-TARGET-CONTEXT"
            "requested semantic digest differs from the frozen source"
            target-unit-id)

          (not (unit/exact-id-set? (stages/sourceunitv0-read-set target)
                 target-read-set))
          (->TypedUnitCompileRejectedV0 "UNIT-TARGET-CONTEXT"
            "requested read set differs from the frozen source"
            target-unit-id)

          (> (count context-detail) 0)
          (->TypedUnitCompileRejectedV0 "UNIT-DEPENDENCY-CONTEXT"
            context-detail target-unit-id)

          (not
            (unit/unit-derivation-receipt-valid-for?
              derivation-receipt target read-contracts
              (preparedcandidatev0-semantic-contracts prepared)))
          (->TypedUnitCompileRejectedV0 "UNIT-DERIVATION-CONTEXT"
            "derivation receipt differs from the unit, dependencies, profile, or form contracts"
            target-unit-id)

          (not= (unit/unitderivationreceiptv1-compiler-rule-epoch
                  derivation-receipt)
            (preparedcandidatev0-compiler-rule-epoch prepared))
          (->TypedUnitCompileRejectedV0 "UNIT-DERIVATION-CONTEXT"
            "derivation receipt uses a different compiler rule epoch"
            target-unit-id)

          (not= expected-result-key result-key)
          (->TypedUnitCompileRejectedV0 "UNIT-RESULT-KEY"
            "recomputed result key differs from the requested key"
            target-unit-id)

          (< signature-position 0)
          (->TypedUnitCompileRejectedV0 "UNIT-SIGNATURE-MISSING"
            (core/nativeid-value target-function) target-unit-id)

          (>= signature-position (count sources))
          (->TypedUnitCompileRejectedV0 "UNIT-SIGNATURE-MISSING"
            "no source root is paired with the target signature"
            target-unit-id)

          :else
          (let [(resolution lower/FunctionResolutionV0)
                (lower/attach-body env (nth resolutions signature-position)
                  (nth sources signature-position))
                (function lower/TypedFunctionV0)
                (lower/functionresolutionv0-function resolution)
                ;; The prelude's types are a BASE, never the closed set: a body
                ;; contributes types of its own, such as the checked-arithmetic
                ;; outcome family.  The merge is the same fold the whole path
                ;; runs over all nine resolutions, applied to this one, and it
                ;; must precede selection because reachability only follows
                ;; references through types present in the vector it is given.
                (merged-types (Vec core/TypeDef))
                (lower/collect-function-types (lower/bodyenvv0-types env)
                  [resolution])
                (unit-types (Vec core/TypeDef))
                (unit/selected-types merged-types function)
                ;; A target at the settlement fixpoint carries only the pure
                ;; effect and no capability, so the whole-program effect and
                ;; capability seeds select exactly what the clean path selects.
                (unit-effects (Vec core/EffectDef))
                (unit/selected-effects
                  (lower/slice-effects false false false false false false
                    false false)
                  function)
                (unit-capabilities (Vec core/CapabilityDef))
                (unit/selected-capabilities
                  (lower/slice-capabilities false false false false false false
                    false false)
                  function)
                (allowed (Vec core/NativeId))
                (read-function-ids units target-read-set)
                (typed-unit unit/TypedUnitV0)
                (unit/make-typed-unit target-unit-id function unit-types
                  unit-effects unit-capabilities)]
            (cond
              (not (at-settlement-fixpoint? function))
              (->TypedUnitCompileRejectedV0 "UNIT-TARGET-NOT-SETTLED"
                (str (lower/typedfunctionv0-name function)
                  " is not ready, exactly pure, and region/capability free")
                target-unit-id)

              (not (core/ids-in? (lower/body-call-targets function) allowed))
              (->TypedUnitCompileRejectedV0 "UNIT-TARGET-CALL-ESCAPES"
                (str (lower/typedfunctionv0-name function)
                  " calls outside its frozen direct read set")
                target-unit-id)

              (not (unit/typed-unit-record-valid? typed-unit))
              (->TypedUnitCompileRejectedV0 "UNIT-WIRE-CORPUS-UNSUPPORTED"
                (str (lower/typedfunctionv0-name function)
                  " has a typed record outside unit wire v1")
                target-unit-id)

              :else
              (->TypedUnitCompiledV0 typed-unit result-key
                [target-unit-id]))))))))

;; Native ABI identity has one non-local input: function-abi embeds the digest
;; of the FULL candidate layout set, so this may run only once a complete,
;; collision-free nine-unit typed set exists.  Resolving layouts for types is
;; allowed here; lowering another function body is not.
(defn compile-native-unit
  [(prepared PreparedCandidateV0)
   (target-unit-id core/NativeId)
   (target-typed unit/TypedUnitV0)
   (candidate-typed-units (Vec unit/TypedUnitV0))
   (derivation-receipt unit/UnitDerivationReceiptV1)
   (expected-result-key String)
   (abi core/AbiProfileV0)]
  NativeUnitCompileResultV0
  (let [(source stages/SourceStageV1)
        (stages/frozensourcestagev1-stage
          (preparedcandidatev0-frozen-source prepared))
        (units (Vec stages/SourceUnitV0)) (stages/sourcestagev1-units source)
        (target (U stages/SourceUnitV0 Nil))
        (unit/source-unit-for units target-unit-id)
        (found (U unit/TypedUnitV0 Nil))
        (typed-unit-for candidate-typed-units target-unit-id)
        (function lower/TypedFunctionV0)
        (unit/typedunitv0-function target-typed)
        (candidate-types (Vec core/TypeDef))
        (unit/collect-types candidate-typed-units)
        (native-types (Vec core/TypeDef))
        (lower/append-type-def candidate-types (lower/union-tag-type))
        (layout-resolutions (Vec lower/LayoutResolutionV0))
        (lower/resolve-layouts native-types abi)
        (layouts (Vec core/LayoutDef)) (lower/collect-layouts layout-resolutions)
        (layouts-digest String) (lower/layout-digest layouts)]
    (cond
      (nil? target)
      (->NativeUnitCompileRejectedV0 "UNIT-TARGET-MISSING"
        "the requested unit is not in the frozen candidate source"
        target-unit-id)

      (nil? found)
      (->NativeUnitCompileRejectedV0 "UNIT-NATIVE-SET"
        "the target typed unit is absent from the candidate typed set"
        target-unit-id)

      (not= found target-typed)
      (->NativeUnitCompileRejectedV0 "UNIT-NATIVE-SET"
        "the target typed unit differs from its candidate set row"
        target-unit-id)

      (not (unit/exact-id-set? (unit/source-unit-ids units)
             (unit/typed-unit-ids candidate-typed-units)))
      (->NativeUnitCompileRejectedV0 "UNIT-NATIVE-SET"
        "the candidate typed set is not the exact nine-unit source set"
        target-unit-id)

      (not (at-settlement-fixpoint? function))
      (->NativeUnitCompileRejectedV0 "UNIT-TARGET-NOT-SETTLED"
        (str (lower/typedfunctionv0-name function)
          " is not ready, exactly pure, and region/capability free")
        target-unit-id)

      (not (lower/layouts-closed? layout-resolutions))
      (->NativeUnitCompileRejectedV0 "UNIT-NATIVE-LAYOUTS"
        "the candidate layout set does not close" target-unit-id)

      (not
        (unit/unit-derivation-receipt-valid-for?
          derivation-receipt target
          (preparedcandidatev0-contracts prepared)
          (preparedcandidatev0-semantic-contracts prepared)))
      (->NativeUnitCompileRejectedV0 "UNIT-DERIVATION-CONTEXT"
        "derivation receipt differs from the unit, dependencies, profile, or form contracts"
        target-unit-id)

      (not= (unit/unitderivationreceiptv1-compiler-rule-epoch
              derivation-receipt)
        (preparedcandidatev0-compiler-rule-epoch prepared))
      (->NativeUnitCompileRejectedV0 "UNIT-DERIVATION-CONTEXT"
        "derivation receipt uses a different compiler rule epoch"
        target-unit-id)

      (not= expected-result-key (unit/unit-result-key derivation-receipt))
      (->NativeUnitCompileRejectedV0 "UNIT-RESULT-KEY"
        "recomputed result key differs from the requested key"
        target-unit-id)

      :else
      (let [(native-function core/FunctionDef)
            (lower/lower-ready-function function)
            (export core/AbiDeclV0) (lower/function-abi function layouts-digest)
            (unit-layouts (Vec core/LayoutDef))
            (unit/selected-layouts layouts
              (unit/typedunitv0-types target-typed))
            (unit-abis (Vec core/AbiDeclV0))
            (unit/selected-abis [export] function native-function)
            (unit-regions (Vec core/RegionDef))
            (unit/selected-regions (lower/slice-regions) native-function)
            (native-unit unit/NativeUnitV0)
            (unit/make-native-unit target-unit-id native-function unit-layouts
              unit-abis unit-regions)]
        (if (not (unit/native-unit-record-valid? native-unit))
          (->NativeUnitCompileRejectedV0 "UNIT-WIRE-CORPUS-UNSUPPORTED"
            (str (lower/typedfunctionv0-name function)
              " has a native record outside unit wire v1")
            target-unit-id)
          (->NativeUnitCompiledV0 native-unit
            (unit/unit-result-key derivation-receipt)
            [target-unit-id]))))))
