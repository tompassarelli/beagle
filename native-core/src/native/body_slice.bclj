#lang beagle/clj
;; Drives one source-fact projection through freeze -> typed -> native -> the
;; seven obligations -> the restricted C17 body materializer.
;; The projection keeps exactly the types the lowered functions reach, so the
;; program-level obligations are about lowered code, not about unreachable shapes.
(ns native.body-slice
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.obligations :as obligations]
            [native.slice :as slice]
            [native.fold-c17 :as c17]
            [native.body-c17 :as body]
            [native.qbe :as qbe]))

(define-mode strict)

(defn union-tag-type-id [] -> core/NativeId
  (core/typedef-id (lower/union-tag-type)))

(defn type-references [definition: core/TypeDef] -> (Vec core/NativeId)
  (let [shape: core/TypeShape (core/typedef-shape definition)]
    (cond
      (instance? native.core.RecordType shape)
      (mapv (fn [field: core/TypeField] -> core/NativeId
              (core/typefield-type-id field))
        (core/recordtype-fields shape))

      (instance? native.core.UnionType shape)
      (loop [position: Int 0
             variants: (Vec core/TypeVariant) (core/uniontype-variants shape)
             collected: (Vec core/NativeId) [(union-tag-type-id)]]
        (if (>= position (count variants))
          collected
          (let [payload: (U core/NativeId Nil)
                (core/typevariant-payload-type (nth variants position))]
            (recur (+ position 1) variants
              (if (nil? payload) collected (conj collected payload))))))

      (instance? native.core.VectorType shape)
      [(core/vectortype-element-type shape)]

      (instance? native.core.MapTypeV0 shape)
      [(core/maptypev0-key-type shape) (core/maptypev0-value-type shape)]

      (instance? native.core.SetTypeV0 shape)
      [(core/settypev0-element-type shape)]

      (instance? native.core.ReferenceType shape)
      [(core/referencetype-target-type shape)]

      (instance? native.core.FunctionType shape)
      (let [rest-type: (U core/NativeId Nil)
            (core/functiontype-rest-type shape)]
        (vec (concat
               (core/functiontype-parameter-types shape)
               (if (nil? rest-type) [] [rest-type])
               [(core/functiontype-return-type shape)])))

      (instance? native.core.OutcomeType shape)
      [(core/outcometype-value-type shape)
       (core/outcometype-failure-type shape)
       (union-tag-type-id)]

      :else [])))

(defn instruction-type [instruction: core/Instruction] -> core/NativeId
  (core/ssavaluev0-type-id (get instruction :result)))

(defn function-type-seeds [function: core/FunctionDef] -> (Vec core/NativeId)
  (let [return-type: (U core/NativeId Nil) (core/functiondef-return-type function)
        seeds: (Vec core/NativeId)
        (core/append-ids
          (mapv (fn [parameter: core/Parameter] -> core/NativeId
                  (core/parameter-type-id parameter))
            (core/functiondef-parameters function))
          (if (nil? return-type) [] [return-type]))
        blocks: (Vec core/BasicBlock) (core/functiondef-blocks function)]
    (loop [position: Int 0 collected: (Vec core/NativeId) seeds]
      (if (>= position (count blocks))
        collected
        (let [block: core/BasicBlock (nth blocks position)
              with-parameters: (Vec core/NativeId)
              (core/append-ids collected
                (mapv (fn [parameter: core/Parameter] -> core/NativeId
                        (core/parameter-type-id parameter))
                  (core/basicblock-parameters block)))]
          (recur (+ position 1)
            (core/append-ids with-parameters
              (mapv (fn [instruction: core/Instruction] -> core/NativeId
                      (instruction-type instruction))
                (core/basicblock-instructions block)))))))))

(defn conj-id
  [ids: (Vec core/NativeId)
   candidate: core/NativeId] -> (Vec core/NativeId)
  (if (core/id-in? ids candidate) ids (conj ids candidate)))

(defn abi-type-seeds [program: core/NativeCoreProgram] -> (Vec core/NativeId)
  (loop [position: Int 0
         abis: (Vec core/AbiDeclV0) (core/nativecoreprogram-abis program)
         collected: (Vec core/NativeId) []]
    (if (>= position (count abis))
      collected
      (let [abi: core/AbiDeclV0 (nth abis position)
            result: (U core/AbiValueV0 Nil) (core/abideclv0-result abi)]
        (recur (+ position 1) abis
          (core/append-ids
            (core/append-ids collected [(core/abideclv0-failure-type abi)])
            (mapv (fn [value: core/AbiValueV0] -> core/NativeId
                    (core/abivaluev0-type-id value))
              (if (nil? result)
                (core/abideclv0-parameters abi)
                (conj (core/abideclv0-parameters abi) result)))))))))

(defn reachable-type-ids [program: core/NativeCoreProgram] -> (Vec core/NativeId)
  (let [types: (Vec core/TypeDef) (core/nativecoreprogram-types program)
        seeds: (Vec core/NativeId)
        (loop [position: Int 0
               functions: (Vec core/FunctionDef) (core/nativecoreprogram-functions program)
               collected: (Vec core/NativeId) (abi-type-seeds program)]
          (if (>= position (count functions))
            collected
            (recur (+ position 1) functions
              (loop [inner: Int 0
                     candidates: (Vec core/NativeId)
                     (function-type-seeds (nth functions position))
                     kept: (Vec core/NativeId) collected]
                (if (>= inner (count candidates))
                  kept
                  (recur (+ inner 1) candidates
                    (conj-id kept (nth candidates inner))))))))]
    (loop [round: Int 0 current: (Vec core/NativeId) seeds]
      (let [grown: (Vec core/NativeId)
            (loop [position: Int 0 collected: (Vec core/NativeId) current]
              (if (>= position (count current))
                collected
                (let [definition: (U core/TypeDef Nil)
                      (slice/find-type types (nth current position))
                      references: (Vec core/NativeId)
                      (if (nil? definition) [] (type-references definition))]
                  (recur (+ position 1)
                    (loop [inner: Int 0 kept: (Vec core/NativeId) collected]
                      (if (>= inner (count references))
                        kept
                        (recur (+ inner 1) (conj-id kept (nth references inner)))))))))]
        (if (or (= (count grown) (count current)) (> round (count types)))
          grown
          (recur (+ round 1) grown))))))

(defn projected-program [program: core/NativeCoreProgram] -> core/NativeCoreProgram
  (let [kept: (Vec core/NativeId) (reachable-type-ids program)]
    (core/->NativeCoreProgram
      (core/nativecoreprogram-id program)
      (core/nativecoreprogram-parent program)
      (core/nativecoreprogram-compiler-pass program)
      (filterv (fn [definition: core/TypeDef] -> Bool
                 (core/id-in? kept (core/typedef-id definition)))
        (core/nativecoreprogram-types program))
      (core/nativecoreprogram-effects program)
      (core/nativecoreprogram-regions program)
      (core/nativecoreprogram-capabilities program)
      (filterv (fn [layout: core/LayoutDef] -> Bool
                 (core/id-in? kept (core/layoutdef-type-id layout)))
        (core/nativecoreprogram-layouts program))
      (core/nativecoreprogram-functions program)
      (core/nativecoreprogram-allowed-effects program)
      (core/nativecoreprogram-allowed-regions program)
      (core/nativecoreprogram-allowed-capabilities program)
      (core/nativecoreprogram-abis program)
      (core/nativecoreprogram-observations program))))

(defn id-text [candidate: Any] -> String (str (get candidate :value "")))

(defn verdict-subject [verdict: Any] -> String
  (str (id-text (get verdict :type-id nil))
    (id-text (get verdict :function-id nil))
    (id-text (get verdict :abi-id nil))))

(defn obligation-report
  [label: String
   verdicts: (Vec obligations/ObligationVerdictV0)] -> String
  (let [names: (Vec String) (slice/obligation-names)]
    (loop [position: Int 0 report: String ""]
      (if (>= position (count verdicts))
        report
        (recur (+ position 1)
          (str report label " "
            (if (obligations/obligation-passed? (nth verdicts position))
              "PASS"
              "FAIL")
            " " (nth names position) "\n"))))))

(defn failing-obligation-verdicts
  [verdicts: (Vec obligations/ObligationVerdictV0)] -> String
  (let [names: (Vec String) (slice/obligation-names)]
    (loop [position: Int 0 report: String ""]
      (if (>= position (count verdicts))
        report
        (recur (+ position 1)
          (if (obligations/obligation-passed? (nth verdicts position))
            report
            (str report "obligation-detail " (nth names position) " "
              (verdict-subject (nth verdicts position)) "\n")))))))

(defn failing-obligations
  [program: core/NativeCoreProgram
   abi: core/AbiProfileV0] -> String
  (failing-obligation-verdicts
    (obligations/validate-native-core-program program abi)))

(defn function-report [functions: (Vec core/FunctionDef)] -> String
  (let [ordered: (Vec core/FunctionDef) (c17/ordered-functions functions)]
    (loop [position: Int 0 report: String ""]
      (if (>= position (count ordered))
        report
        (recur (+ position 1)
          (str report "lowered fn_" (str position) " "
            (core/functiondef-name (nth ordered position)) " "
            (str (count (core/functiondef-blocks (nth ordered position))))
            " blocks\n"))))))

(defn functions-named
  [functions: (Vec core/FunctionDef)
   name: String] -> (Vec core/FunctionDef)
  (filterv (fn [function: core/FunctionDef] -> Bool
             (= name (core/functiondef-name function)))
    functions))

(defn single-function-program
  [program: core/NativeCoreProgram
   function: core/FunctionDef] -> core/NativeCoreProgram
  (let [function-id: core/NativeId (core/functiondef-id function)]
    (core/->NativeCoreProgram
      (core/nativecoreprogram-id program)
      (core/nativecoreprogram-parent program)
      (core/nativecoreprogram-compiler-pass program)
      (core/nativecoreprogram-types program)
      (core/nativecoreprogram-effects program)
      (core/nativecoreprogram-regions program)
      (core/nativecoreprogram-capabilities program)
      (core/nativecoreprogram-layouts program)
      [function]
      (core/nativecoreprogram-allowed-effects program)
      (core/nativecoreprogram-allowed-regions program)
      (core/nativecoreprogram-allowed-capabilities program)
      (filterv (fn [abi: core/AbiDeclV0] -> Bool
                 (core/native-id= function-id (core/abideclv0-function-id abi)))
        (core/nativecoreprogram-abis program))
      (core/nativecoreprogram-observations program))))

(defn obligations-pass?
  [verdicts: (Vec obligations/ObligationVerdictV0)] -> Bool
  (every? obligations/obligation-passed?
    verdicts))

(defn qbe-leaf? [function: core/FunctionDef] -> Bool
  (every? (fn [block: core/BasicBlock] -> Bool
            (every? (fn [instruction: core/Instruction] -> Bool
                      (not (instance? native.core.CallInstruction instruction)))
              (core/basicblock-instructions block)))
    (core/functiondef-blocks function)))

(defn emit-qbe-function!
  [program: core/NativeCoreProgram
   function-name: String
   artifacts-dir: String
   module-index: Int
   abi: core/AbiProfileV0] -> String
  (let [matches: (Vec core/FunctionDef)
        (functions-named (core/nativecoreprogram-functions program) function-name)]
    (if (not= (count matches) 1)
      (str "qbe-selected-function REFUSED " function-name
        " matches=" (count matches) "\n")
      (let [selected: core/FunctionDef (nth matches 0)]
        (if (not (qbe-leaf? selected))
          (str "qbe-selected-function REFUSED " function-name
            " has calls outside the one-function projection\n")
          (let [projected: core/NativeCoreProgram
                (projected-program (single-function-program program selected))
                verdicts: (Vec obligations/ObligationVerdictV0)
                (obligations/validate-native-core-program projected abi)
                head: String
                (str "qbe-selected-function " function-name "\n"
                  "qbe-program-functions "
                  (count (core/nativecoreprogram-functions projected)) "\n"
                  "qbe-program-abis " (count (core/nativecoreprogram-abis projected)) "\n"
                  "qbe-projected-types "
                  (count (core/nativecoreprogram-types projected)) "\n"
                  (obligation-report "qbe-obligation" verdicts)
                  (failing-obligation-verdicts verdicts))]
            (if (not (obligations-pass? verdicts))
              (str head "qbe-materialize REFUSED structural obligations failed\n")
              (let [result: qbe/QbeMaterialization
                    (qbe/materialize-program projected module-index
                      (core/abiprofilev0-id abi))]
                (if (not (qbe/materialization-ok? result))
                  (str head "qbe-materialize REFUSED "
                    (qbe/materialization-detail result) "\n")
                  (let [artifact: qbe/QbeArtifact
                        (qbe/materialization-artifact result)]
                    (do
                      (spit (str artifacts-dir "/"
                              (qbe/qbeartifact-module-name artifact))
                        (qbe/qbeartifact-module-text artifact))
                      (str head "qbe-materialize OK "
                        (qbe/qbeartifact-module-name artifact) "\n"))))))))))))

(defn emit-slice-for-abi!
  [facts-path: String
   module-name: String
   relative-path: String
   artifacts-dir: String
   compiler-commit: String
   abi: core/AbiProfileV0] -> String
  (let [rows: (Vec slice/SliceFactV0) (slice/parse-facts (slurp facts-path))
        configuration: (Vec String)
        ["profile=3" (str "abi=" (core/abiprofilev0-id abi))]
        source: stages/SourceStageV0
        (slice/source-program rows module-name relative-path)
        freeze-result: lower/SourceFreezeResultV0
        (lower/freeze-source-stage source compiler-commit configuration)]
    (if (not (instance? native.lower.SourceFreezeAcceptedV0 freeze-result))
      "stage source-freeze REJECTED\n"
      (let [frozen-source: stages/FrozenSourceStageV0
            (lower/sourcefreezeacceptedv0-frozen freeze-result)
            typing-result: lower/TypingResultV0
            (lower/lower-typed-stage frozen-source compiler-commit configuration)]
        (if (not (instance? native.lower.TypingAcceptedV0 typing-result))
          "stage source-freeze ACCEPTED\nstage source-to-typed REJECTED\n"
          (let [frozen-typed: stages/FrozenTypedStageV0
                (lower/typingacceptedv0-frozen typing-result)
                typed-slice: lower/TypedSliceV0
                (lower/typingacceptedv0-slice typing-result)
                native-result: lower/NativeLoweringResultV0
                (lower/lower-native-stage frozen-typed typed-slice compiler-commit
                  configuration abi)
                frozen-native: stages/FrozenNativeStageV0
                (slice/native-frozen native-result)
                program: core/NativeCoreProgram
                (stages/nativestagev0-program
                  (stages/frozennativestagev0-stage frozen-native))
                projected: core/NativeCoreProgram (projected-program program)
                result: body/BodyMaterializationV0 (body/materialize-program projected 0)
                verdicts: (Vec obligations/ObligationVerdictV0)
                (obligations/validate-native-core-program projected abi)
                head: String
                (str "stage source-freeze ACCEPTED\n"
                  "stage source-to-typed ACCEPTED\n"
                  "stage typed-to-native "
                  (if (instance? native.lower.NativeLoweringCompleteV0 native-result)
                    "COMPLETE" "PENDING")
                  "\n"
                  "source-modules "
                  (str (count (stages/sourcestagev0-modules source))) "\n"
                  "source-imports "
                  (str (count (stages/sourcestagev0-imports source))) "\n"
                  "program-types " (str (count (core/nativecoreprogram-types program))) "\n"
                  "program-functions "
                  (str (count (core/nativecoreprogram-functions program))) "\n"
                  "program-abis " (str (count (core/nativecoreprogram-abis program))) "\n"
                  "projected-types "
                  (str (count (core/nativecoreprogram-types projected))) "\n"
                  (function-report (core/nativecoreprogram-functions projected))
                  (obligation-report "obligation-projection" verdicts)
                  (failing-obligation-verdicts verdicts)
                  (slice/pending-reports (slice/native-pending native-result)))]
            (if (not (body/materialization-ok? result))
              (str head "materialize REFUSED "
                (body/materialization-detail result) "\n")
              (let [artifact: body/BodyArtifactV0
                    (body/materialization-artifact result)]
                (do
                 (spit (str artifacts-dir "/" (body/bodyartifactv0-header-name artifact))
                   (body/bodyartifactv0-header-text artifact))
                 (spit (str artifacts-dir "/" (body/bodyartifactv0-source-name artifact))
                   (body/bodyartifactv0-source-text artifact))
                  (str head "materialize OK "
                    (body/bodyartifactv0-header-name artifact) " "
                    (body/bodyartifactv0-source-name artifact) "\n"))))))))))

(defn emit-slice!
  [facts-path: String
   module-name: String
   relative-path: String
   artifacts-dir: String
   compiler-commit: String
   abi-id: String] -> String
  (let [profile: (U core/AbiProfileV0 Nil) (core/abi-profile-for abi-id)]
    (if (nil? profile)
      (str "stage abi REJECTED unknown abi profile " abi-id "\n")
      (emit-slice-for-abi! facts-path module-name relative-path artifacts-dir
        compiler-commit profile))))

(defn emit-dual-slice-for-abi!
  [facts-path: String
   module-name: String
   relative-path: String
   artifacts-dir: String
   compiler-commit: String
   qbe-function-name: String
   qbe-module-index: Int
   abi: core/AbiProfileV0] -> String
  (let [rows: (Vec slice/SliceFactV0) (slice/parse-facts (slurp facts-path))
        configuration: (Vec String)
        ["profile=3" (str "abi=" (core/abiprofilev0-id abi))]
        source: stages/SourceStageV0
        (slice/source-program rows module-name relative-path)
        freeze-result: lower/SourceFreezeResultV0
        (lower/freeze-source-stage source compiler-commit configuration)]
    (if (not (instance? native.lower.SourceFreezeAcceptedV0 freeze-result))
      "stage source-freeze REJECTED\n"
      (let [frozen-source: stages/FrozenSourceStageV0
            (lower/sourcefreezeacceptedv0-frozen freeze-result)
            typing-result: lower/TypingResultV0
            (lower/lower-typed-stage frozen-source compiler-commit configuration)]
        (if (not (instance? native.lower.TypingAcceptedV0 typing-result))
          "stage source-freeze ACCEPTED\nstage source-to-typed REJECTED\n"
          (let [frozen-typed: stages/FrozenTypedStageV0
                (lower/typingacceptedv0-frozen typing-result)
                typed-slice: lower/TypedSliceV0
                (lower/typingacceptedv0-slice typing-result)
                native-result: lower/NativeLoweringResultV0
                (lower/lower-native-stage frozen-typed typed-slice compiler-commit
                  configuration abi)
                frozen-native: stages/FrozenNativeStageV0
                (slice/native-frozen native-result)
                program: core/NativeCoreProgram
                (stages/nativestagev0-program
                  (stages/frozennativestagev0-stage frozen-native))
                projected: core/NativeCoreProgram (projected-program program)
                result: body/BodyMaterializationV0
                (body/materialize-program projected 0)
                verdicts: (Vec obligations/ObligationVerdictV0)
                (obligations/validate-native-core-program projected abi)
                complete: Bool
                (instance? native.lower.NativeLoweringCompleteV0 native-result)
                qbe-report: String
                (if complete
                  (str "qbe-stage typed-to-native COMPLETE\n"
                    (emit-qbe-function! program qbe-function-name artifacts-dir
                      qbe-module-index abi))
                  (str "qbe-stage typed-to-native PENDING\n"
                    "qbe-materialize REFUSED native lowering incomplete\n"))
                head: String
                (str "stage source-freeze ACCEPTED\n"
                  "stage source-to-typed ACCEPTED\n"
                  "stage typed-to-native " (if complete "COMPLETE" "PENDING") "\n"
                  "source-modules "
                  (count (stages/sourcestagev0-modules source)) "\n"
                  "source-imports "
                  (count (stages/sourcestagev0-imports source)) "\n"
                  "program-types " (count (core/nativecoreprogram-types program)) "\n"
                  "program-functions "
                  (count (core/nativecoreprogram-functions program)) "\n"
                  "program-abis " (count (core/nativecoreprogram-abis program)) "\n"
                  "projected-types "
                  (count (core/nativecoreprogram-types projected)) "\n"
                  (function-report (core/nativecoreprogram-functions projected))
                  (obligation-report "obligation-projection" verdicts)
                  (failing-obligation-verdicts verdicts)
                  (slice/pending-reports (slice/native-pending native-result)))]
            (if (not (body/materialization-ok? result))
              (str head "materialize REFUSED "
                (body/materialization-detail result) "\n" qbe-report)
              (let [artifact: body/BodyArtifactV0
                    (body/materialization-artifact result)]
                (do
                  (spit (str artifacts-dir "/"
                          (body/bodyartifactv0-header-name artifact))
                    (body/bodyartifactv0-header-text artifact))
                  (spit (str artifacts-dir "/"
                          (body/bodyartifactv0-source-name artifact))
                    (body/bodyartifactv0-source-text artifact))
                  (str head "materialize OK "
                    (body/bodyartifactv0-header-name artifact) " "
                    (body/bodyartifactv0-source-name artifact) "\n"
                    qbe-report))))))))))

(defn emit-dual-slice!
  [facts-path: String
   module-name: String
   relative-path: String
   artifacts-dir: String
   compiler-commit: String
   qbe-function-name: String
   qbe-module-index: Int
   abi-id: String] -> String
  (let [profile: (U core/AbiProfileV0 Nil) (core/abi-profile-for abi-id)]
    (if (nil? profile)
      (str "stage abi REJECTED unknown abi profile " abi-id "\n")
      (emit-dual-slice-for-abi! facts-path module-name relative-path artifacts-dir
        compiler-commit qbe-function-name qbe-module-index profile))))
