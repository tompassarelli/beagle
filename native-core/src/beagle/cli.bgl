#lang beagle
(ns beagle.cli
  (:require [beagle.compiler-driver :as driver]))

(defn write-usage [] Nil
  (host.stderr/write-line "usage: beagle syntax SOURCE"))

(defn syntax-command [(args (Vec String))] Int
  (if (= 1 (count args))
    (match (driver/read-source-path (first args))
      [(SourceAccepted) 0]
      [(SourceRejected code path offset detail)
       (do
         (host.stderr/write-line
           (if (>= offset 0)
             (str path ":" offset ": " detail)
             (str path ": " detail)))
         code)])
    (do (write-usage) 64)))

(defn -main [(args (Vec String))] Int
  (if (empty? args)
    (do (write-usage) 64)
    (let [(command String) (first args)
          (command-args (Vec String)) (subvec args 1)]
      (cond
        (= command "syntax") (syntax-command command-args)
        (or (= command "--help") (= command "-h"))
        (do (write-usage) 0)
        :else
        (do
          (host.stderr/write-line (str "beagle: unknown command: " command))
          (write-usage)
          64)))))
