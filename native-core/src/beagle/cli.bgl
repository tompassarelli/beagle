#lang beagle
(ns beagle.cli
  (:require [beagle.bootstrap-contract :as bootstrap]
            [beagle.compiler-driver :as driver]
            [beagle.module-source-resolver :as resolver]
            [beagle.native-rebuild :as rebuild]))

(defunion CliModuleRootsResult
  (CliModuleRootsReady [roots (Vec resolver/ModuleSourceRootV1)])
  (CliModuleRootsRejected [code Int detail String]))

(defn write-native-usage [] Nil
  (do
    (host.stderr/write-line bootstrap/rebuild-next-command-usage)
    (host.stderr/write-line bootstrap/bootstrap-contract-command-usage)))

(defn write-usage [] Nil
  (do
    (host.stderr/write-line "usage: beagle syntax SOURCE")
    (host.stderr/write-line bootstrap/compile-command-usage)
    (write-native-usage)))

(defn bootstrap-contract-command [args (Vec String)] Int
  (if (empty? args)
    (do (print (bootstrap/bootstrap-contract-payload)) 0)
    (if (and (= 1 (count args))
             (or (= "--help" (first args)) (= "-h" (first args))))
      (do (host.stderr/write-line bootstrap/bootstrap-contract-command-usage) 0)
      (do (host.stderr/write-line bootstrap/bootstrap-contract-command-usage) 64))))

(defn rebuild-next-command! [args (Vec String)] Int
  (if (and (= 1 (count args))
           (or (= "--help" (first args)) (= "-h" (first args))))
    (do (host.stderr/write-line bootstrap/rebuild-next-command-usage) 0)
    (if (and (= 6 (count args))
             (= "--bundle" (nth args 0))
             (= "--out" (nth args 2))
             (= "--parent-lineage" (nth args 4)))
      (match (rebuild/read-rebuild-bundle (nth args 1))
        [(rebuild/NativeRebuildBundleRejectedV1 code detail)
         (do
           (host.stderr/write-line (str "beagle: rebuild-next failed: " detail))
           code)]
        [(rebuild/NativeRebuildBundleDecodedV1 bundle)
         (match (rebuild/rebuild-next! bundle (nth args 3) (nth args 5))
           [(rebuild/NativeRebuildRejectedV1 code detail)
            (do
              (host.stderr/write-line
                (str "beagle: rebuild-next failed: " detail))
              code)]
           [(rebuild/NativeRebuildCompletedV1 semantic-content-id
                                               materialization-content-id
                                               executable-content-id
                                               lineage-content-id)
            (do
              (host.stderr/write-line
                (str "beagle: rebuild-next semantic=" semantic-content-id
                     " materialization=" materialization-content-id
                     " executable=" executable-content-id
                     " lineage=" lineage-content-id))
              0)])])
      (do (host.stderr/write-line bootstrap/rebuild-next-command-usage) 64))))

(defn syntax-command [args (Vec String)] Int
  (if (= 1 (count args))
    (match (driver/read-source-path (first args))
      [(SourceAccepted) 0]
      [(SourceRejected code path offset detail)
       (do
         (host.stderr/write-line
           (if (>= offset 0)
             (str path ":" offset ": " detail)
             (str path ": " detail)))
         code)])
    (do (write-usage) 64)))

(defn root-prefix-present?
  [roots (Vec resolver/ModuleSourceRootV1)
   logical-prefix String] Bool
  (some?
    (some
      (fn [root resolver/ModuleSourceRootV1] String?
        (if (= logical-prefix
                (resolver/modulesourcerootv1-logical-prefix root))
          logical-prefix
          nil))
      roots)))

(defn parse-module-roots
  [args (Vec String)
   start Int] CliModuleRootsResult
  (loop [offset Int start
         roots (Vec resolver/ModuleSourceRootV1) []]
    (if (>= offset (count args))
      (if (empty? roots)
        (->CliModuleRootsRejected 64
          "compile requires at least one --module-root")
        (->CliModuleRootsReady roots))
      (if (or (> (+ offset 2) (- (count args) 1))
              (not= "--module-root" (nth args offset)))
        (->CliModuleRootsRejected 64
          "module roots must be --module-root LOGICAL_PREFIX DIRECTORY triples")
        (let [logical-prefix String (nth args (+ offset 1))
              directory String (nth args (+ offset 2))]
          (if (root-prefix-present? roots logical-prefix)
            (->CliModuleRootsRejected 64
              (str "duplicate module-root logical prefix: " logical-prefix))
            (match (resolver/module-source-root logical-prefix directory)
              [(resolver/ModuleSourceRootRejectedV1 code detail)
               (->CliModuleRootsRejected code detail)]
              [(resolver/ModuleSourceRootReadyV1 root)
               (recur (+ offset 3) (conj roots root))])))))))

(defn compile-resolved-command!
  [source String
   source-id String
   output String
   roots (Vec resolver/ModuleSourceRootV1)
   store driver/CompileStore] Int
  (match (resolver/read-entry-source roots source-id source)
    [(resolver/ResolvedSourceReadRejectedV1 code detail)
     (do
       (host.stderr/write-line (str "beagle: compile failed: " detail))
       code)]
    [(resolver/ResolvedSourceReadV1 entry)
     (let [config driver/CompileSourceConfig
           (driver/->CompileSourceConfig
             source-id
             output
             (str output "/beagle-store.log")
             "compiler"
             "cc"
             "")]
       (match (driver/compile-source!
                config
                entry
                (fn [request driver/ImportResolutionRequestV1]
                  driver/ImportResolutionResponseV1
                  (resolver/resolve-import roots request))
                store)
         [(driver/CompileBundleWarm content-id artifact-id executable-path) 0]
         [(driver/CompileBundleMaterialized content-id artifact-id executable-path) 0]
         [(driver/CompileBundleError code detail)
          (do
            (host.stderr/write-line (str "beagle: compile failed: " detail))
            code)]))]))

(defn compile-command!
  [args (Vec String)
   store driver/CompileStore] Int
  (if (and (>= (count args) 8)
           (= "--source-id" (nth args 1))
           (= "--out" (nth args 3))
           (= 0 (mod (- (count args) 5) 3)))
    (let [source String (nth args 0)
          source-id String (nth args 2)
          output String (nth args 4)]
      (match (parse-module-roots args 5)
        [(CliModuleRootsRejected code detail)
         (do
           (host.stderr/write-line (str "beagle: compile failed: " detail))
           code)]
        [(CliModuleRootsReady roots)
         (compile-resolved-command! source source-id output roots store)]))
    (do (write-usage) 64)))

(defn main-with-store!
  [args (Vec String)
   store driver/CompileStore] Int
  (if (empty? args)
    (do (write-usage) 64)
    (let [command String (first args)
          command-args (Vec String) (subvec args 1)]
      (cond
        (= command "syntax") (syntax-command command-args)
        (= command "compile") (compile-command! command-args store)
        (= command "rebuild-next") (rebuild-next-command! command-args)
        (= command "bootstrap-contract")
        (bootstrap-contract-command command-args)
        (or (= command "--help") (= command "-h"))
        (do (write-usage) 0)
        :else
        (do
          (host.stderr/write-line (str "beagle: unknown command: " command))
          (write-usage)
          64)))))

(defn native-main! [args (Vec String)] Int
  (if (empty? args)
    (do (write-native-usage) 64)
    (let [command String (first args)
          command-args (Vec String) (subvec args 1)]
      (cond
        (= command "rebuild-next") (rebuild-next-command! command-args)
        (= command "bootstrap-contract")
        (bootstrap-contract-command command-args)
        (or (= command "--help") (= command "-h"))
        (do (write-native-usage) 0)
        :else
        (do
          (host.stderr/write-line (str "beagle: unknown native command: " command))
          (write-native-usage)
          64)))))

(defn main! [args (Vec String)] Int
  (native-main! args))

(defn -main [args (Vec String)] Int
  (main-with-store! args host.store/compile))
