#lang beagle
(ns beagle.artifact-linker
  (:require [native.json :as json]))

(defrecord ArtifactFileV1
  [name String
   payload String
   content-id String
   payload-byte-count Int
   payload-sha256 String])

(defrecord TargetArtifactV1
  [target String
   files (Vec ArtifactFileV1)
   encoding String
   digest String])

(defrecord ArtifactLinkConfigV1
  [artifact-directory String
   executable-path String
   c-compiler String
   qbe-compiler String])

(defunion ArtifactLinkResultV1
  (ArtifactLinkedV1 [executable-path String])
  (ArtifactLinkErrorV1
    [code Int
     detail String]))

(defunion ArtifactWriteResult
  (ArtifactFilesWritten
    [c-sources (Vec String)
     qbe-sources (Vec String)])
  (ArtifactFileWriteError
    [code Int
     detail String]))

(defunion ToolInputsResult
  (ToolInputsReady [paths (Vec String)])
  (ToolInputsError
    [code Int
     detail String]))

(defunion ArtifactEnvelopeResultV1
  (ArtifactEnvelopeReadyV1
    [content-id String
     payload String])
  (ArtifactEnvelopeErrorV1 [detail String]))

(defunion ArtifactEnvelopeDecodeResultV1
  (ArtifactEnvelopeDecodedV1 [artifact TargetArtifactV1])
  (ArtifactEnvelopeDecodeErrorV1 [detail String]))

(defunion ArtifactFilesDecodeResultV1
  (ArtifactFilesDecodedV1
    [files (Vec ArtifactFileV1)
     next-index Int])
  (ArtifactFilesDecodeErrorV1 [detail String]))

(defn content-digest [text String] String
  (str "sha256:" (sha256-bytes (utf8-encode text))))

(defn artifact-file-envelope-events
  [file ArtifactFileV1] (Vec json/JsonEvent)
  [(json/->JsonArrayStart 0)
   (json/->JsonString 0 (artifactfilev1-name file))
   (json/->JsonString 0 (artifactfilev1-payload file))
   (json/->JsonString 0 (artifactfilev1-content-id file))
   (json/->JsonNumber 0 (str (artifactfilev1-payload-byte-count file)))
   (json/->JsonString 0 (artifactfilev1-payload-sha256 file))
   (json/->JsonArrayEnd 0)])

(defn artifact-envelope-events
  [artifact TargetArtifactV1] (Vec json/JsonEvent)
  (let [prefix (Vec json/JsonEvent)
        [(json/->JsonArrayStart 0)
         (json/->JsonString 0 "beagle-target-artifact-v1")
         (json/->JsonString 0 (targetartifactv1-target artifact))
         (json/->JsonString 0 (targetartifactv1-encoding artifact))
         (json/->JsonString 0 (targetartifactv1-digest artifact))
         (json/->JsonArrayStart 0)]
        with-files (Vec json/JsonEvent)
        (reduce
          (fn [events (Vec json/JsonEvent)
               file ArtifactFileV1] (Vec json/JsonEvent)
            (reduce conj events (artifact-file-envelope-events file)))
          prefix
          (targetartifactv1-files artifact))]
    (conj (conj with-files (json/->JsonArrayEnd 0))
      (json/->JsonArrayEnd 0))))

(defn encode-artifact-envelope
  [artifact TargetArtifactV1] ArtifactEnvelopeResultV1
  (match (json/encode (artifact-envelope-events artifact))
    [(json/JsonEncodeError event-index message)
     (->ArtifactEnvelopeErrorV1 message)]
    [(json/JsonEncoded payload)
     (->ArtifactEnvelopeReadyV1 (content-digest payload) payload)]))

(defn json-array-start? [event json/JsonEvent] Bool
  (match event
    [(json/JsonArrayStart offset) true]
    [(json/JsonObjectStart offset) false]
    [(json/JsonObjectEnd offset) false]
    [(json/JsonArrayEnd offset) false]
    [(json/JsonKey offset value) false]
    [(json/JsonString offset value) false]
    [(json/JsonNumber offset lexeme) false]
    [(json/JsonBoolean offset value) false]
    [(json/JsonNull offset) false]))

(defn json-array-end? [event json/JsonEvent] Bool
  (match event
    [(json/JsonArrayStart offset) false]
    [(json/JsonObjectStart offset) false]
    [(json/JsonObjectEnd offset) false]
    [(json/JsonArrayEnd offset) true]
    [(json/JsonKey offset value) false]
    [(json/JsonString offset value) false]
    [(json/JsonNumber offset lexeme) false]
    [(json/JsonBoolean offset value) false]
    [(json/JsonNull offset) false]))

(defn json-string-value [event json/JsonEvent] String?
  (match event
    [(json/JsonArrayStart offset) nil]
    [(json/JsonObjectStart offset) nil]
    [(json/JsonObjectEnd offset) nil]
    [(json/JsonArrayEnd offset) nil]
    [(json/JsonKey offset value) nil]
    [(json/JsonString offset value) value]
    [(json/JsonNumber offset lexeme) nil]
    [(json/JsonBoolean offset value) nil]
    [(json/JsonNull offset) nil]))

(defn json-integer-value [event json/JsonEvent] Int?
  (match event
    [(json/JsonArrayStart offset) nil]
    [(json/JsonObjectStart offset) nil]
    [(json/JsonObjectEnd offset) nil]
    [(json/JsonArrayEnd offset) nil]
    [(json/JsonKey offset value) nil]
    [(json/JsonString offset value) nil]
    [(json/JsonNumber offset lexeme) (parse-long lexeme)]
    [(json/JsonBoolean offset value) nil]
    [(json/JsonNull offset) nil]))

(defn decode-artifact-files
  [events (Vec json/JsonEvent)
   start Int] ArtifactFilesDecodeResultV1
  (loop [index Int start files (Vec ArtifactFileV1) []]
    (if (>= index (count events))
      (->ArtifactFilesDecodeErrorV1 "artifact envelope has no files terminator")
      (if (json-array-end? (nth events index))
        (->ArtifactFilesDecodedV1 files (+ index 1))
        (if (or (> (+ index 6) (- (count events) 1))
                (not (json-array-start? (nth events index)))
                (not (json-array-end? (nth events (+ index 6)))))
          (->ArtifactFilesDecodeErrorV1 "artifact envelope contains a malformed file")
          (let [name String? (json-string-value (nth events (+ index 1)))
                payload String? (json-string-value (nth events (+ index 2)))
                content-id String? (json-string-value (nth events (+ index 3)))
                payload-byte-count Int? (json-integer-value (nth events (+ index 4)))
                payload-sha256 String? (json-string-value (nth events (+ index 5)))]
            (if (or (nil? name)
                    (or (nil? payload)
                        (or (nil? content-id)
                            (or (nil? payload-byte-count)
                                (nil? payload-sha256)))))
              (->ArtifactFilesDecodeErrorV1
                "artifact envelope file fields have invalid types")
              (let [file ArtifactFileV1
                    (->ArtifactFileV1 name payload content-id
                      payload-byte-count payload-sha256)]
                (if (not (artifact-file-valid? file))
                  (->ArtifactFilesDecodeErrorV1
                    "artifact envelope file metadata is not canonical")
                  (recur (+ index 7) (conj files file)))))))))))

(defn decode-artifact-envelope-events
  [events (Vec json/JsonEvent)] ArtifactEnvelopeDecodeResultV1
  (if (or (< (count events) 8)
          (or (not (json-array-start? (nth events 0)))
              (not (json-array-start? (nth events 5)))))
    (->ArtifactEnvelopeDecodeErrorV1 "artifact envelope shape is invalid")
    (let [version String? (json-string-value (nth events 1))
          target String? (json-string-value (nth events 2))
          encoding String? (json-string-value (nth events 3))
          digest String? (json-string-value (nth events 4))]
      (if (or (not= version "beagle-target-artifact-v1")
              (or (nil? target) (or (nil? encoding) (nil? digest))))
        (->ArtifactEnvelopeDecodeErrorV1
          "artifact envelope header is invalid")
        (match (decode-artifact-files events 6)
          [(ArtifactFilesDecodeErrorV1 detail)
           (->ArtifactEnvelopeDecodeErrorV1 detail)]
          [(ArtifactFilesDecodedV1 files next-index)
           (let [after-files Int next-index]
             (if (or (not= (+ after-files 1) (count events))
                     (not (json-array-end? (nth events after-files))))
               (->ArtifactEnvelopeDecodeErrorV1
                 "artifact envelope contains trailing events")
               (let [artifact TargetArtifactV1
                     (->TargetArtifactV1 target files encoding digest)]
                 (if (artifact-valid? artifact)
                   (->ArtifactEnvelopeDecodedV1 artifact)
                   (->ArtifactEnvelopeDecodeErrorV1
                     "artifact envelope target or digest is invalid")))))])))))

(defn decode-artifact-envelope
  [claimed-content-id String
   payload String] ArtifactEnvelopeDecodeResultV1
  (if (not= claimed-content-id (content-digest payload))
    (->ArtifactEnvelopeDecodeErrorV1
      "artifact envelope content ID does not match its exact bytes")
    (match (json/decode payload)
      [(json/JsonDecodeError offset message)
       (->ArtifactEnvelopeDecodeErrorV1 message)]
      [(json/JsonDecoded events)
       (decode-artifact-envelope-events events)])))

(defn string-suffix?
  [value String
   suffix String] Bool
  (and (>= (count value) (count suffix))
       (= suffix
          (subs value (- (count value) (count suffix)) (count value)))))

(defn safe-leaf-name? [name String] Bool
  (and (> (count name) 0)
       (not= name ".")
       (not= name "..")
       (loop [index Int 0]
         (if (>= index (count name))
           true
           (let [character String (subs name index (+ index 1))]
             (if (or (= character "/") (= character "\\"))
               false
               (recur (+ index 1))))))))

(defn artifact-path
  [config ArtifactLinkConfigV1
   name String] String
  (str (artifactlinkconfigv1-artifact-directory config) "/" name))

(defn artifact-file-valid? [file ArtifactFileV1] Bool
  (let [payload String (artifactfilev1-payload file)
        digest String (content-digest payload)]
    (and (safe-leaf-name? (artifactfilev1-name file))
         (= (artifactfilev1-payload-byte-count file)
            (count (utf8-encode payload)))
         (= digest (artifactfilev1-content-id file))
         (= digest (artifactfilev1-payload-sha256 file)))))

(defn artifact-valid? [artifact TargetArtifactV1] Bool
  (and (or (= (targetartifactv1-target artifact) "c17")
           (= (targetartifactv1-target artifact) "qbe"))
       (= (targetartifactv1-digest artifact)
          (content-digest (targetartifactv1-encoding artifact)))))

(defn write-artifact-files
  [config ArtifactLinkConfigV1
   files (Vec ArtifactFileV1)] ArtifactWriteResult
  (loop [index Int 0
         c-sources (Vec String) []
         qbe-sources (Vec String) []]
    (if (>= index (count files))
      (->ArtifactFilesWritten c-sources qbe-sources)
      (let [file ArtifactFileV1 (nth files index)
            name String (artifactfilev1-name file)]
        (if (not (artifact-file-valid? file))
          (->ArtifactFileWriteError
            65
            (str "invalid artifact file metadata: " name))
          (let [path String (artifact-path config name)]
            (match (host.fs/make-parent-directories path)
              [(host.fs/MakeParentDirectoriesError errno)
               (->ArtifactFileWriteError
                 errno (str "artifact parent creation failed: " path))]
              [(host.fs/MakeParentDirectoriesOk)
               (match (host.fs/write-text-atomic
                        path (artifactfilev1-payload file))
                 [(host.fs/WriteTextAtomicError errno)
                  (->ArtifactFileWriteError
                    errno (str "artifact write failed: " path))]
                 [(host.fs/WriteTextAtomicOk)
                  (recur
                    (+ index 1)
                    (if (string-suffix? name ".c")
                      (conj c-sources path)
                      c-sources)
                    (if (string-suffix? name ".ssa")
                      (conj qbe-sources path)
                      qbe-sources))])])))))))

(defn assembly-path [source-path String] String
  (str (subs source-path 0 (- (count source-path) 4)) ".s"))

(defn qbe-assembly-inputs
  [config ArtifactLinkConfigV1
   qbe-sources (Vec String)] ToolInputsResult
  (loop [index Int 0
         assembly-paths (Vec String) []]
    (if (>= index (count qbe-sources))
      (->ToolInputsReady assembly-paths)
      (let [source-path String (nth qbe-sources index)
            output-path String (assembly-path source-path)
            status Int (host.process/run-inherit
              [(artifactlinkconfigv1-qbe-compiler config)
               "-o"
               output-path
               source-path])]
        (if (= status 0)
          (recur (+ index 1) (conj assembly-paths output-path))
          (->ToolInputsError
            status (str "QBE compiler failed for " source-path)))))))

(defn compiler-argv
  [compiler String
   sources (Vec String)
   executable-path String] (Vec String)
  (loop [index Int 0
         argv (Vec String) [compiler]]
    (if (>= index (count sources))
      (conj (conj argv "-o") executable-path)
      (recur (+ index 1) (conj argv (nth sources index))))))

(defn verify-executable [path String] ArtifactLinkResultV1
  (match (host.fs/path-kind path)
    [(host.fs/PathKindError errno)
     (->ArtifactLinkErrorV1 errno (str "linked output is absent: " path))]
    [(host.fs/PathKindOk kind)
     (if (= kind 1)
       (->ArtifactLinkedV1 path)
       (->ArtifactLinkErrorV1 74 (str "linked output is not a file: " path)))]))

(defn run-c-compiler
  [config ArtifactLinkConfigV1
   sources (Vec String)] ArtifactLinkResultV1
  (if (empty? sources)
    (->ArtifactLinkErrorV1 65 "artifact contains no compiler input")
    (let [executable-path String (artifactlinkconfigv1-executable-path config)]
      (match (host.fs/make-parent-directories executable-path)
        [(host.fs/MakeParentDirectoriesError errno)
         (->ArtifactLinkErrorV1
           errno (str "output parent creation failed: " executable-path))]
        [(host.fs/MakeParentDirectoriesOk)
         (let [status Int (host.process/run-inherit
                 (compiler-argv
                   (artifactlinkconfigv1-c-compiler config)
                   sources
                   executable-path))]
           (if (= status 0)
             (verify-executable executable-path)
             (->ArtifactLinkErrorV1 status "C compiler/linker failed")))]))))

(defn link-written-artifact
  [config ArtifactLinkConfigV1
   target String
   written ArtifactWriteResult] ArtifactLinkResultV1
  (match written
    [(ArtifactFileWriteError code detail)
     (->ArtifactLinkErrorV1 code detail)]
    [(ArtifactFilesWritten c-sources qbe-sources)
     (if (= target "c17")
       (run-c-compiler config c-sources)
       (match (qbe-assembly-inputs config qbe-sources)
         [(ToolInputsError code detail)
          (->ArtifactLinkErrorV1 code detail)]
         [(ToolInputsReady paths)
          (run-c-compiler config paths)]))]))

(defn write-and-link
  [config ArtifactLinkConfigV1
   artifact TargetArtifactV1] ArtifactLinkResultV1
  (cond
    (or (= (artifactlinkconfigv1-artifact-directory config) "")
        (= (artifactlinkconfigv1-executable-path config) "")
        (= (artifactlinkconfigv1-c-compiler config) ""))
    (->ArtifactLinkErrorV1 64 "artifact link configuration is incomplete")

    (and (= (targetartifactv1-target artifact) "qbe")
         (= (artifactlinkconfigv1-qbe-compiler config) ""))
    (->ArtifactLinkErrorV1 64 "QBE compiler path is required")

    (not (artifact-valid? artifact))
    (->ArtifactLinkErrorV1 65 "artifact target or digest is invalid")

    :else
    (link-written-artifact
      config
      (targetartifactv1-target artifact)
      (write-artifact-files config (targetartifactv1-files artifact)))))
