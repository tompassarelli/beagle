#lang beagle
(ns beagle.artifact-linker)

(defrecord ArtifactFileV1
  [name String
   payload String
   content-id String
   payload-byte-count Int
   payload-sha256 String])

(defrecord TargetArtifactV1
  [target String
   files (Vec ArtifactFileV1)
   encoding String
   digest String])

(defrecord ValidatedTargetArtifactV1
  [artifact TargetArtifactV1])

(defrecord ArtifactLinkConfigV1
  [artifact-directory String
   executable-path String
   c-compiler String
   qbe-compiler String])

(defunion ArtifactLinkResultV1
  (ArtifactLinkedV1 [executable-path String])
  (ArtifactLinkErrorV1
    [code Int
     detail String]))

(defunion ArtifactWriteResult
  (ArtifactFilesWritten
    [c-sources (Vec String)
     qbe-sources (Vec String)])
  (ArtifactFileWriteError
    [code Int
     detail String]))

(defunion ToolInputsResult
  (ToolInputsReady [paths (Vec String)])
  (ToolInputsError
    [code Int
     detail String]))

(defunion ArtifactEnvelopeResultV1
  (ArtifactEnvelopeReadyV1
    [content-id String
     payload String])
  (ArtifactEnvelopeErrorV1 [detail String]))

(defunion ArtifactEnvelopeDecodeResultV1
  (ArtifactEnvelopeDecodedV1 [artifact ValidatedTargetArtifactV1])
  (ArtifactEnvelopeDecodeErrorV1 [detail String]))

(defunion ArtifactEnvelopePartV1
  (ArtifactEnvelopePartReadyV1
    [value String
     next-index Int])
  (ArtifactEnvelopePartErrorV1 [detail String]))

(defunion ArtifactEnvelopePartsV1
  (ArtifactEnvelopePartsReadyV1
    [values (Vec String)
     next-index Int])
  (ArtifactEnvelopePartsErrorV1 [detail String]))

(defunion ArtifactFilesDecodeResultV1
  (ArtifactFilesDecodedV1
    [files (Vec ArtifactFileV1)
     next-index Int])
  (ArtifactFilesDecodeErrorV1 [detail String]))

(defn content-digest [text String] String
  (str "sha256:" (sha256-bytes (utf8-encode text))))

(defn encode-envelope-part [value String] String
  (str (count (utf8-encode value)) ":" value))

(defn encode-artifact-file-envelope [file ArtifactFileV1] String
  (str (encode-envelope-part (artifactfilev1-name file))
       (encode-envelope-part (artifactfilev1-payload file))
       (encode-envelope-part (artifactfilev1-content-id file))
       (encode-envelope-part (str (artifactfilev1-payload-byte-count file)))
       (encode-envelope-part (artifactfilev1-payload-sha256 file))))

(defn artifact-envelope-payload [artifact TargetArtifactV1] String
  (reduce
    (fn [payload String file ArtifactFileV1] String
      (str payload (encode-artifact-file-envelope file)))
    (str (encode-envelope-part "beagle-target-artifact-v1")
         (encode-envelope-part (targetartifactv1-target artifact))
         (encode-envelope-part (targetartifactv1-encoding artifact))
         (encode-envelope-part (targetartifactv1-digest artifact))
         (encode-envelope-part (str (count (targetartifactv1-files artifact)))))
    (targetartifactv1-files artifact)))

(defn encode-artifact-envelope
  [artifact TargetArtifactV1] ArtifactEnvelopeResultV1
  (if (not (artifact-valid? artifact))
    (->ArtifactEnvelopeErrorV1 "artifact target or digest is invalid")
    (let [payload String (artifact-envelope-payload artifact)]
      (->ArtifactEnvelopeReadyV1 (content-digest payload) payload))))

(defn decimal-byte? [byte Int] Bool
  (and (>= byte 48) (<= byte 57)))

(defn decode-envelope-part
  [bytes (Vec Int)
   start Int] ArtifactEnvelopePartV1
  (loop [index Int start length Int 0 digits Int 0]
    (if (>= index (count bytes))
      (->ArtifactEnvelopePartErrorV1
        "artifact envelope has an unterminated length")
      (let [byte Int (nth bytes index)]
        (cond
          (= byte 58)
          (if (= digits 0)
            (->ArtifactEnvelopePartErrorV1
              "artifact envelope length is empty")
            (let [payload-start Int (+ index 1)
                  payload-end Int (+ payload-start length)]
              (if (> payload-end (count bytes))
                (->ArtifactEnvelopePartErrorV1
                  "artifact envelope part exceeds its exact bytes")
                (let [part-bytes (Vec Int) (subvec bytes payload-start payload-end)
                      value String (utf8-decode part-bytes)]
                  (if (= part-bytes (utf8-encode value))
                    (->ArtifactEnvelopePartReadyV1 value payload-end)
                    (->ArtifactEnvelopePartErrorV1
                      "artifact envelope part is not canonical UTF-8"))))))

          (not (decimal-byte? byte))
          (->ArtifactEnvelopePartErrorV1
            "artifact envelope length contains a non-decimal byte")

          (> length (count bytes))
          (->ArtifactEnvelopePartErrorV1
            "artifact envelope length exceeds the payload bound")

          :else
          (recur (+ index 1) (+ (* length 10) (- byte 48)) (+ digits 1)))))))

(defn decode-envelope-parts
  [bytes (Vec Int)
   start Int
   part-count Int] ArtifactEnvelopePartsV1
  (loop [index Int start remaining Int part-count values (Vec String) []]
    (if (= remaining 0)
      (->ArtifactEnvelopePartsReadyV1 values index)
      (match (decode-envelope-part bytes index)
        [(ArtifactEnvelopePartErrorV1 detail)
         (->ArtifactEnvelopePartsErrorV1 detail)]
        [(ArtifactEnvelopePartReadyV1 value next-index)
         (recur next-index (- remaining 1) (conj values value))]))))

(defn decode-artifact-files
  [bytes (Vec Int)
   start Int
   file-count Int] ArtifactFilesDecodeResultV1
  (loop [index Int start remaining Int file-count files (Vec ArtifactFileV1) []]
    (if (= remaining 0)
      (->ArtifactFilesDecodedV1 files index)
      (match (decode-envelope-part bytes index)
        [(ArtifactEnvelopePartErrorV1 detail)
         (->ArtifactFilesDecodeErrorV1 detail)]
        [(ArtifactEnvelopePartReadyV1 name after-name)
         (match (decode-envelope-part bytes after-name)
           [(ArtifactEnvelopePartErrorV1 detail)
            (->ArtifactFilesDecodeErrorV1 detail)]
           [(ArtifactEnvelopePartReadyV1 file-payload after-payload)
            (match (decode-envelope-part bytes after-payload)
              [(ArtifactEnvelopePartErrorV1 detail)
               (->ArtifactFilesDecodeErrorV1 detail)]
              [(ArtifactEnvelopePartReadyV1 content-id after-content-id)
               (match (decode-envelope-part bytes after-content-id)
                 [(ArtifactEnvelopePartErrorV1 detail)
                  (->ArtifactFilesDecodeErrorV1 detail)]
                 [(ArtifactEnvelopePartReadyV1 byte-count-text after-byte-count)
                  (match (decode-envelope-part bytes after-byte-count)
                    [(ArtifactEnvelopePartErrorV1 detail)
                     (->ArtifactFilesDecodeErrorV1 detail)]
                    [(ArtifactEnvelopePartReadyV1 payload-sha256 next-index)
                     (let [byte-count Int? (parse-long byte-count-text)]
                       (if (nil? byte-count)
                         (->ArtifactFilesDecodeErrorV1
                           "artifact envelope file byte count is invalid")
                         (let [known-byte-count Int byte-count
                               file ArtifactFileV1
                               (->ArtifactFileV1 name file-payload content-id
                                 known-byte-count payload-sha256)]
                           (if (not (artifact-file-valid? file))
                             (->ArtifactFilesDecodeErrorV1
                               "artifact envelope file metadata is not canonical")
                             (recur next-index (- remaining 1)
                               (conj files file))))))])])])])]))))

(defn decode-artifact-envelope
  [claimed-content-id String
   payload String] ArtifactEnvelopeDecodeResultV1
  (if (not= claimed-content-id (content-digest payload))
    (->ArtifactEnvelopeDecodeErrorV1
      "artifact envelope content ID does not match its exact bytes")
    (let [bytes (Vec Int) (utf8-encode payload)]
      (match (decode-envelope-parts bytes 0 5)
        [(ArtifactEnvelopePartsErrorV1 detail)
         (->ArtifactEnvelopeDecodeErrorV1 detail)]
        [(ArtifactEnvelopePartsReadyV1 values after-header)
         (let [version String (nth values 0)
               target String (nth values 1)
               encoding String (nth values 2)
               digest String (nth values 3)
               file-count Int? (parse-long (nth values 4))]
           (cond
             (not= version "beagle-target-artifact-v1")
             (->ArtifactEnvelopeDecodeErrorV1
               "artifact envelope version is invalid")

             (or (nil? file-count) (< file-count 0))
             (->ArtifactEnvelopeDecodeErrorV1
               "artifact envelope file count is invalid")

             :else
             (let [known-file-count Int file-count]
               (match (decode-artifact-files bytes after-header known-file-count)
                 [(ArtifactFilesDecodeErrorV1 detail)
                  (->ArtifactEnvelopeDecodeErrorV1 detail)]
                 [(ArtifactFilesDecodedV1 files next-index)
                  (if (not= next-index (count bytes))
                    (->ArtifactEnvelopeDecodeErrorV1
                      "artifact envelope contains trailing bytes")
                    (let [artifact TargetArtifactV1
                          (->TargetArtifactV1 target files encoding digest)]
                      (if (artifact-valid? artifact)
                        (->ArtifactEnvelopeDecodedV1
                          (->ValidatedTargetArtifactV1 artifact))
                        (->ArtifactEnvelopeDecodeErrorV1
                          "artifact envelope target or digest is invalid"))))]))))]))))

(defn string-suffix?
  [value String
   suffix String] Bool
  (and (>= (count value) (count suffix))
       (= suffix
          (subs value (- (count value) (count suffix)) (count value)))))

(defn safe-leaf-name? [name String] Bool
  (and (> (count name) 0)
       (not= name ".")
       (not= name "..")
       (loop [index Int 0]
         (if (>= index (count name))
           true
           (let [character String (subs name index (+ index 1))]
             (if (or (= character "/") (= character "\\"))
               false
               (recur (+ index 1))))))))

(defn artifact-path
  [config ArtifactLinkConfigV1
   name String] String
  (str (artifactlinkconfigv1-artifact-directory config) "/" name))

(defn artifact-file-valid? [file ArtifactFileV1] Bool
  (let [payload String (artifactfilev1-payload file)
        digest String (content-digest payload)]
    (and (safe-leaf-name? (artifactfilev1-name file))
         (= (artifactfilev1-payload-byte-count file)
            (count (utf8-encode payload)))
         (= digest (artifactfilev1-content-id file))
         (= digest (artifactfilev1-payload-sha256 file)))))

(defn artifact-valid? [artifact TargetArtifactV1] Bool
  (and (or (= (targetartifactv1-target artifact) "c17")
           (= (targetartifactv1-target artifact) "qbe"))
       (= (targetartifactv1-digest artifact)
          (content-digest (targetartifactv1-encoding artifact)))))

(defn- write-artifact-files-with-validation
  [config ArtifactLinkConfigV1
   files (Vec ArtifactFileV1)
   validate-metadata Bool] ArtifactWriteResult
  (loop [index Int 0
         c-sources (Vec String) []
         qbe-sources (Vec String) []]
    (if (>= index (count files))
      (->ArtifactFilesWritten c-sources qbe-sources)
      (let [file ArtifactFileV1 (nth files index)
            name String (artifactfilev1-name file)]
        (if (and validate-metadata (not (artifact-file-valid? file)))
          (->ArtifactFileWriteError
            65
            (str "invalid artifact file metadata: " name))
          (let [path String (artifact-path config name)]
            (match (host.fs/make-parent-directories path)
              [(host.fs/MakeParentDirectoriesError errno)
               (->ArtifactFileWriteError
                 errno (str "artifact parent creation failed: " path))]
              [(host.fs/MakeParentDirectoriesOk)
               (match (host.fs/write-text-atomic
                        path (artifactfilev1-payload file))
                 [(host.fs/WriteTextAtomicError errno)
                  (->ArtifactFileWriteError
                    errno (str "artifact write failed: " path))]
                 [(host.fs/WriteTextAtomicOk)
                  (recur
                    (+ index 1)
                    (if (string-suffix? name ".c")
                      (conj c-sources path)
                      c-sources)
                    (if (string-suffix? name ".ssa")
                      (conj qbe-sources path)
                      qbe-sources))])])))))))

(defn write-artifact-files
  [config ArtifactLinkConfigV1
   files (Vec ArtifactFileV1)] ArtifactWriteResult
  (write-artifact-files-with-validation config files true))

(defn- write-validated-artifact-files
  [config ArtifactLinkConfigV1
   files (Vec ArtifactFileV1)] ArtifactWriteResult
  (write-artifact-files-with-validation config files false))

(defn assembly-path [source-path String] String
  (str (subs source-path 0 (- (count source-path) 4)) ".s"))

(defn qbe-assembly-inputs
  [config ArtifactLinkConfigV1
   qbe-sources (Vec String)] ToolInputsResult
  (loop [index Int 0
         assembly-paths (Vec String) []]
    (if (>= index (count qbe-sources))
      (->ToolInputsReady assembly-paths)
      (let [source-path String (nth qbe-sources index)
            output-path String (assembly-path source-path)
            status Int (host.process/run-inherit
              [(artifactlinkconfigv1-qbe-compiler config)
               "-o"
               output-path
               source-path])]
        (if (= status 0)
          (recur (+ index 1) (conj assembly-paths output-path))
          (->ToolInputsError
            status (str "QBE compiler failed for " source-path)))))))

(defn compiler-argv
  [compiler String
   sources (Vec String)
   executable-path String] (Vec String)
  (loop [index Int 0
         argv (Vec String) [compiler]]
    (if (>= index (count sources))
      (conj (conj argv "-o") executable-path)
      (recur (+ index 1) (conj argv (nth sources index))))))

(defn verify-executable [path String] ArtifactLinkResultV1
  (match (host.fs/path-kind path)
    [(host.fs/PathKindError errno)
     (->ArtifactLinkErrorV1 errno (str "linked output is absent: " path))]
    [(host.fs/PathKindOk kind)
     (if (= kind 1)
       (->ArtifactLinkedV1 path)
       (->ArtifactLinkErrorV1 74 (str "linked output is not a file: " path)))]))

(defn run-c-compiler
  [config ArtifactLinkConfigV1
   sources (Vec String)] ArtifactLinkResultV1
  (if (empty? sources)
    (->ArtifactLinkErrorV1 65 "artifact contains no compiler input")
    (let [executable-path String (artifactlinkconfigv1-executable-path config)]
      (match (host.fs/make-parent-directories executable-path)
        [(host.fs/MakeParentDirectoriesError errno)
         (->ArtifactLinkErrorV1
           errno (str "output parent creation failed: " executable-path))]
        [(host.fs/MakeParentDirectoriesOk)
         (let [status Int (host.process/run-inherit
                 (compiler-argv
                   (artifactlinkconfigv1-c-compiler config)
                   sources
                   executable-path))]
           (if (= status 0)
             (verify-executable executable-path)
             (->ArtifactLinkErrorV1 status "C compiler/linker failed")))]))))

(defn link-written-artifact
  [config ArtifactLinkConfigV1
   target String
   written ArtifactWriteResult] ArtifactLinkResultV1
  (match written
    [(ArtifactFileWriteError code detail)
     (->ArtifactLinkErrorV1 code detail)]
    [(ArtifactFilesWritten c-sources qbe-sources)
     (if (= target "c17")
       (run-c-compiler config c-sources)
       (match (qbe-assembly-inputs config qbe-sources)
         [(ToolInputsError code detail)
          (->ArtifactLinkErrorV1 code detail)]
         [(ToolInputsReady paths)
          (run-c-compiler config paths)]))]))

(defn- write-and-link-artifact
  [config ArtifactLinkConfigV1
   artifact TargetArtifactV1
   validate-files Bool] ArtifactLinkResultV1
  (cond
    (or (= (artifactlinkconfigv1-artifact-directory config) "")
        (= (artifactlinkconfigv1-executable-path config) "")
        (= (artifactlinkconfigv1-c-compiler config) ""))
    (->ArtifactLinkErrorV1 64 "artifact link configuration is incomplete")

    (and (= (targetartifactv1-target artifact) "qbe")
         (= (artifactlinkconfigv1-qbe-compiler config) ""))
    (->ArtifactLinkErrorV1 64 "QBE compiler path is required")

    (not (artifact-valid? artifact))
    (->ArtifactLinkErrorV1 65 "artifact target or digest is invalid")

    :else
    (link-written-artifact
      config
      (targetartifactv1-target artifact)
      (if validate-files
        (write-artifact-files config (targetartifactv1-files artifact))
        (write-validated-artifact-files
          config (targetartifactv1-files artifact))))))

(defn write-and-link
  [config ArtifactLinkConfigV1
   artifact TargetArtifactV1] ArtifactLinkResultV1
  (write-and-link-artifact config artifact true))

(defn write-validated-and-link
  [config ArtifactLinkConfigV1
   validated ValidatedTargetArtifactV1] ArtifactLinkResultV1
  (write-and-link-artifact
    config (validatedtargetartifactv1-artifact validated) false))
