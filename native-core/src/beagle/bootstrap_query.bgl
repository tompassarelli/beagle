#lang beagle
(ns beagle.bootstrap-query
  (:require [beagle.bootstrap-contract :as bootstrap]
            [beagle.fact-profile :as profile]
            [beagle.rule-scheduler :as scheduler]))

(defunion AdmittedQueryEvaluationV1
  (AdmittedQueryEvaluatedV1
    [query-digest String result scheduler/FixedPointResultV1])
  (AdmittedQueryRejectedV1 [code Keyword detail String]))

(defn query-relation-name [relation Keyword] String
  (cond
    (= relation :query/kind) "query/kind"
    (= relation :query/source) "query/source"
    (= relation :query/compiler) "query/compiler"
    (= relation :query/profile) "query/profile"
    (= relation :query/target) "query/target"
    (= relation :query/schema) "query/schema"
    (= relation :query/rules) "query/rules"
    :else ""))

(defn supported-query-fact? [fact profile/CompileQueryFact] Bool
  (not (= "" (query-relation-name
                (profile/compilequeryfact-relation fact)))))

(defn normalized-query-facts
  [facts (Vec profile/CompileQueryFact)] (Vec scheduler/RuleFactV1)
  (mapv
    (fn [fact profile/CompileQueryFact] scheduler/RuleFactV1
      (scheduler/->RuleFactV1
        (query-relation-name (profile/compilequeryfact-relation fact))
        (str (count (profile/compilequeryfact-subject fact)) ":"
             (profile/compilequeryfact-subject fact) ":"
             (profile/compilequeryfact-slot fact))
        (profile/compilequeryfact-value fact)))
    facts))

(defn default-admitted-query? [query profile/AdmittedQueryClosure] Bool
  (and (= bootstrap/default-compiler-context-id
          (profile/admittedqueryclosure-compiler-context query))
       (= bootstrap/default-profile
          (profile/admittedqueryclosure-profile query))
       (= [bootstrap/default-target-id]
          (profile/admittedqueryclosure-targets query))
       (= bootstrap/compiler-schema-content-id
          (profile/admittedqueryclosure-schema-content-id query))
       (= bootstrap/default-rule-set-content-id
          (profile/admittedqueryclosure-rules-content-id query))
       (every? supported-query-fact?
         (profile/admittedqueryclosure-facts query))))

(defn evaluate-admitted-query
  [query profile/AdmittedQueryClosure evaluate scheduler/RuleEvaluatorV1]
  AdmittedQueryEvaluationV1
  (match (profile/admit-canonical-query query)
    [(QueryRejected code detail)
     (->AdmittedQueryRejectedV1 code detail)]
    [(QueryAdmitted admitted)
     (let [canonical profile/AdmittedQueryClosure admitted]
       (if (not (default-admitted-query? canonical))
         (->AdmittedQueryRejectedV1 :bootstrap/query-mismatch
           "admitted query does not name the frozen compiler context, rule set, lp64 profile, and c17 target")
         (match
           (bootstrap/evaluate-normalized-bundle
             (normalized-query-facts
               (profile/admittedqueryclosure-facts canonical))
             (bootstrap/default-rule-bundle)
             evaluate)
           [(NativeBundleRejectedV1 code detail)
            (->AdmittedQueryRejectedV1 code detail)]
           [(NativeBundleEvaluatedV1 result)
            (->AdmittedQueryEvaluatedV1
              (profile/admittedqueryclosure-query-digest canonical)
              result)])))]))
