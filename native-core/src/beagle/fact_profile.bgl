#lang beagle
(ns beagle.fact-profile)

(defrecord CompileQueryFact
  [order Int
   relation Keyword
   subject String
   slot Int
   value String])

(defrecord QueryAdmissionRequest
  [source-closure-digest String
   compiler-context String
   profile String
   targets (Vec String)
   rules-content-id String
   schema-content-id String])

(defrecord AdmittedQueryClosure
  [query-digest String
   source-closure-digest String
   compiler-context String
   profile String
   targets (Vec String)
   rules-content-id String
   schema-content-id String
   facts (Vec CompileQueryFact)])

(defunion QueryAdmission
  (QueryAdmitted [closure AdmittedQueryClosure])
  (QueryRejected [code Keyword detail String]))

(defn content-id? [value String] Bool
  (some? (re-matches #"sha256:[0-9a-f]{64}" value)))

(defn supported-profile? [profile String] Bool
  (or (= profile "lp64") (= profile "wasm32")))

(defn query-part [value String] String
  (str (count value) ":" value))

(defn targets-encoding [targets (Vec String)] String
  (reduce
    (fn [encoding String target String] String
      (str encoding (query-part target)))
    ""
    targets))

(defn query-digest [request QueryAdmissionRequest targets (Vec String)] String
  (let [encoding String
        (str (query-part "compile")
             (query-part (queryadmissionrequest-source-closure-digest request))
             (query-part (queryadmissionrequest-compiler-context request))
             (query-part (queryadmissionrequest-profile request))
             (query-part (targets-encoding targets))
             (query-part (queryadmissionrequest-rules-content-id request))
             (query-part (queryadmissionrequest-schema-content-id request)))]
    (str "sha256:" (sha256-bytes (utf8-encode encoding)))))

(defn contains-string? [values (Vec String) value String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= value (nth values index))
        true
        (recur (+ index 1))))))

(defn insert-sorted [values (Vec String) value String] (Vec String)
  (loop [index Int 0 prefix (Vec String) []]
    (if (>= index (count values))
      (conj prefix value)
      (let [current String (nth values index)]
        (if (neg? (compare value current))
          (reduce conj (conj prefix value) (subvec values index))
          (recur (+ index 1) (conj prefix current)))))))

(defn sorted-unique-targets [targets (Vec String)] (Vec String)
  (reduce
    (fn [ordered (Vec String) target String] (Vec String)
      (insert-sorted ordered target))
    []
    targets))

(defn valid-targets? [targets (Vec String)] Bool
  (loop [index Int 0 seen (Vec String) []]
    (if (>= index (count targets))
      (not= 0 (count targets))
      (let [target String (nth targets index)]
        (if (or (= "" target) (contains-string? seen target))
          false
          (recur (+ index 1) (conj seen target)))))))

(defn canonical-query-facts
  [digest String request QueryAdmissionRequest targets (Vec String)]
  (Vec CompileQueryFact)
  (let [base (Vec CompileQueryFact)
        [(->CompileQueryFact 0 :query/kind digest 0 "compile")
         (->CompileQueryFact 1 :query/source digest 0
           (queryadmissionrequest-source-closure-digest request))
         (->CompileQueryFact 2 :query/compiler digest 0
           (queryadmissionrequest-compiler-context request))
         (->CompileQueryFact 3 :query/profile digest 0
           (queryadmissionrequest-profile request))]]
    (loop [position Int 0 facts (Vec CompileQueryFact) base]
      (if (>= position (count targets))
        (conj
          (conj facts
            (->CompileQueryFact (+ 4 position) :query/rules digest 0
              (queryadmissionrequest-rules-content-id request)))
          (->CompileQueryFact (+ 5 position) :query/schema digest 0
            (queryadmissionrequest-schema-content-id request)))
        (recur (+ position 1)
          (conj facts
            (->CompileQueryFact (+ 4 position) :query/target digest 0
              (nth targets position))))))))

(defn admit-and-identify-query [request QueryAdmissionRequest] QueryAdmission
  (let [targets (Vec String) (queryadmissionrequest-targets request)]
    (cond
      (not (content-id? (queryadmissionrequest-source-closure-digest request)))
      (->QueryRejected :query/invalid-source "source closure digest must be a lower-case sha256 content ID")
      (not (content-id? (queryadmissionrequest-compiler-context request)))
      (->QueryRejected :query/invalid-compiler "compiler context must be a lower-case sha256 content ID")
      (not (content-id? (queryadmissionrequest-rules-content-id request)))
      (->QueryRejected :query/invalid-rules "rules content ID must be a lower-case sha256 content ID")
      (not (content-id? (queryadmissionrequest-schema-content-id request)))
      (->QueryRejected :query/invalid-schema "schema content ID must be a lower-case sha256 content ID")
      (not (supported-profile? (queryadmissionrequest-profile request)))
      (->QueryRejected :query/unknown-profile "profile must be lp64 or wasm32")
      (not (valid-targets? targets))
      (->QueryRejected :query/invalid-targets "targets must be non-empty, non-empty strings with no duplicates")
      :else
      (let [ordered (Vec String) (sorted-unique-targets targets)
            digest String (query-digest request ordered)]
        (->QueryAdmitted
          (->AdmittedQueryClosure digest
            (queryadmissionrequest-source-closure-digest request)
            (queryadmissionrequest-compiler-context request)
            (queryadmissionrequest-profile request)
            ordered
            (queryadmissionrequest-rules-content-id request)
            (queryadmissionrequest-schema-content-id request)
            (canonical-query-facts digest request ordered)))))))

(defn admit-canonical-query [closure AdmittedQueryClosure] QueryAdmission
  (let [request QueryAdmissionRequest
        (->QueryAdmissionRequest
          (admittedqueryclosure-source-closure-digest closure)
          (admittedqueryclosure-compiler-context closure)
          (admittedqueryclosure-profile closure)
          (admittedqueryclosure-targets closure)
          (admittedqueryclosure-rules-content-id closure)
          (admittedqueryclosure-schema-content-id closure))]
    (match (admit-and-identify-query request)
      [(QueryRejected code detail) (->QueryRejected code detail)]
      [(QueryAdmitted admitted)
       (if (and (= (admittedqueryclosure-query-digest closure)
                   (admittedqueryclosure-query-digest admitted))
                (= (admittedqueryclosure-targets closure)
                   (admittedqueryclosure-targets admitted))
                (= (admittedqueryclosure-facts closure)
                   (admittedqueryclosure-facts admitted)))
         (->QueryAdmitted admitted)
         (->QueryRejected :query/canonical-mismatch
           "canonical query closure does not match its admitted dimensions"))])))

(defrecord ResultAdmissionRequest
  [query AdmittedQueryClosure
   target String
   materializer-content-id String
   status String
   artifact-content-id String?
   diagnostic-content-id String?])

(defrecord AdmittedResultClosure
  [result-digest String
   query AdmittedQueryClosure
   target String
   materializer-content-id String
   status String
   artifact-content-id String?
   diagnostic-content-id String?
   facts (Vec CompileQueryFact)])

(defunion ResultAdmission
  (ResultAdmitted [closure AdmittedResultClosure])
  (ResultRejected [code Keyword detail String]))

(defn result-digest [request ResultAdmissionRequest] String
  (let [artifact String (or (resultadmissionrequest-artifact-content-id request) "")
        diagnostic String (or (resultadmissionrequest-diagnostic-content-id request) "")
        encoding String
        (str (query-part "result")
             (query-part (admittedqueryclosure-query-digest
                           (resultadmissionrequest-query request)))
             (query-part (resultadmissionrequest-target request))
             (query-part (resultadmissionrequest-materializer-content-id request))
             (query-part (resultadmissionrequest-status request))
             (query-part artifact)
             (query-part diagnostic))]
    (str "sha256:" (sha256-bytes (utf8-encode encoding)))))

(defn canonical-result-facts
  [digest String request ResultAdmissionRequest] (Vec CompileQueryFact)
  (let [query-digest String
        (admittedqueryclosure-query-digest (resultadmissionrequest-query request))
        base (Vec CompileQueryFact)
        [(->CompileQueryFact 0 :result/query digest 0 query-digest)
         (->CompileQueryFact 1 :result/target digest 0
           (resultadmissionrequest-target request))
         (->CompileQueryFact 2 :result/materializer digest 0
           (resultadmissionrequest-materializer-content-id request))
         (->CompileQueryFact 3 :result/status digest 0
           (resultadmissionrequest-status request))]]
    (if (= "ok" (resultadmissionrequest-status request))
      (conj base (->CompileQueryFact 4 :result/artifact digest 0
                   (or (resultadmissionrequest-artifact-content-id request) "")))
      (conj base (->CompileQueryFact 4 :result/diagnostic digest 0
                   (or (resultadmissionrequest-diagnostic-content-id request) ""))))))

(defn admit-and-identify-result [request ResultAdmissionRequest] ResultAdmission
  (match (admit-canonical-query (resultadmissionrequest-query request))
    [(QueryRejected code detail) (->ResultRejected code detail)]
    [(QueryAdmitted query)
     (let [status String (resultadmissionrequest-status request)
           artifact String? (resultadmissionrequest-artifact-content-id request)
           diagnostic String? (resultadmissionrequest-diagnostic-content-id request)]
       (cond
         (not (contains-string? (admittedqueryclosure-targets query)
                                (resultadmissionrequest-target request)))
         (->ResultRejected :result/unknown-target "result target is not admitted by its query")
         (not (content-id? (resultadmissionrequest-materializer-content-id request)))
         (->ResultRejected :result/invalid-materializer "materializer must be a lower-case sha256 content ID")
         (not (or (= status "ok") (= status "rejected")))
         (->ResultRejected :result/invalid-status "result status must be ok or rejected")
         (and (= status "ok")
              (or (nil? artifact) (some? diagnostic) (not (content-id? artifact))))
         (->ResultRejected :result/invalid-artifact "ok results require exactly one artifact content ID")
         (and (= status "rejected")
              (or (some? artifact) (nil? diagnostic) (not (content-id? diagnostic))))
         (->ResultRejected :result/invalid-diagnostic "rejected results require exactly one diagnostic content ID")
         :else
         (let [normalized ResultAdmissionRequest
               (->ResultAdmissionRequest query
                            (resultadmissionrequest-target request)
                            (resultadmissionrequest-materializer-content-id request)
                            status artifact diagnostic)
               (digest String) (result-digest normalized)]
           (->ResultAdmitted
             (->AdmittedResultClosure digest query
               (resultadmissionrequest-target normalized)
               (resultadmissionrequest-materializer-content-id normalized)
               status artifact diagnostic
               (canonical-result-facts digest normalized))))))]))

(defn admit-canonical-result [closure AdmittedResultClosure] ResultAdmission
  (let [request ResultAdmissionRequest
        (->ResultAdmissionRequest
          (admittedresultclosure-query closure)
          (admittedresultclosure-target closure)
          (admittedresultclosure-materializer-content-id closure)
          (admittedresultclosure-status closure)
          (admittedresultclosure-artifact-content-id closure)
          (admittedresultclosure-diagnostic-content-id closure))]
    (match (admit-and-identify-result request)
      [(ResultRejected code detail) (->ResultRejected code detail)]
      [(ResultAdmitted admitted)
       (if (and (= (admittedresultclosure-result-digest closure)
                   (admittedresultclosure-result-digest admitted))
                (= (admittedresultclosure-facts closure)
                   (admittedresultclosure-facts admitted)))
         (->ResultAdmitted admitted)
         (->ResultRejected :result/canonical-mismatch
           "canonical result closure does not match its admitted dimensions"))])))
