#lang beagle

(ns beagle.semantic-identity)

(defrecord Digest256 [octets (Vec Int)])

(defrecord ByteContentId [digest Digest256])

(defrecord IdentityProblem
  [code Keyword
   message String
   evidence (Vec String)])

(defunion IdentityDomain
  ByteContentDomain
  ContentReferenceDomain
  NominalSymbolDomain
  StoreSnapshotDomain
  WorldRevisionDomain
  StoreReferenceDomain
  SortContractDomain
  ShapeContractDomain
  RelationContractDomain
  ModeContractDomain
  StrategyContractDomain
  TermNodeDomain
  EqualityGoalDomain
  RelationGoalDomain
  ClauseContentDomain
  TheoryContentDomain
  OperationalCatalogDomain
  CheckedTheoryAuditDomain
  GoalContentDomain
  CheckedRequestDomain
  EvaluationStepDomain
  OrientedPlanDomain
  RuntimeTermDomain
  AnswerContentDomain
  ProofContentDomain
  ProofOccurrenceDomain
  DeterminismCertificationDomain
  EpistemicFactDomain
  WorldSealDomain
  StoreOccurrenceDomain)

(defunion MerkleField
  (BytesField
    [tag Int
     value (Vec Int)])
  (Utf8Field
    [tag Int
     value String])
  (NaturalField
    [tag Int
     value Int])
  (SignedField
    [tag Int
     value Int])
  (DigestField
    [tag Int
     value Digest256])
  (OrderedDigestsField
    [tag Int
     values (Vec Digest256)])
  (SetDigestsField
    [tag Int
     values (Vec Digest256)]))

(defunion EncodingResult
  (EncodingAccepted [bytes (Vec Int)])
  (EncodingRejected [problem IdentityProblem]))

(defunion DigestAdmission
  (DigestAccepted [digest Digest256])
  (DigestRejected [problem IdentityProblem]))

(defunion ByteContentAdmission
  (ByteContentAccepted [identity ByteContentId])
  (ByteContentRejected [problem IdentityProblem]))

(defunion MerkleOutcome
  (MerkleHashed
    [digest Digest256
     canonical-bytes (Vec Int)])
  (MerkleRejected [problem IdentityProblem]))

(defrecord MerkleResult [outcome MerkleOutcome])

(defn identity-problem
  [code Keyword
   message String
   evidence (Vec String)] IdentityProblem
  (->IdentityProblem code message evidence))

(defn identity-domain-tag [domain IdentityDomain] Int
  (match domain
    [(ByteContentDomain) 1]
    [(ContentReferenceDomain) 2]
    [(NominalSymbolDomain) 3]
    [(StoreSnapshotDomain) 4]
    [(WorldRevisionDomain) 5]
    [(StoreReferenceDomain) 6]
    [(SortContractDomain) 7]
    [(ShapeContractDomain) 8]
    [(RelationContractDomain) 9]
    [(ModeContractDomain) 10]
    [(StrategyContractDomain) 11]
    [(TermNodeDomain) 12]
    [(EqualityGoalDomain) 13]
    [(RelationGoalDomain) 14]
    [(ClauseContentDomain) 15]
    [(TheoryContentDomain) 16]
    [(OperationalCatalogDomain) 17]
    [(CheckedTheoryAuditDomain) 18]
    [(GoalContentDomain) 19]
    [(CheckedRequestDomain) 20]
    [(EvaluationStepDomain) 21]
    [(OrientedPlanDomain) 22]
    [(RuntimeTermDomain) 23]
    [(AnswerContentDomain) 24]
    [(ProofContentDomain) 25]
    [(ProofOccurrenceDomain) 26]
    [(DeterminismCertificationDomain) 27]
    [(EpistemicFactDomain) 28]
    [(WorldSealDomain) 29]
    [(StoreOccurrenceDomain) 30]))

(defn byte-content-domain [] IdentityDomain (->ByteContentDomain))
(defn content-reference-domain [] IdentityDomain (->ContentReferenceDomain))
(defn nominal-symbol-domain [] IdentityDomain (->NominalSymbolDomain))
(defn store-snapshot-domain [] IdentityDomain (->StoreSnapshotDomain))
(defn world-revision-domain [] IdentityDomain (->WorldRevisionDomain))
(defn store-reference-domain [] IdentityDomain (->StoreReferenceDomain))
(defn sort-contract-domain [] IdentityDomain (->SortContractDomain))
(defn shape-contract-domain [] IdentityDomain (->ShapeContractDomain))
(defn relation-contract-domain [] IdentityDomain (->RelationContractDomain))
(defn mode-contract-domain [] IdentityDomain (->ModeContractDomain))
(defn strategy-contract-domain [] IdentityDomain (->StrategyContractDomain))
(defn term-node-domain [] IdentityDomain (->TermNodeDomain))
(defn equality-goal-domain [] IdentityDomain (->EqualityGoalDomain))
(defn relation-goal-domain [] IdentityDomain (->RelationGoalDomain))
(defn clause-content-domain [] IdentityDomain (->ClauseContentDomain))
(defn theory-content-domain [] IdentityDomain (->TheoryContentDomain))
(defn operational-catalog-domain [] IdentityDomain (->OperationalCatalogDomain))
(defn checked-theory-audit-domain [] IdentityDomain (->CheckedTheoryAuditDomain))
(defn goal-content-domain [] IdentityDomain (->GoalContentDomain))
(defn checked-request-domain [] IdentityDomain (->CheckedRequestDomain))
(defn evaluation-step-domain [] IdentityDomain (->EvaluationStepDomain))
(defn oriented-plan-domain [] IdentityDomain (->OrientedPlanDomain))
(defn runtime-term-domain [] IdentityDomain (->RuntimeTermDomain))
(defn answer-content-domain [] IdentityDomain (->AnswerContentDomain))
(defn proof-content-domain [] IdentityDomain (->ProofContentDomain))
(defn proof-occurrence-domain [] IdentityDomain (->ProofOccurrenceDomain))
(defn determinism-certification-domain [] IdentityDomain
  (->DeterminismCertificationDomain))
(defn epistemic-fact-domain [] IdentityDomain (->EpistemicFactDomain))
(defn world-seal-domain [] IdentityDomain (->WorldSealDomain))
(defn store-occurrence-domain [] IdentityDomain (->StoreOccurrenceDomain))

(defn valid-octet? [value Int] Bool
  (and (>= value 0) (<= value 255)))

(defn valid-octets? [values (Vec Int)] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      true
      (if (valid-octet? (nth values index))
        (recur (+ index 1))
        false))))

(defn digest-valid? [digest Digest256] Bool
  (let [octets (Vec Int) (digest256-octets digest)]
    (and (= 32 (count octets)) (valid-octets? octets))))

(defn admit-digest [octets (Vec Int)] DigestAdmission
  (cond
    [(not (= 32 (count octets)))
     (->DigestRejected
       (identity-problem
         :identity/digest-length
         "SHA-256 identity requires exactly 32 octets"
         [(str (count octets))]))]
    [(not (valid-octets? octets))
     (->DigestRejected
       (identity-problem
         :identity/invalid-octet
         "identity octets must be integers from zero through 255"
         []))]
    [:else (->DigestAccepted (->Digest256 octets))]))

(defn digest=
  [left Digest256
   right Digest256] Bool
  (= (digest256-octets left) (digest256-octets right)))

(defn octets-compare
  [left (Vec Int)
   right (Vec Int)] Int
  (loop [index Int 0]
    (cond
      [(and (>= index (count left)) (>= index (count right))) 0]
      [(>= index (count left)) -1]
      [(>= index (count right)) 1]
      [(< (nth left index) (nth right index)) -1]
      [(> (nth left index) (nth right index)) 1]
      [:else (recur (+ index 1))])))

(defn digest-compare
  [left Digest256
   right Digest256] Int
  (octets-compare (digest256-octets left) (digest256-octets right)))

(defn merge-digest-runs
  [values (Vec Digest256)
   left Int
   middle Int
   right Int] (Vec Digest256)
  (loop [left-index Int left
         right-index Int middle
         result (Vec Digest256) []]
    (cond
      [(and (>= left-index middle) (>= right-index right)) result]
      [(>= left-index middle)
       (recur left-index (+ right-index 1)
         (conj result (nth values right-index)))]
      [(>= right-index right)
       (recur (+ left-index 1) right-index
         (conj result (nth values left-index)))]
      [(<= (digest-compare
             (nth values left-index)
             (nth values right-index))
           0)
       (recur (+ left-index 1) right-index
         (conj result (nth values left-index)))]
      [:else
       (recur left-index (+ right-index 1)
         (conj result (nth values right-index)))])))

(defn merge-digest-pass
  [values (Vec Digest256)
   width Int] (Vec Digest256)
  (loop [start Int 0
         result (Vec Digest256) []]
    (if (>= start (count values))
      result
      (let [middle Int (min (+ start width) (count values))
            right Int (min (+ start (* width 2)) (count values))]
        (recur right
          (into result
            (merge-digest-runs values start middle right)))))))

(defn sort-digests [values (Vec Digest256)] (Vec Digest256)
  (loop [width Int 1
         result (Vec Digest256) values]
    (if (>= width (count result))
      result
      (recur (* width 2) (merge-digest-pass result width)))))

(defn adjacent-duplicate-digest? [sorted (Vec Digest256)] Bool
  (loop [index Int 1]
    (if (>= index (count sorted))
      false
      (if (digest= (nth sorted (- index 1)) (nth sorted index))
        true
        (recur (+ index 1))))))

(defn unsigned-in-range?
  [value Int
   maximum Int] Bool
  (and (>= value 0) (<= value maximum)))

(defn encode-fixed-unsigned
  [value Int
   width Int] (Vec Int)
  (loop [position Int 0
         result (Vec Int) []]
    (if (>= position width)
      result
      (let [shift Int (* (- (- width position) 1) 8)]
        (recur (+ position 1)
          (conj result
            (bit-and 255 (unsigned-bit-shift-right value shift))))))))

(defn encode-natural [value Int] (Vec Int)
  (encode-fixed-unsigned value 8))

(defn encode-signed [value Int] (Vec Int)
  (encode-fixed-unsigned value 8))

(defn hex-nibble [octet Int] Int?
  (cond
    [(and (>= octet 48) (<= octet 57)) (- octet 48)]
    [(and (>= octet 97) (<= octet 102)) (+ 10 (- octet 97))]
    [:else nil]))

(defn digest-from-hex [hex String] DigestAdmission
  (let [source (Vec Int) (utf8-encode hex)]
    (if (not (= 64 (count source)))
      (->DigestRejected
        (identity-problem
          :identity/malformed-sha256-result
          "SHA-256 implementation returned a noncanonical digest"
          [(str (count source))]))
      (loop [index Int 0
             result (Vec Int) []]
        (if (>= index (count source))
          (admit-digest result)
          (let [high Int? (hex-nibble (nth source index))
                low Int? (hex-nibble (nth source (+ index 1)))]
            (if (nil? high)
              (->DigestRejected
                (identity-problem
                  :identity/malformed-sha256-result
                  "SHA-256 implementation returned a non-hexadecimal digest"
                  [(str index)]))
              (if (nil? low)
                (->DigestRejected
                  (identity-problem
                    :identity/malformed-sha256-result
                    "SHA-256 implementation returned a non-hexadecimal digest"
                    [(str (+ index 1))]))
                (recur (+ index 2) (conj result (+ (* high 16) low)))))))))))

(defn field-tag [field MerkleField] Int
  (match field
    [(BytesField tag value) tag]
    [(Utf8Field tag value) tag]
    [(NaturalField tag value) tag]
    [(SignedField tag value) tag]
    [(DigestField tag value) tag]
    [(OrderedDigestsField tag values) tag]
    [(SetDigestsField tag values) tag]))

(defn field-kind [field MerkleField] Int
  (match field
    [(BytesField tag value) 1]
    [(Utf8Field tag value) 2]
    [(NaturalField tag value) 3]
    [(SignedField tag value) 4]
    [(DigestField tag value) 5]
    [(OrderedDigestsField tag values) 6]
    [(SetDigestsField tag values) 7]))

(defn digest-vector-valid? [values (Vec Digest256)] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      true
      (if (digest-valid? (nth values index))
        (recur (+ index 1))
        false))))

(defn encode-digest-vector [values (Vec Digest256)] (Vec Int)
  (loop [index Int 0
         result (Vec Int) (encode-fixed-unsigned (count values) 8)]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (into
          (into result (encode-fixed-unsigned 32 8))
          (digest256-octets (nth values index)))))))

(defn field-payload [field MerkleField] EncodingResult
  (match field
    [(BytesField tag value)
     (if (valid-octets? value)
       (->EncodingAccepted value)
       (->EncodingRejected
         (identity-problem
           :identity/invalid-octet
           "byte fields require integers from zero through 255"
           [(str tag)])))]
    [(Utf8Field tag value)
     (->EncodingAccepted (utf8-encode value))]
    [(NaturalField tag value)
     (if (>= value 0)
       (->EncodingAccepted (encode-natural value))
       (->EncodingRejected
         (identity-problem
           :identity/negative-natural
           "natural fields cannot encode a negative integer"
           [(str tag) (str value)])))]
    [(SignedField tag value)
     (->EncodingAccepted (encode-signed value))]
    [(DigestField tag value)
     (if (digest-valid? value)
       (->EncodingAccepted (digest256-octets value))
       (->EncodingRejected
         (identity-problem
           :identity/invalid-digest
           "digest fields require exactly 32 valid octets"
           [(str tag)])))]
    [(OrderedDigestsField tag values)
     (if (digest-vector-valid? values)
       (->EncodingAccepted (encode-digest-vector values))
       (->EncodingRejected
         (identity-problem
           :identity/invalid-digest
           "ordered digest fields contain an invalid digest"
           [(str tag)])))]
    [(SetDigestsField tag values)
     (if (not (digest-vector-valid? values))
       (->EncodingRejected
         (identity-problem
           :identity/invalid-digest
           "digest set fields contain an invalid digest"
           [(str tag)]))
       (let [sorted (Vec Digest256) (sort-digests values)]
         (if (adjacent-duplicate-digest? sorted)
           (->EncodingRejected
             (identity-problem
               :identity/duplicate-set-member
               "digest set fields reject duplicate input members"
               [(str tag)]))
           (->EncodingAccepted (encode-digest-vector sorted)))))]))

(defn encode-field [field MerkleField] EncodingResult
  (let [tag Int (field-tag field)]
    (if (not (unsigned-in-range? tag 65535))
      (->EncodingRejected
        (identity-problem
          :identity/invalid-field-tag
          "Merkle field tags must fit an unsigned 16-bit integer"
          [(str tag)]))
      (match (field-payload field)
        [(EncodingRejected problem) (->EncodingRejected problem)]
        [(EncodingAccepted payload)
         (->EncodingAccepted
           (into
             (into
               (into (encode-fixed-unsigned tag 2) [(field-kind field)])
               (encode-fixed-unsigned (count payload) 8))
             payload))]))))

(defn encode-fields [fields (Vec MerkleField)] EncodingResult
  (if (> (count fields) 4294967295)
    (->EncodingRejected
      (identity-problem
        :identity/too-many-fields
        "Merkle nodes cannot exceed an unsigned 32-bit field count"
        [(str (count fields))]))
    (loop [index Int 0
           previous-tag Int -1
           result (Vec Int) []]
      (if (>= index (count fields))
        (->EncodingAccepted result)
        (let [field MerkleField (nth fields index)
              tag Int (field-tag field)]
          (if (<= tag previous-tag)
            (->EncodingRejected
              (identity-problem
                :identity/noncanonical-field-order
                "Merkle field tags must be unique and strictly increasing"
                [(str previous-tag) (str tag)]))
            (match (encode-field field)
              [(EncodingRejected problem) (->EncodingRejected problem)]
              [(EncodingAccepted encoded)
               (recur (+ index 1) tag (into result encoded))])))))))

(defn hash-canonical-bytes [canonical-bytes (Vec Int)] MerkleResult
  (match (digest-from-hex (sha256-bytes canonical-bytes))
    [(DigestRejected problem) (->MerkleResult (->MerkleRejected problem))]
    [(DigestAccepted digest)
     (->MerkleResult (->MerkleHashed digest canonical-bytes))]))

(defn merkle-rejection [problem IdentityProblem] MerkleResult
  (->MerkleResult (->MerkleRejected problem)))

(defn hash-encoded-fields
  [domain-tag Int
   field-count Int
   encoded EncodingResult] MerkleResult
  (match encoded
    [(EncodingRejected problem) (merkle-rejection problem)]
    [(EncodingAccepted encoded-fields)
     (let [header (Vec Int) (into
             (into
               (into (encode-fixed-unsigned 1111968841 4)
                 (encode-fixed-unsigned 1 2))
               (encode-fixed-unsigned domain-tag 2))
             (encode-fixed-unsigned field-count 4))
           canonical-bytes (Vec Int) (into header encoded-fields)]
       (hash-canonical-bytes canonical-bytes))]))

(defn hash-merkle-node
  [domain IdentityDomain
   fields (Vec MerkleField)] MerkleResult
  (hash-encoded-fields
    (identity-domain-tag domain)
    (count fields)
    (encode-fields fields)))

(defn byte-content-id [bytes (Vec Int)] ByteContentAdmission
  (match (merkleresult-outcome
           (hash-merkle-node (byte-content-domain)
             [(->BytesField 1 bytes)]))
    [(MerkleRejected problem) (->ByteContentRejected problem)]
    [(MerkleHashed digest canonical-bytes)
     (->ByteContentAccepted (->ByteContentId digest))]))
