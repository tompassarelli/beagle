#lang beagle
(ns beagle.compiler-driver
  (:require [beagle.artifact-linker :as linker]
            [beagle.bootstrap-contract :as bootstrap]
            [beagle.bootstrap-query :as bootstrap-query]
            [beagle.checker :as checker]
            [beagle.datum-reader :as reader]
            [beagle.fact-materializer :as materializer]
            [beagle.fact-profile :as profile]
            [beagle.frontend-facts :as facts]
            [beagle.parser :as parser]
            [beagle.parser-reader :as parser-reader]
            [beagle.program-projection :as program-projection]
            [beagle.rule-scheduler :as scheduler]
            [beagle.syntax-semantics :as semantics]
            [store.types :as t]))

(def max-source-bytes Int 67108864)

(defunion SourceAdmission
  SourceAccepted
  (SourceRejected
    [(code Int) (path String) (offset Int) (detail String)]))

(defrecord CompileBundleRequest
  [store-log String
   space-id String
   compiler-context String
   profile String
   targets (Vec String)
   rule-set-id String
   schema-content-id String
   source-paths (Vec String)
   syntax facts/SyntaxFactClosure])

(defrecord CompileQuery
  [admitted profile/AdmittedQueryClosure
   request CompileBundleRequest])

(defunion CompileQueryAdmissionResult
  (CompileQueryReady [query CompileQuery])
  (CompileQueryAdmissionRejected [code Keyword detail String]))

(defunion CompileBundleResult
  (CompileBundleWarm
    [content-id String
     artifact-id String
     executable-path String])
  (CompileBundleMaterialized
    [content-id String
     artifact-id String
     executable-path String])
  (CompileBundleError [code Int detail String]))

(defunion ReadSourceFactsResult
  (SourceFactsRead
    [raw facts/SyntaxFactBundle
     normalized facts/SyntaxFactBundle])
  (SourceFactsRejected [code Int detail String]))

(defunion CloseSourceFactsResult
  (SourceFactsClosed [closure facts/SyntaxFactClosure])
  (SourceFactsClosureRejected [code Int detail String]))

(defrecord ImportResolutionDependencyV1
  [candidate-path String
   present Bool
   content-id String])

(defrecord ImportResolutionRequestV1
  [importer-path String
   import-order Int
   required-namespace String])

(defrecord ImportResolutionReceiptV1
  [importer-path String
   import-order Int
   required-namespace String
   dependencies (Vec ImportResolutionDependencyV1)
   selected-path String?])

(defrecord ResolvedSourceFactsV1
  [raw facts/SyntaxFactBundle
   normalized facts/SyntaxFactBundle
   authority parser/ModuleAuthorityV1])

(defrecord ExternalImportResolutionV1
  [importer-path String
   import-order Int
   required-namespace String
   interface-content-id String])

(defunion ImportResolutionResponseV1
  (ImportResolutionFoundV1
    [receipt ImportResolutionReceiptV1
     source ResolvedSourceFactsV1])
  (ImportResolutionMissingV1 [receipt ImportResolutionReceiptV1])
  (ImportResolutionExternalV1
    [receipt ImportResolutionReceiptV1
     interface-content-id String])
  (ImportResolutionFailedV1
    [receipt ImportResolutionReceiptV1
     code Int
     detail String]))

(defalias ImportResolverV1
  (Fn [ImportResolutionRequestV1] ImportResolutionResponseV1))

(defrecord CollectedSourceFactsV1
  [closure facts/SyntaxFactClosure
   raw-modules (Vec facts/SyntaxFactBundle)
   receipts (Vec ImportResolutionReceiptV1)
   external-imports (Vec ExternalImportResolutionV1)])

(defunion CollectSourceFactsResultV1
  (SourceFactsCollectedV1 [collected CollectedSourceFactsV1])
  (SourceFactsCollectionRejectedV1
    [code Int
     detail String
     receipts (Vec ImportResolutionReceiptV1)]))

(defrecord SourceCollectionStateV1
  [sources (Vec ResolvedSourceFactsV1)
   receipts (Vec ImportResolutionReceiptV1)
   external-imports (Vec ExternalImportResolutionV1)])

(defunion ResolveImportStepV1
  (ImportStepResolvedV1 [state SourceCollectionStateV1])
  (ImportStepRejectedV1
    [code Int
     detail String
     receipts (Vec ImportResolutionReceiptV1)]))

(defrecord CheckedModuleFacts
  [raw facts/SyntaxFactBundle
   syntax facts/SyntaxFactBundle
   checked checker/CheckedFacts])

(defrecord CheckedFactClosure
  [syntax facts/SyntaxFactClosure
   modules (Vec CheckedModuleFacts)])

(defunion CheckFactClosureResult
  (FactClosureChecked [closure CheckedFactClosure])
  (FactClosureRejected [code Int detail String]))

(defunion CompileArtifactResult
  (CompileArtifactReady [artifact linker/TargetArtifactV1])
  (CompileArtifactRejected [code Int detail String]))

(defunion CompileQueryEvaluation
  CompileQueryEvaluationReady
  (CompileQueryEvaluationRejected [code Int detail String]))

(defrecord CompileSourceConfig
  [source-path String
   output-directory String
   store-log String
   space-id String
   c-compiler String
   qbe-compiler String])

;; This plan crosses the compiler/Store authority boundary only long enough for
;; the Store host to admit a durable ProgramRoot. Its program content is still
;; canonical recursive Triples, never a stored compiler-specific row.
(defrecord ProgramAdmissionPlan
  [store-log String
   space-id String
   compiler-context String
   closure-digest String
   profile Keyword
   initial-root-candidate t/Term
   propositions (Vec t/Triple)])

(defunion ProgramAdmissionPlanResult
  (ProgramAdmissionPlanned [plan ProgramAdmissionPlan])
  (ProgramAdmissionPlanningRejected [code Int detail String]))

(defunion CompileStoreRequest
  (CompileStoreAdmitProgram [plan ProgramAdmissionPlan])
  (CompileStoreLookup
    [store-log String
     space-id String
     query profile/AdmittedQueryClosure])
  (CompileStoreAppend
    [store-log String
     space-id String
     result profile/AdmittedResultClosure
     artifact linker/TargetArtifactV1]))

(defunion CompileStoreResponse
  CompileStoreCold
  (CompileStoreWarm
    [result profile/AdmittedResultClosure
     artifact linker/TargetArtifactV1])
  (CompileStoreWarmRejected
    [result profile/AdmittedResultClosure
     detail String])
  (CompileStoreProgramAdmitted
    [root-resource t/Term
     root-version Int])
  CompileStorePersisted
  (CompileStoreFailure [code Int detail String]))

(defalias CompileStore
  (Fn [CompileStoreRequest] CompileStoreResponse))

(defn compile-query
  [request CompileBundleRequest] CompileQueryAdmissionResult
  (let [syntax facts/SyntaxFactClosure
        (compilebundlerequest-syntax request)]
    (match (profile/admit-and-identify-query
             (profile/->QueryAdmissionRequest
               (facts/syntaxfactclosure-closure-digest syntax)
               (compilebundlerequest-compiler-context request)
               (compilebundlerequest-profile request)
               (compilebundlerequest-targets request)
               (compilebundlerequest-rule-set-id request)
               (compilebundlerequest-schema-content-id request)))
      [(profile/QueryRejected code detail)
       (->CompileQueryAdmissionRejected code detail)]
      [(profile/QueryAdmitted admitted)
       (->CompileQueryReady
         (->CompileQuery admitted request))])))

(defn compile-query-id [query CompileQuery] String
  (profile/admittedqueryclosure-query-digest
    (compilequery-admitted query)))

(defn fact-errors-detail [errors (Vec facts/FactError)] String
  (if (empty? errors)
    "source fact projection rejected without an error"
    (facts/facterror-message (first errors))))

(defn read-source-facts
  [path String profile String] ReadSourceFactsResult
  (match (host.fs/read-text-bounded path max-source-bytes)
    [(host.fs/ReadTextBoundedError errno)
     (->SourceFactsRejected errno (str "read failed: " path))]
    [(host.fs/ReadTextBoundedOk text)
     (let [source-digest String
           (str "sha256:" (sha256-bytes (utf8-encode text)))]
       (match (parser-reader/facts-from-source
                path text source-digest profile)
         [(facts/FactsRead raw)
          (match (semantics/normalize raw)
            [(facts/FactsRead normalized) (->SourceFactsRead raw normalized)]
            [(facts/FactsRejected errors)
             (->SourceFactsRejected 65 (fact-errors-detail errors))])]
         [(facts/FactsRejected errors)
          (->SourceFactsRejected 65 (fact-errors-detail errors))]))]))

(defn close-source-facts
  [entry-path String
   sources (Vec parser/ExplicitFactSourceV1)] CloseSourceFactsResult
  (match (parser/parse-explicit-bundle
           (parser/->ExplicitFactBundleV1 entry-path sources))
    [(parser/ExplicitBundleParsedV1 closure)
     (->SourceFactsClosed closure)]
    [(parser/ExplicitBundleRejectedV1 errors)
     (->SourceFactsClosureRejected 65 (fact-errors-detail errors))]))

(defn insert-resolution-dependency
  [dependencies (Vec ImportResolutionDependencyV1)
   dependency ImportResolutionDependencyV1]
  (Vec ImportResolutionDependencyV1)
  (loop [remaining (Vec ImportResolutionDependencyV1) dependencies
         prefix (Vec ImportResolutionDependencyV1) []]
    (if (empty? remaining)
      (conj prefix dependency)
      (let [current ImportResolutionDependencyV1 (first remaining)]
        (if (neg? (compare
                    (importresolutiondependencyv1-candidate-path dependency)
                    (importresolutiondependencyv1-candidate-path current)))
          (into (conj prefix dependency) remaining)
          (recur (rest remaining) (conj prefix current)))))))

(defn canonical-resolution-dependencies
  [dependencies (Vec ImportResolutionDependencyV1)]
  (Vec ImportResolutionDependencyV1)
  (reduce insert-resolution-dependency [] dependencies))

(defn duplicate-resolution-path?
  [dependencies (Vec ImportResolutionDependencyV1)] Bool
  (loop [remaining (Vec ImportResolutionDependencyV1) dependencies
         previous String? nil]
    (if (empty? remaining)
      false
      (let [path String
            (importresolutiondependencyv1-candidate-path (first remaining))]
        (if (= previous path)
          true
          (recur (rest remaining) path))))))

(defn canonical-resolution-receipt
  [receipt ImportResolutionReceiptV1] ImportResolutionReceiptV1
  (->ImportResolutionReceiptV1
    (importresolutionreceiptv1-importer-path receipt)
    (importresolutionreceiptv1-import-order receipt)
    (importresolutionreceiptv1-required-namespace receipt)
    (canonical-resolution-dependencies
      (importresolutionreceiptv1-dependencies receipt))
    (importresolutionreceiptv1-selected-path receipt)))

(defn receipt-matches-request?
  [receipt ImportResolutionReceiptV1
   request ImportResolutionRequestV1] Bool
  (and (= (importresolutionreceiptv1-importer-path receipt)
          (importresolutionrequestv1-importer-path request))
       (= (importresolutionreceiptv1-import-order receipt)
          (importresolutionrequestv1-import-order request))
       (= (importresolutionreceiptv1-required-namespace receipt)
          (importresolutionrequestv1-required-namespace request))
       (not (duplicate-resolution-path?
              (importresolutionreceiptv1-dependencies receipt)))
       (not (empty? (importresolutionreceiptv1-dependencies receipt)))
       (every?
         (fn [dependency ImportResolutionDependencyV1] Bool
           (and (> (count
                     (importresolutiondependencyv1-candidate-path dependency)) 0)
                (> (count
                     (importresolutiondependencyv1-content-id dependency)) 0)))
         (importresolutionreceiptv1-dependencies receipt))))

(defn present-resolution-dependencies
  [receipt ImportResolutionReceiptV1]
  (Vec ImportResolutionDependencyV1)
  (reduce
    (fn [present (Vec ImportResolutionDependencyV1)
         dependency ImportResolutionDependencyV1]
      (Vec ImportResolutionDependencyV1)
      (if (importresolutiondependencyv1-present dependency)
        (conj present dependency)
        present))
    []
    (importresolutionreceiptv1-dependencies receipt)))

(defn found-receipt-valid?
  [receipt ImportResolutionReceiptV1
   request ImportResolutionRequestV1
   source ResolvedSourceFactsV1] Bool
  (let [normalized facts/SyntaxFactBundle
        (resolvedsourcefactsv1-normalized source)
        raw facts/SyntaxFactBundle (resolvedsourcefactsv1-raw source)
        selected String? (importresolutionreceiptv1-selected-path receipt)
        present (Vec ImportResolutionDependencyV1)
        (present-resolution-dependencies receipt)
        namespace String? (facts/syntaxfactbundle-namespace normalized)]
    (and (receipt-matches-request? receipt request)
         (some? selected)
         (= 1 (count present))
         (= selected
            (importresolutiondependencyv1-candidate-path (first present)))
         (= selected (facts/syntaxfactbundle-path normalized))
         (= selected (facts/syntaxfactbundle-path raw))
         (= (facts/syntaxfactbundle-source-digest normalized)
            (facts/syntaxfactbundle-source-digest raw))
         (= (facts/syntaxfactbundle-source-digest normalized)
            (importresolutiondependencyv1-content-id (first present)))
         (= namespace
            (importresolutionrequestv1-required-namespace request)))))

(defn missing-receipt-valid?
  [receipt ImportResolutionReceiptV1
   request ImportResolutionRequestV1] Bool
  (and (receipt-matches-request? receipt request)
       (nil? (importresolutionreceiptv1-selected-path receipt))
       (empty? (present-resolution-dependencies receipt))))

(defn external-receipt-valid?
  [receipt ImportResolutionReceiptV1
   request ImportResolutionRequestV1
   interface-content-id String] Bool
  (let [selected String? (importresolutionreceiptv1-selected-path receipt)
        present (Vec ImportResolutionDependencyV1)
        (present-resolution-dependencies receipt)]
    (and (receipt-matches-request? receipt request)
         (some? selected)
         (= 1 (count
                (importresolutionreceiptv1-dependencies receipt)))
         (= 1 (count present))
         (= selected
            (importresolutiondependencyv1-candidate-path (first present)))
         (= interface-content-id
            (importresolutiondependencyv1-content-id (first present))))))

(defn resolved-source-for-namespace
  [sources (Vec ResolvedSourceFactsV1)
   namespace String] ResolvedSourceFactsV1?
  (some
    (fn [source ResolvedSourceFactsV1] ResolvedSourceFactsV1?
      (if (= namespace
              (facts/syntaxfactbundle-namespace
                (resolvedsourcefactsv1-normalized source)))
        source
        nil))
    sources))

(defn same-resolved-source?
  [left ResolvedSourceFactsV1
   right ResolvedSourceFactsV1] Bool
  (let [left-bundle facts/SyntaxFactBundle
        (resolvedsourcefactsv1-normalized left)
        right-bundle facts/SyntaxFactBundle
        (resolvedsourcefactsv1-normalized right)]
    (and (= (facts/syntaxfactbundle-path left-bundle)
            (facts/syntaxfactbundle-path right-bundle))
         (= (facts/syntaxfactbundle-source-digest left-bundle)
            (facts/syntaxfactbundle-source-digest right-bundle)))))

(defn resolve-import-step
  [state SourceCollectionStateV1
   importer-path String
   edge facts/ImportEdgeFact
   resolver ImportResolverV1] ResolveImportStepV1
  (let [request ImportResolutionRequestV1
        (->ImportResolutionRequestV1
          importer-path
          (facts/importedgefact-order edge)
          (facts/importedgefact-required edge))]
    (match (resolver request)
      [(ImportResolutionFailedV1 receipt code detail)
       (let [canonical ImportResolutionReceiptV1
             (canonical-resolution-receipt receipt)]
         (if (receipt-matches-request? canonical request)
           (->ImportStepRejectedV1 code detail
             (conj (sourcecollectionstatev1-receipts state) canonical))
           (->ImportStepRejectedV1 65
             "import resolver failure receipt does not match its request"
             (conj (sourcecollectionstatev1-receipts state) canonical))))]
      [(ImportResolutionMissingV1 receipt)
       (let [canonical ImportResolutionReceiptV1
             (canonical-resolution-receipt receipt)]
         (if (missing-receipt-valid? canonical request)
           (->ImportStepRejectedV1 66
             (str "unresolved namespace: "
                  (facts/importedgefact-required edge))
             (conj (sourcecollectionstatev1-receipts state) canonical))
           (->ImportStepRejectedV1 65
             "missing import receipt is not a closed negative resolution"
             (conj (sourcecollectionstatev1-receipts state) canonical))))]
      [(ImportResolutionExternalV1 receipt interface-content-id)
       (let [canonical ImportResolutionReceiptV1
             (canonical-resolution-receipt receipt)]
         (if (not (external-receipt-valid?
                    canonical request interface-content-id))
           (->ImportStepRejectedV1 65
             "external import does not match its compiler interface receipt"
             (conj (sourcecollectionstatev1-receipts state) canonical))
           (->ImportStepResolvedV1
             (->SourceCollectionStateV1
               (sourcecollectionstatev1-sources state)
               (conj (sourcecollectionstatev1-receipts state) canonical)
               (conj (sourcecollectionstatev1-external-imports state)
                 (->ExternalImportResolutionV1
                   importer-path
                   (facts/importedgefact-order edge)
                   (facts/importedgefact-required edge)
                   interface-content-id))))))]
      [(ImportResolutionFoundV1 receipt source)
       (let [canonical ImportResolutionReceiptV1
             (canonical-resolution-receipt receipt)]
         (if (not (found-receipt-valid? canonical request source))
           (->ImportStepRejectedV1 65
             "resolved import source does not match its causal receipt"
             (conj (sourcecollectionstatev1-receipts state) canonical))
           (let [required String (facts/importedgefact-required edge)
                 existing ResolvedSourceFactsV1?
                 (resolved-source-for-namespace
                   (sourcecollectionstatev1-sources state) required)]
             (if (and (some? existing)
                      (not (same-resolved-source? existing source)))
               (->ImportStepRejectedV1 65
                 (str "namespace resolved to conflicting sources: " required)
                 (conj (sourcecollectionstatev1-receipts state) canonical))
               (->ImportStepResolvedV1
                 (->SourceCollectionStateV1
                   (if (nil? existing)
                     (conj (sourcecollectionstatev1-sources state) source)
                     (sourcecollectionstatev1-sources state))
                   (conj (sourcecollectionstatev1-receipts state)
                         canonical)
                   (sourcecollectionstatev1-external-imports state)))))))])))

(defn resolve-module-imports
  [state SourceCollectionStateV1
   source ResolvedSourceFactsV1
   resolver ImportResolverV1] ResolveImportStepV1
  (let [bundle facts/SyntaxFactBundle
        (resolvedsourcefactsv1-normalized source)
        importer-path String (facts/syntaxfactbundle-path bundle)]
    (loop [remaining (Vec facts/ImportEdgeFact)
           (facts/syntaxfactbundle-imports bundle)
           current SourceCollectionStateV1 state]
      (if (empty? remaining)
        (->ImportStepResolvedV1 current)
        (match (resolve-import-step current importer-path (first remaining) resolver)
          [(ImportStepRejectedV1 code detail receipts)
           (->ImportStepRejectedV1 code detail receipts)]
          [(ImportStepResolvedV1 next-state)
           (recur (rest remaining) next-state)])))))

(defn external-import-matches-edge?
  [external ExternalImportResolutionV1
   importer-path String
   edge facts/ImportEdgeFact] Bool
  (and (= importer-path
          (externalimportresolutionv1-importer-path external))
       (= (facts/importedgefact-order edge)
          (externalimportresolutionv1-import-order external))
       (= (facts/importedgefact-required edge)
          (externalimportresolutionv1-required-namespace external))))

(defn externally-resolved-import?
  [external-imports (Vec ExternalImportResolutionV1)
   importer-path String
   edge facts/ImportEdgeFact] Bool
  (some?
    (some
      (fn [external ExternalImportResolutionV1]
        ExternalImportResolutionV1?
        (if (external-import-matches-edge? external importer-path edge)
          external
          nil))
      external-imports)))

(defn source-imports-for-parser
  [bundle facts/SyntaxFactBundle
   external-imports (Vec ExternalImportResolutionV1)]
  (Vec facts/ImportEdgeFact)
  (let [path String (facts/syntaxfactbundle-path bundle)]
    (reduce
      (fn [imports (Vec facts/ImportEdgeFact)
           edge facts/ImportEdgeFact] (Vec facts/ImportEdgeFact)
        (if (externally-resolved-import? external-imports path edge)
          imports
          (conj imports edge)))
      []
      (facts/syntaxfactbundle-imports bundle))))

(defn source-bundle-for-parser
  [bundle facts/SyntaxFactBundle
   external-imports (Vec ExternalImportResolutionV1)]
  facts/SyntaxFactBundle
  (facts/->SyntaxFactBundle
    (facts/syntaxfactbundle-path bundle)
    (facts/syntaxfactbundle-namespace bundle)
    (facts/syntaxfactbundle-source-text bundle)
    (facts/syntaxfactbundle-source-digest bundle)
    (facts/syntaxfactbundle-profile bundle)
    (facts/syntaxfactbundle-facts bundle)
    (source-imports-for-parser bundle external-imports)
    (facts/syntaxfactbundle-rewrites bundle)))

(defn collect-source-facts
  [entry ResolvedSourceFactsV1
   resolver ImportResolverV1] CollectSourceFactsResultV1
  (loop [cursor Int 0
         state SourceCollectionStateV1
         (->SourceCollectionStateV1 [entry] [] [])]
    (if (>= cursor (count (sourcecollectionstatev1-sources state)))
      (let [sources (Vec ResolvedSourceFactsV1)
            (sourcecollectionstatev1-sources state)
            entry-path String
            (facts/syntaxfactbundle-path
              (resolvedsourcefactsv1-normalized entry))
            external-imports (Vec ExternalImportResolutionV1)
            (sourcecollectionstatev1-external-imports state)
            explicit (Vec parser/ExplicitFactSourceV1)
            (mapv
              (fn [source ResolvedSourceFactsV1] parser/ExplicitFactSourceV1
                (parser/->ExplicitFactSourceV1
                  (source-bundle-for-parser
                    (resolvedsourcefactsv1-normalized source)
                    external-imports)
                  (resolvedsourcefactsv1-authority source)))
              sources)]
        (match (close-source-facts entry-path explicit)
          [(SourceFactsClosureRejected code detail)
           (->SourceFactsCollectionRejectedV1 code detail
             (sourcecollectionstatev1-receipts state))]
          [(SourceFactsClosed closure)
           (->SourceFactsCollectedV1
             (->CollectedSourceFactsV1
               closure
               (mapv resolvedsourcefactsv1-raw sources)
               (sourcecollectionstatev1-receipts state)
               external-imports))]))
      (let [source ResolvedSourceFactsV1
            (nth (sourcecollectionstatev1-sources state) cursor)]
        (match (resolve-module-imports state source resolver)
          [(ImportStepRejectedV1 code detail receipts)
           (->SourceFactsCollectionRejectedV1 code detail receipts)]
          [(ImportStepResolvedV1 next-state)
           (recur (+ cursor 1) next-state)])))))

(defn raw-modules-at-path
  [raw-modules (Vec facts/SyntaxFactBundle)
   path String] (Vec facts/SyntaxFactBundle)
  (reduce
    (fn [matches (Vec facts/SyntaxFactBundle)
         candidate facts/SyntaxFactBundle] (Vec facts/SyntaxFactBundle)
      (if (= path (facts/syntaxfactbundle-path candidate))
        (conj matches candidate)
        matches))
    []
    raw-modules))

(defn check-fact-closure
  [syntax facts/SyntaxFactClosure
   raw-modules (Vec facts/SyntaxFactBundle)] CheckFactClosureResult
  (loop [remaining (Vec facts/SyntaxFactBundle)
         (facts/syntaxfactclosure-modules syntax)
         checked-modules (Vec CheckedModuleFacts) []]
    (if (empty? remaining)
      (->FactClosureChecked (->CheckedFactClosure syntax checked-modules))
      (let [bundle facts/SyntaxFactBundle (first remaining)]
        (match (checker/check-facts bundle)
          [(checker/FactsChecked checked)
           (let [matches (Vec facts/SyntaxFactBundle)
                 (raw-modules-at-path
                   raw-modules
                   (facts/syntaxfactbundle-path bundle))]
             (if (not= 1 (count matches))
               (->FactClosureRejected 65
                 "checked module must have exactly one raw bundle at its exact source path")
               (recur (rest remaining)
                 (conj checked-modules
                   (->CheckedModuleFacts (first matches) bundle checked)))))]
          [(checker/CheckRejected rejection)
           (->FactClosureRejected 65
             (str (checker/checkrejection-rule rejection) ": "
                  (checker/checkrejection-subject rejection) ": "
                  (checker/checkrejection-detail rejection)))])))))

(def program-profile Keyword :program)
(def program-root-domain String "beagle-program-root/v1")

(defn length-framed [value String] String
  (str (count (utf8-encode value)) ":" value))

(defn initial-program-root-candidate
  [space-id String
   compiler-context String
   closure-digest String
   entry-namespace String] String
  (bootstrap/content-id
    (str program-root-domain
         (length-framed space-id)
         (length-framed compiler-context)
         (length-framed closure-digest)
         (length-framed entry-namespace))))

(defn program-admission-seed-value [plan ProgramAdmissionPlan] Any
  (programadmissionplan-initial-root-candidate plan))

(defn program-term-value [value t/Term] Any value)

(defn append-unique-program-proposition
  [propositions (Vec t/Triple)
   proposition t/Triple] (Vec t/Triple)
  (if (some?
        (some
          (fn [candidate t/Triple] t/Triple?
            (if (= candidate proposition) candidate nil))
          propositions))
    propositions
    (conj propositions proposition)))

(defn merge-program-propositions
  [propositions (Vec t/Triple)
   projected (Vec t/Triple)] (Vec t/Triple)
  (reduce append-unique-program-proposition propositions projected))

(defn plan-program-admission
  [config CompileSourceConfig
   checked CheckedFactClosure
   entry-namespace String] ProgramAdmissionPlanResult
  (loop [remaining (Vec CheckedModuleFacts)
         (checkedfactclosure-modules checked)
         propositions (Vec t/Triple) []]
    (if (empty? remaining)
      (let [syntax facts/SyntaxFactClosure
            (checkedfactclosure-syntax checked)
            space-id String (compilesourceconfig-space-id config)
            compiler-context String bootstrap/default-compiler-context-id
            closure-digest String
            (facts/syntaxfactclosure-closure-digest syntax)]
        (->ProgramAdmissionPlanned
          (->ProgramAdmissionPlan
            (compilesourceconfig-store-log config)
            space-id
            compiler-context
            closure-digest
            program-profile
            (initial-program-root-candidate
              space-id compiler-context closure-digest entry-namespace)
            propositions)))
      (let [module CheckedModuleFacts (first remaining)
            normalized facts/SyntaxFactBundle
            (checkedmodulefacts-syntax module)
            namespace String? (facts/syntaxfactbundle-namespace normalized)]
        (if (nil? namespace)
          (->ProgramAdmissionPlanningRejected 65
            "checked module does not declare a namespace")
          (match (program-projection/project-module
                   namespace
                   (checkedmodulefacts-raw module))
            [(program-projection/ProgramProjectionRejected code detail)
             (->ProgramAdmissionPlanningRejected 65 detail)]
            [(program-projection/ProgramProjected projected)
             (recur
               (vec (rest remaining))
               (merge-program-propositions
                 propositions
                 (program-projection/programmoduleprojection-propositions
                   projected)))]))))))

(defn link-query-artifact
  [query CompileQuery
   config linker/ArtifactLinkConfigV1
   artifact linker/TargetArtifactV1] CompileBundleResult
  (match (linker/encode-artifact-envelope artifact)
    [(linker/ArtifactEnvelopeErrorV1 detail)
     (->CompileBundleError 65 detail)]
    [(linker/ArtifactEnvelopeReadyV1 artifact-content-id payload)
     (match (linker/write-and-link config artifact)
       [(linker/ArtifactLinkedV1 executable-path)
        (->CompileBundleMaterialized
          (compile-query-id query)
          artifact-content-id
          executable-path)]
       [(linker/ArtifactLinkErrorV1 code detail)
        (->CompileBundleError code detail)])]))

(defn checked-module-results
  [closure CheckedFactClosure] (Vec checker/CheckedFacts)
  (mapv
    (fn [module CheckedModuleFacts] checker/CheckedFacts
      (checkedmodulefacts-checked module))
    (checkedfactclosure-modules closure)))

(defn materialize-query
  [query CompileQuery
   checked CheckedFactClosure
   entry-namespace String
   entry-definition String] CompileArtifactResult
  (let [targets (Vec String)
        (compilebundlerequest-targets (compilequery-request query))]
    (if (not= 1 (count targets))
      (->CompileArtifactRejected 64
        "native compile requires exactly one materialization target")
      (match (materializer/materialize
               (materializer/->FactMaterializationRequest
                 (compile-query-id query)
                 (first targets)
                 (checkedfactclosure-syntax checked)
                 (checked-module-results checked)
                 entry-namespace
                 entry-definition))
        [(materializer/FactMaterializationRejected code detail)
         (->CompileArtifactRejected code detail)]
        [(materializer/FactMaterialized artifact)
         (->CompileArtifactReady artifact)]))))

(defn scheduler-relation-present?
  [facts (Vec scheduler/RuleFactV1) relation String] Bool
  (some?
    (some
      (fn [fact scheduler/RuleFactV1] scheduler/RuleFactV1?
        (if (= relation (scheduler/rulefactv1-relation fact)) fact nil))
      facts)))

(defn scheduler-first-key [facts (Vec scheduler/RuleFactV1)] String
  (if (empty? facts) "" (scheduler/rulefactv1-key (first facts))))

(defn produce-stage-fact
  [facts (Vec scheduler/RuleFactV1)
   input-relation String
   output-relation String
   payload String] scheduler/RuleEvaluationV1
  (if (scheduler-relation-present? facts input-relation)
    (scheduler/->RuleProducedV1
      [(scheduler/->RuleFactV1 output-relation
         (scheduler-first-key facts) payload)])
    (scheduler/->RuleProducedV1 [])))

(defn stage-content-id [query CompileQuery relation String] String
  (str "sha256:"
    (sha256-bytes
      (utf8-encode (str (compile-query-id query) ":" relation)))))

(defn evaluate-compile-rule
  [query CompileQuery
   artifact linker/TargetArtifactV1
   rule scheduler/RuleSpecV1
   rule-facts (Vec scheduler/RuleFactV1)] scheduler/RuleEvaluationV1
  (let [rule-id String (scheduler/rulespecv1-id rule)]
    (cond
      (= rule-id bootstrap/grammar-rule-content-id)
      (produce-stage-fact rule-facts "query/source" "compiler/syntax"
        (facts/syntaxfactclosure-closure-digest
          (compilebundlerequest-syntax (compilequery-request query))))

      (= rule-id bootstrap/macro-rule-content-id)
      (produce-stage-fact rule-facts "compiler/syntax" "compiler/expanded"
        (stage-content-id query "compiler/expanded"))

      (= rule-id bootstrap/type-rule-content-id)
      (produce-stage-fact rule-facts "compiler/expanded" "compiler/typed"
        (stage-content-id query "compiler/typed"))

      (= rule-id bootstrap/lowering-rule-content-id)
      (produce-stage-fact rule-facts "compiler/typed" "compiler/native"
        (stage-content-id query "compiler/native"))

      (= rule-id bootstrap/materializer-rule-content-id)
      (produce-stage-fact rule-facts "compiler/native"
        bootstrap/compiler-artifact-relation
        (linker/targetartifactv1-digest artifact))

      :else
      (scheduler/->RuleRejectedV1
        (scheduler/->RuleErrorV1
          rule-id
          (scheduler/rulespecv1-source-span rule)
          :compile/unknown-rule
          "compile query received a rule outside its admitted rule set")))))

(defn evaluate-materialized-query
  [query CompileQuery
   artifact linker/TargetArtifactV1] CompileQueryEvaluation
  (match (bootstrap-query/evaluate-admitted-query
           (compilequery-admitted query)
           (fn [rule scheduler/RuleSpecV1
                rule-facts (Vec scheduler/RuleFactV1)]
             scheduler/RuleEvaluationV1
             (evaluate-compile-rule query artifact rule rule-facts)))
    [(bootstrap-query/AdmittedQueryRejectedV1 code detail)
     (->CompileQueryEvaluationRejected 65 detail)]
    [(bootstrap-query/AdmittedQueryEvaluatedV1 query-digest result)
     (match result
       [(FixedPointReachedV1 reached-facts evidence steps)
        (->CompileQueryEvaluationReady)]
       [(FixedPointBoundReachedV1 reached-facts evidence steps bound)
        (->CompileQueryEvaluationRejected 70
          "compile query exceeded its fixed-point step bound")]
       [(FixedPointFailedV1 reached-facts evidence steps error)
        (->CompileQueryEvaluationRejected 65
          (scheduler/ruleerrorv1-message error))])]))

(defn link-warm-query-artifact
  [query CompileQuery
   config linker/ArtifactLinkConfigV1
   artifact linker/TargetArtifactV1] CompileBundleResult
  (match (link-query-artifact query config artifact)
    [(CompileBundleError code detail) (->CompileBundleError code detail)]
    [(CompileBundleWarm content-id artifact-id executable-path)
     (->CompileBundleWarm content-id artifact-id executable-path)]
    [(CompileBundleMaterialized content-id artifact-id executable-path)
     (->CompileBundleWarm content-id artifact-id executable-path)]))

(defn warm-result-valid?
  [query CompileQuery
   result profile/AdmittedResultClosure
   artifact linker/TargetArtifactV1] Bool
  (match (profile/admit-canonical-result result)
    [(profile/ResultRejected code detail) false]
    [(profile/ResultAdmitted admitted)
     (match (linker/encode-artifact-envelope artifact)
       [(linker/ArtifactEnvelopeErrorV1 detail) false]
       [(linker/ArtifactEnvelopeReadyV1 artifact-content-id payload)
        (and (= "ok" (profile/admittedresultclosure-status admitted))
             (= (compile-query-id query)
                (profile/admittedqueryclosure-query-digest
                  (profile/admittedresultclosure-query admitted)))
             (= (linker/targetartifactv1-target artifact)
                (profile/admittedresultclosure-target admitted))
             (= artifact-content-id
                (profile/admittedresultclosure-artifact-content-id admitted)))])]))

(defn append-query-artifact
  [query CompileQuery
   result profile/AdmittedResultClosure
   artifact linker/TargetArtifactV1
   config linker/ArtifactLinkConfigV1
   store CompileStore] CompileBundleResult
  (match (store
           (->CompileStoreAppend
             (compilebundlerequest-store-log (compilequery-request query))
             (compilebundlerequest-space-id (compilequery-request query))
             result
             artifact))
    [(CompileStorePersisted) (link-query-artifact query config artifact)]
    [(CompileStoreFailure code detail) (->CompileBundleError code detail)]
    [(CompileStoreCold)
     (->CompileBundleError 74
       "Store did not acknowledge the compile result append")]
    [(CompileStoreWarm warm-result warm-artifact)
     (->CompileBundleError 74 "Store returned a warm result during append")]
    [(CompileStoreWarmRejected rejected detail)
     (->CompileBundleError 74 "Store returned a rejection during result append")]
    [(CompileStoreProgramAdmitted root-resource root-version)
     (->CompileBundleError 74
       "Store returned a program admission during result append")]))

(defn compile-admitted-artifact
  [query CompileQuery
   artifact linker/TargetArtifactV1
   config linker/ArtifactLinkConfigV1
   store CompileStore] CompileBundleResult
  (match (linker/encode-artifact-envelope artifact)
    [(linker/ArtifactEnvelopeErrorV1 detail)
     (->CompileBundleError 65 detail)]
    [(linker/ArtifactEnvelopeReadyV1 artifact-content-id payload)
     (match (profile/admit-and-identify-result
              (profile/->ResultAdmissionRequest
                (compilequery-admitted query)
                (linker/targetartifactv1-target artifact)
                bootstrap/materializer-capability-content-id
                "ok"
                artifact-content-id
                nil))
       [(profile/ResultRejected code detail) (->CompileBundleError 65 detail)]
       [(profile/ResultAdmitted result)
        (append-query-artifact query result artifact config store)])]))

(defn compile-cold-query
  [query CompileQuery
   checked CheckedFactClosure
   entry-namespace String
   entry-definition String
   config linker/ArtifactLinkConfigV1
   store CompileStore] CompileBundleResult
  (match (materialize-query query checked entry-namespace entry-definition)
    [(CompileArtifactRejected code detail) (->CompileBundleError code detail)]
    [(CompileArtifactReady artifact)
     (match (evaluate-materialized-query query artifact)
       [(CompileQueryEvaluationRejected code detail)
        (->CompileBundleError code detail)]
       [(CompileQueryEvaluationReady)
        (compile-admitted-artifact query artifact config store)])]))

(defn lookup-admitted-program
  [plan ProgramAdmissionPlan
   query CompileQuery
   store CompileStore] CompileStoreResponse
  (match (store (->CompileStoreAdmitProgram plan))
    [(CompileStoreFailure code detail) (->CompileStoreFailure code detail)]
    [(CompileStoreProgramAdmitted root-resource root-version)
     (if (and (t/term? (program-term-value root-resource))
              (>= root-version 0))
       (store
         (->CompileStoreLookup
           (programadmissionplan-store-log plan)
           (programadmissionplan-space-id plan)
           (compilequery-admitted query)))
       (->CompileStoreFailure 74
         "Store returned an invalid ProgramRoot or a negative version"))]
    [(CompileStoreCold)
     (->CompileStoreFailure 74
       "Store omitted ProgramRoot admission before compile lookup")]
    [(CompileStoreWarm result artifact)
     (->CompileStoreFailure 74
       "Store returned a warm compile result during ProgramRoot admission")]
    [(CompileStoreWarmRejected result detail)
     (->CompileStoreFailure 74
       "Store returned a compile rejection during ProgramRoot admission")]
    [(CompileStorePersisted)
     (->CompileStoreFailure 74
       "Store returned a persistence receipt during ProgramRoot admission")]))

(defn compile-stored-query
  [query CompileQuery
   checked CheckedFactClosure
   entry-namespace String
   entry-definition String
   config linker/ArtifactLinkConfigV1
   program-plan ProgramAdmissionPlan
   store CompileStore] CompileBundleResult
  (match (lookup-admitted-program program-plan query store)
    [(CompileStoreFailure code detail) (->CompileBundleError code detail)]
    [(CompileStoreWarm result artifact)
     (if (warm-result-valid? query result artifact)
       (link-warm-query-artifact query config artifact)
       (->CompileBundleError 65 "Store returned a noncanonical warm result"))]
    [(CompileStoreWarmRejected result detail)
     (match (profile/admit-canonical-result result)
       [(profile/ResultRejected code invalid-detail)
        (->CompileBundleError 65 invalid-detail)]
       [(profile/ResultAdmitted admitted)
        (if (= "rejected" (profile/admittedresultclosure-status admitted))
          (->CompileBundleError 65 detail)
          (->CompileBundleError 65
            "Store returned a non-rejected result as a rejection"))])]
    [(CompileStoreCold)
     (compile-cold-query query checked entry-namespace entry-definition
       config store)]
    [(CompileStorePersisted)
     (->CompileBundleError 74
       "Store returned an append acknowledgment during lookup")]
    [(CompileStoreProgramAdmitted root-resource root-version)
     (->CompileBundleError 74
       "Store returned a second ProgramRoot admission during lookup")]))

(defn entry-namespace [closure facts/SyntaxFactClosure] String?
  (let [entry-path String (facts/syntaxfactclosure-entry-path closure)]
    (some
      (fn [bundle facts/SyntaxFactBundle] String?
        (if (= entry-path (facts/syntaxfactbundle-path bundle))
          (facts/syntaxfactbundle-namespace bundle)
          nil))
      (facts/syntaxfactclosure-modules closure))))

(defn write-output-metadata
  [output-directory String
   artifact-id String
   result CompileBundleResult] CompileBundleResult
  (let [layout bootstrap/NativeArtifactLayoutV1
        (bootstrap/native-artifact-layout output-directory)
        manifest-path String
        (bootstrap/nativeartifactlayoutv1-manifest-path layout)
        lineage-path String
        (bootstrap/nativeartifactlayoutv1-lineage-path layout)
        manifest String
        (str (bootstrap/bootstrap-contract-payload)
             "artifact-content-id " artifact-id "\n")
        lineage String
        (bootstrap/lineage-payload (bootstrap/root-lineage artifact-id))]
    (match (host.fs/make-parent-directories manifest-path)
      [(host.fs/MakeParentDirectoriesError errno)
       (->CompileBundleError errno "could not create bootstrap output directory")]
      [(host.fs/MakeParentDirectoriesOk)
       (match (host.fs/write-text-atomic manifest-path manifest)
         [(host.fs/WriteTextAtomicError errno)
          (->CompileBundleError errno "could not write artifact manifest")]
         [(host.fs/WriteTextAtomicOk)
          (match (host.fs/write-text-atomic lineage-path lineage)
            [(host.fs/WriteTextAtomicError errno)
             (->CompileBundleError errno "could not write compiler lineage")]
            [(host.fs/WriteTextAtomicOk) result])])])))

(defn complete-compile-output
  [output-directory String
   result CompileBundleResult] CompileBundleResult
  (match result
    [(CompileBundleError code detail) (->CompileBundleError code detail)]
    [(CompileBundleWarm content-id artifact-id executable-path)
     (write-output-metadata output-directory artifact-id result)]
    [(CompileBundleMaterialized content-id artifact-id executable-path)
     (write-output-metadata output-directory artifact-id result)]))

(defn closure-source-paths
  [syntax facts/SyntaxFactClosure] (Vec String)
  (mapv facts/syntaxfactbundle-path
    (facts/syntaxfactclosure-modules syntax)))

(defn compile-checked-source
  [config CompileSourceConfig
   syntax facts/SyntaxFactClosure
   checked CheckedFactClosure
   namespace String
   store CompileStore] CompileBundleResult
  (match (plan-program-admission config checked namespace)
    [(ProgramAdmissionPlanningRejected code detail)
     (->CompileBundleError code detail)]
    [(ProgramAdmissionPlanned program-plan)
     (let [request CompileBundleRequest
           (->CompileBundleRequest
             (compilesourceconfig-store-log config)
             (compilesourceconfig-space-id config)
             bootstrap/default-compiler-context-id
             bootstrap/default-profile
             [bootstrap/default-target-id]
             bootstrap/default-rule-set-content-id
             bootstrap/compiler-schema-content-id
             (closure-source-paths syntax)
             syntax)]
       (match (compile-query request)
         [(CompileQueryAdmissionRejected code detail)
          (->CompileBundleError 65 detail)]
         [(CompileQueryReady query)
          (let [layout bootstrap/NativeArtifactLayoutV1
                (bootstrap/native-artifact-layout
                  (compilesourceconfig-output-directory config))
                link-config linker/ArtifactLinkConfigV1
                (linker/->ArtifactLinkConfigV1
                  (str (compilesourceconfig-output-directory config) "/artifacts")
                  (bootstrap/nativeartifactlayoutv1-executable-path layout)
                  (compilesourceconfig-c-compiler config)
                  (compilesourceconfig-qbe-compiler config))]
            (complete-compile-output
              (compilesourceconfig-output-directory config)
              (compile-stored-query query checked namespace "main"
                link-config program-plan store)))]))]))

(defn compile-closed-source
  [config CompileSourceConfig
   syntax facts/SyntaxFactClosure
   raw-modules (Vec facts/SyntaxFactBundle)
   store CompileStore] CompileBundleResult
  (match (check-fact-closure syntax raw-modules)
    [(FactClosureRejected code detail) (->CompileBundleError code detail)]
    [(FactClosureChecked checked)
     (let [namespace String? (entry-namespace syntax)]
       (if (nil? namespace)
         (->CompileBundleError 65 "entry source does not declare a namespace")
         (compile-checked-source config syntax checked namespace store)))]))

(defn compile-source
  [config CompileSourceConfig
   entry ResolvedSourceFactsV1
   resolver ImportResolverV1
   store CompileStore] CompileBundleResult
  (let [entry-path String
        (facts/syntaxfactbundle-path (resolvedsourcefactsv1-normalized entry))]
    (if (not= entry-path (compilesourceconfig-source-path config))
      (->CompileBundleError 64
        "compile config source ID does not match the resolved entry source")
      (match (collect-source-facts entry resolver)
        [(SourceFactsCollectionRejectedV1 code detail receipts)
         (->CompileBundleError code detail)]
        [(SourceFactsCollectedV1 collected)
         (compile-closed-source
           config
           (collectedsourcefactsv1-closure collected)
           (collectedsourcefactsv1-raw-modules collected)
           store)]))))

(defn materialize-and-link
  [query CompileQuery
   checked CheckedFactClosure
   entry-namespace String
   entry-definition String
   config linker/ArtifactLinkConfigV1] CompileBundleResult
  (match (materialize-query query checked entry-namespace entry-definition)
    [(CompileArtifactRejected code detail)
     (->CompileBundleError code detail)]
    [(CompileArtifactReady artifact)
     (match (evaluate-materialized-query query artifact)
       [(CompileQueryEvaluationRejected code detail)
        (->CompileBundleError code detail)]
       [(CompileQueryEvaluationReady)
        (link-query-artifact query config artifact)])]))

(defn admit-source-text [path String text String] SourceAdmission
  (let [(read reader/DatumRead) (reader/read-events text)
        (error String?) (reader/datumread-error read)]
    (if (nil? error)
      (->SourceAccepted)
      (->SourceRejected 65 path (reader/datumread-error-offset read) error))))

(defn read-source-path [path String] SourceAdmission
  (match (host.fs/read-text-bounded path max-source-bytes)
    [(host.fs/ReadTextBoundedOk text) (admit-source-text path text)]
    [(host.fs/ReadTextBoundedError errno)
     (->SourceRejected 66 path -1 (str "read failed with errno " errno))]))
