#lang beagle
(ns beagle.program-transaction
  (:require [beagle.program-read :as read]
            [store.program :as program]
            [store.types :as t]))

(def binding-anchor Keyword :binding)
(def reference-anchor Keyword :reference)

;; Term fields use Any because store.types cannot carry its recursive Dyn alias
;; through record accessors. Constructors below validate every such field.
(defrecord SourceEdit
  [target Any
   start-byte Int
   end-byte Int])

(defrecord AnchorProjection
  [module Any
   kind Keyword
   before-anchor Any
   after-anchor Any
   before-span t/Triple
   after-span t/Triple])

(defrecord TermReplacement
  [before Any
   after Any])

(defrecord SourceDelta
  [module Any
   before String
   after String
   edits (Vec SourceEdit)
   anchors (Vec AnchorProjection)])

(defrecord ProgramTransaction
  [base-root program/ProgramRoot
   candidate-root program/ProgramRoot
   expected-version Int
   selected-binding Any
   old-name String
   new-name String
   references (Vec Any)
   operations (Vec t/CommitOperation)
   source-deltas (Vec SourceDelta)
   invalidated (Vec Any)])

(defrecord RenamePreview
  [candidate-root program/ProgramRoot
   selected-binding Any
   old-name String
   new-name String
   references (Vec Any)
   operations (Vec t/CommitOperation)
   source-deltas (Vec SourceDelta)
   invalidated (Vec Any)])

(defunion RenamePlan
  (RenameRejected
    [code Keyword
     detail String])
  (RenamePlanned
    [transaction ProgramTransaction
     preview RenamePreview]))

(defunion CommitDecision
  (CommitConflict
    [expected-space-id String
     observed-space-id String
     expected-version Int
     observed-version Int])
  (CommitReady
    [space-id String
     expected-version Int
     candidate-root program/ProgramRoot
     operations (Vec t/CommitOperation)]))

(defrecord VerifiedRematerialization
  [transaction ProgramTransaction
   candidate-root program/ProgramRoot])

(defunion RematerializationResult
  (RematerializationRejected
    [code Keyword
     detail String])
  (RematerializationVerified [verified VerifiedRematerialization]))

(defrecord ProgramCommitReceipt
  [root Any
   served-version Int
   occurrences (Vec t/Triple)])

(defunion CommitReceiptResult
  (CommitReceiptRejected
    [code Keyword
     detail String])
  (CommitReceiptAccepted [receipt ProgramCommitReceipt]))

(def empty-any (Vec Any) [])
(def empty-edits (Vec SourceEdit) [])
(def empty-anchor-projections (Vec AnchorProjection) [])
(def empty-replacements (Vec TermReplacement) [])
(def empty-deltas (Vec SourceDelta) [])
(def empty-operations (Vec t/CommitOperation) [])
(def empty-triples (Vec t/Triple) [])

(defn proposition-live?
  [propositions (Vec t/Triple)
   proposition t/Triple] Bool
  (some?
    (some
      (fn [candidate t/Triple] t/Triple?
        (if (= candidate proposition) candidate nil))
      propositions)))

(defn related-values
  [propositions (Vec t/Triple)
   source Any
   relation Keyword] (Vec Any)
  (reduce
    (fn
      [values (Vec Any)
       proposition t/Triple] (Vec Any)
      (if (and (= source (t/triple-t1 proposition))
               (= relation (t/triple-t2 proposition)))
        (conj values (t/triple-t3 proposition))
        values))
    empty-any
    propositions))

(defn exactly-one? [values (Vec Any)] Bool
  (= 1 (count values)))

(defn first-string [values (Vec Any)] String?
  (if (and (exactly-one? values) (string? (first values)))
    (first values)
    nil))

(defn contains-value?
  [values (Vec Any)
   value Any] Bool
  (some?
    (some
      (fn [candidate Any] Any?
        (if (= candidate value) candidate nil))
      values)))

(defn append-unique
  [values (Vec Any)
   value Any] (Vec Any)
  (if (contains-value? values value) values (conj values value)))

(defn root-modules
  [propositions (Vec t/Triple)
   root Any] (Vec Any)
  (related-values propositions root program/contains))

(defn module-contains?
  [propositions (Vec t/Triple)
   module Any
   resource Any] Bool
  (proposition-live?
    propositions
    (t/triple module program/contains resource)))

(defn span-term? [value Any] Bool
  (program/span-valid? value))

(defn reference-term-for-module?
  [module Any
   value Any] Bool
  (and
    (t/triple? value)
    (= module (t/triple-t1 value))
    (= program/has-span (t/triple-t2 value))
    (span-term? (t/triple-t3 value))))

(defn binding-span
  [propositions (Vec t/Triple)
   binding Any] Any
  (let [spans (Vec Any) (related-values propositions binding program/has-span)]
    (if (and (exactly-one? spans) (span-term? (first spans)))
      (first spans)
      nil)))

(defn target-span
  [propositions (Vec t/Triple)
   module Any
   binding Any
   target Any] Any
  (if (= target binding)
    (binding-span propositions binding)
    (if (reference-term-for-module? module target)
      (t/triple-t3 target)
      nil)))

(defn source-edit
  [propositions (Vec t/Triple)
   module Any
   binding Any
   target Any] SourceEdit?
  (let [span Any (target-span propositions module binding target)]
    (if (span-term? span)
      (->SourceEdit target (t/triple-t1 span) (t/triple-t3 span))
      nil)))

(defn insert-edit
  [ordered (Vec SourceEdit)
   edit SourceEdit] (Vec SourceEdit)
  (loop [position Int 0
         prefix (Vec SourceEdit) empty-edits]
    (if (>= position (count ordered))
      (conj prefix edit)
      (let [current SourceEdit (nth ordered position)]
        (if (< (sourceedit-start-byte edit)
               (sourceedit-start-byte current))
          (reduce conj (conj prefix edit) (subvec ordered position))
          (recur (inc position) (conj prefix current)))))))

(defn canonical-edits [edits (Vec SourceEdit)] (Vec SourceEdit)
  (reduce
    (fn
      [ordered (Vec SourceEdit)
       edit SourceEdit] (Vec SourceEdit)
      (insert-edit ordered edit))
    empty-edits
    edits))

(defn edits-valid?
  [source-bytes (Vec Int)
   old-name-bytes (Vec Int)
   edits (Vec SourceEdit)] Bool
  (loop [remaining (Vec SourceEdit) edits
         cursor Int 0]
    (if (empty? remaining)
      true
      (let [edit SourceEdit (first remaining)
            start Int (sourceedit-start-byte edit)
            end Int (sourceedit-end-byte edit)]
        (if (and
              (<= cursor start)
              (< start end)
              (<= end (count source-bytes))
              (= old-name-bytes (subvec source-bytes start end)))
          (recur (vec (rest remaining)) end)
          false)))))

(defn apply-source-edits
  [source String
   old-name String
   new-name String
   edits (Vec SourceEdit)] String?
  (let [source-bytes (Vec Int) (utf8-encode source)
        old-name-bytes (Vec Int) (utf8-encode old-name)
        new-name-bytes (Vec Int) (utf8-encode new-name)
        ordered (Vec SourceEdit) (canonical-edits edits)]
    (if (edits-valid? source-bytes old-name-bytes ordered)
      (utf8-decode
        (loop [remaining (Vec SourceEdit) ordered
               cursor Int 0
               projected (Vec Int) []]
          (if (empty? remaining)
            (into projected (subvec source-bytes cursor))
            (let [edit SourceEdit (first remaining)
                  start Int (sourceedit-start-byte edit)
                  end Int (sourceedit-end-byte edit)]
              (recur
                (vec (rest remaining))
                end
                (into
                  (into projected (subvec source-bytes cursor start))
                  new-name-bytes))))))
      nil)))

(defn remap-boundary
  [offset Int
   edits (Vec SourceEdit)
   old-width Int
   new-width Int] Int?
  (loop [remaining (Vec SourceEdit) edits
         shift Int 0]
    (if (empty? remaining)
      (+ offset shift)
      (let [edit SourceEdit (first remaining)
            start Int (sourceedit-start-byte edit)
            end Int (sourceedit-end-byte edit)]
        (cond
          (<= offset start)
          (+ offset shift)

          (>= offset end)
          (recur
            (vec (rest remaining))
            (+ shift (- new-width old-width)))

          :else nil)))))

(defn remap-span
  [span t/Triple
   edits (Vec SourceEdit)
   old-width Int
   new-width Int] t/Triple?
  (let [start Any (t/triple-t1 span)
        end Any (t/triple-t3 span)]
    (if (and (integer? start) (integer? end))
      (let [new-start Int? (remap-boundary start edits old-width new-width)
            new-end Int? (remap-boundary end edits old-width new-width)]
        (if (and (some? new-start) (some? new-end))
          (t/triple new-start program/through-byte new-end)
          nil))
      nil)))

(defn module-source
  [propositions (Vec t/Triple)
   module Any] String?
  (first-string
    (related-values propositions module program/represented-by)))

(defn source-anchor-span
  [source-anchor read/ProgramSourceAnchor] t/Triple?
  (let [kind Keyword (read/programsourceanchor-kind source-anchor)
        anchor Any (read/programsourceanchor-anchor source-anchor)
        detail Any (read/programsourceanchor-detail source-anchor)]
    (cond
      (and (= binding-anchor kind) (span-term? detail)) detail
      (and (= reference-anchor kind)
           (t/triple? anchor)
           (span-term? (t/triple-t3 anchor)))
      (t/triple-t3 anchor)
      :else nil)))

(defn source-anchor-valid?
  [propositions (Vec t/Triple)
   root Any
   source-anchor read/ProgramSourceAnchor] Bool
  (let [module Any (read/programsourceanchor-module source-anchor)
        anchor Any (read/programsourceanchor-anchor source-anchor)
        kind Keyword (read/programsourceanchor-kind source-anchor)
        detail Any (read/programsourceanchor-detail source-anchor)]
    (and
      (t/term? module)
      (t/term? anchor)
      (proposition-live?
        propositions
        (t/triple root program/contains module))
      (module-contains? propositions module anchor)
      (cond
        (= binding-anchor kind)
        (and
          (span-term? detail)
          (program/binding-identity-for-module? module anchor)
          (proposition-live?
            propositions
            (t/triple anchor program/member-of program/bindings))
          (proposition-live?
            propositions
            (t/triple anchor program/has-span detail)))

        (= reference-anchor kind)
        (and
          (t/term? detail)
          (reference-term-for-module? module anchor)
          (proposition-live?
            propositions
            (t/triple anchor program/member-of program/references))
          (proposition-live?
            propositions
            (t/triple anchor program/refers-to detail)))

        :else false))))

(defn anchors-for-module
  [source-anchors (Vec read/ProgramSourceAnchor)
   module Any] (Vec read/ProgramSourceAnchor)
  (filterv
    (fn [source-anchor read/ProgramSourceAnchor] Bool
      (= module (read/programsourceanchor-module source-anchor)))
    source-anchors))

(defn project-anchor
  [source-anchor read/ProgramSourceAnchor
   edits (Vec SourceEdit)
   old-width Int
   new-width Int] AnchorProjection?
  (let [before-span t/Triple? (source-anchor-span source-anchor)]
    (if (nil? before-span)
      nil
      (let [after-span t/Triple?
            (remap-span before-span edits old-width new-width)]
        (if (nil? after-span)
          nil
          (let [module Any (read/programsourceanchor-module source-anchor)
                kind Keyword (read/programsourceanchor-kind source-anchor)
                before-anchor Any (read/programsourceanchor-anchor source-anchor)
                after-anchor Any (cond
                  (= reference-anchor kind)
                  (t/triple module program/has-span after-span)

                  :else before-anchor)]
            (->AnchorProjection
              module kind before-anchor after-anchor
              before-span after-span)))))))

(defn project-anchors
  [source-anchors (Vec read/ProgramSourceAnchor)
   module Any
   edits (Vec SourceEdit)
   old-width Int
   new-width Int] (Vec AnchorProjection)
  (reduce
    (fn
      [projected (Vec AnchorProjection)
       source-anchor read/ProgramSourceAnchor] (Vec AnchorProjection)
      (let [projection AnchorProjection? (project-anchor source-anchor edits old-width new-width)]
        (if (some? projection) (conj projected projection) projected)))
    empty-anchor-projections
    (anchors-for-module source-anchors module)))

(defn target-module
  [propositions (Vec t/Triple)
   root Any
   binding Any
   binding-module Any
   target Any] Any
  (if (= target binding)
    binding-module
    (if (and (t/triple? target)
             (contains-value? (root-modules propositions root)
                              (t/triple-t1 target)))
      (t/triple-t1 target)
      nil)))

(defn targets-for-module
  [propositions (Vec t/Triple)
   root Any
   binding Any
   binding-module Any
   references-for-binding (Vec Any)
   module Any] (Vec Any)
  (reduce
    (fn
      [targets (Vec Any)
       target Any] (Vec Any)
      (if (= module
             (target-module
               propositions root binding binding-module target))
        (conj targets target)
        targets))
    empty-any
    (into [binding] references-for-binding)))

(defn source-delta-for-module
  [propositions (Vec t/Triple)
   root Any
   binding Any
   binding-module Any
   references-for-binding (Vec Any)
   source-anchors (Vec read/ProgramSourceAnchor)
   module Any
   old-name String
   new-name String] SourceDelta?
  (let [targets (Vec Any) (targets-for-module
          propositions root binding binding-module
          references-for-binding module)
        source String? (module-source propositions module)]
    (if (or (empty? targets) (nil? source))
      nil
      (let [edits (Vec SourceEdit) (reduce
              (fn
                [collected (Vec SourceEdit)
                 target Any] (Vec SourceEdit)
                (let [edit SourceEdit? (source-edit propositions module binding target)]
                  (if (some? edit) (conj collected edit) collected)))
              empty-edits
              targets)]
        (if (not= (count edits) (count targets))
          nil
          (let [ordered (Vec SourceEdit) (canonical-edits edits)
                projected String? (apply-source-edits source old-name new-name ordered)
                local-anchors (Vec read/ProgramSourceAnchor) (anchors-for-module source-anchors module)
                projected-anchors (Vec AnchorProjection) (project-anchors
                  source-anchors module ordered
                  (count (utf8-encode old-name))
                  (count (utf8-encode new-name)))]
            (if (and
                  (some? projected)
                  (= (count local-anchors) (count projected-anchors)))
              (->SourceDelta
                module source projected ordered projected-anchors)
              nil)))))))

(defn source-deltas
  [propositions (Vec t/Triple)
   root Any
   binding Any
   binding-module Any
   references-for-binding (Vec Any)
   source-anchors (Vec read/ProgramSourceAnchor)
   old-name String
   new-name String] (Vec SourceDelta)
  (reduce
    (fn
      [deltas (Vec SourceDelta)
       module Any] (Vec SourceDelta)
      (let [targets (Vec Any) (targets-for-module
              propositions root binding binding-module
              references-for-binding module)]
        (if (empty? targets)
          deltas
          (let [delta SourceDelta? (source-delta-for-module
                  propositions root binding binding-module
                  references-for-binding source-anchors module
                  old-name new-name)]
            (if (some? delta) (conj deltas delta) deltas)))))
    empty-deltas
    (root-modules propositions root)))

(defn source-deltas-complete?
  [deltas (Vec SourceDelta)
   reference-count Int] Bool
  (= (+ reference-count 1)
     (reduce
       (fn
         [total Int
          delta SourceDelta] Int
         (+ total (count (sourcedelta-edits delta))))
       0
       deltas)))


(defn distinct-terms? [values (Vec Any)] Bool
  (= (count values)
     (count
       (reduce
         (fn
           [unique (Vec Any)
            value Any] (Vec Any)
           (append-unique unique value))
         empty-any
         values))))

(defn source-anchor-key [source-anchor read/ProgramSourceAnchor] Any
  [(read/programsourceanchor-module source-anchor)
   (read/programsourceanchor-anchor source-anchor)])

(defn distinct-source-anchors?
  [source-anchors (Vec read/ProgramSourceAnchor)] Bool
  (= (count source-anchors)
     (count
       (reduce
         (fn
           [keys (Vec Any)
            source-anchor read/ProgramSourceAnchor] (Vec Any)
           (append-unique keys (source-anchor-key source-anchor)))
         empty-any
         source-anchors))))

(defn selected-binding-anchors
  [source-anchors (Vec read/ProgramSourceAnchor)
   binding Any] (Vec read/ProgramSourceAnchor)
  (filterv
    (fn [source-anchor read/ProgramSourceAnchor] Bool
      (and
        (= binding-anchor (read/programsourceanchor-kind source-anchor))
        (= binding (read/programsourceanchor-anchor source-anchor))))
    source-anchors))

(defn reference-anchor-present?
  [source-anchors (Vec read/ProgramSourceAnchor)
   reference Any] Bool
  (some?
    (some
      (fn [source-anchor read/ProgramSourceAnchor]
        read/ProgramSourceAnchor?
        (if (and
              (= reference-anchor
                 (read/programsourceanchor-kind source-anchor))
              (= reference (read/programsourceanchor-anchor source-anchor)))
          source-anchor
          nil))
      source-anchors)))

(defn affected-module?
  [modules (Vec Any)
   module Any] Bool
  (contains-value? modules module))

(defn selected-target-modules
  [binding-module Any
   selected-references (Vec Any)] (Vec Any)
  (reduce
    (fn
      [modules (Vec Any)
       reference Any] (Vec Any)
      (if (t/triple? reference)
        (append-unique modules (t/triple-t1 reference))
        modules))
    [binding-module]
    selected-references))

(defn source-anchor-modules
  [source-anchors (Vec read/ProgramSourceAnchor)] (Vec Any)
  (reduce
    (fn
      [modules (Vec Any)
       source-anchor read/ProgramSourceAnchor] (Vec Any)
      (append-unique
        modules (read/programsourceanchor-module source-anchor)))
    empty-any
    source-anchors))

(defn same-term-set?
  [left (Vec Any)
   right (Vec Any)] Bool
  (and
    (= (count left) (count right))
    (every?
      (fn [value Any] Bool (contains-value? right value))
      left)))

(defn reference-selection-valid?
  [propositions (Vec t/Triple)
   root Any
   binding Any
   reference Any] Bool
  (and
    (t/triple? reference)
    (let [module Any (t/triple-t1 reference)]
      (and
        (reference-term-for-module? module reference)
        (proposition-live?
          propositions
          (t/triple root program/contains module))
        (module-contains? propositions module reference)
        (proposition-live?
          propositions
          (t/triple reference program/member-of program/references))
        (proposition-live?
          propositions
          (t/triple reference program/refers-to binding))))))

(defn scope-binding-valid?
  [propositions (Vec t/Triple)
   module Any
   selected-binding Any
   scope-binding read/ProgramScopeBinding] Bool
  (let [scope Any (read/programscopebinding-scope scope-binding)
        binding Any (read/programscopebinding-binding scope-binding)
        name String (read/programscopebinding-name scope-binding)]
    (and
      (= module scope)
      (not= selected-binding binding)
      (program/binding-identity-for-module? module binding)
      (module-contains? propositions module binding)
      (proposition-live?
        propositions
        (t/triple binding program/member-of program/bindings))
      (proposition-live?
        propositions
        (t/triple binding program/named name)))))

(defn same-module-name-collision?
  [selection read/ProgramRenameSelection
   new-name String] Bool
  (some?
    (some
      (fn [scope-binding read/ProgramScopeBinding]
        read/ProgramScopeBinding?
        (if (= new-name (read/programscopebinding-name scope-binding))
          scope-binding
          nil))
      (read/programrenameselection-scope-bindings selection))))

(defn rename-selection-valid?
  [propositions (Vec t/Triple)
   root Any
   selection read/ProgramRenameSelection] Bool
  (let [binding Any (read/programrenameselection-binding selection)
        module Any (read/programrenameselection-module selection)
        name String (read/programrenameselection-name selection)
        span Any (read/programrenameselection-span selection)
        selected-references (Vec Any) (read/programrenameselection-references selection)
        invalidated (Vec Any) (read/programrenameselection-dependents selection)
        source-anchors (Vec read/ProgramSourceAnchor) (read/programrenameselection-source-anchors selection)
        scope-bindings (Vec read/ProgramScopeBinding) (read/programrenameselection-scope-bindings selection)
        binding-anchors (Vec read/ProgramSourceAnchor) (selected-binding-anchors source-anchors binding)
        modules (Vec Any) (selected-target-modules module selected-references)]
    (and
      (t/term? binding)
      (t/term? module)
      (span-term? span)
      (program/binding-identity-for-module? module binding)
      (proposition-live?
        propositions
        (t/triple root program/contains module))
      (module-contains? propositions module binding)
      (proposition-live?
        propositions
        (t/triple binding program/member-of program/bindings))
      (proposition-live?
        propositions
        (t/triple binding program/named name))
      (proposition-live?
        propositions
        (t/triple binding program/has-span span))
      (same-term-set? modules (source-anchor-modules source-anchors))
      (every?
        (fn [affected-module Any] Bool
          (and
            (t/term? affected-module)
            (proposition-live?
              propositions
              (t/triple root program/contains affected-module))))
        modules)
      (distinct-terms? selected-references)
      (every?
        (fn [reference Any] Bool
          (and
            (reference-selection-valid?
              propositions root binding reference)
            (affected-module? modules (t/triple-t1 reference))
            (reference-anchor-present? source-anchors reference)))
        selected-references)
      (distinct-terms? invalidated)
      (every?
        (fn [resource Any] Bool (t/term? resource))
        invalidated)
      (distinct-source-anchors? source-anchors)
      (every?
        (fn [source-anchor read/ProgramSourceAnchor] Bool
          (and
            (affected-module?
              modules (read/programsourceanchor-module source-anchor))
            (source-anchor-valid? propositions root source-anchor)))
        source-anchors)
      (distinct-terms?
        (mapv read/programscopebinding-binding scope-bindings))
      (every?
        (fn [scope-binding read/ProgramScopeBinding] Bool
          (scope-binding-valid?
            propositions module binding scope-binding))
        scope-bindings)
      (= 1 (count binding-anchors))
      (let [binding-anchor-row read/ProgramSourceAnchor (first binding-anchors)]
        (and
          (= module
             (read/programsourceanchor-module binding-anchor-row))
          (= span
             (read/programsourceanchor-detail binding-anchor-row)))))))

(defn selection-binding-module
  [selection read/ProgramRenameSelection] Any
  (read/programrenameselection-module selection))

(defn assert-operation [proposition t/Triple] t/CommitOperation
  (t/->CommitOperation t/assert-action proposition))

(defn retract-operation [proposition t/Triple] t/CommitOperation
  (t/->CommitOperation t/retract-action proposition))

(defn source-delta-operations [deltas (Vec SourceDelta)] (Vec t/CommitOperation)
  (reduce
    (fn [operations (Vec t/CommitOperation) delta SourceDelta]
      (Vec t/CommitOperation)
      (let [module Any (sourcedelta-module delta)]
        (conj
          (conj operations
            (retract-operation
              (t/triple
                module program/represented-by (sourcedelta-before delta))))
          (assert-operation
            (t/triple
              module program/represented-by (sourcedelta-after delta))))))
    empty-operations
    deltas))

(defn anchor-projections [deltas (Vec SourceDelta)] (Vec AnchorProjection)
  (reduce
    (fn
      [projections (Vec AnchorProjection)
       delta SourceDelta] (Vec AnchorProjection)
      (into projections (sourcedelta-anchors delta)))
    empty-anchor-projections
    deltas))

(defn anchor-replacements [projections (Vec AnchorProjection)] (Vec TermReplacement)
  (reduce
    (fn
      [replacements (Vec TermReplacement)
       projection AnchorProjection] (Vec TermReplacement)
      (let [before Any (anchorprojection-before-anchor projection)
            after Any (anchorprojection-after-anchor projection)]
        (if (not= before after)
          (conj replacements (->TermReplacement before after))
          replacements)))
    empty-replacements
    projections))

(defn direct-replacement
  [replacements (Vec TermReplacement)
   value Any] Any
  (some
    (fn [replacement TermReplacement] Any
      (if (= value (termreplacement-before replacement))
        (termreplacement-after replacement)
        nil))
    replacements))

(defn replace-term
  [replacements (Vec TermReplacement)
   value Any] Any
  (let [direct Any (direct-replacement replacements value)]
    (if (some? direct)
      direct
      (if (t/triple? value)
        (t/triple
          (replace-term replacements (t/triple-t1 value))
          (replace-term replacements (t/triple-t2 value))
          (replace-term replacements (t/triple-t3 value)))
        value))))

(defn replace-proposition
  [replacements (Vec TermReplacement)
   proposition t/Triple] t/Triple
  (t/triple
    (replace-term replacements (t/triple-t1 proposition))
    (replace-term replacements (t/triple-t2 proposition))
    (replace-term replacements (t/triple-t3 proposition))))

(defn stable-binding-span-operations [projections (Vec AnchorProjection)] (Vec t/CommitOperation)
  (reduce
    (fn [operations (Vec t/CommitOperation)
         projection AnchorProjection] (Vec t/CommitOperation)
      (let [before-span t/Triple (anchorprojection-before-span projection)
            after-span t/Triple (anchorprojection-after-span projection)]
        (if (and
              (= binding-anchor (anchorprojection-kind projection))
              (= (anchorprojection-before-anchor projection)
                 (anchorprojection-after-anchor projection))
              (not= before-span after-span))
          (conj
            (conj operations
              (retract-operation
                (t/triple
                  (anchorprojection-before-anchor projection)
                  program/has-span before-span)))
            (assert-operation
              (t/triple
                (anchorprojection-after-anchor projection)
                program/has-span after-span)))
          operations)))
    empty-operations
    projections))

(defn anchor-rewrite-operations
  [propositions (Vec t/Triple)
   replacements (Vec TermReplacement)] (Vec t/CommitOperation)
  (if (empty? replacements)
    empty-operations
    (reduce
      (fn [operations (Vec t/CommitOperation)
           proposition t/Triple] (Vec t/CommitOperation)
        (let [rewritten t/Triple (replace-proposition replacements proposition)]
          (if (= proposition rewritten)
            operations
            (conj
              (conj operations (retract-operation proposition))
              (assert-operation rewritten)))))
      empty-operations
      propositions)))

(defn anchor-operations
  [propositions (Vec t/Triple)
   deltas (Vec SourceDelta)] (Vec t/CommitOperation)
  (let [projections (Vec AnchorProjection) (anchor-projections deltas)
        replacements (Vec TermReplacement) (anchor-replacements projections)]
    (into
      (stable-binding-span-operations projections)
      (anchor-rewrite-operations propositions replacements))))

(defn root-transition-operations
  [base-root program/ProgramRoot
   next-root-resource t/Term] (Vec t/CommitOperation)
  (let [propositions (Vec t/Triple) (program/programroot-propositions base-root)
        base-resource Any (program/root-resource-value base-root)
        next-resource Any next-root-resource
        profile Any (program/profile-value base-root)]
    (reduce
      (fn [operations (Vec t/CommitOperation) module Any]
        (Vec t/CommitOperation)
        (conj operations
          (assert-operation
            (t/triple next-resource program/contains module))))
      [(assert-operation
         (t/triple
           next-resource program/member-of program/program-roots))
       (assert-operation
         (t/triple next-resource program/admitted-by profile))
       (assert-operation
         (t/triple next-resource program/derived-from base-resource))]
      (root-modules propositions base-resource))))

(defn rename-operations
  [base-root program/ProgramRoot
   next-root-resource t/Term
   binding Any
   old-name String
   new-name String
   deltas (Vec SourceDelta)] (Vec t/CommitOperation)
  (let [propositions (Vec t/Triple) (program/programroot-propositions base-root)]
    (into
      [(retract-operation (t/triple binding program/named old-name))
       (assert-operation (t/triple binding program/named new-name))]
      (into
        (source-delta-operations deltas)
        (into
          (anchor-operations propositions deltas)
          (root-transition-operations base-root next-root-resource))))))

(defn remove-proposition
  [propositions (Vec t/Triple)
   target t/Triple] (Vec t/Triple)
  (loop [remaining (Vec t/Triple) propositions
         retained (Vec t/Triple) empty-triples
         removed Bool false]
    (if (empty? remaining)
      retained
      (let [candidate t/Triple (first remaining)]
        (if (and (not removed) (= candidate target))
          (recur (vec (rest remaining)) retained true)
          (recur
            (vec (rest remaining))
            (conj retained candidate)
            removed))))))

(defn apply-operations
  [propositions (Vec t/Triple)
   operations (Vec t/CommitOperation)] (Vec t/Triple)
  (reduce
    (fn [overlay (Vec t/Triple) operation t/CommitOperation]
      (Vec t/Triple)
      (let [proposition t/Triple (t/commitoperation-proposition operation)]
        (if (= t/assert-action (t/commitoperation-action operation))
          (if (proposition-live? overlay proposition)
            overlay
            (conj overlay proposition))
          (remove-proposition overlay proposition))))
    propositions
    operations))

(defn reject
  [code Keyword
   detail String] RenamePlan
  (->RenameRejected code detail))

(defn- plan-canonical-rename
  [base-root program/ProgramRoot
   next-root-resource t/Term
   selection read/ProgramRenameSelection
   new-name String] RenamePlan
  (let [propositions (Vec t/Triple) (program/programroot-propositions base-root)
        base-resource Any (program/root-resource-value base-root)
        next-resource Any next-root-resource
        expected-version Int (program/programroot-store-version base-root)
        binding Any (read/programrenameselection-binding selection)
        binding-module Any (selection-binding-module selection)
        selected-references (Vec Any) (read/programrenameselection-references selection)
        invalidated (Vec Any) (read/programrenameselection-dependents selection)
        source-anchors (Vec read/ProgramSourceAnchor) (read/programrenameselection-source-anchors selection)
        old-name String (read/programrenameselection-name selection)
        stored-name String? (first-string
          (related-values propositions binding program/named))]
    (cond
      (not (and (t/term? next-resource) (t/term? binding)))
      (reject :rename/invalid-term
        "next root and binding identities must be Store Terms")

      (not (program/admitted-root? base-root))
      (reject :rename/root-not-admitted
        "base root must pass canonical ProgramRoot admission")

      (= base-resource next-resource)
      (reject :rename/invalid-transition
        "rename requires a distinct next root resource")

      (proposition-live?
        propositions
        (t/triple next-resource program/member-of program/program-roots))
      (reject :rename/next-root-exists
        "next root must name a new durable program view")

      (not (rename-selection-valid?
             propositions base-resource selection))
      (reject :rename/binding-scope
        "rename selection must contain only root-scoped semantic Terms")

      (or (nil? stored-name) (not= stored-name old-name))
      (reject :rename/name-cardinality
        "selection must match the binding's one canonical String name")

      (= "" new-name)
      (reject :rename/invalid-name "new binding name must be non-empty")

      (= old-name new-name)
      (reject :rename/unchanged "new binding name must differ")

      (same-module-name-collision? selection new-name)
      (reject :rename/name-collision
        "new name collides with another binding in the selected module")

      :else
      (let [deltas (Vec SourceDelta) (source-deltas
              propositions base-resource binding binding-module
              selected-references source-anchors old-name new-name)]
        (if (not (source-deltas-complete?
                   deltas (count selected-references)))
          (reject :rename/source-projection
            "every selected binding/reference span must project exact source bytes")
          (let [operations (Vec t/CommitOperation) (rename-operations
                  base-root next-root-resource binding old-name new-name deltas)
                overlay (Vec t/Triple) (apply-operations propositions operations)]
            (match
              (program/next-root
                base-root next-root-resource overlay)
              [(program/ProgramRejected code detail)
               (reject :rename/invalid-overlay detail)]
              [(program/ProgramAdmitted candidate)
               (->RenamePlanned
                 (->ProgramTransaction
                   base-root candidate expected-version binding old-name
                   new-name selected-references operations deltas invalidated)
                 (->RenamePreview
                   candidate binding old-name new-name selected-references
                   operations deltas invalidated))])))))))

(defn plan-rename
  [base-root program/ProgramRoot
   next-root-resource t/Term
   selected-binding Any
   new-name String] RenamePlan
  (if (not (t/term? selected-binding))
    (reject :rename/invalid-term
      "selected binding identity must be a Store Term")
    (match (read/rename-selection base-root selected-binding)
      [(read/ProgramRenameSelectionRejected code detail)
       (reject :rename/selection-rejected detail)]
      [(read/ProgramRenameSelected selection)
       (plan-canonical-rename
         base-root next-root-resource selection new-name)])))

(defn preview [transaction ProgramTransaction] RenamePreview
  (->RenamePreview
    (programtransaction-candidate-root transaction)
    (programtransaction-selected-binding transaction)
    (programtransaction-old-name transaction)
    (programtransaction-new-name transaction)
    (programtransaction-references transaction)
    (programtransaction-operations transaction)
    (programtransaction-source-deltas transaction)
    (programtransaction-invalidated transaction)))

(defn same-proposition-set?
  [left (Vec t/Triple)
   right (Vec t/Triple)] Bool
  (let [unique-left (Vec t/Triple) (reduce
          (fn [unique (Vec t/Triple)
               proposition t/Triple] (Vec t/Triple)
            (if (proposition-live? unique proposition)
              unique
              (conj unique proposition)))
          empty-triples
          left)
        unique-right (Vec t/Triple) (reduce
          (fn [unique (Vec t/Triple)
               proposition t/Triple] (Vec t/Triple)
            (if (proposition-live? unique proposition)
              unique
              (conj unique proposition)))
          empty-triples
          right)]
    (and
      (= (count unique-left) (count unique-right))
      (every?
        (fn [proposition t/Triple] Bool
          (proposition-live? unique-right proposition))
        unique-left)
      (every?
        (fn [proposition t/Triple] Bool
          (proposition-live? unique-left proposition))
        unique-right))))

(defn same-root-semantics?
  [left program/ProgramRoot
   right program/ProgramRoot] Bool
  (and
    (= (program/programroot-space-id left)
       (program/programroot-space-id right))
    (= (program/root-resource-value left)
       (program/root-resource-value right))
    (= (program/programroot-store-version left)
       (program/programroot-store-version right))
    (= (program/profile-value left) (program/profile-value right))
    (same-proposition-set?
      (program/programroot-propositions left)
      (program/programroot-propositions right))))

(defn verify-rematerialized
  [transaction ProgramTransaction
   canonical-candidate program/ProgramRoot] RematerializationResult
  (match (program/validate-root canonical-candidate)
    [(program/ProgramRejected code detail)
     (->RematerializationRejected
       :rename/rematerialization-invalid detail)]
    [(program/ProgramAdmitted admitted)
     (if (same-root-semantics?
           (programtransaction-candidate-root transaction) admitted)
       (->RematerializationVerified
         (->VerifiedRematerialization transaction admitted))
       (->RematerializationRejected
         :rename/rematerialization-mismatch
         "canonical native reprojection differs from the planned candidate root"))]))

(defn prepare-commit
  [verified VerifiedRematerialization
   observed-space-id String
   observed-version Int] CommitDecision
  (let [transaction ProgramTransaction (verifiedrematerialization-transaction verified)
        expected-space-id String (program/programroot-space-id
          (programtransaction-base-root transaction))
        expected-version Int (programtransaction-expected-version transaction)]
    (if (and (= expected-space-id observed-space-id)
             (= expected-version observed-version))
      (->CommitReady
        expected-space-id expected-version
        (verifiedrematerialization-candidate-root verified)
        (programtransaction-operations transaction))
      (->CommitConflict
        expected-space-id observed-space-id
        expected-version observed-version))))

(defn commit-receipt
  [transaction ProgramTransaction
   transaction-coordinate t/Triple] CommitReceiptResult
  (if (not (t/transaction-coordinate? transaction-coordinate))
    (->CommitReceiptRejected
      :rename/invalid-commit-coordinate
      "commit receipt requires a Store transaction coordinate")
    (let [space-value Any (t/triple-t1 transaction-coordinate)
          served-version Int (t/triple-t3 transaction-coordinate)
          expected-space-id String (program/programroot-space-id
            (programtransaction-base-root transaction))
          expected-next Int (inc (programtransaction-expected-version transaction))]
      (if (not (and
                 (= space-value expected-space-id)
                 (= served-version expected-next)))
        (->CommitReceiptRejected
          :rename/commit-version
          "commit coordinate must match the pinned Store space and next version")
        (->CommitReceiptAccepted
          (->ProgramCommitReceipt
            (program/root-resource-value
              (programtransaction-candidate-root transaction))
            served-version
            (loop [ordinal Int 0
                   occurrences (Vec t/Triple) empty-triples]
              (if (>= ordinal
                      (count
                        (programtransaction-operations transaction)))
                occurrences
                (recur
                  (inc ordinal)
                  (conj occurrences
                    (t/occurrence-coordinate
                      transaction-coordinate ordinal)))))))))))
