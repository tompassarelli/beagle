typedef uint32_t ffc_outcome;
enum ffc_outcome_bits {
  FFC_OUTCOME_OK = 0,
  FFC_OUTCOME_INVALID_INPUT = 1,
  FFC_OUTCOME_OUT_OF_RANGE = 2,
};

typedef struct ffc_result {
  // Where parsing stopped
  char const *ptr;
  // The outcome of the call
