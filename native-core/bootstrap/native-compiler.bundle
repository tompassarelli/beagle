#ifndef ffc_internal
#define ffc_internal static
#endif

#ifndef ffc_inline
#if defined(_MSC_VER)
  #define ffc_inline __forceinline
#elif defined(__GNUC__) || defined(__clang__)
  #define ffc_inline __attribute__((always_inline)) inline
#else
  #define ffc_inline inline
