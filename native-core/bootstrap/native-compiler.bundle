#undef FFC_FLOAT_MIN_EXPONENT_ROUND_TO_EVEN
#undef FFC_FLOAT_MAX_EXPONENT_ROUND_TO_EVEN
#undef FFC_FLOAT_MAX_EXPONENT_FAST_PATH
#undef FFC_FLOAT_MAX_MANTISSA_FAST_PATH
