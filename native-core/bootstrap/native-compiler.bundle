#define FFC_API

#define FFC_VERSION_YEAR  26
#define FFC_VERSION_MONTH 07
#define FFC_VERSION_BUILD 01
#define FFC_VERSION ((FFC_VERSION_YEAR << 16) | (FFC_VERSION_MONTH << 8) | (FFC_VERSION_BUILD))
