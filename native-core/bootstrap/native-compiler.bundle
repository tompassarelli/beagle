  (void)fclose(input);
  input = NULL;
  input_descriptor = -1;
  (void)close(stdout_pipe[1]);
  stdout_pipe[1] = -1;
  (void)close(stderr_pipe[1]);
  stderr_pipe[1] = -1;

  status = 0;
  while ((stdout_pipe[0] >= 0) || (stderr_pipe[0] >= 0)) {
    struct pollfd descriptors[2] = {
        {stdout_pipe[0], POLLIN, 0}, {stderr_pipe[0], POLLIN, 0}};
    int ready;
    do {
      ready = poll(descriptors, (nfds_t)2U, -1);
