        ((descriptors[0].revents & (POLLIN | POLLHUP | POLLERR)) != 0)) {
      status = native_host_process_drain(
          &stdout_pipe[0], stdout_buffer, bound, &stdout_length,
          &stdout_overflow);
      if (status != 0) {
