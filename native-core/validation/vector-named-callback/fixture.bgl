#lang beagle

(ns native.vector-named-callback
  (:require [native.vector-named-callback-provider :as provider]))

(defrecord ReduceRule
  [head String
   body (Vec String)])

(defn insert-sorted [values (Vec String) value String] (Vec String)
  (loop [index Int 0 prefix (Vec String) []]
    (if (>= index (count values))
      (conj prefix value)
      (let [current String (nth values index)]
        (if (neg? (compare value current))
          (reduce conj (conj prefix value) (subvec values index))
          (recur (+ index 1) (conj prefix current)))))))

(defn rule-head-relations [rules (Vec ReduceRule)] (Vec String)
  (vec (reduce (fn
                 [relations (Set String)
                  value ReduceRule] (Set String)
                 (conj relations (reducerule-head value)))
               #{} rules)))

(defn positive-relation-names [rules (Vec ReduceRule)] (Vec String)
  (vec
    (reduce
      (fn
        [relations (Set String)
         value ReduceRule] (Set String)
        (reduce (fn
                  [current (Set String)
                   relation String] (Set String)
                  (conj current relation))
          relations (reducerule-body value)))
      #{} rules)))

(defn -main [args (Vec String)] Int
  (let [values (Vec provider/Item) [(provider/->Item 4) (provider/->Item 9)]
        mapped (Vec Int) (mapv provider/item-to-int values)
        filtered (Vec provider/Item) (filterv provider/item-positive? values)
        all-positive Bool (every? provider/item-positive? values)
        found (U Int Nil) (some provider/item-present values)
        total Int (reduce provider/item-add 0 values)
        appended (Vec String) (reduce conj ["seed"] args)
        shadowed (Vec String) (reduce provider/conj ["seed"] args)
        left (Set String) (set ["seed"])
        right (Set String) (set args)
        joined (Set String) (into left right)
        sorted (Vec String) (insert-sorted ["alpha" "omega"] "middle")
        rules (Vec ReduceRule) [(->ReduceRule "head-a" ["body-a" "body-b"])
                                (->ReduceRule "head-b" ["body-b"])]
        heads (Vec String) (rule-head-relations rules)
        positives (Vec String) (positive-relation-names rules)]
    (if (and (= (count mapped) 2)
             (= (nth mapped 1) 9)
             (= (count filtered) 2)
             all-positive
             (= found 9)
             (= total 13)
             (= (count appended) (+ 1 (count args)))
             (= appended shadowed)
             (contains? joined "seed")
             (= (count joined) (+ 1 (count (set args))))
             (= (count sorted) 3)
             (= (nth sorted 0) "alpha")
             (= (nth sorted 1) "middle")
             (= (nth sorted 2) "omega")
             (= (count heads) 2)
             (contains? (set heads) "head-a")
             (contains? (set heads) "head-b")
             (= (count positives) 2)
             (contains? (set positives) "body-a")
             (contains? (set positives) "body-b"))
      0 1)))
