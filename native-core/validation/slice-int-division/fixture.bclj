#lang beagle/clj
(ns native.int-division)
(define-mode strict)

(defn quot-int
  [left: Int
   right: Int] -> Int
  (quot left right))

(defn rem-int
  [left: Int
   right: Int] -> Int
  (rem left right))

(defn mod-int
  [left: Int
   right: Int] -> Int
  (mod left right))

(defn variadic-add
  [first: Int
   second: Int
   third: Int] -> Int
  (+ first second third))

(defn variadic-multiply
  [first: Int
   second: Int
   third: Int] -> Int
  (* first second third))

(defn unary-negate [value: Int] -> Int
  (- value))

(defn literal-keyword-equal? [] -> Bool
  (= (keyword "-") (keyword "-")))
