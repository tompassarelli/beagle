#lang beagle
;; The coercion rule's own fixture: the smallest module in which widening into
;; the closure of Any and narrowing back out of it are both reachable from C.
;; store.types has no unguarded narrowing, so its slice cannot fire the trap.
(ns fixture.union
  (:require [clojure.string :as str]))

(defrecord Pair [(left Int) (right Int)])

;; Beagle Store's slot hash accepts Any in a program that also declares mutable index
;; records. Those unrelated record alternatives must not make every dynamic
;; SliceValue hash site unlowerable; the active union tag still selects the
;; descriptor walked at runtime.
(defrecord StoreIndex [(cells (Vec (Atom (Vec Int))))])

;; A finite recursive value repeats the SliceValue descriptor at different
;; addresses. Active-path validation must not confuse that with a value cycle.
(defrecord RecursiveValue [(next Any)])

;; Set storage is an opaque runtime reference, not a semantic record reference.
;; Selecting this active Any branch must trap before dereferencing it.
(defrecord OpaqueIndex [(members (Set Int))])

;; Equality and comparison must validate the whole active value before an
;; earlier differing field can short-circuit past this unsupported field.
(defrecord LateUnsafe [(prefix Int) (cells (Vec (Atom (Vec Int))))])

(defn pair? [(v Any)] Bool (instance? Pair v))

;; Widening: the declared return closes to the Any union, so the body's Int is
;; injected under the i64 tag. Nothing can fail.
(defn wrap-int [(v Int)] Any v)

;; Narrowing: the accessor's operand is statically the union and the expected
;; variant is known, so this is a direct checked extract. A value carrying any
;; other tag traps instead of reading the payload as a Pair reference.
(defn pair-left-of [(v Any)] Int (pair-left v))

(defn pair-right-of [(v Any)] Int (pair-right v))

;; Same-domain Any equality follows the union closure: tags first, then
;; the selected scalar payload or the boxed record's fields.
(defn any-equal? [(left Any) (right Any)] Bool
  (= left right))

(defn any-hash [(value Any)] Int
  (hash value))

(defn any-compare [(left Any) (right Any)] Int
  (compare left right))

;; A narrowed record crosses a by-value return boundary. The native program
;; extracts its reference payload, then materializes a checked shallow copy.
(defn pair-copy-of [(value Any)] Pair
  (if (pair? value)
    value
    (throw (ex-info "expected Pair" {}))))

(defn logic-and [(left Any) (right Any)] Any
  (and left right))

(defn logic-or [(left Any) (right Any)] Any
  (or left right))

(defn logic-three-and [(left Any) (middle Any) (right Any)] Any
  (and left middle right))

(defn logic-three-or [(left Any) (middle Any) (right Any)] Any
  (or left middle right))

(defn logic-false-or-int [(value Int)] Any
  (or false value))

(defn logic-true-and-int [(value Int)] Any
  (and true value))

(defn logic-empty-and [] Bool (and))

(defn logic-empty-or [] Nil (or))

(defn logic-single-and [(value Any)] Any (and value))

(defn logic-single-or [(value Any)] Any (or value))

(defn logic-or-skips [(value Any)] Any
  (or value (throw nil)))

(defn logic-and-skips [(value Any)] Any
  (and value (throw nil)))

(defn cond-mixed [(selector Int)] Any
  (cond
    (= selector 0) "zero"
    (= selector 1) selector
    :else nil))

(defn fail-any [(message String)] Any
  (throw message))

(defn vector-or-fail [(available Bool) (values (Vec Any))] (Vec Any)
  (if available values (fail-any "unavailable")))

(defrecord ValueRow
  [(kind Keyword)
   (text-value String?)
   (int-value Int?)
   (float-value Float?)
   (bool-value Bool?)
   (keyword-value Keyword?)
   (pair-value Pair?)])

(defn classify-value [(value Any)] ValueRow
  (cond
    (string? value) (->ValueRow :string value nil nil nil nil nil)
    (integer? value) (->ValueRow :int nil value nil nil nil nil)
    (number? value) (->ValueRow :float nil nil (double value) nil nil nil)
    (boolean? value) (->ValueRow :bool nil nil nil value nil nil)
    (keyword? value) (->ValueRow :keyword nil nil nil nil value nil)
    (pair? value) (->ValueRow :pair nil nil nil nil nil value)
    :else (throw nil)))

(defrecord TaggedValue [(tag Any)])

(defn tagged-value? [(value Any)] Bool
  (instance? TaggedValue value))

(defn tagged-keyword [(value Any)] Keyword?
  (if (and (tagged-value? value)
           (keyword? (taggedvalue-tag value)))
    (taggedvalue-tag value)
    nil))
(defn false-bool? [(value Bool)] Bool (false? value))

(defn true-bool? [(value Bool)] Bool (true? value))

(defn false-any? [(value Any)] Bool (false? value))

(defn true-any? [(value Any)] Bool (true? value))

(defn false-int? [(value Int)] Bool (false? value))

(defn true-int? [(value Int)] Bool (true? value))

(defn numeric-literal [] Float 1.5)

(defn numeric-int-to-double [(value Int)] Float
  (double value))

(defn numeric-float-to-double [(value Float)] Float
  (double value))

(defn numeric-any-to-double [(value Any)] Float
  (double value))

(defn numeric-float-equal? [(left Float) (right Float)] Bool
  (= left right))

(defn numeric-float-less? [(left Float) (right Float)] Bool
  (< left right))

(defn numeric-float-less-or-equal? [(left Float) (right Float)] Bool
  (<= left right))

(defn numeric-float-greater? [(left Float) (right Float)] Bool
  (> left right))

(defn numeric-float-greater-or-equal? [(left Float) (right Float)] Bool
  (>= left right))

(defn numeric-parse-long [(value String)] Int
  (or (parse-long value) -1))

(defn numeric-parse-long-any [(value Any)] Int
  (if (string? value)
    (or (parse-long value) -1)
    -2))

(defn numeric-int-double-less? [(left Int) (right Int)] Bool
  (< (double left) (double right)))

(defn vector-value? [(value (U (Vec Int) Int))] Bool
  (vector? value))

(defn vector-probe [(values (Vec Int))] Bool
  (vector-value? values))

(defn int-vector? [(value Int)] Bool
  (vector-value? value))

(defn text-ends-with? [(value String) (suffix String)] Bool
  (str/ends-with? value suffix))

(defn maybe-int-if [(available Bool)] Int?
  (if available 7))

(defn maybe-int-when [(available Bool)] Int?
  (when available 9))

;; Dynamic collection equality validates a candidate before an empty lookup or
;; first insertion, then keeps structural collections on the scan path.
(defn empty-any-map [] (Map Any Int) {})

(defn any-map-contains? [(entries (Map Any Int)) (key Any)] Bool
  (contains? entries key))

(defn any-map-assoc
  [(entries (Map Any Int)) (key Any) (value Int)] (Map Any Int)
  (assoc entries key value))

(defn empty-any-set [] (Set Any) #{})

(defn any-set-contains? [(entries (Set Any)) (value Any)] Bool
  (contains? entries value))

(defn any-set-conj [(entries (Set Any)) (value Any)] (Set Any)
  (conj entries value))

(defn any-map-count [(entries (Map Any Int))] Int
  (count entries))

(defn any-map-value [(entries (Map Any Int)) (key Any)] Int
  (get entries key -1))

(defn any-map-dissoc [(entries (Map Any Int)) (key Any)] (Map Any Int)
  (dissoc entries key))

(defn any-set-count [(entries (Set Any))] Int
  (count entries))

(defn any-set-disj [(entries (Set Any)) (value Any)] (Set Any)
  (disj entries value))

(defn transient-any-map! [(key Any) (equal-key Any)] (Map Any Int)
  (persistent!
    (reduce
      (fn [(entries Any) (stage Any)] Any
        (assoc! entries
          (if (= stage 0) key equal-key)
          (if (= stage 0) 1 2)))
      (transient {})
      [0 1])))

(defn transient-any-set! [(value Any) (equal-value Any)] (Set Any)
  (persistent!
    (reduce
      (fn [(entries Any) (entry Any)] Any
        (conj! entries entry))
      (transient #{})
      [value equal-value])))

(defn any-equal-int? [(value Any)] Bool
  (= value 42))

(defn int-equal-any? [(value Any)] Bool
  (= 42 value))

(defn any-not-equal-int? [(value Any)] Bool
  (not= value 42))
