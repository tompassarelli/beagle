#lang beagle/clj
;; The coercion rule's own fixture: the smallest module in which widening into
;; the closure of Any and narrowing back out of it are both reachable from C.
;; fram.types has no unguarded narrowing, so its slice cannot fire the trap.
(ns fixture.union)
(define-mode strict)

(defrecord Pair
  [left: Int
   right: Int])

(defn pair? [v: Any] -> Bool (instance? Pair v))

;; Widening: the declared return closes to the Any union, so the body's Int is
;; injected under the i64 tag. Nothing can fail.
(defn wrap-int [v: Int] -> Any v)

;; Narrowing: the accessor's operand is statically the union and the expected
;; variant is known, so this is a direct checked extract. A value carrying any
;; other tag traps instead of reading the payload as a Pair reference.
(defn pair-left-of [v: Any] -> Int (pair-left v))

(defn pair-right-of [v: Any] -> Int (pair-right v))

;; Same-domain Any equality follows the sealed union closure: tags first, then
;; the selected scalar payload or the boxed record's fields.
(defn any-equal?
  [left: Any
   right: Any] -> Bool
  (= left right))

(defn any-hash [value: Any] -> Int
  (hash value))

(defn any-compare
  [left: Any
   right: Any] -> Int
  (compare left right))

;; A narrowed record crosses a by-value return boundary. The native world
;; extracts its reference payload, then materializes a checked shallow copy.
(defn pair-copy-of [value: Any] -> Pair
  (if (pair? value)
    value
    (throw (ex-info "expected Pair" {}))))

(defn logic-and
  [left: Any
   right: Any] -> Any
  (and left right))

(defn logic-or
  [left: Any
   right: Any] -> Any
  (or left right))

(defn logic-three-and
  [left: Any
   middle: Any
   right: Any] -> Any
  (and left middle right))

(defn logic-three-or
  [left: Any
   middle: Any
   right: Any] -> Any
  (or left middle right))

(defn logic-false-or-int [value: Int] -> Any
  (or false value))

(defn logic-true-and-int [value: Int] -> Any
  (and true value))

(defn logic-empty-and [] -> Bool (and))

(defn logic-empty-or [] -> Nil (or))

(defn logic-single-and [value: Any] -> Any (and value))

(defn logic-single-or [value: Any] -> Any (or value))

(defn logic-or-skips [value: Any] -> Any
  (or value (throw nil)))

(defn logic-and-skips [value: Any] -> Any
  (and value (throw nil)))
