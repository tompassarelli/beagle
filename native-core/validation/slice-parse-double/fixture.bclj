#lang beagle/clj
(ns native.parse-double)
(define-mode strict)

(defn parse-value [(text String)] (U Float Nil)
  (parse-double text))

(defn parsed? [(text String)] Bool
  (some? (parse-double text)))

(defn parsed-bits [(text String)] Int
  (let [value (parse-double text)]
    (if (nil? value)
      0
      (float-to-bits value))))
