#lang beagle
;; Beagle-owned executable witness for the supported rt-core-shaped C17 path.
;; The real Fram projection is audited separately and keeps its one unsupported
;; union-equality function pending; this fixture must not impersonate it.
(ns native.rt-core-supported-probe
  (:require [clojure.string :as str]))

(defn fmt-id [(n String)] String
  (str (subs n 0 4) "-" (subs n 4 6) "-" (subs n 6 8) "-"
    (subs n 8 14)))

(defn bounded-lower [(value String)] String
  (let [lowered (str/lower-case value)]
    (if (> (count lowered) 5) (subs lowered 0 5) lowered)))

(defn probe [] Int
  (if (and (= (fmt-id "20260815123456") "2026-08-15-123456")
        (= (bounded-lower "BEAGLE") "beagl")
        (= (bounded-lower "FRAM") "fram"))
    0
    1))
