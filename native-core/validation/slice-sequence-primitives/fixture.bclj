#lang beagle/clj

(ns fram.sequence-probe)


(defn first-value [(values (Vec Int))] Int
  (first values))

(defn last-value [(values (Vec Int))] Int
  (last values))

(defn peek-value [(values (Vec Int))] Int
  (peek values))

(defn take-values [(amount Int) (values (Vec Int))] (Vec Int)
  (take amount values))

(defn drop-values [(amount Int) (values (Vec Int))] (Vec Int)
  (drop amount values))

(defn sort-values [(values (Vec Int))] (Vec Int)
  (sort values))

(defn sort-texts [(values (Vec String))] (Vec String)
  (sort values))

(defn rest-values [(values (Vec Int))] (Vec Int)
  (rest values))

(defn range-end [(end Int)] (Vec Int)
  (range end))

(defn range-bounds [(start Int) (end Int)] (Vec Int)
  (range start end))

(defn pop-values [(values (Vec Int))] (Vec Int)
  (pop values))
