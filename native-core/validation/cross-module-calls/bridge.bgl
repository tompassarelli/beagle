#lang beagle
(ns native.bridge
  (:require [native.kernel :as kernel]))

(def relay (Fn [Int Int] Int) kernel/advance)

(defn doubled [(state Int)] Int
  (kernel/scale state 2))

(defn integer-signal? [(signal kernel/Signal)] Bool
  (instance? IntegerSignal signal))

(defn append-signals
  [(signals (Vec kernel/Signal))] (Vec kernel/Signal)
  (conj signals
    (kernel/->IntegerSignal 42)
    (kernel/->TextSignal "forty-two")))
