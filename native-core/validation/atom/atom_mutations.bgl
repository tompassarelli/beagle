#lang beagle
(ns native.atom-mutations)

(defrecord Counter [(value Int)])
(defalias CounterMap (Map Keyword Int))

(defn direct-update [(counter Counter) (delta Int)] Counter
  (update counter :value
    (fn [(current Int)] Int (+ current delta))))

(defn make-counter-cell [(initial Int)] (Atom Counter)
  (atom (->Counter initial)))

(defn make-vector-cell [(initial Int)] (Atom (Vec Int))
  (atom [initial]))

(defn reset-counter! [(cell (Atom Counter)) (replacement Counter)] Counter
  (reset! cell replacement))

(defn update-counter! [(cell (Atom Counter)) (delta Int)] Counter
  (swap! cell update :value
    (fn [(current Int)] Int (+ current delta))))

(defn assoc-counter! [(cell (Atom Counter)) (replacement Int)] Counter
  (swap! cell assoc :value replacement))

(defn assoc-counter-map!
  [(cell (Atom CounterMap)) (key Keyword) (replacement Int)] CounterMap
  (swap! cell assoc key replacement))

(defn append-value! [(cell (Atom (Vec Int))) (value Int)] (Vec Int)
  (swap! cell conj value))

(defn append-values! [(cell (Atom (Vec Int))) (values (Vec Int))] (Vec Int)
  (swap! cell into values))

;; S4 dynamic and global cell-flow witnesses.  The declared Atom Any boundary
;; is the closed SliceValue carrier; the concrete initializer must cross that
;; boundary before the cell exists, then every mutation must retain it.
(def any-global (Atom Any) (atom 0))

(defn local-any-cell [] (Atom Any)
  (let [(cell (Atom Any)) (atom 0)] cell))

(defn make-any-cell [(initial Any)] (Atom Any)
  (atom initial))

(defn any-deref [] Any
  (deref any-global))

(defn any-reset! [(value Any)] Any
  (reset! any-global value))

(defn any-update [(value Any)] Any value)

(defn any-swap! [] Any
  (swap! any-global any-update))

(defn any-cas! [(expected Any) (replacement Any)] Bool
  (compare-and-set! any-global expected replacement))

(defn callable-cell-value [(base Int) (value Int)] Int
  (let [(cell (Atom (Fn [Int] Int)))
        (atom (fn [(current Int)] Int (+ base current)))
        (stored (Fn [Int] Int))
        (deref cell)]
    (stored value)))

(defn counter-cas!
  [(cell (Atom Counter)) (expected Counter) (replacement Counter)] Bool
  (compare-and-set! cell expected replacement))
