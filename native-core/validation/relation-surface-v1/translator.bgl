#lang beagle
(ns native.relation-surface-v1-translator
  (:require [beagle.language-capsule-v1 :as capsule]
            [beagle.language-reader-protocol-v1 :as protocol]
            [beagle.language-shared-datum-reader-v1 :as shared]))

(def max-source-bytes Int 4096)

(defrecord SourceProjectionV1
  [logical-path String
   raw-source String
   source-content-id String
   projection-id String])

(defrecord ReaderProductRelationInputV1
  [logical-source-path String
   request protocol/ReaderRequestV1
   product protocol/ReaderProductV1])

(defunion RelationCoreOriginV1
  (RelationCoreAuthoredOriginV1
    [event-index Int
     original-origin protocol/ReaderByteSpanV1])
  (RelationCoreSyntheticOriginV1 [label Keyword]))

(defrecord RelationCoreSourceMapEntryV1
  [generated-origin protocol/ReaderByteSpanV1
   origin RelationCoreOriginV1])

(defrecord RelationCoreSegmentV1
  [text String
   origin RelationCoreOriginV1])

(defrecord SurfaceTranslationV1
  [canonical-expression String
   canonical-core String
   core-expression-id String
   canonical-module-id String
   logical-core-source-id String
   reader-ir-id String
   provenance-map-id String
   core-source-map-id String
   core-source-map (Vec RelationCoreSourceMapEntryV1)
   receipt String])

(defunion ReaderProductRelationResultV1
  (ReaderProductRelationProjectedV1 [translation SurfaceTranslationV1])
  (ReaderProductRelationRejectedV1
    [diagnostics (Vec protocol/ReaderDiagnosticV1)]))

(defn canonical-part [value String] String
  (str (count (utf8-encode value)) ":" value))

(defn content-id
  [domain String
   parts (Vec String)] String
  (let [encoding String (loop [index Int 0
                               current String (str "beagle/relation-surface-identity/v1"
                    (canonical-part domain))]
                          (if (= index (count parts))
            current
            (recur (inc index)
                   (str current (canonical-part (nth parts index))))))]
    (str "sha256:" (sha256-bytes (utf8-encode encoding)))))

(defn source-projection-id
  [logical-path String
   source-content-id String] String
  (content-id "source-projection" [logical-path source-content-id]))

(defn source-provenance-identity [projection-id String] capsule/SemanticIdentityV1
  (capsule/semantic-identity-v1
    "validation/relation-surface-v1/source-provenance"
    [projection-id]))

(defn source-projection
  [logical-path String
   raw-source String] SourceProjectionV1
  (let [source-content-id String (protocol/source-payload-content-id-v1 raw-source)]
    (->SourceProjectionV1
      logical-path
      raw-source
      source-content-id
      (source-projection-id logical-path source-content-id))))

(defn character-at
  [value String
   index Int] String
  (subs value index (inc index)))

(defn decimal-digit? [character String] Bool
  (or (= character "0")
      (= character "1")
      (= character "2")
      (= character "3")
      (= character "4")
      (= character "5")
      (= character "6")
      (= character "7")
      (= character "8")
      (= character "9")))

(defn nonzero-decimal-digit? [character String] Bool
  (and (decimal-digit? character) (not= character "0")))

(defn decimal-tail?
  [value String
   start Int] Bool
  (loop [index Int start]
    (if (= index (count value))
      true
      (if (decimal-digit? (character-at value index))
        (recur (inc index))
        false))))

(defn decimal-digit-value [character String] Int
  (cond
    (= character "0") 0
    (= character "1") 1
    (= character "2") 2
    (= character "3") 3
    (= character "4") 4
    (= character "5") 5
    (= character "6") 6
    (= character "7") 7
    (= character "8") 8
    :else 9))

(defn decimal-at-most?
  [digits String
   limit String] Bool
  (if (< (count digits) (count limit))
    true
    (if (> (count digits) (count limit))
      false
      (loop [index Int 0]
        (if (= index (count digits))
          true
          (let [digit Int (decimal-digit-value (character-at digits index))
                limit-digit Int (decimal-digit-value (character-at limit index))]
            (cond
              (< digit limit-digit) true
              (> digit limit-digit) false
              :else (recur (inc index)))))))))

(defn signed-int64-lexeme? [value String] Bool
  (let [negative Bool (= "-" (character-at value 0))
        digits String (if negative (subs value 1 (count value)) value)]
    (decimal-at-most?
      digits
      (if negative "9223372036854775808" "9223372036854775807"))))

(defn canonical-decimal-lexeme? [value String] Bool
  (if (= 0 (count value))
    false
    (let [negative Bool (= "-" (character-at value 0))
          start Int (if negative 1 0)]
      (if (= start (count value))
        false
        (let [first-digit String (character-at value start)
              width Int (- (count value) start)]
          (and
            (if (= first-digit "0")
              (and (not negative) (= width 1))
              (nonzero-decimal-digit? first-digit))
            (decimal-tail? value (inc start))
            (signed-int64-lexeme? value)))))))

(defn symbol-event? [event protocol/ReaderIrEventV1] Bool
  (= :symbol (protocol/readerireventv1-kind event)))

(defn open-variable-event? [event protocol/ReaderIrEventV1] Bool
  (let [value String (protocol/readerireventv1-value event)]
    (and (symbol-event? event)
         (> (count value) 0)
         (= "?" (character-at value 0)))))

(defn reserved-semantic-word? [value String] Bool
  (or (= value "query")
      (= value "solve")
      (= value "assert")
      (= value "fact")
      (= value "law")
      (= value "rule")
      (= value "goal")))

(defn semantic-rejection-code
  [events (Vec protocol/ReaderIrEventV1)] Keyword?
  (loop [index Int 0]
    (if (= index (count events))
      nil
      (let [event protocol/ReaderIrEventV1 (nth events index)]
        (cond
          (open-variable-event? event) :surface/open-variable
          (and (symbol-event? event)
               (reserved-semantic-word?
                 (protocol/readerireventv1-value event)))
          :surface/reserved-semantic-form
          :else (recur (inc index)))))))

(defn event-is?
  [event protocol/ReaderIrEventV1
   kind Keyword
   value String
   depth Int] Bool
  (and (= kind (protocol/readerireventv1-kind event))
       (= value (protocol/readerireventv1-value event))
       (= depth (protocol/readerireventv1-depth event))))

(defn operator-alias?
  [event protocol/ReaderIrEventV1
   symbolic String
   word String
   depth Int] Bool
  (and (symbol-event? event)
       (= depth (protocol/readerireventv1-depth event))
       (let [value String (protocol/readerireventv1-value event)]
         (or (= value symbolic) (= value word)))))

(defn decimal-event-at-depth?
  [event protocol/ReaderIrEventV1
   depth Int] Bool
  (and (symbol-event? event)
       (= depth (protocol/readerireventv1-depth event))
       (canonical-decimal-lexeme? (protocol/readerireventv1-value event))))

(defn boolean-event-at-depth?
  [event protocol/ReaderIrEventV1
   depth Int] Bool
  (and (= :boolean (protocol/readerireventv1-kind event))
       (= depth (protocol/readerireventv1-depth event))
       (let [value String (protocol/readerireventv1-value event)]
         (or (= value "true") (= value "false")))))

(defn core-literal-event-at-depth?
  [event protocol/ReaderIrEventV1
   depth Int] Bool
  (or (decimal-event-at-depth? event depth)
      (boolean-event-at-depth? event depth)))

(defn relation-shape? [events (Vec protocol/ReaderIrEventV1)] Bool
  (and (= 7 (count events))
       (event-is? (nth events 0) :list/open "" 0)
       (core-literal-event-at-depth? (nth events 1) 1)
       (operator-alias? (nth events 2) "+" "plus" 1)
       (core-literal-event-at-depth? (nth events 3) 1)
       (event-is? (nth events 4) :list/close "" 0)
       (operator-alias? (nth events 5) "=" "equals" 0)
       (core-literal-event-at-depth? (nth events 6) 0)))

(defn integer-position-shape? [events (Vec protocol/ReaderIrEventV1)] Bool
  (and (= 7 (count events))
       (event-is? (nth events 0) :list/open "" 0)
       (symbol-event? (nth events 1))
       (= 1 (protocol/readerireventv1-depth (nth events 1)))
       (operator-alias? (nth events 2) "+" "plus" 1)
       (symbol-event? (nth events 3))
       (= 1 (protocol/readerireventv1-depth (nth events 3)))
       (event-is? (nth events 4) :list/close "" 0)
       (operator-alias? (nth events 5) "=" "equals" 0)
       (symbol-event? (nth events 6))
       (= 0 (protocol/readerireventv1-depth (nth events 6)))))

(defn canonical-expression [events (Vec protocol/ReaderIrEventV1)] String
  (str "(= (+ "
       (protocol/readerireventv1-value (nth events 1))
       " "
       (protocol/readerireventv1-value (nth events 3))
       ") "
       (protocol/readerireventv1-value (nth events 6))
       ")"))

(def bridge-rule-id String
  (content-id
    "reader-product-core-bridge-rule"
    ["relation-surface-v1" "closed-addition-equality-literals-v1"]))

(defn bridge-identity [label String] capsule/SemanticIdentityV1
  (capsule/semantic-identity-v1
    "validation/relation-surface-v1"
    [label]))

(def bridge-capsule-identity capsule/SemanticIdentityV1
  (bridge-identity "capsule"))

(def bridge-reader-component capsule/ComponentIdentityV1
  (capsule/component-identity-v1
    :reader
    (capsule/semanticidentityv1-content-id
      (bridge-identity "shared-datum-reader-artifact"))
    (capsule/semanticidentityv1-content-id
      (bridge-identity "shared-datum-reader-closure"))))

(def bridge-reader-protocol capsule/ProtocolIdentityV1
  (capsule/protocol-identity-v1
    :reader
    (capsule/semanticidentityv1-content-id
      (bridge-identity "reader-product-v1-protocol"))
    (capsule/semanticidentityv1-content-id
      (bridge-identity "reader-product-v1-abi"))))

(defn projection-reader-request [projection SourceProjectionV1] protocol/ReaderRequestV1
  (let [payload String (sourceprojectionv1-raw-source projection)
        provenance capsule/SemanticIdentityV1 (source-provenance-identity
          (sourceprojectionv1-projection-id projection))]
    (protocol/->ReaderRequestV1
      (protocol/source-slice-v1
        payload
        0
        (count (utf8-encode payload))
        provenance
        true)
      bridge-capsule-identity
      bridge-reader-component
      bridge-reader-protocol)))

(defn reader-product-candidate
  [product protocol/ReaderProductV1] protocol/ReaderProductCandidateV1
  (protocol/->ReaderProductCandidateV1
    (protocol/readerproductv1-canonical-ir-id product)
    (protocol/readerproductv1-canonical-ir-bytes product)
    (protocol/readerproductv1-canonical-ir-events product)
    (protocol/readerproductv1-provenance-map-id product)
    (protocol/readerproductv1-source-map product)
    (protocol/readerproductv1-diagnostics product)))

(defn reader-product-bound-to-input? [input ReaderProductRelationInputV1] Bool
  (let [request protocol/ReaderRequestV1 (readerproductrelationinputv1-request input)
        slice protocol/SourceSliceV1 (protocol/readerrequestv1-source-slice request)
        projection-id String (source-projection-id
          (readerproductrelationinputv1-logical-source-path input)
          (protocol/sourceslicev1-payload-content-id slice))]
    (and
      (= (protocol/sourceslicev1-provenance-receipt-identity slice)
         (source-provenance-identity projection-id))
      (protocol/reader-product-candidate-valid-v1?
        request
        (reader-product-candidate
          (readerproductrelationinputv1-product input))))))

(defn authored-origin
  [product protocol/ReaderProductV1
   event-index Int] RelationCoreOriginV1
  (let [entry protocol/ReaderSourceMapEntryV1 (nth
          (protocol/readerproductv1-source-map product)
          event-index)]
    (->RelationCoreAuthoredOriginV1
      event-index
      (protocol/readersourcemapentryv1-original-origin entry))))

(defn authored-segment
  [product protocol/ReaderProductV1
   event-index Int
   text String] RelationCoreSegmentV1
  (->RelationCoreSegmentV1
    text
    (authored-origin product event-index)))

(defn synthetic-segment
  [label Keyword
   text String] RelationCoreSegmentV1
  (->RelationCoreSegmentV1
    text
    (->RelationCoreSyntheticOriginV1 label)))

(defn canonical-core-segments
  [product protocol/ReaderProductV1
   events (Vec protocol/ReaderIrEventV1)] (Vec RelationCoreSegmentV1)
  [(synthetic-segment
     :module-prefix
     (str "#lang beagle\n"
          "(ns native.relation-surface-v1-generated)\n\n"
          "(defn expression [] Bool\n"
          "  ("))
   (authored-segment product 5 "=")
   (synthetic-segment :application-space " ")
   (authored-segment product 0 "(")
   (authored-segment product 2 "+")
   (synthetic-segment :argument-space " ")
   (authored-segment
     product 1 (protocol/readerireventv1-value (nth events 1)))
   (synthetic-segment :argument-space " ")
   (authored-segment
     product 3 (protocol/readerireventv1-value (nth events 3)))
   (authored-segment product 4 ")")
   (synthetic-segment :result-space " ")
   (authored-segment
     product 6 (protocol/readerireventv1-value (nth events 6)))
   (synthetic-segment
     :module-suffix
     (str "))\n\n"
          "(defn main [] Int\n"
          "  (if (expression) 0 1))\n"))])

(defn render-core-segments [segments (Vec RelationCoreSegmentV1)] String
  (reduce
    (fn
      [rendered String
       segment RelationCoreSegmentV1] String
      (str rendered (relationcoresegmentv1-text segment)))
    ""
    segments))

(defn core-source-map [segments (Vec RelationCoreSegmentV1)] (Vec RelationCoreSourceMapEntryV1)
  (loop [index Int 0
         generated-offset Int 0
         entries (Vec RelationCoreSourceMapEntryV1) []]
    (if (>= index (count segments))
      entries
      (let [segment RelationCoreSegmentV1 (nth segments index)
            generated-end Int (+ generated-offset
              (count (utf8-encode (relationcoresegmentv1-text segment))))]
        (recur
          (+ index 1)
          generated-end
          (conj entries
            (->RelationCoreSourceMapEntryV1
              (protocol/->ReaderByteSpanV1 generated-offset generated-end)
              (relationcoresegmentv1-origin segment))))))))

(defn core-origin-encoding [origin RelationCoreOriginV1] String
  (match origin
    [(RelationCoreSyntheticOriginV1 label)
     (str "synthetic" (canonical-part (str label)))]
    [(RelationCoreAuthoredOriginV1 event-index original-origin)
     (str "authored"
          (canonical-part (str event-index))
          (canonical-part
            (str (protocol/readerbytespanv1-start-byte original-origin)))
          (canonical-part
            (str (protocol/readerbytespanv1-end-byte original-origin))))]))

(defn core-source-map-entry-encoding [entry RelationCoreSourceMapEntryV1] String
  (let [generated protocol/ReaderByteSpanV1 (relationcoresourcemapentryv1-generated-origin entry)]
    (str
      (canonical-part (str (protocol/readerbytespanv1-start-byte generated)))
      (canonical-part (str (protocol/readerbytespanv1-end-byte generated)))
      (canonical-part
        (core-origin-encoding (relationcoresourcemapentryv1-origin entry))))))

(defn core-source-map-encoding [entries (Vec RelationCoreSourceMapEntryV1)] String
  (reduce
    (fn
      [encoding String
       entry RelationCoreSourceMapEntryV1] String
      (str encoding (core-source-map-entry-encoding entry)))
    (str "relation-core-source-map/v1"
         (canonical-part (str (count entries))))
    entries))

(defn logical-core-source-id [module-id String] String
  (str "relation-core/" (subs module-id 7 (count module-id)) ".bgl"))

(defn projection-receipt
  [input ReaderProductRelationInputV1
   expression String
   core-expression-id String
   canonical-module-id String
   logical-source-id String
   core-source-map-id String] String
  (let [request protocol/ReaderRequestV1 (readerproductrelationinputv1-request input)
        product protocol/ReaderProductV1 (readerproductrelationinputv1-product input)
        slice protocol/SourceSliceV1 (protocol/readerrequestv1-source-slice request)
        projection-id String (source-projection-id
          (readerproductrelationinputv1-logical-source-path input)
          (protocol/sourceslicev1-payload-content-id slice))]
    (str "relation-surface-projection-v1\n"
         "source-path "
         (readerproductrelationinputv1-logical-source-path input)
         "\nsource-content-id "
         (protocol/sourceslicev1-payload-content-id slice)
         "\nprojection-id " projection-id
         "\nreader-ir-id "
         (capsule/semanticidentityv1-content-id
           (protocol/readerproductv1-canonical-ir-id product))
         "\nprovenance-map-id "
         (capsule/semanticidentityv1-content-id
           (protocol/readerproductv1-provenance-map-id product))
         "\nbridge-rule-id " bridge-rule-id
         "\ncore-expression-id " core-expression-id
         "\ncanonical-module-id " canonical-module-id
         "\nlogical-core-source-id " logical-source-id
         "\ncore-source-map-id " core-source-map-id
         "\ncanonical-expression " expression
         "\n")))

(defn projected-translation [input ReaderProductRelationInputV1] ReaderProductRelationResultV1
  (let [product protocol/ReaderProductV1 (readerproductrelationinputv1-product input)
        events (Vec protocol/ReaderIrEventV1) (protocol/readerproductv1-canonical-ir-events product)
        expression String (canonical-expression events)
        segments (Vec RelationCoreSegmentV1) (canonical-core-segments product events)
        core String (render-core-segments segments)
        source-map (Vec RelationCoreSourceMapEntryV1) (core-source-map segments)
        core-expression-id String (content-id
          "ordinary-core-expression"
          [bridge-rule-id expression])
        module-id String (content-id
          "canonical-core-module"
          [bridge-rule-id core])
        logical-source-id String (logical-core-source-id module-id)
        map-id String (content-id
          "core-source-map"
          [module-id
           (capsule/semanticidentityv1-content-id
             (protocol/readerproductv1-canonical-ir-id product))
           (readerproductrelationinputv1-logical-source-path input)
           (capsule/semanticidentityv1-content-id
             (protocol/readerproductv1-provenance-map-id product))
           (core-source-map-encoding source-map)])]
    (->ReaderProductRelationProjectedV1
      (->SurfaceTranslationV1
        expression
        core
        core-expression-id
        module-id
        logical-source-id
        (capsule/semanticidentityv1-content-id
          (protocol/readerproductv1-canonical-ir-id product))
        (capsule/semanticidentityv1-content-id
          (protocol/readerproductv1-provenance-map-id product))
        map-id
        source-map
        (projection-receipt
          input expression core-expression-id module-id logical-source-id map-id)))))

(defn source-span-for-input [input ReaderProductRelationInputV1] protocol/ReaderByteSpanV1
  (let [slice protocol/SourceSliceV1 (protocol/readerrequestv1-source-slice
          (readerproductrelationinputv1-request input))]
    (protocol/->ReaderByteSpanV1
      (protocol/sourceslicev1-start-byte slice)
      (protocol/sourceslicev1-end-byte slice))))

(defn surface-diagnostic
  [input ReaderProductRelationInputV1
   code Keyword
   detail String] protocol/ReaderDiagnosticV1
  (protocol/->ReaderDiagnosticV1
    code :error detail (source-span-for-input input)))

(defn lower-reader-product-relation-v1 [input ReaderProductRelationInputV1] ReaderProductRelationResultV1
  (let [request protocol/ReaderRequestV1 (readerproductrelationinputv1-request input)
        product protocol/ReaderProductV1 (readerproductrelationinputv1-product input)]
    (cond
      (not (reader-product-bound-to-input? input))
      (->ReaderProductRelationRejectedV1
        [(protocol/protocol-rejection-diagnostic-v1 request)])

      (not (empty? (protocol/readerproductv1-diagnostics product)))
      (->ReaderProductRelationRejectedV1
        (protocol/readerproductv1-diagnostics product))

      :else
      (let [events (Vec protocol/ReaderIrEventV1) (protocol/readerproductv1-canonical-ir-events product)
            semantic-rejection Keyword? (semantic-rejection-code events)]
        (cond
          (some? semantic-rejection)
          (->ReaderProductRelationRejectedV1
            [(surface-diagnostic
               input
               semantic-rejection
               "semantic forms require an explicit future profile")])

          (relation-shape? events)
          (projected-translation input)

          (integer-position-shape? events)
          (->ReaderProductRelationRejectedV1
            [(surface-diagnostic
               input
               :surface/invalid-integer
               "literal positions require canonical signed 64-bit integers or booleans")])

          :else
          (->ReaderProductRelationRejectedV1
            [(surface-diagnostic
               input
               :surface/unsupported-shape
               "only (LITERAL + LITERAL) = LITERAL and word aliases are admitted")]))))))

(defn translate-projection [projection SourceProjectionV1] ReaderProductRelationResultV1
  (let [request protocol/ReaderRequestV1 (projection-reader-request projection)]
    (match (shared/read-shared-datum-request-v1 request)
      [(protocol/ReaderProductRejectedV1 diagnostics)
       (->ReaderProductRelationRejectedV1 diagnostics)]
      [(protocol/ReaderProductAcceptedV1 product)
       (lower-reader-product-relation-v1
         (->ReaderProductRelationInputV1
           (sourceprojectionv1-logical-path projection)
           request
           product))])))

(defn relabeled-input-rejected? [projection SourceProjectionV1] Bool
  (let [request protocol/ReaderRequestV1 (projection-reader-request projection)]
    (match (shared/read-shared-datum-request-v1 request)
      [(protocol/ReaderProductRejectedV1 diagnostics) false]
      [(protocol/ReaderProductAcceptedV1 product)
       (match (lower-reader-product-relation-v1
                (->ReaderProductRelationInputV1
                  (str (sourceprojectionv1-logical-path projection) "#relabeled")
                  request
                  product))
         [(ReaderProductRelationProjectedV1 translation) false]
         [(ReaderProductRelationRejectedV1 diagnostics)
          (and (= 1 (count diagnostics))
               (= :reader/invalid-product
                  (protocol/readerdiagnosticv1-code (first diagnostics))))])])))

(defn core-source-map-entry-line [entry RelationCoreSourceMapEntryV1] String
  (let [generated protocol/ReaderByteSpanV1 (relationcoresourcemapentryv1-generated-origin entry)
        prefix String (str
          (protocol/readerbytespanv1-start-byte generated)
          "\t"
          (protocol/readerbytespanv1-end-byte generated)
          "\t")]
    (match (relationcoresourcemapentryv1-origin entry)
      [(RelationCoreSyntheticOriginV1 label)
       (str prefix "synthetic\t-1\t-\t-\t" label "\n")]
      [(RelationCoreAuthoredOriginV1 event-index original-origin)
       (str prefix
            "authored\t"
            event-index
            "\t"
            (protocol/readerbytespanv1-start-byte original-origin)
            "\t"
            (protocol/readerbytespanv1-end-byte original-origin)
            "\t-\n")])))

(defn core-source-map-text [translation SurfaceTranslationV1] String
  (reduce
    (fn
      [rendered String
       entry RelationCoreSourceMapEntryV1] String
      (str rendered (core-source-map-entry-line entry)))
    (str "relation-core-source-map-v1\t"
         (surfacetranslationv1-core-source-map-id translation)
         "\n")
    (surfacetranslationv1-core-source-map translation)))

(defn write-text
  [path String
   value String] Bool
  (match (host.fs/write-text-atomic path value)
    [(host.fs/WriteTextAtomicOk) true]
    [(host.fs/WriteTextAtomicError errno) false]))

(defn translate-file
  [physical-path String
   logical-path String
   core-output-path String
   receipt-output-path String
   source-map-output-path String] Int
  (match (host.fs/read-text-bounded physical-path max-source-bytes)
    [(host.fs/ReadTextBoundedError errno)
     (do
       (println (str "relation-surface-v1: source read failed: " errno))
       74)]
    [(host.fs/ReadTextBoundedOk raw-source)
     (match (translate-projection (source-projection logical-path raw-source))
       [(ReaderProductRelationRejectedV1 diagnostics)
        (let [diagnostic protocol/ReaderDiagnosticV1 (first diagnostics)]
          (do
            (println
              (str "relation-surface-v1: rejected "
                   (protocol/readerdiagnosticv1-code diagnostic)))
            65))]
       [(ReaderProductRelationProjectedV1 translation)
        (if (and
              (write-text
                core-output-path
                (surfacetranslationv1-canonical-core translation))
              (write-text
                receipt-output-path
                (surfacetranslationv1-receipt translation))
              (write-text
                source-map-output-path
                (core-source-map-text translation)))
          0
          (do
            (println "relation-surface-v1: output write failed")
            74))])]))

(defn probe-relabeled-file
  [physical-path String
   logical-path String] Int
  (match (host.fs/read-text-bounded physical-path max-source-bytes)
    [(host.fs/ReadTextBoundedError errno)
     (do
       (println (str "relation-surface-v1: source read failed: " errno))
       74)]
    [(host.fs/ReadTextBoundedOk raw-source)
     (if (relabeled-input-rejected?
           (source-projection logical-path raw-source))
       0
       1)]))

(defn main [args (Vec String)] Int
  (cond
    (= 5 (count args))
    (translate-file
      (nth args 0)
      (nth args 1)
      (nth args 2)
      (nth args 3)
      (nth args 4))

    (and (= 3 (count args))
         (= "--probe-relabel" (nth args 0)))
    (probe-relabeled-file (nth args 1) (nth args 2))

    :else
    (do
      (println
        "usage: relation-surface-v1 PHYSICAL_SOURCE LOGICAL_PATH CORE_OUT RECEIPT_OUT SOURCE_MAP_OUT | --probe-relabel PHYSICAL_SOURCE LOGICAL_PATH")
      64)))
