#lang beagle
(ns native.datum-reader-fixture
  (:require [beagle.datum-reader :as reader]))

(def representative-source String
  "#lang beagle/nix\n\n(ns default)\n\n(nix/module [config lib pkgs ...]\n  {:tags [browsers gui-only]\n   :tags-opt-in [headless-ok]\n   :tag-overrides {browsers {:myConfig.modules.stylix.chosenTheme \"tokyo-night-dark\"}}\n   ;; This comment is data-blind: :enabled [fake].\n   :config (lib.mkIf true {})})\n\n{:platform linux\n :enabled [terminal [browsers -gjoa +chrome]]\n :disabled [piper]}\n")

(defn contains-event?
  [(events (Vec reader/ReaderEvent)) (kind Keyword) (value String)] Bool
  (loop [remaining (Vec reader/ReaderEvent) events]
    (if (empty? remaining)
      false
      (let [event reader/ReaderEvent (first remaining)]
        (if (and (= kind (reader/readerevent-kind event))
                 (= value (reader/readerevent-value event)))
          true
          (recur (rest remaining)))))))

(defn contains-event-at?
  [(events (Vec reader/ReaderEvent))
   (kind Keyword)
   (value String)
   (depth Int)]
  Bool
  (loop [remaining (Vec reader/ReaderEvent) events]
    (if (empty? remaining)
      false
      (let [event reader/ReaderEvent (first remaining)]
        (if (and (= kind (reader/readerevent-kind event))
                 (= value (reader/readerevent-value event))
                 (= depth (reader/readerevent-depth event)))
          true
          (recur (rest remaining)))))))

(defn event-count
  [(events (Vec reader/ReaderEvent)) (kind Keyword) (value String)] Int
  (loop [remaining (Vec reader/ReaderEvent) events
         total Int 0]
    (if (empty? remaining)
      total
      (let [event reader/ReaderEvent (first remaining)]
        (recur (rest remaining)
               (if (and (= kind (reader/readerevent-kind event))
                        (= value (reader/readerevent-value event)))
                 (inc total)
                 total))))))

(defn representative-case [] Bool
  (let [result reader/DatumRead (reader/read-events representative-source)
        events (Vec reader/ReaderEvent) (reader/datumread-events result)]
    (and (reader/read-ok? result)
         (contains-event-at? events :keyword ":tags" 2)
         (contains-event-at? events :keyword ":tags-opt-in" 2)
         (contains-event-at? events :keyword ":tag-overrides" 2)
         (contains-event-at? events :keyword ":platform" 1)
         (contains-event-at? events :keyword ":enabled" 1)
         (contains-event-at? events :keyword ":disabled" 1)
         (= 1 (event-count events :keyword ":enabled"))
         (contains-event? events :symbol "browsers")
         (contains-event? events :symbol "+chrome")
         (contains-event? events :symbol "-gjoa")
         (contains-event? events :boolean "true")
         (contains-event? events :string "tokyo-night-dark"))))

(defn literal-case [] Bool
  (let [result reader/DatumRead
        (reader/read-events "{:value \"line\\nquote: \\\" and slash: \\\\\"}")
        events (Vec reader/ReaderEvent) (reader/datumread-events result)]
    (and (reader/read-ok? result)
         (contains-event? events :string "line\nquote: \" and slash: \\")
         (= "\"line\\nquote: \\\" and slash: \\\\\""
            (reader/render-literal :string
                                   "line\nquote: \" and slash: \\")))))

(defn prefix-case [] Bool
  (let [result reader/DatumRead
        (reader/read-events "'x `y ~z ~@zs ^:private f v' #{x}")
        events (Vec reader/ReaderEvent) (reader/datumread-events result)]
    (and (reader/read-ok? result)
         (contains-event? events :quote "")
         (contains-event? events :quasiquote "")
         (contains-event? events :unquote "")
         (contains-event? events :unquote-splicing "")
         (contains-event? events :metadata "")
         (contains-event? events :symbol "v'")
         (contains-event? events :set/open "")
         (contains-event? events :set/close ""))))

(defn malformed-case [] Bool
  (and (not (reader/read-ok? (reader/read-events "{:tags [x}")))
       (not (reader/read-ok? (reader/read-events "{:tags [x]")))
       (not (reader/read-ok? (reader/read-events "\"unterminated")))
       (not (reader/read-ok? (reader/read-events "]")))))

(defn main [(args (Vec String))] Int
  (if (and (= 1 (count args)) (= "--emit-source" (first args)))
    (do (println representative-source) 0)
    (if (and (representative-case)
             (literal-case)
             (prefix-case)
             (malformed-case))
      0
      1)))
