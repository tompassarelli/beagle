#lang beagle

(ns beagle.semantic-identity-fixture
  (:require [beagle.semantic-identity :as identity]))

(def domain-a identity/IdentityDomain
  (identity/model-revision-domain))

(def domain-b identity/IdentityDomain
  (identity/goal-content-domain))

(defn repeated-octets
  [value Int
   amount Int] (Vec Int)
  (loop [index Int 0
         result (Vec Int) []]
    (if (>= index amount)
      result
      (recur (+ index 1) (conj result value)))))

(def digest-a identity/Digest256
  (identity/->Digest256 (repeated-octets 17 32)))

(def digest-b identity/Digest256
  (identity/->Digest256 (repeated-octets 34 32)))

(defn different-digests?
  [left identity/MerkleResult
   right identity/MerkleResult] Bool
  (match (identity/merkleresult-outcome left)
    [(identity/MerkleRejected problem) false]
    [(identity/MerkleHashed left-digest left-bytes)
     (match (identity/merkleresult-outcome right)
       [(identity/MerkleRejected problem) false]
       [(identity/MerkleHashed right-digest right-bytes)
        (not (identity/digest= left-digest right-digest))])]))

(defn same-digest?
  [left identity/MerkleResult
   right identity/MerkleResult] Bool
  (match (identity/merkleresult-outcome left)
    [(identity/MerkleRejected problem) false]
    [(identity/MerkleHashed left-digest left-bytes)
     (match (identity/merkleresult-outcome right)
       [(identity/MerkleRejected problem) false]
       [(identity/MerkleHashed right-digest right-bytes)
        (identity/digest= left-digest right-digest)])]))

(defn rejected-as?
  [result identity/MerkleResult
   code Keyword] Bool
  (match (identity/merkleresult-outcome result)
    [(identity/MerkleHashed digest bytes) false]
    [(identity/MerkleRejected problem)
     (= code (identity/identityproblem-code problem))]))

(defn digest-rejected-as?
  [result identity/DigestResult
   code Keyword] Bool
  (match result
    [(identity/DigestValue digest) false]
    [(identity/DigestError problem)
     (= code (identity/identityproblem-code problem))]))

(defn byte-content-rejected-as?
  [result identity/ByteContentIdResult
   code Keyword] Bool
  (match result
    [(identity/ByteContentIdValue accepted) false]
    [(identity/ByteContentIdError problem)
     (= code (identity/identityproblem-code problem))]))

(defn byte-content-candidate-rejected-as?
  [result identity/ByteContentIdCandidateResult
   code Keyword] Bool
  (match result
    [(identity/ByteContentIdCandidateValue candidate) false]
    [(identity/ByteContentIdCandidateError problem)
     (= code (identity/identityproblem-code problem))]))

(defn encoding-rejected-as?
  [result identity/EncodingResult
   code Keyword] Bool
  (match result
    [(identity/EncodingAccepted bytes) false]
    [(identity/EncodingRejected problem)
     (= code (identity/identityproblem-code problem))]))

(defn framing-case [] Bool
  (let [split-a identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->Utf8Field 1 "a")
           (identity/->Utf8Field 2 "bc")])
        split-b identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->Utf8Field 1 "ab")
           (identity/->Utf8Field 2 "c")])
        other-domain identity/MerkleResult (identity/hash-merkle-node domain-b
          [(identity/->Utf8Field 1 "a")
           (identity/->Utf8Field 2 "bc")])
        other-kind identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->BytesField 1 [97])
           (identity/->Utf8Field 2 "bc")])]
    (and
      (different-digests? split-a split-b)
      (different-digests? split-a other-domain)
      (different-digests? split-a other-kind))))

(defn set-case [] Bool
  (let [forward identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->SetDigestsField 1 [digest-a digest-b])])
        reverse identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->SetDigestsField 1 [digest-b digest-a])])
        duplicate identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->SetDigestsField 1 [digest-a digest-a])])
        singleton identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->SetDigestsField 1 [digest-a])])
        ordered-forward identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->OrderedDigestsField 1 [digest-a digest-b])])
        ordered-reverse identity/MerkleResult (identity/hash-merkle-node domain-a
          [(identity/->OrderedDigestsField 1 [digest-b digest-a])])]
    (and
      (same-digest? forward reverse)
      (same-digest? duplicate singleton)
      (different-digests? ordered-forward ordered-reverse))))

(defn signed-boundary-case [] Bool
  (match (identity/merkleresult-outcome
           (identity/hash-merkle-node domain-a
             [(identity/->SignedField 1 -9223372036854775808)]))
    [(identity/MerkleRejected problem) false]
    [(identity/MerkleHashed digest bytes)
     (= [128 0 0 0 0 0 0 0] (subvec bytes 23 31))]))

(defn digest-scalar-case [] Bool
  (let [expected String
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"]
    (and
      (match (identity/project-digest-scalar digest-a)
        [(identity/EncodingRejected problem) false]
        [(identity/EncodingAccepted bytes)
         (let [value String (utf8-decode bytes)]
           (and
             (= expected value)
             (match (identity/decode-digest-scalar value)
               [(identity/DigestError problem) false]
               [(identity/DigestValue decoded)
                (identity/digest= digest-a decoded)])))])
      (digest-rejected-as?
        (identity/decode-digest-scalar
          "sha256:111111111111111111111111111111111111111111111111111111111111111A")
        :identity/noncanonical-digest-scalar)
      (digest-rejected-as?
        (identity/decode-digest-scalar
          "1111111111111111111111111111111111111111111111111111111111111111")
        :identity/noncanonical-digest-scalar)
      (encoding-rejected-as?
        (identity/project-digest-scalar
          (identity/->Digest256 (repeated-octets 0 31)))
        :identity/invalid-digest))))

(defn rejection-case [] Bool
  (and
    (rejected-as?
      (identity/hash-merkle-node domain-a
        [(identity/->BytesField 1 [0 256])])
      :identity/invalid-octet)
    (rejected-as?
      (identity/hash-merkle-node domain-a
        [(identity/->DigestField 1
           (identity/->Digest256 (repeated-octets 0 31)))])
      :identity/invalid-digest)
    (rejected-as?
      (identity/hash-merkle-node domain-a
        [(identity/->Utf8Field 2 "later")
         (identity/->Utf8Field 1 "earlier")])
      :identity/noncanonical-field-order)
    (rejected-as?
      (identity/hash-merkle-node domain-a
        [(identity/->Utf8Field 1 "first")
         (identity/->NaturalField 1 1)])
      :identity/noncanonical-field-order)
    (rejected-as?
      (identity/hash-merkle-node domain-a
        [(identity/->NaturalField 1 -1)])
      :identity/negative-natural)
    (digest-rejected-as?
      (identity/digest-from-octets (repeated-octets 0 31))
      :identity/digest-length)
    (digest-rejected-as?
      (identity/digest-from-octets (repeated-octets -1 32))
      :identity/invalid-octet)))

(defn byte-content-case [] Bool
  (let [first-result identity/ByteContentIdResult (identity/byte-content-id [0 1 2 255])
        second-result identity/ByteContentIdResult (identity/byte-content-id [0 1 2 255])]
    (and
      (match first-result
        [(identity/ByteContentIdError problem) false]
        [(identity/ByteContentIdValue first-id)
         (match second-result
           [(identity/ByteContentIdError problem) false]
           [(identity/ByteContentIdValue second-id)
            (and
              (identity/byte-content-id-well-formed? first-id)
              (identity/digest=
                (identity/bytecontentid-digest first-id)
                (identity/bytecontentid-digest second-id))
              (match (identity/project-byte-content-id-scalar first-id)
                [(identity/EncodingRejected problem) false]
                [(identity/EncodingAccepted bytes)
                 (match (identity/decode-byte-content-id-scalar
                          (utf8-decode bytes))
                   [(identity/ByteContentIdCandidateError problem) false]
                   [(identity/ByteContentIdCandidateValue decoded)
                    (identity/digest=
                      (identity/bytecontentid-digest first-id)
                      (identity/bytecontentidcandidate-digest decoded))])]))])])
      (byte-content-rejected-as?
        (identity/byte-content-id [0 -1])
        :identity/invalid-octet)
      (byte-content-candidate-rejected-as?
        (identity/decode-byte-content-id-scalar
          "sha256:111111111111111111111111111111111111111111111111111111111111111A")
        :identity/noncanonical-digest-scalar)
      (not (identity/byte-content-id-well-formed?
             (identity/->ByteContentId
               (identity/->Digest256 (repeated-octets 0 31))))))))

(defn header-case [] Bool
  (match (identity/merkleresult-outcome
           (identity/hash-merkle-node domain-a
             [(identity/->Utf8Field 1 "value")]))
    [(identity/MerkleRejected problem) false]
    [(identity/MerkleHashed digest bytes)
     (and
       (identity/digest-well-formed? digest)
       (= [66 71 76 73 0 1 0 5 0 0 0 1]
          (subvec bytes 0 12)))]))

(defn main [] Int
  (if (and
        (framing-case)
        (set-case)
        (signed-boundary-case)
        (digest-scalar-case)
        (rejection-case)
        (byte-content-case)
        (header-case))
    0
    1))
