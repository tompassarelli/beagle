#lang beagle/clj

(ns native.inline-callbacks)


(defrecord OptionalBoolCarrier [(value (U Bool Nil))])
(defrecord CallbackBox [(value Int)])

(defn captured-reduce [(offset Int)] Int
  (let [values (Vec Int) [1 2 3]]
    (reduce
      (fn [total Int value Int] Int
        (+ total (+ value offset)))
      0 values)))

(defn captured-map [(offset Int)] Int
  (let [values (Vec Int) [1 2]]
    (nth
      (mapv (fn [value Int] Int (+ value offset)) values)
      1)))

(defn captured-filter [(threshold Int)] Int
  (let [values (Vec Int) [1 4 7]]
    (count
      (filterv (fn [value Int] Bool (> value threshold)) values))))

(defn captured-every? [(threshold Int)] Bool
  (let [values (Vec Int) [1 2 3]]
    (every? (fn [value Int] Bool (> value threshold)) values)))

(defn captured-some? [(target Int)] Bool
  (let [values (Vec Int) [1 3 5]]
    (boolean
      (some (fn [value Int] Bool (= value target)) values))))

(defn shadowed-map-parameter [(value Int)] Int
  (let [values (Vec Int) [10]]
    (nth
      (mapv (fn [value Int] Int (+ value 1)) values)
      0)))

(defn nested-captures [(threshold Int)] Bool
  (let [values (Vec Int) [1 2]
        candidates (Vec Int) [2 3 4]]
    (every?
      (fn [value Int] Bool
        (some?
          (some
            (fn [candidate Int] Bool
              (= candidate (+ value threshold)))
            candidates)))
      values)))

(defn contextual-reduce-any [(offset Int)] Bool
  (let [values (Vec Int) [1 2]]
    (instance? CallbackBox
      (reduce
        (fn [tail Any value Int] Any
          (->CallbackBox (+ value offset)))
        :callback/seed values))))

(defn contextual-map-any [(offset Int)] Int
  (let [values (Vec Int) [1 2]
        mapped (Vec Any)
        (mapv
          (fn [value Int] Any (->CallbackBox (+ value offset)))
          values)]
    (count mapped)))

(defn insertion-order-set-reduce [] Int
  (let [values (Set Int) #{3 1 2}]
    (reduce
      (fn [total Int value Int] Int
        (+ (* total 10) value))
      0 values)))

(defn insertion-order-map-reduce-kv [] Int
  (let [values (Map Int Int) {3 4 1 2}]
    (reduce-kv
      (fn
        [(total Int)
         (key Int)
         (value Int)] Int
        (+ (* total 100) (+ (* key 10) value)))
      0 values)))
