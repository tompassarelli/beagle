#lang beagle/clj

(ns native.inline-callback-refusals)

(define-mode strict)

(defn refuses-named-callback [value: Int] -> Int
  (let [values: (Vec Int) [value]]
    (count (mapv inc values))))

(defn refuses-callback-recur [value: Int] -> Int
  (let [values: (Vec Int) [value]]
    (reduce
      (fn [total: Int item: Int] -> Int
        (recur total item))
      0 values)))
