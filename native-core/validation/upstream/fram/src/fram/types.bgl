#lang beagle
;; The portable store ABI deliberately uses only records and homogeneous
;; vectors. Semantic values are recursive Terms; transaction history is kept
;; in private physical rows and projected back to ordinary Triples.
(ns fram.types)
(define-mode strict)
(require fram.slots :as slots)

;; Atom is the closed grounding vocabulary for the recursive term model.  An
;; Instant is canonical epoch seconds plus nanoseconds; civil-time context is
;; expressed by ordinary triples rather than folded into this scalar.
(defrecord Instant [(epoch-seconds Int) (nanos Int)])
(defn instant? [(v Any)] Bool (instance? Instant v))
(defn instant [(epoch-seconds Int) (nanos Int)] Instant
  (if (and (>= nanos 0) (< nanos 1000000000))
    (->Instant epoch-seconds nanos)
    (throw (ex-info "fram: instant nanoseconds must be in [0, 1000000000)"
                    {:type :invalid-instant}))))

;; Instant arithmetic stays on whole seconds: nanoseconds are already canonical
;; in [0, 1000000000), so shifting by seconds cannot leave that range.
(defn instant-shift-seconds [(at Instant) (seconds Int)] Instant
  (->Instant (+ (instant-epoch-seconds at) seconds) (instant-nanos at)))

(defn instant-seconds-between [(earlier Instant) (later Instant)] Int
  (- (instant-epoch-seconds later) (instant-epoch-seconds earlier)))

;; Triple fields are Any only because the portable record ABI cannot spell a
;; recursive union in-place; term? enforces Term = Atom | Triple at the boundary.
(defalias Atom (Dyn String Int Float Bool Keyword Instant))
(defrecord Triple
  [(t1 Any)
   (t2 Any)
   (t3 Any)])
(defalias Term (Dyn String Int Float Bool Keyword Instant Triple))

;; FRAMRPC payloads are closed records over the same recursive Term vocabulary.
;; A cancel frame carries only its header request-id; event bodies use RpcResponse.
(defrecord RpcPageRequest [(limit Int) (cursor Term?)])
(defrecord RpcPageResponse
  [(ordinal Int)
   (next-cursor Term?)
   (done Bool)])
(defrecord RpcError
  [(code Keyword)
   (retryable Bool)
   (message String)
   (detail Term?)])
(defrecord RpcRequest
  [(space String)
   (op Keyword)
   (expected-version Int?)
   (page RpcPageRequest?)
   (timeout-ms Int?)
   (payload Term)])
(defrecord RpcResponse
  [(space String)
   (op Keyword)
   (served-version Int)
   (page RpcPageResponse?)
   (error RpcError?)
   (payload Term?)])
(defrecord RpcFrameV1
  [(kind Keyword)
   (flags Int)
   (request-id Int)
   (request RpcRequest?)
   (response RpcResponse?)])
(defrecord TermCodecMeasure [(bytes Int) (nodes Int)])
;; The value field is runtime-checked Term; Beagle cannot pass a recursive Dyn
;; across a module boundary without losing its alternatives.
(defrecord TermCodecDecoded [(value Any) (nodes Int)])

(defn triple? [(v Any)] Bool (instance? Triple v))
(defn rpc-page-request? [(v Any)] Bool (instance? RpcPageRequest v))
(defn rpc-page-response? [(v Any)] Bool (instance? RpcPageResponse v))
(defn rpc-error? [(v Any)] Bool (instance? RpcError v))
(defn rpc-request? [(v Any)] Bool (instance? RpcRequest v))
(defn rpc-response? [(v Any)] Bool (instance? RpcResponse v))
(defn rpc-frame-v1? [(v Any)] Bool (instance? RpcFrameV1 v))

;; These bridges preserve the closed Term fields while working around Beagle's
;; current inability to pass a recursive Dyn through a module boundary.
(defn rpc-page-request-cursor-value [(v RpcPageRequest)] Any
  (rpcpagerequest-cursor v))
(defn rpc-page-response-cursor-value [(v RpcPageResponse)] Any
  (rpcpageresponse-next-cursor v))
(defn rpc-error-detail-value [(v RpcError)] Any (rpcerror-detail v))
(defn rpc-request-payload-value [(v RpcRequest)] Any (rpcrequest-payload v))
(defn rpc-response-payload-value [(v RpcResponse)] Any (rpcresponse-payload v))

;; Term handles are private tagged integers. Only these three structural positions
;; cross the store/native boundary; no handle is part of Triple semantics.
(defrecord AtomRow
  [(kind Keyword)
   (string-value String?)
   (int-value Int?)
   (float-value Float?)
   (bool-value Bool?)
   (keyword-value Keyword?)
   (instant-value Instant?)])
(defrecord TripleRow
  [(t1 Int)
   (t2 Int)
   (t3 Int)])

;; SpaceId plus the transaction sequence and operation ordinal form an exact
;; occurrence coordinate. The handle is only a private content reference.
(defalias SpaceId String)
(defrecord TransactionRow
  [(sequence Int)
   (first-operation Int)
   (operation-count Int)])
(defrecord OperationRow
  [(tx-sequence Int)
   (ordinal Int)
   (action Keyword)
   (triple-handle Int)])
(defrecord ActiveBucket [(triple-handle Int) (positions (Vec Int))])
(defrecord CommitOperation [(action Keyword) (proposition Triple)])
(defrecord TransactionFrame [(sequence Int) (operations (Vec CommitOperation))])
(defrecord TermStore
  [(space-id SpaceId)
   (next-sequence Int)
   (atoms (Vec AtomRow))
   (triples (Vec TripleRow))
   (transactions (Vec TransactionRow))
   (operations (Vec OperationRow))
   (withdrawal-targets (Vec Int))
   (active-buckets (Vec ActiveBucket))
   ;; While fold-open these carry every bucket's positions and the
   ;; ActiveBucket rows carry only their handle.
   (active-cells (Vec (Atom (Vec Int))))
   (fold-open Bool)
   (atom-slots slots/TermSlots)
   (triple-slots slots/TermSlots)
   (active-slots slots/TermSlots)])
(defrecord TermStoreDump
  [(version Int)
   (space-id SpaceId)
   (next-sequence Int)
   (atoms (Vec AtomRow))
   (triples (Vec TripleRow))
   (transactions (Vec TransactionRow))
   (operations (Vec OperationRow))])

(defn commit-operation? [(v Any)] Bool (instance? CommitOperation v))
(defn transaction-frame? [(v Any)] Bool (instance? TransactionFrame v))
(defn term-store-dump? [(v Any)] Bool (instance? TermStoreDump v))

(def tx-sequence Keyword :kernel/tx-sequence)
(def op-ordinal Keyword :kernel/op-ordinal)
(def asserts Keyword :kernel/asserts)
(def retracts Keyword :kernel/retracts)
(def withdraws Keyword :kernel/withdraws)
(def recorded-at-predicate Keyword :kernel/recorded-at)
(def assert-action Keyword :assert)
(def retract-action Keyword :retract)

(defn atom? [(v Any)] Bool
  (or (string? v)
      (or (integer? v)
          (or (and (number? v) (not (integer? v)))
              (or (boolean? v) (or (keyword? v) (instant? v)))))))

(defn term? [(v Any)] Bool
  (if (triple? v)
    (and (term? (triple-t1 v))
         (and (term? (triple-t2 v))
              (term? (triple-t3 v))))
    (atom? v)))

(defn triple
  [(t1 Term)
   (t2 Term)
   (t3 Term)] Triple
  (let [value (->Triple t1 t2 t3)]
    (if (term? value)
      value
      (throw (ex-info "fram: triple contains a value outside Term" {:type :invalid-term})))))

(defn transaction-coordinate [(space-id String) (sequence Int)] Triple
  (if (and (pos? (count space-id)) (>= sequence 0))
    (triple space-id tx-sequence sequence)
    (throw (ex-info "fram: transaction coordinate requires a non-empty space and non-negative sequence"
                    {:type :invalid-transaction-coordinate}))))

(defn transaction-coordinate? [(v Any)] Bool
  (and (triple? v)
       (and (string? (triple-t1 v))
            (and (pos? (count (triple-t1 v)))
                 (and (= tx-sequence (triple-t2 v))
                      (and (integer? (triple-t3 v))
                           (>= (triple-t3 v) 0)))))))

(defn occurrence-coordinate [(tx Triple) (ordinal Int)] Triple
  (if (and (transaction-coordinate? tx) (>= ordinal 0))
    (triple tx op-ordinal ordinal)
    (throw (ex-info "fram: occurrence coordinate requires a transaction coordinate and non-negative ordinal"
                    {:type :invalid-occurrence-coordinate}))))

(defn occurrence-coordinate? [(v Any)] Bool
  (and (triple? v)
       (and (transaction-coordinate? (triple-t1 v))
            (and (= op-ordinal (triple-t2 v))
                 (and (integer? (triple-t3 v))
                      (>= (triple-t3 v) 0))))))

(defn assertion-occurrence [(occurrence Triple) (proposition Triple)] Triple
  (if (and (occurrence-coordinate? occurrence) (triple? proposition))
    (triple occurrence asserts proposition)
    (throw (ex-info "fram: assertion requires an occurrence coordinate"
                    {:type :invalid-assertion-occurrence}))))

(defn retraction-occurrence [(occurrence Triple) (proposition Triple)] Triple
  (if (and (occurrence-coordinate? occurrence) (triple? proposition))
    (triple occurrence retracts proposition)
    (throw (ex-info "fram: retraction requires an occurrence coordinate"
                    {:type :invalid-retraction-occurrence}))))

(defn withdrawal [(retraction Triple) (target Triple)] Triple
  (if (and (occurrence-coordinate? retraction) (occurrence-coordinate? target))
    (triple retraction withdraws target)
    (throw (ex-info "fram: withdrawal requires retraction and target occurrence coordinates"
                    {:type :invalid-withdrawal}))))

(defn recorded-at [(source Triple) (at Instant)] Triple
  (if (and (triple? source) (instant? at))
    (triple source recorded-at-predicate at)
    (throw (ex-info "fram: recorded-at requires a triple source and Instant"
                    {:type :invalid-recorded-at}))))

(defn occurrence-before? [(left Triple) (right Triple)] Bool
  (if (and (occurrence-coordinate? left) (occurrence-coordinate? right))
    (let [(left-tx Triple) (triple-t1 left)
          (right-tx Triple) (triple-t1 right)
          (left-space String) (triple-t1 left-tx)
          (right-space String) (triple-t1 right-tx)
          (left-seq Int) (triple-t3 left-tx)
          (right-seq Int) (triple-t3 right-tx)
          (left-ordinal Int) (triple-t3 left)
          (right-ordinal Int) (triple-t3 right)]
      (if (= left-space right-space)
        (or (< left-seq right-seq)
            (and (= left-seq right-seq) (< left-ordinal right-ordinal)))
        (throw (ex-info "fram: occurrences from different spaces have no shared order"
                        {:type :incomparable-occurrence-spaces}))))
    (throw (ex-info "fram: occurrence ordering requires occurrence coordinates"
                    {:type :invalid-occurrence-order}))))
