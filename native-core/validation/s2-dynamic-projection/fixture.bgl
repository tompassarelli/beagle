#lang beagle
(ns native.s2-dynamic-projection)

(def TEXTS (Vec String) ["A" "B"])

(defn direct-map [(value Any)] Int
  (if (map? value)
    (let [item (get value :number 0)
          updated (assoc value :extra 9)]
      (if (and (contains? updated :number) (integer? item))
        item
        0))
    0))

(defn short-map [(value Any)] Int
  (if (and (map? value) (contains? value :number))
    (count (keys value))
    0))

(defn direct-vector [(value Any)] Int
  (if (vector? value) (count value) 0))

(defn short-vector [(value Any)] Int
  (if (and (vector? value) (> (count value) 2))
    (let [item (nth value 0)
          changed (assoc value 0 9)
          joined (into (subvec changed 0 1) (subvec value 1 3))]
      (if (and (= (count joined) 3) (integer? item)) item 0))
    0))

(defn direct-set [(value Any)] Int
  (if (set? value) (count value) 0))

(defn short-set [(value Any)] Int
  (if (and (set? value) (contains? value 2))
    (let [items (vec value)
          doubled (into items items)]
      (do
        (doseq [item items]
          (integer? item))
        (reduce
          (fn [(total Int) (item Any)] Int
            (if (integer? item) (+ total item) total))
          0
          doubled)))
    0))

(defn direct-text [(value Any)] Int
  (if (string? value) (count (str/trim value)) 0))

(defn short-text [(value Any)] Int
  (if (and (string? value) (str/includes? value "EAGLE"))
    (count (str/lower-case (str/trim value)))
    0))

(defn cond-projection [(value Any)] Int
  (cond
    (map? value) (count (keys value))
    (vector? value) (count (subvec value 0 1))
    (set? value) (count (vec value))
    (string? value) (count (str/trim value))
    :else 0))

(defn unguarded-map [(value Any)] Int
  (let [updated (assoc value :extra 9 :other 10)
        cleaned (dissoc updated :number)]
    (if (and (contains? updated :extra)
             (= (get updated :extra 0) 9)
             (= (get updated :other 0) 10)
             (= (count (keys cleaned)) 2))
      9
      0)))

(defn nullable-map
  [(value (U (Map Keyword Int) Nil)) (key Keyword)]
  Int
  (get value key 0))

(defn unguarded-vector [(value Any)] Int
  (let [pushed (conj value 4)
        sliced (subvec value 1 3)
        joined (into value value)
        distinct (set value)
        copied (vec value)]
    (if (and (= (first value) 1)
             (= (last value) 3)
             (= (peek value) 3)
             (= (count pushed) 4)
             (= (count sliced) 2)
             (= (count joined) 6)
             (= (count distinct) 3)
             (= (count copied) 3))
      8
      0)))

(defn unguarded-text [(value Any) (declared (Vec String))] String
  (let [lowered (str/lower-case value)
        replaced (str/replace value #"A" "a")
        pieces (str/split value #"-" -1)]
    (if (and (str/starts-with? lowered "a")
             (str/includes? replaced "a-")
             (str/ends-with? value "-")
             (= (count declared) 2))
      (str/join ":" pieces)
      "")))

(defn unguarded-str [(value Any)] String
  (str "value=" value))

(defn unguarded-map-tail [(value Any)] Int
  (count (vals value)))

(defn unguarded-vector-tail [(value Any)] Int
  (let [tail (rest value)
        popped (pop value)
        flipped (reverse value)
        doubled (concat value value)]
    (if (and (= (count tail) 2)
             (= (count popped) 2)
             (= (count flipped) 3)
             (= (count doubled) 6))
      7
      0)))

(defn unguarded-set-tail [(value Any) (member Any)] Int
  (count (disj value member)))

(defn unguarded-text-tail [(value Any) (needle Any)] Int
  (let [sliced (subs value 1)
        trimmed (str/trim value)
        found (str/index-of value needle)
        last-found (str/last-index-of value needle)]
    (if (and (= (count sliced) 3)
             (= (count trimmed) 4)
             (some? found)
             (some? last-found))
      6
      0)))

(defn unguarded-regex [(value Any)] Int
  (if (re-matches #"A.*" value) 5 0))

(defn carrier-vector [] Any
  [1 2 3])

(defn carrier-count [(items Any)] Int
  (count items))

(defn reduce-dynamic-texts [(items (Vec Any))] String
  (reduce
    (fn [(result String) (item String)] String
      (str result item))
    ""
    items))

(defn step-counter! [] Int
  (let [cell (atom 4)]
    (do
      (swap! cell inc)
      (swap! cell dec)
      (deref cell))))

(defn main! [] Int
  (if (and (= (direct-map {:number 7}) 7)
           (= (short-map {:number 7}) 1)
           (= (direct-vector [4 5 6]) 3)
           (= (short-vector [4 5 6]) 4)
           (= (direct-set #{1 2 3}) 3)
           (= (short-set #{1 2 3}) 12)
           (= (direct-text " ok ") 2)
           (= (short-text "  BEAGLE  ") 6)
           (= (cond-projection {:left 1 :right 2}) 2)
           (= (cond-projection [8]) 1)
           (= (cond-projection #{8}) 1)
           (= (cond-projection " ok ") 2)
           (= (unguarded-map {:number 7}) 9)
           (= (nullable-map {:number 7} :number) 7)
           (= (unguarded-vector [1 2 3]) 8)
           (= (unguarded-text "A-B-" TEXTS) "A:B:")
           (= (unguarded-str 7) "value=7")
           (= (unguarded-map-tail {:number 7}) 1)
           (= (unguarded-vector-tail [1 2 3]) 7)
           (= (unguarded-set-tail #{1 2 3} 2) 2)
           (= (unguarded-text-tail "A-B-" "-") 6)
           (= (unguarded-regex "A-B-") 5)
           (= (carrier-count (carrier-vector)) 3)
           (= (reduce-dynamic-texts ["A" "B"]) "AB")
           (= (step-counter!) 4))
    0
    1))
