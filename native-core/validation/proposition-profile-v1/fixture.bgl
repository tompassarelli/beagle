(defn append-forward-case [] Bool
  (match (execute-query base-world append-forward-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (and
       (= :complete status)
       (= 1 (count answers))
       (= [(canonical-node-term fixture-arena abc-list-node)]
          (answer-canonical-terms (first answers)))
       (= :fifo-clauses
          (strategyselectionreceiptv1-strategy-kind selection))
       (= append-forward-strategy-id
          (strategyselectionreceiptv1-strategy-id selection)))]))

(defn append-splits-case [] Bool
  (let [empty-term String (canonical-node-term fixture-arena nil-node)
        a-list-direct String (canonical-runtime-term
          fixture-arena
          [(->LogicBindingV1
             (->TermRefV1 append-x-node 1) (->TermRefV1 a-node 0))
           (->LogicBindingV1
             (->TermRefV1 append-xs-node 1) (->TermRefV1 nil-node 0))]
          (->TermRefV1 append-x-xs-node 1))
        b-list-term String (canonical-node-term fixture-arena b-list-node)
        ab-list-term String (canonical-node-term fixture-arena ab-list-node)]
    (match (execute-query base-world append-splits-query)
      [(QueryInvalidV1 problem) false]
      [(QueryFinishedV1 status answers proofs counters selection result-id)
       (and
         (= :complete status)
         (= 3 (count answers))
         (= [empty-term ab-list-term]
            (answer-canonical-terms (nth answers 0)))
         (= [a-list-direct b-list-term]
            (answer-canonical-terms (nth answers 1)))
         (= [ab-list-term empty-term]
            (answer-canonical-terms (nth answers 2)))
         (= append-splits-strategy-id
            (strategyselectionreceiptv1-strategy-id selection)))])))

(defn calls-orientations-case [] Bool
  (match (execute-query base-world calls-forward-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1
       forward-status forward-answers forward-proofs forward-counters
       forward-selection forward-result-id)
     (match (execute-query base-world calls-reverse-query)
       [(QueryInvalidV1 problem) false]
       [(QueryFinishedV1
          reverse-status reverse-answers reverse-proofs reverse-counters
          reverse-selection reverse-result-id)
        (and
          (= :complete forward-status)
          (= :complete reverse-status)
          (= calls-relation-id
             (strategyselectionreceiptv1-relation-id forward-selection))
          (= calls-relation-id
             (strategyselectionreceiptv1-relation-id reverse-selection))
          (= :fact-forward
             (strategyselectionreceiptv1-strategy-kind forward-selection))
          (= :fact-reverse
             (strategyselectionreceiptv1-strategy-kind reverse-selection))
          (not= (strategyselectionreceiptv1-strategy-id forward-selection)
                (strategyselectionreceiptv1-strategy-id reverse-selection))
          (= [(canonical-node-term fixture-arena run-rules-node)]
             (answer-canonical-terms (first forward-answers)))
          (= [(canonical-node-term fixture-arena blast-closure-node)]
             (answer-canonical-terms (first reverse-answers)))
          (= 1 (count forward-answers))
          (= 1 (count reverse-answers))
          (= 2 (count forward-proofs))
          (= 2 (count reverse-proofs)))])]))

(defn source-projections-case [] Bool
  (let [result-a QueryResultV1 (execute-query base-world calls-forward-query)
        result-b QueryResultV1 (execute-query base-world calls-forward-query)
        receipt-a ProjectionReceiptV1 (projection-receipt base-world source-projection-a)
        receipt-b ProjectionReceiptV1 (projection-receipt base-world source-projection-b)]
    (match result-a
      [(QueryInvalidV1 problem) false]
      [(QueryFinishedV1
         status-a answers-a proofs-a counters-a selection-a result-id-a)
       (match result-b
         [(QueryInvalidV1 problem) false]
         [(QueryFinishedV1
            status-b answers-b proofs-b counters-b selection-b result-id-b)
          (and
            (= (world-audit-id base-world)
               (projectionreceiptv1-world-audit-id receipt-a))
            (= (projectionreceiptv1-world-audit-id receipt-a)
               (projectionreceiptv1-world-audit-id receipt-b))
            (not= (projectionreceiptv1-identity receipt-a)
                  (projectionreceiptv1-identity receipt-b))
            (not= (sourceprojectionv1-source-path source-projection-a)
                  (sourceprojectionv1-source-path source-projection-b))
            (= result-id-a result-id-b)
            (= (strategyselectionreceiptv1-identity selection-a)
               (strategyselectionreceiptv1-identity selection-b))
            (= (answerv1-identity (first answers-a))
               (answerv1-identity (first answers-b)))
            (not= (render-answer
                    base-world source-projection-a (first answers-a))
                  (render-answer
                    base-world source-projection-b (first answers-b))))])])))

(defn dependency-invalidation-case [] Bool
  (match (execute-query base-world calls-forward-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1
       base-status base-answers base-proofs base-counters
       base-selection base-result-id)
     (match (execute-query relevant-change-world calls-forward-query)
       [(QueryInvalidV1 problem) false]
       [(QueryFinishedV1
          relevant-status relevant-answers relevant-proofs relevant-counters
          relevant-selection relevant-result-id)
        (match (execute-query unrelated-change-world calls-forward-query)
          [(QueryInvalidV1 problem) false]
          [(QueryFinishedV1
             unrelated-status unrelated-answers unrelated-proofs unrelated-counters
             unrelated-selection unrelated-result-id)
           (and
             (not= (world-audit-id base-world)
                   (world-audit-id relevant-change-world))
             (not= (world-audit-id base-world)
                   (world-audit-id unrelated-change-world))
             (not= (strategyselectionreceiptv1-identity base-selection)
                   (strategyselectionreceiptv1-identity relevant-selection))
             (= (strategyselectionreceiptv1-identity base-selection)
                (strategyselectionreceiptv1-identity unrelated-selection))
             (not= base-result-id relevant-result-id)
             (= base-result-id unrelated-result-id)
             (= 1 (count base-answers))
             (= 2 (count relevant-answers))
             (= base-answers unrelated-answers)
             (= base-proofs unrelated-proofs))])])]))

(defn compiler-dependency-orientations-case [] Bool
  (match (execute-query compiler-world compiler-reads-forward-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1
       forward-status forward-answers forward-proofs forward-counters
       forward-selection forward-result-id)
     (match (execute-query compiler-world compiler-reads-reverse-query)
       [(QueryInvalidV1 problem) false]
       [(QueryFinishedV1
          reverse-status reverse-answers reverse-proofs reverse-counters
          reverse-selection reverse-result-id)
        (and
          (= :complete forward-status)
          (= :complete reverse-status)
          (= [(canonical-node-term
                compiler-arena compiler-private-offset-node)]
             (single-output-answer-terms forward-answers))
          (= [(canonical-node-term
                compiler-arena compiler-score-value-node)]
             (single-output-answer-terms reverse-answers))
          (= 1 (count forward-proofs))
          (= 1 (count reverse-proofs))
          (= reads-semantic-unit-relation-id
             (strategyselectionreceiptv1-relation-id forward-selection))
          (= reads-semantic-unit-relation-id
             (strategyselectionreceiptv1-relation-id reverse-selection))
          (= :fact-forward
             (strategyselectionreceiptv1-strategy-kind forward-selection))
          (= :fact-reverse
             (strategyselectionreceiptv1-strategy-kind reverse-selection))
          (not= (strategyselectionreceiptv1-strategy-id forward-selection)
                (strategyselectionreceiptv1-strategy-id reverse-selection)))])]))

(defn compiler-invalidation-case [] Bool
  (match (execute-query compiler-world compiler-comment-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1
       comment-status comment-answers comment-proofs comment-counters
       comment-selection comment-result-id)
     (match (execute-query compiler-world compiler-private-query)
       [(QueryInvalidV1 problem) false]
       [(QueryFinishedV1
          private-status private-answers private-proofs private-counters
          private-selection private-result-id)
        (match (execute-query compiler-world compiler-public-query)
          [(QueryInvalidV1 problem) false]
          [(QueryFinishedV1
             public-status public-answers public-proofs public-counters
             public-selection public-result-id)
           (let [private-expected (Vec String) [(canonical-node-term
                     compiler-arena compiler-private-offset-node)]
                 public-expected (Vec String) [(canonical-node-term compiler-arena compiler-adjust-node)
                   (canonical-node-term compiler-arena compiler-score-value-node)]]
             (and
               (= :complete comment-status)
               (= :complete private-status)
               (= :complete public-status)
               (= 0 (count comment-answers))
               (= 0 (count comment-proofs))
               (same-string-set?
                 private-expected
                 (single-output-answer-terms private-answers))
               (same-string-set?
                 public-expected
                 (single-output-answer-terms public-answers))
               (= 1 (count private-proofs))
               (= 3 (count public-proofs))
               (= :fifo-clauses
                  (strategyselectionreceiptv1-strategy-kind comment-selection))
               (= :fifo-clauses
                  (strategyselectionreceiptv1-strategy-kind private-selection))
               (= :fifo-clauses
                  (strategyselectionreceiptv1-strategy-kind public-selection))
               (= observed-unit-churn-of-relation-id
                  (strategyselectionreceiptv1-relation-id comment-selection))
               (= observed-unit-churn-of-relation-id
                  (strategyselectionreceiptv1-relation-id private-selection))
               (= observed-unit-churn-of-relation-id
                  (strategyselectionreceiptv1-relation-id public-selection))))])])]))

(defn compiler-read-enumeration-case [] Bool
  (match (execute-query compiler-world compiler-reads-enumerate-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (and
       (= :complete status)
       (= 6 (count answers))
       (= 6 (count proofs))
       (= compiler-reads-enumerate-strategy-id
          (strategyselectionreceiptv1-strategy-id selection))
       (same-string-set?
         ["corpus.foundation/adjust\tcorpus.foundation/private-offset"
          "corpus.feature/score-value\tcorpus.foundation/adjust"
          "corpus.feature/stable-score\tcorpus.foundation/double-value"
          "corpus.app/run-score\tcorpus.feature/score-value"
          "corpus.app/run-stable\tcorpus.feature/stable-score"
          "corpus.app/run-independent\tcorpus.independent/independent-value"]
         (compiler-read-lines)))]))

(defn compiler-query-boundaries-case [] Bool
  (match (execute-query compiler-world compiler-underconstrained-query)
    [(QueryFinishedV1 status answers proofs counters selection result-id) false]
    [(QueryInvalidV1 problem)
     (and
       (= :mode-groundness (problemv1-code problem))
       (= [compiler-churn-mode-id] (problemv1-evidence problem))
       (match (execute-query compiler-world compiler-public-bounded-query)
         [(QueryInvalidV1 bounded-problem) false]
         [(QueryFinishedV1
            status answers proofs counters selection result-id)
          (and
            (= :truncated-reductions status)
            (= 0 (count answers))
            (= 1 (searchcountersv1-reductions counters)))]))]))

(defn compiler-dependency-invalidation-case [] Bool
  (match (execute-query compiler-world compiler-comment-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1
       base-status base-answers base-proofs base-counters
       base-selection base-result-id)
     (match (execute-query compiler-relevant-world compiler-comment-query)
       [(QueryInvalidV1 problem) false]
       [(QueryFinishedV1
          relevant-status relevant-answers relevant-proofs relevant-counters
          relevant-selection relevant-result-id)
        (match (execute-query compiler-unrelated-world compiler-comment-query)
          [(QueryInvalidV1 problem) false]
          [(QueryFinishedV1
             unrelated-status unrelated-answers unrelated-proofs
             unrelated-counters unrelated-selection unrelated-result-id)
           (and
             (= :complete base-status)
             (= :complete relevant-status)
             (= :complete unrelated-status)
             (= 0 (count base-answers))
             (= [(canonical-node-term
                   compiler-arena compiler-independent-value-node)]
                (single-output-answer-terms relevant-answers))
             (= base-answers unrelated-answers)
             (= base-proofs unrelated-proofs)
             (not= (world-audit-id compiler-world)
                   (world-audit-id compiler-relevant-world))
             (not= (world-audit-id compiler-world)
                   (world-audit-id compiler-unrelated-world))
             (not= (strategyselectionreceiptv1-identity base-selection)
                   (strategyselectionreceiptv1-identity relevant-selection))
             (= (strategyselectionreceiptv1-identity base-selection)
                (strategyselectionreceiptv1-identity unrelated-selection))
             (not= base-result-id relevant-result-id)
             (= base-result-id unrelated-result-id))])])]))

(defn occurs-check-case [] Bool
  (match (unify-terms
           fixture-arena []
           (->TermRefV1 occurs-variable-node 0)
           (->TermRefV1 occurs-cons-node 0))
    [(NotUnifiedV1 code) (= :occurs-check code)]
    [(UnifiedV1 bindings) false]))

(defn duplicate-variable-ordinal-rejected-case [] Bool
  (not
    (arena-valid?
      fixture-sorts fixture-shapes duplicate-variable-ordinal-arena)))

(defn unsupported-mode-case [] Bool
  (match (execute-query base-world append-unsupported-query)
    [(QueryInvalidV1 problem) (= :unsupported-mode (problemv1-code problem))]
    [(QueryFinishedV1 status answers proofs counters selection result-id) false]))

(defn loop-truncation-case [] Bool
  (match (execute-query base-world loop-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (and
       (= :truncated-reductions status)
       (= 0 (count answers))
       (= 8 (searchcountersv1-reductions counters)))]))

(defn fair-sibling-case [] Bool
  (match (execute-query base-world fair-query)
    [(QueryInvalidV1 problem) false]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (and
       (= :truncated-reductions status)
       (= 1 (count answers))
       (= [(canonical-node-term fixture-arena a-node)]
          (answer-canonical-terms (first answers)))
       (> (searchcountersv1-agenda-peak counters) 1))]))

(defn canonical-result-encoding [result QueryResultV1] String
  (match result
    [(QueryInvalidV1 problem)
     (canonical-parts-v1
       ["invalid"
        (str (problemv1-code problem))
        (problemv1-message problem)
        (canonical-parts-v1 (problemv1-evidence problem))])]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (canonical-parts-v1
       ["finished"
        (str status)
        (canonical-parts-v1
          (mapv
            (fn [answer AnswerV1] String (answerv1-identity answer))
            answers))
        (canonical-parts-v1
          (mapv
            (fn [proof ProofOccurrenceV1] String
              (proofoccurrencev1-identity proof))
            proofs))
        (str (searchcountersv1-reductions counters))
        (str (searchcountersv1-agenda-peak counters))
        (strategyselectionreceiptv1-identity selection)
        (strategyselectionreceiptv1-world-audit-id selection)
        result-id])]))

(defn repeat-determinism-case [] Bool
  (let [first-run QueryResultV1 (execute-query base-world append-splits-query)
        second-run QueryResultV1 (execute-query base-world append-splits-query)]
    (and
      (= first-run second-run)
      (= (utf8-encode (canonical-result-encoding first-run))
         (utf8-encode (canonical-result-encoding second-run))))))

(defn compiler-repeat-determinism-case [] Bool
  (let [first-run QueryResultV1 (execute-query compiler-world compiler-public-query)
        second-run QueryResultV1 (execute-query compiler-world compiler-public-query)]
    (and
      (= first-run second-run)
      (= (utf8-encode (canonical-result-encoding first-run))
         (utf8-encode (canonical-result-encoding second-run))))))

(defn readable-answer
  [world TheoryWorldV1
   projection SourceProjectionV1
   answer AnswerV1] String
  (loop [index Int 0
         rendered String ""]
    (if (>= index (count (answerv1-bindings answer)))
      rendered
      (let [binding AnswerBindingV1 (nth (answerv1-bindings answer) index)]
        (recur
          (+ index 1)
          (str rendered
               (if (= index 0) "" ", ")
               (preferred-rendering
                 projection (answerbindingv1-output-id binding))
               " = "
               (render-runtime-term
                 world projection (answerv1-resolution answer)
                 (answerbindingv1-term binding))))))))

(defn readable-result
  [world TheoryWorldV1
   projection SourceProjectionV1
   result QueryResultV1] String
  (match result
    [(QueryInvalidV1 problem)
     (str "invalid(" (problemv1-code problem) ")")]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (loop [index Int 0
            rendered String ""]
       (if (>= index (count answers))
         (if (= rendered "") "no answers" rendered)
         (recur
           (+ index 1)
           (str rendered
                (if (= index 0) "" " ; ")
                (readable-answer world projection (nth answers index))))))]))

(defn result-status [result QueryResultV1] Keyword
  (match result
    [(QueryInvalidV1 problem) :invalid]
    [(QueryFinishedV1 status answers proofs counters selection result-id) status]))

(defn result-strategy [result QueryResultV1] Keyword
  (match result
    [(QueryInvalidV1 problem) :none]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (strategyselectionreceiptv1-strategy-kind selection)]))

(defn result-semantic-id [result QueryResultV1] String
  (match result
    [(QueryInvalidV1 problem)
     (str "invalid:" (problemv1-code problem))]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     result-id]))

(defn result-selection-id [result QueryResultV1] String
  (match result
    [(QueryInvalidV1 problem)
     (str "invalid:" (problemv1-code problem))]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (strategyselectionreceiptv1-identity selection)]))

(defn result-first-answer-id [result QueryResultV1] String
  (match result
    [(QueryInvalidV1 problem)
     (str "invalid:" (problemv1-code problem))]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (if (empty? answers) "no-answer" (answerv1-identity (first answers)))]))

(defn demo-lines [] (Vec String)
  (let [append-forward QueryResultV1 (execute-query base-world append-forward-query)
        append-splits QueryResultV1 (execute-query base-world append-splits-query)
        calls-forward-a QueryResultV1 (execute-query base-world calls-forward-query)
        calls-forward-b QueryResultV1 (execute-query base-world calls-forward-query)
        calls-reverse QueryResultV1 (execute-query base-world calls-reverse-query)
        calls-relevant QueryResultV1 (execute-query relevant-change-world calls-forward-query)
        calls-unrelated QueryResultV1 (execute-query unrelated-change-world calls-forward-query)
        compiler-reads-forward QueryResultV1 (execute-query compiler-world compiler-reads-forward-query)
        compiler-reads-reverse QueryResultV1 (execute-query compiler-world compiler-reads-reverse-query)
        compiler-comment QueryResultV1 (execute-query compiler-world compiler-comment-query)
        compiler-private QueryResultV1 (execute-query compiler-world compiler-private-query)
        compiler-public QueryResultV1 (execute-query compiler-world compiler-public-query)
        loop-result QueryResultV1 (execute-query base-world loop-query)
        fair-result QueryResultV1 (execute-query base-world fair-query)
        receipt-a ProjectionReceiptV1 (projection-receipt base-world source-projection-a)
        receipt-b ProjectionReceiptV1 (projection-receipt base-world source-projection-b)]
    ["Beagle proposition profile v1 — bounded executable experiment"
     "executor inputs: TheoryWorldV1 + QueryV1; SourceProjectionV1 is absent"
     (str "append([a b], [c], ?whole) via "
          (result-strategy append-forward)
          " => "
          (readable-result base-world source-projection-a append-forward))
     (str "append(?left, ?right, [a b]) via "
          (result-strategy append-splits)
          " => "
          (readable-result base-world source-projection-a append-splits))
     (str "calls(blast-closure!, ?callee) via "
          (result-strategy calls-forward-a)
          " => "
          (readable-result base-world source-projection-a calls-forward-a))
     (str "calls(?caller, d/run-rules!) via "
          (result-strategy calls-reverse)
          " => "
          (readable-result base-world source-projection-a calls-reverse))
     (str (sourceprojectionv1-source-path source-projection-a)
          " renders "
          (readable-result base-world source-projection-a calls-forward-a))
     (str (sourceprojectionv1-source-path source-projection-b)
          " renders "
          (readable-result base-world source-projection-b calls-forward-b))
     (str "projection receipts differ while answer/selection/result IDs remain: "
          (and
            (not= (projectionreceiptv1-identity receipt-a)
                  (projectionreceiptv1-identity receipt-b))
            (= (result-first-answer-id calls-forward-a)
               (result-first-answer-id calls-forward-b))
            (= (result-selection-id calls-forward-a)
               (result-selection-id calls-forward-b))
            (= (result-semantic-id calls-forward-a)
               (result-semantic-id calls-forward-b))))
     (str "unrelated theory edit remints world but preserves result ID: "
          (and
            (not= (world-audit-id base-world)
                  (world-audit-id unrelated-change-world))
            (= (result-semantic-id calls-forward-a)
               (result-semantic-id calls-unrelated))))
     (str "relevant calls edit remints result ID: "
          (not= (result-semantic-id calls-forward-a)
                (result-semantic-id calls-relevant)))
     (str "reads(adjust, ?dependency) / reads(?reader, adjust) via "
          (result-strategy compiler-reads-forward)
          " / "
          (result-strategy compiler-reads-reverse)
          " => "
          (readable-result
            compiler-world compiler-source-projection compiler-reads-forward)
          " / "
          (readable-result
            compiler-world compiler-source-projection compiler-reads-reverse))
     (str "observed compiler unit churn comment/private/public: "
          (readable-result
            compiler-world compiler-source-projection compiler-comment)
          " / "
          (readable-result
            compiler-world compiler-source-projection compiler-private)
          " / "
          (readable-result
            compiler-world compiler-source-projection compiler-public))
     (str "recursive loop status: " (result-status loop-result)
          "; ready sibling status/result: " (result-status fair-result)
          " / " (readable-result base-world source-projection-a fair-result))]))

(defn main [] Int
  (if
    (and
      (world-valid? base-world)
      (world-valid? relevant-change-world)
      (world-valid? unrelated-change-world)
      (world-valid? compiler-world)
      (world-valid? compiler-relevant-world)
      (world-valid? compiler-unrelated-world)
      (append-forward-case)
      (append-splits-case)
      (calls-orientations-case)
      (source-projections-case)
      (dependency-invalidation-case)
      (compiler-dependency-orientations-case)
      (compiler-invalidation-case)
      (compiler-read-enumeration-case)
      (compiler-query-boundaries-case)
      (compiler-dependency-invalidation-case)
      (occurs-check-case)
      (duplicate-variable-ordinal-rejected-case)
      (unsupported-mode-case)
      (loop-truncation-case)
      (fair-sibling-case)
      (repeat-determinism-case)
      (compiler-repeat-determinism-case))
    0
    1))
