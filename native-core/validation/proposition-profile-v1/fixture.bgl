(defn answer-canonical-terms [answer AnswerV1] (Vec String)
  (mapv
    (fn [binding AnswerBindingV1] String
      (answerbindingv1-canonical-term binding))
    (answerv1-bindings answer)))

(defn single-output-answer-terms [answers (Vec AnswerV1)] (Vec String)
  (mapv
    (fn [answer AnswerV1] String
      (answerbindingv1-canonical-term (first (answerv1-bindings answer))))
    answers))

(defn same-string-set?
  [left (Vec String)
   right (Vec String)] Bool
  (and
    (= (count left) (count right))
    (loop [index Int 0]
      (if (>= index (count left))
        true
        (and
          (string-member? right (nth left index))
          (recur (+ index 1)))))))

(defn answer-output-rendering
  [world TheoryWorldV1
   projection SourceProjectionV1
   answer AnswerV1
   output-index Int] String
  (let [binding AnswerBindingV1 (nth (answerv1-bindings answer) output-index)]
    (render-runtime-term
      world
      projection
      (answerv1-resolution answer)
      (answerbindingv1-term binding))))

(defn result-member-lines
  [world TheoryWorldV1
   projection SourceProjectionV1
   case-name String
   result QueryResultV1] (Vec String)
  (match result
    [(QueryInvalidV1 problem)
     [(str case-name "\tinvalid:" (problemv1-code problem))]]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (mapv
       (fn [answer AnswerV1] String
         (str case-name
              "\t"
              (answer-output-rendering world projection answer 0)))
       answers)]))

(defn compiler-read-lines [] (Vec String)
  (match (execute-query compiler-world compiler-reads-enumerate-query)
    [(QueryInvalidV1 problem)
     [(str "invalid:" (problemv1-code problem))]]
    [(QueryFinishedV1 status answers proofs counters selection result-id)
     (mapv
       (fn [answer AnswerV1] String
         (str (answer-output-rendering
                compiler-world compiler-source-projection answer 0)
              "\t"
              (answer-output-rendering
                compiler-world compiler-source-projection answer 1)))
       answers)]))

(defn compiler-cone-member-lines [] (Vec String)
  (append-strings
    (result-member-lines
      compiler-world
      compiler-source-projection
      "comment-layout"
      (execute-query compiler-world compiler-comment-query))
    (append-strings
      (result-member-lines
        compiler-world
        compiler-source-projection
        "private-implementation"
        (execute-query compiler-world compiler-private-query))
      (result-member-lines
        compiler-world
        compiler-source-projection
        "public-interface"
        (execute-query compiler-world compiler-public-query)))))

