(def compiler-arena TermArenaV1
  (->TermArenaV1
    [(->VariableNodeV1 symbol-sort-id 0)
     (->VariableNodeV1 symbol-sort-id 1)
     (->VariableNodeV1 symbol-sort-id 2)
     (->AtomNodeV1 symbol-sort-id corpus-private-offset-id)
     (->AtomNodeV1 symbol-sort-id corpus-adjust-id)
     (->AtomNodeV1 symbol-sort-id corpus-double-value-id)
     (->AtomNodeV1 symbol-sort-id corpus-score-value-id)
     (->AtomNodeV1 symbol-sort-id corpus-stable-score-id)
     (->AtomNodeV1 symbol-sort-id corpus-independent-value-id)
     (->AtomNodeV1 symbol-sort-id corpus-run-score-id)
     (->AtomNodeV1 symbol-sort-id corpus-run-stable-id)
     (->AtomNodeV1 symbol-sort-id corpus-run-independent-id)
     (->AtomNodeV1 symbol-sort-id corpus-comment-mutation-id)
     (->AtomNodeV1 symbol-sort-id corpus-private-mutation-id)
     (->AtomNodeV1 symbol-sort-id corpus-public-mutation-id)]
    32))

(def compiler-reads-relation RelationV1
  (->RelationV1
    reads-semantic-unit-relation-id
    [symbol-sort-id symbol-sort-id]
    [(->ModeV1 compiler-reads-forward-mode-id [:ground :logic] :nondet)
     (->ModeV1 compiler-reads-reverse-mode-id [:logic :ground] :nondet)
     (->ModeV1 compiler-reads-enumerate-mode-id [:logic :logic] :multi)]
    [(->StrategyV1
       compiler-reads-forward-strategy-id
       compiler-reads-forward-mode-id
       :fact-forward
       "ordered direct-read scan from reader identity"
       "finite compiler-emitted semantic read extent")
     (->StrategyV1
       compiler-reads-reverse-strategy-id
       compiler-reads-reverse-mode-id
       :fact-reverse
       "ordered direct-reader scan from dependency identity"
       "finite compiler-emitted semantic read extent")
     (->StrategyV1
       compiler-reads-enumerate-strategy-id
       compiler-reads-enumerate-mode-id
       :fifo-clauses
       "ordered complete direct-read enumeration"
       "finite compiler-emitted semantic read extent")]))

(def compiler-content-change-relation RelationV1
  (->RelationV1
    changes-semantic-content-of-relation-id
    [symbol-sort-id symbol-sort-id]
    [(->ModeV1 compiler-content-change-mode-id [:ground :logic] :nondet)]
    [(->StrategyV1
       compiler-content-change-strategy-id
       compiler-content-change-mode-id
       :fact-forward
       "ordered changed-content scan from mutation identity"
       "finite tracked mutation extent")]))

(def compiler-contract-change-relation RelationV1
