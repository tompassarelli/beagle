  (fixture-id "strategy" "calls/fact-forward"))
(def calls-reverse-strategy-id String
  (fixture-id "strategy" "calls/fact-reverse"))
(def loop-strategy-id String (fixture-id "strategy" "loop/fifo"))
(def fair-strategy-id String (fixture-id "strategy" "fair/fifo"))
(def tagged-strategy-id String (fixture-id "strategy" "tagged/fact-forward"))

(def symbol-a-id String (fixture-id "symbol" "a"))
(def symbol-b-id String (fixture-id "symbol" "b"))
(def symbol-c-id String (fixture-id "symbol" "c"))
(def blast-closure-id String (fixture-id "binding" "blast-closure!"))
(def run-rules-id String (fixture-id "binding" "d/run-rules!"))
(def store-transact-id String (fixture-id "binding" "store/transact"))
(def north-id String (fixture-id "binding" "North"))
(def beagle-id String (fixture-id "binding" "Beagle"))
(def artifact-id String (fixture-id "binding" "North.wasm"))
(def source-id String (fixture-id "binding" "North"))

(def append-output-id String (fixture-id "query-output" "whole"))
(def append-left-output-id String (fixture-id "query-output" "left"))
(def append-right-output-id String (fixture-id "query-output" "right"))
(def calls-output-id String (fixture-id "query-output" "participant"))
(def fair-output-id String (fixture-id "query-output" "ready"))

(def append-x-node Int 0)
(def append-xs-node Int 1)
(def append-ys-node Int 2)
(def append-zs-node Int 3)
(def nil-node Int 4)
(def append-x-xs-node Int 5)
(def append-x-zs-node Int 6)
(def a-node Int 7)
(def b-node Int 8)
(def c-node Int 9)
(def c-list-node Int 10)
(def b-list-node Int 11)
(def ab-list-node Int 12)
(def bc-list-node Int 13)
(def abc-list-node Int 14)
(def append-output-node Int 15)
(def append-left-node Int 16)
(def append-right-node Int 17)
(def append-free-whole-node Int 18)
(def occurs-variable-node Int 19)
(def occurs-cons-node Int 20)
(def blast-closure-node Int 21)
(def run-rules-node Int 22)
(def store-transact-node Int 23)
(def calls-forward-output-node Int 24)
(def calls-reverse-output-node Int 25)
(def north-node Int 26)
(def beagle-node Int 27)
(def artifact-node Int 28)
(def source-node Int 29)
(def tagged-output-node Int 30)
(def fair-output-node Int 31)

(def fixture-sorts (Vec SortSpecV1)
  [(->SortSpecV1 symbol-sort-id :symbol)
   (->SortSpecV1 symbol-list-sort-id :constructed)])

(def fixture-shapes (Vec ShapeSpecV1)
  [(->ShapeSpecV1 nil-shape-id symbol-list-sort-id [])
   (->ShapeSpecV1
     cons-shape-id symbol-list-sort-id [symbol-sort-id symbol-list-sort-id])])

(def fixture-arena TermArenaV1
  (->TermArenaV1
    [(->VariableNodeV1 symbol-sort-id 0)
     (->VariableNodeV1 symbol-list-sort-id 1)
     (->VariableNodeV1 symbol-list-sort-id 2)
     (->VariableNodeV1 symbol-list-sort-id 3)
     (->ConstructorNodeV1 symbol-list-sort-id nil-shape-id [])
     (->ConstructorNodeV1
       symbol-list-sort-id cons-shape-id [append-x-node append-xs-node])
     (->ConstructorNodeV1
       symbol-list-sort-id cons-shape-id [append-x-node append-zs-node])
     (->AtomNodeV1 symbol-sort-id symbol-a-id)
     (->AtomNodeV1 symbol-sort-id symbol-b-id)
     (->AtomNodeV1 symbol-sort-id symbol-c-id)
     (->ConstructorNodeV1 symbol-list-sort-id cons-shape-id [c-node nil-node])
     (->ConstructorNodeV1 symbol-list-sort-id cons-shape-id [b-node nil-node])
     (->ConstructorNodeV1 symbol-list-sort-id cons-shape-id [a-node b-list-node])
     (->ConstructorNodeV1 symbol-list-sort-id cons-shape-id [b-node c-list-node])
     (->ConstructorNodeV1 symbol-list-sort-id cons-shape-id [a-node bc-list-node])
     (->VariableNodeV1 symbol-list-sort-id 15)
     (->VariableNodeV1 symbol-list-sort-id 16)
     (->VariableNodeV1 symbol-list-sort-id 17)
     (->VariableNodeV1 symbol-list-sort-id 18)
     (->VariableNodeV1 symbol-list-sort-id 19)
     (->ConstructorNodeV1
       symbol-list-sort-id cons-shape-id [a-node occurs-variable-node])
     (->AtomNodeV1 symbol-sort-id blast-closure-id)
     (->AtomNodeV1 symbol-sort-id run-rules-id)
     (->AtomNodeV1 symbol-sort-id store-transact-id)
     (->VariableNodeV1 symbol-sort-id 24)
     (->VariableNodeV1 symbol-sort-id 25)
     (->AtomNodeV1 symbol-sort-id north-id)
     (->AtomNodeV1 symbol-sort-id beagle-id)
     (->AtomNodeV1 symbol-sort-id artifact-id)
     (->AtomNodeV1 symbol-sort-id source-id)
     (->VariableNodeV1 symbol-sort-id 30)
     (->VariableNodeV1 symbol-sort-id 31)]
    64))

(def duplicate-variable-ordinal-arena TermArenaV1
  (->TermArenaV1
    [(->VariableNodeV1 symbol-sort-id 0)
     (->VariableNodeV1 symbol-sort-id 0)]
    2))

(def append-relation RelationV1
  (->RelationV1
    append-relation-id
    [symbol-list-sort-id symbol-list-sort-id symbol-list-sort-id]
    [(->ModeV1 append-forward-mode-id [:ground :ground :logic] :det)
     (->ModeV1 append-splits-mode-id [:logic :logic :ground] :multi)]
    [(->StrategyV1
       append-forward-strategy-id append-forward-mode-id :fifo-clauses
       "linear in the first list"
       "finite when the first participant is a finite ground list")
     (->StrategyV1
       append-splits-strategy-id append-splits-mode-id :fifo-clauses
       "linear number of ordered splits"
       "finite when the whole participant is a finite ground list")]))

(def calls-relation RelationV1
  (->RelationV1
    calls-relation-id
    [symbol-sort-id symbol-sort-id]
    [(->ModeV1 calls-forward-mode-id [:ground :logic] :multi)
     (->ModeV1 calls-reverse-mode-id [:logic :ground] :multi)]
    [(->StrategyV1
       calls-forward-strategy-id calls-forward-mode-id :fact-forward
       "ordered fact scan from caller"
       "finite admitted fact extent")
     (->StrategyV1
       calls-reverse-strategy-id calls-reverse-mode-id :fact-reverse
       "ordered reverse fact scan from callee"
       "finite admitted fact extent")]))

(def loop-relation RelationV1
  (->RelationV1
    loop-relation-id
    []
    [(->ModeV1 loop-mode-id [] :nondet)]
    [(->StrategyV1
       loop-strategy-id loop-mode-id :fifo-clauses
       "unbounded recursive branch"
       "only the explicit query reduction bound terminates execution")]))

(def fair-relation RelationV1
  (->RelationV1
    fair-relation-id
    [symbol-sort-id]
    [(->ModeV1 fair-mode-id [:logic] :nondet)]
    [(->StrategyV1
       fair-strategy-id fair-mode-id :fifo-clauses
       "fair clause agenda"
       "bounded prefix; completeness is not claimed after truncation")]))

(def tagged-relation RelationV1
  (->RelationV1
    tagged-relation-id
    [symbol-sort-id symbol-sort-id]
    [(->ModeV1 tagged-mode-id [:ground :logic] :nondet)]
    [(->StrategyV1
       tagged-strategy-id tagged-mode-id :fact-forward
       "ordered fact scan"
       "finite admitted fact extent")]))

(def fixture-relations (Vec RelationV1)
  [append-relation calls-relation loop-relation fair-relation tagged-relation])

(def append-base-clause ClauseV1
  (->ClauseV1
    append-relation-id [nil-node append-ys-node append-ys-node] []
    [(fixture-id "evidence" "append/base")]))

(def append-recursive-clause ClauseV1
  (->ClauseV1
    append-relation-id
    [append-x-xs-node append-ys-node append-x-zs-node]
    [(->RelationGoalV1
       append-relation-id [append-xs-node append-ys-node append-zs-node])]
    [(fixture-id "evidence" "append/recursive")]))

(def calls-primary-clause ClauseV1
  (->ClauseV1
    calls-relation-id [blast-closure-node run-rules-node] []
    [(fixture-id "evidence" "calls/occurrence-one")]))

(def calls-second-proof-clause ClauseV1
  (->ClauseV1
    calls-relation-id [blast-closure-node run-rules-node] []
    [(fixture-id "evidence" "calls/occurrence-two")]))

(def calls-relevant-change-clause ClauseV1
  (->ClauseV1
    calls-relation-id [blast-closure-node store-transact-node] []
    [(fixture-id "evidence" "calls/relevant-change")]))

(def loop-clause ClauseV1
  (->ClauseV1
    loop-relation-id [] [(->RelationGoalV1 loop-relation-id [])]
    [(fixture-id "evidence" "loop/recursive")]))

(def fair-looping-clause ClauseV1
  (->ClauseV1
    fair-relation-id [fair-output-node]
    [(->RelationGoalV1 loop-relation-id [])]
    [(fixture-id "evidence" "fair/looping-first")]))

(def fair-ready-clause ClauseV1
  (->ClauseV1
    fair-relation-id [a-node] []
    [(fixture-id "evidence" "fair/ready-second")]))

(def tagged-base-clause ClauseV1
  (->ClauseV1
    tagged-relation-id [north-node beagle-node] []
    [(fixture-id "evidence" "tagged/base")]))

(def tagged-unrelated-change-clause ClauseV1
  (->ClauseV1
    tagged-relation-id [artifact-node source-node] []
    [(fixture-id "evidence" "tagged/unrelated-change")]))

(def fixture-base-clauses (Vec ClauseV1)
  [append-base-clause
   append-recursive-clause
   calls-primary-clause
   calls-second-proof-clause
   loop-clause
   fair-looping-clause
   fair-ready-clause
   tagged-base-clause])

(defn fixture-world [clauses (Vec ClauseV1)] TheoryWorldV1
  (->TheoryWorldV1
    profile-id profile-rule-epoch fixture-sorts fixture-shapes fixture-arena
    fixture-relations clauses))

(def base-world TheoryWorldV1 (fixture-world fixture-base-clauses))
(def relevant-change-world TheoryWorldV1
  (fixture-world (conj fixture-base-clauses calls-relevant-change-clause)))
(def unrelated-change-world TheoryWorldV1
  (fixture-world (conj fixture-base-clauses tagged-unrelated-change-clause)))

(def append-forward-query QueryV1
  (->QueryV1
    append-relation-id append-forward-mode-id
    [ab-list-node c-list-node append-output-node]
    [(->QueryOutputV1 append-output-id append-output-node)]
    64 32 8))

(def append-splits-query QueryV1
  (->QueryV1
    append-relation-id append-splits-mode-id
    [append-left-node append-right-node ab-list-node]
    [(->QueryOutputV1 append-left-output-id append-left-node)
     (->QueryOutputV1 append-right-output-id append-right-node)]
    96 32 8))

(def append-unsupported-query QueryV1
  (->QueryV1
    append-relation-id (fixture-id "mode" "append/logic-logic-logic")
    [append-left-node append-right-node append-free-whole-node]
    []
    16 8 8))

(def calls-forward-query QueryV1
  (->QueryV1
    calls-relation-id calls-forward-mode-id
    [blast-closure-node calls-forward-output-node]
    [(->QueryOutputV1 calls-output-id calls-forward-output-node)]
    16 8 8))

(def calls-reverse-query QueryV1
  (->QueryV1
    calls-relation-id calls-reverse-mode-id
    [calls-reverse-output-node run-rules-node]
    [(->QueryOutputV1 calls-output-id calls-reverse-output-node)]
    16 8 8))

(def loop-query QueryV1
  (->QueryV1 loop-relation-id loop-mode-id [] [] 8 4 1))

(def fair-query QueryV1
  (->QueryV1
    fair-relation-id fair-mode-id [fair-output-node]
    [(->QueryOutputV1 fair-output-id fair-output-node)]
    8 8 4))

(def source-projection-a SourceProjectionV1
  (->SourceProjectionV1
    (fixture-id "source-content" "projection-a")
    "demo/world-a.bgl"
    (fixture-id "layout" "compact-prefix")
    [(->PreferredNameV1 append-output-id "?whole")
     (->PreferredNameV1 append-left-output-id "?left")
     (->PreferredNameV1 append-right-output-id "?right")
     (->PreferredNameV1 calls-output-id "?participant")
