#lang beagle

(ns native.proposition-profile-v1-fixture)

;; This fixture is intentionally self-contained. It proves a semantic-profile
;; contract without registering a source language or creating a second Store
;; authority. A passing experiment may later justify extracting a library.

(defrecord SortSpecV1
  [identity String
   kind Keyword])

(defrecord ShapeSpecV1
  [identity String
   result-sort String
   slot-sorts (Vec String)])

(defunion TermNodeV1
  (VariableNodeV1
    [sort-id String
     ordinal Int])
  (AtomNodeV1
    [sort-id String
     semantic-id String])
  (ConstructorNodeV1
    [sort-id String
     shape-id String
     arguments (Vec Int)]))

(defrecord TermArenaV1
  [nodes (Vec TermNodeV1)
   maximum-nodes Int])

(defrecord ModeV1
  [identity String
   groundness (Vec Keyword)
   determinism Keyword])

(defrecord StrategyV1
  [identity String
   mode-id String
   kind Keyword
   cost-class String
   termination-contract String])

(defrecord RelationV1
  [identity String
   slot-sorts (Vec String)
   modes (Vec ModeV1)
   strategies (Vec StrategyV1)])

(defunion GoalV1
  (EqualityGoalV1
    [left Int
     right Int])
  (RelationGoalV1
    [relation-id String
     arguments (Vec Int)]))

(defrecord ClauseV1
  [relation-id String
   head (Vec Int)
   body (Vec GoalV1)
   evidence-ids (Vec String)])

(defrecord TheoryWorldV1
  [profile-id String
   rule-epoch String
   sorts (Vec SortSpecV1)
   shapes (Vec ShapeSpecV1)
   arena TermArenaV1
   relations (Vec RelationV1)
   clauses (Vec ClauseV1)])

(defrecord PreferredNameV1
  [semantic-id String
   rendering String])

(defrecord SourceProjectionV1
  [source-content-id String
   source-path String
   layout-id String
   preferred-names (Vec PreferredNameV1)])

(defrecord ProjectionReceiptV1
  [identity String
   world-audit-id String
   source-content-id String
   source-path String
   layout-id String])

(defrecord QueryOutputV1
  [semantic-id String
   node-id Int])

(defrecord QueryV1
  [relation-id String
   mode-id String
   arguments (Vec Int)
   outputs (Vec QueryOutputV1)
   max-reductions Int
   max-agenda Int
   max-answers Int])

(defrecord ProblemV1
  [code Keyword
   message String
   evidence (Vec String)])

(defrecord TermRefV1
  [node-id Int
   scope Int])

(defrecord LogicBindingV1
  [variable TermRefV1
   value TermRefV1])

(defunion UnificationV1
  (UnifiedV1 [bindings (Vec LogicBindingV1)])
  (NotUnifiedV1 [code Keyword]))

(defunion RuntimeGoalV1
  (RuntimeEqualityV1
    [left TermRefV1
     right TermRefV1])
  (RuntimeRelationV1
    [relation-id String
     arguments (Vec TermRefV1)]))

(defrecord SearchStateV1
  [goals (Vec RuntimeGoalV1)
   bindings (Vec LogicBindingV1)
   clause-ids (Vec String)
   evidence-ids (Vec String)
   next-scope Int])

(defrecord AnswerBindingV1
  [output-id String
   canonical-term String
   term TermRefV1])

(defrecord AnswerV1
  [identity String
   bindings (Vec AnswerBindingV1)
   resolution (Vec LogicBindingV1)])

(defrecord ProofOccurrenceV1
  [identity String
   answer-id String
   clause-ids (Vec String)
   evidence-ids (Vec String)])

(defrecord SearchCountersV1
  [reductions Int
   agenda-peak Int])

(defrecord RawSearchV1
  [status Keyword
   answers (Vec AnswerV1)
   proofs (Vec ProofOccurrenceV1)
   counters SearchCountersV1])

(defrecord StrategySelectionReceiptV1
  [identity String
   world-audit-id String
   relation-id String
   mode-id String
   strategy-id String
   strategy-kind Keyword
   reachable-closure-id String
   max-reductions Int
   max-agenda Int
   max-answers Int])

(defunion QueryResultV1
  (QueryInvalidV1 [problem ProblemV1])
  (QueryFinishedV1
    [status Keyword
     answers (Vec AnswerV1)
     proofs (Vec ProofOccurrenceV1)
     counters SearchCountersV1
     selection StrategySelectionReceiptV1
     result-id String]))

(def symbol-sort-id String "beagle:sort/Symbol")
(def symbol-list-sort-id String "beagle:sort/SymbolList")
(def nil-shape-id String "beagle:shape/nil")
(def cons-shape-id String "beagle:shape/cons")

(defn canonical-part-v1 [value String] String
  (str (count (utf8-encode value)) ":" value))

(defn canonical-parts-v1 [values (Vec String)] String
  (loop [index Int 0
         encoded String (str (count values) ":")]
    (if (>= index (count values))
      encoded
      (recur (+ index 1)
             (str encoded (canonical-part-v1 (nth values index)))))))

(defn semantic-id-v1
  [domain String
   parts (Vec String)] String
  (str "sha256:"
       (sha256-bytes
         (utf8-encode
           (str "beagle/proposition-profile/v1"
                (canonical-part-v1 domain)
                (canonical-parts-v1 parts))))))

(def profile-rule-epoch String
  (semantic-id-v1
    "profile-rule-epoch"
    ["first-order-unification"
     "occurs-check"
     "variable-ordinal-is-arena-position"
     "fifo-small-step"
     "canonical-answer-dedup"
     "separate-proof-occurrences"
     "projection-is-not-authority"]))

(def profile-id String
  (semantic-id-v1
    "semantic-profile"
    ["beagle.experimental/proposition-v1" profile-rule-epoch]))

(defn string-member?
  [values (Vec String)
   value String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= value (nth values index))
        true
        (recur (+ index 1))))))

(defn keyword-member?
  [values (Vec Keyword)
   value Keyword] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= value (nth values index))
        true
        (recur (+ index 1))))))

(defn append-strings
  [left (Vec String)
   right (Vec String)] (Vec String)
  (reduce conj left right))

(defn sort-for-id
  [sorts (Vec SortSpecV1)
   identity String] SortSpecV1?
  (some
    (fn [candidate SortSpecV1] SortSpecV1?
      (if (= identity (sortspecv1-identity candidate)) candidate nil))
    sorts))

(defn shape-for-id
  [shapes (Vec ShapeSpecV1)
   identity String] ShapeSpecV1?
  (some
    (fn [candidate ShapeSpecV1] ShapeSpecV1?
      (if (= identity (shapespecv1-identity candidate)) candidate nil))
    shapes))

(defn relation-for-id
  [relations (Vec RelationV1)
   identity String] RelationV1?
  (some
    (fn [candidate RelationV1] RelationV1?
      (if (= identity (relationv1-identity candidate)) candidate nil))
    relations))

(defn mode-for-id
  [modes (Vec ModeV1)
   identity String] ModeV1?
  (some
    (fn [candidate ModeV1] ModeV1?
      (if (= identity (modev1-identity candidate)) candidate nil))
    modes))

(defn strategies-for-mode
  [strategies (Vec StrategyV1)
   mode-id String] (Vec StrategyV1)
  (filterv
    (fn [candidate StrategyV1] Bool
      (= mode-id (strategyv1-mode-id candidate)))
    strategies))

(defn clauses-for-relation
  [clauses (Vec ClauseV1)
   relation-id String] (Vec ClauseV1)
  (filterv
    (fn [candidate ClauseV1] Bool
      (= relation-id (clausev1-relation-id candidate)))
    clauses))

(defn arena-node
  [arena TermArenaV1
   node-id Int] TermNodeV1
  (nth (termarenav1-nodes arena) node-id))

(defn node-sort-id
  [arena TermArenaV1
   node-id Int] String
  (match (arena-node arena node-id)
    [(VariableNodeV1 sort-id ordinal) sort-id]
    [(AtomNodeV1 sort-id semantic-id) sort-id]
    [(ConstructorNodeV1 sort-id shape-id arguments) sort-id]))

(defn valid-node-id?
  [arena TermArenaV1
   node-id Int] Bool
  (and (>= node-id 0) (< node-id (count (termarenav1-nodes arena)))))

(defn slots-match?
  [arena TermArenaV1
   node-index Int
   arguments (Vec Int)
   slot-sorts (Vec String)] Bool
  (and
    (= (count arguments) (count slot-sorts))
    (loop [index Int 0]
      (if (>= index (count arguments))
        true
        (let [argument Int (nth arguments index)]
          (and (< argument node-index)
               (>= argument 0)
               (= (nth slot-sorts index) (node-sort-id arena argument))
               (recur (+ index 1))))))))

(defn arena-valid?
  [sorts (Vec SortSpecV1)
   shapes (Vec ShapeSpecV1)
   arena TermArenaV1] Bool
  (and
    (> (termarenav1-maximum-nodes arena) 0)
    (<= (count (termarenav1-nodes arena))
        (termarenav1-maximum-nodes arena))
    (loop [index Int 0]
      (if (>= index (count (termarenav1-nodes arena)))
        true
        (match (arena-node arena index)
          [(VariableNodeV1 sort-id ordinal)
           (and (= ordinal index)
                (some? (sort-for-id sorts sort-id))
                (recur (+ index 1)))]
          [(AtomNodeV1 sort-id semantic-id)
           (let [sort SortSpecV1? (sort-for-id sorts sort-id)]
             (and (some? sort)
                  (= :symbol (sortspecv1-kind sort))
                  (> (count semantic-id) 0)
                  (recur (+ index 1))))]
          [(ConstructorNodeV1 sort-id shape-id arguments)
           (let [sort SortSpecV1? (sort-for-id sorts sort-id)
                 shape ShapeSpecV1? (shape-for-id shapes shape-id)]
             (and (some? sort)
                  (= :constructed (sortspecv1-kind sort))
                  (some? shape)
                  (= sort-id (shapespecv1-result-sort shape))
                  (slots-match?
                    arena index arguments (shapespecv1-slot-sorts shape))
                  (recur (+ index 1))))])))))

(defn same-variable-ref?
  [arena TermArenaV1
   left TermRefV1
   right TermRefV1] Bool
  (and (= (termrefv1-node-id left) (termrefv1-node-id right))
       (= (termrefv1-scope left) (termrefv1-scope right))
       (match (arena-node arena (termrefv1-node-id left))
         [(VariableNodeV1 sort-id ordinal) true]
         [(AtomNodeV1 sort-id semantic-id) false]
         [(ConstructorNodeV1 sort-id shape-id arguments) false])))

(defn binding-for-variable
  [bindings (Vec LogicBindingV1)
   arena TermArenaV1
   variable TermRefV1] LogicBindingV1?
  (some
    (fn [binding LogicBindingV1] LogicBindingV1?
      (if (same-variable-ref?
            arena variable (logicbindingv1-variable binding))
        binding
        nil))
    bindings))

(defn walk-term
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   term TermRefV1] TermRefV1
  (let [binding LogicBindingV1? (binding-for-variable bindings arena term)]
    (if (some? binding)
      (walk-term arena bindings (logicbindingv1-value binding))
      term)))

(defn occurs-in-term?
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   variable TermRefV1
   candidate TermRefV1] Bool
  (let [resolved TermRefV1 (walk-term arena bindings candidate)]
    (if (same-variable-ref? arena variable resolved)
      true
      (match (arena-node arena (termrefv1-node-id resolved))
        [(VariableNodeV1 sort-id ordinal) false]
        [(AtomNodeV1 sort-id semantic-id) false]
        [(ConstructorNodeV1 sort-id shape-id arguments)
         (loop [index Int 0]
           (if (>= index (count arguments))
             false
             (if (occurs-in-term?
                   arena bindings variable
                   (->TermRefV1
                     (nth arguments index) (termrefv1-scope resolved)))
               true
               (recur (+ index 1)))))]))))

(defn bind-variable
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   variable TermRefV1
   candidate TermRefV1] UnificationV1
  (let [resolved TermRefV1 (walk-term arena bindings candidate)]
    (cond
      (same-variable-ref? arena variable resolved)
      (->UnifiedV1 bindings)

      (not= (node-sort-id arena (termrefv1-node-id variable))
            (node-sort-id arena (termrefv1-node-id resolved)))
      (->NotUnifiedV1 :sort-mismatch)

      (occurs-in-term? arena bindings variable resolved)
      (->NotUnifiedV1 :occurs-check)

      :else
      (->UnifiedV1
        (conj bindings (->LogicBindingV1 variable resolved))))))

(defn unify-terms
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   left TermRefV1
   right TermRefV1] UnificationV1
  (let [resolved-left TermRefV1 (walk-term arena bindings left)
        resolved-right TermRefV1 (walk-term arena bindings right)
        left-node TermNodeV1 (arena-node arena (termrefv1-node-id resolved-left))
        right-node TermNodeV1 (arena-node arena (termrefv1-node-id resolved-right))]
    (match left-node
      [(VariableNodeV1 left-sort left-ordinal)
       (bind-variable arena bindings resolved-left resolved-right)]
      [(AtomNodeV1 left-sort left-id)
       (match right-node
         [(VariableNodeV1 right-sort right-ordinal)
          (bind-variable arena bindings resolved-right resolved-left)]
         [(AtomNodeV1 right-sort right-id)
          (if (and (= left-sort right-sort) (= left-id right-id))
            (->UnifiedV1 bindings)
            (->NotUnifiedV1 :atom-mismatch))]
         [(ConstructorNodeV1 right-sort right-shape right-arguments)
          (->NotUnifiedV1 :term-shape-mismatch)])]
      [(ConstructorNodeV1 left-sort left-shape left-arguments)
       (match right-node
         [(VariableNodeV1 right-sort right-ordinal)
          (bind-variable arena bindings resolved-right resolved-left)]
         [(AtomNodeV1 right-sort right-id)
          (->NotUnifiedV1 :term-shape-mismatch)]
         [(ConstructorNodeV1 right-sort right-shape right-arguments)
          (if (or (not= left-sort right-sort)
                  (not= left-shape right-shape)
                  (not= (count left-arguments) (count right-arguments)))
            (->NotUnifiedV1 :constructor-mismatch)
            (loop [index Int 0
                   current (Vec LogicBindingV1) bindings]
              (if (>= index (count left-arguments))
                (->UnifiedV1 current)
                (match (unify-terms
                         arena current
                         (->TermRefV1
                           (nth left-arguments index)
                           (termrefv1-scope resolved-left))
                         (->TermRefV1
                           (nth right-arguments index)
                           (termrefv1-scope resolved-right)))
                  [(NotUnifiedV1 code) (->NotUnifiedV1 code)]
                  [(UnifiedV1 next)
                   (recur (+ index 1) next)]))))])])))

(defn canonical-node-term
  [arena TermArenaV1
   node-id Int] String
  (match (arena-node arena node-id)
    [(VariableNodeV1 sort-id ordinal)
     (str "var"
          (canonical-part-v1 sort-id)
          (canonical-part-v1 (str ordinal)))]
    [(AtomNodeV1 sort-id semantic-id)
     (str "atom"
          (canonical-part-v1 sort-id)
          (canonical-part-v1 semantic-id))]
    [(ConstructorNodeV1 sort-id shape-id arguments)
     (loop [index Int 0
            encoded String (str "constructor"
                 (canonical-part-v1 sort-id)
                 (canonical-part-v1 shape-id)
                 (count arguments) ":")]
       (if (>= index (count arguments))
         encoded
         (recur (+ index 1)
                (str encoded
                     (canonical-part-v1
                       (canonical-node-term arena (nth arguments index)))))))]))

(defn canonical-runtime-term
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   term TermRefV1] String
  (let [resolved TermRefV1 (walk-term arena bindings term)]
    (match (arena-node arena (termrefv1-node-id resolved))
      [(VariableNodeV1 sort-id ordinal)
       (str "logic"
            (canonical-part-v1 sort-id)
            (canonical-part-v1 (str (termrefv1-scope resolved)))
            (canonical-part-v1 (str ordinal)))]
      [(AtomNodeV1 sort-id semantic-id)
       (str "atom"
            (canonical-part-v1 sort-id)
            (canonical-part-v1 semantic-id))]
      [(ConstructorNodeV1 sort-id shape-id arguments)
       (loop [index Int 0
              encoded String (str "constructor"
                   (canonical-part-v1 sort-id)
                   (canonical-part-v1 shape-id)
                   (count arguments) ":")]
         (if (>= index (count arguments))
           encoded
           (recur (+ index 1)
                  (str encoded
                       (canonical-part-v1
                         (canonical-runtime-term
                           arena bindings
                           (->TermRefV1
                             (nth arguments index)
                             (termrefv1-scope resolved))))))))])))

(defn goal-content-encoding
  [arena TermArenaV1
   goal GoalV1] String
  (match goal
    [(EqualityGoalV1 left right)
     (str "equal"
          (canonical-part-v1 (canonical-node-term arena left))
          (canonical-part-v1 (canonical-node-term arena right)))]
    [(RelationGoalV1 relation-id arguments)
     (loop [index Int 0
            encoded String (str "call"
                 (canonical-part-v1 relation-id)
                 (count arguments) ":")]
       (if (>= index (count arguments))
         encoded
         (recur (+ index 1)
                (str encoded
                     (canonical-part-v1
                       (canonical-node-term arena (nth arguments index)))))))]))

(defn clause-content-id
  [arena TermArenaV1
   clause ClauseV1] String
  (let [head-encoding String (loop [index Int 0
                                    encoded String (str (count (clausev1-head clause)) ":")]
                               (if (>= index (count (clausev1-head clause)))
            encoded
            (recur (+ index 1)
                   (str encoded
                        (canonical-part-v1
                          (canonical-node-term
                            arena (nth (clausev1-head clause) index)))))))
        body-encoding String (loop [index Int 0
                                    encoded String (str (count (clausev1-body clause)) ":")]
                               (if (>= index (count (clausev1-body clause)))
            encoded
            (recur (+ index 1)
                   (str encoded
                        (canonical-part-v1
                          (goal-content-encoding
                            arena (nth (clausev1-body clause) index)))))))]
    (semantic-id-v1
      "clause"
      [(clausev1-relation-id clause) head-encoding body-encoding])))

(defn clause-occurrence-id
  [arena TermArenaV1
   relation-ordinal Int
   clause ClauseV1] String
  (semantic-id-v1
    "ordered-clause-occurrence"
    [(clausev1-relation-id clause)
     (str relation-ordinal)
     (clause-content-id arena clause)
     (canonical-parts-v1 (clausev1-evidence-ids clause))]))

(defn vector-node-sorts-match?
  [arena TermArenaV1
   node-ids (Vec Int)
   expected (Vec String)] Bool
  (and
    (= (count node-ids) (count expected))
    (loop [index Int 0]
      (if (>= index (count node-ids))
        true
        (and
          (valid-node-id? arena (nth node-ids index))
          (= (nth expected index)
             (node-sort-id arena (nth node-ids index)))
          (recur (+ index 1)))))))

(defn goal-valid?
  [world TheoryWorldV1
   goal GoalV1] Bool
  (let [arena TermArenaV1 (theoryworldv1-arena world)]
    (match goal
      [(EqualityGoalV1 left right)
       (and (valid-node-id? arena left)
            (valid-node-id? arena right)
            (= (node-sort-id arena left) (node-sort-id arena right)))]
      [(RelationGoalV1 relation-id arguments)
       (let [relation RelationV1? (relation-for-id (theoryworldv1-relations world) relation-id)]
         (and (some? relation)
              (vector-node-sorts-match?
                arena arguments (relationv1-slot-sorts relation))))])))

(defn clause-valid?
  [world TheoryWorldV1
   clause ClauseV1] Bool
  (let [relation RelationV1? (relation-for-id
          (theoryworldv1-relations world) (clausev1-relation-id clause))
        arena TermArenaV1 (theoryworldv1-arena world)]
    (and
      (some? relation)
      (vector-node-sorts-match?
        arena (clausev1-head clause) (relationv1-slot-sorts relation))
      (loop [index Int 0]
        (if (>= index (count (clausev1-body clause)))
          true
          (and (goal-valid? world (nth (clausev1-body clause) index))
               (recur (+ index 1))))))))

(defn valid-groundness-vector?
  [groundness (Vec Keyword)
   arity Int] Bool
  (and
    (= (count groundness) arity)
    (loop [index Int 0]
      (if (>= index arity)
        true
        (and (keyword-member? [:ground :logic] (nth groundness index))
             (recur (+ index 1)))))))

(defn valid-determinism? [value Keyword] Bool
  (keyword-member? [:det :semidet :multi :nondet] value))

(defn valid-strategy-kind? [value Keyword] Bool
  (keyword-member? [:fifo-clauses :fact-forward :fact-reverse] value))

(defn relation-contract-valid? [relation RelationV1] Bool
  (and
    (> (count (relationv1-identity relation)) 0)
    (> (count (relationv1-modes relation)) 0)
    (loop [mode-index Int 0]
      (if (>= mode-index (count (relationv1-modes relation)))
        true
        (let [mode ModeV1 (nth (relationv1-modes relation) mode-index)
              strategies (Vec StrategyV1) (strategies-for-mode
                (relationv1-strategies relation) (modev1-identity mode))]
          (and
            (valid-groundness-vector?
              (modev1-groundness mode) (count (relationv1-slot-sorts relation)))
            (valid-determinism? (modev1-determinism mode))
            (= 1 (count strategies))
            (valid-strategy-kind? (strategyv1-kind (first strategies)))
            (recur (+ mode-index 1))))))))

(defn unique-relation-identities? [relations (Vec RelationV1)] Bool
  (loop [index Int 0
         seen (Vec String) []]
    (if (>= index (count relations))
      true
      (let [identity String (relationv1-identity (nth relations index))]
        (and (not (string-member? seen identity))
             (recur (+ index 1) (conj seen identity)))))))

(defn world-valid? [world TheoryWorldV1] Bool
  (and
    (= profile-id (theoryworldv1-profile-id world))
    (= profile-rule-epoch (theoryworldv1-rule-epoch world))
    (arena-valid?
      (theoryworldv1-sorts world)
      (theoryworldv1-shapes world)
      (theoryworldv1-arena world))
    (unique-relation-identities? (theoryworldv1-relations world))
    (loop [index Int 0]
      (if (>= index (count (theoryworldv1-relations world)))
        true
        (and (relation-contract-valid?
               (nth (theoryworldv1-relations world) index))
             (recur (+ index 1)))))
    (loop [index Int 0]
      (if (>= index (count (theoryworldv1-clauses world)))
        true
        (and (clause-valid? world (nth (theoryworldv1-clauses world) index))
             (recur (+ index 1)))))))

(defn relation-contract-parts [relation RelationV1] (Vec String)
  (let [mode-parts (Vec String) (mapv
          (fn [mode ModeV1] String
            (str (modev1-identity mode)
                 (canonical-parts-v1
                   (mapv
                     (fn [groundness Keyword] String (str groundness))
                     (modev1-groundness mode)))
                 (canonical-part-v1 (str (modev1-determinism mode)))))
          (relationv1-modes relation))
        strategy-parts (Vec String) (mapv
          (fn [strategy StrategyV1] String
            (str (strategyv1-identity strategy)
                 (canonical-part-v1 (strategyv1-mode-id strategy))
                 (canonical-part-v1 (str (strategyv1-kind strategy)))
                 (canonical-part-v1 (strategyv1-cost-class strategy))
                 (canonical-part-v1
                   (strategyv1-termination-contract strategy))))
          (relationv1-strategies relation))]
    [(relationv1-identity relation)
     (canonical-parts-v1 (relationv1-slot-sorts relation))
     (canonical-parts-v1 mode-parts)
     (canonical-parts-v1 strategy-parts)]))

(defn world-audit-id [world TheoryWorldV1] String
  (let [sort-parts (Vec String) (mapv
          (fn [sort SortSpecV1] String
            (str (sortspecv1-identity sort)
                 (canonical-part-v1 (str (sortspecv1-kind sort)))))
          (theoryworldv1-sorts world))
        shape-parts (Vec String) (mapv
          (fn [shape ShapeSpecV1] String
            (str (shapespecv1-identity shape)
                 (canonical-part-v1 (shapespecv1-result-sort shape))
                 (canonical-parts-v1 (shapespecv1-slot-sorts shape))))
          (theoryworldv1-shapes world))
        relation-parts (Vec String) (mapv
          (fn [relation RelationV1] String
            (canonical-parts-v1 (relation-contract-parts relation)))
          (theoryworldv1-relations world))
        clause-parts (Vec String) (mapv
          (fn [clause ClauseV1] String
            (str (clause-content-id (theoryworldv1-arena world) clause)
                 (canonical-parts-v1 (clausev1-evidence-ids clause))))
          (theoryworldv1-clauses world))]
    (semantic-id-v1
      "theory-world"
      [(theoryworldv1-profile-id world)
       (theoryworldv1-rule-epoch world)
       (canonical-parts-v1 sort-parts)
       (canonical-parts-v1 shape-parts)
       (canonical-parts-v1 relation-parts)
       (canonical-parts-v1 clause-parts)])))

(defn called-relations
  [world TheoryWorldV1
   relation-id String] (Vec String)
  (let [clauses (Vec ClauseV1) (clauses-for-relation (theoryworldv1-clauses world) relation-id)]
    (loop [clause-index Int 0
           found (Vec String) []]
      (if (>= clause-index (count clauses))
        found
        (let [body (Vec GoalV1) (clausev1-body (nth clauses clause-index))]
          (recur
            (+ clause-index 1)
            (loop [goal-index Int 0
                   current (Vec String) found]
              (if (>= goal-index (count body))
                current
                (match (nth body goal-index)
                  [(EqualityGoalV1 left right)
                   (recur (+ goal-index 1) current)]
                  [(RelationGoalV1 called arguments)
                   (recur
                     (+ goal-index 1)
                     (if (string-member? current called)
                       current
                       (conj current called)))])))))))))

(defn reachable-relation-ids
  [world TheoryWorldV1
   root String] (Vec String)
  (loop [pending (Vec String) [root]
         reached (Vec String) []]
    (if (empty? pending)
      reached
      (let [current String (first pending)
            rest (Vec String) (subvec pending 1)]
        (if (string-member? reached current)
          (recur rest reached)
          (recur
            (append-strings rest (called-relations world current))
            (conj reached current)))))))

(defn reachable-closure-parts
  [world TheoryWorldV1
   root String] (Vec String)
  (let [reachable (Vec String) (reachable-relation-ids world root)
        sort-schema String (canonical-parts-v1
          (mapv
            (fn [sort SortSpecV1] String
              (str (sortspecv1-identity sort)
                   (canonical-part-v1 (str (sortspecv1-kind sort)))))
            (theoryworldv1-sorts world)))
        shape-schema String (canonical-parts-v1
          (mapv
            (fn [shape ShapeSpecV1] String
              (str (shapespecv1-identity shape)
                   (canonical-part-v1 (shapespecv1-result-sort shape))
                   (canonical-parts-v1 (shapespecv1-slot-sorts shape))))
            (theoryworldv1-shapes world)))]
    (loop [relation-index Int 0
           parts (Vec String) [(theoryworldv1-profile-id world)
            (theoryworldv1-rule-epoch world)
            sort-schema
            shape-schema]]
      (if (>= relation-index (count reachable))
        parts
        (let [relation-id String (nth reachable relation-index)
              relation RelationV1? (relation-for-id (theoryworldv1-relations world) relation-id)
              clauses (Vec ClauseV1) (clauses-for-relation
                (theoryworldv1-clauses world) relation-id)]
          (if (nil? relation)
            parts
            (let [with-relation (Vec String) (append-strings parts (relation-contract-parts relation))]
              (recur
                (+ relation-index 1)
                (loop [clause-index Int 0
                       current (Vec String) with-relation]
                  (if (>= clause-index (count clauses))
                    current
                    (let [clause ClauseV1 (nth clauses clause-index)]
                      (recur
                        (+ clause-index 1)
                        (conj
                          current
                          (clause-occurrence-id
                            (theoryworldv1-arena world)
                            clause-index
                            clause))))))))))))))

(defn reachable-closure-id
  [world TheoryWorldV1
   root String] String
  (semantic-id-v1
    "reachable-relation-closure"
    (reachable-closure-parts world root)))

(defn preferred-rendering
  [projection SourceProjectionV1
   semantic-id String] String
  (let [match-name PreferredNameV1? (some
          (fn [candidate PreferredNameV1] PreferredNameV1?
            (if (= semantic-id (preferrednamev1-semantic-id candidate))
              candidate
              nil))
          (sourceprojectionv1-preferred-names projection))]
    (if (some? match-name)
      (preferrednamev1-rendering match-name)
      semantic-id)))

(defn projection-receipt
  [world TheoryWorldV1
   projection SourceProjectionV1] ProjectionReceiptV1
  (let [world-id String (world-audit-id world)
        names String (canonical-parts-v1
          (mapv
            (fn [name PreferredNameV1] String
              (str (canonical-part-v1 (preferrednamev1-semantic-id name))
                   (canonical-part-v1 (preferrednamev1-rendering name))))
            (sourceprojectionv1-preferred-names projection)))
        identity String (semantic-id-v1
          "source-projection-receipt"
          [world-id
           (sourceprojectionv1-source-content-id projection)
           (sourceprojectionv1-source-path projection)
           (sourceprojectionv1-layout-id projection)
           names])]
    (->ProjectionReceiptV1
      identity world-id
      (sourceprojectionv1-source-content-id projection)
      (sourceprojectionv1-source-path projection)
      (sourceprojectionv1-layout-id projection))))

(defn runtime-term-ground?
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   term TermRefV1] Bool
  (let [resolved TermRefV1 (walk-term arena bindings term)]
    (match (arena-node arena (termrefv1-node-id resolved))
      [(VariableNodeV1 sort-id ordinal) false]
      [(AtomNodeV1 sort-id semantic-id) true]
      [(ConstructorNodeV1 sort-id shape-id arguments)
       (loop [index Int 0]
         (if (>= index (count arguments))
           true
           (and
             (runtime-term-ground?
               arena bindings
               (->TermRefV1
                 (nth arguments index) (termrefv1-scope resolved)))
             (recur (+ index 1)))))])))

(defn mode-admits-query?
  [arena TermArenaV1
   mode ModeV1
   arguments (Vec Int)] Bool
  (and
    (= (count arguments) (count (modev1-groundness mode)))
    (loop [index Int 0]
      (if (>= index (count arguments))
        true
        (let [ground Bool (runtime-term-ground?
                arena [] (->TermRefV1 (nth arguments index) 0))
              expected Keyword (nth (modev1-groundness mode) index)]
          (and (if (= expected :ground) ground (not ground))
               (recur (+ index 1))))))))

(defn query-id
  [world TheoryWorldV1
   query QueryV1] String
  (let [arena TermArenaV1 (theoryworldv1-arena world)
        arguments String (canonical-parts-v1
          (mapv
            (fn [node-id Int] String (canonical-node-term arena node-id))
            (queryv1-arguments query)))
        outputs String (canonical-parts-v1
          (mapv
            (fn [output QueryOutputV1] String
              (str (canonical-part-v1 (queryoutputv1-semantic-id output))
                   (canonical-part-v1
                     (canonical-node-term arena (queryoutputv1-node-id output)))))
            (queryv1-outputs query)))]
    (semantic-id-v1
      "query"
      [(queryv1-relation-id query)
       (queryv1-mode-id query)
       arguments
       outputs
       (str (queryv1-max-reductions query))
       (str (queryv1-max-agenda query))
       (str (queryv1-max-answers query))])))

(defn term-refs
  [node-ids (Vec Int)
   scope Int] (Vec TermRefV1)
  (mapv
    (fn [node-id Int] TermRefV1 (->TermRefV1 node-id scope))
    node-ids))

(defn runtime-goals
  [goals (Vec GoalV1)
   scope Int] (Vec RuntimeGoalV1)
  (mapv
    (fn [goal GoalV1] RuntimeGoalV1
      (match goal
        [(EqualityGoalV1 left right)
         (->RuntimeEqualityV1
           (->TermRefV1 left scope)
           (->TermRefV1 right scope))]
        [(RelationGoalV1 relation-id arguments)
         (->RuntimeRelationV1
           relation-id (term-refs arguments scope))]))
    goals))

(defn append-runtime-goals
  [left (Vec RuntimeGoalV1)
   right (Vec RuntimeGoalV1)] (Vec RuntimeGoalV1)
  (reduce conj left right))

(defn unify-argument-order
  [arena TermArenaV1
   bindings (Vec LogicBindingV1)
   query-arguments (Vec TermRefV1)
   clause-arguments (Vec TermRefV1)
   order (Vec Int)] UnificationV1
  (loop [index Int 0
         current (Vec LogicBindingV1) bindings]
    (if (>= index (count order))
      (->UnifiedV1 current)
      (let [position Int (nth order index)]
        (match (unify-terms
                 arena current
                 (nth query-arguments position)
                 (nth clause-arguments position))
          [(NotUnifiedV1 code) (->NotUnifiedV1 code)]
          [(UnifiedV1 next)
           (recur (+ index 1) next)])))))

(defn natural-argument-order [arity Int] (Vec Int)
  (loop [index Int 0
         order (Vec Int) []]
    (if (>= index arity)
      order
      (recur (+ index 1) (conj order index)))))

(defn answer-for-bindings
  [world TheoryWorldV1
   query QueryV1
   bindings (Vec LogicBindingV1)] AnswerV1
  (let [arena TermArenaV1 (theoryworldv1-arena world)
        answer-bindings (Vec AnswerBindingV1) (mapv
          (fn [output QueryOutputV1] AnswerBindingV1
            (let [term TermRefV1 (->TermRefV1 (queryoutputv1-node-id output) 0)]
              (->AnswerBindingV1
                (queryoutputv1-semantic-id output)
                (canonical-runtime-term arena bindings term)
                term)))
          (queryv1-outputs query))
        identity String (semantic-id-v1
          "answer"
          (conj
            (mapv
              (fn [binding AnswerBindingV1] String
                (str (canonical-part-v1 (answerbindingv1-output-id binding))
                     (canonical-part-v1
                       (answerbindingv1-canonical-term binding))))
              answer-bindings)
            (query-id world query)))]
    (->AnswerV1 identity answer-bindings bindings)))

(defn proof-for-state
  [answer AnswerV1
   state SearchStateV1] ProofOccurrenceV1
  (let [identity String (semantic-id-v1
          "query-proof-occurrence"
          [(answerv1-identity answer)
           (canonical-parts-v1 (searchstatev1-clause-ids state))
           (canonical-parts-v1 (searchstatev1-evidence-ids state))])]
    (->ProofOccurrenceV1
      identity
      (answerv1-identity answer)
      (searchstatev1-clause-ids state)
      (searchstatev1-evidence-ids state))))

(defn answer-known?
  [answers (Vec AnswerV1)
   identity String] Bool
  (some?
    (some
      (fn [answer AnswerV1] AnswerV1?
        (if (= identity (answerv1-identity answer)) answer nil))
      answers)))

(defn proof-known?
  [proofs (Vec ProofOccurrenceV1)
   identity String] Bool
  (some?
    (some
      (fn [proof ProofOccurrenceV1] ProofOccurrenceV1?
        (if (= identity (proofoccurrencev1-identity proof)) proof nil))
      proofs)))

(defn add-answer
  [answers (Vec AnswerV1)
   answer AnswerV1] (Vec AnswerV1)
  (if (answer-known? answers (answerv1-identity answer))
    answers
    (conj answers answer)))

(defn add-proof
  [proofs (Vec ProofOccurrenceV1)
   proof ProofOccurrenceV1] (Vec ProofOccurrenceV1)
  (if (proof-known? proofs (proofoccurrencev1-identity proof))
    proofs
    (conj proofs proof)))

(defn raw-search
  [status Keyword
   answers (Vec AnswerV1)
   proofs (Vec ProofOccurrenceV1)
   reductions Int
   agenda-peak Int] RawSearchV1
  (->RawSearchV1
    status answers proofs (->SearchCountersV1 reductions agenda-peak)))

(defn branches-for-runtime-call
  [world TheoryWorldV1
   state SearchStateV1
   call RuntimeGoalV1
   remaining (Vec RuntimeGoalV1)] (Vec SearchStateV1)
  (match call
    [(RuntimeEqualityV1 left right) []]
    [(RuntimeRelationV1 relation-id arguments)
     (let [arena TermArenaV1 (theoryworldv1-arena world)
           clauses (Vec ClauseV1) (clauses-for-relation (theoryworldv1-clauses world) relation-id)
           next-scope Int (+ (searchstatev1-next-scope state) (count clauses))]
       (loop [index Int 0
              branches (Vec SearchStateV1) []]
         (if (>= index (count clauses))
           branches
           (let [clause ClauseV1 (nth clauses index)
                 clause-scope Int (+ (searchstatev1-next-scope state) index)
                 head (Vec TermRefV1) (term-refs (clausev1-head clause) clause-scope)]
             (match (unify-argument-order
                      arena
                      (searchstatev1-bindings state)
                      arguments
                      head
                      (natural-argument-order (count arguments)))
               [(NotUnifiedV1 code)
                (recur (+ index 1) branches)]
               [(UnifiedV1 bindings)
                (let [branch SearchStateV1 (->SearchStateV1
                        (append-runtime-goals
                          (runtime-goals (clausev1-body clause) clause-scope)
                          remaining)
                        bindings
                        (conj
                          (searchstatev1-clause-ids state)
                          (clause-occurrence-id arena index clause))
                        (append-strings
                          (searchstatev1-evidence-ids state)
                          (clausev1-evidence-ids clause))
                        next-scope)]
                  (recur (+ index 1) (conj branches branch)))])))))]))

(defn run-fifo-clauses
  [world TheoryWorldV1
   query QueryV1] RawSearchV1
  (let [initial-goal RuntimeGoalV1 (->RuntimeRelationV1
          (queryv1-relation-id query)
          (term-refs (queryv1-arguments query) 0))
        initial SearchStateV1 (->SearchStateV1 [initial-goal] [] [] [] 1)]
    (loop [agenda (Vec SearchStateV1) [initial]
           answers (Vec AnswerV1) []
           proofs (Vec ProofOccurrenceV1) []
           reductions Int 0
           agenda-peak Int 1]
      (cond
        (empty? agenda)
        (raw-search :complete answers proofs reductions agenda-peak)

        (>= reductions (queryv1-max-reductions query))
        (raw-search
          :truncated-reductions answers proofs reductions agenda-peak)

        (> (count agenda) (queryv1-max-agenda query))
        (raw-search :truncated-agenda answers proofs reductions agenda-peak)

        :else
        (let [state SearchStateV1 (first agenda)
              rest-agenda (Vec SearchStateV1) (subvec agenda 1)
              goals (Vec RuntimeGoalV1) (searchstatev1-goals state)]
          (if (empty? goals)
            (let [answer AnswerV1 (answer-for-bindings world query (searchstatev1-bindings state))
                  proof ProofOccurrenceV1 (proof-for-state answer state)
                  already-known Bool (answer-known? answers (answerv1-identity answer))]
              (if (and (not already-known)
                       (>= (count answers) (queryv1-max-answers query)))
                (raw-search
                  :truncated-answers answers proofs reductions agenda-peak)
                (recur
                  rest-agenda
                  (add-answer answers answer)
                  (add-proof proofs proof)
                  reductions
                  agenda-peak)))
            (let [goal RuntimeGoalV1 (first goals)
                  remaining (Vec RuntimeGoalV1) (subvec goals 1)]
              (match goal
                [(RuntimeEqualityV1 left right)
                 (match (unify-terms
                          (theoryworldv1-arena world)
                          (searchstatev1-bindings state)
                          left right)
                   [(NotUnifiedV1 code)
                    (recur
                      rest-agenda answers proofs (+ reductions 1) agenda-peak)]
                   [(UnifiedV1 bindings)
                    (let [next-state SearchStateV1 (->SearchStateV1
                            remaining bindings
                            (searchstatev1-clause-ids state)
                            (searchstatev1-evidence-ids state)
                            (searchstatev1-next-scope state))
                          next-agenda (Vec SearchStateV1) (conj rest-agenda next-state)]
                      (recur
                        next-agenda answers proofs (+ reductions 1)
                        (max agenda-peak (count next-agenda))))])]
                [(RuntimeRelationV1 relation-id arguments)
                 (let [branches (Vec SearchStateV1) (branches-for-runtime-call world state goal remaining)
                       next-agenda (Vec SearchStateV1) (reduce conj rest-agenda branches)]
                   (if (> (count next-agenda) (queryv1-max-agenda query))
                     (raw-search
                       :truncated-agenda
                       answers proofs (+ reductions 1)
                       (max agenda-peak (count next-agenda)))
                     (recur
                       next-agenda answers proofs (+ reductions 1)
                       (max agenda-peak (count next-agenda)))))]))))))))

(defn fact-relation?
  [world TheoryWorldV1
   relation-id String] Bool
  (let [clauses (Vec ClauseV1) (clauses-for-relation (theoryworldv1-clauses world) relation-id)]
    (loop [index Int 0]
      (if (>= index (count clauses))
        true
        (and (empty? (clausev1-body (nth clauses index)))
             (recur (+ index 1)))))))

(defn run-fact-orientation
  [world TheoryWorldV1
   query QueryV1
   order (Vec Int)] RawSearchV1
  (let [arena TermArenaV1 (theoryworldv1-arena world)
        clauses (Vec ClauseV1) (clauses-for-relation
          (theoryworldv1-clauses world) (queryv1-relation-id query))
        query-arguments (Vec TermRefV1) (term-refs (queryv1-arguments query) 0)]
    (loop [index Int 0
           answers (Vec AnswerV1) []
           proofs (Vec ProofOccurrenceV1) []
           reductions Int 0]
      (cond
        (>= index (count clauses))
        (raw-search :complete answers proofs reductions 1)

        (>= reductions (queryv1-max-reductions query))
        (raw-search :truncated-reductions answers proofs reductions 1)

        :else
        (let [clause ClauseV1 (nth clauses index)
              state SearchStateV1 (->SearchStateV1
                [] []
                [(clause-occurrence-id arena index clause)]
                (clausev1-evidence-ids clause)
                (+ index 2))]
          (match (unify-argument-order
                   arena []
                   query-arguments
                   (term-refs (clausev1-head clause) (+ index 1))
                   order)
            [(NotUnifiedV1 code)
             (recur (+ index 1) answers proofs (+ reductions 1))]
            [(UnifiedV1 bindings)
             (let [answered-state SearchStateV1 (->SearchStateV1
                     [] bindings
                     (searchstatev1-clause-ids state)
                     (searchstatev1-evidence-ids state)
                     (searchstatev1-next-scope state))
                   answer AnswerV1 (answer-for-bindings world query bindings)
                   proof ProofOccurrenceV1 (proof-for-state answer answered-state)
                   already-known Bool (answer-known? answers (answerv1-identity answer))]
               (if (and (not already-known)
                        (>= (count answers) (queryv1-max-answers query)))
                 (raw-search
                   :truncated-answers answers proofs reductions 1)
                 (recur
                   (+ index 1)
                   (add-answer answers answer)
                   (add-proof proofs proof)
                   (+ reductions 1))))]))))))

(defn run-fact-forward
  [world TheoryWorldV1
   query QueryV1] RawSearchV1
  (run-fact-orientation world query [0 1]))

(defn run-fact-reverse
  [world TheoryWorldV1
   query QueryV1] RawSearchV1
  (run-fact-orientation world query [1 0]))

(defn query-output-valid?
  [arena TermArenaV1
   query QueryV1
   output QueryOutputV1] Bool
  (let [node-id Int (queryoutputv1-node-id output)]
    (and
      (valid-node-id? arena node-id)
      (some?
        (some
          (fn [argument Int] Int?
            (if (= node-id argument) argument nil))
          (queryv1-arguments query)))
      (match (arena-node arena node-id)
        [(VariableNodeV1 sort-id ordinal) true]
        [(AtomNodeV1 sort-id semantic-id) false]
        [(ConstructorNodeV1 sort-id shape-id arguments) false]))))

(defn query-problem
  [world TheoryWorldV1
   query QueryV1] ProblemV1?
  (cond
    (not (world-valid? world))
    (->ProblemV1
      :invalid-world
      "the semantic world failed typed arena or relation admission"
      [])

    (or (<= (queryv1-max-reductions query) 0)
        (<= (queryv1-max-agenda query) 0)
        (<= (queryv1-max-answers query) 0))
    (->ProblemV1
      :invalid-query-bounds
      "query bounds must all be positive"
      [])

    :else
    (let [relation RelationV1? (relation-for-id
            (theoryworldv1-relations world) (queryv1-relation-id query))]
      (if (nil? relation)
        (->ProblemV1
          :unknown-relation
          "the query relation is not declared in this world"
          [(queryv1-relation-id query)])
        (let [mode ModeV1? (mode-for-id (relationv1-modes relation) (queryv1-mode-id query))]
          (cond
            (nil? mode)
            (->ProblemV1
              :unsupported-mode
              "the relation does not advertise the requested mode"
              [(queryv1-relation-id query) (queryv1-mode-id query)])

            (not (vector-node-sorts-match?
                   (theoryworldv1-arena world)
                   (queryv1-arguments query)
                   (relationv1-slot-sorts relation)))
            (->ProblemV1
              :query-signature
              "query arguments do not match the relation signature"
              [(queryv1-relation-id query)])

            (not (mode-admits-query?
                   (theoryworldv1-arena world)
                   mode
                   (queryv1-arguments query)))
            (->ProblemV1
              :mode-groundness
              "known and logic participants do not match the requested mode"
              [(queryv1-mode-id query)])

            (not
              (loop [index Int 0]
                (if (>= index (count (queryv1-outputs query)))
                  true
                  (and
                    (query-output-valid?
                      (theoryworldv1-arena world)
                      query
                      (nth (queryv1-outputs query) index))
                    (recur (+ index 1))))))
            (->ProblemV1
              :query-output
              "each output must name a logic variable present in the query"
              [])

            (and
              (keyword-member?
                [:fact-forward :fact-reverse]
                (strategyv1-kind
                  (first
                    (strategies-for-mode
                      (relationv1-strategies relation)
                      (modev1-identity mode)))))
              (or (not= 2 (count (relationv1-slot-sorts relation)))
                  (not (fact-relation? world (relationv1-identity relation)))))
            (->ProblemV1
              :strategy-precondition
              "fact orientation requires one binary fact-only relation"
              [(queryv1-relation-id query)])

            :else nil))))))

(defn determinism-satisfied?
  [determinism Keyword
   answer-count Int] Bool
  (cond
    (= determinism :det) (= answer-count 1)
    (= determinism :semidet) (<= answer-count 1)
    (= determinism :multi) (> answer-count 0)
    (= determinism :nondet) true
    :else false))

(defn selection-receipt
  [world TheoryWorldV1
   query QueryV1
   strategy StrategyV1] StrategySelectionReceiptV1
  (let [closure-id String (reachable-closure-id world (queryv1-relation-id query))
        identity String (semantic-id-v1
          "strategy-selection"
          [(theoryworldv1-profile-id world)
           (queryv1-relation-id query)
           (queryv1-mode-id query)
           (strategyv1-identity strategy)
           (str (strategyv1-kind strategy))
           closure-id
           (query-id world query)
           (str (queryv1-max-reductions query))
           (str (queryv1-max-agenda query))
           (str (queryv1-max-answers query))])]
    (->StrategySelectionReceiptV1
      identity
      (world-audit-id world)
      (queryv1-relation-id query)
      (queryv1-mode-id query)
      (strategyv1-identity strategy)
      (strategyv1-kind strategy)
      closure-id
      (queryv1-max-reductions query)
      (queryv1-max-agenda query)
      (queryv1-max-answers query))))

(defn query-result-id
  [selection StrategySelectionReceiptV1
   raw RawSearchV1] String
  (semantic-id-v1
    "query-result"
    [(strategyselectionreceiptv1-identity selection)
     (str (rawsearchv1-status raw))
     (canonical-parts-v1
       (mapv
         (fn [answer AnswerV1] String (answerv1-identity answer))
         (rawsearchv1-answers raw)))
     (canonical-parts-v1
       (mapv
         (fn [proof ProofOccurrenceV1] String
           (proofoccurrencev1-identity proof))
         (rawsearchv1-proofs raw)))
     (str (searchcountersv1-reductions (rawsearchv1-counters raw)))
     (str (searchcountersv1-agenda-peak (rawsearchv1-counters raw)))]))

(defn execute-query
  [world TheoryWorldV1
   query QueryV1] QueryResultV1
  (let [problem ProblemV1? (query-problem world query)]
    (if (some? problem)
      (->QueryInvalidV1 problem)
      (let [relation RelationV1? (relation-for-id
              (theoryworldv1-relations world) (queryv1-relation-id query))]
        (if (nil? relation)
          (->QueryInvalidV1
            (->ProblemV1
              :invalid-query-state
              "validated query lost its declared relation"
              [(queryv1-relation-id query)]))
          (let [mode ModeV1? (mode-for-id
                  (relationv1-modes relation) (queryv1-mode-id query))]
            (if (nil? mode)
              (->QueryInvalidV1
                (->ProblemV1
                  :invalid-query-state
                  "validated query lost its admitted mode"
                  [(queryv1-relation-id query) (queryv1-mode-id query)]))
              (let [strategy StrategyV1 (first
                      (strategies-for-mode
                        (relationv1-strategies relation)
                        (modev1-identity mode)))
                    raw RawSearchV1 (cond
                      (= :fifo-clauses (strategyv1-kind strategy))
                      (run-fifo-clauses world query)

                      (= :fact-forward (strategyv1-kind strategy))
                      (run-fact-forward world query)

                      :else
                      (run-fact-reverse world query))
                    selection StrategySelectionReceiptV1 (selection-receipt world query strategy)]
                (if (and (= :complete (rawsearchv1-status raw))
                         (not
                           (determinism-satisfied?
                             (modev1-determinism mode)
                             (count (rawsearchv1-answers raw)))))
                  (->QueryInvalidV1
                    (->ProblemV1
                      :determinism-violation
                      "complete execution contradicted the declared determinism"
                      [(modev1-identity mode)
                       (str (count (rawsearchv1-answers raw)))]))
                  (->QueryFinishedV1
                    (rawsearchv1-status raw)
                    (rawsearchv1-answers raw)
                    (rawsearchv1-proofs raw)
                    (rawsearchv1-counters raw)
                    selection
                    (query-result-id selection raw)))))))))))

(defn render-runtime-term
  [world TheoryWorldV1
   projection SourceProjectionV1
   bindings (Vec LogicBindingV1)
   term TermRefV1] String
  (let [arena TermArenaV1 (theoryworldv1-arena world)
        resolved TermRefV1 (walk-term arena bindings term)]
    (match (arena-node arena (termrefv1-node-id resolved))
      [(VariableNodeV1 sort-id ordinal)
       (str "?_" (termrefv1-scope resolved) "_" ordinal)]
      [(AtomNodeV1 sort-id semantic-id)
       (preferred-rendering projection semantic-id)]
      [(ConstructorNodeV1 sort-id shape-id arguments)
       (cond
         (= shape-id nil-shape-id) "[]"
         (= shape-id cons-shape-id)
         (loop [cursor TermRefV1 resolved
                rendered String "["]
           (let [current TermRefV1 (walk-term arena bindings cursor)]
             (match (arena-node arena (termrefv1-node-id current))
               [(VariableNodeV1 current-sort current-ordinal)
                (str rendered " | "
                     (render-runtime-term world projection bindings current)
                     "]")]
               [(AtomNodeV1 current-sort current-semantic-id)
                (str rendered " | "
                     (render-runtime-term world projection bindings current)
                     "]")]
               [(ConstructorNodeV1 current-sort current-shape current-arguments)
                (cond
                  (= current-shape nil-shape-id)
                  (str rendered "]")

                  (= current-shape cons-shape-id)
                  (let [head TermRefV1 (->TermRefV1
                          (first current-arguments) (termrefv1-scope current))
                        tail TermRefV1 (->TermRefV1
                          (nth current-arguments 1) (termrefv1-scope current))]
                    (recur
                      tail
                      (str rendered
                           (if (= rendered "[") "" " ")
                           (render-runtime-term
                             world projection bindings head))))

                  :else
                  (str rendered " | "
                       (render-runtime-term world projection bindings current)
                       "]"))])))
         :else
         (str (preferred-rendering projection shape-id) "(...)"))])))

(defn render-answer
  [world TheoryWorldV1
   projection SourceProjectionV1
   answer AnswerV1] String
  (canonical-parts-v1
    (mapv
      (fn [binding AnswerBindingV1] String
        (str (preferred-rendering projection (answerbindingv1-output-id binding))
             " = "
             (render-runtime-term
               world projection (answerv1-resolution answer)
               (answerbindingv1-term binding))))
      (answerv1-bindings answer))))

;; Concrete RacketCon vertical. The world is semantic data consumed by the
;; evaluator. The two source projections below are replaceable renderings of
;; these identities; neither projection participates in query execution.

(defn fixture-id
  [domain String
   name String] String
  (semantic-id-v1 domain ["racketcon-v1" name]))

(def append-relation-id String (fixture-id "relation" "append"))
(def calls-relation-id String (fixture-id "relation" "calls-defn"))
(def loop-relation-id String (fixture-id "relation" "loop"))
