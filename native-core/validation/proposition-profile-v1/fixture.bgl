(def append-forward-mode-id String (fixture-id "mode" "append/ground-ground-logic"))
(def append-splits-mode-id String (fixture-id "mode" "append/logic-logic-ground"))
(def calls-forward-mode-id String (fixture-id "mode" "calls/ground-logic"))
(def calls-reverse-mode-id String (fixture-id "mode" "calls/logic-ground"))
