    [symbol-sort-id symbol-sort-id]
    [(->ModeV1 compiler-churn-mode-id [:ground :logic] :nondet)]
    [(->StrategyV1
       compiler-churn-strategy-id
       compiler-churn-mode-id
       :fifo-clauses
       "bounded explanation from observed content and direct contract evidence"
       "finite observed mutation and direct-read extents")]))

(def compiler-relations (Vec RelationV1)
