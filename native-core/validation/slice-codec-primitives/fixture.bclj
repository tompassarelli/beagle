#lang beagle/clj
(ns native.codec-primitives)
(define-mode strict)

(defn encode-utf8 [value: String] -> (Vec Int)
  (utf8-encode value))

(defn decode-utf8 [value: (Vec Int)] -> String
  (utf8-decode value))

(defn encode-float [value: Float] -> Int
  (float-to-bits value))

(defn decode-float [value: Int] -> Float
  (float-from-bits value))
