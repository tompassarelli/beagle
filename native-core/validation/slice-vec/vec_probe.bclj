#lang beagle/clj

;; Vec-vocabulary leaves over the real fram.types record shapes; every real fram
;; count/nth/conj site also reaches a loop or arithmetic callee, so the C probe
;; calls these while those tiers land separately.
(ns fram.vec-probe)

(define-mode strict)

(require fram.types :as t)

(defn bucket-size [(bucket t/ActiveBucket)] Int
  (count (t/activebucket-positions bucket)))

(defn bucket-position-at [(bucket t/ActiveBucket) (position Int)] Int
  (nth (t/activebucket-positions bucket) position))

(defn bucket-with-position
  [(bucket t/ActiveBucket)
   (position Int)] t/ActiveBucket
  (t/->ActiveBucket (t/activebucket-triple-handle bucket)
                    (conj (t/activebucket-positions bucket) position)))

(defn append-position [(positions (Vec Int)) (position Int)] (Vec Int)
  (conj positions position))

(defn position-pair [(low Int) (high Int)] (Vec Int) [low high])

(defn empty-positions [] (Vec Int)
  (let [(seed (Vec Int)) []] seed))

(defn frame-operation-count [(frame t/TransactionFrame)] Int
  (count (t/transactionframe-operations frame)))

(defn frame-operation-at
  [(frame t/TransactionFrame)
   (position Int)] t/CommitOperation
  (nth (t/transactionframe-operations frame) position))

(defn any-values-equal? [(left (Vec Any)) (right (Vec Any))] Bool
  (= left right))

(defn increment-value [(value Int)] Int
  (inc value))

(defn decrement-value [(value Int)] Int
  (dec value))

(defn mask-values [(left Int) (right Int)] Int
  (bit-and left right))

(defn xor-values [(left Int) (right Int)] Int
  (bit-xor left right))

(defn shifted-value [(value Int) (distance Int)] Int
  (bit-shift-left value distance))

(defn values-differ? [(left Int) (right Int)] Bool
  (not= left right))

(defn no-positions? [(positions (Vec Int))] Bool
  (empty? positions))

(defn position-slice
  [(positions (Vec Int))
   (start Int)
   (end Int)] (Vec Int)
  (subvec positions start end))

(defn position-tail [(positions (Vec Int)) (start Int)] (Vec Int)
  (subvec positions start))

(defn reversed-positions [(positions (Vec Int))] (Vec Int)
  (reverse positions))

(defn append-positions [(left (Vec Int)) (right (Vec Int))] (Vec Int)
  (into left right))
