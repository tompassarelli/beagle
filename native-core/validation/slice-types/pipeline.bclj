#lang beagle/clj
(ns native.slice-types-pipeline)


(require native.core :as core)
(require native.stages :as stages)
(require native.lower :as lower)
(require native.obligations :as obligations)
(require native.c11 :as c11)

(defrecord FactV0
  [(subject Int)
   (predicate String)
   (object Any)
   (reference Bool)])

(defn slice-id [(domain String) (parts (Vec String))] core/NativeId
  (core/canonical-id (str "native-slice-types-v0/" domain) parts))

(defn same-id? [(left core/NativeId) (right core/NativeId)] Bool
  (core/native-id= left right))

(defn int-in? [(values (Vec Int)) (target Int)] Bool
  (loop [(index Int) 0]
    (if (>= index (count values))
      false
      (if (= (nth values index) target)
        true
        (recur (+ index 1))))))

(defn node-id [(source-id Int)] core/NativeId
  (slice-id "source-node" [(str source-id)]))

(defn fact-id [(ordinal Int)] core/NativeId
  (slice-id "source-fact" [(str ordinal)]))

(defn literal-key [(value Any)] String
  (cond
    (string? value) (str "text:" value)
    (integer? value) (str "i64:" value)
    (number? value) (str "f64:" value)
    (boolean? value) (str "bool:" value)
    :else (str "text:" value)))

(defn literal-id [(value Any)] core/NativeId
  (slice-id "literal" [(literal-key value)]))

(defn literal-term [(value Any)] stages/TermV0
  (cond
    (string? value) (stages/->TextTermV0 value)
    (integer? value) (stages/->I64TermV0 value)
    (number? value) (stages/->F64TermV0 (str value))
    (boolean? value) (stages/->BoolTermV0 value)
    :else (stages/->TextTermV0 (str value))))

(defn find-fact
  [(facts (Vec Any))
   (subject Int)
   (predicate String)] (U Any Nil)
  (loop [(index Int) 0]
    (if (>= index (count facts))
      nil
      (let [(fact Any) (nth facts index)]
        (if (and (= subject (nth fact 0)) (= predicate (nth fact 1)))
          fact
          (recur (+ index 1)))))))

(defn child-reference?
  [(facts (Vec Any))
   (subject Int)
   (object Any)] Bool
  (and (integer? object)
    (loop [(index Int) 0]
      (if (>= index (count facts))
        false
        (let [(fact Any) (nth facts index)]
          (if (and (= subject (nth fact 0))
                   (= "child" (nth fact 1))
                   (= object (nth fact 2)))
            true
            (recur (+ index 1))))))))

(defn instant-root [(facts (Vec Any))] Int
  (loop [(index Int) 0]
    (if (>= index (count facts))
      -1
      (let [(fact Any) (nth facts index)
            (subject Int) (nth fact 0)]
        (if (and (= "form-kind" (nth fact 1))
                 (= "record" (nth fact 2))
                 (if-let [name-fact (find-fact facts subject "name")]
                   (= "Instant" (nth name-fact 2))
                   false))
          subject
          (recur (+ index 1)))))))

(defn child-ids [(facts (Vec Any)) (subjects (Vec Int))] (Vec Int)
  (loop [(index Int) 0 (children (Vec Int)) []]
    (if (>= index (count facts))
      children
      (let [(fact Any) (nth facts index)
            (subject Int) (nth fact 0)
            (predicate String) (nth fact 1)
            (object Any) (nth fact 2)]
        (if (and (int-in? subjects subject)
                 (= "child" predicate)
                 (integer? object)
                 (not (int-in? subjects object))
                 (not (int-in? children object)))
          (recur (+ index 1) (conj children object))
          (recur (+ index 1) children))))))

(defn descendant-ids [(facts (Vec Any)) (root Int)] (Vec Int)
  (loop [(subjects (Vec Int)) [root]]
    (let [(children (Vec Int)) (child-ids facts subjects)]
      (if (= 0 (count children))
        subjects
        (recur (vec (concat subjects children)))))))

(defn select-facts [(facts (Vec Any)) (subjects (Vec Int))] (Vec FactV0)
  (loop [(index Int) 0 (selected (Vec FactV0)) []]
    (if (>= index (count facts))
      selected
      (let [(fact Any) (nth facts index)
            (subject Int) (nth fact 0)
            (predicate String) (nth fact 1)
            (object Any) (nth fact 2)]
        (if (int-in? subjects subject)
          (recur (+ index 1)
            (conj selected
              (->FactV0 subject predicate object
                (child-reference? facts subject object))))
          (recur (+ index 1) selected))))))

(defn node-in? [(nodes (Vec stages/TermNodeV0)) (identity core/NativeId)] Bool
  (loop [(index Int) 0]
    (if (>= index (count nodes))
      false
      (if (same-id? identity
            (stages/termnodev0-identity (nth nodes index)))
        true
        (recur (+ index 1))))))

(defn append-node
  [(nodes (Vec stages/TermNodeV0))
   (node stages/TermNodeV0)] (Vec stages/TermNodeV0)
  (if (node-in? nodes (stages/termnodev0-identity node))
    nodes
    (conj nodes node)))

(defn source-marker-node [(source-id Int)] stages/TermNodeV0
  (stages/->TermNodeV0 (node-id source-id)
    (stages/->TextTermV0 "source-node-v0")))

(defn literal-node [(value Any)] stages/TermNodeV0
  (stages/->TermNodeV0 (literal-id value) (literal-term value)))

(defn fact-object-id [(fact FactV0)] core/NativeId
  (if (factv0-reference fact)
    (node-id (factv0-object fact))
    (literal-id (factv0-object fact))))

(defn fact-node [(ordinal Int) (fact FactV0)] stages/TermNodeV0
  (stages/->TermNodeV0 (fact-id ordinal)
    (stages/->TripleTermV0
      (node-id (factv0-subject fact))
      (literal-id (factv0-predicate fact))
      (fact-object-id fact))))

(defn source-nodes [(facts (Vec FactV0))] (Vec stages/TermNodeV0)
  (loop [(index Int) 0 (nodes (Vec stages/TermNodeV0)) []]
    (if (>= index (count facts))
      nodes
      (let [(fact FactV0) (nth facts index)
            (with-subject (Vec stages/TermNodeV0))
            (append-node nodes (source-marker-node (factv0-subject fact)))
            (with-predicate (Vec stages/TermNodeV0))
            (append-node with-subject (literal-node (factv0-predicate fact)))
            (with-object (Vec stages/TermNodeV0))
            (if (factv0-reference fact)
              (append-node with-predicate
                (source-marker-node (factv0-object fact)))
              (append-node with-predicate (literal-node (factv0-object fact))))]
        (recur (+ index 1)
          (append-node with-object (fact-node index fact)))))))

(defn source-program
  [(facts (Vec Any))
   (source-text String)] stages/SourceStageV0
  (let [(root-number Int) (instant-root facts)
        (subjects (Vec Int)) (descendant-ids facts root-number)
        (selected (Vec FactV0)) (select-facts facts subjects)
        (root core/NativeId) (slice-id "source-root" ["fram.types"])
        (source-text-id core/NativeId) (slice-id "source-text" ["fram.types"])
        (nodes (Vec stages/TermNodeV0))
        (conj
          (conj (source-nodes selected)
            (stages/->TermNodeV0 root
              (stages/->TextTermV0 "source-stage-v0")))
          (stages/->TermNodeV0 source-text-id
            (stages/->TextTermV0 source-text)))]
    (if (< root-number 0)
      (throw (ex-info "fram.types Instant declaration is absent" {}))
      (stages/->SourceStageV0
        (stages/->TermGraphV0 root nodes)
        [(stages/->SourceModuleV0
           (slice-id "module" ["fram.types"])
           "fram.types"
           "src/fram/types.bgl"
           (stages/content-digest source-text)
           (stages/content-digest (str root-number ":Instant:Int:Int"))
           (node-id root-number))]
        []
        []))))

(defn type-named? [(definition core/TypeDef) (name String)] Bool
  (= name (core/typedef-name definition)))

(defn selected-type? [(definition core/TypeDef)] Bool
  (or (type-named? definition "I64")
      (type-named? definition "Instant")))

(defn selected-types [(program core/NativeCoreProgram)] (Vec core/TypeDef)
  (filterv
    (fn [(definition core/TypeDef)] Bool (selected-type? definition))
    (core/nativecoreprogram-types program)))

(defn id-selected?
  [(definitions (Vec core/TypeDef))
   (target core/NativeId)] Bool
  (loop [(index Int) 0]
    (if (>= index (count definitions))
      false
      (if (same-id? target (core/typedef-id (nth definitions index)))
        true
        (recur (+ index 1))))))

(defn selected-layouts
  [(program core/NativeCoreProgram)
   (definitions (Vec core/TypeDef))] (Vec core/LayoutDef)
  (filterv
    (fn [(layout core/LayoutDef)] Bool
      (id-selected? definitions (core/layoutdef-type-id layout)))
    (core/nativecoreprogram-layouts program)))

(defn c17-projection [(program core/NativeCoreProgram)] core/NativeCoreProgram
  (let [(definitions (Vec core/TypeDef)) (selected-types program)
        (layouts (Vec core/LayoutDef)) (selected-layouts program definitions)]
    (core/->NativeCoreProgram
      (slice-id "c17-projection" [(core/nativeid-value (core/nativecoreprogram-id program))])
      (core/nativecoreprogram-id program)
      "types-c17-projection-v0"
      definitions
      []
      []
      []
      layouts
      []
      []
      []
      []
      []
      [])))

(def obligation-names (Vec String)
  ["VALID_SSA"
   "EXHAUSTIVE_MATCHES"
   "CLOSED_LAYOUTS"
   "CHECKED_ARITHMETIC"
   "LEGAL_ABI"
   "DISCHARGED_TOKENS"
   "BOUNDED_EFFECTS"
   "EPOCH_SOUNDNESS"
   "LEAK_FREEDOM"])

(defn obligation-lines [(program core/NativeCoreProgram)] (Vec String)
  (let [(verdicts (Vec obligations/ObligationVerdictV0))
        (obligations/validate-native-core-program program (core/abi-profile-lp64))]
    (loop [(index Int) 0 (lines (Vec String)) []]
      (if (>= index (count verdicts))
        lines
        (let [(verdict obligations/ObligationVerdictV0) (nth verdicts index)]
          (if (obligations/obligation-passed? verdict)
            (recur (+ index 1)
              (conj lines (str (nth obligation-names index) " PASS")))
            (throw (ex-info
              (str (nth obligation-names index) " failed") {}))))))))

(defn join-lines [(lines (Vec String))] String
  (loop [(index Int) 0 (result String) ""]
    (if (>= index (count lines))
      result
      (recur (+ index 1) (str result (nth lines index) "\n")))))

(defn remove-extra-terminal-newline [(value String)] String
  (let [(size Int) (count value)]
    (if (and (> size 1)
             (= "\n" (subs value (- size 1) size))
             (= "\n" (subs value (- size 2) (- size 1))))
      (subs value 0 (- size 1))
      value)))

(defn require-source-freeze
  [(result lower/SourceFreezeResultV0)] stages/FrozenSourceStageV0
  (if (instance? native.lower.SourceFreezeAcceptedV0 result)
    (lower/sourcefreezeacceptedv0-frozen result)
    (throw (ex-info "source program freezing failed" {}))))

(defn require-typing [(result lower/TypingResultV0)] stages/FrozenTypedStageV0
  (if (instance? native.lower.TypingAcceptedV0 result)
    (lower/typingacceptedv0-frozen result)
    (throw (ex-info "source-to-typed lowering failed" {}))))

(defn require-slice [(result lower/TypingResultV0)] lower/TypedSliceV0
  (if (instance? native.lower.TypingAcceptedV0 result)
    (lower/typingacceptedv0-slice result)
    (throw (ex-info "source-to-typed lowering produced no slice" {}))))

(defn require-native-freeze
  [(result lower/NativeLoweringResultV0)] stages/FrozenNativeStageV0
  (cond
    (instance? native.lower.NativeLoweringCompleteV0 result)
    (lower/nativeloweringcompletev0-frozen result)

    (instance? native.lower.NativeLoweringPendingV0 result)
    (lower/nativeloweringpendingv0-frozen result)

    :else (throw (ex-info "typed-to-native lowering produced no program" {}))))

(defn native-status [(result lower/NativeLoweringResultV0)] String
  (if (instance? native.lower.NativeLoweringCompleteV0 result)
    "complete"
    "frozen-types-only-pending-no-function-abi"))

(defn require-artifact [(result c11/C11Materialization)] c11/C11Artifact
  (if (instance? native.c11.C11Success result)
    (c11/c11success-artifact result)
    (throw (ex-info (c11/c11failure-detail result) {}))))

(defn main-text [(program core/NativeCoreProgram)] String
  (let [(types (Vec core/TypeDef)) (c11/ordered-types (core/nativecoreprogram-types program))
        (instant-index Int)
        (c11/type-index types (lower/source-type-id "fram.types/Instant"))
        (instant-type String) (c11/type-name 0 instant-index)]
    (if (< instant-index 0)
      (throw (ex-info "Instant type is absent from C17 projection" {}))
      (str "/* Generated by native.slice-types-pipeline; do not edit. */\n"
        "#include \"module_0.h\"\n\n"
        "int main(void) {\n"
        "  " instant-type " value = { INT64_C(42), INT64_C(7) };\n"
        "  if ((value.field_0 != INT64_C(42)) || (value.field_1 != INT64_C(7))) {\n"
        "    return 1;\n"
        "  }\n"
        "  return 0;\n"
        "}\n"))))

(defn emit-slice!
  [(facts-path String)
   (source-path String)
   (output-directory String)] Nil
  (let [(facts (Vec Any)) (read-string (slurp facts-path))
        (source-text String) (slurp source-path)
        (configuration (Vec String))
        ["profile=3" "module=fram.types" "slice=Instant"]
        (source stages/SourceStageV0) (source-program facts source-text)
        (source-freeze stages/FrozenSourceStageV0)
        (require-source-freeze
          (lower/freeze-source-stage source "e50f806" configuration))
        (typing-result lower/TypingResultV0)
        (lower/lower-typed-stage source-freeze "e50f806" configuration)
        (typed-freeze stages/FrozenTypedStageV0) (require-typing typing-result)
        (typed-slice lower/TypedSliceV0) (require-slice typing-result)
        (native-result lower/NativeLoweringResultV0)
        (lower/lower-native-stage typed-freeze typed-slice "e50f806" configuration
          (core/abi-profile-lp64))
        (native-freeze stages/FrozenNativeStageV0) (require-native-freeze native-result)
        (epoch-freeze stages/FrozenNativeStageV0)
        (lower/epoch-result-frozen
          (lower/epoch-identity-stage native-freeze "e50f806" configuration
            (core/abi-profile-lp64)))
        (lowered-program core/NativeCoreProgram)
        (stages/nativestagev0-program
          (stages/frozennativestagev0-stage epoch-freeze))
        (material-program core/NativeCoreProgram) (c17-projection lowered-program)
        (obligations-text String) (join-lines (obligation-lines material-program))
        (artifact c11/C11Artifact)
        (require-artifact (c11/materialize-program material-program 0))
        (evidence String)
        (join-lines
          [(str "source-path=" source-path)
           (str "source-bytes=" (count source-text))
           (str "source-digest-bytes="
             (count (stages/frozensourcestagev0-digest source-freeze)))
           (str "typed-digest-bytes="
             (count (stages/frozentypedstagev0-digest typed-freeze)))
           (str "native-digest-bytes="
             (count (stages/frozennativestagev0-digest native-freeze)))
           (str "typed-source-bound="
             (= (stages/typedstagev0-source-digest
                  (stages/frozentypedstagev0-stage typed-freeze))
                (stages/frozensourcestagev0-digest source-freeze)))
           (str "native-typed-bound="
             (= (stages/nativestagev0-typed-digest
                  (stages/frozennativestagev0-stage native-freeze))
                (stages/frozentypedstagev0-digest typed-freeze)))
           (str "typed-host-erased="
             (lower/term-graph-clean?
               (stages/typedstagev0-terms
                 (stages/frozentypedstagev0-stage typed-freeze))))
           (str "native-host-erased="
             (lower/native-program-host-erased? native-freeze))
           (str "typed-to-native-status=" (native-status native-result))
           (str "epoch-digest-bytes="
             (count (stages/frozennativestagev0-digest epoch-freeze)))
           (str "epoch-native-rebound="
             (not (= (stages/frozennativestagev0-digest epoch-freeze)
                     (stages/frozennativestagev0-digest native-freeze))))
           (str "materialized-compiler-pass="
             (core/nativecoreprogram-compiler-pass lowered-program))
           (str "materialized-types=" (count (core/nativecoreprogram-types material-program)))
           (str "materialized-layouts=" (count (core/nativecoreprogram-layouts material-program)))
           "materializer=native.c11/materialize-program"
           "c-standard=c17"])]
    (spit (str output-directory "/module_0.h")
      (c11/c11artifact-header-text artifact))
    (spit (str output-directory "/module_0.c")
      (remove-extra-terminal-newline
        (c11/c11artifact-source-text artifact)))
    (spit (str output-directory "/main.c") (main-text material-program))
    (spit (str output-directory "/obligations.txt") obligations-text)
    (spit (str output-directory "/pipeline-evidence.txt") evidence)
    (println evidence)
    (println obligations-text)))
