#lang beagle/clj
;; The four loop/recur shapes the Beagle checker accepts and the native lowering
;; must refuse by name; each function carries exactly one of them.
(ns native.loops-refusals)
(define-mode strict)

(defn non-tail [n: Int] -> Int
  (loop [a: Int 0]
    (if (>= a n) a (+ 1 (recur a)))))

(defn outside-loop [n: Int] -> Int
  (recur n))

(defn wrong-arity [n: Int] -> Int
  (loop [a: Int 0]
    (if (>= a n) a (recur a a))))

(defn wrong-types [n: Int] -> Int
  (loop [a: Int 0]
    (if (>= a n) a (recur true))))
