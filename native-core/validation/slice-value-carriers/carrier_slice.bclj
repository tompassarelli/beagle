#lang beagle/clj
(ns native.slice-value-carriers-slice
  (:require [native.core :as core]
            [native.stages :as stages]
            [native.lower :as lower]
            [native.obligations :as obligations]
            [native.slice :as slice]
            [native.body-c17 :as body]))

(defn function-report [(functions (Vec core/FunctionDef))] String
  (loop [(position Int) 0 (report String) ""]
    (if (>= position (count functions))
      report
      (recur (+ position 1)
        (str report "lowered "
          (core/functiondef-name (nth functions position)) "\n")))))

(defn obligations-pass?
  [(verdicts (Vec obligations/ObligationVerdictV0))] Bool
  (every? obligations/obligation-passed? verdicts))

(defn typing-rejection-report [(result lower/TypingResultV0)] String
  (if (not (instance? native.lower.TypingRejectedV0 result))
    "stage source-to-typed REJECTED\n"
    (let [(diagnostics (Vec core/DiagnosticV0))
          (core/passreceiptv0-diagnostics
            (lower/typingrejectedv0-receipt result))]
      (loop [(position Int) 0
             (report String) "stage source-to-typed REJECTED\n"]
        (if (>= position (count diagnostics))
          report
          (let [(diagnostic core/DiagnosticV0) (nth diagnostics position)]
            (recur (+ position 1)
              (str report "typing-diagnostic "
                (core/diagnosticv0-code diagnostic) " "
                (core/diagnosticv0-detail diagnostic) "\n"))))))))

(defn emit-fixture!
  [(facts-path String) (artifacts-dir String)] String
  (let [(abi core/AbiProfileV0) (core/abi-profile-lp64)
        (configuration (Vec String)) ["profile=3" "abi=lp64"]
        (source stages/SourceStageV1)
        (slice/source-program
          (slice/parse-facts (slurp facts-path))
          "native.slice-value-carriers"
          "native-core/validation/slice-value-carriers/fixture.bgl")
        (freeze-result lower/SourceFreezeResultV0)
        (lower/freeze-source-stage source
          "native-slice-value-carriers-v0" configuration)]
    (if (not (instance? native.lower.SourceFreezeAcceptedV0 freeze-result))
      "stage source-freeze REJECTED\n"
      (let [(typing-result lower/TypingResultV0)
            (lower/lower-typed-stage
              (lower/sourcefreezeacceptedv0-frozen freeze-result)
              "native-slice-value-carriers-v0" configuration)]
        (if (not (instance? native.lower.TypingAcceptedV0 typing-result))
          (typing-rejection-report typing-result)
          (let [(native-result lower/NativeLoweringResultV0)
                (lower/lower-native-stage
                  (lower/typingacceptedv0-frozen typing-result)
                  (lower/typingacceptedv0-slice typing-result)
                  "native-slice-value-carriers-v0" configuration abi)
                (epoch-result lower/EpochLoweringResultV0)
                (lower/epoch-derived-stage (slice/native-frozen native-result)
                  "native-slice-value-carriers-v0" configuration abi)
                (program core/NativeCoreProgram)
                (stages/nativestagev0-program
                  (stages/frozennativestagev0-stage
                    (lower/epoch-result-frozen epoch-result)))
                (verdicts (Vec obligations/ObligationVerdictV0))
                (obligations/validate-native-core-program program abi)
                (materialized body/BodyMaterializationV0)
                (body/materialize-program program 0)
                (head String)
                (str "stage source-freeze ACCEPTED\n"
                  "stage source-to-typed ACCEPTED\n"
                  "stage typed-to-native "
                  (if (instance? native.lower.NativeLoweringCompleteV0
                        native-result)
                    "COMPLETE\n"
                    "PENDING\n")
                  (function-report (core/nativecoreprogram-functions program))
                  (if (obligations-pass? verdicts)
                    "obligations PASS\n"
                    "obligations FAIL\n")
                  (slice/pending-reports (slice/native-pending native-result)))]
            (if (not (body/materialization-ok? materialized))
              (str head "materialize REFUSED "
                (body/materialization-detail materialized) "\n")
              (let [(artifact body/BodyArtifactV0)
                    (body/materialization-artifact materialized)]
                (do
                  (spit (str artifacts-dir "/"
                          (body/bodyartifactv0-header-name artifact))
                    (body/bodyartifactv0-header-text artifact))
                  (spit (str artifacts-dir "/"
                          (body/bodyartifactv0-source-name artifact))
                    (body/bodyartifactv0-source-text artifact))
                  (str head "materialize OK "
                    (body/bodyartifactv0-header-name artifact) " "
                    (body/bodyartifactv0-source-name artifact) "\n"))))))))))
