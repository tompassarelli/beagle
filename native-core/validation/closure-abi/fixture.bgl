#lang beagle

(ns native.closure-abi)

(defn make-adder [(base Int)] (Fn [Int] Int)
  (fn [value Int] Int
    (+ base value)))

(defn invoke [(callable (Fn [Int] Int)) (value Int)] Int
  (callable value))

(defn factorial [(value Int)] Int
  (letfn [(step [(current Int)] Int
            (if (= current 0)
              1
              (* current (step (- current 1)))))]
    (step value)))

(defn add [(left Int) (right Int)] Int
  (+ left right))

(defn packed-count [(head Int) & (tail (Vec Int))] Int
  (+ head (count tail)))

(defn -main [] Int
  (let [stored (Fn [Int] Int) (make-adder 7)
        arguments (Vec Int) [4 5]]
    (if (and (= (stored 5) 12)
          (= (invoke stored 6) 13)
          (= (factorial 5) 120)
          (= (apply add arguments) 9)
          (= (packed-count 1 2 3) 3))
      0
      1)))
