#lang beagle
(ns native.type-closure-payloadless
  (:require [native.type-closure-provider :as provider]))

(defunion ViewsAction
  ViewsOverview
  (ViewsHost [(host String)])
  ViewsRefresh
  (ViewsModule [(module String)])
  ViewsJson
  (ViewsPath [(path String)])
  ViewsHelp)

(defn preserve-action [action ViewsAction] ViewsAction
  (match action
    [(ViewsOverview) (->ViewsOverview)]
    [(ViewsHost host) (->ViewsHost host)]
    [(ViewsRefresh) (->ViewsRefresh)]
    [(ViewsModule module) (->ViewsModule module)]
    [(ViewsJson) (->ViewsJson)]
    [(ViewsPath path) (->ViewsPath path)]
    [(ViewsHelp) (->ViewsHelp)]))

(defrecord OverlapLeft [(value String)])
(defrecord OverlapRight [(value String)])
(defrecord OverlapExtra [(value String)])

(defunion OverlapBroad OverlapLeft OverlapRight OverlapExtra)
(defunion OverlapExact OverlapLeft OverlapRight)

(defn preserve-overlap
  [value (U OverlapLeft OverlapRight)] (U OverlapLeft OverlapRight)
  value)

(defn preserve-action-subset
  [value (U ViewsOverview ViewsHost)] (U ViewsOverview ViewsHost)
  value)

(defrecord AmbiguousLeft [(value String)])
(defrecord AmbiguousRight [(value String)])

(defunion AmbiguousOne AmbiguousLeft AmbiguousRight)
(defunion AmbiguousTwo AmbiguousLeft AmbiguousRight)

(defn preserve-ambiguous
  [value (U AmbiguousLeft AmbiguousRight)] (U AmbiguousLeft AmbiguousRight)
  value)

(defrecord CrossLeft [(value String)])
(defrecord CrossRight [(value String)])

(defunion LocalCrossPair CrossLeft CrossRight)

(defn preserve-imported-cross
  [value (U provider/CrossLeft provider/CrossRight)]
  (U provider/CrossLeft provider/CrossRight)
  value)

(defunion :throwable ClosureProblem ClosureMissing ClosureDenied)

(defn preserve-closure-problem
  [value (U ClosureMissing ClosureDenied)]
  (U ClosureMissing ClosureDenied)
  value)
