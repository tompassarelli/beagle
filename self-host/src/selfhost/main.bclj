#lang beagle/clj
(ns selfhost.main
  "Self-hosted compiler driver: reader -> parse -> check -> emit-clj on
  babashka. Commands: ast FILE | check FILE | emit FILE | emit-from-ast |
  facts-roundtrip MODE FILE.
  Host IO via selfhost.rt externs; the compiler stages are pure .bclj.
  (:gen-class) so the JVM/GraalVM native-image path has a -main entry class;
  babashka ignores it."
  (:gen-class))
(define-mode strict)

(require clojure.string :as str)
(require selfhost.rt)
(require selfhost.reader :as rd)
(require selfhost.parse :as p)
(require selfhost.check :as c)
(require selfhost.emit-clj :as e)
(require selfhost.emit-nix :as en)
(require selfhost.emit-js :as ejs)
(require selfhost.facts-roundtrip :as fr)

(declare-extern selfhost.rt/slurp-file (Fn [String] String))
(declare-extern selfhost.rt/read-source-snapshot (Fn [String] Any))
(declare-extern selfhost.rt/read-stdin (Fn [] String))
(declare-extern selfhost.rt/to-json (Fn [Any] String))
(declare-extern selfhost.rt/parse-json (Fn [String] Any))
(declare-extern selfhost.rt/exit (Fn [Int] Nil))
(declare-extern selfhost.rt/eprint (Fn [String] Nil))
(declare-extern selfhost.rt/file-exists? (Fn [String] Bool))
(declare-extern selfhost.rt/abs-path (Fn [String] String))
(declare-extern selfhost.rt/source-id (Fn [String] String))
(declare-extern selfhost.rt/canonical-json (Fn [Any] String))
(declare-extern selfhost.rt/source-sha256 (Fn [String] String))
(declare-extern selfhost.rt/projection-sha256 (Fn [Any] String))
(declare-extern selfhost.rt/valid-sha256? (Fn [Any] Bool))
(declare-extern selfhost.rt/valid-projection-sha256? (Fn [Any] Bool))

(def CHECKED-PROGRAM-SCHEMA-VERSION Int 3)

(def IMPORTED-RECORD-CONTRACTS-KEY String
  "$beagle$selfhost$imported-record-contracts")

(def IMPORTED-CALLABLE-SYNCHRONIZATION-KEY String
  "$beagle$selfhost$imported-callable-synchronization")

;; A module surface is useful only after its provider has parsed and checked.
;; Cache that checked result per CLI invocation so a diamond import graph does
;; not rerun provider checks, and reject cycles instead of guessing contracts
;; from a partially loaded provider.
(def MODULE-SURFACE-CACHE Any (atom {}))
(def MODULE-LOAD-STACK Any (atom {}))

(declare parse-file-target!)

;; --- module resolution (driver-level; parse stays pure) ----------------------
;; Mirror of beagle-lib parse.rkt resolve-module-path + register-require!: for
;; each (require ...) resolve a sibling beagle source, read + parse it (pure),
;; extract its typed surface via p/import-module-surface, and merge the imported
;; externs into the program so cross-module refs type-check like the oracle. IO
;; (file-exists?/slurp) lives here; the parse stage takes only datums. A require
;; that resolves to no beagle source (external / .clj runtime) is skipped, and
;; its calls type as Any — exactly the oracle's behavior.

(def BEAGLE-EXTENSIONS (Vec String)
  [".bclj" ".bjs" ".bnix" ".bgl" ".rkt"])

(defn- split-dots [(s String)] Any
  (loop [(i Int) 0 (start Int) 0 (acc Any) []]
    (cond
      (>= i (count s)) (conj acc (subs s start i))
      (= (subs s i (+ i 1)) ".") (recur (+ i 1) (+ i 1) (conj acc (subs s start i)))
      :else (recur (+ i 1) start acc))))

(defn- last-slash [(s String)] Int
  (loop [i (- (count s) 1)]
    (cond
      (< i 0) -1
      (= (subs s i (+ i 1)) "/") i
      :else (recur (- i 1)))))

(defn- dir-of [(path String)] String
  (let [i (last-slash path)]
    (if (< i 0) "" (subs path 0 i))))

(defn- join-slash [(segs Any)] String
  (if (= (count segs) 0)
    ""
    (reduce (fn [(a String) (s String)] String (str a "/" s))
            (nth segs 0) (subvec segs 1))))

(defn- try-ext [(dir String) (rel String)] Any
  (loop [i 0]
    (if (>= i (count BEAGLE-EXTENSIONS))
      nil
      (let [p (str dir "/" rel (nth BEAGLE-EXTENSIONS i))]
        (if (selfhost.rt/file-exists? p) p (recur (+ i 1)))))))

;; nested (dir-segs/base) first, then a flat (base) fallback guarded against
;; resolving to the source file itself — parse.rkt try-at.
(defn- try-at-dir
  [(dir String) (dir-segs Any) (base String) (abs-source String)] Any
  (let [nested-rel (if (> (count dir-segs) 0) (str (join-slash dir-segs) "/" base) base)
        nested (try-ext dir nested-rel)]
    (if (some? nested)
      nested
      (if (> (count dir-segs) 0)
        (let [flat (try-ext dir base)]
          (if (and (some? flat) (not (= flat abs-source))) flat nil))
        nil))))

(defn- resolve-ns-path [(ns String) (source-path String)] Any
  (let [segs (split-dots ns)
        base (nth segs (- (count segs) 1))
        dir-segs (subvec segs 0 (- (count segs) 1))
        abs-source (selfhost.rt/abs-path source-path)
        src-dir (dir-of abs-source)]
    (loop [cur src-dir]
      (let [hit (try-at-dir cur dir-segs base abs-source)]
        (if (some? hit)
          hit
          (let [parent (dir-of cur)]
            (if (or (= parent "") (= parent cur)) nil (recur parent))))))))

(defn- dedup-externs [(xs Any)] Any
  (loop [(i Int) 0 (seen Any) {} (acc Any) []]
    (if (>= i (count xs))
      acc
      (let [e (nth xs i) nm (get e "name")]
        (if (= true (get seen nm))
          (recur (+ i 1) seen acc)
          (recur (+ i 1) (assoc seen nm true) (conj acc e)))))))

(defn- surface-type-aliases [(surfaces Any)] Any
  (reduce
    (fn [(aliases Any) (surface Any)] Any
      (into aliases (get surface "type-aliases" {})))
    {}
    surfaces))

(defn- checked-module-surface!
  [(path String) (target String) (imported-aliases Any)] Any
  (let [absolute-path (selfhost.rt/abs-path path)
        cache-key (str target "\n" absolute-path)
        cached (get (deref MODULE-SURFACE-CACHE) cache-key)]
    (cond
      (some? cached)
      cached

      (= true (get (deref MODULE-LOAD-STACK) cache-key))
      (do
        (selfhost.rt/eprint
          (str "beagle [module]: cyclic checked module dependency at "
            absolute-path "\n"))
        (selfhost.rt/exit 1)
        nil)

      :else
      (do
        (swap! MODULE-LOAD-STACK assoc cache-key true)
        (let [snapshot (parse-file-target! absolute-path target)
              prog (get snapshot "program")
              errors (c/check-program! prog)]
          (if (> (count errors) 0)
            (do
              (doseq [err errors]
                (selfhost.rt/eprint
                  (str "beagle [check]: " err "\n")))
              (selfhost.rt/exit 1)
              nil)
            (let [surface
                    {"datums" (get snapshot "datums")
                     "type-aliases"
                       (p/module-type-aliases-with-imports!
                         (get snapshot "datums")
                         ""
                         nil
                         imported-aliases)
                     "record-contracts"
                       (c/export-checked-record-contracts! prog)
                     "callable-synchronization"
                       (c/export-checked-callable-synchronization! prog)}]
              (swap! MODULE-SURFACE-CACHE assoc cache-key surface)
              (swap! MODULE-LOAD-STACK dissoc cache-key)
              surface)))))))

(declare load-import-surfaces*!)

(defn- load-import-surfaces*!
  [(requires Any) (source-path String) (target String) (seen-paths Any)] Any
  (reduce
    (fn [(surfaces Any) (r Any)] Any
      (let [ns (get r "ns")
            alias (get r "alias")
            refer (get r "refer")
            prefix (if (and (some? alias) (not (= alias false)))
                     alias
                     (let [segs (split-dots ns)] (nth segs (- (count segs) 1))))
            refer-syms (if (and (some? refer) (not (= refer false))) refer nil)
            path (resolve-ns-path ns source-path)]
        (if (some? path)
          (let [absolute-path (selfhost.rt/abs-path path)]
            (if (= true (get seen-paths absolute-path))
              surfaces
              (let [datums (rd/read-program (selfhost.rt/slurp-file path))
                    dependency-surfaces
                      (load-import-surfaces*!
                        (p/discover-requires! datums)
                        path
                        target
                        (assoc seen-paths absolute-path true))
                    imported-aliases (surface-type-aliases dependency-surfaces)
                    checked-surface
                      (checked-module-surface! path target imported-aliases)
                    type-aliases
                      (p/module-type-aliases-with-imports!
                        datums prefix refer-syms imported-aliases)]
                (conj surfaces
                  (assoc checked-surface
                    "path" path
                    "prefix" prefix
                    "refer" refer-syms
                    "imported-aliases" imported-aliases
                    "type-aliases" type-aliases)))))
          surfaces)))
    []
    requires))

(defn- load-import-surfaces!
  [(requires Any) (source-path String) (target String)] Any
  (load-import-surfaces*!
    requires
    source-path
    target
    {(selfhost.rt/abs-path source-path) true}))

(defn- import-parametric-arities [(surfaces Any)] Any
  (reduce
    (fn [(arities Any) (surface Any)] Any
      (into arities
        (p/module-parametric-arities
          (get surface "datums")
          (get surface "prefix")
          (get surface "refer"))))
    {}
    surfaces))

(defn- import-type-aliases [(surfaces Any)] Any
  (surface-type-aliases surfaces))

(defn- resolve-imports! [(prog Any) (surfaces Any)] Any
  (let [own-externs (get prog "externs")
        imported (reduce
                   (fn [(acc Any) (surface Any)] Any
                     (into acc
                       (mapv
                         (fn [(extern Any)] Any
                           ;; Imported callables are unproved unless the
                           ;; checked provider separately publishes its
                           ;; authoritative ordinary and returned-callable
                           ;; synchronization facts below.
                         (assoc extern
                           "synchronous" false
                           "returnsSynchronousCallable" false))
                         (p/import-module-surface-with-aliases!
                           (get surface "datums")
                           (get surface "prefix")
                           (get surface "refer")
                           (get surface "imported-aliases")))))
                   [] surfaces)
        record-contracts
          (reduce
            (fn [(acc Any) (surface Any)] Any
              (into acc
                (p/qualify-imported-record-contracts
                  (get surface "record-contracts")
                  (get surface "prefix")
                  (get surface "refer"))))
            [] surfaces)
        callable-synchronization
          (reduce
            (fn [(acc Any) (surface Any)] Any
              (into acc
                (p/qualify-imported-callable-synchronization
                  (get surface "callable-synchronization")
                  (get surface "prefix")
                  (get surface "refer"))))
            [] surfaces)]
    ;; own declare-externs are first, so they win any name collision.
    (assoc prog
      "externs" (dedup-externs (into own-externs imported))
      IMPORTED-RECORD-CONTRACTS-KEY record-contracts
      IMPORTED-CALLABLE-SYNCHRONIZATION-KEY callable-synchronization)))

;; Inject the requested emit target into the datum stream when the source
;; declares none, so parse (js/quote combiner, target-case) + emit agree. The
;; #lang line is consumed by the reader (target dropped from read-program), and
;; the CLI --target is authoritative; a source-level (define-target ...) wins if
;; present (duplicate would be a parse error).
(defn- has-define-target? [(datums Any)] Bool
  (> (count (filterv (fn [(d Any)] Bool
                       (and (vector? d) (>= (count d) 2) (= (nth d 0) "define-target")))
                     datums)) 0))

(defn- parse-file-target! [(path String) (target String)] Any
  (let [(source-snapshot Any) (selfhost.rt/read-source-snapshot path)
        (source-text String) (get source-snapshot "text")
        (datums0 Any) (rd/read-program source-text)
        (datums Any) (if (has-define-target? datums0) datums0 (into [["define-target" target]] datums0))
        (surfaces Any) (load-import-surfaces!
                         (p/discover-requires! datums)
                         path
                         target)
        (imported-arities Any) (import-parametric-arities surfaces)
        (imported-aliases Any) (import-type-aliases surfaces)
        (prog Any) (resolve-imports!
                    (p/parse-program-with-imports!
                      datums imported-arities imported-aliases)
                    surfaces)
        (perrs Any) (p/parse-errors)]
    ;; Racket raises on a parse diagnostic and exits nonzero. The self-host
    ;; parser collects + eprints, so the driver must fail explicitly: any parse
    ;; diagnostic => nonzero exit, no 'ok', no emit. (err! already printed each.)
    (if (> (count perrs) 0)
      (do (selfhost.rt/exit 1)
          prog)
      {"program" prog
       "datums" datums
       "source-text" source-text
       "source-sha256" (get source-snapshot "sourceSha256")
       "source-id" (selfhost.rt/source-id path)})))

(defn- check-or-die! [(prog Any)] Any
  (let [(errors Any) (c/check-program! prog)]
    (if (> (count errors) 0)
      (do
        (doseq [err errors]
          (selfhost.rt/eprint (str "beagle [check]: " err "\n")))
        (selfhost.rt/exit 1)
        prog)
      (c/decorate-checked-program! prog))))

;; Emit dispatch by target. Default clj keeps current behavior; each backend
;; adds one branch here (parallel target ports union into this table).
(defn- emit-for-target [(target String) (prog Any)] String
  (cond
    (= target "js") (ejs/emit-program! prog)
    (= target "nix") (en/emit-program! prog)
    :else (e/emit-program! prog)))

(def CHECKED-PROGRAM-KEYS Any
  ["kind" "schemaVersion" "phase" "target" "namespace" "sourceId"
   "sourceSha256" "projectionSha256" "mode" "gen-class" "requires"
   "imports" "externs" "forms"])

(defn- exact-checked-program-keys? [(projection Any)] Bool
  (and (= (count (keys projection)) (count CHECKED-PROGRAM-KEYS))
       (every? (fn [(key String)] Bool (contains? projection key))
         CHECKED-PROGRAM-KEYS)))

(defn- complete-binding? [(binding Any)] Bool
  (and (map? binding)
       (contains? binding "name")
       (contains? binding "constraint")
       (contains? binding "constraintSynchronous")
       (boolean? (get binding "constraintSynchronous"))
       (= (get binding "constraintSynchronous")
          (and (not (nil? (get binding "constraint")))
               (not (false? (get binding "constraint")))))))

(defn- exact-object-keys? [(value Any) (expected Any)] Bool
  (and (map? value)
       (= (count (keys value)) (count expected))
       (every? (fn [(key String)] Bool (contains? value key)) expected)))

(defn- valid-record-update-contract? [(contract Any)] Bool
  (and (exact-object-keys?
         contract ["recordName" "fieldOrder" "validator"])
       (string? (get contract "recordName"))
       (vector? (get contract "fieldOrder"))
       (every? string? (get contract "fieldOrder"))
       (or (nil? (get contract "validator"))
           (string? (get contract "validator")))))

(defn- valid-record-field-access-contract? [(contract Any)] Bool
  (and (exact-object-keys? contract ["recordName"])
       (string? (get contract "recordName"))))

(defn- params-complete? [(params Any)] Bool
  (and (vector? params)
       (every? (fn [(param Any)] Bool
                 (if (= (get param "type") "param")
                   (complete-binding? param)
                   true))
         params)))

(defn- callable-shape-complete? [(callable Any)] Bool
  (and (contains? callable "rest")
       (params-complete? (get callable "params"))
       (let [rest-param (get callable "rest")]
         (or (nil? rest-param)
             (false? rest-param)
             (and (= (get rest-param "type") "param")
                  (complete-binding? rest-param))))))

(defn- bindings-complete? [(bindings Any)] Bool
  (and (vector? bindings) (every? complete-binding? bindings)))

(declare constraint-schema-complete?)

(defn- map-children-complete? [(value Any)] Bool
  (every? (fn [(key Any)] Bool
            (constraint-schema-complete? (get value key)))
    (keys value)))

(defn- constraint-schema-complete? [(value Any)] Bool
  (cond
    (vector? value)
    (every? constraint-schema-complete? value)

    (map? value)
    (let [node (get value "node")
          type (get value "type")
          local-ok
            (cond
              (= type "param") (complete-binding? value)
              (= type "binding") (complete-binding? value)

              (or (= node "defn") (= node "fn"))
              (callable-shape-complete? value)

              (= node "defn-multi")
              (every? callable-shape-complete? (get value "arities"))

              (= node "letfn")
              (every? callable-shape-complete? (get value "fns"))

              (or (= node "let") (= node "loop")
                  (= node "binding") (= node "with-open"))
              (bindings-complete? (get value "bindings"))

              (or (= node "for") (= node "doseq"))
              (every?
                (fn [(clause Any)] Bool
                  (cond
                    (= (get clause "type") "binding")
                    (complete-binding? clause)
                    (= (get clause "type") "let")
                    (bindings-complete? (get clause "bindings"))
                    :else true))
                (get value "clauses"))

              (= node "record")
              (params-complete? (get value "fields"))

              (or (= node "defunion") (= node "deferror"))
              (let [member-fields (get value "member-fields")]
                (or (nil? member-fields)
                    (false? member-fields)
                    (every? (fn [(name Any)] Bool
                              (params-complete? (get member-fields name)))
                      (keys member-fields))))

              (= node "defprotocol")
              (every? callable-shape-complete? (get value "methods"))

              (= node "extend-type")
              (every?
                (fn [(impl Any)] Bool
                  (every? callable-shape-complete? (get impl "methods")))
                (get value "impls"))

              (= node "defscalar")
              (and (contains? value "predicates")
                   (vector? (get value "predicates")))

              (= node "with")
              (and (contains? value "recordUpdate")
                   (not (contains? value "validator"))
                   (or (nil? (get value "recordUpdate"))
                       (valid-record-update-contract?
                         (get value "recordUpdate"))))

              (= node "kw-access")
              (and (contains? value "recordFieldAccess")
                   (or (nil? (get value "recordFieldAccess"))
                       (valid-record-field-access-contract?
                         (get value "recordFieldAccess"))))

              :else true)]
      (and local-ok (map-children-complete? value)))

    :else true))

(defn- checked-projection [(snapshot Any)] Any
  (let [prog (get snapshot "program")
        externs (mapv (fn [(extern Any)] Any
                        {"name" (get extern "name")
                         "type" (get extern "type")})
                  (get prog "externs"))
        base {"kind" "beagle.checked-program"
              "schemaVersion" CHECKED-PROGRAM-SCHEMA-VERSION
              "phase" "checked"
              "target" (get prog "target")
              "namespace" (get prog "namespace")
              "sourceId" (get snapshot "source-id")
              "sourceSha256" (get snapshot "source-sha256")
              "mode" (get prog "mode")
              "gen-class" (get prog "gen-class")
              "requires" (get prog "requires")
              "imports" (get prog "imports")
              "externs" externs
              "forms" (get prog "forms")}]
    (assoc base "projectionSha256" (selfhost.rt/projection-sha256 base))))

(defn- invalid-projection! [(message String)] Any
  (selfhost.rt/eprint (str "beagle [emit-from-ast]: " message "\n"))
  (selfhost.rt/exit 1)
  nil)

(defn- validate-checked-projection! [(target String) (projection Any)] Any
  (cond
    (not (map? projection))
    (invalid-projection! "input must be a checked-program JSON object")

    (not (exact-checked-program-keys? projection))
    (invalid-projection! "checked-program keys do not match the v3 contract")

    (not (= (get projection "kind") "beagle.checked-program"))
    (invalid-projection! "kind must be beagle.checked-program")

    (not (= (get projection "schemaVersion") CHECKED-PROGRAM-SCHEMA-VERSION))
    (invalid-projection! "schemaVersion must be 3")

    (not (= (get projection "phase") "checked"))
    (invalid-projection! "phase must be checked")

    (not (= (get projection "mode") "strict"))
    (invalid-projection! "checked-program mode must be strict")

    (not (= (get projection "target") target))
    (invalid-projection! (str "target mismatch: projection is " (get projection "target")
                           ", command requested " target))

    (not (string? (get projection "namespace")))
    (invalid-projection! "namespace must be a string")

    (not (or (nil? (get projection "sourceId"))
             (string? (get projection "sourceId"))))
    (invalid-projection! "sourceId must be a string or null")

    (not (selfhost.rt/valid-sha256? (get projection "sourceSha256")))
    (invalid-projection! "sourceSha256 must be a lowercase sha256 digest")

    (not (vector? (get projection "requires")))
    (invalid-projection! "requires must be an array")

    (not (and (vector? (get projection "imports"))
              (every? string? (get projection "imports"))))
    (invalid-projection! "imports must be an array of class names")

    (not (vector? (get projection "externs")))
    (invalid-projection! "externs must be an array")

    (not (vector? (get projection "forms")))
    (invalid-projection! "forms must be an array")

    (not (constraint-schema-complete? (get projection "forms")))
    (invalid-projection! "checked-program binding constraint schema is incomplete")

    (not (selfhost.rt/valid-projection-sha256? projection))
    (invalid-projection! "projectionSha256 does not match the canonical checked program")

    :else projection))

(defn- cmd-ast! [(path String) (target String)] Nil
  (let [snapshot (parse-file-target! path target)
        prog (check-or-die! (get snapshot "program"))]
    (println (selfhost.rt/canonical-json
               (checked-projection (assoc snapshot "program" prog))))))

(defn- cmd-check! [(path String) (target String)] Nil
  (check-or-die! (get (parse-file-target! path target) "program"))
  (selfhost.rt/eprint "ok\n"))

(defn- cmd-emit! [(path String) (target String)] Nil
  (print (emit-for-target target
           (check-or-die! (get (parse-file-target! path target) "program")))))

(defn- cmd-emit-from-ast! [(target String)] Nil
  (print (emit-for-target target
           (validate-checked-projection! target
             (selfhost.rt/parse-json (selfhost.rt/read-stdin))))))

;; Extract `--target VALUE` (default clj); returns the first non-flag positional
;; after the command as the path.
(defn- flag-value [(args Any) (flag String) (default String)] String
  (loop [i 0]
    (if (>= i (count args)) default
      (if (and (= (nth args i) flag) (< (+ i 1) (count args)))
        (nth args (+ i 1))
        (recur (+ i 1))))))

(defn- first-positional [(args Any)] String
  (loop [i 1]
    (if (>= i (count args)) ""
      (let [a (nth args i)]
        (cond
          (= a "--target") (recur (+ i 2))
          (str/starts-with? a "--") (recur (+ i 1))
          :else a)))))

(defn -main [& (args (Vec String))] Nil
  (reset! MODULE-SURFACE-CACHE {})
  (reset! MODULE-LOAD-STACK {})
  (let [cmd (if (> (count args) 0) (nth args 0) "")
        target (flag-value args "--target" "clj")
        path (first-positional args)]
    (cond
      (= cmd "ast") (cmd-ast! path target)
      (= cmd "check") (cmd-check! path target)
      (= cmd "emit") (cmd-emit! path target)
      (= cmd "emit-from-ast") (cmd-emit-from-ast! target)
      (= cmd "facts-roundtrip") (fr/run! (rest args))
      :else
        (do (selfhost.rt/eprint "usage: selfhost.main [--target clj|js|nix] ast|check|emit FILE, emit-from-ast < ast.json, or facts-roundtrip MODE FILE\n")
            (selfhost.rt/exit 2)))
    ;; clojure.main flushes *out* in a finally; the gen-class/native-image entry
    ;; bypasses clojure.main, so an unflushed `print` would exit with empty stdout.
    (flush)))
