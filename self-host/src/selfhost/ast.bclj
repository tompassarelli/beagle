#lang beagle/clj
(ns selfhost.ast)

;; Self-hosted AST definitions — matches beagle-lib/private/ast.rkt.
;; AST node constructors, tag utilities, symbol predicates.
;; Uses plain string-keyed maps with a "node" discriminator rather than classes.
(require selfhost.rt)
(declare-extern selfhost.rt/eprint (Fn [String] Nil))

(require clojure.string :as str)

;; --- small string helpers (duplicated per module — PoC pattern) --------------

(defn char-at [(s String) (i Int)] String
  (if (and (>= i 0) (< i (count s))) (subs s i (+ i 1)) ""))

(defn substring2 [(s String) (a Int) (b Int)] String
  (let [n (count s)
        lo (if (< a 0) 0 (if (> a n) n a))
        hi (if (< b lo) lo (if (> b n) n b))]
    (subs s lo hi)))

;; --- tag constants -------------------------------------------------------------

(def BRACKET-TAG String "#%brackets")
(def MAP-TAG String "#%map")
(def SET-TAG String "#%set")

;; --- tag utilities ---------------------------------------------------------------

(defn bracketed? [(d Any)] Bool
  (and (vector? d) (> (count d) 0) (= (nth d 0) BRACKET-TAG)))

(defn bracket-body [(d Any)] Any
  (if (vector? d) (subvec d 1) []))

(defn map-tagged? [(d Any)] Bool
  (and (vector? d) (> (count d) 0) (= (nth d 0) MAP-TAG)))

(defn map-body [(d Any)] Any
  (if (vector? d) (subvec d 1) []))

(defn set-tagged? [(d Any)] Bool
  (and (vector? d) (> (count d) 0) (= (nth d 0) SET-TAG)))

(defn set-body [(d Any)] Any
  (if (vector? d) (subvec d 1) []))

(defn unwrap-items [(d Any) (what String)] Any
  (cond
    (bracketed? d) (bracket-body d)
    (vector? d) d
    :else []))

;; --- symbol predicates -------------------------------------------------------

(defn dot-method-sym? [(sym String)] Bool
  (and (> (count sym) 1) (= (char-at sym 0) ".")))

(defn upper-case-char? [(code Int)] Bool
  (and (>= code 65) (<= code 90)))

(defn qualified-ref? [(ref Any)] Bool
  (and (map? ref)
       (= (get ref "node") "ref")
       (string? (get ref "qualifier"))
       (string? (get ref "name"))))

(defn static-method-ref? [(ref Any)] Bool
  (and (qualified-ref? ref)
       (let [qualifier (get ref "qualifier")]
         (and (> (count qualifier) 0)
              (or (upper-case-char? (int (.charAt qualifier 0)))
                  (= qualifier "js"))))))

(defn dynamic-var-sym? [(sym String)] Bool
  (and (>= (count sym) 3)
       (= (char-at sym 0) "*")
       (= (char-at sym (- (count sym) 1)) "*")))

(defn constructor-sym? [(sym String)] Bool
  (and (> (count sym) 1)
       (upper-case-char? (int (.charAt sym 0)))
       (= (char-at sym (- (count sym) 1)) ".")))

(defn keyword-sym? [(sym String)] Bool
  (and (> (count sym) 1) (= (char-at sym 0) ":")))

;; --- macro-facing immutable syntax objects ----------------------------------
;; These persistent maps mirror the Racket oracle's syntax variants. Reader
;; data remains available only through the explicit beagle-syntax->datum
;; adapter; quoted values stay inert and ordinary tagged strings never become
;; identifiers.

(declare beagle-syntax? syntax-contract-error! structural-name?)

(def SCOPE-COUNTER Any (atom 0))

(defn reset-scope-counter! [] Nil
  (reset! SCOPE-COUNTER 0)
  nil)

(defn fresh-scope-id! [(scope-kind String)] Any
  (let [serial (deref SCOPE-COUNTER)]
    (swap! SCOPE-COUNTER inc)
    {"kind" "scope-id" "serial" serial "scopeKind" scope-kind}))

(defn scope-id? [(value Any)] Bool
  (and (map? value)
       (= (get value "kind") "scope-id")
       (int? (get value "serial"))
       (string? (get value "scopeKind"))))

;; Scope identities are compilation-local. Fresh serials make vector membership
;; identity-preserving without leaking those serials into checked output.
(def EMPTY-SCOPE-SET Any [])

(defn scope-set? [(value Any)] Bool
  (and (vector? value) (every? scope-id? value)))

(defn scope-set-member? [(scopes Any) (scope Any)] Bool
  (contains? (set scopes) scope))

(defn scope-set-add [(scopes Any) (scope Any)] Any
  (if (scope-set-member? scopes scope) scopes (conj (vec scopes) scope)))

(defn scope-set-remove [(scopes Any) (scope Any)] Any
  (filterv (fn [(candidate Any)] Bool (not= candidate scope)) scopes))

(defn scope-set-flip [(scopes Any) (scope Any)] Any
  (if (scope-set-member? scopes scope)
    (scope-set-remove scopes scope)
    (scope-set-add scopes scope)))

(defn scope-set-subset? [(left Any) (right Any)] Bool
  (every? (fn [(scope Any)] Bool (scope-set-member? right scope)) left))

(defn make-binding-id! [(stable String)] Any
  {"kind" "binding-id" "stable" stable})

(defn binding-id? [(value Any)] Bool
  (and (map? value)
       (= (get value "kind") "binding-id")
       (string? (get value "stable"))))

(defn binding-id-stable [(value Any)] String
  (get value "stable"))

(defn make-scope-binding!
  [(id Any) (name Any) (scopes Any) (binding-kind String)] Any
  (when (not (binding-id? id))
    (syntax-contract-error! "make-scope-binding" "id must be a binding id"))
  (when (not (structural-name? name))
    (syntax-contract-error!
      "make-scope-binding" "name must be a structural name"))
  (when (not (scope-set? scopes))
    (syntax-contract-error! "make-scope-binding" "scopes must be a scope set"))
  {"kind" "scope-binding"
   "id" id
   "name" name
   "scopes" scopes
   "bindingKind" binding-kind})

(def EMPTY-BINDING-TABLE Any {})

(defn binding-table-bindings-for [(table Any) (name Any)] Any
  (or (get table name) []))

(defn binding-table-add! [(table Any) (binding Any)] Any
  (let [name (get binding "name")
        scopes (get binding "scopes")
        existing (binding-table-bindings-for table name)
        duplicate
        (first
          (filterv
            (fn [(candidate Any)] Bool
              (= (get candidate "scopes") scopes))
            existing))]
    (when (some? duplicate)
      (syntax-contract-error!
        "binding-table-add"
        "duplicate binding for the same structural name and scope set"))
    (assoc table name (conj (vec existing) binding))))

(defn- proper-scope-subset? [(left Any) (right Any)] Bool
  (and (scope-set-subset? left right) (not= left right)))

(defn resolve-scoped-identifier! [(table Any) (identifier Any)] Any
  (let [name (get identifier "payload")
        use-scopes (get identifier "scopes")
        applicable
        (filterv
          (fn [(candidate Any)] Bool
            (scope-set-subset? (get candidate "scopes") use-scopes))
          (binding-table-bindings-for table name))
        maxima
        (filterv
          (fn [(candidate Any)] Bool
            (not
              (some
                (fn [(other Any)] Any
                  (proper-scope-subset?
                    (get candidate "scopes")
                    (get other "scopes")))
                applicable)))
          applicable)]
    (cond
      (= (count maxima) 0) {"status" "unbound" "name" name}
      (= (count maxima) 1)
        {"status" "resolved" "bindingId" (get (nth maxima 0) "id")}
      :else
        {"status" "ambiguous"
         "name" name
         "bindingIds" (set (mapv (fn [(entry Any)] Any (get entry "id")) maxima))})))

(defn- syntax-contract-error! [(who String) (message String)] Any
  (throw (ex-info (str who ": " message) {})))

(defn make-source-span!
  [(source Any) (start Int) (end Int) (line Int) (column Int)] Any
  (when (or (< start 0) (< end start) (< line 0) (< column 0))
    (syntax-contract-error! "make-source-span" "invalid source range"))
  {"kind" "source-span"
   "source" source
   "start" start
   "end" end
   "line" line
   "column" column})

(defn source-span? [(value Any)] Bool
  (and (map? value) (= (get value "kind") "source-span")))

(defn make-reader-metadata [(source-bytes String) (delimiter Any)] Any
  {"kind" "reader-metadata"
   "sourceBytes" source-bytes
   "delimiter" delimiter})

(defn make-structural-name!
  [(qualifier Any) (leaf String) (provider-id Any)] Any
  (when (or (not (string? leaf)) (= leaf ""))
    (syntax-contract-error! "make-structural-name" "leaf must be a name"))
  {"kind" "structural-name"
   "qualifier" qualifier
   "leaf" leaf
   "providerId" provider-id})

(defn structural-name? [(value Any)] Bool
  (and (map? value)
       (= (get value "kind") "structural-name")
       (string? (get value "leaf"))))

(defn symbol->structural-name! [(symbol String)] Any
  (let [slash (str/index-of symbol "/")]
    (if (and (some? slash) (> slash 0) (< (+ slash 1) (count symbol)))
      (make-structural-name!
        (subs symbol 0 slash)
        (subs symbol (+ slash 1))
        nil)
      (make-structural-name! nil symbol nil))))

(defn structural-name->symbol [(name Any)] String
  (if (some? (get name "qualifier"))
    (str (get name "qualifier") "/" (get name "leaf"))
    (get name "leaf")))

(defn make-expansion-origin! [(macro-id String) (call-span Any) (parent Any)] Any
  (when (and (some? call-span) (not (source-span? call-span)))
    (syntax-contract-error!
      "make-expansion-origin" "call span must be a source span"))
  (when (and (some? parent)
             (not (= (get parent "kind") "expansion-origin")))
    (syntax-contract-error!
      "make-expansion-origin" "parent must be an expansion origin"))
  {"kind" "expansion-origin"
   "macroId" macro-id
   "callSpan" call-span
   "parent" parent})

(defn- ensure-syntax-context!
  [(who String) (span Any) (scopes Any) (origin Any) (properties Any)] Nil
  (when (and (some? span) (not (source-span? span)))
    (syntax-contract-error! who "span must be a source span"))
  (when (not (scope-set? scopes))
    (syntax-contract-error! who "scope set must contain only scope identities"))
  (when (and (some? origin)
             (not (= (get origin "kind") "expansion-origin")))
    (syntax-contract-error! who "origin must be an expansion origin"))
  (when (not (map? properties))
    (syntax-contract-error! who "properties must be a persistent map"))
  nil)

(defn- make-syntax-value!
  [(variant String)
   (payload Any)
   (span Any)
   (scopes Any)
   (origin Any)
   (properties Any)]
  Any
  (ensure-syntax-context! variant span scopes origin properties)
  {"kind" "syntax"
   "variant" variant
   "payload" payload
   "span" span
   "scopes" scopes
   "origin" origin
   "properties" properties})

(defn make-syntax-atom!
  [(datum Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (make-syntax-value! "atom" datum span scopes origin properties))

(defn make-syntax-ident!
  [(name Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (when (not (structural-name? name))
    (syntax-contract-error!
      "make-syntax-ident" "name must be a structural name"))
  (make-syntax-value! "ident" name span scopes origin properties))

(defn make-syntax-list!
  [(children Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (when (or (not (vector? children))
            (not (every? beagle-syntax? children)))
    (syntax-contract-error!
      "make-syntax-list" "children must all be syntax values"))
  (make-syntax-value! "list" children span scopes origin properties))

(defn make-syntax-vector!
  [(children Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (when (or (not (vector? children))
            (not (every? beagle-syntax? children)))
    (syntax-contract-error!
      "make-syntax-vector" "children must all be syntax values"))
  (make-syntax-value! "vector" children span scopes origin properties))

(defn make-syntax-quote!
  [(datum Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (make-syntax-value! "quote" datum span scopes origin properties))

(defn make-syntax-unquote!
  [(child Any)
   (splicing Bool)
   (span Any)
   (scopes Any)
   (origin Any)
   (properties Any)]
  Any
  (when (not (beagle-syntax? child))
    (syntax-contract-error!
      "make-syntax-unquote" "child must be a syntax value"))
  (make-syntax-value!
    (if splicing "unquote-splicing" "unquote")
    child span scopes origin properties))

(defn beagle-syntax? [(value Any)] Bool
  (and (map? value) (= (get value "kind") "syntax")))

(defn beagle-syntax-span [(value Any)] Any (get value "span"))

(defn beagle-syntax-origin [(value Any)] Any (get value "origin"))

(defn beagle-syntax-properties [(value Any)] Any (get value "properties"))

(defn beagle-syntax-property [(value Any) (key String)] Any
  (get (beagle-syntax-properties value) key))

(defn beagle-syntax-scopes [(value Any)] Any (get value "scopes"))

(defn beagle-syntax-binding-id [(value Any)] Any
  (beagle-syntax-property value "binding-id"))

(defn syntax-children [(value Any)] Any
  (let [variant (get value "variant")]
    (if (or (= variant "list") (= variant "vector"))
      (get value "payload")
      [])))

(defn string-literal-datum? [(datum Any)] Bool
  (and (vector? datum)
       (= (count datum) 2)
       (= (nth datum 0) "#%string")))

(defn inert-atom-datum? [(datum Any)] Bool
  (or (string-literal-datum? datum)
      (and (vector? datum)
           (> (count datum) 0)
           (or (= (nth datum 0) "#%regex")
               (= (nth datum 0) "#%char")))))

(defn datum->beagle-syntax!
  [(datum Any) (span Any) (scopes Any) (origin Any) (properties Any)] Any
  (cond
    (beagle-syntax? datum) datum
    (and (string? datum) (not (keyword-sym? datum)))
      (make-syntax-ident!
        (symbol->structural-name! datum) span scopes origin properties)
    (inert-atom-datum? datum)
      (make-syntax-atom! datum span scopes origin properties)
    (and (vector? datum) (= (count datum) 2) (= (nth datum 0) "quote"))
      (make-syntax-quote! (nth datum 1) span scopes origin properties)
    (and (vector? datum)
         (= (count datum) 2)
         (or (= (nth datum 0) "unquote")
             (= (nth datum 0) "unquote-splicing")))
      (make-syntax-unquote!
        (datum->beagle-syntax!
          (nth datum 1) span scopes origin properties)
        (= (nth datum 0) "unquote-splicing")
        span scopes origin properties)
    (bracketed? datum)
      (make-syntax-vector!
        (mapv
          (fn [(child Any)] Any
            (datum->beagle-syntax! child span scopes origin properties))
          (bracket-body datum))
        span scopes origin properties)
    (vector? datum)
      (make-syntax-list!
        (mapv
          (fn [(child Any)] Any
            (datum->beagle-syntax! child span scopes origin properties))
          datum)
        span scopes origin properties)
    :else
      (make-syntax-atom! datum span scopes origin properties)))

(defn beagle-syntax->datum! [(value Any)] Any
  (let [variant (get value "variant") payload (get value "payload")]
    (cond
      (= variant "atom") payload
      (= variant "ident") (structural-name->symbol payload)
      (= variant "list") (mapv beagle-syntax->datum! payload)
      (= variant "vector")
        (into [BRACKET-TAG] (mapv beagle-syntax->datum! payload))
      (= variant "quote") ["quote" payload]
      (= variant "unquote") ["unquote" (beagle-syntax->datum! payload)]
      (= variant "unquote-splicing")
        ["unquote-splicing" (beagle-syntax->datum! payload)]
      :else
        (syntax-contract-error!
          "beagle-syntax->datum" "unknown syntax variant"))))

(defn- restored-syntax [(restorations Any) (value Any)] Any
  (if (nil? restorations)
    nil
    (loop [(entries Any) (deref restorations)]
      (if (= (count entries) 0)
        nil
        (let [entry (nth entries 0)]
          (if (identical? (get entry "flipped") value)
            (get entry "original")
            (recur (subvec (vec entries) 1))))))))

;; Macro input is flipped before evaluation and output is flipped afterward.
;; Exact antiquoted syntax is restored by identity; generated syntax gains the
;; introduction scope on the output flip.
(defn beagle-syntax-flip-scope!
  [(value Any) (scope Any) (restorations Any) (record-original Bool)] Any
  (let [restored
        (if record-original nil (restored-syntax restorations value))]
    (if (some? restored)
      restored
      (let [variant (get value "variant")
            payload (get value "payload")
            span (beagle-syntax-span value)
            scopes (scope-set-flip (beagle-syntax-scopes value) scope)
            origin (beagle-syntax-origin value)
            properties (beagle-syntax-properties value)
            rebuilt
            (cond
              (= variant "atom")
                (make-syntax-atom! payload span scopes origin properties)
              (= variant "ident")
                (make-syntax-ident! payload span scopes origin properties)
              (= variant "list")
                (make-syntax-list!
                  (mapv
                    (fn [(child Any)] Any
                      (beagle-syntax-flip-scope!
                        child scope restorations record-original))
                    payload)
                  span scopes origin properties)
              (= variant "vector")
                (make-syntax-vector!
                  (mapv
                    (fn [(child Any)] Any
                      (beagle-syntax-flip-scope!
                        child scope restorations record-original))
                    payload)
                  span scopes origin properties)
              (= variant "quote")
                (make-syntax-quote! payload span scopes origin properties)
              (= variant "unquote")
                (make-syntax-unquote!
                  (beagle-syntax-flip-scope!
                    payload scope restorations record-original)
                  false span scopes origin properties)
              (= variant "unquote-splicing")
                (make-syntax-unquote!
                  (beagle-syntax-flip-scope!
                    payload scope restorations record-original)
                  true span scopes origin properties)
              :else value)]
        (when (and (some? restorations) record-original)
          (swap! restorations conj {"flipped" rebuilt "original" value}))
        rebuilt))))

(defn introduced-binding-id? [(id Any)] Bool
  (and (string? id) (str/starts-with? id "introduced-")))

(defn binding-id-output-name [(id Any) (authored-name String)] String
  (if (not (introduced-binding-id? id))
    authored-name
    (let [parts (str/split id #":")
          reversed (vec (reverse parts))
          path (if (> (count reversed) 1) (nth reversed 1) "0")
          clean-path (str/replace path #"[^0-9]+" "_")]
      (str authored-name "__scope_" clean-path))))

;; Checked AST keeps authored spellings and lexical edges. Target emitters call
;; this pure projection once, immediately before rendering, so only introduced
;; identities receive collision-proof output spellings.
(defn lower-binding-target-output [(target Any) (identities Any)] Any
  (cond
    (string? target)
      (binding-id-output-name (get identities target) target)
    (not (map? target)) target
    (= (get target "type") "map-destructure")
      (let [lower-name
            (fn [(name Any)] Any
              (if (string? name)
                (binding-id-output-name (get identities name) name)
                name))]
        (assoc
          (assoc
            (assoc target "keys" (mapv lower-name (get target "keys")))
            "as" (lower-name (get target "as")))
          "or"
          (mapv
            (fn [(entry Any)] Any
              (assoc entry "key" (lower-name (get entry "key"))))
            (get target "or"))))
    (= (get target "type") "seq-destructure")
      (assoc
        (assoc target "names"
          (mapv
            (fn [(name Any)] Any
              (lower-binding-target-output name identities))
            (get target "names")))
        "rest"
        (lower-binding-target-output (get target "rest") identities))
    :else target))

(defn lower-binding-output-identities [(value Any)] Any
  (cond
    (vector? value) (mapv lower-binding-output-identities value)
    (not (map? value)) value
    :else
      (let [lowered
            (reduce
              (fn [(out Any) (key Any)] Any
                (assoc out key
                  (lower-binding-output-identities (get value key))))
              {}
              (keys value))
            direct (get lowered "bindingId")
            identities (get lowered "bindingIds")
            node (get lowered "node")
            kind (get lowered "type")]
        (cond
          (and (= node "ref") (string? (get lowered "refersTo")))
            (assoc lowered "name"
              (binding-id-output-name
                (get lowered "refersTo") (get lowered "name")))
          (and (string? direct) (string? (get lowered "name")))
            (assoc lowered "name"
              (binding-id-output-name direct (get lowered "name")))
          (and (string? direct) (string? (get lowered "err")))
            (assoc lowered "err"
              (binding-id-output-name direct (get lowered "err")))
          (not (map? identities)) lowered
          (= kind "record")
            (assoc lowered "bindings"
              (mapv
                (fn [(binding Any)] Any
                  (assoc binding "name"
                    (binding-id-output-name
                      (get identities (get binding "name"))
                      (get binding "name"))))
                (get lowered "bindings")))
          (= kind "map")
            (assoc lowered "entries"
              (mapv
                (fn [(entry Any)] Any
                  (assoc entry "name"
                    (binding-id-output-name
                      (get identities (get entry "name"))
                      (get entry "name"))))
                (get lowered "entries")))
          (contains? lowered "name")
            (assoc lowered "name"
              (lower-binding-target-output (get lowered "name") identities))
          :else lowered))))

;; --- AST node constructors ---------------------------------------------------
;; Each returns a plain string-keyed map with a "node" discriminator matching
;; ast-json.rkt.

(defn make-ns-decl [(name String)] Any
  {"node" "ns" "name" name})

(defn make-def [(name String) (ann Any) (value Any)] Any
  {"node" "def" "name" name "ann" ann "value" value})

(defn make-defonce [(name String) (ann Any) (value Any)] Any
  {"node" "defonce" "name" name "ann" ann "value" value})

(defn make-defn
  [(name String)
   (params (Vec Any))
   (rest-param Any)
   (ret Any)
   (body (Vec Any))
   (private- Bool)]
  Any
  {"node" "defn" "name" name "params" params "rest-param" rest-param
   "ret" ret "body" body "private" private-})

(defn make-defn-multi [(name String) (arities (Vec Any)) (private- Bool)] Any
  {"node" "defn-multi" "name" name "arities" arities "private" private-})

(defn make-fn
  [(params (Vec Any)) (rest-param Any) (ret Any) (body (Vec Any))] Any
  {"node" "fn" "params" params "rest-param" rest-param "ret" ret "body" body})

(defn make-let [(bindings (Vec Any)) (body (Vec Any))] Any
  {"node" "let" "bindings" bindings "body" body})

(defn make-if [(test Any) (then-expr Any) (else-expr Any)] Any
  {"node" "if" "test" test "then" then-expr "else" else-expr})

(defn make-cond [(clauses (Vec Any))] Any
  {"node" "cond" "clauses" clauses})

(defn make-when [(test Any) (body (Vec Any))] Any
  {"node" "when" "test" test "body" body})

(defn make-do [(body (Vec Any))] Any
  {"node" "do" "body" body})

(defn make-call [(fn-name Any) (args (Vec Any))] Any
  {"node" "call" "fn" fn-name "args" args})

(defn make-qualified-ref
  [(qualifier String) (name String) (provider-id Any)] Any
  {"node" "ref" "qualifier" qualifier "name" name
   "providerId" provider-id})

(defn make-ref [(name String)] Any
  {"node" "ref" "name" name})

(defn make-literal [(kind String) (value Any)] Any
  {"node" "literal" "kind" kind "value" value})

(defn make-vec [(items (Vec Any))] Any
  {"node" "vec" "items" items})

(defn make-quoted [(datum Any)] Any
  {"node" "quoted" "datum" datum})

(defn make-unsafe [(code String)] Any
  {"node" "unsafe" "code" code})

(defn make-regex [(pattern String)] Any
  {"node" "regex" "pattern" pattern})

(defn make-loop [(bindings (Vec Any)) (body (Vec Any))] Any
  {"node" "loop" "bindings" bindings "body" body})

(defn make-recur [(args (Vec Any))] Any
  {"node" "recur" "args" args})

(defn make-for [(clauses (Vec Any)) (body Any)] Any
  {"node" "for" "clauses" clauses "body" body})

(defn make-record [(name String) (fields (Vec Any))] Any
  {"node" "record" "name" name "fields" fields})

(defn make-method-call [(method String) (target Any) (args (Vec Any))] Any
  {"node" "method-call" "method" method "target" target "args" args})

(defn make-static-call [(class-method Any) (args (Vec Any))] Any
