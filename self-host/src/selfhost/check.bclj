                               (make-app "HVec" [(make-prim "Int") (make-prim "String")]))]
                            (make-prim "String")
                            [(make-ref "x")])])]
      (> (get (type-check! prog) "count") 0)))
  (expect! "destructure: HVec arity mismatch rejected"
