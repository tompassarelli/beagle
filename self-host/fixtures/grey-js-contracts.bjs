#lang beagle/js
(ns selfhost.fixtures.grey-js-contracts)

(defmacro typed-pair []
  [7 "north"])

(defn canonical-prefix [(value String)] String
  (js/call (js/call value .trim) .slice 0 5))

(defn typed-index [(value String)] Int
  (js/call value .indexOf "north"))

(def absolute-count Int
  (js/call Math .abs -7))

(def absolute-distance Float
  (js/call Math .abs -7.5))

(def sine Float
  (js/call Math .sin 0.5))

(def cosine Float
  (js/call Math .cos 0.5))

(def arctangent Float
  (js/call Math .atan 0.5))

(def arctangent-two Float
  (js/call Math .atan2 0.5 1.0))

(def exponential Float
  (js/call Math .exp 0.5))

(def minimum Float
  (js/call Math .min 0.5 1.0))

(def maximum Int
  (js/call Math .max 1 2))

(def map-size Int
  (let [values (js/new Map)]
    (js/get values .size)))

(defn string-index [] (JsMap String Int)
  (js/new Map))

(defn map-lookup
  [(values (JsMap String Int))
   (key String)]
  (U Int Nil)
  (js/call values .get key))

(defn map-insert
  [(values (JsMap String Int))
   (key String)
   (value Int)]
  (JsMap String Int)
  (js/call values .set key value))

(def tangent Float
  (js/call Math .tan 0.5))

(def wall-clock Int
  (js/call Date .now))

(def monotonic-clock Float
  (js/call performance .now))

(def ceiling Int
  (js/call Math .ceil 1.5))

(def circle-ratio Float
  (js/get Math .PI))

(defn pointer-x [(event JsPointerEvent)] Float
  (js/get event .clientX))

(defn canvas-left [(canvas JsCanvas)] Float
  (js/get (js/call canvas .getBoundingClientRect) .left))

(def mixed-ratio Float
  (/ 3 2.0))

(def reversed-mixed-ratio Float
  (/ 3.0 2))

(def integer-range (List Int)
  (range 0 4))

(defn pair-first [] Int
  (let [(pair (HVec Int String)) (typed-pair)]
    (nth pair 0)))
