#lang beagle/js
(ns selfhost.fixtures.grey-js-contracts)

(defmacro typed-pair []
  [7 "north"])

(defn canonical-prefix [(value String)] String
  (.slice (.trim value) 0 5))

(defn typed-index [(value String)] Int
  (.indexOf value "north"))

(def absolute-count Int
  (.abs Math -7))

(def absolute-distance Float
  (.abs Math -7.5))

(def sine Float
  (.sin Math 0.5))

(def cosine Float
  (.cos Math 0.5))

(def arctangent Float
  (.atan Math 0.5))

(def arctangent-two Float
  (.atan2 Math 0.5 1.0))

(def exponential Float
  (.exp Math 0.5))

(def minimum Float
  (.min Math 0.5 1.0))

(def maximum Int
  (.max Math 1 2))

(def map-size Int
  (let [(values (JsMap Any Any)) (new Map)]
    (.size values)))

(defn string-index [] (JsMap String Int)
  (new Map))

(defn map-lookup
  [(values (JsMap String Int))
   (key String)]
  (U Int Nil)
  (.get values key))

(defn map-insert
  [(values (JsMap String Int))
   (key String)
   (value Int)]
  (JsMap String Int)
  (.set values key value))

(def tangent Float
  (.tan Math 0.5))

(def wall-clock Int
  (.now Date))

(def monotonic-clock Float
  (.now performance))

(def ceiling Int
  (.ceil Math 1.5))

(def circle-ratio Float
  (.PI Math))

(defn pointer-x [(event JsPointerEvent)] Float
  (.clientX event))

(defn canvas-left [(canvas JsCanvas)] Float
  (.-left (.getBoundingClientRect canvas)))

(def mixed-ratio Float
  (/ 3 2.0))

(def reversed-mixed-ratio Float
  (/ 3.0 2))

(def integer-range (List Int)
  (range 0 4))

(defn pair-first [] Int
  (let [(pair (HVec Int String)) (typed-pair)]
    (nth pair 0)))
