#lang beagle/js
(ns selfhost.fixtures.grey-second-order-state)

(defrecord Prepared [(ticket Int)])
(defrecord Holder [(prepared (Atom (U Prepared Nil)))])
(defalias RenderOrigin (HVec Float Float Float))

(defn write-concrete! [(cell (Atom Any))] Any
  (reset! cell 1))

(defn fresh-holder [] Holder
  (->Holder (atom nil)))

(defn clear-prepared! [(cell (Atom (U Prepared Nil)))] Nil
  (do (reset! cell nil) nil))

(defn clear-fresh! [] Nil
  (clear-prepared! (atom nil)))

(defn consume-origin [(origin (Atom (U RenderOrigin Nil)))] Nil
  nil)

(defn fresh-origin [] Nil
  (consume-origin (atom [0.0 0.0 0.0])))

(defn count-to-one [] Int
  (loop [(value Int) 0]
    (if (< value 1)
      (recur (+ value 1))
      value)))

(defn maybe-pair [(ready? Bool)] (U (HVec Int String) Nil)
  (if ready?
    (let [(pair (HVec Int String)) [1 "ready"]]
      pair)
    nil))

(defn maybe-first [(ready? Bool)] Int
  (let [pair (maybe-pair ready?)]
    (if (nil? pair) -1 (nth pair 0))))
