#lang beagle/clj
(ns fixtures.invalid.absent-provider)

;; fixtures.absent.geom is declared by no bundle member and provided by no
;; module root. Only an ancestor-walking resolver with a flat-basename
;; fallback can satisfy it (../geom.bclj), and a silently-skipping resolver
;; accepts it as Any. Closed resolution must reject with exit 1 on both
;; compilers; an accept here is the fail-open divergence this fixture guards.
(require fixtures.absent.geom :as g)

(defn use-absent [] Any
  (g/origin))
