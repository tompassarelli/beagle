#lang beagle/clj
(ns selfhost.fixtures.purity.transient-lifetime-reject)

(def global-owned Any (transient []))

(defn borrowed [(value Any)] Any
  (conj! value 1))

(defn global-mutation [] Any
  (conj! global-owned 1))

(defn consumed-in-one-branch [(condition Bool) (xs Any)] Any
  (let [owned (transient xs)]
    (if condition
      (persistent! owned)
      nil)
    (conj! owned 1)
    (persistent! owned)))

(defn shadowed-allocator [(transient Any) (xs Any)] Any
  (let [owned (transient xs)]
    (conj! owned 1)
    (persistent! owned)))

(defn shadowed-owner [(xs Any)] Any
  (let [owned (transient xs)]
    (let [owned xs]
      (conj! owned 1))
    (persistent! owned)))
