#lang beagle/js

(ns declarations.provider)

(defalias PublicLabel String)

(defrecord Draft
  [id PublicLabel
   tags (Vec String)])

(defrecord Accepted [draft Draft])
(defrecord Rejected [reason (U String Nil)])
(defunion Result Accepted Rejected)

(declare-extern chooseImpl
  (U (Fn [JsObject] JsObject)
     (Fn [JsObject Bool] JsObject)))

(declare-extern ProviderCatalogFileCacheImpl
  (Fn [(U JsObject Nil) (U Int Nil)] JsObject))

(declare-extern BridgeWireSessionImpl
  (Fn [JsObject JsObject JsObject (U JsObject Nil)] JsObject))

(declare-extern BridgeProviderTeardownTimeoutErrorImpl
  (Fn [Int] JsObject))

(js/declare-record PublicAccepted
  [status (js/literal "accepted")
   note (js/optional String)])

(js/declare-record PublicRejected
  [status (js/literal "rejected")
   reason String])

(js/declare-type PublicLabel (js/enum "one" "two"))

(js/declare-record PublicDraft
  [id String
   label PublicLabel])

(js/declare-type PublicResult
  (U PublicAccepted PublicRejected))

(js/declare-record ProviderCatalogFileReader
  [identity (Fn [String] JsObject)
   read (Fn [String] String)])

(js/declare-record (ProviderCatalogFileCache T)
  [load (Fn [String (Fn [String] T)] T)])

(js/declare-type WireEvent declarations.events/WireEvent)
(js/declare-type WireEventWriter declarations.writer/WireEventWriter)
(js/declare-record WireQuery [])
(js/declare-record AbortController [])
(js/declare-record AbortSignal [])

(js/declare-record BridgeSessionPresentation
  [cwd String])

(js/declare-record BridgeProviderSession
  [presentation (js/optional BridgeSessionPresentation)
   submitInput (Fn [String] (Promise (js/void)))
   interruptTurn (Fn [] (Promise (js/void)))
   terminateSession (Fn [] (Promise (js/void)))
   forceTerminateSession (js/optional (Fn [] (js/void)))
   events (Fn [] (AsyncIterable WireEvent))])

(js/declare-record BridgeProviderTeardownTimeoutError
  [name String
   message String])

(js/export (def LABELS (Vec String) ["one" "two"]))
(js/declare-export LABELS (Vec PublicLabel))
(js/export
  (def choose
    (U (Fn [JsObject] JsObject)
       (Fn [JsObject Bool] JsObject))
    chooseImpl))

(js/declare-export choose
  (U (Fn [PublicDraft] PublicResult)
     (Fn [PublicDraft Bool] PublicResult)))

(js/export
  (defn maybeLabel [label (U String Nil)] (U String Nil) label))

(js/declare-export maybeLabel
  (Fn [(js/optional String)] (js/optional String)))

(js/export
  (def ProviderCatalogFileCache
    (Fn [(U JsObject Nil) (U Int Nil)] JsObject)
    ProviderCatalogFileCacheImpl))

(js/declare-export ProviderCatalogFileCache
  (js/constructor
    (forall [T]
      (Fn [(js/optional ProviderCatalogFileReader)
           (js/optional Int)]
        (ProviderCatalogFileCache T)))))

(js/export
  (def BridgeWireSession
    (Fn [JsObject JsObject JsObject (U JsObject Nil)] JsObject)
    BridgeWireSessionImpl))

(js/declare-export BridgeWireSession
  (js/constructor
    (Fn [WireQuery AbortController AbortSignal
         (js/optional BridgeSessionPresentation)]
      BridgeProviderSession)))

(js/export
  (def BridgeProviderTeardownTimeoutError
    (Fn [Int] JsObject)
    BridgeProviderTeardownTimeoutErrorImpl))

(js/declare-export BridgeProviderTeardownTimeoutError
  (js/constructor
    (Fn [Int] BridgeProviderTeardownTimeoutError)))
