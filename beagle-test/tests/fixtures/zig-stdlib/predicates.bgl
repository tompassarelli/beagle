(ns zig-stdlib.predicates)

(def DIGIT: Regex (re-pattern "[0-9]"))
(def VALUES: (Vec String) ["x"])

(defn map-value? [record: (Map Keyword String)] -> Bool
  (map? record))

(defn main [] -> Nil
  (println
    (str
      (boolean (re-matches DIGIT "7")) ":"
      (string? "fram") ":"
      (map-value? {:name "fram"}) ":"
      (sequential? VALUES) ":"
      (int? 7) ":"
      (integer? 7))))
