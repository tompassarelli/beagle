#lang beagle/clj

;; Same unhanded provider, called with the wrong argument type. This is what
;; proves the provider's INTERFACE actually loaded rather than the alias being
;; accepted as a phantom: a phantom types every call at Any and reports nothing.
(ns modres.consumer-bad)
(require [modres.wire-format :as wf])

(defn go [] String (wf/encode "not-an-int"))
