#lang beagle/clj

;; A variant pattern over an imported union binds the FIELD, so `height` is
;; String and returning it as Int must fail naming the FIELD type. While the
;; require went unresolved the binder took the constructor type instead, and
;; this same source failed with "got Circle" — blaming the variant, not the field.
(ns xmod.unhanded-field-type)
(require xmod.shape-kinds :as p)

(defn wrong [s p/Shape] Int
  (match s
    [(Circle radius) radius]
    [(Rect width height) height]))
