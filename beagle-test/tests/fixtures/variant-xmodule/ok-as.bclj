#lang beagle/clj

;; `:as` import: qualified constructor and accessor are TYPED, and a variant
;; pattern binds the FIELD positionally — same as a same-module defunion.
(require prov :as p)

(defn area [(s p/Shape)] Int
  (match s
    [(Circle r) r]
    [(Rect w h) w]))

(defn second-field [(s p/Shape)] String
  (match s
    [(Circle r) "circle"]
    [(Rect w h) h]))

(defn build [] Int
  (p/circle-radius (p/->Circle 3)))

(defn flagged [(f p/Flag)] Int
  (match f
    [(On) 1]
    [(Off) 0]))
