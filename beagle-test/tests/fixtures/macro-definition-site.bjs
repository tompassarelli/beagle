#lang beagle/js
(ns macro-definition-site)

(defmacro define-box [name value]
  `(def ~name Box
     (->Box (normalize ~value))))

;; The exported macro expands to these references in the consumer, so they
;; must cross the js module boundary with it.
(js/export (defrecord Box [(value String)]))

(js/export
  (defn normalize [(value String)] String
    value))
