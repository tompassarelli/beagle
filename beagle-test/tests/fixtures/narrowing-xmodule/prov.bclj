#lang beagle/clj

;; Provider for the cross-module scrutinee-narrowing tests: narrowing must reach
;; an IMPORTED member exactly as it reaches a same-module one.

(defunion Shape
  (Circle [radius: Int])
  (Rect
    [width: Int
     height: String]))

(defunion (Result T E)
  (Ok [value: T])
  (Err [error: E]))
