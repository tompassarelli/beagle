#lang beagle/js
(ns wake.dsl)

(defrecord FieldDeclaration [name: String type-name: String])

(defrecord EntityDeclaration
  [name: String
   fields: (Vec FieldDeclaration)])

(defmacro entity [name fields]
  (let [field-declarations
        (map
          (fn [field]
            `(->FieldDeclaration
               ~(symbol->string (syntax-name field))
               ~(symbol->string (syntax-type field))))
          (partition 3 fields))]
    `(def ~name: EntityDeclaration
       (->EntityDeclaration
         ~(symbol->string name)
         [~@field-declarations]))))
