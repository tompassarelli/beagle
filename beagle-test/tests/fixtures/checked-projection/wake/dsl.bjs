#lang beagle/js
(ns wake.dsl)

;; The exported entity macro expands to these constructors in the consumer,
;; so the records must cross the js module boundary with it.
(js/export
  (defrecord FieldDeclaration [(name String) (type-name String)]))

(js/export
  (defrecord EntityDeclaration
    [(name String)
     (fields (Vec FieldDeclaration))]))

(defmacro entity [name fields]
  (let [field-declarations
        (map
          (fn [field] Any
            `(->FieldDeclaration
               ~(symbol->string (syntax-name field))
               ~(symbol->string (syntax-type field))))
          fields)]
    `(def ~name EntityDeclaration
       (->EntityDeclaration
         ~(symbol->string name)
         [~@field-declarations]))))
