#lang beagle/js

(ns js-array-methods)

(defn push-one
  [xs (Vec Int)
   x Int] Int
  (js/call xs .push x))

(defn pop-last [xs (Vec Int)] Int
  (js/call xs .pop))

(defn first-idx
  [xs (Vec Int)
   target Int] Int
  (js/call xs .indexOf target))

(defn includes?
  [xs (Vec Int)
   target Int] Bool
  (js/call xs .includes target))

(defn joined [xs (Vec String)] String
  (js/call xs .join ", "))

(defn sliced
  [xs (Vec Int)
   start Int
   end Int] (Vec Int)
  (js/call xs .slice start end))

(defn reversed [xs (Vec Int)] (Vec Int)
  (js/call xs .reverse))

(defn concatenated
  [a (Vec Int)
   b (Vec Int)] (Vec Int)
  (js/call a .concat b))
