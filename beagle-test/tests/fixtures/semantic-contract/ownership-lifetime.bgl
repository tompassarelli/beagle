(ns semantic-contract.ownership-lifetime)

(defrecord Cell [value: Int])
(defrecord World [cell: Cell score: Int])

(defn borrowed-score [world: World] -> Int
  (:score world))

(defn world-tick [ctx: Ctx world: World] -> World
  (->World
   (->Cell (inc (:value (:cell world))))
   (inc (borrowed-score world))))

(defn observe [ctx: Ctx] -> Int
  (let [next (world-tick ctx (->World (->Cell 4) 10))]
    (+ (:value (:cell next)) (:score next))))
