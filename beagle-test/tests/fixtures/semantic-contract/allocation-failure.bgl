(ns semantic-contract.allocation-failure)

(defn map-abort [xs: (Vec Int)] -> (Vec Int)
  (mapv (fn [x: Int] -> Int (inc x)) xs))

(defn map-fallible
  [ctx: Ctx
   xs: (Vec Int)] -> (Vec Int)
  :raises AllocationError
  (mapv (fn [x: Int] -> Int (inc x)) xs))

(defn string-abort
  [left: String
   right: String] -> String
  (str left right))
