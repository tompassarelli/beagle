(ns semantic-contract.closed-dynamic)

(defn dyn-string [value :- String] :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn dyn-int [value :- Int] :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn dyn-bool [value :- Bool] :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn dyn-vector [value :- (Vec String)] :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn dyn-map [value :- (Map String Int)] :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn round-trip [value :- (Dyn String Int Bool (Vec String) (Map String Int))]
  :- (Dyn String Int Bool (Vec String) (Map String Int))
  value)

(defn observe [value :- (Dyn String Int Bool (Vec String) (Map String Int))] :- String
  (if (string? value)
    (str "string:" value)
    (if (integer? value)
      (str "int:" value)
      (if (boolean? value)
        (str "bool:" value)
        (if (vector? value)
          (str "vec:" (count value))
          (if (map? value)
            (str "map:" (count value))
            "unreachable"))))))
