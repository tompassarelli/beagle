(ns semantic-contract.typed-errors)

(defunion :throwable RewriteError
  (RewriteFailure
    [message: String
     path: String
     refusal: Bool]))

(defn classify
  [missing: Bool
   mismatch: Bool
   path: String] -> String
  :raises RewriteError
  (cond
    missing
    (throw
      (ex-info
        "missing"
        {:path path :refusal true}))
    mismatch
    (throw
      (ex-info
        "mismatch"
        {:path path :refusal true}))
    :else
    "roll-back"))

(defn propagate
  [missing: Bool
   mismatch: Bool
   path: String] -> String
  :raises RewriteError
  (check (classify missing mismatch path)))

(defn render
  [missing: Bool
   mismatch: Bool
   path: String] -> String
  (rescue
    (classify missing mismatch path)
    err
    (:message err)))
