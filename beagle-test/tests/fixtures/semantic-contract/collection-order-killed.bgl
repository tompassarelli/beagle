(ns semantic-contract.collection-order-killed)

(defn key-set-matches [record :- (Map Keyword Int)] :- Bool
  (let [expected :- (Set Keyword) #{:alpha :beta}]
    (= expected (set (keys record)))))

(defn key-count [record :- (Map Keyword Int)] :- Int
  (count (keys record)))

(defn values-empty? [record :- (Map Keyword Int)] :- Bool
  (empty? (vals record)))

(defn key-present? [record :- (Map Keyword Int)] :- Bool
  (contains? (set (keys record)) :alpha))
