(ns zig-closed-union-map-key)

(define-mode strict)

(defn text-key [value :- String] :- (Dyn String Int)
  value)

(defn int-key [value :- Int] :- (Dyn String Int)
  value)

(defn exercise [] :- Int
  (let [entries :- (Map (Dyn String Int) Int)
        {(text-key "7") 1
         (text-key (str "" "7")) 2
         (int-key 7) 3}]
    (count entries)))
