#lang beagle/js

(ns js-stdlib-statics)

(defn parse-config [s String] Any
  (js/call JSON .parse s))

(defn to-config [obj Any] String
  (js/call JSON .stringify obj))

(defn floor-of [x Float] Int
  (js/call Math .floor x))

(defn sqrt-of [x Float] Float
  (js/call Math .sqrt x))

(defn pow-of
  [x Float
   y Float] Float
  (js/call Math .pow x y))

(defn random-float [] Float
  (js/call Math .random))

(defn pi-times [n Float] Float
  (* (js/get Math .PI) n))

(defn integer? [x Any] Bool
  (js/call Number .isInteger x))

(defn nan? [x Any] Bool
  (js/call Number .isNaN x))

(defn parse-int [s String] Int
  (js/call Number .parseInt s))
