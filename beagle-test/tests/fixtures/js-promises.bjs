#lang beagle/js

(ns js-promises)

(defrecord FetchResponse [text (Fn [] (Promise String))])

(declare-extern fetch (Fn [String] (Promise FetchResponse)))
(declare-extern parse-json (Fn [String] Any))

(defn ^:async fetch-text [url String] (Promise String)
  (let [resp (await (fetch url))]
    (await (.text resp))))

(defn ^:async fetch-and-parse [url String] (Promise Any)
  (let [text (await (fetch-text url))]
    (parse-json text)))

(defn ^:async fetch-both
  [a String
   b String] (Promise (Vec String))
  (let [ta (await (fetch-text a))
        tb (await (fetch-text b))]
    [ta tb]))

(defn resolve-now [x Int] (Promise Int)
  (.resolve Promise x))

(defn reject-with [msg String] (Promise Nil)
  (.reject Promise msg))

(defn all-of [promises (Vec (Promise Int))] (Promise (Vec Int))
  (.all Promise promises))

(defn race-of [promises (Vec (Promise Int))] (Promise Int)
  (.race Promise promises))
