#lang beagle/js
(ns export-xmodule.provider)

(js/export
  (defn scale
    [x Float
     k Float] Float
    (* x k)))

(js/export
  (defrecord Pos
    [x Float
     z Float]))

(js/export
  (defunion JsonEvent
    (JsonObjectStart [offset Int])
    (JsonObjectEnd [offset Int])))

(defn internal [x Float] Float (+ x 1.0))

(def hidden-offset Float 0.5)

(js/export (def cell Any (atom nil)))
