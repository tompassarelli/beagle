#lang beagle/js
(ns export-xmodule.refconsumer
  (:require [export-xmodule.provider :as p]))

;; A qualified name used as a VALUE, not called — read and written through a
;; property access.
(js/export
  (defn peek-it [] -> Any (.-value p/cell)))

(js/export
  (defn poke-it [v: Any] -> Nil (do (set! (.-value p/cell) v) nil)))
