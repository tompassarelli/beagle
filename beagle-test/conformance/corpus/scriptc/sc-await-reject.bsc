#lang beagle/scriptc
;; RATCHET FIXTURE — js/await under the scriptc target.
;; Upstream ScriptC compiles async/await statically with native stdout/exit
;; parity, so this JS-family form is implementation scope, not a host limit.
;; The target-family gate that once rejected js/await here is CLOSED (check.rkt
;; admits it for scriptc); the row now fails one layer deeper, on the
;; (Promise Int) boundary type in emit-scriptc's validator.
;; Classified :bug; delete the entry once Promise-typed boundaries are admitted.
(ns conformance.sc-await-reject)

(declare-extern host-fetch [Int -> (Promise Int)])

(defn load-doubled [(id :- Int)] :- (Promise Int)
  (let [n (js/await (host-fetch id))]
    (* n 2)))

(println "await row")
