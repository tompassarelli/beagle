#lang beagle/scriptc
;; RATCHET FIXTURE — D7-comment-unpointed.
;; A target-neutral top-level `(comment ...)` reads as nil and the ScriptC
;; validator rejects it as an unsupported top-level form. Classified :bug;
;; delete the entry once comments are erased/accepted for ScriptC.
(ns conformance.sc-comment-neutral)

(comment "target-neutral commentary is not a program form")

(defn identity-int [(x :- Int)] :- Int
  x)

(println (identity-int 7))
