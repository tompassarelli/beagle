#lang beagle/scriptc
;; RATCHET FIXTURE — D2-inner-fn-untyped.
;; A typed `fn` bound inside a defn must preserve its inferred/declared
;; TypeScript boundary instead of emitting an implicit-any arrow parameter.
(ns conformance.sc-inner-fn)

(defn apply-twice [(x: Int)] -> Int
  (let [bump (fn [n: Int] -> Int (+ n 1))]
    (bump (bump x))))

(println (apply-twice 40))
