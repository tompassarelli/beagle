#lang beagle/scriptc
;; RATCHET FIXTURE — D3-declare-extern.
;; `declare-extern` states a host contract but emits no ambient declaration, so
;; the reference is an unresolved bare identifier under ScriptC's tsc (SC0001).
;; Classified :bug; delete the entry once the ambient declaration contract lands.
(ns conformance.sc-extern)

(declare-extern host-parse [String -> Int])

(defn parse-or-zero [(s :- String)] :- Int
  (host-parse s))

(println (parse-or-zero "17"))
