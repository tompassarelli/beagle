#lang beagle/scriptc
;; RATCHET FIXTURE — D3-declare-extern.
;; `declare-extern` renders a module-local inline ambient declaration before
;; executable statements. It is compile-time-only and has no .d.ts sidecar.
(ns conformance.sc-extern)

(declare-extern host-parse [String -> Int])

(defn parse-or-zero [(s: String)] -> Int
  (host-parse s))

(println (parse-or-zero "17"))
