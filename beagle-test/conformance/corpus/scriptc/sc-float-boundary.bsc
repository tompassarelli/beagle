#lang beagle/scriptc
;; Float boundary: Beagle Float lowers to TypeScript `number` (f64-backed).
;; native row: golden TS + 100% ScriptC static coverage + Node/native parity.
(ns conformance.sc-float-boundary)

(defn half [(x :- Float)] :- Float
  (/ x 2.0))

(defn area [(r :- Float)] :- Float
  (* 3.14 (* r r)))

(println (half 5.0))
(println (area 2.0))
