#lang beagle/scriptc
;; Typed primitive arithmetic across the ScriptC boundary.
;; native row: golden TS + 100% ScriptC static coverage + Node/native parity.
(ns conformance.sc-defn-arith)

(defn add [(x: Int) (y: Int)] -> Int
  (+ x y))

(defn scale [(x: Int) (factor: Int)] -> Int
  (* (add x 1) factor))

(println (add 20 22))
(println (scale 6 7))
