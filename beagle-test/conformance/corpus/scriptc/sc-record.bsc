#lang beagle/scriptc
;; RATCHET FIXTURE — records are not admitted by the ScriptC validator.
;; `defrecord` is a target-neutral form ScriptC can host (TypeScript records are
;; 35/35 static upstream), but the validator admits only defn and calls at the
;; top level. Classified :bug; delete the entry once typed record lowering and
;; admission land.
(ns conformance.sc-record)

(defrecord Point [(x: Int) (y: Int)])

(defn manhattan [(p: Point)] -> Int
  (+ (point-x p) (point-y p)))

(println (manhattan (->Point 3 4)))
