#lang beagle/scriptc
;; RATCHET FIXTURE — map/set literals are not admitted by the ScriptC validator.
;; Upstream ScriptC compiles Map at 50/50 and Set at 47/47 statically, so this is
;; a Beagle admission gap, not a host limit. Classified :bug; delete the entry
;; once the validator admits them and native semantics are proven.
(ns conformance.sc-map-set-literal)

(def sizes: (Map String Int) {"a" 1 "b" 2})

(def flags: (Set Int) #{1 2 3})

(println (count sizes))
(println (count flags))
