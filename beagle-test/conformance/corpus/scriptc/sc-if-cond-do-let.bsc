#lang beagle/scriptc
;; Control-flow core: if / cond / do / let over typed boundaries.
;; native row: golden TS + 100% ScriptC static coverage + Node/native parity.
(ns conformance.sc-if-cond-do-let)

(defn classify [(n: Int)] -> String
  (cond
    (< n 0) "negative"
    (< n 1) "zero"
    :else "positive"))

(defn clamped [(n: Int)] -> Int
  (let [lo 0
        hi 10]
    (do
      (if (< n lo) lo (if (< hi n) hi n)))))

(println (classify -5))
(println (classify 0))
(println (classify 42))
(println (clamped -3))
(println (clamped 25))
