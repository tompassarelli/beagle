#lang beagle/js

(ns store.cli-js)

;; The bridge is the irreducible Bun/RPC boundary. Command grammar, dispatch,
;; human syntax, rendering, and exit classification stay in this typed module.

(declare-extern host-call (Fn [Any String Any] (Promise Any)))
(declare-extern host-get (Fn [Any Any] Any))
(declare-extern host-error-field (Fn [Any String] String))
(declare-extern host-store-rpc-error? (Fn [Any] Bool))

(defn delimiter? [ch String] Bool
  (or (= ch " ") (= ch "\n") (= ch "\r") (= ch "\t")
      (= ch ",") (= ch "[") (= ch "]") (= ch "{") (= ch "}")
      (= ch "(") (= ch ")")))

(defn token-end
  [text String
   start Int] Int
  (loop [index Int start]
    (if (or (>= index (count text))
            (delimiter? (subs text index (+ index 1))))
      index
      (recur (+ index 1)))))

(defn edn-whitespace? [ch String] Bool
  (or (= ch " ") (= ch "\n") (= ch "\r") (= ch "\t") (= ch ",")))

(defn quoted-token-end
  [text String
   start Int] Int
  (loop [index Int (+ start 1)
         escaped Bool false]
    (if (>= index (count text))
      index
      (let [ch String (subs text index (+ index 1))]
        (cond
          escaped (recur (+ index 1) false)
          (= ch "\\") (recur (+ index 1) true)
          (= ch "\"") (+ index 1)
          :else (recur (+ index 1) false))))))

(defn item-start [stack Any] Any
  (if (= 0 (count stack))
    ["" "" stack]
    (let [last-index Int (- (count stack) 1)
          frame Any (nth stack last-index)
          state String (nth frame 0)
          after String (nth frame 1)
          close String (nth frame 2)
          parent Any (.slice stack 0 last-index)]
      (cond
        (= state "array-first")
        ["" "" (conj parent ["array-next" after close])]
        (= state "array-next") ["," "" stack]
        (= state "map-first")
        ["[" "," (conj parent ["map-value" after close])]
        (= state "map-next")
        [",[" "," (conj parent ["map-value" after close])]
        (= state "map-value")
        ["" "]" (conj parent ["map-next" after close])]
        :else ["" "" stack]))))

(defn close-container [stack Any] Any
  (if (= 0 (count stack))
    ["" stack]
    (let [last-index Int (- (count stack) 1)
          frame Any (nth stack last-index)]
      [(str (nth frame 2) (nth frame 1))
       (.slice stack 0 last-index)])))

(defn scalar-node-json
  [kind String
   value-json String] String
  (str "[\"" kind "\"," value-json "]"))

(defn edn-json [text String] String
  (loop [index Int 0
         output String ""
         stack Any []]
    (if (>= index (count text))
      output
      (let [ch String (subs text index (+ index 1))]
        (cond
          (edn-whitespace? ch)
          (recur (+ index 1) output stack)

          (= ch "{")
          (let [started Any (item-start stack)]
            (recur (+ index 1)
                   (str output (nth started 0) "[\"map\",[")
                   (conj (nth started 2)
                         ["map-first" (nth started 1) "]]"])))

          (= ch "}")
          (let [closed Any (close-container stack)]
            (recur (+ index 1)
                   (str output (nth closed 0))
                   (nth closed 1)))

          (or (= ch "[") (= ch "("))
          (let [started Any (item-start stack)]
            (recur (+ index 1)
                   (str output (nth started 0) "[\"vector\",[")
                   (conj (nth started 2)
                         ["array-first" (nth started 1) "]]"])))

          (or (= ch "]") (= ch ")"))
          (let [closed Any (close-container stack)]
            (recur (+ index 1)
                   (str output (nth closed 0))
                   (nth closed 1)))

          (= ch "\"")
          (let [end Int (quoted-token-end text index)
                started Any (item-start stack)]
            (recur end
                   (str output
                        (nth started 0)
                        (scalar-node-json "string" (subs text index end))
                        (nth started 1))
                   (nth started 2)))

          (= ch ":")
          (let [end Int (token-end text (+ index 1))
                token String (subs text (+ index 1) end)
                started Any (item-start stack)]
            (recur end
                   (str output
                        (nth started 0)
                        (scalar-node-json "keyword" (.stringify JSON token))
                        (nth started 1))
                   (nth started 2)))

          (not (delimiter? ch))
          (let [end Int (token-end text index)
                token String (subs text index end)
                started Any (item-start stack)]
            (recur end
                   (str output
                        (nth started 0)
                        (scalar-node-json "atom" (.stringify JSON token))
                        (nth started 1))
                   (nth started 2)))

          :else
          (recur (+ index 1) (str output ch) stack))))))

(defn structural-query-keyword? [context String] Bool
  (or (= context "find") (= context "rel") (= context "var")
      (= context "pred") (= context "fn") (= context "op")
      (= context "direction")))

(defn query-atom
  [bridge Any
   token String] Any
  (cond
    (= token "true") true
    (= token "false") false
    (= token "nil") nil
    (some? (re-matches #"-?[0-9]+" token))
    (.integerValue bridge (.integerTerm bridge token))
    (some? (re-matches #"-?(?:[0-9]+\.[0-9]*|[0-9]*\.[0-9]+)(?:[eE][+-]?[0-9]+)?" token))
    (.parseFloat Number token)
    :else token))

(defn query-map-key
  [bridge Any
   node Any] String
  (let [kind String (host-get node 0)
        value String (host-get node 1)]
    (if (or (= kind "keyword") (= kind "string") (= kind "atom"))
      value
      (.fail bridge "query map keys must be keywords, strings, or atoms"))))

(defn query-value
  [bridge Any
   node Any
   context String] Any
  (let [kind String (host-get node 0)
        value Any (host-get node 1)]
    (cond
      (= kind "string") value

      (= kind "keyword")
      (let [spelling String value]
        (if (structural-query-keyword? context)
          spelling
          (.keywordTerm bridge spelling)))

      (= kind "atom") (query-atom bridge value)

      (= kind "vector")
      (mapv (fn [item Any] Any (query-value bridge item context)) value)

      (= kind "map")
      (let [result Any (js-obj)]
        (doseq [entry Any value]
          (let [key String (query-map-key bridge (nth entry 0))]
            (aset result key (query-value bridge (nth entry 1) key))))
        result)

      :else (.fail bridge (str "unknown EDN node kind " kind)))))

(defn parse-query
  [bridge Any
   text String] Any
  (if (and (> (count text) 1)
           (= "\"" (subs text 1 2)))
    (.parse JSON text)
    (query-value bridge (.parse JSON (edn-json text)) "")))

(defn atom-term
  [bridge Any
   token String] Any
  (cond
    (= token "true") (.booleanTerm bridge true)
    (= token "false") (.booleanTerm bridge false)
    (some? (re-matches #"-?[0-9]+" token)) (.integerTerm bridge token)
    (some? (re-matches #"-?(?:[0-9]+\.[0-9]*|[0-9]*\.[0-9]+)(?:[eE][+-]?[0-9]+)?" token))
    (.floatTerm bridge token)
    :else (.stringTerm bridge token)))

(defn parsed-term
  [bridge Any
   node Any] Any
  (let [kind String (host-get node 0)
        value Any (host-get node 1)]
    (cond
      (= kind "string") (.stringTerm bridge value)
      (= kind "keyword") (.keywordTerm bridge value)
      (= kind "atom") (atom-term bridge value)

      (= kind "vector")
      (if (= 3 (count value))
        (.tripleTerm bridge
                     (parsed-term bridge (nth value 0))
                     (parsed-term bridge (nth value 1))
                     (parsed-term bridge (nth value 2)))
        (.fail bridge "term vector must contain exactly three values"))

      (= kind "map")
      (if (= 1 (count value))
        (let [entry Any (nth value 0)
              key-node Any (nth entry 0)
              instant-node Any (nth entry 1)
              instant-values Any (host-get instant-node 1)]
          (if (and (= "keyword" (host-get key-node 0))
                   (= "instant" (host-get key-node 1))
                   (= "vector" (host-get instant-node 0))
                   (= 2 (count instant-values))
                   (= "atom" (host-get (nth instant-values 0) 0))
                   (= "atom" (host-get (nth instant-values 1) 0)))
            (.instantTerm bridge
                          (host-get (nth instant-values 0) 1)
                          (host-get (nth instant-values 1) 1))
            (.fail bridge "term map must be {:instant [SECONDS NANOS]}")))
        (.fail bridge "term map must be {:instant [SECONDS NANOS]}"))

      :else (.fail bridge "unsupported human term"))))

(defn parse-term
  [bridge Any
   text String] Any
  (parsed-term bridge (.parse JSON (edn-json text))))

(defn parse-subject
  [bridge Any
   text String] Any
  (parse-term bridge
              (if (or (= "@" (subs text 0 1))
                      (= "[" (subs text 0 1))
                      (= "{" (subs text 0 1))
                      (= "\"" (subs text 0 1))
                      (= ":" (subs text 0 1)))
                text
                (str "@" text))))

(defn render-term
  [bridge Any
   value Any] String
  (let [tag String (host-get value 0)]
    (cond
      (= tag "string") (host-get value 1)
      (= tag "integer") (host-get value 1)
      (= tag "float64") (str (.floatValue bridge value))
      (= tag "boolean") (if (host-get value 1) "true" "false")
      (= tag "keyword") (str ":" (host-get value 1))
      (= tag "instant") (str "{:instant [" (host-get value 1) " " (host-get value 2) "]}")
      (= tag "triple")
      (str "[" (render-term bridge (host-get value 1)) " "
           (render-term bridge (host-get value 2)) " "
           (render-term bridge (host-get value 3)) "]")
      :else (.fail bridge (str "unknown Term tag " tag)))))

(defn render-row
  [bridge Any
   row Any] String
  (str "[" (apply str
                   (map-indexed
                    (fn
                      [index Int
                       value Any] String
                      (str (if (= index 0) "" " ")
                           (render-term bridge value)))
                    row)) "]"))

(defn require-count
  [bridge Any
   arguments (Vec String)
   expected Int
   usage String] Nil
  (when-not (= expected (count arguments))
    (.fail bridge usage)))

(defn scan-pattern
  [bridge Any
   arguments (Vec String)] Any
  (let [pattern Any (js-obj)]
    (when-not (= "_" (nth arguments 0))
      (aset pattern "t1" (parse-term bridge (nth arguments 0))))
    (when-not (= "_" (nth arguments 1))
      (aset pattern "t2" (parse-term bridge (nth arguments 1))))
    (when-not (= "_" (nth arguments 2))
      (aset pattern "t3" (parse-term bridge (nth arguments 2))))
    pattern))

(defn ^:async call
  [bridge Any
   operation String
   arguments Any] (Promise Any)
  (await (host-call bridge operation arguments)))

(defn retryable-conflict? [error Any] Bool
  (and (host-store-rpc-error? error)
       (= "rpc/conflict" (host-error-field error "code"))
       (= true (host-get error "retryable"))))

(defn ^:async write-command
  [bridge Any
   command String
   arguments (Vec String)] (Promise Int)
  (do
    (require-count bridge arguments 3
                   "usage: store tell|retract SUBJECT SLOT VALUE")
    (let [asserting Bool (or (= command "tell") (= command "tell-existing"))
          existing Bool (or (= command "tell-existing") (= command "retract-existing"))]
      (loop [attempt Int 1]
        (let [base Any (await (call bridge "version" nil))
              request Any (js-obj
                           "t1" (parse-subject bridge (nth arguments 0))
                           "t2" (parse-term bridge (nth arguments 1))
                           "t3" (parse-term bridge (nth arguments 2))
                           "existing" existing
                           "expectedVersion" (host-get base "servedVersion"))]
          (try
            (let [response Any (await (call bridge (if asserting "assert" "retract") request))
                  result Any (nth (host-get response "result") 0)
                  proposition Any (js-obj
                                   "subject" (host-get request "t1")
                                   "predicate" (host-get request "t2")
                                   "value" (host-get request "t3"))]
              (.out bridge
                    (str (if (host-get result "stateChanged") "committed" "no change")
                         " via server (v" (host-get response "servedVersion") "): "
                         (render-term bridge (host-get proposition "subject")) " "
                         (render-term bridge (host-get proposition "predicate")) " = "
                         (render-term bridge (host-get proposition "value"))
                         " [input 0, occurrence "
                         (render-term bridge (host-get result "occurrence")) "]"))
              0)
            (catch Error error
              (if (and (< attempt 5) (retryable-conflict? error))
                (recur (+ attempt 1))
                (throw error)))))))))

(defn normalized-argv [argv (Vec String)] (Vec String)
  (if (and (pos? (count argv)) (= "store" (first argv)))
    (vec (rest argv))
    argv))

(js/export
  (defn ^:async run
    [bridge Any
     raw-argv (Vec String)] (Promise Int)
    (let [argv (Vec String) (normalized-argv raw-argv)
          command String (if (empty? argv) "" (first argv))
          arguments (Vec String) (vec (rest argv))]
      (cond
        (= command "version")
        (do (require-count bridge arguments 0 "usage: store version")
            (.out bridge (str (host-get (await (call bridge "version" nil)) "servedVersion")))
            0)

        (= command "status")
        (do (require-count bridge arguments 0 "usage: store status")
            (let [response Any (await (call bridge "status" nil))
                  result Any (host-get response "result")]
              (.out bridge (str "up|" (host-get response "servedVersion") "|"
                                (host-get result "liveCount") "|"
                                (host-get result "state") "|" (host-get result "engine"))))
            0)

        (= command "validate")
        (do (require-count bridge arguments 0 "usage: store validate")
            (let [response Any (await (call bridge "validate" nil))
                  result Any (host-get response "result")]
              (doseq [violation Any (host-get result "violations")]
                (.out bridge (str (if (host-get result "valid") "advisory: " "violation: ")
                                  (render-term bridge violation))))
              (if (host-get result "valid") (do (.out bridge "valid") 0) 1)))

        (= command "show")
        (do (require-count bridge arguments 1 "usage: store show SUBJECT")
            (let [subject Any (parse-subject bridge (first arguments))
                  response Any (await (call bridge "scan" (js-obj "t1" subject)))
                  triples Any (host-get response "result")]
              (if (empty? triples)
                (.out bridge (str "no triples for " (render-term bridge subject)))
                (doseq [triple Any triples]
                  (.out bridge (str "  " (render-term bridge (host-get triple 2))
                                    "  " (render-term bridge (host-get triple 3))))))
              0))

        (= command "query")
        (do (require-count bridge arguments 1 "usage: store query EDN-QUERY")
            (let [response Any (await (call bridge "query" (parse-query bridge (first arguments))))
                  rows Any (host-get response "result")]
              (if (empty? rows)
                (.out bridge "  (no results)")
                (doseq [row Any rows] (.out bridge (str "  " (render-row bridge row)))))
              0))

        (= command "scan")
        (do (require-count bridge arguments 3 "usage: store scan T1|_ T2|_ T3|_")
            (let [response Any (await (call bridge "scan" (scan-pattern bridge arguments)))]
              (doseq [triple Any (host-get response "result")]
                (.out bridge (render-term bridge triple)))
              0))

        (= command "occurrences")
        (do (require-count bridge arguments 0 "usage: store occurrences")
            (loop [cursor Any nil]
              (let [response Any (await (call bridge "occurrences" cursor))]
                (doseq [occurrence Any (host-get response "result")]
                  (.out bridge
                        (str "{:type :occurrence, :coordinate "
                             (render-term bridge (host-get occurrence "coordinate"))
                             ", :action :" (host-get occurrence "action")
                             ", :proposition "
                             (render-term bridge (host-get occurrence "proposition")) "}")))
                (if (host-get (host-get response "page") "done")
                  0
                  (recur (host-get (host-get response "page") "nextCursor"))))))

        (or (= command "tell") (= command "retract")
            (= command "tell-existing") (= command "retract-existing"))
        (await (write-command bridge command arguments))

        :else (.fail bridge (str "unsupported data command: " command))))))

(js/export
  (defn classify-error [error Any] Int
    (let [name String (host-error-field error "name")
          code String (host-error-field error "code")]
      (cond
        (= code "rpc/subject-not-found") 3
        (= name "StoreTransportError") 4
        (and (= name "StoreProtocolError")
             (not (or (= code "client/invalid-input")
                      (= code "client/invalid-integer")
                      (= code "client/integer-range")
                      (= code "client/invalid-term")
                      (= code "client/invalid-keyword")
                      (= code "client/invalid-float")
                      (= code "client/query-syntax")
                      (= code "client/invalid-host")
                      (= code "client/invalid-port")))) 4
        :else 1))))

(js/export
  (defn error-message [error Any] String
    (let [message String (host-error-field error "message")]
      (if (= message "") (str error) message))))
