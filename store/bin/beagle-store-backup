#!/usr/bin/env bun
import { StoreBackupError, runCli } from '../clients/bun/backup.mjs';

try {
  await runCli();
} catch (error) {
  if (error instanceof StoreBackupError) {
    console.error(`beagle-store-backup: ${error.code}: ${error.message}`);
    process.exit(error.code === 'usage' ? 2 : 1);
  }
  console.error(`beagle-store-backup: internal: ${error?.message ?? String(error)}`);
  process.exit(1);
}
