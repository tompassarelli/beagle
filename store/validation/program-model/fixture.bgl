#lang beagle

(ns store.program-model-fixture
  (:require [store.kernel :as kernel]
            [store.program :as program]
            [store.types :as t]))

(def profile Keyword :program)
(def rule String "FNF")
(def space-id String "program-fixture")
(def root String "program-root-7")
(def module-a String "module-a")
(def module-b String "module-b")
(def binding-a t/Triple (t/triple module-a program/declares-at 0))
(def binding-b t/Triple (t/triple module-b program/declares-at 0))
(def span-a t/Triple (t/triple 22 program/through-byte 28))
(def span-b t/Triple (t/triple 22 program/through-byte 28))
(def reference-a t/Triple (t/triple module-a program/has-span span-a))

(def source-a String
  "#lang beagle\n(ns sample.a)\n;; helper comment\n(defn helper [x Int] Int x)\n")
(def source-b String
  "#lang beagle\n(ns sample.b)\n(defn helper [x Int] Int x)\n")

(defn relationship-declarations [] (Vec t/Triple)
  [(t/triple program/member-of program/member-of program/relationships)
   (t/triple program/contains program/member-of program/relationships)
   (t/triple program/represented-by program/member-of program/relationships)
   (t/triple program/refers-to program/member-of program/relationships)
   (t/triple program/depends-on program/member-of program/relationships)
   (t/triple program/derived-from program/member-of program/relationships)
   (t/triple program/admitted-by program/member-of program/relationships)
   (t/triple program/has-span program/member-of program/relationships)
   (t/triple program/named program/member-of program/relationships)
   (t/triple program/declares-at program/member-of program/relationships)
   (t/triple program/through-byte program/member-of program/relationships)])

(defn content-propositions [root-resource t/Term] (Vec t/Triple)
  [(t/triple space-id kernel/profile-anchor
     (kernel/profile-header profile program/fact-profile-kind
       kernel/observe-profile-mode))
   (kernel/profile-rule profile kernel/fact-normal-form-profile-rule)
   (t/triple profile program/member-of program/profiles)
   (t/triple rule program/member-of program/profile-rules)
   (t/triple root-resource program/member-of program/program-roots)
   (t/triple root-resource program/admitted-by profile)
   (t/triple root-resource program/contains module-a)
   (t/triple root-resource program/contains module-b)
   (t/triple module-a program/member-of program/modules)
   (t/triple module-b program/member-of program/modules)
   (t/triple module-a program/represented-by source-a)
   (t/triple module-b program/represented-by source-b)
   (t/triple binding-a program/member-of program/bindings)
   (t/triple binding-b program/member-of program/bindings)
   (t/triple module-a program/contains binding-a)
   (t/triple module-b program/contains binding-b)
   (t/triple binding-a program/named "helper")
   (t/triple binding-b program/named "helper")
   (t/triple binding-a program/has-span span-a)
   (t/triple binding-b program/has-span span-b)
   (t/triple module-a program/contains reference-a)
   (t/triple reference-a program/member-of program/references)
   (t/triple reference-a program/refers-to binding-a)
   (t/triple module-b program/depends-on module-a)])

(defn root-with-additions
  [root-resource t/Term
   additions (Vec t/Triple)] program/ProgramRoot
  (program/->ProgramRoot space-id root-resource 7 profile
    (into
      (into (relationship-declarations)
            (content-propositions root-resource))
      additions)))

(defn canonical-root [] program/ProgramRoot
  (root-with-additions root []))

(def float-atom Float 7.5)
(def nested-float-relation t/Triple
  (t/triple module-a program/depends-on float-atom))

(defn valid-canonical-atoms-root [] program/ProgramRoot
  (root-with-additions
    root
    [(t/triple 42 program/depends-on module-a)
     (t/triple true program/depends-on false)
     (t/triple :canonical program/depends-on (t/instant 123 456))
     (t/triple
       (t/triple 1 program/depends-on :canonical)
       program/depends-on
       module-a)]))

(defn float-proposition-roots [] (Vec program/ProgramRoot)
  [(root-with-additions
     root
     [(t/triple float-atom program/depends-on module-a)])
   (root-with-additions
     root
     [(t/triple float-atom program/member-of program/relationships)
      (t/triple module-a float-atom module-b)])
   (root-with-additions
     root
     [(t/triple module-a program/depends-on float-atom)])
   (root-with-additions
     root
     [(t/triple
        (t/triple float-atom program/depends-on module-a)
        program/depends-on
        module-b)])
   (root-with-additions
     root
     [(t/triple nested-float-relation program/member-of program/relationships)
      (t/triple module-a nested-float-relation module-b)])
   (root-with-additions
     root
     [(t/triple
        module-a
        program/depends-on
        (t/triple module-b program/depends-on float-atom))])])

(defn float-propositions-rejected? [] Bool
  (every?
    (fn [candidate program/ProgramRoot] Bool
      (not (program/admitted-root? candidate)))
    (float-proposition-roots)))

(defn canonical-root-observations?
  [candidate program/ProgramRoot] Bool
  (let [source String? (program/source-for-module candidate module-a)
        observed-module Any
        (program/reference-module candidate reference-a)
        observed-span Any
        (program/reference-span candidate reference-a)
        root-resource Any (program/root-resource-value candidate)
        first-proposition t/Triple
        (first (program/programroot-propositions candidate))]
    (if (string? source)
      (let [source-value String source]
        (if (string? observed-module)
          (let [module-value String observed-module]
            (if (t/triple? observed-span)
              (let [span-value t/Triple observed-span]
                (if (string? root-resource)
                  (let [resource-value String root-resource]
                    (and (program/admitted-root? candidate)
                         (and (= source-a source-value)
                              (and (= space-id
                                      (program/programroot-space-id candidate))
                                   (and (= module-a module-value)
                                        (and (= span-a span-value)
                                             (and (= 7
                                                     (program/programroot-store-version
                                                       candidate))
                                                  (and (= root resource-value)
                                                       (t/triple?
                                                         first-proposition)))))))))
                  false))
              false))
          false))
      false)))

(defn main [] Int
  (let [candidate program/ProgramRoot (canonical-root)
        canonical-atoms program/ProgramRoot (valid-canonical-atoms-root)
        float-root program/ProgramRoot (root-with-additions float-atom [])]
    (cond
      [(not (canonical-root-observations? candidate)) 1]
      [(not (program/admitted-root? canonical-atoms)) 1]
      [(program/admitted-root? float-root) 1]
      [(not (float-propositions-rejected?)) 1]
      [:else 0])))
