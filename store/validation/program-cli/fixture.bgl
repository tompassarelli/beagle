#lang beagle

(ns store.program-cli-fixture
  (:require [beagle.frontend-facts :as facts]
            [beagle.parser-reader :as parser-reader]
            [beagle.program-projection :as projection]
            [store.kernel :as kernel]
            [store.native-dispatch :as dispatch]
            [store.native-server :as server]
            [store.program :as program]
            [store.program-cli :as cli]
            [store.types :as t]))

(def space-id String "program-cli-space")
(def profile String "program-cli-profile")
(def rule String "program-cli-admission")
(def root String "program-cli-root-v1")
(def other-root String "program-cli-other-root-v1")
(def module String "fixture/shadowing-rename.bgl")
(def other-module String "fixture/other-root.bgl")
(def max-store-log-bytes Int 67108864)

(defn failed-store [detail String] server/StoreResult
  (server/->StoreResult server/status-fatal nil detail 0 [] ""))

(defn append-log! [path String bytes (Vec Int)] String?
  (if (empty? bytes)
    nil
    (match (host.fs/append-bytes path bytes)
      [(host.fs/AppendBytesOk) nil]
      [(host.fs/AppendBytesError errno) "could not append fixture Store log"])))

(defn open-store! [path String] server/StoreResult
  (match (host.fs/append-text path "")
    [(host.fs/AppendTextError errno)
     (failed-store "could not create fixture Store log")]
    [(host.fs/AppendTextOk)
     (let [source ByteSource
           (host.fs/read-byte-source-bounded-or-die path max-store-log-bytes)]
       (server/server-store-boot! path space-id source (subvec source 0 0)))]))

(defn persist-boot! [path String opened server/StoreResult] String?
  (append-log! path (server/storeresult-boot-append opened)))

(def source String
  (str
    "#lang beagle\n\n"
    ";; helper is the selected top-level binding.\n"
    "(defn helper [value Int] Int\n"
    "  (+ value 1))\n\n"
    ";; This local helper shadows the top-level binding.\n"
    "(defn shadowed [helper Int] Int\n"
    "  (+ helper 10))\n\n"
    "(defn dependent [value Int] Int\n"
    "  (helper value))\n\n"
    ";; helper in this string and comment is not a reference.\n"
    "(defn literal [] String\n"
    "  \"helper\")\n\n"
    "(defn independent [value Int] Int\n"
    "  (* value 2))\n"))

(def other-source String
  (str
    "#lang beagle\n"
    "(defn helper [value Int] Int\n"
    "  (+ value 100))\n"))

(defn project
  [logical-module t/Term text String] (U (Vec t/Triple) Nil)
  (let [digest String (str "sha256:" (sha256-bytes (utf8-encode text)))]
    (match (parser-reader/facts-from-source
             "program-cli-fixture.bgl" text digest "program")
      [(facts/FactsRejected errors) nil]
      [(facts/FactsRead bundle)
       (match (projection/project-module logical-module bundle)
         [(projection/ProgramProjectionRejected code detail) nil]
         [(projection/ProgramProjected projected)
          (projection/programmoduleprojection-propositions projected)])])))

(defn append-unique
  [values (Vec t/Triple) proposition t/Triple] (Vec t/Triple)
  (if (some?
        (some
          (fn [candidate t/Triple] t/Triple?
            (if (= candidate proposition) candidate nil))
          values))
    values
    (conj values proposition)))

(defn merge-triples
  [left (Vec t/Triple) right (Vec t/Triple)] (Vec t/Triple)
  (reduce append-unique left right))

(defn scaffold [projected (Vec t/Triple)] (Vec t/Triple)
  (merge-triples projected
    [(t/triple profile kernel/profile-includes
       kernel/fact-normal-form-profile-rule)
     (t/triple profile program/member-of program/profiles)
     (t/triple profile program/includes rule)
     (t/triple rule program/member-of program/profile-rules)
     (t/triple space-id kernel/profile-anchor
       (kernel/profile-header profile program/fact-profile-kind
         kernel/observe-profile-mode))
     (t/triple root program/member-of program/program-roots)
     (t/triple root program/admitted-by profile)
     (t/triple root program/contains module)
     (t/triple other-root program/member-of program/program-roots)
     (t/triple other-root program/admitted-by profile)
     (t/triple other-root program/contains other-module)]))

(defn selected-binding [propositions (Vec t/Triple)] t/Triple?
  (some
    (fn [proposition t/Triple] t/Triple?
      (let [candidate Any (t/triple-t1 proposition)]
        (if (and (= program/named (t/triple-t2 proposition))
                 (and (= "helper" (t/triple-t3 proposition))
                      (and (t/triple? candidate)
                           (= module (t/triple-t1 candidate)))))
          candidate nil)))
    propositions))

(defn rpc-action [proposition t/Triple] t/Triple
  (dispatch/rpc-record
    :rpc/action [:rpc/assert proposition :rpc/subject-any]))

(defn parser-roundtrip-valid? [] Bool
  (let [negative-zero-bits Int -9223372036854775808
        nan-bits Int 9221120237041090626
        text String
        (str "[[#float " negative-zero-bits " :bits] :sample "
             "[[#float " nan-bits " :bits] :at [#instant -12 345]]]"
             )]
    (match (cli/parse-term text)
      [(cli/TermParseRejected detail) false]
      [(cli/TermParsed parsed)
       (if (not (t/triple? parsed))
         false
         (let [outer t/Triple parsed
               negative-zero Any (t/triple-t1 outer)
               nested Any (t/triple-t3 outer)]
           (and (and (number? negative-zero)
                     (= negative-zero-bits
                        (float-to-bits (double negative-zero))))
                (and (t/triple? nested)
                     (let [nan-value Any (t/triple-t1 nested)
                           instant-value Any (t/triple-t3 nested)]
                       (and (and (number? nan-value)
                                 (= nan-bits
                                    (float-to-bits (double nan-value))))
                            (and (t/instant? instant-value)
                                 (= text (cli/render-term parsed)))))))))])))

(defn seed! [path String propositions (Vec t/Triple)] Int
  (let [opened server/StoreResult (open-store! path)
        store-value server/Store? (server/storeresult-store opened)]
    (if (or (nil? store-value)
            (some? (persist-boot! path opened)))
      74
      (let [store server/Store store-value
            actions (Vec Any) (mapv rpc-action propositions)
            payload t/Triple
            (dispatch/rpc-record
              :rpc/batch [(dispatch/rpc-list actions) :rpc/none])
            request t/RpcRequest
            (t/->RpcRequest space-id :rpc/batch 0 nil nil payload)
            packet t/StoreRpcPacketV2
            (t/->StoreRpcPacketV2 :request 0 1 request nil)
            result server/ResponseResult
            (server/dispatch-request!
              opened store (server/->Request packet) 0)]
        (if (or (not= server/status-ok (server/responseresult-status result))
                (not (server/responseresult-state-changed result)))
          74
          (let [write-error String?
                (append-log!
                  path (server/responseresult-append-bytes result))]
            (if (some? write-error) 74 0)))))))

(defn -main [args (Vec String)] Int
  (if (or (not= 1 (count args)) (not (parser-roundtrip-valid?)))
    64
    (let [first-projection (U (Vec t/Triple) Nil) (project module source)
          second-projection (U (Vec t/Triple) Nil)
          (project other-module other-source)]
      (if (or (nil? first-projection) (nil? second-projection))
        65
        (let [first-values (Vec t/Triple) first-projection
              second-values (Vec t/Triple) second-projection
              propositions (Vec t/Triple)
              (scaffold (merge-triples first-values second-values))
              binding t/Triple? (selected-binding first-values)]
          (if (nil? binding)
            65
            (let [present t/Triple binding
                  status Int (seed! (nth args 0) propositions)]
              (if (= status 0)
                (do
                  (host.stdout/write-line
                    (str (t/triple-t3 present)))
                  0)
                status))))))))
