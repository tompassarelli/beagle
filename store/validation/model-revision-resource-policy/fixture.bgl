#lang beagle

(ns store.model-revision-resource-policy-fixture
  (:require [store.model-revision-resource-policy :as resource]))

(defn uniform-policy [maximum Int] resource/ModelRevisionResourcePolicy
  (resource/->ModelRevisionResourcePolicy
   maximum maximum maximum maximum maximum maximum))

(defn uniform-use [required-at-least Int] resource/ModelRevisionResourceUse
  (resource/->ModelRevisionResourceUse
   required-at-least required-at-least required-at-least
   required-at-least required-at-least required-at-least))

(defn policy-with
  [dimension resource/ModelRevisionResourceDimension
   maximum Int] resource/ModelRevisionResourcePolicy
  (match dimension
    [(resource/ModelRevisionProposals ordinal)
     (resource/->ModelRevisionResourcePolicy maximum 2 2 2 2 2)]
    [(resource/ModelRevisionFacts ordinal)
     (resource/->ModelRevisionResourcePolicy 2 maximum 2 2 2 2)]
    [(resource/ModelRevisionJudgments ordinal)
     (resource/->ModelRevisionResourcePolicy 2 2 maximum 2 2 2)]
    [(resource/ModelRevisionDirectParents ordinal)
     (resource/->ModelRevisionResourcePolicy 2 2 2 maximum 2 2)]
    [(resource/ModelRevisionLineageNodes ordinal)
     (resource/->ModelRevisionResourcePolicy 2 2 2 2 maximum 2)]
    [(resource/ModelRevisionLineageEdges ordinal)
     (resource/->ModelRevisionResourcePolicy 2 2 2 2 2 maximum)]
    [_ (uniform-policy -1)]))

(defn use-with
  [dimension resource/ModelRevisionResourceDimension
   required-at-least Int] resource/ModelRevisionResourceUse
  (match dimension
    [(resource/ModelRevisionProposals ordinal)
     (resource/->ModelRevisionResourceUse required-at-least 0 0 0 0 0)]
    [(resource/ModelRevisionFacts ordinal)
     (resource/->ModelRevisionResourceUse 0 required-at-least 0 0 0 0)]
    [(resource/ModelRevisionJudgments ordinal)
     (resource/->ModelRevisionResourceUse 0 0 required-at-least 0 0 0)]
    [(resource/ModelRevisionDirectParents ordinal)
     (resource/->ModelRevisionResourceUse 0 0 0 required-at-least 0 0)]
    [(resource/ModelRevisionLineageNodes ordinal)
     (resource/->ModelRevisionResourceUse 0 0 0 0 required-at-least 0)]
    [(resource/ModelRevisionLineageEdges ordinal)
     (resource/->ModelRevisionResourceUse 0 0 0 0 0 required-at-least)]
    [_ (uniform-use -1)]))

(defn admitted-use?
  [result resource/ModelRevisionResourceAdmission
   expected resource/ModelRevisionResourceUse] Bool
  (match result
    [(resource/ResourcesAdmitted accepted-use) (= expected accepted-use)]
    [(resource/ResourcesExhausted dimension allowed required-at-least) false]
    [(resource/ResourcePolicyInvalid dimension supplied) false]
    [(resource/ResourceUseInvalid dimension supplied) false]
    [_ false]))

(defn exhausted-as?
  [result resource/ModelRevisionResourceAdmission
   expected-dimension resource/ModelRevisionResourceDimension
   expected-allowed Int
  expected-required-at-least Int] Bool
  (match result
    [(resource/ResourcesAdmitted accepted-use) false]
    [(resource/ResourcesExhausted dimension allowed required-at-least)
     (and (= expected-dimension dimension)
          (and (= expected-allowed allowed)
               (= expected-required-at-least required-at-least)))]
    [(resource/ResourcePolicyInvalid dimension supplied) false]
    [(resource/ResourceUseInvalid dimension supplied) false]
    [_ false]))

(defn policy-invalid-as?
  [result resource/ModelRevisionResourceAdmission
   expected-dimension resource/ModelRevisionResourceDimension
  expected-supplied Int] Bool
  (match result
    [(resource/ResourcesAdmitted accepted-use) false]
    [(resource/ResourcesExhausted dimension allowed required-at-least) false]
    [(resource/ResourcePolicyInvalid dimension supplied)
     (and (= expected-dimension dimension) (= expected-supplied supplied))]
    [(resource/ResourceUseInvalid dimension supplied) false]
    [_ false]))

(defn use-invalid-as?
  [result resource/ModelRevisionResourceAdmission
   expected-dimension resource/ModelRevisionResourceDimension
  expected-supplied Int] Bool
  (match result
    [(resource/ResourcesAdmitted accepted-use) false]
    [(resource/ResourcesExhausted dimension allowed required-at-least) false]
    [(resource/ResourcePolicyInvalid dimension supplied) false]
    [(resource/ResourceUseInvalid dimension supplied)
     (and (= expected-dimension dimension) (= expected-supplied supplied))]
    [_ false]))

(defn invalid-policy-case
  [dimension resource/ModelRevisionResourceDimension] Bool
  (policy-invalid-as?
   (resource/admit-model-revision-resource-use
    (policy-with dimension -1)
    (uniform-use 0))
   dimension
   -1))

(defn invalid-use-case
  [dimension resource/ModelRevisionResourceDimension] Bool
  (use-invalid-as?
   (resource/admit-model-revision-resource-use
    (uniform-policy 2)
    (use-with dimension -1))
   dimension
   -1))

(defn exhaustion-case
  [dimension resource/ModelRevisionResourceDimension] Bool
  (exhausted-as?
   (resource/admit-model-revision-resource-use
    (uniform-policy 2)
    (use-with dimension 3))
   dimension
   2
   3))

(defn main [] Int
  (let [dimensions (Vec resource/ModelRevisionResourceDimension) (resource/model-revision-resource-dimensions)
        first-dimension resource/ModelRevisionResourceDimension (first dimensions)
        last-dimension resource/ModelRevisionResourceDimension (last dimensions)]
    (if (and
         (admitted-use?
          (resource/admit-model-revision-resource-use
           (uniform-policy 0)
           (uniform-use 0))
          (uniform-use 0))
         (every? invalid-policy-case dimensions)
         (every? invalid-use-case dimensions)
         (every? exhaustion-case dimensions)
         (exhausted-as?
         (resource/admit-model-revision-resource-use
           (uniform-policy 0)
           (uniform-use 1))
          first-dimension
          0
          1)
         (policy-invalid-as?
          (resource/admit-model-revision-resource-use
           (resource/->ModelRevisionResourcePolicy 0 0 0 0 0 -1)
           (resource/->ModelRevisionResourceUse 1 0 0 0 0 0))
          last-dimension
          -1)
         (use-invalid-as?
          (resource/admit-model-revision-resource-use
           (uniform-policy 0)
           (resource/->ModelRevisionResourceUse 1 0 0 0 0 -1))
          last-dimension
          -1)
         (admitted-use?
          (resource/admit-model-revision-resource-use
           (uniform-policy 2048)
           (uniform-use 1025))
          (uniform-use 1025)))
      0
      1)))
