#lang beagle

(ns store.branch-revision-identity-fixture
  (:require [beagle.semantic-identity :as identity]
            [store.revision-identity :as revision]
            [store.store :as store]
            [store.types :as t]))


(def first-proposition t/Triple (t/triple "model" :state "declared"))
(def second-proposition t/Triple (t/triple "model" :state "checked"))

(def first-operation t/CommitOperation
  (store/assert-operation first-proposition))
(def second-operation t/CommitOperation
  (store/assert-operation second-proposition))

(def empty-records (Vec t/TransactionRecord) [])
(def one-record (Vec t/TransactionRecord)
  [(t/->TransactionRecord 1 [first-operation])])
(def two-records (Vec t/TransactionRecord)
  [(t/->TransactionRecord 1 [first-operation])
   (t/->TransactionRecord 2 [second-operation])])
(def joined-record (Vec t/TransactionRecord)
  [(t/->TransactionRecord 1 [first-operation second-operation])])
(def reversed-joined-record (Vec t/TransactionRecord)
  [(t/->TransactionRecord 1 [second-operation first-operation])])
(def noncontiguous-records (Vec t/TransactionRecord)
  [(t/->TransactionRecord 2 [first-operation])])

(defn accepted-revision
  [result revision/BranchRevisionResult] revision/BranchRevision?
  (match result
    [(revision/BranchRevisionAccepted accepted) accepted]
    [(revision/BranchRevisionRejected code detail) nil]))

(defn rejected-as?
  [result revision/BranchRevisionResult
   expected Keyword] Bool
  (match result
    [(revision/BranchRevisionAccepted accepted) false]
    [(revision/BranchRevisionRejected code detail) (= expected code)]))

(defn decoded-candidate
  [result revision/BranchRevisionIdCandidateResult]
  revision/BranchRevisionIdCandidate?
  (match result
    [(revision/BranchRevisionIdCandidateValue candidate) candidate]
    [(revision/BranchRevisionIdCandidateRejected code detail) nil]))

(defn projected-scalar
  [result identity/EncodingResult] String?
  (match result
    [(identity/EncodingRejected problem) nil]
    [(identity/EncodingAccepted bytes) (utf8-decode bytes)]))

(defn digest-equal?
  [left revision/CommittedHistoryDigest
   right revision/CommittedHistoryDigest] Bool
  (identity/digest=
   (revision/committedhistorydigest-digest left)
   (revision/committedhistorydigest-digest right)))

(defn forged-head
  [revision-value revision/BranchRevision] revision/BranchRevision
  (revision/->BranchRevision
   (revision/branchrevision-identity revision-value)
   (revision/branchrevision-space-id revision-value)
   (revision/branchrevision-committed-history revision-value)
   (+ 1 (revision/branchrevision-head-sequence revision-value))))

(defn main [] Int
  (let [empty revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" empty-records))
        one revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" one-record))
        two revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" two-records))
        two-again revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" two-records))
        other-space revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-b" two-records))
        joined revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" joined-record))
        reversed revision/BranchRevision? (accepted-revision
         (revision/mint-branch-revision! "space-a" reversed-joined-record))]
    (if (or (nil? empty)
            (or (nil? one)
                (or (nil? two)
                    (or (nil? two-again)
                        (or (nil? other-space)
                            (or (nil? joined) (nil? reversed)))))))
      10
      (let [empty-value revision/BranchRevision empty
            one-value revision/BranchRevision one
            two-value revision/BranchRevision two
            two-again-value revision/BranchRevision two-again
            other-space-value revision/BranchRevision other-space
            joined-value revision/BranchRevision joined
            reversed-value revision/BranchRevision reversed
            scalar String? (projected-scalar
             (revision/project-branch-revision-id-scalar
              (revision/branchrevision-identity two-value)))]
        (if (nil? scalar)
          11
          (let [scalar-value String scalar
                candidate revision/BranchRevisionIdCandidate? (decoded-candidate
                 (revision/decode-branch-revision-id-scalar scalar-value))
                candidate-verified revision/BranchRevision? (if (nil? candidate)
                  nil
                  (accepted-revision
                   (revision/verify-branch-revision-id!
                    candidate "space-a" two-records)))]
            (cond
              [(not= 0 (revision/branchrevision-head-sequence empty-value)) 12]
              [(not= 1 (revision/branchrevision-head-sequence one-value)) 13]
              [(not= 2 (revision/branchrevision-head-sequence two-value)) 14]
              [(not (revision/branch-revision=
                     two-value two-again-value)) 15]
              [(revision/branch-revision=
                two-value other-space-value) 16]
              [(not (digest-equal?
                     (revision/branchrevision-committed-history two-value)
                     (revision/branchrevision-committed-history
                      other-space-value))) 17]
              [(revision/branch-revision=
                joined-value reversed-value) 18]
              [(not (rejected-as?
                     (revision/mint-branch-revision!
                      "space-a" noncontiguous-records)
                     :branch-revision/noncontiguous-history)) 19]
              [(not (rejected-as?
                     (revision/mint-branch-revision! "" two-records)
                     :branch-revision/space-unbound)) 20]
              [(not (rejected-as?
                     (revision/verify-branch-revision!
                      (forged-head two-value) "space-a" two-records)
                     :branch-revision/mismatch)) 21]
              [(nil? candidate) 22]
              [(nil? candidate-verified) 23]
              [(not (revision/branch-revision=
                     two-value candidate-verified)) 24]
              [(not (rejected-as?
                     (revision/verify-branch-revision-id!
                      candidate "space-a" one-record)
                     :branch-revision/mismatch)) 25]
              [(some?
                (decoded-candidate
                 (revision/decode-branch-revision-id-scalar
                  "sha256:ABC"))) 26]
              [:else 0])))))))
