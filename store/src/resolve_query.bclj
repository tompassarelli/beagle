#lang beagle/clj

;; ============================================================================
;; resolve-query — the code queries that run ON the resolved graph.
;; ============================================================================
;; Stage M1 Cut F of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad), and the `callgraph` mode of
;; migration_order's M1.
;;
;;   call-edges     scope-correct defn->defn edges over the bound corpus. A
;;                  "call" is ANY resolved reference inside a top-level defn's
;;                  body whose binding is itself a top-level defn — head-only
;;                  under-reports, which was proven on shipped store/src. Edges
;;                  are keyed on the binding's NODE id (@mod#int identity), so
;;                  same-named fns in different modules never false-merge and a
;;                  rename does not move an edge.
;;   blast-closure! transitive blast radius via Beagle Store Datalog: who breaks if D
;;                  changes. THE one `reaches` implementation.
;;   binding-privacy  {binding-leaf -> :public | :private}, identity-keyed.
;;   dead-private-bindings!  the stratified-Datalog query: private top-level
;;                  bindings unreachable from any public root. Stratum 1 is
;;                  positive recursive reachability; stratum 2 is the negated
;;                  dead(p) :- private(p), ¬live(p). An unreachable private
;;                  RECURSIVE CYCLE is never seeded by a root, so positive
;;                  reachability skips it and it is correctly dead.
;;
;; The two Datalog queries build a THROWAWAY store, which is why they carry the
;; `!` suffix here that the raw originals did not: they mutate, and Beagle's
;; purity gate says so out loud. resolve.clj's wrappers keep the old names, so
;; server.clj's `resolve/blast-closure` and `resolve/dead-private-bindings`
;; are untouched. The originals' `volatile!` becomes an `atom` — the ref is
;; function-local and single-threaded, so the only difference is the barrier.
;;
;; State arrives as parameters (Cut B's reason: resolve.clj's ^:dynamic vars
;; cannot change namespace).
;;
;; Consumed by resolve.clj — the emitted out/resolve_query.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-query
  (:require [clojure.string :as str]
    [store.types :as t]
    [store.datalog :as d]
    [resolve-ident :as ri]
    [resolve-core :as rc]
    [resolve-read :as rr]
    [resolve-modules :as rm]
    [resolve-render :as rv]))


(def SLASH-RE Regex (re-pattern "/"))

(def EXT-RE Regex (re-pattern "\\.[^.]+$"))

(defn- call-refs
  [ctx (U ri/Graph Nil)
   view Any
   BOUND Any
   REFERS Any
   node Any] (Vec Any)
  (if (some? (rr/refers-target ctx view BOUND REFERS node))
    (if (nil? node) [] [node])
    (if (= "list" (rr/kind-of ctx view node))
      (reduce (fn
                [acc (Vec Any)
                 ch Any] (Vec Any)
                (into acc (call-refs ctx view BOUND REFERS ch)))
        []
        (rr/ordered-children ctx node))
      [])))

(defn- src-label
  [ctx (U ri/Graph Nil)
   view Any
   src String
   ents (Vec Any)] Any
  (let [mn (rm/module-name ctx view ents)]
    (if (some? mn)
      mn
      (str/replace (str (last (str/split src SLASH-RE))) EXT-RE ""))))

(defn- defn-meta-of
  [ctx (U ri/Graph Nil)
   view Any
   srcs (Vec String)
   file-module-context Any
   ents-of Any] (Map Any Any)
  (reduce (fn
            [acc (Map Any Any)
             src String] (Map Any Any)
            (let [module-context (get file-module-context src {})
                  label (src-label ctx view src (get ents-of src []))]
              (reduce (fn
                        [a (Map Any Any)
                         nm Any] (Map Any Any)
                        (let [leaf (get module-context nm)] (assoc a leaf {:key (str src "#" (str leaf)) :file src :module label :name nm}))) acc (set (keys module-context)))))
    {}
    srcs))

(defn- callers-of
  [ctx (U ri/Graph Nil)
   view Any
   BOUND Any
   REFERS Any
   srcs (Vec String)
   ents-of Any
   defn-meta (Map Any Any)] (Vec Any)
  (reduce (fn
            [acc (Vec Any)
             src String] (Vec Any)
            (reduce (fn
                      [a (Vec Any)
                       form Any] (Vec Any)
                      (let [d (rm/unwrap-def ctx view form)
                            h (str (rr/head-sym ctx view d))]
                        (cond (contains? rc/TOPLEVEL-VALUE-DEFS h) (let [cl (rm/logical-name-leaf ctx view (nth (rr/ordered-children ctx d) 1 nil))] (if (contains? defn-meta cl) (conj a [cl d]) a)) (contains? #{"extend-protocol" "extend-type"} h) (reduce (fn
                                                                                                                                                                                                                                                                 [b (Vec Any)
                                                                                                                                                                                                                                                                  cc Any] (Vec Any)
                                                                                                                                                                                                                                                                 (let [outer (rr/unwrap-meta ctx view cc)] (if (= "list" (rr/kind-of ctx view outer)) (let [mnode (rm/logical-name-leaf ctx view cc)
                                                                                                                                                                                                                                                                                                                                                            cl (if (some? (rr/sym-val ctx view mnode)) (rv/ultimate ctx view BOUND REFERS (rr/refers-target ctx view BOUND REFERS mnode)) nil)]
                                                                                                                                                                                                                                                                                                                                                        (if (and (some? cl) (contains? defn-meta cl)) (conj b [cl cc]) b)) b))) a (vec (rest (rr/ordered-children ctx d)))) :else a))) acc (rm/forms-of ctx view (get ents-of src []))))
    []
    srcs))

(defn call-edges
  [ctx (U ri/Graph Nil)
   view Any
   BOUND Any
   REFERS Any
   srcs (Vec String)
   file-module-context Any
   ents-of Any] (Map Keyword Any)
  (let [defn-meta (defn-meta-of ctx view srcs file-module-context ents-of)
        defn-set (set (keys defn-meta))
        callers (callers-of ctx view BOUND REFERS srcs ents-of defn-meta)
        edges (reduce (fn
                        [acc (Vec Any)
                         pair Any] (Vec Any)
                        (let [caller-leaf (nth pair 0)
                              body (nth pair 1)]
                          (reduce (fn
                                    [a (Vec Any)
                                     r Any] (Vec Any)
                                    (let [callee (rv/ultimate ctx view BOUND REFERS (rr/refers-target ctx view BOUND REFERS r))] (if (and (contains? defn-set callee) (not= callee caller-leaf)) (conj a [caller-leaf callee]) a))) acc (call-refs ctx view BOUND REFERS body)))) [] callers)]
    {:defn-meta defn-meta :edges (vec (distinct edges)) :defn-set defn-set}))

(defn binding-privacy
  [ctx (U ri/Graph Nil)
   view Any
   srcs (Vec String)
   ents-of Any] (Map Any Keyword)
  (reduce (fn
            [acc (Map Any Keyword)
             src String] (Map Any Keyword)
            (reduce (fn
                      [a (Map Any Keyword)
                       f Any] (Map Any Keyword)
                      (let [d (rm/unwrap-def ctx view f)
                            h (str (rr/head-sym ctx view d))]
                        (if (contains? rc/TOPLEVEL-VALUE-DEFS h) (let [nl (rm/logical-name-leaf ctx view (nth (rr/ordered-children ctx d) 1 nil))] (if (some? (rr/sym-val ctx view nl)) (assoc a nl (if (contains? #{"def-" "defn-"} h) :private :public)) a)) a))) acc (rm/forms-of ctx view (get ents-of src []))))
    {}
    srcs))

(def CALLS-DEFN String "calls-defn")

(def IS-ROOT String "is-root")

(def IS-PRIV String "is-priv")

;; An edge key is already a Term — a minted node coordinate or a "src#leaf"
;; string — so the Datalog EDB
;; is built straight from propositions and no id interning (and no inverse map)
;; stands between a query answer and the identity it names.
(defn- edge-propositions
  [edges (Vec Any)
   predicate String] (Vec Any)
  (mapv (fn [e Any] Any (t/triple (nth e 0) predicate (nth e 1))) edges))

(defn blast-closure! [edges (Vec Any)] (Map Keyword Any)
  (let [db (d/run-rules! (edge-propositions edges CALLS-DEFN)
             [(d/rule "reaches"
                [(d/variable "x") (d/variable "y")]
                [(d/relation-literal d/triple-relation
                   [(d/variable "x") (d/constant CALLS-DEFN) (d/variable "y")])])
              (d/rule "reaches"
                [(d/variable "x") (d/variable "z")]
                [(d/relation-literal d/triple-relation
                   [(d/variable "x") (d/constant CALLS-DEFN) (d/variable "y")])
                 (d/relation-literal "reaches"
                   [(d/variable "y") (d/variable "z")])])])
        reaches (set (mapv (fn [row Any] Any
                                                                                 [(nth row 0) (nth row 1)]) (vec (d/facts db "reaches"))))
        blast (reduce (fn
                        [m (Map Any Any)
                         row Any] (Map Any Any)
                        (let [x (nth row 0)
                              y (nth row 1)]
                          (assoc m y (conj (get m y #{}) x)))) {} (vec reaches))]
    {:reaches reaches :blast blast}))

(defn dead-private-bindings!
  [cg (Map Keyword Any)
   privacy Any] (Set Any)
  (let [defn-meta (get cg :defn-meta {})
        edges (get cg :edges [])
        marks (mapv (fn [leaf Any] Any
                                                                                (t/triple leaf (if (= :private (get privacy leaf)) IS-PRIV IS-ROOT) leaf)) (vec (set (keys defn-meta))))
        db (d/run-strata-db! (d/edb (vec (concat (edge-propositions edges CALLS-DEFN) marks))) [[(d/rule "live" [(d/variable "x")] [(d/relation-literal d/triple-relation [(d/variable "x") (d/constant IS-ROOT) (d/variable "x")])]) (d/rule "live" [(d/variable "y")] [(d/relation-literal d/triple-relation [(d/variable "x") (d/constant CALLS-DEFN) (d/variable "y")]) (d/relation-literal "live" [(d/variable "x")])])] [(d/rule "dead" [(d/variable "p")] [(d/relation-literal d/triple-relation [(d/variable "p") (d/constant IS-PRIV) (d/variable "p")]) (d/negated-literal "live" [(d/variable "p")])])]])]
    (set (vec (keep (fn [row Any] Any (nth row 0)) (vec (d/facts db "dead")))))))

;; ------------------------------------------------------------ call-edges ---

;; ALL resolved reference symbols in a subtree — any position: head call,

;; value-pass, threaded step, or executable body. Type positions are resolved
;; separately and therefore never create false call edges. Every value reference
;; to a defn is a

;; blast dependency.

;; `#"…"` cannot cross the graph-edit datum channel (EDN reader), so these two

;; patterns are re-pattern defs hoisted to the top level — compiled once at load,

;; exactly like the literals they replace.

;; PER-DEF NOTES (the graph-edit datum channel carries FORMS, not text, so a

;; comment cannot ride inside an authored form; the load-bearing prose lives

;; here instead — same convention as src/pull.bclj).

;; ---------------------------------------------------------------------------

;;   src-label

;;     The module label for a src path when the file has no ns form: its basename,

;;     extension stripped.

;;   defn-meta-of

;;     {leaf -> {:key :file :module :name}} over every top-level binding in the bound

;;     corpus, in srcs order then context order — `into {}` semantics, so a later entry

;;     for the same leaf wins, exactly as before.

;;   callers-of

;;     [[caller-leaf body-node] ...] — the top-level defns (and extend-type /

;;     extend-protocol method bodies) whose interiors are searched for calls.

;;   call-edges

;;     {:defn-meta {leaf -> {...}} :edges [[caller-leaf callee-leaf]] :defn-set #{leaf}}

;;     — the server joins footprint @concern->@node against :edges; the CLI maps

;;     leaf -> :key for JSON.

;;   binding-privacy

;;     -------------------------------------------------------------- privacy ----

;;     A top-level `def-`/`defn-` is PRIVATE; every other top-level value binding is

;;     PUBLIC — a reachability ROOT. Keyed on the binding NODE, so a private `helper`

;;     in module A stays distinct from a public `helper` in module B.

;;   ent!

;;     --------------------------------------------------------------- datalog ---

;;     Intern an arbitrary hashable edge key as an entity in the throwaway store.

;;   blast-closure!

;;     blast(D) = {x | x transitively calls D} — D's transitive callers. Edge keys

;;     are any hashable (node ids on the warm path, "src#leaf" strings for JSON).

;;     Returns {:reaches #{[x y]} :blast {callee -> #{transitive-callers}}}.

;;   dead-private-bindings!

;;     The identity-keyed stratified-Datalog code query: over the scope-correct call

;;     graph, the PRIVATE top-level bindings UNREACHABLE from any PUBLIC binding.

;;     `privacy` maps leaf -> :public|:private; a leaf absent from it (e.g. a

;;     protocol method) is treated as a non-private root and is never dead.
