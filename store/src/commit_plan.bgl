#lang beagle

;; ============================================================================
;; commit-plan — pure commit-sequencer decisions.
;; ============================================================================
;; Store snapshots and proposed writes enter explicitly. Mutation, server
;; locks, queues, futures, promises, fsync, group commit, and dynamic vars stay
;; in the server runtime.
;; ============================================================================
(ns commit-plan (:require [clojure.string :as str] [store.types :as t]))


(defn version-conflict?
  [(single Bool) (base-version Int) (expected-version Int?)] Bool
  (if (nil? expected-version)
    false
    (and single (> base-version expected-version))))

(defn expected-value-match? [(live-values (Set Int)) (expected-value Int?)] Bool
  (if (nil? expected-value) false (contains? live-values expected-value)))

(defrecord CommitIntent
  [(index Int)
   (pred String)
   (kind Keyword)
   (r String)
   (single Bool)
   (base-version Int)
   (expected-version Int?)
   (live-values (Set Int))
   (expected-value Int?)
   (cycle Bool)])

(defn commit-plan
  [(head-version Int) (intents (Vec CommitIntent))] (Map Keyword Any)
  (loop [(remaining (Vec CommitIntent)) intents (writes (Vec Any)) [] (idempotent (Vec String)) []]
    (if (empty? remaining)
      {:writes writes :idempotent idempotent}
      (let [(intent CommitIntent) (first remaining) (pred String) (:pred intent)]
        (cond
          (version-conflict? (:single intent)
            (:base-version intent)
            (:expected-version intent))
          {:reject
           :conflict
           :version
           head-version
           :at
           (:index intent)
           :pred
           pred}
          (:cycle intent)
          {:reject
           [(str pred " cycle")]
           :version
           head-version
           :at
           (:index intent)
           :pred
           pred}
          (and (not (:single intent))
            (expected-value-match? (:live-values intent)
              (:expected-value intent)))
          (recur (vec (rest remaining)) writes (conj idempotent pred))
          :else
          (recur (vec (rest remaining))
            (conj writes {:pred pred :kind (:kind intent) :r (:r intent)})
            idempotent))))))

(defrecord GroupBatchItem [(path String?)])

(defrecord GroupBatch [(path String?) (indices (Vec Int))])

(defn- group-index [(groups (Vec GroupBatch)) (path String?)] Int?
  (loop [(remaining (Vec GroupBatch)) groups (index Int) 0]
    (if (empty? remaining)
      nil
      (if (= (:path (first remaining)) path)
        index
        (recur (vec (rest remaining)) (inc index))))))

(defn group-batch-plan [(items (Vec GroupBatchItem))] (Vec GroupBatch)
  (loop [(remaining (Vec GroupBatchItem)) items (index Int) 0 (groups (Vec GroupBatch)) []]
    (if (empty? remaining)
      groups
      (let [(item GroupBatchItem) (first remaining) (group-index Int?) (group-index groups (:path item))]
        (if (nil? group-index)
          (recur (vec (rest remaining))
            (inc index)
            (conj groups (->GroupBatch (:path item) [index])))
          (let [(group GroupBatch) (nth groups group-index)]
            (recur (vec (rest remaining))
              (inc index)
              (assoc groups
                group-index
                (->GroupBatch (:path group) (conj (:indices group) index))))))))))

(defrecord LeaseSnapshot [(holder String) (exp Int) (epoch Int)])

(defn lease-expired? [(lease LeaseSnapshot?) (now-ms Int)] Bool
  (if (nil? lease) false (<= (:exp lease) now-ms)))

(defn valid-lease-request?
  [(holder Any) (resource Any) (ttl-ms Any) (now-ms Int) (max-ms Int)] Bool
  (and (string? holder)
    (not (str/blank? holder))
    (not (str/includes? holder "|"))
    (string? resource)
    (not (str/blank? resource))
    (integer? ttl-ms)
    (pos? ttl-ms)
    (<= ttl-ms (- max-ms now-ms))))

(defn valid-lease-epoch? [(epoch Any) (max-epoch Int)] Bool
  (and (integer? epoch) (pos? epoch) (<= epoch max-epoch)))

(defn lease-fence-ok?
  [(lease LeaseSnapshot?) (holder Any) (epoch Any) (now-ms Int)] Bool
  (and (not (nil? lease))
    (> (:exp lease) now-ms)
    (= (:holder lease) holder)
    (= (:epoch lease) epoch)))

(defn lease-held? [(lease LeaseSnapshot?) (now-ms Int)] Bool
  (if (nil? lease) false (> (:exp lease) now-ms)))

(defn lease-grant-decision
  [(lease LeaseSnapshot?)
   (holder Any)
   (resource Any)
   (ttl-ms Any)
   (now-ms Int)
   (max-ms Int)
   (version Int)]
  (Map Keyword Any)
  (cond
    (not (valid-lease-request? holder resource ttl-ms now-ms max-ms))
    {:reject :invalid-lease-request :version version}
    (and (lease-held? lease now-ms) (not= (:holder lease) holder))
    {:reject :held :holder (:holder lease) :exp (:exp lease) :version version}
    :else
    {:persist true}))

(defn lease-renew-decision
  [(lease LeaseSnapshot?)
   (holder Any)
   (resource Any)
   (expected-epoch Any)
   (ttl-ms Any)
   (now-ms Int)
   (max-ms Int)
   (max-epoch Int)
   (version Int)]
  (Map Keyword Any)
  (cond
    (or (not (valid-lease-request? holder resource ttl-ms now-ms max-ms))
      (not (valid-lease-epoch? expected-epoch max-epoch)))
    {:reject :invalid-lease-request :version version}
    (and (lease-held? lease now-ms)
      (= (:holder lease) holder)
      (= (:epoch lease) expected-epoch))
    {:persist true}
    :else
    {:reject :fence-lost :version version}))

(defn lease-release-decision
  [(lease LeaseSnapshot?)
   (holder Any)
   (epoch Any)
   (require-epoch Bool)
   (version Int)]
  (Map Keyword Any)
  (if (and (not (nil? lease)) (= (:holder lease) holder) (or (not require-epoch) (= (:epoch lease) epoch)))
    {:retract true}
    {:ok version :noop true}))

(defrecord GroupFlushPolicy [(min-items Int) (drain-limit Int)])

(defn group-flush-policy [(pending-count Int)] GroupFlushPolicy
  (->GroupFlushPolicy 1 2147483647))

(defn group-flush-ready? [(policy GroupFlushPolicy) (batch-count Int)] Bool
  (>= batch-count (:min-items policy)))

(defn queue-admission-decision [(deferred Bool)] Keyword
  (if deferred :defer :await))

(defn group-lock-order [] (Vec Keyword) [:group-io :append-admission])

(defn snapshot-replay-decision [(enabled Bool) (validation-reason Any)] Keyword
  (if (or (not enabled) (some? validation-reason)) :fold :replay))

(defn boot-install-decision
  [(candidate-present Bool)
   (verification-enabled Bool)
   (verification-ok Bool)]
  Keyword
  (if (and candidate-present (or (not verification-enabled) verification-ok))
    :snapshot
    :fold))

;; A closed record, not a map: Native Core cannot lower a keyword access into
;; an open map, and this decision is read by the snapshot boot path.
(defrecord SidecarValidation [(reason Keyword?) (label Any)])

(defn sidecar-validation-decision
  [(sidecar-map Bool)
   (seq-valid Bool)
   (watermark-valid Bool)
   (watermark-agrees Bool)
   (log-set-matches Bool)
   (offsets-valid Bool)
   (stamped Bool)
   (fingerprint-computable Bool)
   (fingerprint-matches Bool)
   (bad-identity Any)
   (past-eof Any)]
  SidecarValidation
  (cond
    (not sidecar-map)
    (->SidecarValidation :no-sidecar nil)
    (not seq-valid)
    (->SidecarValidation :seq-malformed nil)
    (not watermark-valid)
    (->SidecarValidation :watermark-malformed nil)
    (not watermark-agrees)
    (->SidecarValidation :watermark-disagrees nil)
    (not log-set-matches)
    (->SidecarValidation :log-set-mismatch nil)
    (not offsets-valid)
    (->SidecarValidation :offset-malformed nil)
    (not stamped)
    (->SidecarValidation :unstamped nil)
    (not fingerprint-computable)
    (->SidecarValidation :fingerprint-uncomputable nil)
    (not fingerprint-matches)
    (->SidecarValidation :fingerprint-mismatch nil)
    (some? bad-identity)
    (->SidecarValidation :identity-mismatch bad-identity)
    (some? past-eof)
    (->SidecarValidation :past-eof past-eof)
    :else
    (->SidecarValidation nil nil)))

(defn reload-entry-decision
  [(nonblocking-if-active Bool) (active-reloads Int)] Keyword
  (if (and nonblocking-if-active (pos? active-reloads))
    :in-progress
    :participate))

(defn reload-watermark-decision
  [(split-logs Bool) (from-tx Int) (tail-max Int) (log-max Int)] Keyword
  (if split-logs
    (if (< log-max from-tx) :refused :whole)
    (cond (> tail-max from-tx) :tail (< log-max from-tx) :refused :else :whole)))

(defn reload-install-decision
  [(candidate-mode Keyword)
   (same-target Bool)
   (exact-base Bool)
   (generation-advanced Bool)
   (stamps-converged Bool)]
  Keyword
  (cond
    (= candidate-mode :raced)
    :retry
    (and same-target exact-base (= candidate-mode :refused))
    :refused
    (and same-target exact-base (= candidate-mode :install))
    :installed
    (and same-target generation-advanced stamps-converged)
    :superseded
    :else
    :retry))

(defn reload-result-decision
  [(result Keyword) (attempt Int) (max-attempts Int)] Keyword
  (if (= result :retry)
    (if (< attempt (dec max-attempts)) :retry :exhausted)
    :return))

(defn migrate-input-plan [(raw (Vec Any))] (Map Keyword Any)
  (let [flat-max-tx (reduce max 0 (map (fn [(line Any)] Int (let [tx (get line :tx)] (if (int? tx) tx 0))) raw)) asserts (filterv (fn
                                                                                                                                    [(line Any)]
                                                                                                                                    Bool
                                                                                                                                    (boolean (and (get line :l) (get line :p) (get line :r)))) raw)]
    {:flat-max-tx flat-max-tx :asserts asserts}))

(defn migrate-schema-plan
  [(predicates (Vec String))
   (card-only (Vec String))
   (by-pred (Set String))
   (schema-preds (Set String))]
  (Map Keyword Any)
  {:domain
   (filterv (fn [(pred String)] Bool (not (contains? schema-preds pred)))
     predicates)
   :card-only
   (filterv (fn [(pred String)] Bool (and (not (contains? schema-preds pred)) (not (contains? by-pred pred))))
     card-only)})

(defn migrate-kernel-seed-plan
  [(single-valued (Vec String))
   (schema-preds (Set String))
   (cmap (Map String Bool))
   (current-single (Set String))]
  (Vec String)
  (filterv (fn [(pred String)] Bool (and (not (contains? schema-preds pred)) (not (contains? cmap pred)) (not (contains? current-single pred))))
    single-valued))

(defn tail-input-plan
  [(lines (Vec Any)) (schema-preds (Set String))] (Map Keyword Any)
  (let [valid (filterv (fn [(line Any)] Bool (boolean (and (get line :l) (get line :p) (get line :r) (int? (get line :tx)) (not (contains? schema-preds (get line :p)))))) lines) max-tx (reduce max 0 (map (fn
                                                                                                                                                                                                              [(line Any)]
                                                                                                                                                                                                              Int
                                                                                                                                                                                                              (get line :tx)) valid))]
    {:valid valid :max-tx max-tx}))

(defn tail-keyed-latest
  [(single-preds (Set String)) (lines (Vec Any))] (Map Any Any)
  (reduce (fn [(latest (Map Any Any)) (line Any)] (Map Any Any) (let [(pred String) (get line :p) (key Any) (if (contains? single-preds pred) [(get line :l) pred] [(get line :l) pred (get line :r)]) (previous Any) (get latest key) (previous-tx Any) (if (nil? previous) nil (get previous :tx)) (line-tx Any) (get line :tx)] (if (and (int? previous-tx) (int? line-tx) (>= previous-tx line-tx)) latest (assoc latest key line))))
    {}
    lines))

(defrecord TailPredicatePlan
  [(pred String) (action Keyword) (cardinality String) (value-kind String)])

(defn tail-predicate-plan
  [(domain (Vec String))
   (card-only (Vec String))
   (single-preds (Set String))
   (declared-preds (Set String))
   (current-cardinality (Map String String))
   (link-preds (Set String))]
  (Vec TailPredicatePlan)
  (into []
    (concat (map (fn [(pred String)] TailPredicatePlan (let [(want String) (if (contains? single-preds pred) "single" "multi") (action Keyword) (cond (not (contains? declared-preds pred)) :define (not= want (get current-cardinality pred)) :update :else :keep) (value-kind String) (if (contains? link-preds pred) "ref" "literal")] (->TailPredicatePlan pred action want value-kind))) domain)
      (map (fn [(pred String)] TailPredicatePlan (let [(want String) (if (contains? single-preds pred) "single" "multi") (action Keyword) (if (not= want (get current-cardinality pred)) :define :keep)] (->TailPredicatePlan pred action want "literal")))
        card-only))))

(defn tail-fact-decision
  [(retract Bool) (single Bool) (value-present Bool)] (Map Keyword Keyword)
  (cond
    retract
    {:action :retract :selection (if single :all :matching)}
    (or single (not value-present))
    {:action :assert :selection :none}
    :else
    {:action :keep :selection :none}))
