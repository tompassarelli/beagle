#lang beagle/clj

;; ============================================================================
;; resolve-mint — THE MINT/AUTHOR LAYER: a new form enters the store as
;; asserted structural propositions.
;; ============================================================================
;; Stage M1 Cut I of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). This is the inverse of
;; facts-roundtrip.rkt's datum->facts: a Clojure EDN datum (the structured edit
;; spec an agent emits, e.g. `(defn add-two [(x Int)] Int (+ x 2))`) is
;; walked into FRESH entities carrying `kind`/`v`/`fN` propositions, with
;; qualified symbols stored as `qualifier` + leaf `name`, and registered in file->ents so the
;; projection emits them. That is what makes add-def / set-body graph operations
;; rather than text splices; the renderer reconstructs purely from
;; fN/tail, so a minted subtree round-trips byte-stable and any reference in it
;; resolves through the SAME lexical walk.
;;
;; STRUCTURAL ADAPTATION (Cuts B–H's rule, unchanged): STATE IS A PARAMETER.
;; resolve.clj's ^:dynamic vars cannot change namespace (server.clj and
;; server tests `binding` them by qualified name), so the store, tx and the
;; predicate value-ids arrive HERE as one explicit `Mint` record that resolve.clj
;; builds from the dynamic state at call time. `ents` is the file->ents ATOM
;; ITSELF (not a snapshot) — register! must mutate the var the projection reads.
;;
;; PER-DEF NOTES (the rationale that rode with the originals):
;;   register!    every minted entity is appended to file->ents[src] so
;;                extract-file! emits it. THE registration.
;;   mint-leaf!   one scalar leaf: asserted `kind` and `v` propositions.
;;   fN-facts     the LIVE, ordered fN assertion occurrences of a parent — the body slots
;;                set-body / replace-in-body address. Integer fN only (a CRDT
;;                order key is a WRAPPER-level spelling; body edges stay flat),
;;                matching the original's #"f\d+" exactly.
;;   retire-fact! retract a live structural proposition with NO replacement value
;;                (retiring a wrapper/body fN edge). The kernel records the
;;                resulting withdrawal against the newest live equal assertion
;;                occurrence; no domain proposition is manufactured.
;;
;; The regex literal is hoisted to a top-level `re-pattern` def (resolve_read's
;; rule: a #"…" literal cannot cross the graph-edit datum channel), compiled
;; once exactly as the literal was.
;;
;; Consumed by resolve.clj — the emitted out/resolve_mint.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-mint
  (:require [clojure.string :as str]
    [resolve-ident :as ri]
    [resolve-core :as rc]
    [resolve-read :as rr]
    [resolve-binds :as rb]
    [resolve-modules :as rm]
    [resolve-render :as rv]))


(def FN-RE Regex (re-pattern "f\\d+"))

;; The mint environment: the dynamic store state of resolve.clj, handed over
;; explicitly. `ents` is typed (Atom Any) because Beagle cannot name "a map from
;; src string to a vector of entity ids" more precisely than Any — the same
;; boundary Cut G's xres/tres/ares and Cut H's corpus tables sit on.
(defrecord Mint
  [(ctx ri/Graph)
   (KIND Any)
   (Vp Any)
   (ents (Atom Any))
   (view Any)
   (BOUND Any)
   (REFERS Any)
   (FIXED Any)])

;; -> [[N assertion-occurrence child-node] …]: one row per LIVE fN edge, in slot order.
(defrecord FnEdge [(idx Int) (cid Any) (child Any)])

(defn register! [(m Mint) (src String) (e Any)] Any
  (let [ents (:ents m)]
    (do
      (swap! ents
        (fn [(tbl Any)] Any (assoc tbl src (conj (get tbl src []) e))))
      e)))

(defn- mint-leaf-on!
  [(m Mint) (builder Any) (src String) (kind Any) (v Any)] Any
  (let [ctx (:ctx m) e (register! m src (ri/mint! ctx builder))]
    (do
      (ri/assert-on! builder e (:KIND m) (ri/literal! kind))
      (ri/assert-on! builder e (:Vp m) (ri/literal! v))
      e)))

(defn mint-leaf! [(m Mint) (src String) (kind Any) (v Any)] Any
  (let [ctx (:ctx m) builder (ri/open ctx) e (mint-leaf-on! m builder src kind v)]
    (do (ri/commit! ctx builder) e)))

(defn- mint-symbol-on! [(m Mint) (builder Any) (src String) (d Any)] Any
  (let [qualifier (namespace d)]
    (if (nil? qualifier)
      (mint-leaf-on! m builder src "symbol" (name d))
      (let [ctx (:ctx m) e (register! m src (ri/mint! ctx builder))]
        (do
          (ri/assert-on! builder e (:KIND m) (ri/literal! "symbol"))
          (ri/assert-on! builder e "qualifier" (ri/literal! qualifier))
          (ri/assert-on! builder e "name" (ri/literal! (name d)))
          e)))))

(defn- clj-meta->beagle-meta [(mt Any)] Any
  (cond
    (and (= 1 (count mt)) (contains? mt :tag) (symbol? (get mt :tag)))
    (get mt :tag)
    (and (= 1 (count mt)) (true? (val (first mt))))
    (key (first mt))
    :else
    mt))

(defn- reader-meta [(d Any)] Any
  (if (instance? clojure.lang.IObj d)
    (not-empty (apply dissoc (meta d) [:line :column :end-line :end-column :file]))
    nil))

;; The MINT. Every branch below re-encodes a Clojure EDN token the way beagle's own
;; Racket reader would have read it — the corpus convention, not clojure.edn's:
;;   nil      -> the SYMBOL "nil" (a kind="nil" leaf means Racket '() and renders as
;;               `()`, which the type-checker rejects).
;;   :foo     -> a SYMBOL leaf with the colon RETAINED (beagle has no keyword syntax;
;;               a keyword-kind leaf decodes with `#:` reader spelling, corrupting
;;               colon-prefixed grammar markers such as `:raises`).
;;   true/false -> SYMBOL leaves (the corpus has zero kind="bool" leaves).
;;   [..]/{..}  -> a `list` headed by #%brackets / #%map, exactly what --emit-edn
;;               produces, keeping the projection lossless.
;;   #"…"/#{…}  -> the `(#%regex "pat")` / `(#%set e…)` list node the renderer inverts
;;               back to the reader literal. Without this a regex fell to the :else
;;               leaf and was pr-str'd — `#","` became the STRING `"#\",\""` (EXP-025).
;; Evaluation ORDER is load-bearing: the parent entity is allocated BEFORE its children
;; and each child's slot value before the child itself, yielding deterministic
;; file-local node identities and stable projection order.
(defn- mint-datum-on! [(m Mint) (builder Any) (src String) (d Any)] Any
  (let [mt (reader-meta d)]
    (if (some? mt)
      (mint-datum-on! m
        builder
        src
        (list (symbol "#%meta") (clj-meta->beagle-meta mt) (with-meta d nil)))
      (let [reuse-node (rc/reuse-node-id d)]
        (if (some? reuse-node)
          reuse-node
          (cond
            (nil? d)
            (mint-leaf-on! m builder src "symbol" "nil")
            (symbol? d)
            (mint-symbol-on! m builder src d)
            (keyword? d)
            (mint-leaf-on! m builder src "symbol" (str d))
            (string? d)
            (mint-leaf-on! m builder src "string" d)
            (boolean? d)
            (mint-leaf-on! m builder src "symbol" (if d "true" "false"))
            (char? d)
            (mint-leaf-on! m builder src "char" (str d))
            (number? d)
            (mint-leaf-on! m builder src "number" (str d))
            (or (list? d) (seq? d) (vector? d) (map? d))
            (let [(ctx Any) (:ctx m) (head Any) (cond (vector? d) [(symbol "#%brackets")] (map? d) [(symbol "#%map")] :else []) (elems (Vec Any)) (vec (concat head (if (map? d) (apply concat (seq d)) (seq d)))) (e Any) (register! m src (ri/mint! ctx builder))]
              (do
                (ri/assert-on! builder e (:KIND m) (ri/literal! "list"))
                (doseq [(i Int) (range (count elems))]
                  (ri/assert-on! builder
                    e
                    (str "f" i)
                    (mint-datum-on! m builder src (nth elems i))))
                e))
            (instance? java.util.regex.Pattern d)
            (mint-datum-on! m builder src (list (symbol "#%regex") (.pattern d)))
            (set? d)
            (mint-datum-on! m builder src (apply list (cons (symbol "#%set") (seq d))))
            :else
            (mint-leaf-on! m builder src "other" (pr-str d))))))))

;; ONE source context per minted subtree: every coordinate in it is durable on that
;; source context's own assertions, and a half-minted subtree can never be observed.
(defn mint-datum! [(m Mint) (src String) (d Any)] Any
  (let [ctx (:ctx m) builder (ri/open ctx) root (mint-datum-on! m builder src d)]
    (do (ri/commit! ctx builder) root)))

(defn fN-facts [(m Mint) (parent Any)] (Vec Any)
  (let [ctx (:ctx m) rows (reduce (fn
                                    [(acc (Vec FnEdge)) (cid Any)] (Vec FnEdge) (let [(p Any) (ri/predicate-at ctx cid) (r Any) (ri/value-at ctx cid)] (if (and (string? p) (some? (re-matches FN-RE (str p)))) (let [n (parse-long (subs (str p) 1))] (if (nil? n) acc (conj acc (->FnEdge n cid r)))) acc))) [] (ri/by-subject ctx parent))]
    (mapv (fn [(e FnEdge)] Any [(:idx e) (:cid e) (:child e)])
      (sort-by (fn [(e FnEdge)] Int (:idx e)) rows))))

;; The supersedes edge is gone (ruling GAP 3): retiring an edge appends a
;; retraction occurrence, and the kernel withdrawal relation records which live
;; equal assertion occurrence it cancels.
(defn retire-fact! [(m Mint) (oldc Any)] Any
  (ri/retire! (:ctx m) oldc))

;; ---------------------------------------------------------------------------
;; the no-capture invariant — the LEXICAL DUAL of the def-vs-def collision guard
;; ---------------------------------------------------------------------------
;; Renaming def B to `new` is UNSOUND if a reference to B would, after rendering
;; as `new`, be captured by a LOCAL binding `new` in scope at that reference —
;; e.g. (def src 1)(defn f [dst] (+ dst src)), rename src->dst yields (+ dst dst).
;; A reference that resolves to B (unqualified, name-tracking — not a
;; :rename-fixed or x/qualified ref, which don't render as a bare `new`) is
;; captured iff `new` is in its scope. capture-refs reuses walk's EXACT context
;; construction (param-binds, let-bind-pairs, for-bind-pairs,
;; match-pat-binds, context-of), so the check is scope-precise — the two
;; walkers must agree or a rename is either wrongly rejected or wrongly allowed.
;;
;; Scope is a (Vec Any) of contexts here, innermost first, as in Cut G's walk!
;; (the original threaded a cons-list; resolve.clj's wrapper vecs it). `new` is
;; spelled `newnm` — Beagle reserves nothing, but `new` reads as host interop.
;; The Int-typing sentinel is gone with the widening: a node id is a Term.
(defn- nn [(e Any)] Any e)

(defn- push [(context Any) (scope (Vec Any))] (Vec Any) (into [context] scope))

;; a reference that will render the binding's CURRENT name: not :rename-fixed
;; (keeps its own spelling) and not x/qualified (renders alias/, so a bare local
;; cannot capture it).
(defn- renders-as-tracked-name? [(m Mint) (node Any)] Bool
  (and (empty? (ri/by-subject-predicate (:ctx m) (nn node) (:FIXED m)))
    (nil? (rr/pred-val (:ctx m) (:view m) node "qualifier"))))

(defn capture-refs
  [(m Mint) (node Any) (scope (Vec Any)) (B Any) (newnm Any)] (Vec Any)
  (let [ctx (:ctx m) view (:view m) BOUND (:BOUND m) REFERS (:REFERS m) k (rr/kind-of ctx view node)]
    (cond
      (= "symbol" k)
      (let [target (rr/refers-target ctx view BOUND REFERS node)]
        (if (and (some? target)
              (= B (rv/ultimate ctx view BOUND REFERS target))
              (renders-as-tracked-name? m node)
              (some? (some (fn [(context Any)] Any (get context newnm)) scope)))
          [node]
          []))
      (= "list" k)
      (let [kids (rr/ordered-children ctx node)
            head (str (rr/head-sym ctx view node))
            brk? (fn [(candidate Any)] Bool (rb/brackets? ctx view candidate))
            capture-all (fn
                          [(nodes (Vec Any)) (active-scope (Vec Any))] (Vec Any)
                          (reduce (fn [(acc (Vec Any)) (child Any)] (Vec Any)
                                    (into acc
                                      (capture-refs m child active-scope B newnm)))
                            []
                            nodes))
            cap-signature (fn
                            [(signature Any) (arity-scope (Vec Any))] (Vec Any)
                            (let [params (get signature :params)
                                  context (rb/context-of ctx view
                                          (if (nil? params)
                                            []
                                            (rb/param-binds ctx view params)))
                                  constraints (if (nil? params)
                                                []
                                                (rb/param-constraint-nodes ctx view params))
                                  or-vals (if (nil? params)
                                            []
                                            (reduce (fn
                                                      [(acc (Vec Any))
                                                       (binding Any)]
                                                      (Vec Any)
                                                      (into acc
                                                        (rb/collect-or-vals ctx view binding)))
                                              []
                                              (vec (rest (rr/ordered-children ctx params)))))
                                  body (vec (get signature :body))]
                              (into
                                (into
                                  (capture-all constraints arity-scope)
                                  (capture-all or-vals arity-scope))
                                (capture-all body (push context arity-scope)))))
            cap-arity (fn
                        [(forms (Vec Any))
                         (macro? Bool)
                         (arity-scope (Vec Any))]
                        (Vec Any)
                        (cap-signature
                          (rb/signature-parts
                            ctx view forms macro? false)
                          arity-scope))
            cap-field-constraints (fn
                                    [(fields Any)
                                     (field-scope (Vec Any))]
                                    (Vec Any)
                                    (if (or (nil? fields) (not (brk? fields)))
                                      []
                                      (capture-all
                                        (rb/param-constraint-nodes ctx view fields)
                                        field-scope)))
            cap-method-constraints (fn
                                     [(raw-method Any)
                                      (method-scope (Vec Any))]
                                     (Vec Any)
                                     (let [method (rr/unwrap-meta ctx view raw-method)]
                                       (if (= "list" (rr/kind-of ctx view method))
                                         (let [signature (rb/signature-parts ctx view
                                                           (vec (rest (rr/ordered-children ctx method)))
                                                           false
                                                           false)
                                               params (get signature :params)]
                                           (if (nil? params)
                                             []
                                             (capture-all
                                               (rb/param-constraint-nodes ctx view params)
                                               method-scope)))
                                         [])))
            cap-protocol-method-constraints (fn
                                              [(raw-method Any)
                                               (method-scope (Vec Any))]
                                              (Vec Any)
                                              (let [parts (rm/protocol-method-parts
                                                            ctx view raw-method)
                                                    params (get parts :params)]
                                                (if (nil? params)
                                                  []
                                                  (capture-all
                                                    (rb/param-constraint-nodes
                                                      ctx view params)
                                                    method-scope))))
            cap-type-def (fn
                           [(forms (Vec Any)) (type-scope (Vec Any))] (Vec Any)
                           (let [type-head (str (rr/sym-val ctx view (nth forms 0 nil)))
                                 name-index (rc/type-name-index type-head
                                              (rr/sym-val ctx view (nth forms 1 nil)))
                                 members (vec (drop (inc name-index) forms))]
                             (cond
                               (= "defrecord" type-head)
                               (cap-field-constraints (nth forms 2 nil) type-scope)
                               (= "deftype" type-head)
                               (reduce (fn
                                         [(acc (Vec Any))
                                          (raw-member Any)]
                                         (Vec Any)
                                         (into acc
                                           (cap-method-constraints raw-member type-scope)))
                                 (cap-field-constraints (nth forms 2 nil) type-scope)
                                 (vec (drop 3 forms)))
                               (contains? #{"defprotocol" "definterface"} type-head)
                               (reduce (fn
                                         [(acc (Vec Any))
                                          (method Any)]
                                         (Vec Any)
                                         (into acc
                                           (cap-protocol-method-constraints
                                             method type-scope)))
                                 []
                                 members)
                               (= "defunion" type-head)
                               (reduce (fn
                                         [(acc (Vec Any))
                                          (raw-member Any)]
                                         (Vec Any)
                                         (let [parts (rm/union-member-parts ctx view raw-member)
                                               fields (get parts :fields)]
                                           (if (nil? fields)
                                             acc
                                             (into acc
                                               (cap-field-constraints fields type-scope)))))
                                 []
                                 members)
                               :else
                               [])))]
        (cond
          (contains? rc/TYPE-DEFS head)
          (cap-type-def kids scope)
          (contains? rc/PARAM-FORMS head)
          (let [after-name (if (contains? #{"defn" "defn-" "defmacro"} head)
                             (vec (drop 2 kids))
                             (vec (rest kids)))]
            (reduce (fn [(acc (Vec Any)) (signature Any)] (Vec Any)
                      (into acc
                        (cap-signature signature scope)))
              []
              (rb/executable-signatures
                ctx view head after-name)))
          (contains? rc/LET-FORMS head)
          (let [(bracket Any) (nth kids 1 nil)
                (pairs (Vec Any)) (if (and (some? bracket) (brk? bracket))
                                    (rb/let-bind-pairs ctx view bracket)
                                    [])
                (state (Vec Any)) (reduce (fn
                                            [(state (Vec Any))
                                             (pair Any)]
                                            (Vec Any)
                                            (let [(active-scope (Vec Any)) (nth state 0)
                                                 (captures (Vec Any)) (nth state 1)
                                                 (binds Any) (nth pair 0)
                                                 (value-node Any) (nth pair 1)
                                                 (or-vals Any) (nth pair 2)
                                                 (constraint Any) (nth pair 3 nil)
                                                 (after-defaults (Vec Any))
                                                 (into captures
                                                   (capture-all or-vals active-scope))
                                                 (after-constraint (Vec Any))
                                                 (if (some? constraint)
                                                   (into after-defaults
                                                     (capture-refs m constraint active-scope B newnm))
                                                   after-defaults)
                                                 (after-value (Vec Any))
                                                 (if (some? value-node)
                                                   (into after-constraint
                                                     (capture-refs m value-node active-scope B newnm))
                                                   after-constraint)]
                                             [(push
                                                (rb/context-of ctx view binds)
                                                active-scope)
                                              after-value]))
                                   [scope []]
                                   pairs)
                (final-scope (Vec Any)) (nth state 0)
                (binding-captures (Vec Any)) (nth state 1)]
            (into binding-captures
              (capture-all (vec (drop 2 kids)) final-scope)))
          (contains? rc/FOR-FORMS head)
          (let [(bracket Any) (nth kids 1 nil)
                (entries (Vec Any)) (if (and (some? bracket) (brk? bracket))
                                      (rb/for-bind-pairs ctx view bracket)
                                      [])
                (state (Vec Any)) (reduce (fn
                                            [(state (Vec Any))
                                             (entry Any)]
                                            (Vec Any)
                                            (let [(active-scope (Vec Any)) (nth state 0)
                                                 (captures (Vec Any)) (nth state 1)]
                                             (if (= :expr (nth entry 0))
                                               [active-scope
                                                (into captures
                                                  (capture-refs m
                                                    (nth entry 1)
                                                    active-scope
                                                    B
                                                    newnm))]
                                               (let [binds (nth entry 1)
                                                     value-node (nth entry 2)
                                                     or-vals (nth entry 3)
                                                     constraint (nth entry 4 nil)
                                                     after-defaults (into captures
                                                                      (capture-all
                                                                        or-vals
                                                                        active-scope))
                                                     after-constraint (if (some? constraint)
                                                                        (into after-defaults
                                                                          (capture-refs m
                                                                            constraint
                                                                            active-scope
                                                                            B
                                                                            newnm))
                                                                        after-defaults)
                                                     after-value (if (some? value-node)
                                                                   (into after-constraint
                                                                     (capture-refs m
                                                                       value-node
                                                                       active-scope
                                                                       B
                                                                       newnm))
                                                                   after-constraint)]
                                                 [(push
                                                    (rb/context-of ctx view binds)
                                                    active-scope)
                                                  after-value]))))
                                   [scope []]
                                   entries)
                (final-scope (Vec Any)) (nth state 0)
                (binding-captures (Vec Any)) (nth state 1)]
            (into binding-captures
              (capture-all (vec (drop 2 kids)) final-scope)))
          (contains? rc/MATCH-FORMS head)
          (reduce (fn [(acc (Vec Any)) (clause Any)] (Vec Any)
                    (if (brk? clause)
                      (let [clause-children (vec
                                             (rest
                                               (rr/ordered-children ctx clause)))
                            pattern (nth clause-children 0 nil)
                            body (vec (rest clause-children))
                            context (rb/context-of ctx view
                                    (rb/match-pat-binds ctx view pattern))]
                        (into
                          (into acc
                            (capture-refs m pattern scope B newnm))
                          (capture-all body (push context scope))))
                      acc))
            (capture-refs m (nth kids 1 nil) scope B newnm)
            (vec (drop 2 kids)))
          (= "letfn" head)
          (let [bracket (nth kids 1 nil)
                fnlists (if (and (some? bracket) (brk? bracket))
                          (vec
                            (filter
                              (fn [(form Any)] Bool
                                (= "list" (rr/kind-of ctx view form)))
                              (vec (rest (rr/ordered-children ctx bracket)))))
                          [])
                context (rb/context-of ctx view
                        (vec
                          (keep
                            (fn [(form Any)] Any
                              (nth (rr/ordered-children ctx form) 0 nil))
                            fnlists)))
                body-scope (push context scope)
                function-captures (reduce (fn
                                            [(acc (Vec Any))
                                             (form Any)]
                                            (Vec Any)
                                            (into acc
                                              (cap-arity
                                                (vec
                                                  (rest
                                                    (rr/ordered-children ctx form)))
                                                false
                                                body-scope)))
                                    []
                                    fnlists)]
            (into function-captures
              (capture-all (vec (drop 2 kids)) body-scope)))
          (contains? #{"extend-type" "extend-protocol"} head)
          (reduce (fn [(acc (Vec Any)) (raw-item Any)] (Vec Any)
                    (let [item (rr/unwrap-meta ctx view raw-item)]
                      (cond
                        (some? (rr/sym-val ctx view item))
                        acc
                        (= "list" (rr/kind-of ctx view item))
                        (let [method (rr/ordered-children ctx item)]
                          (into
                            (into acc
                              (capture-refs m
                                (nth method 0 nil)
                                scope
                                B
                                newnm))
                            (cap-arity
                              (vec (rest method))
                              false
                              scope)))
                        :else
                        acc)))
            []
            (vec (rest kids)))
          (= "extend" head)
          (let [tail (vec (rest kids))
                target (nth tail 0 nil)
                body (vec (drop 2 tail))
                initial (if (some? target)
                          (capture-refs m target scope B newnm)
                          [])]
            (into initial (capture-all body scope)))
          (= "as->" head)
          (let [init (nth kids 1 nil)
                name-node (nth kids 2 nil)
                context (rb/context-of ctx view
                        (if (some? (rr/sym-val ctx view name-node))
                          [(nn name-node)]
                          []))
                initial (if (some? init)
                          (capture-refs m init scope B newnm)
                          [])]
            (into initial
              (capture-all
                (vec (drop 3 kids))
                (push context scope))))
          :else
          (capture-all kids scope)))
      :else
      [])))

;; ---------------------------------------------------------------------------
;; the PROJECTION — a module's resolved structural propositions, back out as render EDN
;; ---------------------------------------------------------------------------
;; extract-lines! builds the structural projection rows; resolve.clj restores
;; scalar integers that share the local-node label space, then writes the rows.
;; The host owns that final interpretation because it can inspect the live graph
;; behind each emitted row. Content and order remain deterministic for renderer
;; and CLI consumers.
;;
;; Two filters, both load-bearing:
;;   #36  wrapper child edges are ALWAYS renumbered to consecutive CRDT paths.
;;        The projection rebuilds the head and surviving forms as
;;        f<path>~<tie>, which is the facts renderer's structural vocabulary.
;;        Previously this ran ONLY under deletes, so an inserted order key could
;;        leave a gap at the wrapper boundary.
;;   REACHABILITY  emit ONLY nodes reachable from the beagle-file wrapper via
;;        LIVE structural edges. A verb that WITHDRAWS a body/form fN assertion
;;        (set-body, upsert REPLACE) leaves the OLD subtree in file->ents with
;;        its parent edge retired — parentless ROOT CANDIDATES the renderer's
;;        edn-root may pick INSTEAD of the real wrapper (observed: a re-edited
;;        module rendered as just the orphaned old body). Skipped under the
;;        delete path, which has its own subtree machinery.
(def INTERNAL-PREDS (Set String)
  #{"refers_to"
    "keep_spelling"
    "qualifier"
    "ctor_prefix"
    "accessor_field"})

;; The projection environment. `ents` is a SNAPSHOT (@file->ents) — unlike Mint's
;; atom, nothing here mutates. wrapper-of / structural-descendants ride as closures: they
;; read the same dynamic state and stayed in resolve.clj with the delete
;; machinery (Cut H's Verb record carries the identical pair).
(defrecord Emit
  [(ctx ri/Graph)
   (view Any)
   (BOUND Any)
   (REFERS Any)
   (FIXED Any)
   (ents Any)
   (wrapper-of Any)
   (descendants Any)
   (deleted-forms Any)
   (deleted-subtree Any)])

(defn- emit-line! [(m Emit) (wrap Any) (e Any) (cid Any)] Any
  (let [(ctx Any) (:ctx m) (view Any) (:view m) (ps Any) (ri/predicate-at ctx cid) (r Any) (ri/value-at ctx cid)]
    (cond
      (and (some? wrap) (= e wrap) (string? ps) (rc/ord-pos? ps) (not= ps "f0"))
      nil
      (contains? INTERNAL-PREDS (str ps))
      nil
      (and (= ps "name") (= "symbol" (rr/kind-of ctx view e)))
      (str "["
        (ri/ordinal! ctx e)
        " \"v\" "
        (pr-str (rv/render-sym ctx view (:BOUND m) (:REFERS m) (:FIXED m) e))
        "]")
      (and (= ps "v")
        (some? (rr/refers-target ctx view (:BOUND m) (:REFERS m) e)))
      (str "["
        (ri/ordinal! ctx e)
        " \"v\" "
        (pr-str (rv/render-sym ctx view (:BOUND m) (:REFERS m) (:FIXED m) e))
        "]")
      (ri/literal? r)
      (str "[" (ri/ordinal! ctx e) " " (pr-str ps) " " (pr-str r) "]")
      :else
      (str "[" (ri/ordinal! ctx e) " " (pr-str ps) " " (ri/ordinal! ctx r) "]"))))

(defn extract-lines! [(m Emit) (src String)] (Vec Any)
  (let [(ctx Any) (:ctx m)
        (wrapf Any) (:wrapper-of m)
        (desc Any) (:descendants m)
        (dforms Any) (:deleted-forms m)
        (dsub Any) (:deleted-subtree m)
        (wrap Any) (wrapf src)
        (root Any) (if (empty? dforms) (wrapf src) nil)
        (live Any) (if (some? root) (desc root) nil)
        (ents (Vec Any)) (vec (get (:ents m) src []))
        (rows (Vec Any))
        (reduce (fn [(acc (Vec Any)) (e Any)] (Vec Any)
                  (if (or (contains? dsub e)
                        (and (some? live) (not (contains? live e))))
                    acc
                    (reduce (fn [(a (Vec Any)) (cid Any)] (Vec Any)
                              (let [(line Any) (emit-line! m wrap e cid)]
                                (if (nil? line) a (conj a line))))
                      acc
                      (ri/by-subject ctx e))))
          []
          ents)
        (children (Vec Any)) (if (some? wrap) (rr/ordered-children ctx wrap) [])
        (head Any) (first children)
        (forms (Vec Any))
        (vec (remove (fn [(f Any)] Bool (contains? dforms f))
               (vec (rest children))))
        (projected-children (Vec Any))
        (if (some? head) (into [head] forms) forms)
        (structural-lines (Vec Any))
        (mapv (fn [(i Int)] Any
                (let [child (nth projected-children i)
                      child-ordinal (ri/ordinal! ctx child)
                      predicate (rc/ord-str [(* (+ i 1) rc/ORD-STEP)] child-ordinal)]
                  (str "[" (ri/ordinal! ctx wrap) " " (pr-str predicate) " "
                    child-ordinal "]")))
          (vec (range (count projected-children))))]
    (into (into [(str "@file " src)] rows) structural-lines)))

;; author-emit! — the stderr report of an authoring run. The `binding [*out* *err*]`
;; stays in resolve.clj (a host dynamic var cannot change namespace), so this builds
;; the LINES it printed, in order; `detail` rides through as a VALUE, never str'd, so
;; println renders it exactly as the original did (a map prints unreadably either way).
(defn author-emit-lines
  [(op Any) (detail Any) (srcs (Vec String)) (outp Any)] (Vec Any)
  (let [f outp]
    (into [(str "================ authoring: " op " ================") detail]
      (mapv (fn [(s String)] Any (str "projected -> " (f s) "   <- " s))
        srcs))))

;; re-resolve! — after a mint the module context is stale (a new def, or a new body's
;; references), so recompute every module's three contexts and re-walk. The `binding`
;; of *xresolve*/*tresolve*/*aresolve* IS the dynamic scope and cannot move, so this
;; ports the portable half: the three per-src tables the re-walk reads. Idempotent —
;; bind! only adds an edge where one resolves.
(defn re-resolve-contexts
  [(srcs (Vec String)) (mdefs Any) (mtypes Any) (maccs Any)] (Map Keyword Any)
  (let [fd mdefs ft mtypes fa maccs]
    {:module-context
     (reduce (fn [(acc (Map Any Any)) (s String)] (Map Any Any) (assoc acc s (fd s)))
       {}
       srcs)
     :type-context
     (reduce (fn [(acc (Map Any Any)) (s String)] (Map Any Any) (assoc acc s (ft s)))
       {}
       srcs)
     :accessors
     (reduce (fn [(acc (Map Any Any)) (s String)] (Map Any Any) (assoc acc s (fa s)))
       {}
       srcs)}))

(def STRUCTURAL-SEG-RE Regex (re-pattern "seg\\d+"))

(def STRUCTURAL-COMMENT-RE Regex (re-pattern "comment\\d+"))

(def PATH-SPLIT-RE Regex (re-pattern "/"))

(defn wrapper-of [(ctx ri/Graph) (view Any) (ents Any) (src String)] Any
  (some (fn [(e Any)] Any (when (= "beagle-file" (rr/head-sym ctx view e)) e))
    (vec (get ents src []))))

(defn structural-kids [(ctx ri/Graph) (n Any)] (Vec Any)
  (vec (keep (fn [(cid Any)] Any (let [p (ri/predicate-at ctx cid) r (ri/target-at ctx cid)] (when (and (some? r) (string? p) (or (rc/ord-pos? p) (re-matches STRUCTURAL-SEG-RE p) (re-matches STRUCTURAL-COMMENT-RE p) (= p "tail"))) r))) (ri/by-subject ctx n))))

(defn structural-descendants [(ctx ri/Graph) (root Any)] (Set Any)
  (loop [seen (Set Any) #{} stack (Vec Any) [root]]
    (if (empty? stack)
      seen
      (let [n (peek stack)]
        (if (contains? seen n)
          (recur seen (pop stack))
          (recur (conj seen n) (into (pop stack) (structural-kids ctx n))))))))

(defn form-for-victim
  [(ctx ri/Graph)
   (view Any)
   (ents Any)
   (unwrap-def Any)
   (src String)
   (victim Any)]
  Any
  (some (fn [(f Any)] Any (let [d (unwrap-def f) children (rr/ordered-children ctx d) name-index (rc/type-name-index (rr/head-sym ctx view d) (rr/sym-val ctx view (nth children 1 nil))) outer (rr/unwrap-meta ctx view (nth children name-index nil)) leaf (if (= "list" (rr/kind-of ctx view outer)) (first (rr/ordered-children ctx outer)) outer) logical (rr/unwrap-meta ctx view leaf)] (when (= victim logical) f)))
    (rest (rr/ordered-children ctx (wrapper-of ctx view ents src)))))

(defn emit-env
  [(ctx ri/Graph)
   (view Any)
   (BOUND Any)
   (REFERS Any)
   (FIXED Any)
   (ents Any)
   (unwrap-def Any)]
  Emit
  (->Emit ctx
    view
    BOUND
    REFERS
    FIXED
    ents
    (fn [(src String)] Any (wrapper-of ctx view ents src))
    (fn [(root Any)] (Set Any) (structural-descendants ctx root))
    #{}
    #{}))

(def DEFAULT-RESOLVE-OUT Any nil)

(defn out-path [(src String)] String
  (str (or DEFAULT-RESOLVE-OUT (System/getenv "RESOLVE_OUT") "/tmp")
    "/resolved-"
    (last (str/split src PATH-SPLIT-RE))
    ".edn"))

(def DEFAULT-PROJECT-SRCS Any nil)

(defn emit-srcs [(srcs (Vec String))] (Vec String)
  (if (nil? DEFAULT-PROJECT-SRCS) srcs (vec DEFAULT-PROJECT-SRCS)))

(defn scope-match? [(module-name Any) (src String) (scope String)] Bool
  (let [seg? (fn [(m Any)] Bool (boolean (and m (or (= m scope) (str/ends-with? m (str "." scope))))))]
    (or (seg? src) (seg? (module-name src)))))

(defn scope->srcs
  [(module-name Any) (srcs (Vec String)) (scope String)] (Vec String)
  (vec (filter (fn [(src String)] Bool (scope-match? module-name src scope)) srcs)))

(defn out-path-for [(resolve-out Any) (src String)] String
  (str (or resolve-out DEFAULT-RESOLVE-OUT (System/getenv "RESOLVE_OUT") "/tmp")
    "/resolved-"
    (last (str/split src PATH-SPLIT-RE))
    ".edn"))

(defn emit-srcs-for [(project-srcs Any) (srcs (Vec String))] (Vec String)
  (if (nil? project-srcs) (emit-srcs srcs) (vec project-srcs)))
