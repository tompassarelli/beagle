#lang beagle/clj

;; ============================================================================
;; resolve-read — the view-relative READ layer over the fact graph.
;; ============================================================================
;; Stage M1 Cut B of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). Everything a reader needs to turn a
;; pile of facts back into an ordered syntax tree: which member of a live (l,p)
;; group the current VIEW elects, what a predicate says about a node, and the
;; node's children in CRDT-key order.
;;
;; WHY THE STORE IS A PARAMETER HERE AND A DYNAMIC VAR THERE. resolve.clj holds
;; `ctx`/`*view*`/`BOUND`/`REFERS`/`KIND` in ^:dynamic vars, and server.clj
;; plus server tests `binding` them by their QUALIFIED names (resolve/ctx,
;; resolve/*view*, ...). A dynamic var cannot be moved to another namespace
;; without breaking those: a `(def ctx rr/ctx)` alias copies the value (so
;; `binding` no longer reaches the reader) and a `:refer` alias leaves
;; `resolve/ctx` unresolvable (Clojure's qualified-symbol lookup is
;; findInternedVar, which ignores referred vars). So the VARS stay in resolve.clj
;; as the host state seam and the LOGIC moves here with the state passed
;; explicitly; resolve.clj keeps a one-line wrapper per name that reads the var.
;; Every call site in resolve.clj, server.clj and the tests is unchanged.
;;
;; `ctx` is a resolve-ident Graph: the store root paired with its live-occurrence
;; rotation. Node and predicate ids are Terms, and a fact cid is the assertion
;; occurrence coordinate. A
;; predicate need not be interned before it can be asked about, so the
;; "value-id missing -> nil" early exits are gone: an unregistered predicate
;; simply has no live occurrences. select-causal-1 and select-main-1 now agree,
;; because a record store's transaction sequence IS the causal order the old tx
;; :observed/:seq metadata stood in for.
;;
;; Consumed by resolve.clj (aliases these behind wrappers) — so the emitted
;; out/resolve_read.clj must stay on the classpath.
;; ============================================================================
(ns resolve-read
  (:require [store.types :as t] [resolve-ident :as ri] [resolve-core :as rc]
            [store.rotation :as rot] [store.txn :as txn]))


(def SEG-RE Any (re-pattern "seg\\d+"))

(defrecord OrdPair [(key rc/OrdKey) (child Any)])

(defrecord SegPair [(idx Int) (child Any)])

(defn view-cids [(ctx ri/Graph) (v Any) (cids (Vec Any))] (U (Vec Any) Nil)
  (if (nil? v)
    nil
    (let [sel (reduce (fn [acc (Set Any) occ Any] (Set Any) (let [r (ri/value-at ctx occ)] (if (nil? r) acc (conj acc r)))) #{} (ri/by-subject-predicate ctx v "selects"))]
      (filterv (fn [cid Any] Bool (contains? sel cid)) cids))))

(defn- pool-of [(ctx ri/Graph) (view Any) (cids (Vec Any))] (Vec Any)
  (let [in-view (if (nil? view) nil (view-cids ctx view cids))]
    (if (or (nil? in-view) (empty? in-view)) cids in-view)))

(defn- occ-key [(ctx ri/Graph) (occ Any)] (Vec Any)
  [(ri/occurrence-order occ) (ri/writer-of ctx occ)])

(defn select-main-1 [(ctx (U ri/Graph Nil)) (view Any) (cids (Vec Any))] Any
  (if (empty? cids)
    nil
    (if (nil? ctx)
      (first cids)
      (first (sort-by (fn [cid Any] (Vec Any) (occ-key ctx cid))
               (pool-of ctx view cids))))))

(defn select-causal-1 [(ctx (U ri/Graph Nil)) (view Any) (cids (Vec Any))] Any
  (if (empty? cids)
    nil
    (if (nil? ctx)
      (first cids)
      (first (sort-by (fn [cid Any] (Vec Any) (occ-key ctx cid))
               (pool-of ctx view cids))))))

(defn- fact-r [(ctx (U ri/Graph Nil)) (cid Any)] Any
  (if (or (nil? ctx) (nil? cid)) nil (ri/target-at ctx cid)))

(defn pred-val [(ctx (U ri/Graph Nil)) (view Any) (e Any) (pname Any)] Any
  (if (or (nil? ctx) (nil? e))
    nil
    (let [occ (select-main-1 ctx view (ri/by-subject-predicate ctx e pname))]
      (if (nil? occ) nil (ri/value-at ctx occ)))))

(defn kind-of [(ctx (U ri/Graph Nil)) (view Any) (e Any)] Any
  (pred-val ctx view e "kind"))

(defn sym-qualifier [(ctx (U ri/Graph Nil)) (view Any) (e Any)] Any
  (if (= "symbol" (kind-of ctx view e)) (pred-val ctx view e "qualifier") nil))

(defn sym-val [(ctx (U ri/Graph Nil)) (view Any) (e Any)] Any
  (if (= "symbol" (kind-of ctx view e))
    (let [name (pred-val ctx view e "name")]
      (if (some? name) name (pred-val ctx view e "v")))
    nil))

(defn ordered-children [(ctx (U ri/Graph Nil)) (e Any)] (Vec Any)
  (if (or (nil? ctx) (nil? e))
    []
    (let [pairs (reduce (fn [acc (Vec OrdPair) cid Any] (Vec OrdPair) (let [k (rc/ord-parse (ri/predicate-at ctx cid)) r (fact-r ctx cid)] (if (or (nil? k) (nil? r)) acc (conj acc (->OrdPair k r))))) [] (ri/by-subject ctx e))]
      (mapv (fn [pr OrdPair] Any (:child pr))
        (sort-by (fn [pr OrdPair] rc/OrdKey (:key pr)) rc/ord-cmp pairs)))))

(defn ordered-segs [(ctx (U ri/Graph Nil)) (e Any)] (Vec Any)
  (if (or (nil? ctx) (nil? e))
    []
    (let [pairs (reduce (fn [acc (Vec SegPair) cid Any] (Vec SegPair) (let [p Any (ri/predicate-at ctx cid) r Any (fact-r ctx cid)] (if (and (string? p) (some? (re-matches SEG-RE (str p))) (some? r)) (let [n (parse-long (subs (str p) 3))] (if (nil? n) acc (conj acc (->SegPair n r)))) acc))) [] (ri/by-subject ctx e))]
      (mapv (fn [pr SegPair] Any (:child pr))
        (sort-by (fn [pr SegPair] Int (:idx pr)) pairs)))))

(defn head-sym [(ctx (U ri/Graph Nil)) (view Any) (e Any)] Any
  (if (= "list" (kind-of ctx view e))
    (let [head (first (ordered-children ctx e))]
      (if (nil? (sym-qualifier ctx view head)) (sym-val ctx view head) nil))
    nil))

(defn unwrap-meta [(ctx (U ri/Graph Nil)) (view Any) (e Any)] Any
  (loop [e Any e n Int 0]
    (if (and (some? e) (< n 64) (= "#%meta" (head-sym ctx view e)))
      (recur (nth (ordered-children ctx e) 2 nil) (inc n))
      e)))

(defn bound-target [(ctx (U ri/Graph Nil)) (view Any) (BOUND Any) (L Any)] Any
  (if (or (nil? ctx) (nil? BOUND) (nil? L))
    nil
    (fact-r ctx (select-main-1 ctx view (ri/by-subject-predicate ctx L BOUND)))))

(defn refers-target
  [(ctx (U ri/Graph Nil)) (view Any) (BOUND Any) (REFERS Any) (L Any)] Any
  (let [bt (bound-target ctx view BOUND L)]
    (if (some? bt)
      bt
      (if (or (nil? ctx) (nil? REFERS) (nil? L))
        nil
        (fact-r ctx (select-main-1 ctx view (ri/by-subject-predicate ctx L REFERS)))))))

(defn live-node? [(ctx (U ri/Graph Nil)) (KIND Any) (e Any)] Bool
  (if (or (nil? ctx) (nil? KIND) (nil? e))
    false
    (not (empty? (ri/by-subject-predicate ctx e KIND)))))

;; A (child-position-key, child-node) pair, sorted to produce ordered-children.

;; A record rather than the original's 2-vector because the pair is fixed-shape

;; and the sort key is typed: sorting a (Vec Any) by `first` would hand ord-cmp

;; an Any and lose the OrdKey contract the comparator actually needs.

;; `#"…"` cannot cross the graph-edit datum channel (the verb payload is read as

;; EDN and `#"` is a Clojure reader macro), so the segment pattern is spelled with

;; re-pattern and hoisted to a top-level def — compiled once, as the literal was.

;; PER-DEF NOTES (the graph-edit datum channel carries FORMS, not text, so a

;; comment cannot ride inside an authored form; the load-bearing prose lives

;; here instead — same convention as src/pull.bclj).

;; ---------------------------------------------------------------------------

;;   SegPair

;;     The segN twin: comment segments carry an integer index, not an order key.

;;   view-cids

;;     --------------------------------------------------------------- election ---

;;   pool-of

;;     The election pool: a bound view narrows the group to the cids it selects, and

;;     inherits main wherever it selects none of them.

;;   agent-of

;;     The writing agent of the tx that committed `cid`, as a string. "" when the

;;     transaction has no writer attribution.

;;   fact-r

;;     ------------------------------------------------------------- node reads ---

;;     The :r (right/object) slot of a fact as a minted Term identity. A nil cid,

;;     missing fact, or literal slot reads as "no target".

;;   kind-of

;;     default-main kind of node e

;;   sym-val

;;     default-main spelling of a symbol

;;   ordered-children

;;     ---------------------------------------------------------- ordered reads ---

;;     fN children, in CRDT-key (path,tie) order.

;;   ordered-segs

;;     Turtle #6: a comment node's segN children, in order.

;;   unwrap-meta

;;     D2: peel leading (#%meta <metadata> <target>) wrappers to reach the bound form.

;;     A metadata-annotated def NAME — `(def ^:dynamic *x* 1)` ingests its name slot

;;     as `(#%meta {:dynamic true} *x*)` — hides the symbol from a bare `sym-val`.

;;     Metas nest left (`^a ^b x` = `(#%meta a (#%meta b x))`), so loop to the

;;     innermost target (the 3rd child). nil-safe: a malformed/absent target falls

;;     through to nil.

;;   bound-target

;;     ------------------------------------------------------------- identity ----

;;   live-node?

;;     Does the node still carry a `kind` — i.e. was it not retired out of the graph?

;; ---------------------------------------------------------- authoring context

;; One context is a Graph whose writers map carries the open transaction builder
;; and whose view is the committed rotation plus that builder's staged overlay:
;; a reader sees its own uncommitted writes while the store stays untouched
;; until commit!.
(def builder-key Keyword :builder)

(defn builder [(context ri/Graph)] (Atom txn/Builder)
  (get (ri/writers-of context) builder-key))

(defn- resync! [(context ri/Graph)] ri/Graph
  (let [open txn/Builder (deref (builder context))
        coordinate t/Triple (txn/builder-coordinate open)
        store (Atom t/TermStore) (ri/store-of context)]
    (ri/with-view! context
      (rot/staged (rot/project! store)
                  (t/triple-t1 coordinate)
                  (t/triple-t3 coordinate)
                  (txn/builder-operations open)))))

;; A fresh builder stages nothing, so the graph's own committed projection is
;; already the effective view.
(defn context! [(store (Atom t/TermStore))] ri/Graph
  (ri/graph! store {builder-key (txn/open store)}))

(defn mint! [(context ri/Graph)] t/Triple
  (txn/mint! (builder context)))

(defn assert!
  [(context ri/Graph) (subject Any) (predicate Any) (value Any)] t/Triple
  (let [occurrence t/Triple
        (txn/assert! (builder context) (t/triple subject predicate value))]
    (do (resync! context) occurrence)))

(defn update-single!
  [(context ri/Graph) (subject Any) (predicate Any) (value Any)] t/Triple
  (let [occurrence t/Triple
        (txn/update-single! (builder context) (ri/view context)
                            subject predicate value)]
    (do (resync! context) occurrence)))

;; Commit reopens the builder in place against the advanced sequence, so the
;; context stays the caller's single durable handle across transactions.
(defn commit! [(context ri/Graph)] t/Triple
  (let [store (Atom t/TermStore) (ri/store-of context)
        cell (Atom txn/Builder) (builder context)
        coordinate t/Triple (txn/commit! store cell)]
    (do (reset! cell (deref (txn/open store)))
        (resync! context)
        coordinate)))

(defn events-by-subject
  [(context ri/Graph) (subject Any)] (Vec t/OperationOccurrence)
  (rot/by-t1 (ri/view context) subject))

(defn events-by-subject-predicate
  [(context ri/Graph) (subject Any) (predicate Any)] (Vec t/OperationOccurrence)
  (rot/by-t12 (ri/view context) subject predicate))

(defn event-predicate [(event t/OperationOccurrence)] Any
  (t/triple-t2 (rot/proposition-of event)))

(defn event-value [(event t/OperationOccurrence)] Any
  (t/triple-t3 (rot/proposition-of event)))
