#lang beagle/clj
;; FRI is a disposable acceleration cache over the canonical Beagle Store log.
;; Its private handles never cross the semantic API boundary.
(ns fri-port
  (:require [store.store :as store]
            [store.types :as t])
  (:import [java.io ByteArrayOutputStream File FileOutputStream]
           [java.nio ByteBuffer ByteOrder CharBuffer]
           [java.nio.charset CodingErrorAction StandardCharsets]
           [java.nio.file Files StandardCopyOption]
           [java.security MessageDigest]
           [java.util Arrays HexFormat]))


(def MAGIC String "BEAGLEFRI2")
(def FMT Int 2)
(def FLAGS Int 0)
(def PAYLOAD-FLAGS Int 0)
(def MAX-TERM-DEPTH Int 256)
(def FINGERPRINT-BYTES Int 32)

;; The cache is accepted only when its immutable space and exact canonical-log
;; prefix match the caller's expectation.
(defrecord CacheSource
  [space-id String
   fingerprint String
   valid-bytes Int])
(defrecord CacheReceipt
  [format Int
   space-id String
   source-fingerprint String
   source-position Int
   sha256 String])
(defrecord CacheImage
  [source CacheSource
   dump t/TermStoreDump
   indexes Any
   store Any])

(defn- fail
  [message String
   type Keyword] Any
  (throw (ex-info message {:type type})))

(defn- valid-fingerprint? [value String] Bool
  (some? (re-matches #"[0-9a-f]{64}" value)))

(defn source-binding
  [space-id String
   fingerprint String
   valid-bytes Int] CacheSource
  (if (and (pos? (count space-id))
           (and (valid-fingerprint? fingerprint) (>= valid-bytes 0)))
    (->CacheSource space-id fingerprint valid-bytes)
    (fail "fri: source binding requires SpaceId, sha256, and non-negative valid-byte position"
          :invalid-cache-source)))

(defn- hex [bytes Any] String
  (apply str (map (fn [value Any] String
                    (format "%02x" (bit-and value 255)))
                  bytes)))

(defn- sha256-bytes [bytes Any] Any
  (.digest (MessageDigest/getInstance "SHA-256") bytes))

(defn- sha256 [bytes Any] String
  (hex (sha256-bytes bytes)))

(defn- strict-utf8
  [value String
   context String] Any
  (try
    (let [encoder Any (doto (.newEncoder StandardCharsets/UTF_8)
            (.onMalformedInput CodingErrorAction/REPORT)
            (.onUnmappableCharacter CodingErrorAction/REPORT))
          buffer ByteBuffer (.encode encoder (CharBuffer/wrap value))
          bytes Any (byte-array (.remaining buffer))]
      (.get buffer bytes)
      bytes)
    (catch java.nio.charset.CharacterCodingException error
      (fail (str "fri: invalid UTF-8 in " context) :invalid-fri-cache))))

(defn- strict-utf8-string
  [bytes Any
   context String] String
  (try
    (let [decoder Any (doto (.newDecoder StandardCharsets/UTF_8)
            (.onMalformedInput CodingErrorAction/REPORT)
            (.onUnmappableCharacter CodingErrorAction/REPORT))]
      (str (.decode decoder (ByteBuffer/wrap bytes))))
    (catch java.nio.charset.CharacterCodingException error
      (fail (str "fri: invalid UTF-8 in " context) :invalid-fri-cache))))

(defn- require-u32
  [value Int
   context String] Int
  (if (and (>= value 0) (<= value 4294967295))
    value
    (fail (str "fri: " context " exceeds u32") :invalid-fri-cache)))

(defn- require-i64
  [value Int
   context String] Int
  (if (and (>= value -9223372036854775808) (<= value 9223372036854775807))
    value
    (fail (str "fri: " context " exceeds i64") :invalid-fri-cache)))

(defn- write-u8!
  [out Any
   value Int] Nil
  (do (.write out (int (bit-and value 255))) nil))

(defn- write-u16-le!
  [out Any
   value Int] Nil
  (do
    (doseq [position (range 2)]
      (write-u8! out (unsigned-bit-shift-right value (* position 8))))
    nil))

(defn- write-u32-le!
  [out Any
   value Int
   context String] Nil
  (let [checked Int (require-u32 value context)]
    (doseq [position (range 4)]
      (write-u8! out (unsigned-bit-shift-right checked (* position 8))))
    nil))

(defn- write-i64-le!
  [out Any
   value Int
   context String] Nil
  (let [checked Int (require-i64 value context)]
    (doseq [position (range 8)]
      (write-u8! out (unsigned-bit-shift-right checked (* position 8))))
    nil))

(defn- ensure-remaining!
  [buffer ByteBuffer
   amount Int
   context String] Nil
  (if (and (>= amount 0) (>= (.remaining buffer) amount))
    nil
    (fail (str "fri: truncated " context) :invalid-fri-cache)))

(defn- read-u8!
  [buffer ByteBuffer
   context String] Int
  (do
    (ensure-remaining! buffer 1 context)
    (let [position Int (.position buffer)
          value Any (.get buffer position)]
      (.position buffer (inc position))
      (bit-and 255 (int value)))))

(defn- read-u16-le!
  [buffer ByteBuffer
   context String] Int
  (do (ensure-remaining! buffer 2 context)
      (bit-and 65535 (int (.getShort buffer)))))

(defn- read-u32-le!
  [buffer ByteBuffer
   context String] Int
  (do (ensure-remaining! buffer 4 context)
      (Integer/toUnsignedLong (.getInt buffer))))

(defn- read-i64-le!
  [buffer ByteBuffer
   context String] Int
  (do (ensure-remaining! buffer 8 context) (.getLong buffer)))

(defn- read-fixed!
  [buffer ByteBuffer
   amount Int
   context String] Any
  (do
    (ensure-remaining! buffer amount context)
    (let [bytes Any (byte-array amount)]
      (.get buffer bytes)
      bytes)))

(defn- write-sized-text!
  [out Any
   value String
   context String] Nil
  (let [bytes Any (strict-utf8 value context)]
    (write-u32-le! out (alength bytes) context)
    (.write out bytes)
    nil))

(defn- read-sized-bytes!
  [buffer ByteBuffer
   context String] Any
  (let [amount Int (read-u32-le! buffer context)]
    (if (> amount 2147483647)
      (fail (str "fri: " context " length exceeds JVM bounds") :invalid-fri-cache)
      (read-fixed! buffer amount context))))

(defn- read-sized-text!
  [buffer ByteBuffer
   context String] String
  (strict-utf8-string (read-sized-bytes! buffer context) context))

;; Extraction seam: this private provider is byte-identical to the server's
;; TermCodecV1. When the server codec lands on this lineage, both callers
;; should import one shared text-canonical module; the cross-runtime golden keeps
;; this temporary copy from acquiring a divergent tag table.
(declare write-term-v1!)

(defn- write-triple-v1!
  [out Any
   value Any
   depth Int] Nil
  (do
    (when (not (t/triple? value))
      (fail "fri: TermCodecV1 expected Triple" :invalid-fri-cache))
    (when (> depth MAX-TERM-DEPTH)
      (fail "fri: TermCodecV1 depth exceeds 256" :invalid-fri-cache))
    (write-u8! out 7)
    (write-term-v1! out (t/triple-t1 value) (inc depth))
    (write-term-v1! out (t/triple-t2 value) (inc depth))
    (write-term-v1! out (t/triple-t3 value) (inc depth))))

(defn- write-term-v1!
  [out Any
   term Any
   depth Int] Nil
  (cond
    [(t/triple? term) (write-triple-v1! out term depth)]
    [(string? term)
     (do (write-u8! out 1) (write-sized-text! out term "String atom"))]
    [(integer? term)
     (do (write-u8! out 2) (write-i64-le! out term "Int atom"))]
    [(and (number? term) (not (integer? term)))
     (do (write-u8! out 3)
         (write-i64-le! out (Double/doubleToLongBits (double term)) "Float atom"))]
    [(false? term) (write-u8! out 4)]
    [(true? term) (write-u8! out 5)]
    [(keyword? term)
     (let [spelling String (subs (str term) 1)]
       (when (empty? spelling)
         (fail "fri: TermCodecV1 Keyword is empty" :invalid-fri-cache))
       (write-u8! out 6)
       (write-sized-text! out spelling "Keyword atom"))]
    [(t/instant? term)
     (do (write-u8! out 8)
         (write-i64-le! out (t/instant-epoch-seconds term) "Instant seconds")
         (write-u32-le! out (t/instant-nanos term) "Instant nanos"))]
    [:else (fail "fri: value outside TermCodecV1" :invalid-fri-cache)]))

(declare read-term-v1!)

(defn- read-term-v1!
  [buffer ByteBuffer
   depth Int] Any
  (do
    (when (> depth MAX-TERM-DEPTH)
      (fail "fri: TermCodecV1 depth exceeds 256" :invalid-fri-cache))
    (let [tag Int (read-u8! buffer "Term tag")]
      (cond
        [(= tag 1) (read-sized-text! buffer "String atom")]
        [(= tag 2) (read-i64-le! buffer "Int atom")]
        [(= tag 3) (Double/longBitsToDouble (read-i64-le! buffer "Float atom"))]
        [(= tag 4) false]
        [(= tag 5) true]
        [(= tag 6)
         (let [spelling String (read-sized-text! buffer "Keyword atom")]
           (if (empty? spelling)
             (fail "fri: TermCodecV1 Keyword is empty" :invalid-fri-cache)
             (keyword spelling)))]
        [(= tag 7)
         (t/triple (read-term-v1! buffer (inc depth))
                   (read-term-v1! buffer (inc depth))
                   (read-term-v1! buffer (inc depth)))]
        [(= tag 8)
         (t/instant (read-i64-le! buffer "Instant seconds")
                    (read-u32-le! buffer "Instant nanos"))]
        [:else (fail "fri: unknown TermCodecV1 tag" :invalid-fri-cache)]))))

(defn- encode-term-v1! [term Any] Any
  (let [out ByteArrayOutputStream (ByteArrayOutputStream.)]
    (write-term-v1! out term 0)
    (.toByteArray out)))

(defn- decode-term-v1! [bytes Any] Any
  (let [buffer ByteBuffer (doto (ByteBuffer/wrap bytes) (.order ByteOrder/LITTLE_ENDIAN))
        term Any (read-term-v1! buffer 0)]
    (if (= 0 (.remaining buffer))
      term
      (fail "fri: trailing bytes inside TermCodecV1 row" :invalid-fri-cache))))

(defn- atom-row [value Any] t/AtomRow
  (cond
    [(string? value) (t/->AtomRow :string value nil nil nil nil nil)]
    [(integer? value) (t/->AtomRow :int nil value nil nil nil nil)]
    [(and (number? value) (not (integer? value)))
     (t/->AtomRow :float nil nil (double value) nil nil nil)]
    [(boolean? value) (t/->AtomRow :bool nil nil nil value nil nil)]
    [(keyword? value) (t/->AtomRow :keyword nil nil nil nil value nil)]
    [(t/instant? value) (t/->AtomRow :instant nil nil nil nil nil value)]
    [:else (fail "fri: TermCodecV1 AtomRow contains a Triple" :invalid-fri-cache)]))

(defn- action-code [action Keyword] Int
  (cond
    [(= action t/assert-action) 1]
    [(= action t/retract-action) 2]
    [:else (fail "fri: operation has an unknown action" :invalid-fri-cache)]))

(defn- code-action [code Int] Keyword
  (cond
    [(= code 1) t/assert-action]
    [(= code 2) t/retract-action]
    [:else (fail "fri: operation has an unknown action code" :invalid-fri-cache)]))

(defn- atom-handle [position Int] Int (* 2 position))
(defn- triple-handle [position Int] Int (inc (* 2 position)))

(defn- index-data [rows Any] Any
  (let [with-handles Any (map-indexed (fn
                                        [position Int
                                         row t/TripleRow] Any
                                        [(triple-handle position) row])
                     rows)]
    [(vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t1 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t2 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t3 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t1 (nth entry 1))
                        (t/triplerow-t2 (nth entry 1))
                        (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t2 (nth entry 1))
                        (t/triplerow-t3 (nth entry 1))
                        (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry Any] Any
                       [(t/triplerow-t1 (nth entry 1))
                        (t/triplerow-t3 (nth entry 1))
                        (nth entry 0)])
                     with-handles))) ]))

(declare atom-value resolve-handle)

(defn- write-term-row!
  [out Any
   term Any] Nil
  (let [bytes Any (encode-term-v1! term)]
    (write-u32-le! out (alength bytes) "Term row length")
    (.write out bytes)
    nil))

(defn- write-payload! [dump t/TermStoreDump] Any
  (let [out ByteArrayOutputStream (ByteArrayOutputStream.)
        atoms Any (t/termstoredump-atoms dump)
        triples Any (t/termstoredump-triples dump)
        transactions Any (t/termstoredump-transactions dump)
        operations Any (t/termstoredump-operations dump)
        indexes Any (index-data triples)]
    (write-u16-le! out store/term-store-dump-version)
    (write-u16-le! out PAYLOAD-FLAGS)
    (write-i64-le! out (t/termstoredump-next-sequence dump) "next sequence")
    (write-u32-le! out (count atoms) "AtomRow count")
    (doseq [row atoms] (write-term-row! out (atom-value row)))
    (write-u32-le! out (count triples) "TripleRow count")
    (doseq [position (range (count triples))]
      (write-term-row! out (resolve-handle dump (triple-handle position))))
    (write-u32-le! out (count transactions) "TransactionRow count")
    (doseq [row transactions]
      (write-i64-le! out (t/transactionrow-sequence row) "transaction sequence")
      (write-i64-le! out (t/transactionrow-first-operation row) "first operation")
      (write-i64-le! out (t/transactionrow-operation-count row) "operation count"))
    (write-u32-le! out (count operations) "OperationRow count")
    (doseq [row operations]
      (write-i64-le! out (t/operationrow-tx-sequence row) "operation transaction")
      (write-i64-le! out (t/operationrow-ordinal row) "operation ordinal")
      (write-u8! out (action-code (t/operationrow-action row)))
      (write-i64-le! out (t/operationrow-triple-handle row) "operation handle"))
    (doseq [entries indexes]
      (write-u32-le! out (count entries) "slot index row count")
      (doseq [entry entries]
        (doseq [handle entry]
          (write-i64-le! out handle "slot index handle"))))
    (.toByteArray out)))

(defn- read-count!
  [buffer ByteBuffer
   context String
   minimum-row Int] Int
  (let [row-count Int (read-u32-le! buffer context)]
    (if (or (> row-count 2147483647)
            (> (* row-count minimum-row) (.remaining buffer)))
      (fail (str "fri: impossible " context) :invalid-fri-cache)
      row-count)))

(defn- read-term-row! [buffer ByteBuffer] Any
  (decode-term-v1! (read-sized-bytes! buffer "Term row")))

(defn- read-atoms! [buffer ByteBuffer] Any
  (let [row-count Int (read-count! buffer "AtomRow count" 5)]
    (mapv (fn [position Int] t/AtomRow
            (let [term Any (read-term-row! buffer)]
              (if (t/triple? term)
                (fail "fri: AtomRow decoded as Triple" :invalid-fri-cache)
                (atom-row term))))
          (vec (range row-count)))))

(defn- initial-handles [atoms Any] Any
  (into {}
        (map-indexed (fn
                       [position Int
                        row t/AtomRow] Any
                       [(atom-value row) (atom-handle position)])
                     atoms)))

(defn- required-handle
  [handles Any
   term Any] Int
  (if (contains? handles term)
    (get handles term)
    (fail "fri: TripleRow references a term absent from prior rows"
          :invalid-fri-cache)))

(defn- read-triples!
  [buffer ByteBuffer
   atoms Any] Any
  (let [row-count Int (read-count! buffer "TripleRow count" 8)]
    (loop [position Int 0
           rows Any []
           handles Any (initial-handles atoms)]
      (if (>= position row-count)
        rows
        (let [term Any (read-term-row! buffer)]
          (if (not (t/triple? term))
            (fail "fri: TripleRow decoded as Atom" :invalid-fri-cache)
            (if (contains? handles term)
              (fail "fri: duplicate structural TripleRow" :invalid-fri-cache)
              (let [row t/TripleRow (t/->TripleRow
                     (required-handle handles (t/triple-t1 term))
                     (required-handle handles (t/triple-t2 term))
                     (required-handle handles (t/triple-t3 term)))]
                (recur (inc position)
                       (conj rows row)
                       (assoc handles term (triple-handle position)))))))))))

(defn- read-transactions! [buffer ByteBuffer] Any
  (let [row-count Int (read-count! buffer "TransactionRow count" 24)]
    (mapv (fn [position Int] t/TransactionRow
            (t/->TransactionRow
             (read-i64-le! buffer "transaction sequence")
             (read-i64-le! buffer "first operation")
             (read-i64-le! buffer "operation count")))
          (vec (range row-count)))))

(defn- read-operations! [buffer ByteBuffer] Any
  (let [row-count Int (read-count! buffer "OperationRow count" 25)]
    (mapv (fn [position Int] t/OperationRow
            (t/->OperationRow
             (read-i64-le! buffer "operation transaction")
             (read-i64-le! buffer "operation ordinal")
             (code-action (read-u8! buffer "operation action"))
             (read-i64-le! buffer "operation handle")))
          (vec (range row-count)))))

(defn- read-index!
  [buffer ByteBuffer
   width Int] Any
  (let [row-count Int (read-count! buffer "slot index row count" (* width 8))]
    (mapv (fn [position Int] Any
            (mapv (fn [field Int] Int
                    (read-i64-le! buffer "slot index handle"))
                  (vec (range width))))
          (vec (range row-count)))))

(defn- read-indexes! [buffer ByteBuffer] Any
  (mapv (fn [width Int] Any (read-index! buffer width)) [2 2 2 3 3 3]))

(defn- read-payload!
  [payload Any
   space-id String] Any
  (let [buffer ByteBuffer (doto (ByteBuffer/wrap payload) (.order ByteOrder/LITTLE_ENDIAN))
        dump-version Int (read-u16-le! buffer "TermStoreDump version")
        payload-flags Int (read-u16-le! buffer "payload flags")]
    (if (not (= dump-version store/term-store-dump-version))
      (fail "fri: invalid TermStore payload version" :invalid-fri-cache)
      (if (not (= payload-flags PAYLOAD-FLAGS))
        (fail "fri: unsupported payload flags" :invalid-fri-cache)
        (let [next-sequence Int (read-i64-le! buffer "next sequence")
              atoms Any (read-atoms! buffer)
              triples Any (read-triples! buffer atoms)
              transactions Any (read-transactions! buffer)
              operations Any (read-operations! buffer)
              indexes Any (read-indexes! buffer)
              dump t/TermStoreDump (t/->TermStoreDump dump-version space-id next-sequence
                                 atoms triples transactions operations)]
          (if (not (= 0 (.remaining buffer)))
            (fail "fri: trailing bytes in binary payload" :invalid-fri-cache)
            (if (not (= indexes (index-data triples)))
              (fail "fri: slot index does not match TripleRow table"
                    :invalid-fri-cache)
              {:dump dump :indexes indexes})))))))

(defn- validate-dump!
  [dump Any
   source CacheSource] Any
  (if (not (t/term-store-dump? dump))
    (fail "fri: invalid cache input" :invalid-fri-cache)
    (if (not (= store/term-store-dump-version (t/termstoredump-version dump)))
      (fail "fri: invalid cache input" :invalid-fri-cache)
      (if (not (= (cachesource-space-id source)
                  (t/termstoredump-space-id dump)))
        (fail "fri: cache source and TermStore belong to different spaces"
              :cache-space-mismatch)
        (let [ctx Any (store/new-term-store (cachesource-space-id source))]
          (store/load-term-store! ctx dump)
          ctx)))))

(defn- write-bytes!
  [path String
   bytes Any] Nil
  (let [target Any (File. path)
        parent Any (.getParentFile target)
        temporary Any (File. (str path ".tmp"))]
    (when (some? parent) (.mkdirs parent))
    (with-open [stream (FileOutputStream. temporary)]
      (.write stream bytes)
      (.flush stream)
      (.force (.getChannel stream) true))
    (Files/move (.toPath temporary) (.toPath target)
                (into-array StandardCopyOption
                            [StandardCopyOption/ATOMIC_MOVE
                             StandardCopyOption/REPLACE_EXISTING]))
    nil))

(defn write-fri!
  [dump Any
   path String
   source CacheSource] Any
  (do
    (validate-dump! dump source)
    (let [payload Any (write-payload! dump)
          payload-sha Any (sha256-bytes payload)
          buffer ByteArrayOutputStream (ByteArrayOutputStream.)]
      (.write buffer (strict-utf8 MAGIC "magic"))
      (write-u16-le! buffer FMT)
      (write-u16-le! buffer FLAGS)
      (write-sized-text! buffer (cachesource-space-id source) "SpaceId")
      (.write buffer (.parseHex (HexFormat/of)
                                (cachesource-fingerprint source)))
      (write-i64-le! buffer (cachesource-valid-bytes source) "source position")
      (.write buffer payload-sha)
      (write-i64-le! buffer (alength payload) "payload length")
      (.write buffer payload)
      (let [bytes Any (.toByteArray buffer)]
        (write-bytes! path bytes)
        (->CacheReceipt FMT
                        (cachesource-space-id source)
                        (cachesource-fingerprint source)
                        (cachesource-valid-bytes source)
                        (sha256 bytes))))))

(defn- read-envelope! [path String] Any
  (try
    (let [bytes Any (Files/readAllBytes (.toPath (File. path)))
          buffer ByteBuffer (doto (ByteBuffer/wrap bytes) (.order ByteOrder/LITTLE_ENDIAN))
          magic String (strict-utf8-string (read-fixed! buffer (count MAGIC) "cache magic")
                              "cache magic")]
      (if (not (= magic MAGIC))
        (fail "fri: invalid cache magic" :invalid-fri-cache)
        (let [format Int (read-u16-le! buffer "cache format")
              flags Int (read-u16-le! buffer "cache flags")]
          (if (not (= format FMT))
            (fail "fri: unsupported cache format" :invalid-fri-cache)
            (if (not (= flags FLAGS))
              (fail "fri: unsupported cache flags" :invalid-fri-cache)
              (let [space-id String (read-sized-text! buffer "SpaceId")
                    fingerprint String (hex (read-fixed! buffer FINGERPRINT-BYTES
                                      "source fingerprint"))
                    source-position Int (read-i64-le! buffer "source position")
                    payload-sha Any (read-fixed! buffer FINGERPRINT-BYTES "payload checksum")
                    payload-length Int (read-i64-le! buffer "payload length")]
                (if (or (< source-position 0)
                        (or (< payload-length 0)
                            (> payload-length 2147483647)))
                  (fail "fri: invalid source position or payload length"
                        :invalid-fri-cache)
                  (let [payload Any (read-fixed! buffer payload-length "cache payload")]
                    (if (not (= 0 (.remaining buffer)))
                      (fail "fri: cache has trailing bytes" :invalid-fri-cache)
                      {:space-id space-id
                       :fingerprint fingerprint
                       :source-position source-position
                       :payload-sha payload-sha
                       :payload payload})))))))))
    (catch clojure.lang.ExceptionInfo error
      (throw error))
    (catch Throwable error
      (throw (ex-info "fri: cache is truncated or malformed"
                      {:type :invalid-fri-cache :cause (str error)})))))

(defn open-fri!
  [path String
   source CacheSource] Any
  (let [envelope Any (read-envelope! path)
        payload Any (:payload envelope)
        stored-space Any (:space-id envelope)
        stored-fingerprint Any (:fingerprint envelope)
        stored-position Any (:source-position envelope)
        stored-sha Any (:payload-sha envelope)]
    (if (not (= stored-space (cachesource-space-id source)))
      (fail "fri: cache belongs to a different SpaceId" :cache-space-mismatch)
      (if (not (and (= stored-fingerprint (cachesource-fingerprint source))
                    (= stored-position (cachesource-valid-bytes source))))
        (fail "fri: cache does not match the canonical Beagle Store log prefix"
              :cache-source-mismatch)
        (if (not (Arrays/equals stored-sha (sha256-bytes payload)))
          (fail "fri: cache payload checksum mismatch" :invalid-fri-cache)
          (let [cache-data Any (read-payload! payload stored-space)
                dump t/TermStoreDump (:dump cache-data)
                ctx Any (validate-dump! dump source)]
            (->CacheImage source dump (:indexes cache-data) ctx)))))))

(defn- atom-value [row t/AtomRow] Any
  (let [kind Keyword (t/atomrow-kind row)]
    (cond
      [(= kind :string) (t/atomrow-string-value row)]
      [(= kind :int) (t/atomrow-int-value row)]
      [(= kind :float) (t/atomrow-float-value row)]
      [(= kind :bool) (t/atomrow-bool-value row)]
      [(= kind :keyword) (t/atomrow-keyword-value row)]
      [(= kind :instant) (t/atomrow-instant-value row)]
      [:else (fail "fri: AtomRow has an unknown kind" :invalid-fri-cache)])))

(defn- atom-handle? [handle Int] Bool (= 0 (mod handle 2)))
(defn- handle-position [handle Int] Int (quot handle 2))

(defn- resolve-handle
  [dump t/TermStoreDump
   handle Int] Any
  (let [position Int (handle-position handle)]
    (if (atom-handle? handle)
      (atom-value (nth (t/termstoredump-atoms dump) position))
      (let [row t/TripleRow (nth (t/termstoredump-triples dump) position)]
        (t/triple (resolve-handle dump (t/triplerow-t1 row))
                  (resolve-handle dump (t/triplerow-t2 row))
                  (resolve-handle dump (t/triplerow-t3 row)))))))

(defn- term-handles [dump t/TermStoreDump] Any
  (into {}
        (concat
         (map-indexed (fn
                        [position Int
                         row t/AtomRow] Any
                        [(atom-value row) (atom-handle position)])
                      (t/termstoredump-atoms dump))
         (map-indexed (fn
                        [position Int
                         row t/TripleRow] Any
                        [(resolve-handle dump (triple-handle position))
                         (triple-handle position)])
                      (t/termstoredump-triples dump)))))

(defn- index-matches
  [image Any
   index-position Int
   keys Any] Any
  (let [dump t/TermStoreDump (cacheimage-dump image)
        handles Any (term-handles dump)
        key-handles Any (mapv (fn [term Any] Any (get handles term)) keys)]
    (if (some nil? key-handles)
      []
      (let [entries Any (nth (cacheimage-indexes image) index-position)
            key-count Int (count key-handles)]
        (mapv (fn [entry Any] Any
                (resolve-handle dump (nth entry key-count)))
              (filter (fn [entry Any] Bool
                        (= key-handles (subvec entry 0 key-count)))
                      entries))))))

(defn- live-positions-as-of
  [image Any
   sequence Int] Any
  (if (< sequence 0)
    (fail "fri: as-of sequence must be non-negative" :invalid-as-of-sequence)
    (let [dump t/TermStoreDump (cacheimage-dump image)
          operations Any (t/termstoredump-operations dump)]
      (loop [position Int 0
             active Any {}
             live Any []]
        (if (or (>= position (count operations))
                (> (t/operationrow-tx-sequence (nth operations position)) sequence))
          (vec (keep-indexed (fn
                               [index Int
                                present? Bool] Any
                               (when present? index))
                             live))
          (let [row t/OperationRow (nth operations position)
                handle Int (t/operationrow-triple-handle row)
                positions Any (get active handle [])]
            (if (= t/assert-action (t/operationrow-action row))
              (recur (inc position)
                     (assoc active handle (conj positions position))
                     (conj live true))
              (if (empty? positions)
                (recur (inc position) active (conj live false))
                (let [target Int (peek positions)]
                  (recur (inc position)
                         (assoc active handle (pop positions))
                         (conj (assoc live target false) false)))))))))))

(defn- occurrence-event
  [dump t/TermStoreDump
   position Int] t/OperationOccurrence
  (let [row t/OperationRow (nth (t/termstoredump-operations dump) position)
        transaction t/Triple (t/transaction-coordinate (t/termstoredump-space-id dump)
                                  (t/operationrow-tx-sequence row))
        occurrence t/Triple (t/occurrence-coordinate transaction (t/operationrow-ordinal row))
        proposition Any (resolve-handle dump (t/operationrow-triple-handle row))]
    (t/operation-occurrence
     occurrence (t/operationrow-action row) proposition)))

(defn close-fri! [image Any] Nil nil)
(defn restore-store!
  [image Any
   target Any] Any
  (store/load-term-store! target (cacheimage-dump image)))
(defn space-id [image Any] String
  (cachesource-space-id (cacheimage-source image)))
(defn source-fingerprint [image Any] String
  (cachesource-fingerprint (cacheimage-source image)))
(defn source-position [image Any] Int
  (cachesource-valid-bytes (cacheimage-source image)))
(defn transaction-count [image Any] Int
  (store/transaction-count (cacheimage-store image)))
(defn operation-count [image Any] Int
  (store/operation-count (cacheimage-store image)))
(defn occurrences [image Any] Any
  (store/occurrences (cacheimage-store image)))
(defn withdrawals [image Any] Any
  (store/withdrawals (cacheimage-store image)))
(defn live-occurrences [image Any] Any
  (store/live-occurrences (cacheimage-store image)))
(defn live-propositions [image Any] Any
  (store/live-propositions (cacheimage-store image)))
(defn by-t1
  [image Any
   term Any] Any
  (index-matches image 0 [term]))
(defn by-t2
  [image Any
   term Any] Any
  (index-matches image 1 [term]))
(defn by-t3
  [image Any
   term Any] Any
  (index-matches image 2 [term]))
(defn by-t12
  [image Any
   t1 Any
   t2 Any] Any
  (index-matches image 3 [t1 t2]))
(defn by-t23
  [image Any
   t2 Any
   t3 Any] Any
  (index-matches image 4 [t2 t3]))
(defn by-t13
  [image Any
   t1 Any
   t3 Any] Any
  (index-matches image 5 [t1 t3]))
(defn live-occurrences-as-of
  [image Any
   sequence Int] Any
  (let [dump t/TermStoreDump (cacheimage-dump image)]
    (mapv (fn [position Int] t/OperationOccurrence
            (occurrence-event dump position))
          (live-positions-as-of image sequence))))
(defn live-propositions-as-of
  [image Any
   sequence Int] Any
  (let [dump t/TermStoreDump (cacheimage-dump image)]
    (mapv (fn [position Int] Any
            (resolve-handle
             dump
             (t/operationrow-triple-handle
              (nth (t/termstoredump-operations dump) position))))
          (live-positions-as-of image sequence))))
