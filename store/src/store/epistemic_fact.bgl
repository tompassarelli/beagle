#lang beagle

(ns store.epistemic-fact
  (:require [store.rotation :as rotation]
            [store.store :as store]
            [store.txn :as txn]
            [store.types :as t]))

;; A world is an immutable explanation root.  Physical placement and trust are
;; referenced facts elsewhere; they are deliberately not folded into identity.
(defrecord WorldRoot
  [world-id String
   schema-id String
   rules-id String
   normalizer-id String
   parent-world-ids (Vec String)])

(defrecord AttemptReference
  [attempt-id String
   capability-id String])

;; Every mode carries the evidence appropriate to its epistemic claim.  The
;; union tag is structural: equal propositions in different modes are not the
;; same evidence and cannot be admitted through the same reasoning gate.
(defunion EpistemicProvenance
  (Declared
    [authority-id String
     evidence-id String])
  (Derived
    [rule-id String
     premise-ids (Vec String)
     evidence-id String])
  (Observed
    [observer-id String
     evidence-id String
     observed-at-ms Int
     valid-until-ms Int])
  (Desired
    [authority-id String
     plan-id String
     evidence-id String])
  (EffectAttempt
    [attempt-id String
     plan-id String
     capability-id String
     evidence-id String])
  (EffectReceipt
    [receipt-id String
     attempt-id String
     capability-id String
     issuer-id String
     evidence-id String]))

(defrecord EpistemicFact
  [fact-id String
   world-id String
   proposition t/Triple
   provenance EpistemicProvenance])

(defrecord AdmissionContext
  [world WorldRoot
   known-premise-ids (Vec String)
   capability-ids (Vec String)
   attempts (Vec AttemptReference)
   now-ms Int])

(defunion FactAdmission
  (FactAdmitted [fact EpistemicFact])
  (FactRejected
    [code Keyword
     detail String]))

(defunion ProvenanceAdmission
  ProvenanceAccepted
  (ProvenanceRejected
    [code Keyword
     detail String]))

(defunion EvidenceRequirement
  RequireDeclared
  RequireDerived
  RequireObserved
  RequireDesired
  RequireEffectAttempt
  RequireEffectReceipt)

(defn require-declared [] EvidenceRequirement
  (->RequireDeclared))

(defn require-derived [] EvidenceRequirement
  (->RequireDerived))

(defn require-observed [] EvidenceRequirement
  (->RequireObserved))

(defn require-desired [] EvidenceRequirement
  (->RequireDesired))

(defn require-effect-attempt [] EvidenceRequirement
  (->RequireEffectAttempt))

(defn require-effect-receipt [] EvidenceRequirement
  (->RequireEffectReceipt))

(defn nonempty-id? [value String] Bool
  (> (count value) 0))

(defn contains-id?
  [values (Vec String)
   candidate String] Bool
  (loop [position Int 0]
    (if (>= position (count values))
      false
      (if (= candidate (nth values position))
        true
        (recur (+ position 1))))))

(defn all-nonempty? [values (Vec String)] Bool
  (loop [position Int 0]
    (if (>= position (count values))
      true
      (if (nonempty-id? (nth values position))
        (recur (+ position 1))
        false))))

(defn world-root-valid? [world WorldRoot] Bool
  (and (nonempty-id? (worldroot-world-id world))
       (and (nonempty-id? (worldroot-schema-id world))
            (and (nonempty-id? (worldroot-rules-id world))
                 (and (nonempty-id? (worldroot-normalizer-id world))
                      (all-nonempty?
                       (worldroot-parent-world-ids world)))))))

(defn all-known-premises?
  [known (Vec String)
   premises (Vec String)] Bool
  (if (= 0 (count premises))
    false
    (loop [position Int 0]
      (if (>= position (count premises))
        true
        (let [premise String (nth premises position)]
          (if (and (nonempty-id? premise) (contains-id? known premise))
            (recur (+ position 1))
            false))))))

(defn matching-attempt?
  [attempts (Vec AttemptReference)
   attempt-id String
   capability-id String] Bool
  (loop [position Int 0]
    (if (>= position (count attempts))
      false
      (let [attempt AttemptReference (nth attempts position)]
        (if (and (= attempt-id (attemptreference-attempt-id attempt))
                 (= capability-id
                    (attemptreference-capability-id attempt)))
          true
          (recur (+ position 1)))))))

(defn provenance-admission
  [context AdmissionContext
   provenance EpistemicProvenance] ProvenanceAdmission
  (match provenance
    [(Declared authority-id evidence-id)
     (if (and (nonempty-id? authority-id) (nonempty-id? evidence-id))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-declared
         "declared provenance requires authority and evidence identities"))]
    [(Derived rule-id premise-ids evidence-id)
     (if (and (nonempty-id? rule-id)
              (and (nonempty-id? evidence-id)
                   (all-known-premises?
                    (admissioncontext-known-premise-ids context)
                    premise-ids)))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-derived
         "derived provenance requires a rule, evidence, and known premises"))]
    [(Observed observer-id evidence-id observed-at-ms valid-until-ms)
     (if (and (nonempty-id? observer-id)
              (and (nonempty-id? evidence-id)
                   (and (<= observed-at-ms (admissioncontext-now-ms context))
                        (< (admissioncontext-now-ms context)
                           valid-until-ms))))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-observed
         "observed provenance requires an observer and a current validity window"))]
    [(Desired authority-id plan-id evidence-id)
     (if (and (nonempty-id? authority-id)
              (and (nonempty-id? plan-id) (nonempty-id? evidence-id)))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-desired
         "desired provenance requires authority, plan, and evidence identities"))]
    [(EffectAttempt attempt-id plan-id capability-id evidence-id)
     (if (and (nonempty-id? attempt-id)
              (and (nonempty-id? plan-id)
                   (and (nonempty-id? evidence-id)
                        (contains-id?
                         (admissioncontext-capability-ids context)
                         capability-id))))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-effect-attempt
         "effect attempt requires a plan and an admitted capability"))]
    [(EffectReceipt receipt-id attempt-id capability-id issuer-id evidence-id)
     (if (and (nonempty-id? receipt-id)
              (and (nonempty-id? issuer-id)
                   (and (nonempty-id? evidence-id)
                        (matching-attempt?
                         (admissioncontext-attempts context)
                         attempt-id capability-id))))
       (->ProvenanceAccepted)
       (->ProvenanceRejected :epistemic/invalid-effect-receipt
         "effect receipt must reference a known attempt and its capability"))]))

(defn admit-fact
  [context AdmissionContext
   fact EpistemicFact] FactAdmission
  (cond
    [(not (world-root-valid? (admissioncontext-world context)))
     (->FactRejected :epistemic/invalid-world-root
       "world root requires schema, rules, normalizer, and valid parent identities")]
    [(not= (worldroot-world-id (admissioncontext-world context))
           (epistemicfact-world-id fact))
     (->FactRejected :epistemic/world-mismatch
       "fact world does not match the admission world")]
    [(or (not (nonempty-id? (epistemicfact-fact-id fact)))
         (not (t/triple? (epistemicfact-proposition fact))))
     (->FactRejected :epistemic/invalid-envelope
       "fact identity and proposition are required")]
    [:else
     (match (provenance-admission context (epistemicfact-provenance fact))
       [(ProvenanceAccepted) (->FactAdmitted fact)]
       [(ProvenanceRejected code detail) (->FactRejected code detail)])]))

(defn satisfies?
  [fact EpistemicFact
   requirement EvidenceRequirement] Bool
  (let [provenance EpistemicProvenance (epistemicfact-provenance fact)]
    (match requirement
      [(RequireDeclared) (instance? Declared provenance)]
      [(RequireDerived) (instance? Derived provenance)]
      [(RequireObserved) (instance? Observed provenance)]
      [(RequireDesired) (instance? Desired provenance)]
      [(RequireEffectAttempt) (instance? EffectAttempt provenance)]
      [(RequireEffectReceipt) (instance? EffectReceipt provenance)])))

(def fact-world Keyword :epistemic/world)
(def fact-proposition Keyword :epistemic/proposition)
(def fact-mode Keyword :epistemic/mode)
(def fact-authority Keyword :epistemic/authority)
(def fact-evidence Keyword :epistemic/evidence)
(def fact-rule Keyword :epistemic/rule)
(def fact-premise Keyword :epistemic/premise)
(def fact-premise-ordinal Keyword :epistemic/premise-ordinal)
(def fact-premise-value Keyword :epistemic/premise-value)
(def fact-observer Keyword :epistemic/observer)
(def fact-observed-at-ms Keyword :epistemic/observed-at-ms)
(def fact-valid-until-ms Keyword :epistemic/valid-until-ms)
(def fact-plan Keyword :epistemic/plan)
(def fact-attempt Keyword :epistemic/attempt)
(def fact-capability Keyword :epistemic/capability)
(def fact-receipt Keyword :epistemic/receipt)
(def fact-issuer Keyword :epistemic/issuer)

(def declared-mode Keyword :declared)
(def derived-mode Keyword :derived)
(def observed-mode Keyword :observed)
(def desired-mode Keyword :desired)
(def effect-attempt-mode Keyword :effect-attempt)
(def effect-receipt-mode Keyword :effect-receipt)

(defrecord DerivedPremise
  [ordinal Int
   value String])
(defalias DerivedPremises (U (Vec String) Nil))

(defunion FactPersistence
  (FactPersisted
    [fact EpistemicFact
     transaction t/Triple])
  (FactNotPersisted [rejection FactAdmission]))

(defunion FactReconstruction
  (FactMissing [detail String])
  (FactMalformed [detail String])
  (FactReconstructed [fact EpistemicFact]))

(defn premise-subject
  [fact-id String
   ordinal Int] t/Triple
  (t/triple fact-id fact-premise ordinal))

(defn derived-premise-triples
  [fact-id String
   premises (Vec String)] (Vec t/Triple)
  (loop [ordinal Int 0
         rows (Vec t/Triple) []]
    (if (>= ordinal (count premises))
      rows
      (let [subject t/Triple (premise-subject fact-id ordinal)]
        (recur
         (inc ordinal)
         (conj
          (conj
           (conj rows (t/triple fact-id fact-premise subject))
           (t/triple subject fact-premise-ordinal ordinal))
          (t/triple subject fact-premise-value (nth premises ordinal))))))))

(defn fact-triples [fact EpistemicFact] (Vec t/Triple)
  (let [fact-id String (epistemicfact-fact-id fact)
        base (Vec t/Triple) [(t/triple fact-id fact-world (epistemicfact-world-id fact))
         (t/triple fact-id fact-proposition (epistemicfact-proposition fact))]]
    (match (epistemicfact-provenance fact)
      [(Declared authority-id evidence-id)
       (conj
        (conj
         (conj base (t/triple fact-id fact-mode declared-mode))
         (t/triple fact-id fact-authority authority-id))
        (t/triple fact-id fact-evidence evidence-id))]
      [(Derived rule-id premise-ids evidence-id)
       (into
        (conj
         (conj
          (conj base (t/triple fact-id fact-mode derived-mode))
          (t/triple fact-id fact-rule rule-id))
         (t/triple fact-id fact-evidence evidence-id))
        (derived-premise-triples fact-id premise-ids))]
      [(Observed observer-id evidence-id observed-at-ms valid-until-ms)
       (conj
        (conj
         (conj
          (conj
           (conj base (t/triple fact-id fact-mode observed-mode))
           (t/triple fact-id fact-observer observer-id))
          (t/triple fact-id fact-evidence evidence-id))
         (t/triple fact-id fact-observed-at-ms observed-at-ms))
        (t/triple fact-id fact-valid-until-ms valid-until-ms))]
      [(Desired authority-id plan-id evidence-id)
       (conj
        (conj
         (conj
          (conj base (t/triple fact-id fact-mode desired-mode))
          (t/triple fact-id fact-authority authority-id))
         (t/triple fact-id fact-plan plan-id))
        (t/triple fact-id fact-evidence evidence-id))]
      [(EffectAttempt attempt-id plan-id capability-id evidence-id)
       (conj
        (conj
         (conj
          (conj
           (conj base (t/triple fact-id fact-mode effect-attempt-mode))
           (t/triple fact-id fact-attempt attempt-id))
          (t/triple fact-id fact-plan plan-id))
         (t/triple fact-id fact-capability capability-id))
        (t/triple fact-id fact-evidence evidence-id))]
      [(EffectReceipt receipt-id attempt-id capability-id issuer-id evidence-id)
       (conj
        (conj
         (conj
          (conj
           (conj
            (conj base (t/triple fact-id fact-mode effect-receipt-mode))
            (t/triple fact-id fact-receipt receipt-id))
           (t/triple fact-id fact-attempt attempt-id))
          (t/triple fact-id fact-capability capability-id))
         (t/triple fact-id fact-issuer issuer-id))
        (t/triple fact-id fact-evidence evidence-id))])))

(defn persist-admitted!
  [root (Atom t/TermStore)
   context AdmissionContext
   fact EpistemicFact] FactPersistence
  (match (admit-fact context fact)
    [(FactAdmitted admitted)
     (let [builder (Atom txn/Builder) (txn/open root)]
       (do
        (doseq [row (fact-triples admitted)] (txn/assert! builder row))
        (match (txn/commit! root builder)
          [(store/CommitSuccess coordinate)
           (->FactPersisted admitted coordinate)]
          [(store/CommitStale expected observed)
           (->FactNotPersisted
            (->FactRejected
             :store/commit-stale
             (str "store advanced from expected sequence " expected
                  " to " observed)))]
          [(store/CommitRejected code detail)
           (->FactNotPersisted (->FactRejected code detail))])))]
    [(FactRejected code detail) (->FactNotPersisted (->FactRejected code detail))]))

(defn property-values
  [view rotation/Rotation
   subject Any
   predicate Keyword] (Vec Any)
  (mapv
   (fn [event t/OperationOccurrence] Any
     (t/triple-t3 (rotation/proposition-of event)))
   (rotation/by-t12 view subject predicate)))

(defn only-value [values (Vec Any)] Any?
  (if (= 1 (count values)) (nth values 0) nil))

(defn only-string [values (Vec Any)] String?
  (let [value Any? (only-value values)]
    (if (string? value) value nil)))

(defn only-int [values (Vec Any)] Int?
  (let [value Any? (only-value values)]
    (if (integer? value) value nil)))

(defn only-keyword [values (Vec Any)] Keyword?
  (let [value Any? (only-value values)]
    (if (keyword? value) value nil)))

(defn only-triple [values (Vec Any)] t/Triple?
  (let [value Any? (only-value values)]
    (if (t/triple? value) value nil)))

(defn nonempty-only-string
  [view rotation/Rotation
   subject Any
   predicate Keyword] String?
  (let [value String? (only-string (property-values view subject predicate))]
    (if (and (some? value) (nonempty-id? value)) value nil)))

(defn parsed-derived-premise
  [view rotation/Rotation
   fact-id String
   subject Any] DerivedPremise?
  (if (not (t/triple? subject))
    nil
    (let [ordinal Int? (only-int (property-values view subject fact-premise-ordinal))
          value String? (nonempty-only-string view subject fact-premise-value)]
      (if (and (some? ordinal)
               (and (some? value)
                    (and (>= ordinal 0)
                         (= subject (premise-subject fact-id ordinal)))))
        (->DerivedPremise ordinal value)
        nil))))

(defn premise-at
  [premises (Vec DerivedPremise)
   ordinal Int] String?
  (loop [position Int 0
         matches Int 0
         found String ""]
    (if (>= position (count premises))
      (if (= matches 1) found nil)
      (let [premise DerivedPremise (nth premises position)]
        (if (= ordinal (derivedpremise-ordinal premise))
          (recur (inc position) (inc matches) (derivedpremise-value premise))
          (recur (inc position) matches found))))))

(defn derived-premises
  [view rotation/Rotation
   fact-id String] DerivedPremises
  (let [references (Vec Any) (property-values view fact-id fact-premise)]
    (if (= 0 (count references))
      nil
      (loop [position Int 0
             parsed (Vec DerivedPremise) []]
        (if (>= position (count references))
          (loop [ordinal Int 0
                 values (Vec String) []]
            (if (>= ordinal (count parsed))
              values
              (let [value String? (premise-at parsed ordinal)]
                (if (some? value)
                  (recur (inc ordinal) (conj values value))
                  nil))))
          (let [premise DerivedPremise? (parsed-derived-premise view fact-id (nth references position))]
            (if (some? premise)
              (recur (inc position) (conj parsed premise))
              nil)))))))

(defn reconstructed-provenance
  [view rotation/Rotation
   fact-id String
   mode Keyword] EpistemicProvenance?
  (cond
    [(= mode declared-mode)
     (let [authority String? (nonempty-only-string view fact-id fact-authority)
           evidence String? (nonempty-only-string view fact-id fact-evidence)]
       (if (and (some? authority) (some? evidence))
         (->Declared authority evidence)
         nil))]
    [(= mode derived-mode)
     (let [rule String? (nonempty-only-string view fact-id fact-rule)
           evidence String? (nonempty-only-string view fact-id fact-evidence)
           premises DerivedPremises (derived-premises view fact-id)]
       (if (and (some? rule) (and (some? evidence) (some? premises)))
         (->Derived rule premises evidence)
         nil))]
    [(= mode observed-mode)
     (let [observer String? (nonempty-only-string view fact-id fact-observer)
           evidence String? (nonempty-only-string view fact-id fact-evidence)
           observed-at-ms Int? (only-int (property-values view fact-id fact-observed-at-ms))
           valid-until-ms Int? (only-int (property-values view fact-id fact-valid-until-ms))]
       (if (and (some? observer)
                (and (some? evidence)
                     (and (some? observed-at-ms) (some? valid-until-ms))))
         (->Observed observer evidence observed-at-ms valid-until-ms)
         nil))]
    [(= mode desired-mode)
     (let [authority String? (nonempty-only-string view fact-id fact-authority)
           plan String? (nonempty-only-string view fact-id fact-plan)
           evidence String? (nonempty-only-string view fact-id fact-evidence)]
       (if (and (some? authority) (and (some? plan) (some? evidence)))
         (->Desired authority plan evidence)
         nil))]
    [(= mode effect-attempt-mode)
     (let [attempt String? (nonempty-only-string view fact-id fact-attempt)
           plan String? (nonempty-only-string view fact-id fact-plan)
           capability String? (nonempty-only-string view fact-id fact-capability)
           evidence String? (nonempty-only-string view fact-id fact-evidence)]
       (if (and (some? attempt)
                (and (some? plan) (and (some? capability) (some? evidence))))
         (->EffectAttempt attempt plan capability evidence)
         nil))]
    [(= mode effect-receipt-mode)
     (let [receipt String? (nonempty-only-string view fact-id fact-receipt)
           attempt String? (nonempty-only-string view fact-id fact-attempt)
           capability String? (nonempty-only-string view fact-id fact-capability)
           issuer String? (nonempty-only-string view fact-id fact-issuer)
           evidence String? (nonempty-only-string view fact-id fact-evidence)]
       (if (and (some? receipt)
                (and (some? attempt)
                     (and (some? capability)
                          (and (some? issuer) (some? evidence)))))
         (->EffectReceipt receipt attempt capability issuer evidence)
         nil))]
    [:else nil]))

(defn reconstruct-fact
  [view rotation/Rotation
   fact-id String] FactReconstruction
  (let [rows (Vec t/OperationOccurrence) (rotation/by-t1 view fact-id)]
    (if (empty? rows)
      (->FactMissing "epistemic fact has no persisted rows")
      (let [world String? (nonempty-only-string view fact-id fact-world)
            proposition t/Triple? (only-triple (property-values view fact-id fact-proposition))
            mode Keyword? (only-keyword (property-values view fact-id fact-mode))]
        (if (and (nonempty-id? fact-id)
                 (and (some? world) (and (some? proposition) (some? mode))))
          (let [provenance EpistemicProvenance? (reconstructed-provenance view fact-id mode)]
            (if (some? provenance)
              (->FactReconstructed
               (->EpistemicFact fact-id world proposition provenance))
              (->FactMalformed
               "epistemic provenance rows are missing, ambiguous, or inconsistent")))
          (->FactMalformed
           "epistemic envelope rows are missing, ambiguous, or malformed"))))))
