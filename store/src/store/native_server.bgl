#lang beagle

(ns store.native-server
  (:require [beagle.fact-profile :as fact-profile]
            [store.log-codec :as log]
            [store.native-dispatch :as dispatch]
            [store.native-wire-codec :as native-wire]
            [store.schema :as schema]
            [store.snapshot-codec :as snapshot]
            [store.store :as term-store]
            [store.types :as t]))


(def server-abi Int 4)
(def status-ok Int 0)
(def status-fatal Int 2)
(def empty-bytes (Vec Int) [])

(defrecord Status [(code Int) (error String?)])

;; log-byte-count tracks the canonical transaction log length this store has written,
;; which is the watermark a checkpoint image records.
(defrecord Store
  [(canonical-log-path String) (session schema/Session) (log-byte-count Int)])

(defrecord Request [(packet t/StoreRpcPacketV2)])
(defrecord Response [(packet t/StoreRpcPacketV2)])

;; Optional payloads and errors stay opaque; status and byte fields have fixed
;; positions because the C adapter consumes those fields directly.
(defrecord StoreResult
  [(status Int)
   (store Store?)
   (error String?)
   (valid-log-bytes Int)
   (boot-append (Vec Int))
   (snapshot-report String)])

(defrecord RequestResult [(status Int) (request Request?) (error String?)])

(defrecord ResponseResult
  [(status Int)
   (response Response?)
   (error String?)
   (append-bytes (Vec Int))
   (next-store StoreResult)
   (state-changed Bool)
   (snapshot-bytes (Vec Int))])

(defrecord BytesResult [(status Int) (bytes (Vec Int))])

;; Direct compiler calls carry fact-profile products through the same Store
;; transaction boundary as RPC.  There is no second key encoding: every
;; admitted canonical fact is one ordinary Store triple.
(defrecord CompileDirectResult
  [(status Int)
   (error String?)
   (next-store StoreResult)
   (append-bytes (Vec Int))
   (state-changed Bool)
   (query fact-profile/AdmittedQueryClosure?)
   (result fact-profile/AdmittedResultClosure?)])

(defrecord CompileStoredValue
  [(result fact-profile/AdmittedResultClosure) (payload String)])

(defrecord CompileQueryResult
  [(status Int) (found Bool) (value CompileStoredValue?) (error String?)])

(defrecord CompileAppendResult
  [(status Int)
   (outcome Int)
   (value CompileStoredValue?)
   (error String?)
   (append-bytes (Vec Int))
   (next-store StoreResult)
   (state-changed Bool)
   (snapshot-bytes (Vec Int))])

(defn error-or [(error String?) (fallback String)] String
  (if error error fallback))

(defn ok-status [] Status (->Status status-ok nil))

(defn fatal-status [(message String)] Status
  (->Status status-fatal message))

(defn failed-store [(message String)] StoreResult
  (->StoreResult status-fatal nil message 0 empty-bytes ""))

(defn failed-request [(message String)] RequestResult
  (->RequestResult status-fatal nil message))

(defn failed-response
  [(message String) (store-result StoreResult)] ResponseResult
  (->ResponseResult
   status-fatal nil message empty-bytes store-result false empty-bytes))

(defn next-store-result [(prior StoreResult) (store Store)] StoreResult
  (->StoreResult
   status-ok store nil
   (storeresult-valid-log-bytes prior) empty-bytes ""))

(defn compiler-fact-triple [(fact fact-profile/CompileQueryFact)] t/Triple
  (t/triple (fact-profile/compilequeryfact-subject fact)
            (fact-profile/compilequeryfact-relation fact)
            (fact-profile/compilequeryfact-value fact)))

(defn compiler-fact-operations
  [(root (Atom t/TermStore)) (facts (Vec fact-profile/CompileQueryFact))]
  (Vec t/CommitOperation)
  (reduce
   (fn [(operations (Vec t/CommitOperation))
        (fact fact-profile/CompileQueryFact)] (Vec t/CommitOperation)
     (let [proposition (compiler-fact-triple fact)]
       (if (contains? (term-store/live-propositions root) proposition)
         operations
         (conj operations (t/->CommitOperation t/assert-action proposition)))))
   [] facts))

(defn compiler-commit!
  [(prior StoreResult) (facts (Vec fact-profile/CompileQueryFact))
   (query fact-profile/AdmittedQueryClosure?)
   (result fact-profile/AdmittedResultClosure?)] CompileDirectResult
  (let [current Store? (storeresult-store prior)]
    (if (or (not= status-ok (storeresult-status prior)) (nil? current))
      (->CompileDirectResult status-fatal
                             (error-or (storeresult-error prior) "store boot failed")
                             prior empty-bytes false query result)
      (let [(store-value Store) current
            session (schema/fork-session (store-session store-value))
            root (schema/store-of session)
            before (term-store/current-sequence root)
            operations (compiler-fact-operations root facts)]
        (if (empty? operations)
          (->CompileDirectResult status-ok nil prior empty-bytes false query result)
          (do
            (term-store/commit-boundary!
             root operations
             (term-store/commit-metadata "store.compiler" "fact-profile" nil))
            (schema/refresh! session)
            (let [encoded (log/encode-store-append! root before)]
              (if (= status-ok (log/bytesresult-status encoded))
                (let [append (log/bytesresult-bytes encoded)
                      next (->StoreResult status-ok
                               (->Store (store-canonical-log-path store-value) session
                                        (+ (store-log-byte-count store-value)
                                           (count append)))
                               nil (storeresult-valid-log-bytes prior)
                               empty-bytes "")]
                  (->CompileDirectResult status-ok nil next append true query result))
                (->CompileDirectResult status-fatal
                                       (error-or (log/bytesresult-error encoded)
                                                 "compiler fact log encoding failed")
                                       prior empty-bytes false query result)))))))))

(defn payload-content-id [(payload String)] String
  (str "sha256:" (sha256-bytes (utf8-encode payload))))

(defn compiler-stored-facts
  [(query fact-profile/AdmittedQueryClosure)
   (result fact-profile/AdmittedResultClosure)
   (payload String)] (Vec fact-profile/CompileQueryFact)
  (conj
   (vec
    (concat (fact-profile/admittedqueryclosure-facts query)
            (fact-profile/admittedresultclosure-facts result)))
   (fact-profile/->CompileQueryFact 5 :result/payload
                                   (fact-profile/admittedresultclosure-result-digest result)
                                   0 payload)))

(defn stored-result-text
  [(root (Atom t/TermStore)) (result-digest String) (relation Keyword)] String?
  (reduce
   (fn [found String? proposition t/Triple] String?
     (if found
       found
       (let [value Any (t/triple-t3 proposition)]
         (if (and (= result-digest (t/triple-t1 proposition))
                  (= relation (t/triple-t2 proposition))
                  (string? value))
           value nil))))
   nil (term-store/live-propositions root)))

(defn stored-value-for-result
  [(root (Atom t/TermStore))
   (query fact-profile/AdmittedQueryClosure)
   (result-digest String)] CompileStoredValue?
  (let [target String? (stored-result-text root result-digest :result/target)
        materializer String? (stored-result-text root result-digest :result/materializer)
        status String? (stored-result-text root result-digest :result/status)
        artifact String? (stored-result-text root result-digest :result/artifact)
        diagnostic String? (stored-result-text root result-digest :result/diagnostic)
        payload String? (stored-result-text root result-digest :result/payload)]
    (if (and target materializer status payload)
      (match (fact-profile/admit-and-identify-result
              (fact-profile/->ResultAdmissionRequest
               query target materializer status artifact diagnostic))
        [(fact-profile/ResultAdmitted result)
         (if (= result-digest
                (fact-profile/admittedresultclosure-result-digest result))
           (->CompileStoredValue result payload)
           nil)]
        [(fact-profile/ResultRejected code detail) nil])
      nil)))

(defn stored-value-for-query
  [(root (Atom t/TermStore))
   (query fact-profile/AdmittedQueryClosure)] CompileStoredValue?
  (let [query-digest String (fact-profile/admittedqueryclosure-query-digest query)]
    (reduce
     (fn [found CompileStoredValue? proposition t/Triple] CompileStoredValue?
       (if found
         found
         (if (and (= :result/query (t/triple-t2 proposition))
                  (= query-digest (t/triple-t3 proposition)))
           (stored-value-for-result root query (t/triple-t1 proposition))
           nil)))
     nil (term-store/live-propositions root))))

;; The whole log is already borrowed here; slicing it into chunks would copy
;; every byte again.
(defn- fold-store!
  [(canonical-log-path String)
   (space-id String)
   (log-bytes ByteSource)
   (report String)]
  StoreResult
  (let [completed
        (log/consume-transaction-log-header!
         (log/start-transaction-log-stream space-id) log-bytes)
        root (log/bootstream-store completed)
        error (log/bootstream-error completed)]
    (if (and (nil? error) root)
      (let [valid-log-bytes (log/bootstream-valid-log-bytes completed)
            boot-append (log/bootstream-boot-append completed)
            closed (term-store/close-fold! root)]
        (->StoreResult
         status-ok
         (->Store canonical-log-path (schema/session! closed)
                  (+ valid-log-bytes (count boot-append)))
         nil
         valid-log-bytes
         boot-append
         report))
      (failed-store
       (error-or error
                 "native transaction log boot failed")))))

;; An image that installs but whose tail does not continue is never an error:
;; the boot degrades to the full fold that the transaction log alone supports.
(defn- snapshot-store!
  [(canonical-log-path String)
   (space-id String)
   (log-bytes ByteSource)
   (plan snapshot/BootPlan)]
  StoreResult
  (let [(image snapshot/Image?) (snapshot/bootplan-image plan)]
    (if (nil? image)
      (fold-store! canonical-log-path space-id log-bytes
                   "store: snapshot boot degraded to full fold; reason :no-image")
      (let [(present snapshot/Image) image
            (sidecar snapshot/Sidecar?) (snapshot/image-sidecar present)]
        (if (nil? sidecar)
          (fold-store!
           canonical-log-path space-id log-bytes
           "store: snapshot boot degraded to full fold; reason :no-sidecar")
          (let [watermark (snapshot/sidecar-watermark
                           (let [(known snapshot/Sidecar) sidecar] known))
                root (term-store/new-term-store
                      (snapshot/image-space-id present))
                loaded (snapshot/install-image! present root)]
            (if (not (term-store/termstoreloadresult-ok loaded))
              (fold-store!
               canonical-log-path space-id log-bytes
               (str "store: snapshot boot degraded to full fold; reason "
                    (str (term-store/termstoreloadresult-code loaded))))
              (let [tail
                    (log/consume-transaction-log-records!
                     (log/->BootStream space-id (term-store/open-fold! root)
                                       watermark [] nil)
                     log-bytes watermark)
                    error (log/bootstream-error tail)]
                (if (some? error)
                  (fold-store!
                   canonical-log-path space-id log-bytes
                   (str "store: snapshot boot degraded to full fold; reason "
                        (error-or error "tail-does-not-continue")))
                  (let [valid-log-bytes (log/bootstream-valid-log-bytes tail)]
                    (->StoreResult
                     status-ok
                     (->Store canonical-log-path
                              (schema/session! (term-store/close-fold! root))
                              valid-log-bytes)
                     nil
                     valid-log-bytes
                     empty-bytes
                     (snapshot/bootplan-report plan))))))))))))

(defn boot-store!
  [(canonical-log-path String)
   (space-id String)
   (log-bytes ByteSource)
   (snapshot-bytes ByteSource)]
  StoreResult
  (let [plan (snapshot/plan-snapshot-boot! true snapshot-bytes log-bytes
                                           space-id)]
    (if (= :replay (snapshot/bootplan-route plan))
      (snapshot-store! canonical-log-path space-id log-bytes plan)
      (fold-store! canonical-log-path space-id log-bytes
                   (snapshot/bootplan-report plan)))))

(defn wrap-rpc-response
  [(request-packet t/StoreRpcPacketV2) (rpc-response t/RpcResponse)] Response
  (->Response
   (t/->StoreRpcPacketV2 :response 0
                   (t/storerpcpacketv2-request-id request-packet)
                   nil rpc-response)))

;; A checkpoint writes an image beside the log; the log itself is untouched, so
;; the operation appends nothing and changes no store state.
(defn checkpoint-response!
  [(store-result StoreResult)
   (store Store)
   (packet t/StoreRpcPacketV2)
   (request t/RpcRequest)
   (now-ms Int)]
  ResponseResult
  (let [session (store-session store)
        root (schema/store-of session)
        served-version (term-store/current-sequence root)
        watermark (store-log-byte-count store)
        next-store (next-store-result store-result store)]
    (cond
      [(not= (term-store/space-id root) (t/rpcrequest-space request))
       (->ResponseResult
        status-ok
        (wrap-rpc-response
         packet
         (dispatch/error-response request served-version :rpc/space-mismatch
                                  false
                                  "request SpaceId does not match the served store"))
        nil empty-bytes next-store false empty-bytes)]
      [(not= :rpc/unit (t/rpc-request-payload-value request))
       (->ResponseResult
        status-ok
        (wrap-rpc-response
         packet
         (dispatch/error-response request served-version :rpc-invalid-payload
                                  false
                                  "operation payload must be :rpc/unit"))
        nil empty-bytes next-store false empty-bytes)]
      [(t/rpcrequest-page request)
       (->ResponseResult
        status-ok
        (wrap-rpc-response
         packet
         (dispatch/error-response request served-version :rpc/unexpected-page
                                  false
                                  "rpc/checkpoint does not support paging"))
        nil empty-bytes next-store false empty-bytes)]
      [:else
       (let [encoded
             (snapshot/encode-snapshot! root served-version watermark now-ms)]
         (if (= status-ok (snapshot/bytesresult-status encoded))
           (->ResponseResult
            status-ok
            (wrap-rpc-response
             packet
             (dispatch/response
              request served-version
              (dispatch/rpc-record
               :rpc/checkpoint
               [served-version watermark now-ms
                (snapshot/bytesresult-fingerprint encoded)
                (count (snapshot/bytesresult-bytes encoded))])))
            nil empty-bytes next-store false
            (snapshot/bytesresult-bytes encoded))
           (->ResponseResult
            status-ok
            (wrap-rpc-response
             packet
             (dispatch/error-response
              request served-version :rpc/checkpoint-unavailable false
              (error-or (snapshot/bytesresult-error encoded)
                        "snapshot image encoding failed")))
            nil empty-bytes next-store false empty-bytes)))])))

(defn dispatch-request!
  [(store-result StoreResult)
   (store Store)
   (request-value Request)
   (now-ms Int)]
  ResponseResult
  (let [packet (request-packet request-value)
        request (t/storerpcpacketv2-request packet)]
    (if request
      (let [(present t/RpcRequest) request]
        (if (= :rpc/checkpoint (t/rpcrequest-op present))
          (checkpoint-response! store-result store packet present now-ms)
          (let [session (store-session store)
                working-session (schema/fork-session session)
                root (schema/store-of working-session)
                before-sequence (term-store/current-sequence root)
                before-derived (schema/derived-generation-of working-session)
                rpc-response (dispatch/dispatch! working-session present now-ms)
                after-sequence (term-store/current-sequence root)
                after-derived (schema/derived-generation-of working-session)
                encoded (log/encode-store-append! root before-sequence)]
            (if (= status-ok (log/bytesresult-status encoded))
              (let [append-bytes (log/bytesresult-bytes encoded)
                    next-store
                    (next-store-result
                     store-result
                     (->Store (store-canonical-log-path store) working-session
                              (+ (store-log-byte-count store)
                                 (count append-bytes))))]
                (->ResponseResult status-ok
                                  (wrap-rpc-response packet rpc-response)
                                  nil
                                  append-bytes
                                  next-store
                                  (or (not= before-sequence after-sequence)
                                      (not= before-derived after-derived))
                                  empty-bytes))
              (failed-response
               (error-or (log/bytesresult-error encoded)
                         "native transaction log append encoding failed")
               store-result)))))
      (failed-response
       "decoded request packet omitted RpcRequest" store-result))))

(defn read-request! [(request-bytes ByteSource)] RequestResult
  (let [decoded (native-wire/decode-request-bytes! request-bytes)
        packet (native-wire/decoderesult-packet decoded)
        error (native-wire/decoderesult-error decoded)]
    (if (and (nil? error) packet)
      (->RequestResult status-ok (->Request packet) nil)
      (failed-request
       (error-or error "native Store RPC request decode failed")))))

(defn write-response! [(response-value Response)] BytesResult
  (let [encoded
        (native-wire/encode-response-bytes! (response-packet response-value))
        bytes (native-wire/encoderesult-bytes encoded)
        error (native-wire/encoderesult-error encoded)]
    (if (and (nil? error) bytes)
      (->BytesResult status-ok bytes)
      (->BytesResult status-fatal empty-bytes))))

;; These eight functions are the generated-module contract consumed by
;; store:native/server_host.h. Keep their order and signatures stable.
(defn server-generated-abi [] Int server-abi)

(defn server-store-boot!
  [(canonical-log-path String)
   (space-id String)
   (log-bytes ByteSource)
   (snapshot-bytes ByteSource)]
  StoreResult
  (boot-store! canonical-log-path space-id log-bytes snapshot-bytes))

(defn server-store-dispatch!
  [(store-result StoreResult)
   (request-result RequestResult)
   (now-ms Int)]
  ResponseResult
  (let [store (storeresult-store store-result)
        request-value (requestresult-request request-result)]
    (if (and (= status-ok (storeresult-status store-result))
             store
             (= status-ok (requestresult-status request-result))
             request-value)
      (dispatch-request! store-result store request-value now-ms)
      (failed-response
       (if (not= status-ok (storeresult-status store-result))
         (error-or (storeresult-error store-result) "store boot failed")
         (error-or (requestresult-error request-result)
                   "request decode failed"))
       store-result))))

(defn server-store-shutdown [(store-result StoreResult)] Status
  (let [store (storeresult-store store-result)]
    (if (and (= status-ok (storeresult-status store-result)) store)
      (ok-status)
      (fatal-status
       (error-or (storeresult-error store-result) "store boot failed")))))

(defn server-codec-read-request! [(request-bytes ByteSource)] RequestResult
  (read-request! request-bytes))

(defn server-codec-write-response!
  [(response-result ResponseResult)] BytesResult
  (let [response-value (responseresult-response response-result)]
    (if (and (= status-ok (responseresult-status response-result))
             response-value)
      (write-response! response-value)
      (->BytesResult status-fatal empty-bytes))))

(defn server-codec-release-request [(request-result RequestResult)] Nil nil)

(defn server-codec-release-response [(response-result ResponseResult)] Nil nil)

;; These direct entries are intentionally positional: the C boundary passes
;; raw fact-profile dimensions, never a serialized closure.
(defn server-compile-query!
  [(store-result StoreResult)
   (source-closure-digest String)
   (compiler-context String)
   (profile String)
   (ordered-targets (Vec String))
   (rules-content-id String)
   (schema-content-id String)
   (expected-query-digest String)] CompileQueryResult
  (match (fact-profile/admit-and-identify-query
          (fact-profile/->QueryAdmissionRequest
           source-closure-digest compiler-context profile ordered-targets
           rules-content-id schema-content-id))
    [(fact-profile/QueryRejected code detail)
     (->CompileQueryResult status-fatal false nil detail)]
    [(fact-profile/QueryAdmitted query)
     (if (not= expected-query-digest
                (fact-profile/admittedqueryclosure-query-digest query))
       (->CompileQueryResult
        status-fatal false nil "expected query digest does not match admission")
       (let [current Store? (storeresult-store store-result)]
         (if (or (not= status-ok (storeresult-status store-result)) (nil? current))
           (->CompileQueryResult status-fatal false nil
                                 (error-or (storeresult-error store-result)
                                           "store boot failed"))
           (let [store-value Store current
                 value CompileStoredValue?
                 (stored-value-for-query (schema/store-of (store-session store-value))
                                         query)]
             (if value
               (->CompileQueryResult status-ok true value nil)
               (->CompileQueryResult status-ok false nil nil))))))]))

(defn server-compile-append!
  [(store-result StoreResult)
   (source-closure-digest String)
   (compiler-context String)
   (profile String)
   (ordered-targets (Vec String))
   (rules-content-id String)
   (schema-content-id String)
   (expected-query-digest String)
   (target String)
   (materializer-content-id String)
   (status String)
   (claimed-content-id String)
   (payload String)] CompileAppendResult
  (match (fact-profile/admit-and-identify-query
          (fact-profile/->QueryAdmissionRequest
           source-closure-digest compiler-context profile ordered-targets
           rules-content-id schema-content-id))
    [(fact-profile/QueryRejected code detail)
     (->CompileAppendResult status-fatal status-fatal nil detail empty-bytes
                            store-result false empty-bytes)]
    [(fact-profile/QueryAdmitted query)
     (cond
       [(not= expected-query-digest
               (fact-profile/admittedqueryclosure-query-digest query))
        (->CompileAppendResult status-fatal status-fatal nil
                               "expected query digest does not match admission"
                               empty-bytes store-result false empty-bytes)]
       [(not= claimed-content-id (payload-content-id payload))
        (->CompileAppendResult status-fatal status-fatal nil
                               "claimed content ID does not match UTF-8 payload"
                               empty-bytes store-result false empty-bytes)]
       [(not (or (= status "ok") (= status "rejected")))
        (->CompileAppendResult status-fatal status-fatal nil
                               "result status must be ok or rejected"
                               empty-bytes store-result false empty-bytes)]
       [:else
       (match (fact-profile/admit-and-identify-result
               (fact-profile/->ResultAdmissionRequest
                query target materializer-content-id status
                (if (= status "ok") claimed-content-id nil)
                (if (= status "rejected") claimed-content-id nil)))
         [(fact-profile/ResultRejected code detail)
          (->CompileAppendResult status-fatal status-fatal nil detail empty-bytes
                                 store-result false empty-bytes)]
         [(fact-profile/ResultAdmitted result)
          (let [stored (->CompileStoredValue result payload)
                committed (compiler-commit!
                           store-result (compiler-stored-facts query result payload)
                           query result)]
            (if (= status-ok (compiledirectresult-status committed))
              (->CompileAppendResult status-ok
                                     (if (compiledirectresult-state-changed committed) 0 1)
                                     stored nil
                                     (compiledirectresult-append-bytes committed)
                                     (compiledirectresult-next-store committed)
                                     (compiledirectresult-state-changed committed)
                                     empty-bytes)
              (->CompileAppendResult status-fatal status-fatal nil
                                     (compiledirectresult-error committed)
                                     empty-bytes store-result false empty-bytes)))])])]))

(defn main [] Int status-fatal)
