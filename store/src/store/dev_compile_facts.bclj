#lang beagle/clj
;; Bounded Store adapter for opt-in development compile-unit facts. Reads are
;; exact by stage and result key. Unopened, unavailable, malformed, duplicate,
;; or conflicting state is evidence for cold compilation, never authority.
(ns store.dev-compile-facts
  (:gen-class)
  (:import [java.io File]
           [java.nio.charset StandardCharsets]
           [java.security MessageDigest]))

(declare-extern clojure.core/load-file (Fn [String] Any))
(declare-extern clojure.core/require (Fn [Any] Any))
(declare-extern store.rt/parse-edn (Fn [String] Any))
(declare-extern store.types/triple (Fn [Any Any Any] Any))
(declare-extern store.types/triple? (Fn [Any] Bool))
(declare-extern store.types/triple-t1 (Fn [Any] Any))
(declare-extern store.types/triple-t2 (Fn [Any] Any))
(declare-extern store.types/triple-t3 (Fn [Any] Any))
(declare-extern database/create-triple-log! (Fn [String String] Any))
(declare-extern database/open-database! (Fn [String String] Any))
(declare-extern database/commit! (Fn [Any Any] Any))
(declare-extern database/live-propositions (Fn [Any] (Vec Any)))
(declare-extern database/branch-revision! (Fn [String] Any))
(declare-extern writer-authority/acquire! (Fn [String] Any))
(declare-extern writer-authority/release! (Fn [Any] Any))

(clojure.core/require 'store.rt)
(let [(raw-emitted-file Any) (File. (str *file*))
      (emitted-file Any) (.getCanonicalFile raw-emitted-file)
      (emitted-namespace-directory Any) (.getParentFile emitted-file)
      (out-directory Any) (.getParentFile emitted-namespace-directory)
      (store-directory Any) (.getParentFile out-directory)]
  (clojure.core/load-file
   (str (.getPath store-directory) "/database.clj")))

(def space-id String "beagle-dev-compile-facts-v1")
(def subject-tag String "store.dev-compile-facts/result-v1")
(def fact-kind String "DevCompileUnitResultV1")

(defrecord CompileFact
  [(stage String) (result-key String) (id String) (encoding String)])

(defrecord AppendCounts [(appended Int) (retained Int)])

(defn- fail [(message String) (code Keyword)] Any
  (throw (ex-info message {:type code :store/code code})))

(defn- nonempty-string? [(value Any)] Bool
  (and (string? value) (pos? (count value))))

(defn- exact-sha256? [(value Any)] Bool
  (and (string? value)
       (some? (re-matches #"sha256:[0-9a-f]{64}" value))))

(defn- allowed-stage? [(value Any)] Bool
  (or (= "typed" value) (= "native" value)))

(defn- sha256-id [(text String)] String
  (str
   "sha256:"
   (apply
    str
    (mapv
     (fn [(value Any)] String
       (format "%02x" (bit-and (int value) 255)))
     (vec
      (.digest (MessageDigest/getInstance "SHA-256")
               (.getBytes text StandardCharsets/UTF_8)))))))

(defn- payload-byte-count [(payload String)] Int
  (count (vec (.getBytes payload StandardCharsets/UTF_8))))

(defn- absolute-store-path [(value Any)] String
  (if (and (string? value) (some? (re-matches #"/.*" value)))
    value
    (fail "development fact Store path must be absolute"
          :dev-compile-facts/relative-route)))

(defn compile-fact [(id String) (encoding String)] CompileFact
  (let [(envelope Any) (store.rt/parse-edn encoding)]
    (if-not (and (vector? envelope) (= 9 (count envelope)))
      (fail "compile fact envelope must have nine vector fields"
            :dev-compile-facts/invalid-envelope)
      (let [(kind Any) (nth envelope 0)
            (stage Any) (nth envelope 1)
            (result-key Any) (nth envelope 2)
            (compiler-context Any) (nth envelope 3)
            (profile Any) (nth envelope 4)
            (unit-id Any) (nth envelope 5)
            (byte-count Any) (nth envelope 6)
            (digest Any) (nth envelope 7)
            (payload Any) (nth envelope 8)]
        (cond
          [(not= fact-kind kind)
           (fail "compile fact envelope has an unknown kind"
                 :dev-compile-facts/unknown-kind)]
          [(not= encoding (pr-str envelope))
           (fail "compile fact envelope must be canonical EDN"
                 :dev-compile-facts/noncanonical-envelope)]
          [(not (allowed-stage? stage))
           (fail "compile fact stage must be typed or native"
                 :dev-compile-facts/invalid-stage)]
          [(not (and (exact-sha256? id)
                     (exact-sha256? result-key)
                     (exact-sha256? compiler-context)
                     (nonempty-string? profile)
                     (nonempty-string? unit-id)
                     (integer? byte-count)
                     (<= 0 byte-count)
                     (exact-sha256? digest)
                     (string? payload)))
           (fail "compile fact envelope metadata is malformed"
                 :dev-compile-facts/invalid-envelope)]
          [(not= id (sha256-id encoding))
           (fail "compile fact id does not match its canonical envelope"
                 :dev-compile-facts/fact-id-mismatch)]
          [(or (not= byte-count (payload-byte-count payload))
               (not= digest (sha256-id payload)))
           (fail "compile fact payload bytes do not match its digest"
                 :dev-compile-facts/payload-mismatch)]
          [:else (->CompileFact stage result-key id encoding)])))))

(defn- fact-subject [(stage String) (result-key String)] Any
  (store.types/triple subject-tag stage result-key))

(defn- fact-proposition [(entry CompileFact)] Any
  (store.types/triple
   (fact-subject (compilefact-stage entry)
                 (compilefact-result-key entry))
   fact-kind
   (compilefact-encoding entry)))

;; Stored envelopes remain raw here. The caller must observe malformed or
;; duplicate facts as divergence instead of having the Store hide them as a
;; plausible miss.
(defn- proposition-entry [(proposition Any)] CompileFact?
  (if-not (store.types/triple? proposition)
    nil
    (let [(subject Any) (store.types/triple-t1 proposition)
          (kind Any) (store.types/triple-t2 proposition)
          (encoding Any) (store.types/triple-t3 proposition)]
      (if (and (store.types/triple? subject)
               (= subject-tag (store.types/triple-t1 subject))
               (allowed-stage? (store.types/triple-t2 subject))
               (exact-sha256? (store.types/triple-t3 subject))
               (= fact-kind kind)
               (string? encoding))
        (->CompileFact
         (store.types/triple-t2 subject)
         (store.types/triple-t3 subject)
         (sha256-id encoding)
         encoding)
        nil))))

(defn- all-facts [(database Any)] (Vec CompileFact)
  (reduce
   (fn [(entries (Vec CompileFact)) (proposition Any)] (Vec CompileFact)
     (let [(entry CompileFact?) (proposition-entry proposition)]
       (if (some? entry) (conj entries entry) entries)))
   []
   (database/live-propositions database)))

(defn- facts-for-key
  [(entries (Vec CompileFact))
   (stage String)
   (result-key String)]
  (Vec CompileFact)
  (filterv
   (fn [(entry CompileFact)] Bool
     (and (= stage (compilefact-stage entry))
          (= result-key (compilefact-result-key entry))))
   entries))

(defn- same-entry? [(left CompileFact) (right CompileFact)] Bool
  (and (= (compilefact-stage left) (compilefact-stage right))
       (= (compilefact-result-key left) (compilefact-result-key right))
       (= (compilefact-id left) (compilefact-id right))
       (= (compilefact-encoding left) (compilefact-encoding right))))

(defn- create-or-open! [(path String)] Any
  (let [(file Any) (File. path)
        (parent Any) (.getParentFile file)]
    (if (and (some? parent) (not (.isDirectory parent)))
      (.mkdirs parent)
      nil)
    (if (.exists file)
      nil
      (database/create-triple-log! path space-id))
    (database/open-database! path space-id)))

(defn- revision-identity [(path String)] String
  (let [(revision Any) (database/branch-revision! path)
        (identity Any) (get revision :identity)]
    (if (string? identity)
      identity
      (fail "Store returned no branch revision identity"
            :dev-compile-facts/revision-unresolved))))

(defn- append-propositions! [(database Any) (propositions (Vec Any))] Nil
  (if (empty? propositions)
    nil
    (do
      (database/commit!
       database
       {:actor "store.dev-compile-facts/v1"
        :commit-metadata
        {:producer "store.dev-compile-facts/v1"
         :shape-schema-id "store/CommitOperationV1"
         :profile "dev-compile-facts-v1"
         :validation-attestation
         {:validator "store/canonical-validator-v1"
          :result :pending
          :attestation "store/canonical-validator-v1"}}
        :operations
        (mapv
         (fn [(proposition Any)] Any
           {:action :assert :proposition proposition})
         propositions)})
      nil)))

(defn- append-entries! [(database Any) (entries (Vec CompileFact))] AppendCounts
  (let [(known (Vec CompileFact)) (all-facts database)
        (pending (Vec CompileFact))
        (reduce
         (fn
           [(accepted (Vec CompileFact)) (entry CompileFact)] (Vec CompileFact)
           (let [(candidates (Vec CompileFact))
                 (facts-for-key
                  (vec (concat known accepted))
                  (compilefact-stage entry)
                  (compilefact-result-key entry))]
             (cond
               [(empty? candidates) (conj accepted entry)]
               [(every?
                 (fn [(candidate CompileFact)] Bool
                   (same-entry? candidate entry))
                 candidates)
                accepted]
               [:else
                (fail
                 (str "compile fact result key has conflicting content: "
                      (compilefact-result-key entry))
                 :dev-compile-facts/conflicting-fact)])))
         []
         entries)]
    (append-propositions! database (mapv fact-proposition pending))
    (->AppendCounts (count pending) (- (count entries) (count pending)))))

(defn append! [(path String) (entries (Vec CompileFact))] (Vec Any)
  (let [(authority Any) (writer-authority/acquire! path)]
    (try
      (let [(database Any) (create-or-open! path)
            (counts AppendCounts) (append-entries! database entries)]
        ["store.dev-compile-facts/append-response-v1"
         "ok"
         (revision-identity path)
         (appendcounts-appended counts)
         (appendcounts-retained counts)])
      (finally (writer-authority/release! authority)))))

(defn- request-row [(value Any)] (Vec String)
  (if (and (vector? value)
           (= 5 (count value))
           (allowed-stage? (nth value 0))
           (exact-sha256? (nth value 1))
           (exact-sha256? (nth value 2))
           (nonempty-string? (nth value 3))
           (nonempty-string? (nth value 4)))
    [(nth value 0) (nth value 1) (nth value 2)
     (nth value 3) (nth value 4)]
    (fail "query row must be [stage key context profile unit-id]"
          :dev-compile-facts/invalid-query)))

(defn- query-rows
  [(facts (Vec CompileFact)) (requests (Vec (Vec String)))] (Vec Any)
  (reduce
   (fn [(rows (Vec Any)) (request (Vec String))] (Vec Any)
     (let [(stage String) (nth request 0)
           (result-key String) (nth request 1)
           (matches (Vec CompileFact))
           (facts-for-key facts stage result-key)]
       (vec
        (concat
         rows
         (mapv
          (fn [(entry CompileFact)] (Vec String)
            [stage result-key
             (compilefact-id entry)
             (compilefact-encoding entry)])
          matches)))))
   []
   requests))

(defn query! [(path String) (requests (Vec (Vec String)))] (Vec Any)
  (let [(file Any) (File. path)]
    (if-not (.isFile file)
      ["store.dev-compile-facts/query-response-v1"
       "COLD" "" requests []]
      (let [(database Any) (database/open-database! path space-id)
            (facts (Vec CompileFact)) (all-facts database)]
        ["store.dev-compile-facts/query-response-v1"
         "ONLINE"
         (revision-identity path)
         requests
         (query-rows facts requests)]))))

(defn- request-vector [(expected-tag String)] (Vec Any)
  (let [(line Any) (read-line)
        (value Any)
        (if (string? line) (store.rt/parse-edn line) nil)]
    (if (and (vector? value)
             (= 3 (count value))
             (= expected-tag (nth value 0)))
      value
      (fail (str "request must be " expected-tag " with three fields")
            :dev-compile-facts/invalid-request))))

(defn- query-requests-from [(value Any)] (Vec (Vec String))
  (if (vector? value)
    (mapv request-row value)
    (fail "query requests must be a vector"
          :dev-compile-facts/invalid-query)))

(defn- entry-from-value [(value Any)] CompileFact
  (if (and (vector? value)
           (= 2 (count value))
           (string? (nth value 0))
           (string? (nth value 1)))
    (compile-fact (nth value 0) (nth value 1))
    (fail "append entry must be [id canonical-envelope-edn]"
          :dev-compile-facts/invalid-entry)))

(defn- entries-from-value [(value Any)] (Vec CompileFact)
  (if (vector? value)
    (mapv entry-from-value value)
    (fail "append entries must be a vector"
          :dev-compile-facts/invalid-entry)))

(defn dispatch! [(command String)] (Vec Any)
  (cond
    [(= command "query")
     (let [(request (Vec Any))
           (request-vector "store.dev-compile-facts/query-v1")]
       (query! (absolute-store-path (nth request 1))
               (query-requests-from (nth request 2))))]
    [(= command "append")
     (let [(request (Vec Any))
           (request-vector "store.dev-compile-facts/append-v1")]
       (append! (absolute-store-path (nth request 1))
                (entries-from-value (nth request 2))))]
    [:else
     (fail (str "unknown development compile fact command: " command)
           :dev-compile-facts/unknown-command)]))

(defn- error-code [(error Any)] String
  (let [(data Any) (ex-data error)
        (code Any) (or (get data :store/code) (get data :type))]
    (if (keyword? code) (subs (str code) 1) "unclassified")))

(defn -main [& args] Nil
  (try
    (if (= 1 (count args))
      (println (pr-str (dispatch! (first args))))
      (fail "development compile facts expects one command argument"
            :dev-compile-facts/invalid-command-line))
    (catch (error Exception)
      (println
       (pr-str
        ["store.dev-compile-facts/error-v1"
         (error-code error)
         (.getMessage error)]))
      (System/exit 2))))
