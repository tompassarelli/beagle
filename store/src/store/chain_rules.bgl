#lang beagle
;; Branch layout validation shared by hosted ref folding and Native Core boot.
(ns store.chain-rules)

(defn sealed-member-fault
  [(index Int)
   (expected-space String)
   (actual-space String)
   (recorded-start Int)
   (actual-start Int)
   (recorded-end Int)
   (actual-end Int)
   (recorded-bytes Int)
   (actual-bytes Int)
   (continuation Bool)
   (torn Bool)
   (expected-next Int)]
  String?
  (cond
    [(not= expected-space actual-space)
     "FRAMLOG segment belongs to a different SpaceId"]
    [(not= recorded-bytes actual-bytes)
     "FRAMLOG segment size does not match its branch ref record"]
    [(not= recorded-start actual-start)
     "FRAMLOG segment does not begin at its recorded transaction sequence"]
    [(not= recorded-end actual-end)
     "FRAMLOG segment does not end at its recorded transaction sequence"]
    [torn "FRAMLOG segment ends inside a transaction frame"]
    [(and (pos? index) (not continuation))
     "FRAMLOG chain segment after the base segment must carry the continuation flag"]
    [(and (zero? index) continuation)
     "FRAMLOG base chain segment must not carry the continuation flag"]
    [(and (pos? actual-start) (not= expected-next actual-start))
     "FRAMLOG chain segment does not continue the previous transaction sequence"]
    [:else nil]))

(defn tail-member-fault
  [(sealed-count Int)
   (expected-space String)
   (actual-space String)
   (actual-start Int)
   (continuation Bool)
   (expected-next Int)]
  String?
  (cond
    [(not= expected-space actual-space)
     "FRAMLOG tail belongs to a different SpaceId"]
    [(and (pos? sealed-count) (not continuation))
     "FRAMLOG branch tail must carry the continuation flag"]
    [(and (zero? sealed-count) continuation)
     "FRAMLOG version or flags are unsupported"]
    [(and (pos? actual-start) (not= expected-next actual-start))
     "FRAMLOG branch tail does not continue the sealed chain"]
    [:else nil]))

(defn next-expected [(actual-end Int) (expected-next Int)] Int
  (if (pos? actual-end) (inc actual-end) expected-next))
