#lang beagle
;; Snapshot v1: a store image beside the canonical Store transaction log, never a rewrite of
;; it. Rows are emitted in position order, which IS fold order because every
;; intern conjoins at the end, so re-loading assigns identical handles.
(ns store.snapshot-codec
  (:require [commit-plan :as plan]
            [store.log-codec :as log]
            [store.native-wire-codec :as wire :refer [defwire]]
            [store.store :as term-store]
            [store.types :as t]))


(def status-ok Int 0)
(def status-fatal Int 2)

;; "store-snapshot/v1"
(def snapshot-magic (Vec Int)
  [102 114 97 109 45 115 110 97 112 115 104 111 116 47 118 49])
(def snapshot-codec-version Int 1)
(def snapshot-flags Int 0)
(def snapshot-max-count Int 2147483647)
(def snapshot-max-text-bytes Int 1048576)
(def snapshot-max-record-bytes Int 1048576)
(def snapshot-max-log-labels Int 64)
(def snapshot-header-fixed-bytes Int 28)

(def atom-string Int 1)
(def atom-int Int 2)
(def atom-float Int 3)
(def atom-bool Int 4)
(def atom-keyword Int 5)
(def atom-instant Int 6)

(def action-assert Int 1)
(def action-retract Int 2)

(def empty-bytes (Vec Int) [])
(def empty-atom-rows (Vec t/AtomRow) [])
(def empty-triple-rows (Vec t/TripleRow) [])
(def empty-transaction-rows (Vec t/TransactionRow) [])
(def empty-operation-rows (Vec t/OperationRow) [])
(def empty-labels (Vec String) [])

;; The trailer's sidecar map, spelled as a record: sequence, watermark,
;; log-set, offsets (image-start/image-end), stamp, fingerprint.
(defrecord Sidecar
  [sequence Int
   watermark Int
   log-set (Vec String)
   image-start Int
   image-end Int
   stamp Int
   fingerprint Int])

(defrecord Image
  [space-id String
   next-sequence Int
   atoms (Vec t/AtomRow)
   triples (Vec t/TripleRow)
   transactions (Vec t/TransactionRow)
   operations (Vec t/OperationRow)
   sidecar Sidecar?])

(defrecord BytesResult
  [status Int
   bytes (Vec Int)
   fingerprint Int
   error String?])

(defrecord ReadResult
  [ok Bool
   image Image?
   error String?])

(defrecord RecordResult
  [kind Int
   atom-row t/AtomRow?
   triple-row t/TripleRow?
   transaction-row t/TransactionRow?
   operation-row t/OperationRow?
   sidecar Sidecar?
   error String?])

;; reason is the sidecar-validation reason that forced a fold; report is the
;; one boot line the host prints.
(defrecord BootPlan
  [route Keyword
   reason Keyword?
   report String
   image Image?])

(wire/defwire snapshot-record
  (packet-encoded :u32le :crc32)
  (tagged :u8
    [1 atom
     [(row (codec t/AtomRow :atom
                  append-snapshot-atom-payload!
                  read-snapshot-atom-payload! -1))]]
    [2 triple [(t1 :i64le) (t2 :i64le) (t3 :i64le)]]
    [3 transaction
     [(sequence :i64le)
      (first-operation :i64le)
      (operation-count :i64le)]]
    [4 operation
     [(tx-sequence :i64le)
      (ordinal :i64le)
      (action :u8)
      (triple-handle :i64le)]]
    [5 trailer
     [(sequence :i64le)
      (watermark :i64le)
      (labels (codec (Vec String) :bounded-text-list
                     append-snapshot-labels! read-snapshot-labels! -1
                     snapshot-max-log-labels))
      (image-start :i64le)
      (image-end :i64le)
      (stamp :i64le)
      (fingerprint :u32le)]]))

(def no-sidecar Sidecar? nil)
(def no-image Image? nil)
(def no-reason Keyword? nil)

(defn failed-bytes [message String] BytesResult
  (->BytesResult status-fatal empty-bytes 0 message))

(defn failed-read [message String] ReadResult
  (->ReadResult false nil message))

(defn- text-or-empty [value String?] String (if value value ""))

(defn- atom-row-of [decoded RecordResult] t/AtomRow
  (let [row t/AtomRow? (recordresult-atom-row decoded)]
    (if row row (t/->AtomRow :int nil 0 nil nil nil nil))))

(defn- triple-row-of [decoded RecordResult] t/TripleRow
  (let [row t/TripleRow? (recordresult-triple-row decoded)]
    (if row row (t/->TripleRow -1 -1 -1))))

(defn- transaction-row-of [decoded RecordResult] t/TransactionRow
  (let [row t/TransactionRow? (recordresult-transaction-row decoded)]
    (if row row (t/->TransactionRow -1 -1 -1))))

(defn- operation-row-of [decoded RecordResult] t/OperationRow
  (let [row t/OperationRow? (recordresult-operation-row decoded)]
    (if row row (t/->OperationRow -1 -1 t/assert-action -1))))

(defn- error-or-snapshot [error String?] String
  (if error error "snapshot record decode failed"))
(defn- int-or-zero [value Int?] Int (if value value 0))
(defn- bool-or-false [value Bool?] Bool (if value value false))

(defn- new-encoder [] wire/Encoder
  (wire/->Encoder (wire/empty-byte-cell) (atom 0) (wire/empty-error-cell)))

(defn- payload-decoder
  [bytes ByteSource
   start Int
   end Int] wire/Decoder
  (wire/->Decoder bytes (atom start) end (atom 0) (wire/empty-error-cell)))

;; Every record is length-prefixed and CRC-checked on its own, so one damaged
;; row is detected without trusting any other byte of the image.
(defn- append-record!
  [out wire/Encoder
   payload wire/Encoder] Nil
  (let [error String? (deref (wire/encoder-error payload))
        bytes (Vec Int) (deref (wire/encoder-bytes payload))]
    (if error
      (wire/encoder-error! out error)
      (do
        (wire/append-u32-le! out (count bytes))
        (wire/append-bytes! out bytes)
        (wire/append-u32-le! out (log/crc32 bytes))
        nil))))

(defn- start-record!
  [out wire/Encoder
   payload-bytes Int] Int
  (do
    (wire/append-u32-le! out payload-bytes)
    (count (deref (wire/encoder-bytes out)))))

(defn- finish-record!
  [out wire/Encoder
   start Int
   payload-bytes Int] Nil
  (let [bytes (Vec Int) (deref (wire/encoder-bytes out))
        end Int (count bytes)]
    (if (not= payload-bytes (- end start))
      (wire/encoder-error!
       out "snapshot record wrote a payload of an undeclared length")
      (do
        (wire/append-u32-le! out (log/crc32-range bytes start end))
        nil))))

(defn- append-snapshot-atom-payload!
  [out wire/Encoder
   row t/AtomRow] Nil
  (let [kind (t/atomrow-kind row)]
    (cond
      [(= :string kind)
       (do
         (wire/append-u8! out atom-string)
         (wire/append-sized-text!
          out (text-or-empty (t/atomrow-string-value row))
          snapshot-max-text-bytes "snapshot string atom"))]
      [(= :int kind)
       (do
         (wire/append-u8! out atom-int)
         (wire/append-i64-le! out (int-or-zero (t/atomrow-int-value row))))]
      [(= :float kind)
       (let [value Float? (t/atomrow-float-value row)]
         (if (nil? value)
           (wire/encoder-error! out "snapshot float atom has no value")
           (let [present Float value]
             (do
               (wire/append-u8! out atom-float)
               (wire/append-i64-le! out (float-to-bits present))
               nil))))]
      [(= :bool kind)
       (do
         (wire/append-u8! out atom-bool)
         (wire/append-u8!
          out (if (bool-or-false (t/atomrow-bool-value row)) 1 0)))]
      [(= :keyword kind)
       (let [value Keyword? (t/atomrow-keyword-value row)]
         (if (nil? value)
           (wire/encoder-error! out "snapshot keyword atom has no value")
           (let [present Keyword value]
             (do
               (wire/append-u8! out atom-keyword)
               (wire/append-sized-text!
                out (subs (str present) 1) snapshot-max-text-bytes
                "snapshot keyword atom")))))]
      [(= :instant kind)
       (let [value t/Instant? (t/atomrow-instant-value row)]
         (if (nil? value)
           (wire/encoder-error! out "snapshot instant atom has no value")
           (let [present t/Instant value]
             (do
               (wire/append-u8! out atom-instant)
               (wire/append-i64-le! out (t/instant-epoch-seconds present))
               (wire/append-u32-le! out (t/instant-nanos present))
               nil))))]
      [:else
       (wire/encoder-error! out "snapshot atom row has an unknown kind")])))

(defn- append-atom-record!
  [out wire/Encoder
   row t/AtomRow] Nil
  (let [payload wire/Encoder (new-encoder)]
    (do
      (append-snapshot-record-atom! payload row)
      (append-record! out payload))))

(defn- append-triple-record!
  [out wire/Encoder
   row t/TripleRow] Nil
  (let [start Int (start-record! out snapshot-record-triple-fixed-bytes)]
    (do
      (append-snapshot-record-triple!
       out (t/triplerow-t1 row) (t/triplerow-t2 row) (t/triplerow-t3 row))
      (finish-record! out start snapshot-record-triple-fixed-bytes))))

(defn- append-transaction-record!
  [out wire/Encoder
   row t/TransactionRow] Nil
  (let [start Int (start-record! out snapshot-record-transaction-fixed-bytes)]
    (do
      (append-snapshot-record-transaction!
       out (t/transactionrow-sequence row)
       (t/transactionrow-first-operation row)
       (t/transactionrow-operation-count row))
      (finish-record! out start snapshot-record-transaction-fixed-bytes))))

(defn- append-operation-record!
  [out wire/Encoder
   row t/OperationRow] Nil
  (let [action (t/operationrow-action row)]
    (if (and (not= t/assert-action action) (not= t/retract-action action))
      (wire/encoder-error!
       out "snapshot operation action must be assert or retract")
      (let [start Int (start-record! out snapshot-record-operation-fixed-bytes)]
        (do
          (append-snapshot-record-operation!
           out (t/operationrow-tx-sequence row)
           (t/operationrow-ordinal row)
           (if (= t/assert-action action) action-assert action-retract)
           (t/operationrow-triple-handle row))
          (finish-record! out start snapshot-record-operation-fixed-bytes))))))

(defn- append-snapshot-labels!
  [out wire/Encoder
   labels (Vec String)] Nil
  (do
    (wire/append-u32-le! out (count labels))
    (loop [position Int 0]
      (if (>= position (count labels))
        nil
        (do
          (wire/append-sized-text!
           out (nth labels position) snapshot-max-text-bytes
           "snapshot log label")
          (recur (+ position 1)))))))

(defn- append-trailer-record!
  [out wire/Encoder
   sidecar Sidecar] Nil
  (let [payload wire/Encoder (new-encoder)
        labels (Vec String) (sidecar-log-set sidecar)]
    (do
      (append-snapshot-record-trailer!
       payload (sidecar-sequence sidecar) (sidecar-watermark sidecar) labels
       (sidecar-image-start sidecar) (sidecar-image-end sidecar)
       (sidecar-stamp sidecar) (sidecar-fingerprint sidecar))
      (append-record! out payload))))

(defn- append-atom-records!
  [out wire/Encoder
   rows (Vec t/AtomRow)] Nil
  (loop [position Int 0]
    (if (>= position (count rows))
      nil
      (do
        (append-atom-record! out (nth rows position))
        (recur (+ position 1))))))

(defn- append-triple-records!
  [out wire/Encoder
   rows (Vec t/TripleRow)] Nil
  (loop [position Int 0]
    (if (>= position (count rows))
      nil
      (do
        (append-triple-record! out (nth rows position))
        (recur (+ position 1))))))

(defn- append-transaction-records!
  [out wire/Encoder
   rows (Vec t/TransactionRow)] Nil
  (loop [position Int 0]
    (if (>= position (count rows))
      nil
      (do
        (append-transaction-record! out (nth rows position))
        (recur (+ position 1))))))

(defn- append-operation-records!
  [out wire/Encoder
   rows (Vec t/OperationRow)] Nil
  (loop [position Int 0]
    (if (>= position (count rows))
      nil
      (do
        (append-operation-record! out (nth rows position))
        (recur (+ position 1))))))

;; WATERMARK is the canonical Store transaction log byte count the image already accounts
;; for; boot replays only the bytes past it.
(defn encode-snapshot!
  [root (Atom t/TermStore)
   snapshot-sequence Int
   watermark Int
   stamp Int] BytesResult
  (let [dump t/TermStoreDump (term-store/dump-term-store root)
        space String (t/termstoredump-space-id dump)]
    (cond
      [(= 0 (count space))
       (failed-bytes "snapshot SpaceId must be nonempty")]
      [(or (< snapshot-sequence 0) (< watermark 0))
       (failed-bytes "snapshot sequence and watermark must be non-negative")]
      [:else
       (let [out (new-encoder)
             space-bytes (wire/utf8-bytes! out space snapshot-max-text-bytes
                               "snapshot SpaceId")]
         (do
           (swap! (wire/encoder-bytes out) into snapshot-magic)
           (wire/append-u16-le! out snapshot-codec-version)
           (wire/append-u16-le! out snapshot-flags)
           (wire/append-u32-le! out (count space-bytes))
           (swap! (wire/encoder-bytes out) into space-bytes)
           (wire/append-i64-le! out (t/termstoredump-next-sequence dump))
           (let [image-start Int (count (deref (wire/encoder-bytes out)))]
             (do
               (append-atom-records! out (t/termstoredump-atoms dump))
               (append-triple-records! out (t/termstoredump-triples dump))
               (append-transaction-records!
                out (t/termstoredump-transactions dump))
               (append-operation-records! out (t/termstoredump-operations dump))
               (let [image-bytes (Vec Int) (deref (wire/encoder-bytes out))
                     image-end Int (count image-bytes)
                     fingerprint Int (log/crc32-range image-bytes image-start image-end)]
                 (do
                   (append-trailer-record!
                    out
                    (->Sidecar snapshot-sequence watermark [space] image-start
                               image-end stamp fingerprint))
                   (let [error (deref (wire/encoder-error out))]
                     (if error
                       (failed-bytes (str "snapshot encode failed: " error))
                       (->BytesResult
                        status-ok (deref (wire/encoder-bytes out))
                        fingerprint nil)))))))))])))

(defn- failed-record [message String] RecordResult
  (->RecordResult 0 nil nil nil nil nil message))

(defn- failed-atom!
  [decoder wire/Decoder
   message String] t/AtomRow
  (do
    (wire/decoder-error! decoder message)
    (t/->AtomRow :int nil 0 nil nil nil nil)))

(defn- read-snapshot-atom-payload! [decoder wire/Decoder] t/AtomRow
  (let [kind (wire/read-u8! decoder "snapshot atom kind")]
    (cond
      [(= kind atom-string)
       (let [value (wire/read-sized-text! decoder snapshot-max-text-bytes
                                          "snapshot string atom")]
         (t/->AtomRow :string value nil nil nil nil nil))]
      [(= kind atom-int)
       (let [value (wire/read-i64-le! decoder "snapshot int atom")]
         (t/->AtomRow :int nil value nil nil nil nil))]
      [(= kind atom-float)
       (let [value (float-from-bits
                    (wire/read-i64-le! decoder "snapshot float atom"))]
         (t/->AtomRow :float nil nil value nil nil nil))]
      [(= kind atom-bool)
       (let [value (wire/read-u8! decoder "snapshot bool atom")]
         (if (> value 1)
           (failed-atom! decoder "snapshot bool atom is outside its range")
           (t/->AtomRow :bool nil nil nil (= value 1) nil nil)))]
      [(= kind atom-keyword)
       (let [spelling (wire/read-sized-text! decoder snapshot-max-text-bytes
                                             "snapshot keyword atom")]
         (if (= 0 (count spelling))
           (failed-atom!
            decoder "snapshot keyword atom spelling must be nonempty")
           (t/->AtomRow :keyword nil nil nil nil (keyword spelling) nil)))]
      [(= kind atom-instant)
       (let [seconds (wire/read-i64-le! decoder "snapshot instant atom")
             nanos (wire/read-u32-le! decoder "snapshot instant nanoseconds")]
         (if (>= nanos 1000000000)
           (failed-atom!
            decoder "snapshot instant nanoseconds are outside the range")
           (t/->AtomRow
            :instant nil nil nil nil nil (t/instant seconds nanos))))]
      [:else (failed-atom! decoder "snapshot atom record has an unknown kind")])))

(defn- read-snapshot-labels! [decoder wire/Decoder] (Vec String)
  (let [label-count (wire/read-u32-le! decoder "snapshot log label count")]
    (if (> label-count snapshot-max-log-labels)
      (do
        (wire/decoder-error! decoder
                             "snapshot log set exceeds its label bound")
        empty-labels)
      (loop [position Int 0
             current (Vec String) empty-labels]
        (if (>= position label-count)
          current
          (recur (+ position 1)
                 (conj current
                       (wire/read-sized-text!
                        decoder snapshot-max-text-bytes
                        "snapshot log label"))))))))

(defn- decode-record!
  [bytes ByteSource
   payload-start Int
   payload-end Int] RecordResult
  (let [kind (nth bytes payload-start)
        decoder (payload-decoder bytes (+ payload-start 1) payload-end)
        decoded (cond
          [(= kind snapshot-record-atom-tag)
           (let [fields WireFields_snapshot-record_atom (read-snapshot-record-atom! decoder)]
             (->RecordResult
              kind (wirefields_snapshot-record_atom-row fields)
              nil nil nil nil nil))]
          [(= kind snapshot-record-triple-tag)
           (let [fields WireFields_snapshot-record_triple (read-snapshot-record-triple! decoder)]
             (->RecordResult
              kind nil
              (t/->TripleRow
               (wirefields_snapshot-record_triple-t1 fields)
               (wirefields_snapshot-record_triple-t2 fields)
               (wirefields_snapshot-record_triple-t3 fields))
              nil nil nil nil))]
          [(= kind snapshot-record-transaction-tag)
           (let [fields WireFields_snapshot-record_transaction (read-snapshot-record-transaction! decoder)]
             (->RecordResult
              kind nil nil
              (t/->TransactionRow
               (wirefields_snapshot-record_transaction-sequence fields)
               (wirefields_snapshot-record_transaction-first-operation fields)
               (wirefields_snapshot-record_transaction-operation-count fields))
              nil nil nil))]
          [(= kind snapshot-record-operation-tag)
           (let [fields WireFields_snapshot-record_operation (read-snapshot-record-operation! decoder)
                 action Int (wirefields_snapshot-record_operation-action fields)]
             (cond
               [(= action action-assert)
                (->RecordResult
                 kind nil nil nil
                 (t/->OperationRow
                  (wirefields_snapshot-record_operation-tx-sequence fields)
                  (wirefields_snapshot-record_operation-ordinal fields)
                  t/assert-action
                  (wirefields_snapshot-record_operation-triple-handle fields))
                 nil nil)]
               [(= action action-retract)
                (->RecordResult
                 kind nil nil nil
                 (t/->OperationRow
                  (wirefields_snapshot-record_operation-tx-sequence fields)
                  (wirefields_snapshot-record_operation-ordinal fields)
                  t/retract-action
                  (wirefields_snapshot-record_operation-triple-handle fields))
                 nil nil)]
               [:else
                (failed-record "snapshot operation action is unknown")]))]
          [(= kind snapshot-record-trailer-tag)
           (let [fields WireFields_snapshot-record_trailer (read-snapshot-record-trailer! decoder)]
             (->RecordResult
              kind nil nil nil nil
              (->Sidecar
               (wirefields_snapshot-record_trailer-sequence fields)
               (wirefields_snapshot-record_trailer-watermark fields)
               (wirefields_snapshot-record_trailer-labels fields)
               (wirefields_snapshot-record_trailer-image-start fields)
               (wirefields_snapshot-record_trailer-image-end fields)
               (wirefields_snapshot-record_trailer-stamp fields)
               (wirefields_snapshot-record_trailer-fingerprint fields))
              nil))]
          [:else (failed-record "snapshot record has an unknown kind")])
        error (deref (wire/decoder-error decoder))]
    (cond
      [(recordresult-error decoded) decoded]
      [error (failed-record error)]
      [(not= 0 (wire/decoder-remaining decoder))
       (failed-record "snapshot record has trailing payload bytes")]
      [:else decoded])))

(defn- read-records!
  [bytes ByteSource
   start Int
   space-id String
   next-sequence Int] ReadResult
  (loop [position Int start
         atoms (Vec t/AtomRow) empty-atom-rows
         triples (Vec t/TripleRow) empty-triple-rows
         transactions (Vec t/TransactionRow) empty-transaction-rows
         operations (Vec t/OperationRow) empty-operation-rows]
    (cond
      [(> (+ position 8) (count bytes))
       (failed-read "snapshot trailer is missing")]
      [:else
       (let [payload-length (log/u32-le-at bytes position)
             payload-start (+ position 4)
             payload-end (+ payload-start payload-length)]
         (cond
           [(or (= 0 payload-length)
                (> payload-length snapshot-max-record-bytes))
            (failed-read "snapshot record length is outside its bound")]
           [(> (+ payload-end 4) (count bytes))
            (failed-read "snapshot record is truncated")]
           [(not= (log/u32-le-at bytes payload-end)
                  (log/crc32-range-source bytes payload-start payload-end))
            (failed-read "snapshot record CRC does not match")]
           [:else
            (let [decoded (decode-record! bytes payload-start payload-end)
                  next-position (+ payload-end 4)
                  kind (recordresult-kind decoded)]
              (cond
                [(recordresult-error decoded)
                 (failed-read
                  (error-or-snapshot (recordresult-error decoded)))]
                [(= kind snapshot-record-atom-tag)
                 (recur next-position (conj atoms (atom-row-of decoded))
                        triples transactions operations)]
                [(= kind snapshot-record-triple-tag)
                 (recur next-position atoms
                        (conj triples (triple-row-of decoded))
                        transactions operations)]
                [(= kind snapshot-record-transaction-tag)
                 (recur next-position atoms triples
                        (conj transactions (transaction-row-of decoded))
                        operations)]
                [(= kind snapshot-record-operation-tag)
                 (recur next-position atoms triples transactions
                        (conj operations (operation-row-of decoded)))]
                [(= kind snapshot-record-trailer-tag)
                 (if (not= next-position (count bytes))
                   (failed-read "snapshot trailer is not the last record")
                   (->ReadResult
                    true
                    (->Image space-id next-sequence atoms triples transactions
                             operations (recordresult-sidecar decoded))
                    nil))]
                [:else
                 (failed-read "snapshot record has an unknown kind")]))]))])))

(defn- magic-at-start? [bytes ByteSource] Bool
  (loop [position Int 0]
    (if (>= position (count snapshot-magic))
      true
      (if (= (nth bytes position) (nth snapshot-magic position))
        (recur (+ position 1))
        false))))

(defn read-snapshot!
  [bytes ByteSource
   configured-space-id String] ReadResult
  (cond
    [(< (count bytes) snapshot-header-fixed-bytes)
     (failed-read "snapshot header is truncated")]
    [(not (magic-at-start? bytes))
     (failed-read "snapshot magic does not match")]
    [:else
     (let [decoder (payload-decoder bytes (count snapshot-magic) (count bytes))
           version (wire/read-u16-le! decoder "snapshot codec version")
           flags (wire/read-u16-le! decoder "snapshot flags")
           space-length (wire/read-u32-le! decoder "snapshot SpaceId length")]
       (cond
         [(or (not= version snapshot-codec-version) (not= flags snapshot-flags))
          (failed-read "snapshot codec version or flags are unsupported")]
         [(or (= 0 space-length) (> space-length snapshot-max-text-bytes))
          (failed-read "snapshot SpaceId length is invalid")]
         [:else
          (let [space-id (wire/read-utf8! decoder space-length "snapshot SpaceId")
                next-sequence (wire/read-i64-le! decoder "snapshot next sequence")
                header-error (deref (wire/decoder-error decoder))]
            (cond
              [header-error (failed-read header-error)]
              [(< next-sequence 1)
               (failed-read "snapshot next sequence is invalid")]
              [(and (not= 0 (count configured-space-id))
                    (not= configured-space-id space-id))
               (failed-read "snapshot belongs to a different SpaceId")]
              [:else
               (read-records! bytes (deref (wire/decoder-position decoder))
                              space-id next-sequence)]))]))]))


;; The nine sidecar checks the declared contract names, answered against the log.
(defn- label-present?
  [labels (Vec String)
   label String] Bool
  (loop [position Int 0]
    (if (>= position (count labels))
      false
      (if (= label (nth labels position))
        true
        (recur (+ position 1))))))

;; -1 when the tail is empty or does not start with a readable transaction
;; record header in the Store transaction log.
(defn- tail-first-sequence!
  [log-bytes ByteSource
   watermark Int] Int
  (if (>= watermark (count log-bytes))
    -1
    (let [decoder (payload-decoder log-bytes watermark (count log-bytes))
          _ (wire/read-u32-le! decoder "snapshot tail transaction record length")
          sequence (wire/read-i64-le! decoder "snapshot tail transaction record sequence")]
      (if (deref (wire/decoder-error decoder)) -1 sequence))))

(defn- sidecar-reason!
  [snapshot-bytes ByteSource
   log-bytes ByteSource
   configured-space-id String
   image Image] Keyword?
  (let [sidecar Sidecar? (image-sidecar image)]
    (if (nil? sidecar)
      (plan/sidecarvalidation-reason
       (plan/sidecar-validation-decision
        false false false false false false false false false nil nil))
      (let [present Sidecar sidecar
            watermark Int (sidecar-watermark present)
            image-start Int (sidecar-image-start present)
            image-end Int (sidecar-image-end present)
            past-eof Bool (> watermark (count log-bytes))
            tail-sequence Int (tail-first-sequence! log-bytes watermark)
            offsets-valid Bool (and (>= image-start 0)
                 (and (>= image-end image-start)
                      (<= image-end (count snapshot-bytes))))
            decision plan/SidecarValidation (plan/sidecar-validation-decision
             true
             (>= (sidecar-sequence present) 0)
             (>= watermark 0)
             (or past-eof
                 (or (< tail-sequence 0)
                     (= tail-sequence (image-next-sequence image))))
             (or (= 0 (count configured-space-id))
                 (label-present? (sidecar-log-set present) configured-space-id))
             offsets-valid
             (> (sidecar-stamp present) 0)
             offsets-valid
             (and offsets-valid
                  (= (sidecar-fingerprint present)
                     (log/crc32-range-source
                      snapshot-bytes image-start image-end)))
             (if (or (= 0 (count configured-space-id))
                     (= configured-space-id (image-space-id image)))
               nil
               (image-space-id image))
             (if past-eof "snapshot watermark" nil))]
        (plan/sidecarvalidation-reason decision)))))

(defn- reason-report [reason Keyword?] String
  (if (nil? reason)
    "store: snapshot boot degraded to full fold; reason none"
    (str "store: snapshot boot degraded to full fold; reason "
         (subs (str (let [named Keyword reason] named)) 1))))

;; The three declared boot predicates, given their callers: an image is
;; installed only when it is present, verifies, and its sidecar agrees with
;; the log. Any refusal degrades to a full fold and never fails the boot.
(defn plan-snapshot-boot!
  [enabled Bool
   snapshot-bytes ByteSource
   log-bytes ByteSource
   configured-space-id String] BootPlan
  (let [candidate-present Bool (pos? (count snapshot-bytes))
        read ReadResult (if candidate-present
          (read-snapshot! snapshot-bytes configured-space-id)
          (failed-read "snapshot object is empty"))
        verification-ok Bool (readresult-ok read)
        install Keyword (plan/boot-install-decision candidate-present true
                                                     verification-ok)
        image Image? (readresult-image read)
        reason Keyword? (cond
          [(not candidate-present) :no-image]
          [(not verification-ok) :image-unverified]
          [(not= :snapshot install) :install-refused]
          [(nil? image) :image-unverified]
          [:else
           (sidecar-reason! snapshot-bytes log-bytes configured-space-id
                           (let [present Image image] present))])
        route Keyword (plan/snapshot-replay-decision
                        (and enabled (= :snapshot install)) reason)]
    (if (= :replay route)
      (->BootPlan
       :replay no-reason
       "store: snapshot boot installed the image and replays the log tail"
       image)
      (->BootPlan :fold reason (reason-report reason) no-image))))

;; Re-interning from the image: load-term-store! rebuilds the derived indexes
;; and refuses a dump whose handles do not resolve, so an image that would not
;; produce the folded store cannot install.
(defn install-image!
  [image Image
   root (Atom t/TermStore)] term-store/TermStoreLoadResult
  (term-store/load-term-store-result!
   root
   (t/->TermStoreDump
    term-store/term-store-dump-version
    (image-space-id image)
    (image-next-sequence image)
    (image-atoms image)
    (image-triples image)
    (image-transactions image)
    (image-operations image))))
