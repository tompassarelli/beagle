#lang beagle/clj

;; JVM Store RPC subscription generations.  Store history remains the durable
;; replay authority; this module is only the bounded notification transport
;; between one published Store version and one exact listener generation.
(ns store.rpc-subscription
  (:require [store.rpc :as rpc]
            [store.types :as t])
  (:import [java.io OutputStream]
           [java.net Socket]
           [java.util.concurrent ArrayBlockingQueue TimeUnit]))

(def subscription-max-ttl-ms Int 86400000)
(def subscription-event-operation Keyword :rpc/subscription-event)
(def subscription-operations
  #{:rpc/subscribe :rpc/subscription-ack})

(defrecord SubscriptionRegistry
  [lock Any
   generations Any
   published-version Any
   last-observed-ms Any
   now-ms Any])

(defrecord SubscriptionConnection
  [registry SubscriptionRegistry
   socket Socket
   output OutputStream
   generation Any])

(defrecord SubscriptionResult
  [payload t/Triple
   served-version Int])

(defn- subscription-fail!
  [code Keyword
   message String] Any
  (throw (ex-info message {:type code :store/code code :code code})))

(defn new-registry! [now-ms Any] SubscriptionRegistry
  (if (fn? now-ms)
    (->SubscriptionRegistry (Object.) (atom {}) (atom -1) (atom nil) now-ms)
    (subscription-fail! :rpc/subscription-invalid-clock
                        "subscription registry requires a clock function")))

(def default-registry SubscriptionRegistry
  (new-registry! #(System/currentTimeMillis)))

(defn new-connection
  [registry SubscriptionRegistry
   socket Socket
   output OutputStream] SubscriptionConnection
  (->SubscriptionConnection registry socket output (atom nil)))

(defn subscription-operation? [operation Any] Bool
  (contains? subscription-operations operation))

(defn- registry-now-ms! [registry SubscriptionRegistry] Int
  (let [value ((subscriptionregistry-now-ms registry))]
    (if (integer? value)
      value
      (subscription-fail! :rpc/subscription-invalid-clock
                          "subscription registry clock must return Int"))))

(defn- millis->instant [value Int] t/Instant
  (let [seconds (quot value 1000)
        millis (mod value 1000)]
    (t/instant seconds (* millis 1000000))))

(defn- require-nonempty-string!
  [value Any
   label String] String
  (if (and (string? value) (not (empty? value)))
    value
    (subscription-fail! :rpc/invalid-subscription
                        (str label " must be a nonempty String"))))

(defn- require-version!
  [value Any
   label String] Int
  (if (and (integer? value) (>= value -1))
    value
    (subscription-fail! :rpc/invalid-subscription
                        (str label " must be an Int at least -1"))))

(defn- require-ttl! [value Any] Int
  (if (and (integer? value)
           (and (> value 0) (<= value subscription-max-ttl-ms)))
    value
    (subscription-fail!
     :rpc/invalid-subscription
     (str "subscription ttl-ms must be in [1," subscription-max-ttl-ms "]"))))

(defn- generation-state [connection SubscriptionConnection] Any
  (deref (subscriptionconnection-generation connection)))

(defn- state-expires-ms! [state Any] Int
  (let [value (:expires-ms state)]
    (if (integer? value)
      value
      (subscription-fail! :rpc/subscription-invalid-state
                          "subscription expires-ms must be an Int"))))

(defn- next-observed-ms-under-lock! [registry SubscriptionRegistry] Int
  (let [now-ms (registry-now-ms! registry)
        previous (deref (subscriptionregistry-last-observed-ms registry))
        observed-ms (if (nil? previous)
          now-ms
          (if (integer? previous)
            (if (> now-ms previous) now-ms (+ previous 1))
            (subscription-fail! :rpc/subscription-invalid-state
                                "subscription last-observed-ms must be an Int")))]
    (reset! (subscriptionregistry-last-observed-ms registry) observed-ms)
    observed-ms))

(defn- same-live-generation?
  [registry SubscriptionRegistry
   state Any] Bool
  (identical? state
              (get (deref (subscriptionregistry-generations registry))
                   (:generation state))))

(defn- retire-under-lock!
  [registry SubscriptionRegistry
   state Any
   reason Keyword
   close-socket Bool] Nil
  (when (same-live-generation? registry state)
    (swap! (subscriptionregistry-generations registry)
           dissoc (:generation state)))
  (let [connection (:connection state)]
    (when (identical? state (generation-state connection))
      (reset! (subscriptionconnection-generation connection) nil)))
  (reset! (:state state) reason)
  (.offer ^ArrayBlockingQueue (:notifications state) -2)
  (when close-socket
    (try (.close ^Socket (:socket state)) (catch Throwable _ nil)))
  nil)

(defn- retire-generation!
  [state Any
   reason Keyword
   close-socket Bool] Nil
  (let [registry (:registry state)]
    (locking (subscriptionregistry-lock registry)
      (retire-under-lock! registry state reason close-socket))))

(defn reset-registry! [registry SubscriptionRegistry] Nil
  (locking (subscriptionregistry-lock registry)
    (let [states (vals (deref (subscriptionregistry-generations registry)))]
      (doseq [state states]
        (retire-under-lock! registry state :closed true))
      (reset! (subscriptionregistry-generations registry) {})
      (reset! (subscriptionregistry-published-version registry) -1)))
  nil)

(defn active-generation-count [registry SubscriptionRegistry] Int
  (count (deref (subscriptionregistry-generations registry))))

(defn- signal-version-under-lock!
  [state Any
   version Int] Bool
  (let [acknowledged (deref (:acknowledged-version state))
        offered (deref (:offered-version state))]
    (if (and (> version acknowledged) (> version offered))
      (do
        (reset! (:offered-version state) version)
        (.poll ^ArrayBlockingQueue (:notifications state))
        (.offer ^ArrayBlockingQueue (:notifications state) version)
        true)
      false)))

(defn publish-version!
  [registry SubscriptionRegistry
   version Int] Int
  (require-version! version "published version")
  (locking (subscriptionregistry-lock registry)
    (let [previous (deref (subscriptionregistry-published-version registry))]
      (when (< version previous)
        (subscription-fail! :rpc/subscription-version-regressed
                            "published Store version regressed"))
      (reset! (subscriptionregistry-published-version registry) version)
      (let [now-ms (registry-now-ms! registry)]
        (reduce
         (fn
           [signalled Int
            state Any] Int
           (if (>= now-ms (state-expires-ms! state))
             (do
               (retire-under-lock! registry state :expired true)
               signalled)
             (if (signal-version-under-lock! state version)
               (+ signalled 1)
               signalled)))
         0
         (vec (vals (deref (subscriptionregistry-generations registry)))))))))

(defn- open-generation!
  [connection SubscriptionConnection
   request-id Int
   space String
   payload Any] SubscriptionResult
  (let [[recipient-value awaited-value transport-value generation-value acknowledged-value ttl-value] (rpc/rpc-subscription-request-fields! payload)
        recipient (require-nonempty-string! recipient-value
                                            "subscription recipient")
        awaited (require-nonempty-string! awaited-value
                                          "subscription awaited peer/run")
        transport (require-nonempty-string! transport-value
                                            "subscription transport")
        generation (require-nonempty-string! generation-value
                                             "subscription generation")
        acknowledged (require-version! acknowledged-value
                                       "subscription acknowledged-version")
        ttl-ms (require-ttl! ttl-value)
        registry (subscriptionconnection-registry connection)]
    (locking (subscriptionregistry-lock registry)
      (when (generation-state connection)
        (subscription-fail! :rpc/subscription-already-open
                            "connection already owns a subscription generation"))
      (when (contains? (deref (subscriptionregistry-generations registry)) generation)
        (subscription-fail! :rpc/subscription-generation-active
                            "subscription generation is already active"))
      (let [baseline (deref (subscriptionregistry-published-version registry))]
        (when (> acknowledged baseline)
          (subscription-fail!
           :rpc/subscription-cursor-ahead
           "subscription acknowledged-version is ahead of Store publication"))
        (let [observed-ms (next-observed-ms-under-lock! registry)
              expires-ms (+ observed-ms ttl-ms)
              identity (rpc/rpc-subscription-identity!
                        recipient awaited transport generation
                        (millis->instant observed-ms)
                        (millis->instant expires-ms))
              state {:registry registry
                     :connection connection
                     :socket (subscriptionconnection-socket connection)
                     :output (subscriptionconnection-output connection)
                     :space space
                     :request-id request-id
                     :generation generation
                     :identity identity
                     :baseline-version baseline
                     :observed-ms observed-ms
                     :expires-ms expires-ms
                     :acknowledged-version (atom acknowledged)
                     :offered-version (atom baseline)
                     :delivered-version (atom acknowledged)
                     :notifications (ArrayBlockingQueue. 1)
                     :delivery-lock (Object.)
                     :state (atom :opening)
                     :writer (atom nil)}]
          (swap! (subscriptionregistry-generations registry)
                 assoc generation state)
          (reset! (subscriptionconnection-generation connection) state)
          (->SubscriptionResult
           (rpc/rpc-subscription-open! identity baseline acknowledged)
           baseline))))))

(defn- write-event!
  [state Any
   version Int] Nil
  (locking (:delivery-lock state)
    (let [acknowledged (deref (:acknowledged-version state))]
      (when (and (= :active (deref (:state state)))
                 (> version acknowledged))
        (let [response (rpc/rpc-response!
                        (:space state) subscription-event-operation version
                        nil nil
                        (rpc/rpc-subscription-event!
                         (:identity state) acknowledged version))
              packet (rpc/store-rpc-event-packet (:request-id state) response)
              bytes (rpc/store-rpc-encode-packet-v2! packet)
              output ^OutputStream (:output state)]
          (locking output
            (.write output bytes)
            (.flush output))
          (reset! (:delivered-version state) version)))))
  nil)

(defn- writer-loop! [state Any] Nil
  (try
    (loop []
      (let [registry (:registry state)
            remaining (- (state-expires-ms! state)
                         (registry-now-ms! registry))]
        (if (and (= :active (deref (:state state))) (> remaining 0))
          (let [version (.poll ^ArrayBlockingQueue (:notifications state)
                               remaining TimeUnit/MILLISECONDS)]
            (cond
              [(nil? version)
               (retire-generation! state :expired true)]
              [(neg? version) nil]
              [:else
               (do
                 (write-event! state version)
                 (recur))]))
          (retire-generation! state :expired true))))
    (catch InterruptedException _
      (retire-generation! state :closed false))
    (catch Throwable _
      (retire-generation! state :transport-closed true)))
  nil)

(defn activate-open!
  [connection SubscriptionConnection
   operation Keyword] Nil
  (when (= operation :rpc/subscribe)
    (when-let [state (generation-state connection)]
      (locking (:delivery-lock state)
        (when (= :opening (deref (:state state)))
          ;; The ordinary OPEN response has reached the transport before this
          ;; transition, so its baseline is now eligible for causal ACK.
          (reset! (:delivered-version state)
                  (:baseline-version state))
          (reset! (:state state) :active)
          (reset! (:writer state)
                  (future-call (fn [] Nil (writer-loop! state))))))))
  nil)

(defn- acknowledge-generation!
  [connection SubscriptionConnection
   payload Any] SubscriptionResult
  (let [[identity observed-value] (rpc/rpc-subscription-ack-fields! payload)
        _ (rpc/rpc-subscription-identity-fields! identity)
        observed (require-version! observed-value
                                   "subscription observed-version")
        registry (subscriptionconnection-registry connection)
        state (generation-state connection)]
    (when-not state
      (subscription-fail! :rpc/subscription-unavailable
                          "connection has no active subscription generation"))
    (locking (subscriptionregistry-lock registry)
      (when-not (same-live-generation? registry state)
        (subscription-fail! :rpc/subscription-unavailable
                            "subscription generation is no longer active"))
      (when (>= (registry-now-ms! registry) (state-expires-ms! state))
        (retire-under-lock! registry state :expired true)
        (subscription-fail! :rpc/subscription-expired
                            "subscription generation has expired")))
    (when-not (= identity (:identity state))
      (subscription-fail! :rpc/subscription-identity-mismatch
                          "subscription ACK identity does not match OPEN"))
    (locking (:delivery-lock state)
      (when-not (= :active (deref (:state state)))
        (subscription-fail! :rpc/subscription-unavailable
                            "subscription generation is not active"))
      (let [acknowledged (deref (:acknowledged-version state))
            delivered (deref (:delivered-version state))]
        (when (< observed acknowledged)
          (subscription-fail! :rpc/subscription-stale-ack
                              "subscription ACK regresses the replay cursor"))
        (when (> observed delivered)
          (subscription-fail! :rpc/subscription-unobserved-ack
                              "subscription ACK names an undelivered version"))
        (reset! (:acknowledged-version state) observed)))
    (->SubscriptionResult
     (rpc/rpc-subscription-acknowledged! (:identity state) observed)
     (deref (subscriptionregistry-published-version registry)))))

(defn handle-request!
  [connection SubscriptionConnection
   request-id Int
   space String
   operation Keyword
   payload Any] SubscriptionResult
  (cond
    [(= operation :rpc/subscribe)
     (open-generation! connection request-id space payload)]
    [(= operation :rpc/subscription-ack)
     (acknowledge-generation! connection payload)]
    [:else
     (subscription-fail! :rpc/unsupported-operation
                         "operation is not a subscription operation")]))

(defn handle-rpc-request!
  [connection SubscriptionConnection
   request-id Int
   request t/RpcRequest] t/RpcResponse
  (let [space (t/rpcrequest-space request)
        operation (t/rpcrequest-op request)]
    (when (t/rpcrequest-expected-version request)
      (subscription-fail!
       :rpc/unexpected-expected-version
       "subscription requests carry their cursor in the typed payload"))
    (when (t/rpcrequest-page request)
      (subscription-fail! :rpc/unexpected-page
                          "subscription requests do not support paging"))
    (when (t/rpcrequest-timeout-ms request)
      (subscription-fail! :rpc/unexpected-timeout
                          "subscription requests use the generation TTL"))
    (let [result (handle-request!
                  connection request-id space operation
                  (t/rpc-request-payload-value request))]
      (rpc/rpc-response!
       space operation
       (subscriptionresult-served-version result)
       nil nil
       (subscriptionresult-payload result)))))

(defn read-timeout-ms!
  [connection SubscriptionConnection
   default-timeout-ms Int] Int
  (if-let [state (generation-state connection)]
    (let [remaining (- (state-expires-ms! state)
                       (registry-now-ms!
                        (subscriptionconnection-registry connection)))]
      (if (> remaining 0)
        (int (max 1 (min 2147483647 remaining)))
        default-timeout-ms))
    default-timeout-ms))

(defn continue-after-read-timeout?! [connection SubscriptionConnection] Bool
  (if-let [state (generation-state connection)]
    (let [registry (subscriptionconnection-registry connection)]
      (if (< (registry-now-ms! registry) (state-expires-ms! state))
        true
        (do
          (retire-generation! state :expired true)
          false)))
    false))

(defn close-connection! [connection SubscriptionConnection] Nil
  (when-let [state (generation-state connection)]
    (retire-generation! state :closed false))
  nil)
