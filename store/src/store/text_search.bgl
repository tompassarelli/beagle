#lang beagle
;; Additive analyzers over the exact word index. The released text-match
;; relation delegates to its original source and keeps its semantics unchanged.
(ns store.text-search)
(require clojure.string :as str)
(require store.text-index :as text-index)
(require store.types :as t)

(defalias PostingMap (Map String (Vec Int)))

(def WORD-SEPARATOR-RE Regex (re-pattern "[^\\p{L}\\p{Nd}]+"))

(defrecord SearchAnalyzers
  [(token-rows (Vec (Vec String)))
   (normalized-rows (Vec String))
   (stem-postings PostingMap)
   (trigram-postings PostingMap)
   (bytes Int)])

;; Analyzers realize on first use of their relations, so the shipped
;; text-match build and query budgets stay untouched by them.
(defrecord TextSearchSource
  [(exact text-index/TextCandidateSource)
   (rows (Vec t/Triple))
   (maximum Int)
   (analyzers-cell (Atom (U SearchAnalyzers Nil)))
   (bytes Int)])

(defrecord SearchBuildState
  [(token-rows (Vec (Vec String)))
   (normalized-rows (Vec String))
   (stem-postings PostingMap)
   (trigram-postings PostingMap)])

(defrecord TextSearchSourceResult
  [(ok Bool) (source TextSearchSource?) (error text-index/TextError)])

(defrecord TextSearchHandlesResult
  [(ok Bool) (handles (Vec Int)) (error text-index/TextError)])

(defrecord TextSearchRowsResult
  [(ok Bool) (rows (Vec (Vec Any))) (error text-index/TextError)])

(defrecord TextSearchScoreResult
  [(ok Bool) (score Int) (error text-index/TextError)])

(defrecord SearchAnalyzersResult
  [(ok Bool) (analyzers SearchAnalyzers) (error text-index/TextError)])

(defrecord StringNeedleResult
  [(ok Bool) (value String) (error text-index/TextError)])

(defrecord WordNeedleResult
  [(ok Bool) (tokens (Vec String)) (error text-index/TextError)])

(defn source-result-ok? [(result TextSearchSourceResult)] Bool
  (textsearchsourceresult-ok result))

(defn source-result-source [(result TextSearchSourceResult)] TextSearchSource?
  (textsearchsourceresult-source result))

(defn source-result-error [(result TextSearchSourceResult)] text-index/TextError
  (textsearchsourceresult-error result))

(defn handles-result-ok? [(result TextSearchHandlesResult)] Bool
  (textsearchhandlesresult-ok result))

(defn handles-result-handles [(result TextSearchHandlesResult)] (Vec Int)
  (textsearchhandlesresult-handles result))

(defn handles-result-error
  [(result TextSearchHandlesResult)] text-index/TextError
  (textsearchhandlesresult-error result))

(defn rows-result-ok? [(result TextSearchRowsResult)] Bool
  (textsearchrowsresult-ok result))

(defn rows-result-rows [(result TextSearchRowsResult)] (Vec (Vec Any))
  (textsearchrowsresult-rows result))

(defn rows-result-error [(result TextSearchRowsResult)] text-index/TextError
  (textsearchrowsresult-error result))

(defn query-text-rows-error
  [(code Keyword) (message String)] TextSearchRowsResult
  (->TextSearchRowsResult false [] (text-index/query-text-error code message)))

(defn source-weight [(source TextSearchSource)] Int
  (let [(analyzers (U SearchAnalyzers Nil))
        (deref (textsearchsource-analyzers-cell source))]
    (+ (textsearchsource-bytes source)
       (if (nil? analyzers) 0 (searchanalyzers-bytes analyzers)))))

(defn- lower [(value String)] String
  (str/lower-case value))

(defn word-tokens [(value String)] (Vec String)
  (let [(parts (Vec String)) (str/split value WORD-SEPARATOR-RE)]
    (loop [(index Int) 0 (tokens (Vec String)) []]
      (if (>= index (count parts))
        tokens
        (let [(token String) (nth parts index)]
          (recur (inc index)
                 (if (= "" token)
                   tokens
                   (conj tokens (lower token)))))))))

(defn- drop-last [(value String) (amount Int)] String
  (subs value 0 (- (count value) amount)))

(defn- vowel? [(character String)] Bool
  (contains? #{"a" "e" "i" "o" "u"} character))

(defn- vowel-at? [(value String) (index Int)] Bool
  (vowel? (subs value index (inc index))))

(defn- has-vowel? [(value String)] Bool
  (loop [index 0]
    (if (>= index (count value))
      false
      (if (vowel-at? value index) true (recur (inc index))))))

(defn- double-consonant? [(value String)] Bool
  (let [size (count value)]
    (and (>= size 2)
         (let [last-char (subs value (dec size) size)
               prior-char (subs value (- size 2) (dec size))]
           (and (= last-char prior-char)
                (and (not (vowel? last-char))
                     (not (contains? #{"l" "s" "z"} last-char))))))))

(defn- short-syllable? [(value String)] Bool
  (let [size (count value)]
    (and (>= size 3)
         (let [first-char (subs value (- size 3) (- size 2))
               middle-char (subs value (- size 2) (dec size))
               last-char (subs value (dec size) size)]
           (and (not (vowel? first-char))
                (and (vowel? middle-char)
                     (and (not (vowel? last-char))
                          (not (contains? #{"w" "x" "y"} last-char)))))))))

(defn- normalize-verb-stem [(value String)] String
  (if (double-consonant? value)
    (drop-last value 1)
    (if (short-syllable? value) (str value "e") value)))

(defn- plural-stem [(value String)] String
  (cond
    [(and (> (count value) 4) (str/ends-with? value "ies"))
     (str (drop-last value 3) "y")]
    [(str/ends-with? value "sses") (drop-last value 2)]
    [(and (> (count value) 3)
          (and (str/ends-with? value "s")
               (not (or (str/ends-with? value "ss")
                        (or (str/ends-with? value "us")
                            (str/ends-with? value "is"))))))
     (drop-last value 1)]
    [:else value]))

(defn english-stem [(token String)] String
  (let [value (plural-stem (lower token))]
    (cond
      [(and (> (count value) 4) (str/ends-with? value "ied"))
       (str (drop-last value 3) "y")]
      [(and (> (count value) 5) (str/ends-with? value "ing"))
       (let [base (drop-last value 3)]
         (if (has-vowel? base) (normalize-verb-stem base) value))]
      [(and (> (count value) 4) (str/ends-with? value "ed"))
       (let [base (drop-last value 2)]
         (if (has-vowel? base) (normalize-verb-stem base) value))]
      [(and (> (count value) 4) (str/ends-with? value "ly"))
       (drop-last value 2)]
      [(and (> (count value) 4) (str/ends-with? value "er"))
       (let [base (drop-last value 2)]
         (if (has-vowel? base) (normalize-verb-stem base) value))]
      [(and (> (count value) 5) (str/ends-with? value "est"))
       (let [base (drop-last value 3)]
         (if (has-vowel? base) (normalize-verb-stem base) value))]
      [:else value])))

(defn- stems [(tokens (Vec String))] (Set String)
  (set (mapv (fn [(token String)] String (english-stem token)) tokens)))

(defn- trigrams [(value String)] (Set String)
  (loop [(index Int) 0 (grams (Set String)) #{}]
    (if (> (+ index 3) (count value))
      grams
      (recur (inc index) (conj grams (subs value index (+ index 3)))))))

(defn- postings-add
  [(postings PostingMap) (keys (Vec String)) (handle Int)] PostingMap
  (reduce (fn [(current PostingMap) (key String)] PostingMap
            (assoc current key (conj (get current key []) handle)))
          postings keys))

(defn- postings-weight [(postings PostingMap)] Int
  (reduce-kv (fn [(total Int) (key String) (handles (Vec Int))] Int
               (+ total 84 (* 4 (count key)) (* 42 (count handles))))
             0 postings))

(defn- token-rows-weight [(rows (Vec (Vec String)))] Int
  (reduce (fn [(total Int) (tokens (Vec String))] Int
            (let [(token-weight Int)
                  (loop [(remaining (Vec String)) tokens (subtotal Int) 0]
                    (if (empty? remaining)
                      subtotal
                      (recur (vec (rest remaining))
                             (+ subtotal 42 (* 4 (count (first remaining)))))))]
              (+ total 42 token-weight)))
          0 rows))

(defn- strings-weight [(values (Vec String))] Int
  (reduce (fn [(total Int) (value String)] Int
            (+ total 70 (* 4 (count value))))
          0 values))

(defn- index-limit-error [(weight Int) (maximum Int)] text-index/TextError?
  (if (> weight maximum)
    (text-index/text-index-limit-error
     "text search index exceeds the snapshot cache budget" weight maximum)
    nil))

(defn- index-limit [(weight Int) (maximum Int)] Nil
  (if (> weight maximum)
    (text-index/raise-text-error
     (text-index/text-index-limit-error
      "text search index exceeds the snapshot cache budget" weight maximum))
    nil))

(defn- build-state [(rows (Vec t/Triple))] SearchBuildState
  (loop [(handle Int) 0
         (state SearchBuildState) (->SearchBuildState [] [] {} {})]
    (if (>= handle (count rows))
      state
      (let [(value Any) (t/triple-t3 (nth rows handle))]
        (if (string? value)
          (let [(tokens (Vec String)) (word-tokens value)
                (normalized String) (lower value)
                (stem-keys (Set String)) (stems tokens)
                (gram-keys (Set String)) (trigrams normalized)]
            (recur
             (inc handle)
             (->SearchBuildState
              (conj (searchbuildstate-token-rows state) tokens)
              (conj (searchbuildstate-normalized-rows state) normalized)
              (postings-add (searchbuildstate-stem-postings state)
                            (vec stem-keys) handle)
              (postings-add (searchbuildstate-trigram-postings state)
                            (vec gram-keys) handle))))
          (recur
           (inc handle)
           (->SearchBuildState
            (conj (searchbuildstate-token-rows state) [])
            (conj (searchbuildstate-normalized-rows state) "")
            (searchbuildstate-stem-postings state)
            (searchbuildstate-trigram-postings state))))))))

(defn build-source-result!
  [(propositions (Vec t/Triple)) (maximum Int)] TextSearchSourceResult
  (let [(rows (Vec t/Triple)) (vec propositions)
        (exact-result text-index/TextCandidateSourceResult)
        (text-index/build-source-result! rows maximum)
        (exact text-index/TextCandidateSource?)
        (text-index/source-result-source exact-result)]
    (if (nil? exact)
      (->TextSearchSourceResult
       false nil (text-index/source-result-error exact-result))
      (let [(weight Int)
            (+ (text-index/source-weight exact)
               112
               (* 28 (count rows)))
            (error text-index/TextError?) (index-limit-error weight maximum)]
        (if error
          (->TextSearchSourceResult false nil error)
          (let [(empty-analyzers (U SearchAnalyzers Nil)) nil
                (cell (Atom (U SearchAnalyzers Nil))) (atom empty-analyzers)]
            (->TextSearchSourceResult
             true (->TextSearchSource exact rows maximum cell weight)
             (text-index/no-text-error))))))))

(defn propositions-for-attributes
  [(propositions (Vec t/Triple)) (attributes (Set Any))] (Vec t/Triple)
  (filterv
   (fn [(proposition t/Triple)] Bool
     (contains? attributes (t/triple-t2 proposition)))
   propositions))

(defn build-source-for-attributes-result!
  [(propositions (Vec t/Triple))
   (attributes (Set Any))
   (maximum Int)]
  TextSearchSourceResult
  (build-source-result!
   (propositions-for-attributes propositions attributes) maximum))

(defn build-source!
  [(propositions (Vec t/Triple)) (maximum Int)] TextSearchSource
  (let [(rows (Vec t/Triple)) (vec propositions)
        (exact text-index/TextCandidateSource)
        (text-index/build-source! rows maximum)
        (weight Int)
        (+ (text-index/source-weight exact)
           112
           (* 28 (count rows)))
        (empty-analyzers (U SearchAnalyzers Nil)) nil
        (cell (Atom (U SearchAnalyzers Nil))) (atom empty-analyzers)]
    (index-limit weight maximum)
    (->TextSearchSource exact rows maximum cell weight)))

(defn build-source-for-attributes!
  [(propositions (Vec t/Triple))
   (attributes (Set Any))
   (maximum Int)]
  TextSearchSource
  (build-source!
   (propositions-for-attributes propositions attributes) maximum))

;; Build-on-first-use with a benign race: a concurrent double build is
;; idempotent and last-wins, matching the snapshot cache's own semantics.
(defn- analyzers-of-result! [(source TextSearchSource)] SearchAnalyzersResult
  (let [(current (U SearchAnalyzers Nil))
        (deref (textsearchsource-analyzers-cell source))]
    (if (nil? current)
      (let [(state SearchBuildState)
            (build-state (textsearchsource-rows source))
            (token-rows (Vec (Vec String))) (searchbuildstate-token-rows state)
            (normalized-rows (Vec String))
            (searchbuildstate-normalized-rows state)
            (stem-postings PostingMap) (searchbuildstate-stem-postings state)
            (trigram-postings PostingMap)
            (searchbuildstate-trigram-postings state)
            (weight Int)
            (+ (token-rows-weight token-rows)
               (strings-weight normalized-rows)
               (postings-weight stem-postings)
               (postings-weight trigram-postings))
            (analyzers SearchAnalyzers)
            (->SearchAnalyzers token-rows normalized-rows
                               stem-postings trigram-postings weight)
            (error text-index/TextError?)
            (index-limit-error (+ (textsearchsource-bytes source) weight)
                               (textsearchsource-maximum source))]
        (if error
          (->SearchAnalyzersResult false analyzers error)
          (do
            (reset! (textsearchsource-analyzers-cell source) analyzers)
            (->SearchAnalyzersResult
             true analyzers (text-index/no-text-error)))))
      (->SearchAnalyzersResult true current (text-index/no-text-error)))))

(defn- analyzers-of! [(source TextSearchSource)] SearchAnalyzers
  (let [(result SearchAnalyzersResult) (analyzers-of-result! source)]
    (if (searchanalyzersresult-ok result)
      (searchanalyzersresult-analyzers result)
      (text-index/raise-text-error (searchanalyzersresult-error result)))))

(defn- string-needle-result [(relation String) (needle Any)] StringNeedleResult
  (if (string? needle)
    (->StringNeedleResult true needle (text-index/no-text-error))
    (->StringNeedleResult
     false ""
     (text-index/query-text-error
      :query-text-invalid-needle
      (str relation " needle must be a string")))))

(defn- string-needle [(relation String) (needle Any)] String
  (let [(result StringNeedleResult) (string-needle-result relation needle)]
    (if (stringneedleresult-ok result)
      (stringneedleresult-value result)
      (text-index/raise-text-error (stringneedleresult-error result)))))

(defn- word-needle-result [(relation String) (needle Any)] WordNeedleResult
  (let [(string-result StringNeedleResult)
        (string-needle-result relation needle)]
    (if (not (stringneedleresult-ok string-result))
      (->WordNeedleResult false [] (stringneedleresult-error string-result))
      (let [(tokens (Vec String))
            (word-tokens (stringneedleresult-value string-result))]
        (if (empty? tokens)
          (->WordNeedleResult
           false []
           (text-index/query-text-error
            :query-text-invalid-needle
            (str relation " needle must contain at least one word token")))
          (->WordNeedleResult true tokens (text-index/no-text-error)))))))

(defn- word-needle [(relation String) (needle Any)] (Vec String)
  (let [(result WordNeedleResult) (word-needle-result relation needle)]
    (if (wordneedleresult-ok result)
      (wordneedleresult-tokens result)
      (text-index/raise-text-error (wordneedleresult-error result)))))

(defn- substring-needle-result
  [(relation String) (needle Any)] StringNeedleResult
  (let [(string-result StringNeedleResult)
        (string-needle-result relation needle)]
    (if (not (stringneedleresult-ok string-result))
      string-result
      (let [(value String) (lower (stringneedleresult-value string-result))]
        (if (empty? (str/trim value))
          (->StringNeedleResult
           false ""
           (text-index/query-text-error
            :query-text-invalid-needle
            (str relation " needle must contain non-whitespace text")))
          (->StringNeedleResult true value (text-index/no-text-error)))))))

(defn- substring-needle [(relation String) (needle Any)] String
  (let [(result StringNeedleResult) (substring-needle-result relation needle)]
    (if (stringneedleresult-ok result)
      (stringneedleresult-value result)
      (text-index/raise-text-error (stringneedleresult-error result)))))

(defn word-needle-valid? [(needle Any)] Bool
  (and (string? needle) (not (empty? (word-tokens needle)))))

(defn substring-needle-valid? [(needle Any)] Bool
  (if (string? needle)
    (let [(text String) needle]
      (not (empty? (str/trim text))))
    false))

(defn- shortest-posting [(vectors (Vec (Vec Int)))] (Vec Int)
  (let [(empty-handles (Vec Int)) []]
    (if (empty? vectors)
      empty-handles
      (loop [(index Int) 1
             (best (Vec Int)) (nth vectors 0)]
        (if (>= index (count vectors))
          best
          (let [(candidate (Vec Int)) (nth vectors index)]
            (recur (inc index)
                   (if (< (count candidate) (count best))
                     candidate best))))))))

(defn- postings-handles [(postings PostingMap) (keys (Vec String))] (Vec Int)
  (let [(wanted (Vec String)) (vec (sort (vec (set keys))))]
    (if (empty? wanted)
      []
      (let [(vectors (Vec (Vec Int)))
            (mapv (fn [(key String)] (Vec Int) (get postings key [])) wanted)
            (seed (Vec Int)) (shortest-posting vectors)]
        (if (or (empty? seed) (= 1 (count vectors)))
          seed
          (let [(sets (Vec (Set Int)))
                (mapv (fn [(handles (Vec Int))] (Set Int) (set handles)) vectors)]
            (filterv (fn [(handle Int)] Bool
                       (every? (fn [(handles (Set Int))] Bool
                                 (contains? handles handle))
                               sets))
                     seed)))))))

(defn- all-handles [(source TextSearchSource)] (Vec Int)
  (vec (range (count (textsearchsource-rows source)))))

(defn- sequence-at?
  [(haystack (Vec String)) (needle (Vec String)) (start Int)] Bool
  (loop [offset 0]
    (if (>= offset (count needle))
      true
      (if (= (nth haystack (+ start offset)) (nth needle offset))
        (recur (inc offset))
        false))))

(defn- sequence-contains? [(haystack (Vec String)) (needle (Vec String))] Bool
  (if (or (empty? needle) (> (count needle) (count haystack)))
    false
    (loop [start 0]
      (if (> (+ start (count needle)) (count haystack))
        false
        (if (sequence-at? haystack needle start)
          true
          (recur (inc start)))))))

(defn- handles-ok [(handles (Vec Int))] TextSearchHandlesResult
  (->TextSearchHandlesResult true handles (text-index/no-text-error)))

(defn- handles-error [(error text-index/TextError)] TextSearchHandlesResult
  (->TextSearchHandlesResult false [] error))

(defn- rows-ok [(rows (Vec (Vec Any)))] TextSearchRowsResult
  (->TextSearchRowsResult true rows (text-index/no-text-error)))

(defn- rows-error [(error text-index/TextError)] TextSearchRowsResult
  (->TextSearchRowsResult false [] error))

(defn phrase-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result WordNeedleResult)
        (word-needle-result "text-phrase" needle)]
    (if (not (wordneedleresult-ok needle-result))
      (handles-error (wordneedleresult-error needle-result))
      (let [(indexed-result text-index/TextHandlesResult)
            (text-index/indexed-handles-result!
             (textsearchsource-exact source) needle)]
        (if (not (text-index/handles-result-ok? indexed-result))
          (handles-error (text-index/handles-result-error indexed-result))
          (let [(analyzers-result SearchAnalyzersResult)
                (analyzers-of-result! source)]
            (if (not (searchanalyzersresult-ok analyzers-result))
              (handles-error (searchanalyzersresult-error analyzers-result))
              (let [(tokens (Vec String))
                    (wordneedleresult-tokens needle-result)
                    (candidates (Vec Int))
                    (text-index/handles-result-handles indexed-result)
                    (rows (Vec (Vec String)))
                    (searchanalyzers-token-rows
                     (searchanalyzersresult-analyzers analyzers-result))]
                (handles-ok
                 (filterv (fn [(handle Int)] Bool
                            (sequence-contains? (nth rows handle) tokens))
                          candidates))))))))))

(defn phrase-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (phrase-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn phrase-scan-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result WordNeedleResult)
        (word-needle-result "text-phrase" needle)]
    (if (not (wordneedleresult-ok needle-result))
      (handles-error (wordneedleresult-error needle-result))
      (let [(analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (let [(tokens (Vec String)) (wordneedleresult-tokens needle-result)
                (rows (Vec (Vec String)))
                (searchanalyzers-token-rows
                 (searchanalyzersresult-analyzers analyzers-result))]
            (handles-ok
             (filterv (fn [(handle Int)] Bool
                        (sequence-contains? (nth rows handle) tokens))
                      (all-handles source)))))))))

(defn phrase-scan-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (phrase-scan-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn substring-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result StringNeedleResult)
        (substring-needle-result "text-substring" needle)]
    (if (not (stringneedleresult-ok needle-result))
      (handles-error (stringneedleresult-error needle-result))
      (let [(value String) (stringneedleresult-value needle-result)
            (grams (Vec String)) (vec (trigrams value))
            (analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (let [(analyzers SearchAnalyzers)
                (searchanalyzersresult-analyzers analyzers-result)
                (candidates (Vec Int))
                (if (empty? grams)
                  (all-handles source)
                  (postings-handles
                   (searchanalyzers-trigram-postings analyzers) grams))
                (rows (Vec String))
                (searchanalyzers-normalized-rows analyzers)]
            (handles-ok
             (filterv (fn [(handle Int)] Bool
                        (str/includes? (nth rows handle) value))
                      candidates))))))))

(defn substring-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (substring-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn substring-scan-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result StringNeedleResult)
        (substring-needle-result "text-substring" needle)]
    (if (not (stringneedleresult-ok needle-result))
      (handles-error (stringneedleresult-error needle-result))
      (let [(analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (let [(value String) (stringneedleresult-value needle-result)
                (rows (Vec String))
                (searchanalyzers-normalized-rows
                 (searchanalyzersresult-analyzers analyzers-result))]
            (handles-ok
             (filterv (fn [(handle Int)] Bool
                        (str/includes? (nth rows handle) value))
                      (all-handles source)))))))))

(defn substring-scan-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (substring-scan-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn stem-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result WordNeedleResult)
        (word-needle-result "text-stem" needle)]
    (if (not (wordneedleresult-ok needle-result))
      (handles-error (wordneedleresult-error needle-result))
      (let [(keys (Vec String))
            (vec (stems (wordneedleresult-tokens needle-result)))
            (analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (handles-ok
           (postings-handles
            (searchanalyzers-stem-postings
             (searchanalyzersresult-analyzers analyzers-result))
            keys)))))))

(defn stem-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult) (stem-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn stem-scan-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result WordNeedleResult)
        (word-needle-result "text-stem" needle)]
    (if (not (wordneedleresult-ok needle-result))
      (handles-error (wordneedleresult-error needle-result))
      (let [(analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (let [(keys (Vec String))
                (vec (stems (wordneedleresult-tokens needle-result)))
                (rows (Vec (Vec String)))
                (searchanalyzers-token-rows
                 (searchanalyzersresult-analyzers analyzers-result))]
            (handles-ok
             (filterv (fn [(handle Int)] Bool
                        (let [(row-stems (Set String))
                              (stems (nth rows handle))]
                          (every? (fn [(key String)] Bool
                                    (contains? row-stems key))
                                  keys)))
                      (all-handles source)))))))))

(defn stem-scan-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (stem-scan-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn- count-token [(tokens (Vec String)) (wanted String)] Int
  (reduce (fn [(total Int) (token String)] Int
            (if (= token wanted) (inc total) total))
          0 tokens))

(defn- score-at-result!
  [(source TextSearchSource) (handle Int) (needle Any)] TextSearchScoreResult
  (let [(needle-result StringNeedleResult)
        (substring-needle-result "text-search" needle)]
    (if (not (stringneedleresult-ok needle-result))
      (->TextSearchScoreResult
       false 0 (stringneedleresult-error needle-result))
      (let [(analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (->TextSearchScoreResult
           false 0 (searchanalyzersresult-error analyzers-result))
          (let [(value String) (stringneedleresult-value needle-result)
                (query-tokens (Vec String)) (word-tokens value)
                (query-stems (Vec String)) (vec (stems query-tokens))
                (analyzers SearchAnalyzers)
                (searchanalyzersresult-analyzers analyzers-result)
                (document-tokens (Vec String))
                (nth (searchanalyzers-token-rows analyzers) handle)
                (document-token-set (Set String)) (set document-tokens)
                (document-stems (Set String)) (stems document-tokens)
                (normalized String)
                (nth (searchanalyzers-normalized-rows analyzers) handle)
                (substring-match Bool) (str/includes? normalized value)
                (stem-covered Bool)
                (and (not (empty? query-stems))
                     (every? (fn [(key String)] Bool
                               (contains? document-stems key))
                             query-stems))
                (phrase-match Bool)
                (and (not (empty? query-tokens))
                     (sequence-contains? document-tokens query-tokens))
                (score Int)
                (if (not (or substring-match stem-covered))
                  0
                  (let [(token-score Int)
                        (reduce
                         (fn [(total Int) (token String)] Int
                           (let [(match-score Int)
                                 (cond
                                   [(contains? document-token-set token) 100]
                                   [(contains? document-stems
                                               (english-stem token)) 60]
                                   [:else 0])
                                 (match-count Int)
                                 (min 3 (count-token document-tokens token))]
                             (+ total match-score (* 5 match-count))))
                         0 query-tokens)
                        (phrase-score Int) (if phrase-match 250 0)
                        (substring-score Int) (if substring-match 80 0)
                        (exact-score Int) (if (= normalized value) 400 0)
                        (raw Int)
                        (+ token-score phrase-score substring-score exact-score)
                        (penalty Int)
                        (min 40
                             (max 0 (- (count document-tokens)
                                       (count query-tokens))))]
                    (max 1 (- raw penalty))))]
            (->TextSearchScoreResult
             true score (text-index/no-text-error))))))))

(defn- score-at! [(source TextSearchSource) (handle Int) (needle Any)] Int
  (let [(result TextSearchScoreResult)
        (score-at-result! source handle needle)]
    (if (textsearchscoreresult-ok result)
      (textsearchscoreresult-score result)
      (text-index/raise-text-error (textsearchscoreresult-error result)))))

(defn- union-handles [(left (Vec Int)) (right (Vec Int))] (Vec Int)
  (vec (sort (vec (set (concat left right))))))

(defn- matching-score-handles-result!
  [(source TextSearchSource)
   (needle Any)
   (candidates (Vec Int))]
  TextSearchHandlesResult
  (loop [(position Int) 0 (matches (Vec Int)) []]
    (if (>= position (count candidates))
      (handles-ok matches)
      (let [(handle Int) (nth candidates position)
            (result TextSearchScoreResult)
            (score-at-result! source handle needle)]
        (if (not (textsearchscoreresult-ok result))
          (handles-error (textsearchscoreresult-error result))
          (recur (inc position)
                 (if (pos? (textsearchscoreresult-score result))
                   (conj matches handle)
                   matches)))))))

(defn ranked-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (let [(needle-result StringNeedleResult)
        (substring-needle-result "text-search" needle)]
    (if (not (stringneedleresult-ok needle-result))
      (handles-error (stringneedleresult-error needle-result))
      (let [(analyzers-result SearchAnalyzersResult)
            (analyzers-of-result! source)]
        (if (not (searchanalyzersresult-ok analyzers-result))
          (handles-error (searchanalyzersresult-error analyzers-result))
          (let [(value String) (stringneedleresult-value needle-result)
                (query-tokens (Vec String)) (word-tokens value)
                (analyzers SearchAnalyzers)
                (searchanalyzersresult-analyzers analyzers-result)
                (stem-candidates (Vec Int))
                (if (empty? query-tokens)
                  []
                  (postings-handles
                   (searchanalyzers-stem-postings analyzers)
                   (vec (stems query-tokens))))
                (gram-keys (Vec String)) (vec (trigrams value))
                (substring-candidates (Vec Int))
                (if (empty? gram-keys)
                  (all-handles source)
                  (postings-handles
                   (searchanalyzers-trigram-postings analyzers) gram-keys))
                (candidates (Vec Int))
                (union-handles stem-candidates substring-candidates)]
            (matching-score-handles-result! source needle candidates)))))))

(defn ranked-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (ranked-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn ranked-scan-handles-result!
  [(source TextSearchSource) (needle Any)] TextSearchHandlesResult
  (matching-score-handles-result! source needle (all-handles source)))

(defn ranked-scan-handles! [(source TextSearchSource) (needle Any)] (Vec Int)
  (let [(result TextSearchHandlesResult)
        (ranked-scan-handles-result! source needle)]
    (if (handles-result-ok? result)
      (handles-result-handles result)
      (text-index/raise-text-error (handles-result-error result)))))

(defn- rows-for-handles
  [(source TextSearchSource) (needle Any) (handles (Vec Int))] (Vec (Vec Any))
  (let [(rows (Vec t/Triple)) (textsearchsource-rows source)]
    (mapv (fn [(handle Int)] (Vec Any)
            (let [(proposition t/Triple) (nth rows handle)]
              [(t/triple-t1 proposition)
               (t/triple-t2 proposition)
               needle]))
          handles)))

(defn- ranked-rows-for-handles-result!
  [(source TextSearchSource)
   (needle Any)
   (handles (Vec Int))]
  TextSearchRowsResult
  (let [(source-rows (Vec t/Triple)) (textsearchsource-rows source)]
    (loop [(position Int) 0 (result-rows (Vec (Vec Any))) []]
      (if (>= position (count handles))
        (rows-ok result-rows)
        (let [(handle Int) (nth handles position)
              (score-result TextSearchScoreResult)
              (score-at-result! source handle needle)]
          (if (not (textsearchscoreresult-ok score-result))
            (rows-error (textsearchscoreresult-error score-result))
            (let [(proposition t/Triple) (nth source-rows handle)]
              (recur
               (inc position)
               (conj result-rows
                     [(t/triple-t1 proposition)
                      (t/triple-t2 proposition)
                      needle
                      (textsearchscoreresult-score score-result)])))))))))

(defn- ranked-rows-for-handles!
  [(source TextSearchSource) (needle Any) (handles (Vec Int))] (Vec (Vec Any))
  (let [(result TextSearchRowsResult)
        (ranked-rows-for-handles-result! source needle handles)]
    (if (rows-result-ok? result)
      (rows-result-rows result)
      (text-index/raise-text-error (rows-result-error result)))))

(defn exact-indexed-rows-result!
  [(source TextSearchSource) (needle Any)] TextSearchRowsResult
  (let [(result text-index/TextRowsResult)
        (text-index/indexed-rows-result! (textsearchsource-exact source) needle)]
    (if (text-index/rows-result-ok? result)
      (rows-ok (text-index/rows-result-rows result))
      (rows-error (text-index/rows-result-error result)))))

(defn exact-scan-rows-result!
  [(source TextSearchSource) (needle Any)] TextSearchRowsResult
  (let [(result text-index/TextRowsResult)
        (text-index/scan-rows-result! (textsearchsource-exact source) needle)]
    (if (text-index/rows-result-ok? result)
      (rows-ok (text-index/rows-result-rows result))
      (rows-error (text-index/rows-result-error result)))))

(defn exact-indexed-rows!
  [(source TextSearchSource) (needle Any)] (Vec (Vec Any))
  (let [(result TextSearchRowsResult) (exact-indexed-rows-result! source needle)]
    (if (rows-result-ok? result)
      (rows-result-rows result)
      (text-index/raise-text-error (rows-result-error result)))))

(defn exact-scan-rows! [(source TextSearchSource) (needle Any)] (Vec (Vec Any))
