(defn ranked-indexed-rows-result!
  [(source TextSearchSource) (needle Any)] TextSearchRowsResult
  (let [(handles-result TextSearchHandlesResult)
        (ranked-handles-result! source needle)]
    (if (handles-result-ok? handles-result)
      (ranked-rows-for-handles-result!
       source needle (handles-result-handles handles-result))
      (rows-error (handles-result-error handles-result)))))

(defn ranked-scan-rows-result!
