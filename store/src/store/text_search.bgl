    (if (rows-result-ok? result)
      (rows-result-rows result)
      (text-index/raise-text-error (rows-result-error result)))))

(defn- rows-for-handles-result
  [(source TextSearchSource)
   (needle Any)
   (result TextSearchHandlesResult)]
  TextSearchRowsResult
  (if (handles-result-ok? result)
    (rows-ok (rows-for-handles source needle (handles-result-handles result)))
    (rows-error (handles-result-error result))))

(defn phrase-indexed-rows-result!
  [(source TextSearchSource) (needle Any)] TextSearchRowsResult
  (rows-for-handles-result source needle
                           (phrase-handles-result! source needle)))

(defn phrase-scan-rows-result!
  [(source TextSearchSource) (needle Any)] TextSearchRowsResult
  (rows-for-handles-result source needle
                           (phrase-scan-handles-result! source needle)))

(defn substring-indexed-rows-result!
