#lang beagle/clj

(ns store.kernel-classify
  "The ONE classification authority store.kernel / store.fold / server.clj\n  delegate to, so a server and a CLI can never classify differently: predicate\n  cardinality, reference shape, fold key bytes, lease codec, delivery candidacy.\n\n  INVARIANT: stays inside the natively lowerable subset — String/Int/Bool/records/Vec\n  only, no Any, no higher-order fns, no throw, no env reads.")

(require [clojure.string :as str])

(defn strip-at [s String] String
  (if (str/starts-with? s "@") (subs s 1) s))

(defn has-whitespace? [s String] Bool
  (or (str/includes? s "\t")
    (str/includes? s "\n")
    (str/includes? s "\u000b")
    (str/includes? s "\u000c")
    (str/includes? s "\r")
    (str/includes? s " ")))

(defn ref-shape? [s String] Bool
  (and (> (count s) 1) (str/starts-with? s "@") (not (has-whitespace? s))))

(def fallback-single (Vec String)
  ["title"
   "owner"
   "lead"
   "driver"
   "source"
   "part_of"
   "do_on"
   "valid_until"
   "estimate_hours"
   "created_at"
   "updated_at"
   "name"
   "body"
   "created_by"
   "committed"
   "outcome"
   "abandoned"
   "superseded_by"
   "merged_into"
   "session_of"
   "start_time"
   "end_time"
   "clockify_id"])

(defn vec-member?
  [xs (Vec String)
   s String] Bool
  (loop [i Int 0]
    (if (>= i (count xs)) false (if (= (nth xs i) s) true (recur (+ i 1))))))

(defn emoji-single? [p String] Bool (str/starts-with? p "emoji_"))

(defn configured-single?
  [configured (Vec String)
   p String] Bool
  (vec-member? configured p))

(defn meta-single-seed? [p String] Bool
  (or (= p "cardinality")
    (= p "value_kind")
    (= p "name")
    (= p "acyclic")
    (= p "predicate_name")))

(defn single-eff?
  [declared-present Bool
   declared-single Bool
   configured Bool
   p String] Bool
  (if declared-present
    declared-single
    (or configured (vec-member? fallback-single p) (emoji-single? p))))

(def key-sep String "\u0001")

(defn key-of-group
  [l String
   p String] String
  (str l key-sep p))

(defn key-of-triple
  [l String
   p String
   r String] String
  (str l key-sep p key-sep r))

(defn normalize-ref-value
  [value-kind String
   r String] String
  (if (and (= "ref" value-kind) (not (str/starts-with? r "@")) (not (str/blank? r)) (not (has-whitespace? r)))
    (str "@" r)
    r))

(defrecord LeaseParts
  [holder String
   exp Int
   epoch Int
   valid Bool])

(defn lease-invalid [] LeaseParts (->LeaseParts "" 0 0 false))

(defn lease-subject [res String] String (str "@lease:" res))

(defn lease-encode
  [holder String
   exp Int
   epoch Int] String
  (str holder "|" exp "|" epoch))

(defn lease-decode [v String] LeaseParts
  (let [cut1 Int? (str/index-of v "|")]
    (if (nil? cut1)
      (lease-invalid)
      (let [cut1-position Int cut1
            holder String (subs v 0 cut1-position)
            tail String (subs v (+ cut1-position 1))
            cut2 Int? (str/index-of tail "|")]
        (if (nil? cut2)
          (lease-invalid)
          (let [cut2-position Int cut2
                exp-s String (subs tail 0 cut2-position)
                epoch-s String (subs tail (+ cut2-position 1))
                extra Int? (str/index-of epoch-s "|")]
            (if (some? extra)
              (lease-invalid)
              (let [exp Int? (parse-long exp-s)
                    epoch Int? (parse-long epoch-s)]
                (if (nil? exp)
                  (lease-invalid)
                  (if (nil? epoch)
                    (lease-invalid)
                    (let [present-exp Int exp
                          present-epoch Int epoch]
                      (->LeaseParts holder present-exp present-epoch true))))))))))))

(def lease-schema-lines (Vec String)
  ["@lease cardinality single" "@lease value_kind literal"])

(defn delivery-trigger? [p String] Bool (or (= p "to") (= p "target")))
