#lang beagle

(ns store.log-codec
  (:require [store.chain-rules :as chain-rules]
            [store.native-wire-codec :as wire :refer [defwire]]
            [store.store :as term-store]
            [store.types :as t]))


(def status-ok Int 0)
(def status-fatal Int 2)
(def store-log-version Int 1)
(def store-log-flags Int 0)
;; Header flag bit 1: this generation continues a sealed segment chain and is
;; not a whole store on its own, so every single-file open must refuse it.
(def store-log-continuation-flag Int 2)
(def max-codec-count Int 2147483647)
(def max-term-depth Int 256)
(def store-log-stream-max-chunk-bytes Int 1048602)
(def store-log-stream-max-space-bytes Int 4096)
(def store-log-stream-max-payload-bytes Int 1048576)
(def crc32-mask Int 4294967295)
(def crc32-polynomial Int 3988292384)
(def store-log-magic (Vec Int) [83 84 79 82 69 76 79 71])

(defrecord BootResult
  [status Int
   store (U Nil (Atom t/TermStore))
   valid-log-bytes Int
   boot-append (Vec Int)
   error String?])

(defrecord BootStream
  [configured-space-id String
   store (U Nil (Atom t/TermStore))
   valid-log-bytes Int
   boot-append (Vec Int)
   error String?])

(defrecord BytesResult
  [status Int
   bytes (Vec Int)
   error String?])

(defrecord RecordDecodeResult
  [record t/TransactionRecord?
   error String?])

;; One member of a branch's fold order: a sealed segment's bytes, or the tail's.
;; start-sequence and end-sequence are the ref's record of the member's span,
;; 0 when it records none; the tail is named by no ref and carries 0 for both.
(defrecord ChainPiece
  [bytes ByteSource
   start-sequence Int
   end-sequence Int
   byte-count Int])

(defrecord ChainFold
  [ok Bool
   valid-bytes Int
   start-sequence Int
   end-sequence Int
   torn Bool
   error String?])

(defrecord HeaderFields
  [ok Bool
   space-id String
   flags Int
   header-bytes Int
   error String?])

(wire/defwire store-log-header
  (packet-encoded :none :none)
  (tagged :none
    [0 header
     [(version :u16le "Store transaction log version")
      (flags :u16le "Store transaction log flags")
      (space-id (bounded-text max-codec-count) "Store transaction log SpaceId")]]))

(wire/defwire store-log-transaction
  (packet-encoded :u32le :crc32)
  (tagged :none
    [0 payload
     [(sequence :i64le "Store transaction log transaction sequence")
      (operation-count :u32le "Store transaction log operation count")]]))

(wire/defwire store-log-operation
  (packet-encoded :none :none)
  (tagged :none
    [0 payload
     [(ordinal :u32le "Store transaction log operation ordinal")
      (action :u8 "Store transaction log operation action")
      (proposition (codec t/Triple :term append-store-log-term!
                          read-store-log-term! -1))]]))

(defn failed-boot [message String] BootResult
  (->BootResult status-fatal nil 0 [] message))

(defn failed-bytes [message String] BytesResult
  (->BytesResult status-fatal [] message))

(defn error-or
  [error String?
   fallback String] String
  (if error error fallback))

(defn crc32 [bytes (Vec Int)] Int
  (loop [position Int 0
         crc Int crc32-mask]
    (if (>= position (count bytes))
      (bit-and crc32-mask (bit-xor crc crc32-mask))
      (let [mixed (bit-xor crc (nth bytes position))
            next-crc (loop [bit Int 0
                            value Int mixed]
                       (if (>= bit 8)
                value
                (let [shifted (unsigned-bit-shift-right value 1)]
                  (recur (+ bit 1)
                         (if (= 1 (bit-and value 1))
                           (bit-xor shifted crc32-polynomial)
                           shifted)))))]
        (recur (+ position 1) (bit-and crc32-mask next-crc))))))

(defn crc32-source [bytes ByteSource] Int
  (loop [position Int 0
         crc Int crc32-mask]
    (if (>= position (count bytes))
      (bit-and crc32-mask (bit-xor crc crc32-mask))
      (let [mixed (bit-xor crc (nth bytes position))
            next-crc (loop [bit Int 0
                            value Int mixed]
                       (if (>= bit 8)
                value
                (let [shifted (unsigned-bit-shift-right value 1)]
                  (recur (+ bit 1)
                         (if (= 1 (bit-and value 1))
                           (bit-xor shifted crc32-polynomial)
                           shifted)))))]
        (recur (+ position 1) (bit-and crc32-mask next-crc))))))

(defn crc32-range-source
  [bytes ByteSource
   start Int
   end Int] Int
  (loop [position Int start
         crc Int crc32-mask]
    (if (>= position end)
      (bit-and crc32-mask (bit-xor crc crc32-mask))
      (let [mixed (bit-xor crc (nth bytes position))
            next-crc (loop [bit Int 0
                            value Int mixed]
                       (if (>= bit 8)
                value
                (let [shifted (unsigned-bit-shift-right value 1)]
                  (recur (+ bit 1)
                         (if (= 1 (bit-and value 1))
                           (bit-xor shifted crc32-polynomial)
                           shifted)))))]
        (recur (+ position 1) (bit-and crc32-mask next-crc))))))

(defn crc32-range
  [bytes (Vec Int)
   start Int
   end Int] Int
  (loop [position Int start
         crc Int crc32-mask]
    (if (>= position end)
      (bit-and crc32-mask (bit-xor crc crc32-mask))
      (let [mixed (bit-xor crc (nth bytes position))
            next-crc (loop [bit Int 0
                            value Int mixed]
                       (if (>= bit 8)
                value
                (let [shifted (unsigned-bit-shift-right value 1)]
                  (recur (+ bit 1)
                         (if (= 1 (bit-and value 1))
                           (bit-xor shifted crc32-polynomial)
                           shifted)))))]
        (recur (+ position 1) (bit-and crc32-mask next-crc))))))

(defn u16-le-at
  [bytes ByteSource
   position Int] Int
  (+ (nth bytes position)
     (bit-shift-left (nth bytes (+ position 1)) 8)))

(defn u32-le-at
  [bytes ByteSource
   position Int] Int
  (loop [offset Int 0
         value Int 0]
    (if (>= offset 4)
      value
      (recur
       (+ offset 1)
       (bit-or value
               (bit-shift-left
                (nth bytes (+ position offset)) (* offset 8)))))))

(defn magic-at-start? [bytes ByteSource] Bool
  (if (< (count bytes) (count store-log-magic))
    false
    (loop [position Int 0]
      (if (>= position (count store-log-magic))
        true
        (if (= (nth bytes position) (nth store-log-magic position))
          (recur (+ position 1))
          false)))))

(defn- append-store-log-term!
  [encoder wire/Encoder
   term t/Triple] Nil
  (do
    (reset! (wire/encoder-nodes encoder) 0)
    (wire/append-term-limited!
     encoder term 0 max-codec-count max-codec-count max-term-depth)))

(defn- read-store-log-term! [decoder wire/Decoder] t/Triple
  (let [_ (reset! (wire/decoder-nodes decoder) 0)
        proposition (wire/read-term-limited!
         decoder 0 max-codec-count max-codec-count max-term-depth)
        triple (t/term-as-triple proposition)]
    (if triple
      triple
      (do
        (wire/decoder-error!
         decoder "Store transaction log operation proposition is not a Triple")
        (t/triple "" "" "")))))

(defn encode-header! [space-id String] BytesResult
  (if (= 0 (count space-id))
    (failed-bytes "Store transaction log SpaceId must be nonempty")
    (let [encoder (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                  (wire/empty-error-cell))]
      (do
        (swap! (wire/encoder-bytes encoder) into store-log-magic)
        (append-store-log-header-header!
         encoder store-log-version store-log-flags space-id)
        (let [error (deref (wire/encoder-error encoder))]
          (if error
            (failed-bytes (str "Store transaction log header encode failed: " error))
            (->BytesResult status-ok
                           (deref (wire/encoder-bytes encoder)) nil)))))))

(defn decode-record-payload-range!
  [bytes ByteSource
   start Int
   end Int] RecordDecodeResult
  (let [decoder (wire/->Decoder bytes (atom start) end (atom 0)
                                (wire/empty-error-cell))]
    (if (< (- end start) 12)
      (->RecordDecodeResult nil "Store transaction log record header is truncated")
      (let [transaction-fields WireFields_store-log-transaction_payload (read-store-log-transaction-payload! decoder)
            sequence Int (wirefields_store-log-transaction_payload-sequence
             transaction-fields)
            operation-count Int (wirefields_store-log-transaction_payload-operation-count
             transaction-fields)]
        (cond
          [(deref (wire/decoder-error decoder))
           (->RecordDecodeResult nil (deref (wire/decoder-error decoder)))]
          [(< sequence 0)
           (->RecordDecodeResult nil
                                "Store transaction log sequence is negative")]
          [(or (= operation-count 0) (> operation-count max-codec-count))
           (->RecordDecodeResult
            nil "Store transaction log record operation count is invalid")]
          [:else
           (loop [ordinal Int 0
                  operations (Vec t/CommitOperation) []]
             (if (>= ordinal operation-count)
               (let [error (deref (wire/decoder-error decoder))]
                 (cond
                   [error (->RecordDecodeResult nil error)]
                   [(not= 0 (wire/decoder-remaining decoder))
                    (->RecordDecodeResult
                     nil "Store transaction log record has trailing payload bytes")]
                   [:else
                    (->RecordDecodeResult
                     (term-store/transaction-record sequence operations) nil)]))
               (let [operation-fields WireFields_store-log-operation_payload (read-store-log-operation-payload! decoder)
                     actual Int (wirefields_store-log-operation_payload-ordinal
                      operation-fields)
                     action Int (wirefields_store-log-operation_payload-action
                      operation-fields)
                     triple t/Triple (wirefields_store-log-operation_payload-proposition
                      operation-fields)
                     error String? (deref (wire/decoder-error decoder))]
                 (cond
                   [error (->RecordDecodeResult nil error)]
                   [(not= actual ordinal)
                    (->RecordDecodeResult
                     nil "Store transaction log operation ordinals are not contiguous")]
                   [(= action 1)
                    (recur (+ ordinal 1)
                           (conj operations
                                 (term-store/assert-operation triple)))]
                   [(= action 2)
                    (recur (+ ordinal 1)
                           (conj operations
                                 (term-store/retract-operation triple)))]
                   [:else
                    (->RecordDecodeResult
                     nil "Store transaction log contains an unknown operation action")]))))])))))

(defn decode-record-payload! [payload ByteSource] RecordDecodeResult
  (decode-record-payload-range! payload 0 (count payload)))

(defn start-transaction-log-stream [configured-space-id String] BootStream
  (->BootStream configured-space-id nil 0 [] nil))

(defn failed-boot-stream
  [stream BootStream
   message String] BootStream
  (->BootStream
   (bootstream-configured-space-id stream)
   (bootstream-store stream)
   (bootstream-valid-log-bytes stream)
   []
   message))

(def no-actions (Vec Keyword) [])

(def no-handles (Vec Int) [])

;; Fused record replay: the wire walk interns terms as it reads them, so a
;; replayed record allocates its rows and nothing shaped like a term tree.
;; Mirrors decode-record-payload-range!'s validation, spelling for spelling.
(defn- intern-wire-term!
  [decoder wire/Decoder
   root (Atom t/TermStore)
   depth Int] Int
  (if (not (wire/decoder-node-limited! decoder depth max-codec-count
                                       max-term-depth))
    -1
    (let [tag (wire/read-u8! decoder "Term tag")]
      (cond
        [(deref (wire/decoder-error decoder)) -1]
        [(= tag 1)
         (let [text (wire/read-sized-text! decoder max-codec-count
                                           "String atom")]
           (if (deref (wire/decoder-error decoder))
             -1
             (term-store/intern-atom-handle! root text)))]
        [(= tag 2)
         (let [value (wire/read-i64-le! decoder "Int atom")]
           (if (deref (wire/decoder-error decoder))
             -1
             (term-store/intern-atom-handle! root value)))]
        [(= tag 3)
         (let [bits (wire/read-i64-le! decoder "Float atom")]
           (if (deref (wire/decoder-error decoder))
             -1
             (term-store/intern-atom-handle! root (float-from-bits bits))))]
        [(= tag 4) (term-store/intern-atom-handle! root false)]
        [(= tag 5) (term-store/intern-atom-handle! root true)]
        [(= tag 6)
         (let [spelling (wire/read-sized-text! decoder max-codec-count
                                               "Keyword atom")]
           (cond
             [(deref (wire/decoder-error decoder)) -1]
             [(empty? spelling)
              (do
                (wire/decoder-error! decoder
                                     "Keyword atom spelling must be nonempty")
                -1)]
             [:else (term-store/intern-atom-handle! root (keyword spelling))]))]
        [(= tag 7)
         (let [t1 (intern-wire-term! decoder root (+ depth 1))]
           (if (< t1 0)
             -1
             (let [t2 (intern-wire-term! decoder root (+ depth 1))]
               (if (< t2 0)
                 -1
                 (let [t3 (intern-wire-term! decoder root (+ depth 1))]
                   (if (< t3 0)
                     -1
                     (term-store/intern-triple-handle! root t1 t2 t3)))))))]
        [(= tag 8)
         (let [seconds (wire/read-i64-le! decoder "Instant atom")
               nanos (wire/read-u32-le! decoder "Instant nanos")]
           (cond
             [(deref (wire/decoder-error decoder)) -1]
             [(< nanos 1000000000)
              (term-store/intern-atom-handle! root (t/instant seconds nanos))]
             [:else
              (do
                (wire/decoder-error!
                 decoder "Instant nanoseconds are outside the canonical range")
                -1)]))]
        [:else
         (do
           (wire/decoder-error! decoder "TermCodecV1 contains an unknown tag")
           -1)]))))

(defn- replay-record-fused!
  [root (Atom t/TermStore)
   bytes ByteSource
   start Int
   end Int] term-store/TransactionReplayResult
  (let [decoder (wire/->Decoder bytes (atom start) end (atom 0)
                                (wire/empty-error-cell))]
    (if (< (- end start) 12)
      (term-store/->TransactionReplayResult
       false :invalid-transaction-record
       "Store transaction log record header is truncated")
      (let [sequence (wire/read-i64-le! decoder "Store transaction log transaction sequence")
            operation-count (wire/read-u32-le! decoder "Store transaction log operation count")]
        (cond
          [(deref (wire/decoder-error decoder))
           (term-store/->TransactionReplayResult
            false :invalid-transaction-record
            (error-or (deref (wire/decoder-error decoder))
                      "Store transaction log record decode failed"))]
          [(< sequence 0)
           (term-store/->TransactionReplayResult
            false :invalid-transaction-record
            "Store transaction log sequence is negative")]
          [(or (= operation-count 0) (> operation-count max-codec-count))
           (term-store/->TransactionReplayResult
            false :invalid-transaction-record
            "Store transaction log record operation count is invalid")]
          [:else
           (loop [ordinal Int 0
                  actions (Vec Keyword) no-actions
                  handles (Vec Int) no-handles]
             (if (>= ordinal operation-count)
               (if (not= 0 (wire/decoder-remaining decoder))
                 (term-store/->TransactionReplayResult
                  false :invalid-transaction-record
                  "Store transaction log record has trailing payload bytes")
                 (term-store/append-replayed-transaction! root sequence
                                                          actions handles))
               (let [actual (wire/read-u32-le! decoder "Store transaction log operation ordinal")
                     action (wire/read-u8! decoder "Store transaction log operation action")
                     _ (reset! (wire/decoder-nodes decoder) 0)
                     handle (intern-wire-term! decoder root 0)
                     error (deref (wire/decoder-error decoder))]
                 (cond
                   [error
                    (term-store/->TransactionReplayResult
                     false :invalid-transaction-record
                     (str "Store transaction log record decode failed: " error))]
                   [(not= actual ordinal)
                    (term-store/->TransactionReplayResult
                     false :invalid-transaction-record
                     "Store transaction log operation ordinals are not contiguous")]
                   [(not (term-store/triple-handle-shape? handle))
                    (term-store/->TransactionReplayResult
                     false :invalid-transaction-record
                     "Store transaction log operation proposition is not a Triple")]
                   [(= action 1)
                    (recur (+ ordinal 1) (conj actions t/assert-action)
                      (conj handles handle))]
                   [(= action 2)
                    (recur (+ ordinal 1) (conj actions t/retract-action)
                      (conj handles handle))]
                   [:else
                    (term-store/->TransactionReplayResult
                     false :invalid-transaction-record
                     "Store transaction log contains an unknown operation action")]))))])))))

;; Replay is a loop, not a self-call: one C stack entry per Store transaction
;; log record overflows the wasm stack a few hundred commits in.
(defn consume-transaction-log-records!
  [stream BootStream
   bytes ByteSource
   position Int] BootStream
  (loop [stream BootStream stream
         position Int position]
    (let [remaining (- (count bytes) position)]
      (cond
        [(< remaining 4) stream]
        [:else
         (let [payload-length (u32-le-at bytes position)
               record-length (+ payload-length 8)]
           (cond
             [(> payload-length store-log-stream-max-payload-bytes)
              (failed-boot-stream
               stream "Store transaction log record exceeds the supported byte range")]
             [(< remaining record-length) stream]
             [:else
              (let [payload-start (+ position 4)
                    payload-end (+ payload-start payload-length)
                    stored-crc (u32-le-at bytes payload-end)
                    actual-crc (crc32-range-source bytes payload-start payload-end)
                    root (bootstream-store stream)]
                (cond
                  [(not= stored-crc actual-crc)
                   (failed-boot-stream stream "Store transaction log record CRC does not match")]
                  [(nil? root)
                   (failed-boot-stream stream "Store transaction log header was not decoded")]
                  [:else
                   (let [replayed (replay-record-fused! root bytes payload-start
                                              payload-end)]
                     (if (term-store/transactionreplayresult-ok replayed)
                       (recur
                        (->BootStream
                         (bootstream-configured-space-id stream)
                         root
                         (+ (bootstream-valid-log-bytes stream) record-length)
                         []
                         nil)
                        (+ position record-length))
                       (failed-boot-stream
                        stream
                        (or (term-store/transactionreplayresult-message replayed)
                            "Store transaction log transaction sequence does not advance"))))]))]))]))))

(defn consume-transaction-log-header!
  [stream BootStream
   bytes ByteSource] BootStream
  (let [minimum-header-bytes (+ (count store-log-magic) 8)]
    (cond
      [(= 0 (count bytes))
       (let [header (encode-header! (bootstream-configured-space-id stream))]
         (if (= status-ok (bytesresult-status header))
           (->BootStream
            (bootstream-configured-space-id stream)
            (term-store/new-term-store
             (bootstream-configured-space-id stream))
            0 (bytesresult-bytes header) nil)
           (failed-boot-stream
            stream
            (error-or (bytesresult-error header)
                      "Store transaction log header encode failed"))))]
      [(< (count bytes) minimum-header-bytes)
       (failed-boot-stream stream "Store transaction log header is truncated")]
      [(not (magic-at-start? bytes))
       (failed-boot-stream
        stream "Store transaction log magic does not match")]
      [:else
       (let [version (u16-le-at bytes (count store-log-magic))
             flags (u16-le-at bytes (+ (count store-log-magic) 2))
             space-length (u32-le-at bytes (+ (count store-log-magic) 4))
             header-bytes (+ minimum-header-bytes space-length)]
         (cond
           [(or (not= version store-log-version) (not= flags store-log-flags))
            (failed-boot-stream
             stream "Store transaction log version or flags are unsupported")]
           [(or (= space-length 0)
                (> space-length store-log-stream-max-space-bytes))
            (failed-boot-stream stream "Store transaction log SpaceId length is invalid")]
           [(< (count bytes) header-bytes)
            (failed-boot-stream
             stream "Store transaction log header is truncated inside SpaceId")]
           [:else
            (let [decoder (wire/->Decoder bytes (atom minimum-header-bytes)
                                  header-bytes (atom 0)
                                  (wire/empty-error-cell))
                  space-id (wire/read-utf8! decoder space-length "Store transaction log SpaceId")
                  error (deref (wire/decoder-error decoder))]
              (cond
                [error
                 (failed-boot-stream
                  stream (error-or error "Store transaction log SpaceId decode failed"))]
                [(= 0 (count space-id))
                 (failed-boot-stream
                  stream "Store transaction log SpaceId must be nonempty")]
                [(and
                  (not= 0 (count (bootstream-configured-space-id stream)))
                  (not= (bootstream-configured-space-id stream) space-id))
                 (failed-boot-stream
                  stream "Store transaction log belongs to a different SpaceId")]
                [:else
                 (consume-transaction-log-records!
                  (->BootStream
                   (bootstream-configured-space-id stream)
                   (term-store/open-fold!
                    (term-store/new-term-store-for-log space-id (count bytes)))
                   header-bytes [] nil)
                  bytes header-bytes)]))]))])))

(defn canonical-store-copy! [root (Atom t/TermStore)] (Atom t/TermStore)
  (term-store/validated-store! root))

(defn successful-boot!
  [root (Atom t/TermStore)
   valid-log-bytes Int
   boot-append (Vec Int)] BootResult
  (->BootResult status-ok (canonical-store-copy! (term-store/close-fold! root))
                valid-log-bytes boot-append nil))

(defn replay-complete-records!
  [decoder wire/Decoder
   root (Atom t/TermStore)
   header-bytes Int] BootResult
  (loop [valid-log-bytes Int header-bytes]
    (let [remaining (wire/decoder-remaining decoder)]
      (cond
        [(= remaining 0)
         (successful-boot! root valid-log-bytes [])]
        [(< remaining 4)
         (successful-boot! root valid-log-bytes [])]
        [:else
         (let [record-start (deref (wire/decoder-position decoder))
               payload-length (wire/read-u32-le! decoder "Store transaction log record payload length")]
           (cond
             [(deref (wire/decoder-error decoder))
              (failed-boot
               (error-or (deref (wire/decoder-error decoder))
                         "Store transaction log record decode failed"))]
             [(> payload-length max-codec-count)
              (failed-boot "Store transaction log record exceeds the supported byte range")]
             [(< (wire/decoder-remaining decoder) (+ payload-length 4))
              (do
                (reset! (wire/decoder-position decoder) record-start)
                (successful-boot! root valid-log-bytes []))]
             [:else
              (let [payload-start (deref (wire/decoder-position decoder))
                    payload-end (+ payload-start payload-length)
                    payload (subvec (wire/decoder-bytes decoder)
                            payload-start payload-end)
                    _ (reset! (wire/decoder-position decoder) payload-end)
                    stored-crc (wire/read-u32-le! decoder "Store transaction log record CRC")
                    actual-crc (crc32-source payload)
                    decoded (decode-record-payload! payload)
                    record (recorddecoderesult-record decoded)]
                (cond
                  [(not= stored-crc actual-crc)
                   (failed-boot "Store transaction log record CRC does not match")]
                  [(recorddecoderesult-error decoded)
                   (failed-boot
                    (str "Store transaction log record decode failed: "
                         (recorddecoderesult-error decoded)))]
                  [(nil? record)
                   (failed-boot "Store transaction log decoder returned no record")]
                  [(< (t/transactionrecord-sequence record)
                      (term-store/next-sequence root))
                   (failed-boot
                    "Store transaction log transaction sequence does not advance")]
                  [:else
                   (do
                     (term-store/replay-transaction! root record)
                     (recur (deref (wire/decoder-position decoder))))]))]))]))))

(defn boot-store-log!
  [configured-space-id String
   bytes ByteSource] BootResult
  (cond
    [(= 0 (count bytes))
     (let [header (encode-header! configured-space-id)]
       (if (= status-ok (bytesresult-status header))
         (successful-boot!
          (term-store/new-term-store configured-space-id)
          0 (bytesresult-bytes header))
         (failed-boot
          (error-or (bytesresult-error header)
                    "Store transaction log header encode failed"))))]
    [(not (magic-at-start? bytes))
     (failed-boot "Store transaction log magic does not match")]
    [:else
     (let [decoder (wire/->Decoder bytes (atom (count store-log-magic))
                                   (count bytes)
                                   (atom 0) (wire/empty-error-cell))]
       (if (< (wire/decoder-remaining decoder) 8)
         (failed-boot "Store transaction log header is truncated")
         (let [version (wire/read-u16-le! decoder "Store transaction log version")
               flags (wire/read-u16-le! decoder "Store transaction log flags")
               space-length (wire/read-u32-le! decoder "Store transaction log SpaceId length")]
           (cond
             [(or (not= version store-log-version) (not= flags store-log-flags))
              (failed-boot "Store transaction log version or flags are unsupported")]
             [(or (= space-length 0) (> space-length max-codec-count))
              (failed-boot "Store transaction log SpaceId length is invalid")]
             [(< (wire/decoder-remaining decoder) space-length)
              (failed-boot "Store transaction log header is truncated inside SpaceId")]
             [:else
              (let [space-id (wire/read-utf8! decoder space-length "Store transaction log SpaceId")
                    error (deref (wire/decoder-error decoder))]
                (cond
                  [error
                   (failed-boot
                    (error-or error "Store transaction log SpaceId decode failed"))]
                  [(= 0 (count space-id))
                   (failed-boot "Store transaction log SpaceId must be nonempty")]
                  [(and (not= 0 (count configured-space-id))
                        (not= configured-space-id space-id))
                   (failed-boot "Store transaction log belongs to a different SpaceId")]
                  [:else
                   (replay-complete-records!
                    decoder
                    (term-store/open-fold!
                     (term-store/new-term-store-for-log space-id (count bytes)))
                    (deref (wire/decoder-position decoder)))]))]))))]))

(defn- failed-header [message String] HeaderFields
  (->HeaderFields false "" 0 0 message))

(defn decode-store-log-header! [bytes ByteSource] HeaderFields
  (let [minimum-header-bytes (+ (count store-log-magic) 8)]
    (cond
      [(< (count bytes) minimum-header-bytes)
       (failed-header "Store transaction log header is truncated")]
      [(not (magic-at-start? bytes))
       (failed-header "Store transaction log magic does not match")]
      [:else
       (let [version (u16-le-at bytes (count store-log-magic))
             flags (u16-le-at bytes (+ (count store-log-magic) 2))
             space-length (u32-le-at bytes (+ (count store-log-magic) 4))
             header-bytes (+ minimum-header-bytes space-length)]
         (cond
           [(or (not= version store-log-version)
                (and (not= flags store-log-flags)
                     (not= flags store-log-continuation-flag)))
            (failed-header "Store transaction log version or flags are unsupported")]
           [(or (= space-length 0)
                (> space-length store-log-stream-max-space-bytes))
            (failed-header "Store transaction log SpaceId length is invalid")]
           [(< (count bytes) header-bytes)
            (failed-header "Store transaction log header is truncated inside SpaceId")]
           [:else
            (let [decoder (wire/->Decoder bytes (atom minimum-header-bytes)
                                  header-bytes (atom 0)
                                  (wire/empty-error-cell))
                  space-id (wire/read-utf8! decoder space-length "Store transaction log SpaceId")
                  error (deref (wire/decoder-error decoder))]
              (cond
                [error
                 (failed-header
                  (error-or error "Store transaction log SpaceId decode failed"))]
                [(= 0 (count space-id))
                 (failed-header "Store transaction log SpaceId must be nonempty")]
                [:else
                 (->HeaderFields true space-id flags header-bytes nil)]))]))])))

(defn- fold-chain-piece!
  [root (Atom t/TermStore)
   bytes ByteSource
   header-bytes Int
   start-sequence Int
   end-sequence Int
   sealed Bool] ChainFold
  (loop [position Int header-bytes
         first-record Bool true
         first-sequence Int 0
         last-sequence Int 0]
    (let [remaining (- (count bytes) position)
          short-piece (if sealed
            (->ChainFold
             false position first-sequence last-sequence true
             "Store transaction log segment ends inside a transaction record")
            (->ChainFold true position first-sequence last-sequence true nil))]
      (cond
        [(= remaining 0)
         (->ChainFold true position first-sequence last-sequence false nil)]
        [(< remaining 4) short-piece]
        [:else
         (let [payload-length (u32-le-at bytes position)
               record-length (+ payload-length 8)]
           (cond
             [(> payload-length store-log-stream-max-payload-bytes)
              (->ChainFold
               false position first-sequence last-sequence false
               "Store transaction log record exceeds the supported byte range")]
             [(< remaining record-length) short-piece]
             [:else
              (let [payload-start (+ position 4)
                    payload-end (+ payload-start payload-length)
                    stored-crc (u32-le-at bytes payload-end)
                    actual-crc (crc32-range-source bytes payload-start payload-end)
                    decoded (decode-record-payload-range! bytes payload-start payload-end)
                    record (recorddecoderesult-record decoded)]
                (cond
                  [(not= stored-crc actual-crc)
                   (->ChainFold
                    false position first-sequence last-sequence false
                    "Store transaction log record CRC does not match")]
                  [(recorddecoderesult-error decoded)
                   (->ChainFold
                    false position first-sequence last-sequence false
                    (str "Store transaction log record decode failed: "
                         (recorddecoderesult-error decoded)))]
                  [(nil? record)
                   (->ChainFold
                    false position first-sequence last-sequence false
                    "Store transaction log decoder returned no record")]
                  [:else
                   (let [replayed (term-store/replay-transaction-result! root record)]
                     (if (term-store/transactionreplayresult-ok replayed)
                       (recur (+ position record-length) false
                              (if first-record
                                (t/transactionrecord-sequence record)
                                first-sequence)
                              (t/transactionrecord-sequence record))
                       (->ChainFold
                        false position first-sequence last-sequence false
                        (or (term-store/transactionreplayresult-message replayed)
                            "Store transaction log transaction sequence does not advance"))))]))]))]))))

(defn- chain-piece-at
  [segments (Vec ChainPiece)
   tail ChainPiece
   index Int] ChainPiece
  (if (< index (count segments)) (nth segments index) tail))

;; Fold a branch: every sealed segment in ref order, then its tail. A sealed
;; segment must consume exactly; only the tail may end inside a record.
;; Hosted ref folding and this native path share store.chain-rules.
(defn boot-store-log-chain!
  [configured-space-id String
   segments (Vec ChainPiece)
   tail ChainPiece] BootResult
  (let [first-header (decode-store-log-header! (chainpiece-bytes (chain-piece-at segments tail 0)))]
    (cond
      [(not (headerfields-ok first-header))
       (failed-boot
        (error-or (headerfields-error first-header)
                  "Store transaction log header is unreadable"))]
      [(and (not= 0 (count configured-space-id))
            (not= configured-space-id (headerfields-space-id first-header)))
       (failed-boot "Store transaction log belongs to a different SpaceId")]
      [:else
       (let [total Int (+ (count segments) 1)
             chain-bytes Int (loop [index Int 0
                                    counted Int 0]
                               (if (>= index total)
                 counted
                 (recur (inc index)
                        (+ counted
                           (count (chainpiece-bytes
                                   (chain-piece-at segments tail index)))))))
             root (Atom t/TermStore) (term-store/open-fold!
              (term-store/new-term-store-for-log
               (headerfields-space-id first-header) chain-bytes))]
         (loop [index Int 0
                tail-valid-bytes Int 0
                expected-next Int 1]
           (if (>= index total)
             (successful-boot! root tail-valid-bytes [])
             (let [piece (chain-piece-at segments tail index)
                   sealed (< index (count segments))
                   header (decode-store-log-header! (chainpiece-bytes piece))]
               (cond
                 [(not (headerfields-ok header))
                  (failed-boot
                   (error-or (headerfields-error header)
                             "Store transaction log header is unreadable"))]
                 [:else
                  (let [folded (fold-chain-piece!
                         root (chainpiece-bytes piece)
                         (headerfields-header-bytes header)
                         (chainpiece-start-sequence piece)
                         (chainpiece-end-sequence piece) sealed)]
                    (if (chainfold-ok folded)
                      (let [continuation (= store-log-continuation-flag
                               (headerfields-flags header))
                            fault (if sealed
                              (chain-rules/sealed-member-fault
                               index
                               (term-store/space-id root)
                               (headerfields-space-id header)
                               (chainpiece-start-sequence piece)
                               (chainfold-start-sequence folded)
                               (chainpiece-end-sequence piece)
                               (chainfold-end-sequence folded)
                               (chainpiece-byte-count piece)
                               (count (chainpiece-bytes piece))
                               continuation
                               (chainfold-torn folded)
                               expected-next)
                              (chain-rules/tail-member-fault
                               (count segments)
                               (term-store/space-id root)
                               (headerfields-space-id header)
                               (chainfold-start-sequence folded)
                               continuation
                               expected-next))]
                        (if fault
                          (failed-boot fault)
                          (recur
                           (+ index 1)
                           (chainfold-valid-bytes folded)
                           (chain-rules/next-expected
                            (chainfold-end-sequence folded)
                            expected-next))))
                      (failed-boot
                       (error-or (chainfold-error folded)
                                 "Store transaction log chain fold failed"))))])))))])))

(defn append-record-bytes! [record t/TransactionRecord] BytesResult
  (let [payload (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                (wire/empty-error-cell))
        operations (t/transactionrecord-operations record)
        sequence (t/transactionrecord-sequence record)]
    (if (or (< sequence 0) (= 0 (count operations)))
      (failed-bytes "Store transaction log transaction record is invalid")
      (do
        (append-store-log-transaction-payload!
         payload sequence (count operations))
        (loop [ordinal Int 0]
          (if (< ordinal (count operations))
            (let [operation (nth operations ordinal)
                  action (t/commitoperation-action operation)
                  action-tag (cond
                    [(= action t/assert-action) 1]
                    [(= action t/retract-action) 2]
                    [:else 0])]
              (if (= action-tag 0)
                (wire/encoder-error!
                 payload "Store transaction log operation action must be assert or retract")
                (append-store-log-operation-payload!
                 payload ordinal action-tag
                 (t/commitoperation-proposition operation)))
              (recur (+ ordinal 1)))
            nil))
        (let [payload-error (deref (wire/encoder-error payload))
              payload-bytes (deref (wire/encoder-bytes payload))]
          (if payload-error
            (failed-bytes
             (str "Store transaction log record encode failed: " payload-error))
            (let [out (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                      (wire/empty-error-cell))]
              (wire/append-u32-le! out (count payload-bytes))
              (swap! (wire/encoder-bytes out) into payload-bytes)
              (wire/append-u32-le! out (crc32 payload-bytes))
              (let [error (deref (wire/encoder-error out))]
                (if error
                  (failed-bytes (str "Store transaction log record encode failed: " error))
                  (->BytesResult status-ok
                                 (deref (wire/encoder-bytes out)) nil))))))))))

(defn encode-store-append!
  [root (Atom t/TermStore)
   lower-exclusive Int] BytesResult
  (let [current (term-store/current-sequence root)]
    (cond
      [(or (< lower-exclusive 0) (> lower-exclusive current))
       (failed-bytes "Store transaction log append lower bound is outside store history")]
      [(= lower-exclusive current)
       (->BytesResult status-ok [] nil)]
      [(not= current (+ lower-exclusive 1))
       (failed-bytes "Store transaction log dispatch produced more than one transaction")]
      [:else
       (let [records (term-store/transaction-records-between
              (deref root) lower-exclusive current)]
         (if (= 1 (count records))
           (append-record-bytes! (nth records 0))
           (failed-bytes
            "Store transaction log append did not resolve exactly one transaction")))])))
