#lang beagle/clj
;; Pure projection of ordered transaction records through the authoritative
;; recursive TermStore history.
(ns store.fold)
(require store.store :as store)
(require store.types :as t)

(defrecord Fold
  [(space-id String)
   (occurrences (Vec t/OperationOccurrence))
   (withdrawals (Vec t/Withdrawal))
   (live-occurrences (Vec t/OperationOccurrence))
   (live-propositions (Vec t/Triple))
   (version Int)
   (dump t/TermStoreDump)])

(defn transaction-record
  [(sequence Int) (operations (Vec t/CommitOperation))] t/TransactionRecord
  (store/transaction-record sequence operations))

(defn max-sequence [(records (Vec t/TransactionRecord))] Int
  (reduce
   (fn [(maximum Int) (record t/TransactionRecord)] Int
     (let [sequence (t/transactionrecord-sequence record)]
       (if (> sequence maximum) sequence maximum)))
   0
   records))

(defn- project [(ctx (Atom t/TermStore))] Fold
  (->Fold (store/space-id ctx)
          (store/occurrences ctx)
          (store/withdrawals ctx)
          (store/live-occurrences ctx)
          (store/live-propositions ctx)
          (store/current-sequence ctx)
          (store/dump-term-store ctx)))

(defn fold! [(space-id String) (records (Vec t/TransactionRecord))] Fold
  (let [ctx (store/new-term-store space-id)]
    (doseq [record records] (store/replay-transaction! ctx record))
    (project ctx)))

(defn refold! [(space-id String) (dump Any)] Fold
  (let [ctx (store/new-term-store space-id)]
    (store/load-term-store! ctx dump)
    (project ctx)))
