#lang beagle/clj

;; Covering rotations over the LIVE assertion occurrences of one TermStore: a
;; disposable projection pinned to (SpaceId, store version), never kernel
;; semantics and never a second identity — discard on mismatch and rebuild.
;; Leaves hold occurrences in commit order, so two equal propositions asserted
;; twice stay two answers. Four indexed key shapes cover all eight
;; bound-subsets: spo [s] [s p], pos [p], osp [o], the occurrence index, and
;; unbound = events. The three remaining subsets ([s p o], [p o], [o s]) are
;; NARROWINGS of an indexed answer, not indexes of their own: they are the
;; near-unique shapes, so indexing them costs a fresh leaf per event while
;; filtering the enclosing leaf costs one pass over a handful of occurrences.
;;
;; A rotation is a CLOSED base plus a pending tail. The base buckets are built
;; once per projection; commits land as pending operations that every read
;; folds over its base answer, so a commit retains O(delta) instead of a
;; rebucketed copy of the projection. The tail folds down into a fresh base
;; only at a projection point (boot, compaction, or the tail cap).
(ns store.rotation)


(require [store.types :as t])

(require [store.store :as store])

;; A key is never materialized. It is NAMED by the event that first carried it
;; plus the key shape, and hashed through one of these stack entries, so
;; neither a build step nor a probe allocates a key tuple. Distinct entry
;; shapes hash apart, so two shapes sharing a bucket cannot collide by
;; construction; the entry comparison still settles equality term by term.
(defrecord KeyOne [a Any])

(defrecord KeyTwo
  [a Any
   b Any])

;; A leaf keyed by its bound-subset shape. `codes` names each key by the
;; position of its first event and its shape; `heads`/`chain` are a chained
;; hash over those keys, so a slot row costs one Int per key instead of a
;; growable vector per slot.
(defrecord Bucket
  [width Int
   codes (Vec Int)
   events (Vec (Vec t/OperationOccurrence))
   heads (Vec Int)
   chain (Vec Int)])

;; Occurrences are unique per operation and their key IS the event's own
;; occurrence coordinate, so this index needs no keys, no leaves and no
;; codes: key k is event position k. The chain prepends, so a repeated
;; occurrence resolves to its newest event without a replace step.
(defrecord OccurrenceIndex
  [width Int
   heads (Vec Int)
   chain (Vec Int)])

(defrecord Rotation
  [space-id String
   version Int
   events (Vec t/OperationOccurrence)
   by-occurrence OccurrenceIndex
   spo Bucket
   pos Bucket
   osp Bucket
   pending (Vec t/OperationOccurrence)])

(def empty-events (Vec t/OperationOccurrence) [])

(def empty-event-lists (Vec (Vec t/OperationOccurrence)) [])

(def empty-ints (Vec Int) [])

(def no-pending (Vec t/OperationOccurrence) [])

;; A bucket doubles once it holds more than this many keys per slot.
(def bucket-initial-slots Int 64)

(def bucket-slot-load Int 4)

;; A tail longer than this folds down into a fresh base on refresh. The native
;; server compacts (and reprojects) on its own cadence well under this cap; the
;; cap is what keeps a long-lived hosted session's reads bounded.
(def pending-fold-cap Int 512)

;; Key shapes. 0 = [t1], 1 = [t1 t2] (spo); 2 = [t2] (pos); 3 = [t3] (osp).
(def shape-t1 Int 0)

(def shape-t12 Int 1)

(def shape-t2 Int 2)

(def shape-t3 Int 3)

(def shape-mask Int 3)

(def shape-bits Int 2)

(defn occurrence-of [event t/OperationOccurrence] t/Triple
  (t/operationoccurrence-coordinate event))

(defn proposition-of [event t/OperationOccurrence] t/Triple
  (t/operationoccurrence-proposition event))

(defn assertion-occurrence? [event Any] Bool
  (t/assertion-occurrence? event))

;; A one- or two-term key hashes through a record built on the stack: `hash`
;; takes its address and allocates nothing, so this is the whole cost of
;; naming a key at build time and at probe time alike.
(defn- hash-one [a Any] Int (hash (->KeyOne a)))

(defn- hash-two
  [a Any
   b Any] Int
  (hash (->KeyTwo a b)))

(defn- shape-hash
  [shape Int
   event t/OperationOccurrence] Int
  (let [proposition t/Triple (proposition-of event)]
    (cond
      [(= shape shape-t1) (hash-one (t/triple-t1 proposition))]
      [(= shape shape-t12)
       (hash-two (t/triple-t1 proposition) (t/triple-t2 proposition))]
      [(= shape shape-t2) (hash-one (t/triple-t2 proposition))]
      [:else (hash-one (t/triple-t3 proposition))])))

(defn- same-shape-key?
  [shape Int
   left t/OperationOccurrence
   right t/OperationOccurrence] Bool
  (let [lp t/Triple (proposition-of left)
        rp t/Triple (proposition-of right)]
    (cond
      [(= shape shape-t1) (= (t/triple-t1 lp) (t/triple-t1 rp))]
      [(= shape shape-t12)
       (and (= (t/triple-t1 lp) (t/triple-t1 rp))
         (= (t/triple-t2 lp) (t/triple-t2 rp)))]
      [(= shape shape-t2) (= (t/triple-t2 lp) (t/triple-t2 rp))]
      [:else (= (t/triple-t3 lp) (t/triple-t3 rp))])))

(defn- key-code
  [position Int
   shape Int] Int
  (bit-or (bit-shift-left position shape-bits) shape))

(defn- code-position [code Int] Int
  (unsigned-bit-shift-right code shape-bits))

(defn- code-shape [code Int] Int (bit-and code shape-mask))

;; The one term a single-term shape binds, read back off the event that named
;; the key. Shape 1 binds two terms and is compared field by field instead.
(defn- shape-term
  [shape Int
   event t/OperationOccurrence] Any
  (let [proposition t/Triple (proposition-of event)]
    (cond
      [(= shape shape-t1) (t/triple-t1 proposition)]
      [(= shape shape-t2) (t/triple-t2 proposition)]
      [:else (t/triple-t3 proposition)])))

;; --- Probes. A probe hashes the bound terms directly and walks the chain of
;; keys in that slot, comparing each candidate against the event that named it.

(defn- bucket-leaf-one
  [bucket Bucket
   source (Vec t/OperationOccurrence)
   shape Int
   a Any] (Vec t/OperationOccurrence)
  (let [codes (Vec Int) (bucket-codes bucket)
        chain (Vec Int) (bucket-chain bucket)]
    (loop [key Int (nth (bucket-heads bucket)
             (mod (hash-one a) (bucket-width bucket)))]
      (if (< key 0)
        empty-events
        (let [code Int (nth codes key)]
          (if (and (= shape (code-shape code))
                (= a (shape-term shape (nth source (code-position code)))))
            (nth (bucket-events bucket) key)
            (recur (nth chain key))))))))

(defn- bucket-leaf-two
  [bucket Bucket
   source (Vec t/OperationOccurrence)
   a Any
   b Any] (Vec t/OperationOccurrence)
  (let [codes (Vec Int) (bucket-codes bucket)
        chain (Vec Int) (bucket-chain bucket)]
    (loop [key Int (nth (bucket-heads bucket)
             (mod (hash-two a b) (bucket-width bucket)))]
      (if (< key 0)
        empty-events
        (let [code Int (nth codes key)]
          (if (and (= shape-t12 (code-shape code))
                (let [proposition t/Triple (proposition-of (nth source (code-position code)))]
                  (and (= a (t/triple-t1 proposition))
                    (= b (t/triple-t2 proposition)))))
            (nth (bucket-events bucket) key)
            (recur (nth chain key))))))))

(defn- occurrence-event
  [index OccurrenceIndex
   source (Vec t/OperationOccurrence)
   occurrence t/Triple] t/OperationOccurrence?
  (let [chain (Vec Int) (occurrenceindex-chain index)]
    (loop [position Int (nth (occurrenceindex-heads index)
             (mod (hash-one occurrence) (occurrenceindex-width index)))]
      (if (< position 0)
        nil
        (let [event t/OperationOccurrence (nth source position)]
          (if (= occurrence (occurrence-of event))
            event
            (recur (nth chain position))))))))

;; --- Pending-tail reads. Every base answer is folded through the tail: an
;; assert appends its event when the pattern covers it, a retract withdraws the
;; newest surviving occurrence of its proposition. Restricted to any pattern a
;; bucket serves, the globally newest live occurrence of a proposition is the
;; last one in that pattern's commit-ordered answer, so the per-answer fold
;; agrees with the from-scratch projection of the same history.

(defn- slot-matches?
  [pattern Any
   term Any] Bool
  (or (nil? pattern) (= pattern term)))

(defn- pattern-match?
  [proposition t/Triple
   t1 Any
   t2 Any
   t3 Any] Bool
  (and (slot-matches? t1 (t/triple-t1 proposition))
    (and (slot-matches? t2 (t/triple-t2 proposition))
      (slot-matches? t3 (t/triple-t3 proposition)))))

;; The three unindexed bound-subsets are exact narrowings of an indexed leaf:
;; the same events, in the same commit order, minus the ones the extra bound
;; slot excludes. A leaf that survives whole is returned as it stands, so the
;; common one-answer case allocates nothing.
(defn- narrowed
  [base (Vec t/OperationOccurrence)
   t1 Any
   t2 Any
   t3 Any] (Vec t/OperationOccurrence)
  (let [kept Int (loop [position Int 0
                        total Int 0]
                   (if (>= position (count base))
            total
            (recur (inc position)
              (if (pattern-match? (proposition-of (nth base position)) t1 t2 t3)
                (inc total)
                total))))]
    (if (= kept (count base))
      base
      (loop [built (Vec t/OperationOccurrence) empty-events
             position Int 0]
        (if (>= position (count base))
          built
          (recur
           (if (pattern-match? (proposition-of (nth base position)) t1 t2 t3)
             (conj built (nth base position))
             built)
           (inc position)))))))

(defn- without-newest-of
  [events (Vec t/OperationOccurrence)
   proposition t/Triple] (Vec t/OperationOccurrence)
  (let [at Int (loop [position Int (dec (count events))]
          (if (< position 0)
            -1
            (if (= proposition (proposition-of (nth events position)))
              position
              (recur (dec position)))))]
    (if (< at 0)
      events
      (loop [built (Vec t/OperationOccurrence) empty-events
             position Int 0]
        (if (>= position (count events))
          built
          (recur (if (= position at) built (conj built (nth events position)))
            (inc position)))))))

(defn- merged-matching
  [base (Vec t/OperationOccurrence)
   pending (Vec t/OperationOccurrence)
   t1 Any
   t2 Any
   t3 Any] (Vec t/OperationOccurrence)
  (if (empty? pending)
    base
    (loop [events (Vec t/OperationOccurrence) base
           position Int 0]
      (if (>= position (count pending))
        events
        (let [op t/OperationOccurrence (nth pending position)
              proposition t/Triple (proposition-of op)]
          (recur
           (if (= t/assert-action (t/operationoccurrence-action op))
             (if (pattern-match? proposition t1 t2 t3)
               (conj events op)
               events)
             (without-newest-of events proposition))
           (inc position)))))))

(defn space-id [rotation Rotation] String (rotation-space-id rotation))

(defn version [rotation Rotation] Int (rotation-version rotation))

(defn all-occurrences [rotation Rotation] (Vec t/OperationOccurrence)
  (merged-matching (rotation-events rotation) (rotation-pending rotation)
    nil nil nil))

(defn occurrence-count [rotation Rotation] Int
  (count (all-occurrences rotation)))

;; Every bound subset resolves to one indexed leaf, narrowed by any bound slot
;; the index does not carry; results stay in commit order, so `last` is the
;; newest live occurrence of that pattern.
(defn by-t1
  [rotation Rotation
   t1 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (bucket-leaf-one (rotation-spo rotation) (rotation-events rotation)
     shape-t1 t1)
   (rotation-pending rotation) t1 nil nil))

(defn by-t12
  [rotation Rotation
   t1 Any
   t2 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (bucket-leaf-two (rotation-spo rotation) (rotation-events rotation) t1 t2)
   (rotation-pending rotation) t1 t2 nil))

(defn by-t2
  [rotation Rotation
   t2 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (bucket-leaf-one (rotation-pos rotation) (rotation-events rotation)
     shape-t2 t2)
   (rotation-pending rotation) nil t2 nil))

(defn by-t23
  [rotation Rotation
   t2 Any
   t3 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (narrowed
    (bucket-leaf-one (rotation-osp rotation) (rotation-events rotation)
      shape-t3 t3)
    nil t2 nil)
   (rotation-pending rotation) nil t2 t3))

(defn by-t3
  [rotation Rotation
   t3 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (bucket-leaf-one (rotation-osp rotation) (rotation-events rotation)
     shape-t3 t3)
   (rotation-pending rotation) nil nil t3))

(defn by-t13
  [rotation Rotation
   t1 Any
   t3 Any] (Vec t/OperationOccurrence)
  (merged-matching
   (narrowed
    (bucket-leaf-one (rotation-osp rotation) (rotation-events rotation)
      shape-t3 t3)
    t1 nil nil)
   (rotation-pending rotation) t1 nil t3))

(defn by-proposition
  [rotation Rotation
   proposition t/Triple] (Vec t/OperationOccurrence)
  (merged-matching
   (narrowed
    (bucket-leaf-two (rotation-spo rotation) (rotation-events rotation)
      (t/triple-t1 proposition) (t/triple-t2 proposition))
    nil nil (t/triple-t3 proposition))
   (rotation-pending rotation)
   (t/triple-t1 proposition)
   (t/triple-t2 proposition)
   (t/triple-t3 proposition)))

;; nil in a slot means UNBOUND. This is the semantic entry point; the bucket
;; layout above is private detail every caller is expected to route through.
(defn matching
  [rotation Rotation
   t1 Any
   t2 Any
   t3 Any] (Vec t/OperationOccurrence)
  (cond
    [(and (some? t1) (and (some? t2) (some? t3)))
     (by-proposition rotation (t/triple t1 t2 t3))]
    [(and (some? t1) (some? t2)) (by-t12 rotation t1 t2)]
    [(and (some? t2) (some? t3)) (by-t23 rotation t2 t3)]
    [(and (some? t1) (some? t3)) (by-t13 rotation t1 t3)]
    [(some? t1) (by-t1 rotation t1)]
    [(some? t2) (by-t2 rotation t2)]
    [(some? t3) (by-t3 rotation t3)]
    [:else (all-occurrences rotation)]))

;; The newest surviving event carrying this occurrence, judged through the
;; proposition's own merged answer so a pending retract of the proposition
;; withdraws exactly the occurrence the store's fold would withdraw.
(defn event-at
  [rotation Rotation
   occurrence t/Triple] t/OperationOccurrence?
  (let [base t/OperationOccurrence? (occurrence-event (rotation-by-occurrence rotation) (rotation-events rotation) occurrence)
        candidate t/OperationOccurrence? (let [pending (Vec t/OperationOccurrence) (rotation-pending rotation)]
          (loop [position Int 0
                 found t/OperationOccurrence? base]
            (if (>= position (count pending))
              found
              (let [op t/OperationOccurrence (nth pending position)]
                (recur (inc position)
                  (if (and (= t/assert-action
                              (t/operationoccurrence-action op))
                           (= occurrence (occurrence-of op)))
                    op
                    found))))))]
    (if (nil? candidate)
      nil
      (let [present t/OperationOccurrence candidate
            live (Vec t/OperationOccurrence) (by-proposition rotation (proposition-of present))
            survives Bool (loop [position Int 0]
              (if (>= position (count live))
                false
                (if (= occurrence (occurrence-of (nth live position)))
                  true
                  (recur (inc position)))))]
        (if survives present nil)))))

(defn live-occurrence?
  [rotation Rotation
   occurrence t/Triple] Bool
  (some? (event-at rotation occurrence)))

(defn newest-first [events (Vec t/OperationOccurrence)] (Vec t/OperationOccurrence)
  (vec (reverse events)))

(defn newest [events (Vec t/OperationOccurrence)] t/OperationOccurrence?
  (if (empty? events) nil (last events)))

(defn propositions [events (Vec t/OperationOccurrence)] (Vec t/Triple)
  (mapv (fn [event t/OperationOccurrence] t/Triple
          (proposition-of event))
        events))

(defn subjects [events (Vec t/OperationOccurrence)] (Vec Any)
  (mapv (fn [event t/OperationOccurrence] Any
          (t/triple-t1 (proposition-of event)))
    events))

(defn values [events (Vec t/OperationOccurrence)] (Vec Any)
  (mapv (fn [event t/OperationOccurrence] Any
          (t/triple-t3 (proposition-of event)))
    events))

(defn occurrences [events (Vec t/OperationOccurrence)] (Vec t/Triple)
  (mapv (fn [event t/OperationOccurrence] t/Triple
          (occurrence-of event))
        events))

;; --- The full projection. The arena a projection allocates into is never
;; reset before its store generation dies, so the projection's TOTAL
;; allocation is its resident cost: every intermediate a build step takes is
;; paid for as if it were retained. That is why nothing here materializes a
;; key, why a slot row is an Int rather than a growable vector, and why the
;; near-unique shapes are narrowed on probe rather than given leaves of their
;; own.

(def empty-event-cells (Vec (Atom (Vec t/OperationOccurrence))) [])

(def empty-head-cells (Vec (Atom Int)) [])

(defn- fresh-head-cells [width Int] (Vec (Atom Int))
  (loop [cells (Vec (Atom Int)) empty-head-cells
         position Int 0]
    (if (>= position width)
      cells
      (recur (conj cells (atom -1)) (inc position)))))

(defn- frozen-heads [cells (Vec (Atom Int))] (Vec Int)
  (loop [rows (Vec Int) empty-ints
         position Int 0]
    (if (>= position (count cells))
      rows
      (recur (conj rows (deref (nth cells position))) (inc position)))))

(defn- close-event-cells [cells (Vec (Atom (Vec t/OperationOccurrence)))] (Vec (Vec t/OperationOccurrence))
  (loop [lists (Vec (Vec t/OperationOccurrence)) empty-event-lists
         position Int 0]
    (if (>= position (count cells))
      lists
      (recur (conj lists (deref (nth cells position))) (inc position)))))

;; Relink every key into a freshly widened head array; the caller owns the
;; cells, so a doubling never has to carry a cell out through a record field.
(defn- relinked-chain!
  [codes (Vec Int)
   source (Vec t/OperationOccurrence)
   heads (Vec (Atom Int))
   width Int] (Vec Int)
  (loop [chain (Vec Int) empty-ints
         key Int 0]
    (if (>= key (count codes))
      chain
      (let [code Int (nth codes key)
            slot Int (mod (shape-hash (code-shape code)
                   (nth source (code-position code)))
              width)
            linked (Vec Int) (conj chain (deref (nth heads slot)))]
        (do
          (reset! (nth heads slot) key)
          (recur linked (inc key)))))))

(defn- checked-assertion [event t/OperationOccurrence] t/OperationOccurrence
  (if (assertion-occurrence? event)
    event
    (throw (ex-info "store: rotations cover assertion occurrences only" {:type :invalid-rotation-occurrence}))))

;; A bucket sized from the entry count starts at the width its keys will want,
;; so the common projection rehashes at most once instead of walking every
;; doubling: a doubling reallocates the whole slot-cell array and re-links
;; every key, and nothing the build allocates is ever given back.
(defn- initial-bucket-width [event-count Int] Int
  (loop [width Int bucket-initial-slots]
    (if (>= (* bucket-slot-load width) event-count)
      width
      (recur (* 2 width)))))

(defn- bucket-key-at
  [codes (Vec Int)
   chain (Vec Int)
   heads (Vec (Atom Int))
   source (Vec t/OperationOccurrence)
   slot Int
   shape Int
   event t/OperationOccurrence] Int
  (loop [key Int (deref (nth heads slot))]
    (if (< key 0)
      -1
      (let [code Int (nth codes key)]
        (if (and (= shape (code-shape code))
              (same-shape-key? shape event (nth source (code-position code))))
          key
          (recur (nth chain key)))))))

;; One bucket over the key shapes it owns. Each state is an ordinary loop
;; variable and the pass reads the events once per shape.
(defn- projected-bucket!
  [events (Vec t/OperationOccurrence)
   first-shape Int
   last-shape Int
   initial-width Int] Bucket
  (loop [width Int initial-width
         codes (Vec Int) empty-ints
         cells (Vec (Atom (Vec t/OperationOccurrence))) empty-event-cells
         chain (Vec Int) empty-ints
         heads (Vec (Atom Int)) (fresh-head-cells initial-width)
         position Int 0
         shape Int first-shape]
    (if (>= position (count events))
      (->Bucket width codes (close-event-cells cells) (frozen-heads heads)
        chain)
      (if (> shape last-shape)
        (recur width codes cells chain heads (inc position) first-shape)
        (let [event t/OperationOccurrence (checked-assertion (nth events position))
              slot Int (mod (shape-hash shape event) width)
              at Int (bucket-key-at codes chain heads events slot shape event)]
          (if (>= at 0)
            (do
              (swap! (nth cells at) conj event)
              (recur width codes cells chain heads position (inc shape)))
            (let [appended Int (count codes)
                  grown-codes (Vec Int) (conj codes (key-code position shape))
                  grown-cells (Vec (Atom (Vec t/OperationOccurrence))) (conj cells (atom [event]))
                  grown-chain (Vec Int) (conj chain (deref (nth heads slot)))]
              (do
                (reset! (nth heads slot) appended)
                (if (> (count grown-codes) (* bucket-slot-load width))
                  (let [widened Int (* 2 width)
                        fresh (Vec (Atom Int)) (fresh-head-cells widened)
                        relinked (Vec Int) (relinked-chain! grown-codes events fresh widened)]
                    (recur widened grown-codes grown-cells relinked fresh
                      position (inc shape)))
                  (recur width grown-codes grown-cells grown-chain heads
                    position (inc shape)))))))))))

;; The occurrence index carries no keys and no leaves: an occurrence coordinate
;; is unique per operation, so key k is event position k, and prepending each
;; event onto its slot chain makes a repeated occurrence resolve newest-first.
(defn- projected-occurrences!
  [events (Vec t/OperationOccurrence)
   width Int] OccurrenceIndex
  (let [heads (Vec (Atom Int)) (fresh-head-cells width)]
    (loop [chain (Vec Int) empty-ints
           position Int 0]
      (if (>= position (count events))
        (->OccurrenceIndex width (frozen-heads heads) chain)
        (let [event t/OperationOccurrence (checked-assertion (nth events position))
              slot Int (mod (hash-one (occurrence-of event)) width)
              linked (Vec Int) (conj chain (deref (nth heads slot)))]
          (do
            (reset! (nth heads slot) position)
            (recur linked (inc position))))))))

(defn- projected!
  [space-id String
   version Int
   events (Vec t/OperationOccurrence)] Rotation
  (let [total Int (count events)]
    (->Rotation space-id version events
      (projected-occurrences! events (initial-bucket-width total))
      (projected-bucket! events shape-t1 shape-t12
        (initial-bucket-width (* 2 total)))
      (projected-bucket! events shape-t2 shape-t2
        (initial-bucket-width total))
      (projected-bucket! events shape-t3 shape-t3
        (initial-bucket-width total))
      no-pending)))

(defn project! [ctx (Atom t/TermStore)] Rotation
  (projected! (store/space-id ctx) (store/current-sequence ctx)
    (store/live-occurrences ctx)))

;; --- The pending tail. A committed record joins the tail as one system
;; occurrence per operation; the tail folds down only at a projection point.

(defn- pending-with-record
  [pending (Vec t/OperationOccurrence)
   space-id String
   record t/TransactionRecord] (Vec t/OperationOccurrence)
  (let [coordinate t/Triple (t/transaction-coordinate space-id (t/transactionrecord-sequence record))
        operations (Vec t/CommitOperation) (t/transactionrecord-operations record)]
    (loop [built (Vec t/OperationOccurrence) pending
           ordinal Int 0]
      (if (>= ordinal (count operations))
        built
        (let [operation t/CommitOperation (nth operations ordinal)
              proposition t/Triple (t/commitoperation-proposition operation)]
          (recur
           (conj built
                 (t/operation-occurrence
                  (t/occurrence-coordinate coordinate ordinal)
                  (t/commitoperation-action operation)
                  proposition))
           (inc ordinal)))))))

;; Uncommitted builder operations projected onto a committed rotation through
;; the same fold commit applies, so a staged read cannot disagree with its own
;; commit.
(defn staged
  [rotation Rotation
   space-id String
   sequence Int
   operations (Vec t/CommitOperation)] Rotation
  (assoc rotation :pending
    (pending-with-record (rotation-pending rotation) space-id
      (t/->TransactionRecord sequence operations))))

(defn refresh!
  [rotation Rotation
   ctx (Atom t/TermStore)] Rotation
  (let [space String (store/space-id ctx)
        target Int (store/current-sequence ctx)
        pinned Int (rotation-version rotation)]
    (if (not (= space (rotation-space-id rotation)))
      (throw (ex-info "store: rotation belongs to a different space" {:type :rotation-space-mismatch}))
      (if (> pinned target)
        (throw (ex-info "store: rotation is ahead of the store it projects" {:type :rotation-ahead-of-store}))
        (if (= pinned target)
          rotation
          (let [records (Vec t/TransactionRecord) (store/transaction-records-between (deref ctx) pinned target)
                pending (Vec t/OperationOccurrence) (loop [built (Vec t/OperationOccurrence) (rotation-pending rotation)
                                                           position Int 0]
                                                      (if (>= position (count records))
                    built
                    (recur (pending-with-record built space (nth records position))
                      (inc position))))
                advanced Rotation (->Rotation (rotation-space-id rotation) target
                  (rotation-events rotation)
                  (rotation-by-occurrence rotation) (rotation-spo rotation)
                  (rotation-pos rotation) (rotation-osp rotation) pending)]
            (if (> (count pending) pending-fold-cap)
              (projected! space target (all-occurrences advanced))
              advanced)))))))

;; The projection must travel with the root it was built from; a caller holding
;; an unpinned rotation is reading a version that no longer exists.
(defn pinned?
  [rotation Rotation
   ctx (Atom t/TermStore)] Bool
  (and (= (store/space-id ctx) (rotation-space-id rotation))
    (= (store/current-sequence ctx) (rotation-version rotation))))
