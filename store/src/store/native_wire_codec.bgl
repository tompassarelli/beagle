#lang beagle

(ns store.native-wire-codec
  (:require [store.rpc-limits :as limits]
            [store.types :as t]))


(def rpc-v2-header-bytes Int 26)
(def rpc-v2-max-body-bytes Int 1048576)
(def store-rpc-v2-max-packet-bytes Int 1048602)
(def rpc-v2-max-string-bytes Int 1048576)
(def rpc-v2-max-space-bytes Int 4096)
(def rpc-v2-max-term-nodes Int 65536)
(def store-rpc-v2-magic (Vec Int) [83 84 79 82 69 82 80 67])
(def recursive-term-depth-error String
  "recursive Term exceeds the TermCodecV1 depth bound")
(def term-node-count-error String
  "TermCodecV1 node count exceeds the configured bound")

(defwire store-rpc-v2-packet-header
  (packet-encoded :u32le :none)
  (tagged :u8
    [1 request
     [(flags :u8 "packet flags")
      (body-length :u32le "body length")
      (request-id :i64le "request id")]]
    [2 response
     [(flags :u8 "packet flags")
      (body-length :u32le "body length")
      (request-id :i64le "request id")]]))

(defwire rpc-v2-request-body
  (packet-encoded :none :none)
  (tagged :none
    [0 request
     [(space (codec String :bounded-space-term append-space-term!
                    read-space-term! -1 rpc-v2-max-space-bytes))
      (op (codec Keyword :keyword-term append-keyword-term!
                 read-request-keyword-term! -1))
      (expected-version (optional :i64le) "expected-version")
      (page (optional (codec t/RpcPageRequest :page-request
                             append-page-request! read-page-request! -1)))
      (timeout-ms (optional :u32le) "timeout-ms")
      (payload (codec Any :term append-schema-term! read-schema-term! -1))]]))

(defwire rpc-v2-response-body
  (packet-encoded :none :none)
  (tagged :none
    [0 response
     [(space (codec String :bounded-space-term append-space-term!
                    read-space-term! -1 rpc-v2-max-space-bytes))
      (op (codec Keyword :keyword-term append-keyword-term!
                 read-response-keyword-term! -1))
      (served-version :i64le)
      (page (optional (codec t/RpcPageResponse :page-response
                             append-page-response! read-page-response! -1)))
      (error (optional (codec t/RpcError :rpc-error
                              append-error! read-error! -1)))
      (payload (optional (codec Any :term append-schema-term!
                                read-schema-term! -1)))]]))

(defrecord DecodeResult [(packet t/StoreRpcPacketV2?) (error String?)])

(defrecord EncodeResult [(bytes (U Nil (Vec Int))) (error String?)])

(defn response-encode-error-code [(error String?)] Keyword
  (cond
    [(= error recursive-term-depth-error) :term-depth-exceeded]
    [(= error term-node-count-error) :term-codec-node-limit]
    [:else :rpc-packet-too-large]))

(defrecord TermDigestResult
  [(ok Bool) (digest String) (code Keyword) (message String)])

(defrecord Decoder
  [(bytes ByteSource)
   (position (Atom Int))
   (limit Int)
   (nodes (Atom Int))
   (error (Atom String?))])

(defrecord Encoder
  [(bytes (Atom (Vec Int))) (nodes (Atom Int)) (error (Atom String?))])

(defrecord WireFieldSchema
  [(name Keyword) (kind Keyword) (fixed-bytes Int) (bound Int?) (optional Bool)])

(defrecord WireCaseSchema
  [(tag Int) (name Keyword) (fixed-bytes Int) (fields (Vec WireFieldSchema))])

(defrecord WireSchema
  [(name Keyword)
   (length-kind Keyword)
   (checksum-kind Keyword)
   (tag-kind Keyword)
   (cases (Vec WireCaseSchema))])

;; A field is `(name wire-type)` or `(name wire-type context)`. Wire types are
;; primitive keywords, `(bounded-text maximum)`, `(optional wire-type)`, or a
;; typed `(codec Type kind append-fn read-fn fixed-bytes [bound])` pair. The
;; latter is how domain records compose schemas without exposing target code or
;; splitting one field's encoder and decoder across declarations.
(defmacro defwire [name packet-encoding tagging]
  (syntax-match (list packet-encoding tagging)
    [(list
      (list (literal packet-encoded)
            (capture length-kind)
            (capture checksum-kind))
      (list (literal tagged) (capture tag-kind) (tail-splice cases)))
     (let [base-type Any
           (fn [spec Any] Any
             (cond
               [(= spec ':u8) 'Int]
               [(= spec ':u16le) 'Int]
               [(= spec ':u32le) 'Int]
               [(= spec ':i64le) 'Int]
               [(= spec ':bool) 'Bool]
               [(= spec ':term) 'store.types/Term]
               [(if (list? spec) (= (first spec) 'bounded-text) false) 'String]
               [(if (list? spec) (= (first spec) 'codec) false) (nth spec 1)]
               [:else
                (error "defwire " name ": unsupported wire type " spec)]))
           field-type Any
           (fn [spec Any] Any
             (if (if (list? spec) (= (first spec) 'optional) false)
               (list 'U 'Nil (base-type (nth spec 1)))
               (base-type spec)))
           base-kind Any
           (fn [spec Any] Any
             (cond
               [(if (list? spec) (= (first spec) 'bounded-text) false)
                ':bounded-text]
               [(if (list? spec) (= (first spec) 'codec) false) (nth spec 2)]
               [:else spec]))
           field-kind Any
           (fn [spec Any] Any
             (if (if (list? spec) (= (first spec) 'optional) false)
               (base-kind (nth spec 1))
               (base-kind spec)))
           base-fixed Any
           (fn [spec Any] Any
             (cond
               [(= spec ':u8) 1]
               [(= spec ':bool) 1]
               [(= spec ':u16le) 2]
               [(= spec ':u32le) 4]
               [(= spec ':i64le) 8]
               [(= spec ':term) -1]
               [(if (list? spec) (= (first spec) 'bounded-text) false) -1]
               [(if (list? spec) (= (first spec) 'codec) false) (nth spec 5)]
               [:else
                (error "defwire " name ": unsupported wire type " spec)]))
           field-fixed Any
           (fn [spec Any] Any
             (if (if (list? spec) (= (first spec) 'optional) false)
               (let [fixed Any (base-fixed (nth spec 1))]
                 (if (< fixed 0) -1 (+ 1 fixed)))
               (base-fixed spec)))
           field-bound Any
           (fn [spec Any] Any
             (let [base Any (if (if (list? spec) (= (first spec) 'optional) false)
                          (nth spec 1) spec)]
               (cond
                 [(if (list? base) (= (first base) 'bounded-text) false)
                  (nth base 1)]
                 [(if (list? base) (= (first base) 'codec) false)
                  (if (= (count base) 7) (nth base 6) 'nil)]
                 [:else 'nil])))
           field-optional? Any
           (fn [spec Any] Any
             (if (list? spec) (= (first spec) 'optional) false))
           append-base Any
           (fn [spec Any encoder Any value Any context Any] Any
             (cond
               [(= spec ':u8)
                (list 'store.native-wire-codec/append-u8! encoder value)]
               [(= spec ':u16le)
                (list 'store.native-wire-codec/append-u16-le! encoder value)]
               [(= spec ':u32le)
                (list 'store.native-wire-codec/append-u32-le! encoder value)]
               [(= spec ':i64le)
                (list 'store.native-wire-codec/append-i64-le! encoder value)]
               [(= spec ':bool)
                (list 'store.native-wire-codec/append-u8!
                      encoder (list 'if value 1 0))]
               [(= spec ':term)
                (list 'store.native-wire-codec/append-term! encoder value 0)]
               [(if (list? spec) (= (first spec) 'bounded-text) false)
                (list 'store.native-wire-codec/append-sized-text!
                      encoder value (nth spec 1) context)]
               [(if (list? spec) (= (first spec) 'codec) false)
                (list (nth spec 3) encoder value)]
               [:else
                (error "defwire " name ": unsupported wire type " spec)]))
           read-base Any
           (fn [spec Any decoder Any context Any] Any
             (cond
               [(= spec ':u8)
                (list 'store.native-wire-codec/read-u8! decoder context)]
               [(= spec ':u16le)
                (list 'store.native-wire-codec/read-u16-le! decoder context)]
               [(= spec ':u32le)
                (list 'store.native-wire-codec/read-u32-le! decoder context)]
               [(= spec ':i64le)
                (list 'store.native-wire-codec/read-i64-le! decoder context)]
               [(= spec ':bool)
                (list 'store.native-wire-codec/read-bool! decoder context)]
               [(= spec ':term)
                (list 'store.native-wire-codec/read-term! decoder 0)]
               [(if (list? spec) (= (first spec) 'bounded-text) false)
                (list 'store.native-wire-codec/read-sized-text!
                      decoder (nth spec 1) context)]
               [(if (list? spec) (= (first spec) 'codec) false)
                (list (nth spec 4) decoder)]
               [:else
                (error "defwire " name ": unsupported wire type " spec)]))
           append-field Any
           (fn [spec Any encoder Any value Any context Any] Any
             (if (field-optional? spec)
               (let [base Any (nth spec 1)
                     present Any (list 'not (list 'nil? value))
                     present-value Any 'wire-present-value]
                 (list 'do
                       (list 'store.native-wire-codec/append-presence!
                             encoder present)
                       (list 'if-let
                             (vec (ann present-value (base-type base)) value)
                             (append-base base encoder present-value context)
                             'nil)))
               (append-base spec encoder value context)))
           read-field Any
           (fn [spec Any decoder Any context Any] Any
             (if (field-optional? spec)
               (list 'if
                     (list 'store.native-wire-codec/read-presence!
                           decoder (str context " presence"))
                     (read-base (nth spec 1) decoder context)
                     'nil)
               (read-base spec decoder context)))
           checked-cases Any
           (map-indexed
            (fn [case-index Any case Any] Any
              (if (vector? case)
                (if (= (count case) 3)
                  (let [fields Any (nth case 2)]
                    (if (vector? fields)
                      (do
                        (map-indexed
                         (fn [field-index Any field Any] Any
                           (if (list? field)
                             (if (if (= (count field) 2)
                                   true (= (count field) 3))
                               (do (field-type (nth field 1)) field)
                               (syntax-error-at fields field-index
                                 "Invalid defwire field declaration: " field))
                             (syntax-error-at fields field-index
                               "Invalid defwire field declaration: " field)))
                         fields)
                        case)
                      (syntax-error-at cases case-index
                        "Invalid defwire case fields: " fields)))
                  (syntax-error-at cases case-index
                    "Invalid defwire case declaration: " case))
                (syntax-error-at cases case-index
                  "Invalid defwire case declaration: " case)))
            cases)
           tag-bytes Any (cond
                       [(= tag-kind ':none) 0]
                       [(= tag-kind ':u8) 1]
                       [(= tag-kind ':u16le) 2]
                       [:else
                        (error "defwire " name
                               ": tag kind must be :none, :u8, or :u16le")])
           append-tag Any
           (fn [encoder Any tag Any] Any
             (cond
               [(= tag-kind ':none) 'nil]
               [(= tag-kind ':u8)
                (list 'store.native-wire-codec/append-u8! encoder tag)]
               [:else
                (list 'store.native-wire-codec/append-u16-le! encoder tag)]))
           case-forms Any
           (mapcat
            (fn [case Any] Any
              (let [tag Any (nth case 0)
                    case-name Any (nth case 1)
                    fields Any (nth case 2)
                    helper-prefix Any (format-symbol "~a-~a" name case-name)
                    tag-name Any (format-symbol "~a-tag" helper-prefix)
                    fixed-name Any (format-symbol "~a-fixed-bytes" helper-prefix)
                    append-name Any (format-symbol "append-~a!" helper-prefix)
                    read-name Any (format-symbol "read-~a!" helper-prefix)
                    record-name Any
                    (format-symbol "WireFields_~a_~a" name case-name)
                    constructor-name Any (format-symbol "->~a" record-name)
                    fixed-fields Any (map (fn [field Any] Any
                                        (field-fixed (nth field 1))) fields)
                    fixed-bytes Any
                    (if (every? (fn [size Any] Any (>= size 0)) fixed-fields)
                      (+ tag-bytes (reduce + 0 fixed-fields)) -1)
                    encoder Any 'wire-encoder
                    decoder Any 'wire-decoder
                    locals Any
                    (map-indexed
                     (fn [index Any field Any] Any
                       (format-symbol "wire-field-~a-~a" index (nth field 0)))
                     fields)
                    writes Any
                    (map
                     (fn [field Any local Any] Any
                       (let [field-name Any (nth field 0)
                             context Any (if (= (count field) 3)
                                       (nth field 2)
                                       (str name " " case-name " " field-name))]
                         (append-field (nth field 1) encoder local context)))
                     fields locals)
                    append-parameters Any
                    (apply vec
                           (cons (ann encoder 'store.native-wire-codec/Encoder)
                                 (map
                                  (fn [field Any local Any] Any
                                    (ann local (field-type (nth field 1))))
                                  fields locals)))
                    bindings Any
                    (mapcat
                     (fn [field Any local Any] Any
                       (let [context Any (if (= (count field) 3)
                                       (nth field 2)
                                       (str name " " case-name " " (nth field 0)))]
                         (list (ann local (field-type (nth field 1)))
                               (read-field (nth field 1) decoder context))))
                     fields locals)]
                (list
                 (list 'defrecord record-name
                       (apply vec
                              (map
                               (fn [field Any] Any
                                 (ann (nth field 0)
                                      (field-type (nth field 1))))
                               fields)))
                 (list 'def tag-name 'Int tag)
                 (list 'def fixed-name 'Int fixed-bytes)
                 (make-defn append-name
                   append-parameters 'Nil
                   (cons 'do
                         (append (list (append-tag encoder tag)) writes
                                 (list 'nil))))
                 (make-defn read-name
                   (vec (ann decoder 'store.native-wire-codec/Decoder)) record-name
                   (list 'let
                         (apply vec
                                bindings)
                         (cons constructor-name locals))))))
            checked-cases)
           case-schemas Any
           (map
            (fn [case Any] Any
              (let [tag Any (nth case 0)
                    case-name Any (nth case 1)
                    fields Any (nth case 2)
                    fixed-fields Any (map (fn [field Any] Any
                                        (field-fixed (nth field 1))) fields)
                    fixed-bytes Any
                    (if (every? (fn [size Any] Any (>= size 0)) fixed-fields)
                      (+ tag-bytes (reduce + 0 fixed-fields)) -1)
                    field-schemas Any
                    (map
                     (fn [field Any] Any
                       (let [spec Any (nth field 1)]
                         (list 'store.native-wire-codec/->WireFieldSchema
                               (make-keyword (nth field 0))
                               (field-kind spec)
                               (field-fixed spec)
                               (field-bound spec)
                               (field-optional? spec))))
                     fields)]
                (list 'store.native-wire-codec/->WireCaseSchema
                      tag (make-keyword case-name)
                      fixed-bytes (apply vec field-schemas))))
            checked-cases)
           schema-name Any (format-symbol "~a-schema" name)
           schema Any
           (list 'def schema-name 'store.native-wire-codec/WireSchema
                 (list 'store.native-wire-codec/->WireSchema
                       (make-keyword name) length-kind
                       checksum-kind tag-kind (apply vec case-schemas)))]
       (cons 'do (append case-forms (list schema))))]))

(def empty-byte-vector (Vec Int) [])
(def no-error String? nil)

(defn increment-int [(value Int)] Int (+ value 1))

(defn empty-byte-cell [] (Atom (Vec Int))
  (atom empty-byte-vector))

(defn empty-error-cell [] (Atom String?)
  (atom no-error))

;; Preserve-first is the nil compare-and-set, not a swap: a swap updater is
;; handed no arena, so one returning String? cannot build its own union.
(defn decoder-error! [(decoder Decoder) (message String)] Nil
  (compare-and-set! (decoder-error decoder) no-error message)
  nil)

(defn encoder-error! [(encoder Encoder) (message String)] Nil
  (compare-and-set! (encoder-error encoder) no-error message)
  nil)

(defn byte-value? [(value Int)] Bool
  (and (>= value 0) (<= value 255)))

(defn decoder-remaining [(decoder Decoder)] Int
  (- (decoder-limit decoder) (deref (decoder-position decoder))))

(defn ensure-bytes! [(decoder Decoder) (amount Int) (context String)] Bool
  (if (and (>= amount 0) (>= (decoder-remaining decoder) amount))
    true
    (do
      (decoder-error! decoder (str "Store RPC ended inside " context))
      false)))

(defn read-u8! [(decoder Decoder) (context String)] Int
  (if (ensure-bytes! decoder 1 context)
    (let [position (deref (decoder-position decoder))
          value (nth (decoder-bytes decoder) position)]
      (if (byte-value? value)
        (do (swap! (decoder-position decoder) increment-int) value)
        (do
          (decoder-error! decoder
                          "Store RPC byte vector contains a value outside u8")
          0)))
    0))

(defn read-u16-le! [(decoder Decoder) (context String)] Int
  (let [b0 (read-u8! decoder context)
        b1 (read-u8! decoder context)]
    (+ b0 (bit-shift-left b1 8))))

(defn read-u32-le! [(decoder Decoder) (context String)] Int
  (loop [offset Int 0 value Int 0]
    (if (< offset 4)
      (recur (+ offset 1)
             (bit-or value
                     (bit-shift-left (read-u8! decoder context) (* offset 8))))
      value)))

(defn read-i64-le! [(decoder Decoder) (context String)] Int
  (loop [offset Int 0 value Int 0]
    (if (< offset 8)
      (recur (+ offset 1)
             (bit-or value
                     (bit-shift-left (read-u8! decoder context) (* offset 8))))
      value)))

(defn read-presence! [(decoder Decoder) (context String)] Bool
  (let [value (read-u8! decoder context)]
    (cond
      [(= value 0) false]
      [(= value 1) true]
      [:else
       (do
         (decoder-error! decoder (str context " must be the strict byte 0 or 1"))
         false)])))

(defn read-bool! [(decoder Decoder) (context String)] Bool
  (read-presence! decoder context))

(defn append-u8! [(encoder Encoder) (value Int)] Nil
  ;; Both arms end in nil so the native join has one declared alternative.
  (if (byte-value? value)
    (do (swap! (encoder-bytes encoder) conj value) nil)
    (do (encoder-error! encoder
                        "Store RPC encoder produced a value outside u8")
        nil)))

(defn append-u16-le! [(encoder Encoder) (value Int)] Nil
  (loop [offset Int 0]
    (if (< offset 2)
      (do
        (append-u8! encoder
                    (bit-and 255 (unsigned-bit-shift-right value (* offset 8))))
        (recur (+ offset 1)))
      nil)))

(defn append-u32-le! [(encoder Encoder) (value Int)] Nil
  (if (and (>= value 0) (<= value 4294967295))
    (loop [offset Int 0]
      (if (< offset 4)
        (do
          (append-u8! encoder
                      (bit-and 255 (unsigned-bit-shift-right value (* offset 8))))
          (recur (+ offset 1)))
        nil))
    (encoder-error! encoder "Store RPC u32 value is out of range")))

(defn append-i64-le! [(encoder Encoder) (value Int)] Nil
  (loop [offset Int 0]
    (if (< offset 8)
      (do
        (append-u8! encoder
                    (bit-and 255 (unsigned-bit-shift-right value (* offset 8))))
        (recur (+ offset 1)))
      nil)))

(defn append-presence! [(encoder Encoder) (present Bool)] Nil
  (append-u8! encoder (if present 1 0)))

;; Push, never `into`: the native arena is bump-only, so rebuilding the byte
;; cell costs one arena copy of everything appended so far.
(defn append-bytes! [(encoder Encoder) (bytes (Vec Int))] Nil
  (loop [position Int 0]
    (if (>= position (count bytes))
      nil
      (do
        (append-u8! encoder (nth bytes position))
        (recur (+ position 1))))))

(defn utf8-bytes!
  [(encoder Encoder) (value String) (maximum Int) (label String)] (Vec Int)
  (let [(bytes (Vec Int)) (utf8-encode value)]
    (if (> (count bytes) maximum)
      (do
        (encoder-error! encoder (str label " exceeds the UTF-8 byte limit"))
        [])
      bytes)))

(defn continuation? [(value Int)] Bool
  (= 128 (bit-and value 192)))

(defn read-utf8! [(decoder Decoder) (length Int) (label String)] String
  (if (ensure-bytes! decoder length label)
    (let [start (deref (decoder-position decoder))
          end (+ start length)]
      (loop []
        (let [position (deref (decoder-position decoder))]
          (if (>= position end)
            (utf8-decode (subvec (decoder-bytes decoder) start end))
            (let [b0 (read-u8! decoder label)
                  width (cond
                          [(<= b0 127) 1]
                          [(and (>= b0 194) (<= b0 223)) 2]
                          [(and (>= b0 224) (<= b0 239)) 3]
                          [(and (>= b0 240) (<= b0 244)) 4]
                          [:else 0])]
              (if (or (= width 0) (> (+ position width) end))
                (do
                  (decoder-error! decoder (str label " is not valid UTF-8"))
                  "")
                (let [b1 (if (> width 1) (read-u8! decoder label) 0)
                      b2 (if (> width 2) (read-u8! decoder label) 0)
                      b3 (if (> width 3) (read-u8! decoder label) 0)
                      continuation-valid
                      (and (or (= width 1) (continuation? b1))
                           (and (or (< width 3) (continuation? b2))
                                (or (< width 4) (continuation? b3))))
                      code-point
                      (cond
                        [(= width 1) b0]
                        [(= width 2)
                         (+ (bit-shift-left (bit-and b0 31) 6)
                            (bit-and b1 63))]
                        [(= width 3)
                         (+ (bit-shift-left (bit-and b0 15) 12)
                            (+ (bit-shift-left (bit-and b1 63) 6)
                               (bit-and b2 63)))]
                        [:else
                         (+ (bit-shift-left (bit-and b0 7) 18)
                            (+ (bit-shift-left (bit-and b1 63) 12)
                               (+ (bit-shift-left (bit-and b2 63) 6)
                                  (bit-and b3 63))))])
                      scalar-valid
                      (and continuation-valid
                           (and (or (not= width 3)
                                    (and (or (not= b0 224) (>= b1 160))
                                         (or (not= b0 237) (<= b1 159))))
                                (and (or (not= width 4)
                                         (and (or (not= b0 240) (>= b1 144))
                                              (or (not= b0 244) (<= b1 143))))
                                     (and (not (and (>= code-point 55296)
                                                    (<= code-point 57343)))
                                          (<= code-point 1114111)))))]
                  (if scalar-valid
                    (recur)
                    (do
                      (decoder-error! decoder (str label " is not valid UTF-8"))
                      "")))))))))
    ""))

(defn read-sized-text! [(decoder Decoder) (maximum Int) (label String)] String
  (let [length (read-u32-le! decoder label)]
    (if (> length maximum)
      (do
        (decoder-error! decoder (str label " exceeds the UTF-8 byte limit"))
        "")
      (read-utf8! decoder length label))))

(defn append-sized-text!
  [(encoder Encoder) (value String) (maximum Int) (label String)] Nil
  (let [bytes (utf8-bytes! encoder value maximum label)]
    (if (nil? (deref (encoder-error encoder)))
      (do
        (append-u32-le! encoder (count bytes))
        (append-bytes! encoder bytes)
        nil)
      nil)))

(defn decoder-node-limited!
  [(decoder Decoder) (depth Int) (max-nodes Int) (max-depth Int)] Bool
  (if (> depth max-depth)
    (do
      (decoder-error! decoder recursive-term-depth-error)
      false)
    (let [node-count (swap! (decoder-nodes decoder) increment-int)]
      (if (> node-count max-nodes)
        (do
          (decoder-error! decoder term-node-count-error)
          false)
        true))))

(defn encoder-node-limited!
  [(encoder Encoder) (depth Int) (max-nodes Int) (max-depth Int)] Bool
  (if (> depth max-depth)
    (do
      (encoder-error! encoder recursive-term-depth-error)
      false)
    (let [node-count (swap! (encoder-nodes encoder) increment-int)]
      (if (> node-count max-nodes)
        (do
          (encoder-error! encoder term-node-count-error)
          false)
        true))))

(defn decoder-node! [(decoder Decoder) (depth Int)] Bool
  (decoder-node-limited! decoder depth rpc-v2-max-term-nodes
                         limits/term-codec-v1-max-depth))

(defn encoder-node! [(encoder Encoder) (depth Int)] Bool
  (encoder-node-limited! encoder depth rpc-v2-max-term-nodes
                         limits/term-codec-v1-max-depth))

(defn read-term-limited!
  [(decoder Decoder)
   (depth Int)
   (max-string-bytes Int)
   (max-nodes Int)
   (max-depth Int)]
  t/Term
  (if (decoder-node-limited! decoder depth max-nodes max-depth)
    (let [tag (read-u8! decoder "Term tag")]
      (cond
        [(= tag 1)
         (read-sized-text! decoder max-string-bytes "String atom")]
        [(= tag 2) (read-i64-le! decoder "Int atom")]
        [(= tag 3)
         (float-from-bits (read-i64-le! decoder "Float atom"))]
        [(= tag 4) false]
        [(= tag 5) true]
        [(= tag 6)
         (let [spelling
               (read-sized-text! decoder max-string-bytes "Keyword atom")]
           (if (empty? spelling)
             (do
               (decoder-error! decoder "Keyword atom spelling must be nonempty")
               :rpc/invalid)
             (keyword spelling)))]
        [(= tag 7)
         (t/triple
          (read-term-limited! decoder (+ depth 1) max-string-bytes max-nodes
                              max-depth)
          (read-term-limited! decoder (+ depth 1) max-string-bytes max-nodes
                              max-depth)
          (read-term-limited! decoder (+ depth 1) max-string-bytes max-nodes
                              max-depth))]
        [(= tag 8)
         (let [seconds (read-i64-le! decoder "Instant atom")
               nanos (read-u32-le! decoder "Instant nanos")]
           (if (< nanos 1000000000)
             (t/instant seconds nanos)
             (do
               (decoder-error! decoder
                               "Instant nanoseconds are outside the canonical range")
               (t/instant 0 0))))]
        [:else
         (do
           (decoder-error! decoder "TermCodecV1 contains an unknown tag")
           :rpc/invalid)]))
    :rpc/invalid))

(defn read-term! [(decoder Decoder) (depth Int)] t/Term
  (read-term-limited! decoder depth rpc-v2-max-string-bytes
                      rpc-v2-max-term-nodes limits/term-codec-v1-max-depth))

(defn append-term-limited!
  [(encoder Encoder)
   (term Any)
   (depth Int)
   (max-string-bytes Int)
   (max-nodes Int)
   (max-depth Int)]
  Nil
  (if (encoder-node-limited! encoder depth max-nodes max-depth)
    (cond
      [(t/triple? term)
       (do
         (append-u8! encoder 7)
         (append-term-limited! encoder (t/triple-t1 term) (+ depth 1)
                               max-string-bytes max-nodes max-depth)
         (append-term-limited! encoder (t/triple-t2 term) (+ depth 1)
                               max-string-bytes max-nodes max-depth)
         (append-term-limited! encoder (t/triple-t3 term) (+ depth 1)
                               max-string-bytes max-nodes max-depth))]
      [(string? term)
       (do
         (append-u8! encoder 1)
         (append-sized-text! encoder term max-string-bytes "String atom"))]
      [(integer? term)
       (do (append-u8! encoder 2) (append-i64-le! encoder term))]
      [(and (number? term) (not (integer? term)))
       (let [(float-term Float) (double term)]
         (do
           (append-u8! encoder 3)
           (append-i64-le! encoder (float-to-bits float-term))))]
      [(false? term) (append-u8! encoder 4)]
      [(true? term) (append-u8! encoder 5)]
      [(keyword? term)
       (let [spelling (subs (str term) 1)]
         (if (empty? spelling)
           (encoder-error! encoder "Keyword atom spelling must be nonempty")
           (do
             (append-u8! encoder 6)
             (append-sized-text! encoder spelling max-string-bytes
                                 "Keyword atom"))))]
      [(t/instant? term)
       (do
         (append-u8! encoder 8)
         (append-i64-le! encoder (t/instant-epoch-seconds term))
         (append-u32-le! encoder (t/instant-nanos term)))]
      [:else
       (encoder-error! encoder "TermCodecV1 encountered a value outside Term")])
    nil))

(defn append-term! [(encoder Encoder) (term Any) (depth Int)] Nil
  (append-term-limited! encoder term depth rpc-v2-max-string-bytes
                        rpc-v2-max-term-nodes limits/term-codec-v1-max-depth))

(defn canonical-term-sha256-result! [(term Any)] TermDigestResult
  (let [encoder (->Encoder (empty-byte-cell) (atom 0) (empty-error-cell))]
    (append-term! encoder term 0)
    (let [error (deref (encoder-error encoder))]
      (if error
        (->TermDigestResult false "" :term-codec-encode-failed error)
        (->TermDigestResult true
                            (sha256-bytes (deref (encoder-bytes encoder)))
                            :rpc/none "")))))

(defn canonical-term-byte-count! [(term Any)] Int
  (let [encoder (->Encoder (empty-byte-cell) (atom 0) (empty-error-cell))]
    (append-term! encoder term 0)
    (if (deref (encoder-error encoder))
      0
      (count (deref (encoder-bytes encoder))))))

(defn canonical-term-sha256! [(term Any)] String
  (let [(result TermDigestResult) (canonical-term-sha256-result! term)]
    (if (termdigestresult-ok result)
      (termdigestresult-digest result)
      (let [message (termdigestresult-message result)]
        (throw (ex-info message {:type (termdigestresult-code result)
                                 :store-rpc/code (termdigestresult-code result)
                                 :message message}))))))

(defn read-keyword-term! [(decoder Decoder) (label String)] Keyword
  (let [value (read-term! decoder 0)]
    (if (keyword? value)
      value
      (do
        (decoder-error! decoder (str label " must be a Keyword Term"))
        :rpc/invalid))))

(defn read-space-term! [(decoder Decoder)] String
  (if (decoder-node! decoder 0)
    (let [tag (read-u8! decoder "SpaceId Term tag")]
      (if (= tag 1)
        (read-sized-text! decoder rpc-v2-max-space-bytes "SpaceId")
        (do
          (decoder-error! decoder "Store RPC SpaceId must be a String Term")
          "")))
    ""))

(defn append-space-term! [(encoder Encoder) (space String)] Nil
  (let [space-node (encoder-node! encoder 0)
        space-bytes
        (if space-node
          (utf8-bytes! encoder space rpc-v2-max-space-bytes "SpaceId")
          [])]
    (if (nil? (deref (encoder-error encoder)))
      (do
        (append-u8! encoder 1)
        (append-u32-le! encoder (count space-bytes))
        (swap! (encoder-bytes encoder) into space-bytes)
        nil)
      nil)))

(defn append-keyword-term! [(encoder Encoder) (value Keyword)] Nil
  (append-term! encoder value 0))

(defn read-request-keyword-term! [(decoder Decoder)] Keyword
  (read-keyword-term! decoder "request op"))

(defn read-response-keyword-term! [(decoder Decoder)] Keyword
  (read-keyword-term! decoder "response op"))

(defn append-schema-term! [(encoder Encoder) (term Any)] Nil
  (append-term! encoder term 0))

(defn read-schema-term! [(decoder Decoder)] Any
  (read-term! decoder 0))

(defn read-page-request! [(decoder Decoder)] t/RpcPageRequest
  (let [(limit Int) (read-u32-le! decoder "page limit")
        (cursor-present Bool) (read-presence! decoder "page cursor presence")
        (cursor t/Term?) (if cursor-present (read-term! decoder 0) nil)]
    (t/->RpcPageRequest limit cursor)))

(defn append-page-request! [(encoder Encoder) (page t/RpcPageRequest)] Nil
  (append-u32-le! encoder (t/rpcpagerequest-limit page))
  (let [cursor (t/rpc-page-request-cursor-value page)]
    (append-presence! encoder (not (nil? cursor)))
    (if (nil? cursor) nil (append-term! encoder cursor 0))))

(defn read-page-response! [(decoder Decoder)] t/RpcPageResponse
  (let [ordinal (read-u32-le! decoder "page ordinal")
        cursor-present (read-presence! decoder "page cursor presence")
        cursor (if cursor-present (read-term! decoder 0) nil)
        done (read-bool! decoder "page done")]
    (t/->RpcPageResponse ordinal cursor done)))

(defn read-error! [(decoder Decoder)] t/RpcError
  (let [code (read-keyword-term! decoder "response error code")
        retryable (read-bool! decoder "response error retryable")
        message-term (read-term! decoder 0)
        message
        (if (string? message-term)
          message-term
          (do
            (decoder-error! decoder
                            "response error message must be a String Term")
            ""))
        detail-present (read-presence! decoder "response error detail presence")
        detail (if detail-present (read-term! decoder 0) nil)]
    (t/->RpcError code retryable message detail)))

(defn read-request-body! [(decoder Decoder)] t/RpcRequest
  (let [(fields WireFields_rpc-v2-request-body_request)
        (read-rpc-v2-request-body-request! decoder)]
    (t/->RpcRequest
     (wirefields_rpc-v2-request-body_request-space fields)
     (wirefields_rpc-v2-request-body_request-op fields)
     (wirefields_rpc-v2-request-body_request-expected-version fields)
     (wirefields_rpc-v2-request-body_request-page fields)
     (wirefields_rpc-v2-request-body_request-timeout-ms fields)
     (wirefields_rpc-v2-request-body_request-payload fields))))

(defn magic-valid! [(decoder Decoder)] Bool
  (loop [index Int 0 valid Bool true]
    (if (< index (count store-rpc-v2-magic))
      (recur (+ index 1)
             (and valid
                  (= (nth store-rpc-v2-magic index)
                     (read-u8! decoder "magic"))))
      valid)))

(defn decode-request-bytes! [(bytes ByteSource)] DecodeResult
  (let [decoder (->Decoder bytes (atom 0) (count bytes)
                           (atom 0) (empty-error-cell))
        byte-count (count bytes)]
    (cond
      [(> byte-count store-rpc-v2-max-packet-bytes)
       (->DecodeResult nil
                       "Store RPC packet exceeds the configured byte limit")]
      [(< byte-count rpc-v2-header-bytes)
       (->DecodeResult nil "Store RPC packet ended inside its header")]
      [(not (magic-valid! decoder))
       (->DecodeResult nil "Store RPC magic does not match")]
      [:else
       (let [major (read-u16-le! decoder "major version")
             minor (read-u16-le! decoder "minor version")
             kind (read-u8! decoder "packet kind")
             (header WireFields_store-rpc-v2-packet-header_request)
             (read-store-rpc-v2-packet-header-request! decoder)
             flags (wirefields_store-rpc-v2-packet-header_request-flags header)
             body-length
             (wirefields_store-rpc-v2-packet-header_request-body-length header)
             request-id
             (wirefields_store-rpc-v2-packet-header_request-request-id header)]
         (cond
           [(or (not= major 2) (not= minor 0))
            (->DecodeResult nil "Store RPC major/minor version is unsupported")]
           [(not= kind 1)
            (->DecodeResult nil
                            "native request decoder accepts only request packets")]
           [(not= flags 0)
            (->DecodeResult nil "Store RPC v2 flags must be zero")]
           [(> body-length rpc-v2-max-body-bytes)
            (->DecodeResult nil
                            "Store RPC declared body exceeds the configured byte limit")]
           [(< (decoder-remaining decoder) body-length)
            (->DecodeResult nil "Store RPC body is shorter than declared")]
           [(> (decoder-remaining decoder) body-length)
            (->DecodeResult nil
                            "Store RPC packet has bytes beyond its declared body")]
           [:else
            (let [request (read-request-body! decoder)
                  packet
                  (t/->StoreRpcPacketV2 :request 0 request-id request nil)
                  error (deref (decoder-error decoder))]
              (cond
                [error (->DecodeResult nil error)]
                [(not= 0 (decoder-remaining decoder))
                 (->DecodeResult nil
                                 "Store RPC body decoder left trailing bytes")]
                [:else (->DecodeResult packet nil)]))]))])))

(defn append-page-response! [(encoder Encoder) (page t/RpcPageResponse)] Nil
  (append-u32-le! encoder (t/rpcpageresponse-ordinal page))
  (let [cursor (t/rpc-page-response-cursor-value page)]
    (append-presence! encoder (not (nil? cursor)))
    (if (nil? cursor) nil (append-term! encoder cursor 0)))
  (append-u8! encoder (if (t/rpcpageresponse-done page) 1 0)))

(defn append-error! [(encoder Encoder) (error t/RpcError)] Nil
  (append-term! encoder (t/rpcerror-code error) 0)
  (append-u8! encoder (if (t/rpcerror-retryable error) 1 0))
  (append-term! encoder (t/rpcerror-message error) 0)
  (let [detail (t/rpc-error-detail-value error)]
    (append-presence! encoder (not (nil? detail)))
    (if (nil? detail) nil (append-term! encoder detail 0))))

(defn append-response-body! [(encoder Encoder) (response t/RpcResponse)] Nil
  (append-rpc-v2-response-body-response!
   encoder (t/rpcresponse-space response)
   (t/rpcresponse-op response)
   (t/rpcresponse-served-version response)
   (t/rpcresponse-page response)
   (t/rpcresponse-error response)
   (t/rpc-response-payload-value response)))

(defn finish-response-packet!
  [(packet t/StoreRpcPacketV2) (body-bytes (Vec Int))] EncodeResult
  (let [out (->Encoder (empty-byte-cell) (atom 0) (empty-error-cell))]
    (swap! (encoder-bytes out) into store-rpc-v2-magic)
    (append-u16-le! out 2)
    (append-u16-le! out 0)
    (append-store-rpc-v2-packet-header-response!
     out 0 (count body-bytes) (t/storerpcpacketv2-request-id packet))
    (swap! (encoder-bytes out) into body-bytes)
    (let [error (deref (encoder-error out))]
      (if error
        (->EncodeResult nil error)
        (->EncodeResult (deref (encoder-bytes out)) nil)))))

(defn encode-response-bytes! [(packet t/StoreRpcPacketV2)] EncodeResult
  (let [response (t/storerpcpacketv2-response packet)]
    (cond
      [(not= :response (t/storerpcpacketv2-kind packet))
       (->EncodeResult nil
                       "native response encoder accepts only response packets")]
      [(not= 0 (t/storerpcpacketv2-flags packet))
       (->EncodeResult nil "Store RPC v2 flags must be zero")]
      [(nil? response)
       (->EncodeResult nil "response packet must carry one RpcResponse")]
      [(not (nil? (t/storerpcpacketv2-request packet)))
       (->EncodeResult nil "response packet must not carry RpcRequest")]
      [:else
       (let [body (->Encoder (empty-byte-cell) (atom 0) (empty-error-cell))]
         (append-response-body! body response)
         (let [body-bytes (deref (encoder-bytes body))
               body-error (deref (encoder-error body))]
           (cond
             [body-error (->EncodeResult nil body-error)]
             [(> (count body-bytes) rpc-v2-max-body-bytes)
              (->EncodeResult nil
                              "Store RPC body exceeds the configured byte limit")]
             [:else (finish-response-packet! packet body-bytes)])))])))
