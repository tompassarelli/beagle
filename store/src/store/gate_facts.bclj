#lang beagle/clj
;; Shadow-only durable storage for gate fact envelopes. The semantic envelope is
;; owned by the Racket maintainer and crosses this boundary as canonical EDN
;; text; this adapter owns only exact-candidate routing, append-only occurrence
;; history, and miss-to-fallback ordering.
(ns store.gate-facts
  (:gen-class)
  (:import [java.io File]
           [java.nio.charset StandardCharsets]
           [java.security MessageDigest]))

(declare-extern clojure.core/load-file (Fn [String] Any))
(declare-extern clojure.core/require (Fn [Any] Any))
(declare-extern store.rt/parse-edn (Fn [String] Any))
(declare-extern store.types/triple (Fn [Any Any Any] Any))
(declare-extern store.types/triple? (Fn [Any] Bool))
(declare-extern store.types/triple-t1 (Fn [Any] Any))
(declare-extern store.types/triple-t2 (Fn [Any] Any))
(declare-extern store.types/triple-t3 (Fn [Any] Any))
(declare-extern database/create-triple-log! (Fn [String String] Any))
(declare-extern database/open-database! (Fn [String String] Any))
(declare-extern database/commit! (Fn [Any Any] Any))
(declare-extern database/live-propositions (Fn [Any] (Vec Any)))
(declare-extern database/branch-revision! (Fn [String] Any))
(declare-extern writer-authority/acquire! (Fn [String] Any))
(declare-extern writer-authority/release! (Fn [Any] Any))

;; The hosted database owns FRAMLOG creation, append/fsync, replay, and recovery.
;; Loading it here keeps the command runnable with only store/out on classpath.
(clojure.core/require 'store.rt)
(let [(raw-emitted-file Any) (File. (str *file*))
      (emitted-file Any) (.getCanonicalFile raw-emitted-file)
      (emitted-namespace-directory Any) (.getParentFile emitted-file)
      (out-directory Any) (.getParentFile emitted-namespace-directory)
      (store-directory Any) (.getParentFile out-directory)]
  (clojure.core/load-file
   (str (.getPath store-directory) "/database.clj")))

(def protocol-prefix String "store.gate-facts")
(def space-prefix String "beagle-gate-facts-experimental-v1:")
(def subject-tag String "store.gate-facts/subject-v1")
(def fallback-link-kind String "store.gate-facts/fallback-link-v1")

(def allowed-kinds (Set String)
  #{"GateCandidateV1"
    "GatePhaseClaimV1"
    "GatePhaseObservationV1"
    "GateCandidateVerdictV1"
    "FactMissEventV1"
    "GateMaintenanceReceiptV1"})

(defrecord FactRoute
  [(path String) (base-commit String) (candidate-root String) (space-id String)])

(defrecord FactEntry [(id String) (kind String) (envelope String)])

(defrecord FallbackLink [(miss-id String) (observation-id String)])

(defrecord AppendCounts [(appended Int) (retained Int)])

(defn- fail [(message String) (code Keyword)] Any
  (throw (ex-info message {:type code :fram/code code})))

(defn- nonempty-string? [(value Any)] Bool
  (and (string? value) (pos? (count value))))

(defn- exact-base-commit? [(value Any)] Bool
  (and (string? value)
       (some? (re-matches #"[0-9a-f]{40}" value))))

(defn- sha256-id [(text String)] String
  (str
   "sha256:"
   (apply
    str
    (mapv
     (fn [(value Any)] String
       (format "%02x" (bit-and (int value) 255)))
     (vec
      (.digest (MessageDigest/getInstance "SHA-256")
               (.getBytes text StandardCharsets/UTF_8)))))))

(defn route
  [(path String) (base-commit String) (candidate-root String)] FactRoute
  (cond
    [(nil? (re-matches #"/.*" path))
     (fail "gate fact Store path must be absolute" :gate-facts/relative-route)]
    [(not (exact-base-commit? base-commit))
     (fail "gate fact base commit must be one full lowercase Git object id"
           :gate-facts/invalid-base-commit)]
    [(not (nonempty-string? candidate-root))
     (fail "gate fact candidate root must be nonempty"
           :gate-facts/invalid-candidate-root)]
    [(or (= candidate-root "main") (= candidate-root "refs/heads/main"))
     (fail "gate fact candidate root must be immutable, not a published route"
           :gate-facts/published-route-refused)]
    [:else
     (->FactRoute path base-commit
                  candidate-root
                  (str space-prefix base-commit))]))

(defn fact-entry [(id String) (kind String) (envelope String)] FactEntry
  (let [(payload Any) (store.rt/parse-edn envelope)]
    (cond
      [(not (nonempty-string? id))
       (fail "gate fact id must be nonempty" :gate-facts/invalid-fact-id)]
      [(not (contains? allowed-kinds kind))
       (fail (str "gate fact kind is unknown: " kind)
             :gate-facts/unknown-kind)]
      [(not (and (vector? payload)
                 (pos? (count payload))
                 (= kind (first payload))
                 (= envelope (pr-str payload))))
       (fail "gate fact envelope must be an EDN vector headed by its V1 kind"
             :gate-facts/invalid-envelope)]
      [(not= id (sha256-id envelope))
       (fail "gate fact id does not match the canonical envelope bytes"
             :gate-facts/fact-id-mismatch)]
      [:else (->FactEntry id kind envelope)])))

(defn- fact-subject [(candidate-root String) (fact-id String)] Any
  (store.types/triple subject-tag candidate-root fact-id))

(defn- fact-proposition [(candidate-root String) (entry FactEntry)] Any
  (store.types/triple (fact-subject candidate-root (factentry-id entry))
                      (factentry-kind entry)
                      (factentry-envelope entry)))

(defn- fallback-proposition [(candidate-root String) (link FallbackLink)] Any
  (store.types/triple
   (fact-subject candidate-root (fallbacklink-miss-id link))
   fallback-link-kind
   (fallbacklink-observation-id link)))

(defn- candidate-subject? [(value Any) (candidate-root String)] Bool
  (and (store.types/triple? value)
       (= subject-tag (store.types/triple-t1 value))
       (= candidate-root (store.types/triple-t2 value))
       (string? (store.types/triple-t3 value))))

(defn- proposition-entry [(proposition Any) (candidate-root String)] FactEntry?
  (let [(subject Any) (store.types/triple-t1 proposition)
        (kind Any) (store.types/triple-t2 proposition)
        (envelope Any) (store.types/triple-t3 proposition)]
    (if (and (candidate-subject? subject candidate-root)
             (string? kind)
             (contains? allowed-kinds kind)
             (string? envelope))
      (->FactEntry (store.types/triple-t3 subject) kind envelope)
      nil)))

(defn- proposition-link
  [(proposition Any) (candidate-root String)] FallbackLink?
  (let [(subject Any) (store.types/triple-t1 proposition)
        (kind Any) (store.types/triple-t2 proposition)
        (observation-id Any) (store.types/triple-t3 proposition)]
    (if (and (candidate-subject? subject candidate-root)
             (= fallback-link-kind kind)
             (string? observation-id))
      (->FallbackLink (store.types/triple-t3 subject) observation-id)
      nil)))

(defn- facts-for [(database Any) (selected FactRoute)] (Vec FactEntry)
  (reduce
   (fn [(entries (Vec FactEntry)) (proposition Any)] (Vec FactEntry)
     (let [(entry FactEntry?)
           (proposition-entry proposition
                              (factroute-candidate-root selected))]
       (if (some? entry) (conj entries entry) entries)))
   []
   (database/live-propositions database)))

(defn- links-for [(database Any) (selected FactRoute)] (Vec FallbackLink)
  (reduce
   (fn [(links (Vec FallbackLink)) (proposition Any)] (Vec FallbackLink)
     (let [(link FallbackLink?)
           (proposition-link proposition
                             (factroute-candidate-root selected))]
       (if (some? link) (conj links link) links)))
   []
   (database/live-propositions database)))

(defn- entry-with-id [(entries (Vec FactEntry)) (fact-id String)] FactEntry?
  (reduce
   (fn [(found FactEntry?) (entry FactEntry)] FactEntry?
     (if (= fact-id (factentry-id entry)) entry found))
   nil
   entries))

(defn- same-entry? [(left FactEntry) (right FactEntry)] Bool
  (and (= (factentry-id left) (factentry-id right))
       (= (factentry-kind left) (factentry-kind right))
       (= (factentry-envelope left) (factentry-envelope right))))

(defn- link-with-miss-id
  [(links (Vec FallbackLink)) (miss-id String)] FallbackLink?
  (reduce
   (fn [(found FallbackLink?) (link FallbackLink)] FallbackLink?
     (if (= miss-id (fallbacklink-miss-id link)) link found))
   nil
   links))

(defn- required-link [(link FallbackLink?)] FallbackLink
  (if (some? link)
    link
    (fail "fallback link is absent" :gate-facts/fallback-link-absent)))

(defn- create-or-open! [(selected FactRoute)] Any
  (let [(path String) (factroute-path selected)
        (file Any) (File. path)]
    (if (.exists file)
      nil
      (database/create-triple-log! path (factroute-space-id selected)))
    (database/open-database! path (factroute-space-id selected))))

(defn- with-writer!
  [(selected FactRoute) (operation (Fn [Any] (Vec Any)))] (Vec Any)
  (let [(authority Any)
        (writer-authority/acquire! (factroute-path selected))]
    (try
      (operation (create-or-open! selected))
      (finally (writer-authority/release! authority)))))

(defn- cold-open! [(selected FactRoute)] Any
  (let [(path String) (factroute-path selected)
        (file Any) (File. path)]
    (if (.isFile file)
      (database/open-database! path (factroute-space-id selected))
      (fail "gate fact Store route is unopened"
            :gate-facts/route-unresolved))))

(defn- append-propositions! [(database Any) (propositions (Vec Any))] Nil
  (if (empty? propositions)
    nil
    (do
      (database/commit!
       database
       {:actor "store.gate-facts/v1"
        :commit-metadata
        {:producer "store.gate-facts/v1"
         :shape-schema-id "store/CommitOperationV1"
         :profile "gate-facts-v1"
         :validation-attestation
         {:validator "store/canonical-validator-v1"
          :result :pending
          :attestation "store/canonical-validator-v1"}}
        :operations
        (mapv
         (fn [(proposition Any)] Any
           {:action :assert :proposition proposition})
         propositions)})
      nil)))

(defn- append-entries!
  [(database Any) (selected FactRoute) (entries (Vec FactEntry))] AppendCounts
  (let [(known (Vec FactEntry)) (facts-for database selected)
        (new-entries (Vec FactEntry))
        (reduce
         (fn [(pending (Vec FactEntry)) (entry FactEntry)] (Vec FactEntry)
           (let [(prior FactEntry?)
                 (entry-with-id (vec (concat known pending))
                                (factentry-id entry))]
             (cond
               [(nil? prior) (conj pending entry)]
               [(same-entry? prior entry) pending]
               [:else
                (fail (str "gate fact id has conflicting immutable content: "
                           (factentry-id entry))
                      :gate-facts/conflicting-fact)])))
         []
         entries)]
    (append-propositions!
     database
     (mapv
      (fn [(entry FactEntry)] Any
        (fact-proposition (factroute-candidate-root selected) entry))
      new-entries))
    (->AppendCounts (count new-entries)
                    (- (count entries) (count new-entries)))))

(defn- revision-identity [(selected FactRoute)] String
  (let [(revision Any)
        (database/branch-revision! (factroute-path selected))
        (identity Any) (get revision :identity)]
    (if (string? identity)
      identity
      (fail "Store returned no durable branch revision identity"
            :gate-facts/revision-unresolved))))

(defn- response-for [(database Any) (selected FactRoute)] (Vec Any)
  (let [(entries (Vec FactEntry)) (facts-for database selected)
        (links (Vec FallbackLink)) (links-for database selected)
        (receipts (Vec FactEntry))
        (filterv
         (fn [(entry FactEntry)] Bool
           (= "GateMaintenanceReceiptV1" (factentry-kind entry)))
         entries)]
    ["store.gate-facts/response-v1"
     "ok"
     (factroute-candidate-root selected)
     (revision-identity selected)
     (mapv
      (fn [(entry FactEntry)] (Vec String)
        [(factentry-id entry)
         (factentry-kind entry)
         (factentry-envelope entry)])
      entries)
     (mapv
      (fn [(link FallbackLink)] (Vec String)
        [(fallbacklink-miss-id link)
         (fallbacklink-observation-id link)])
      links)
     (mapv factentry-id receipts)]))

(defn import-facts! [(selected FactRoute) (entries (Vec FactEntry))] (Vec Any)
  (with-writer!
   selected
   (fn [(database Any)] (Vec Any)
     (let [(counts AppendCounts)
           (append-entries! database selected entries)]
       (response-for database selected)))))

(defn record-miss! [(selected FactRoute) (entry FactEntry)] (Vec Any)
  (if (not= "FactMissEventV1" (factentry-kind entry))
    (fail "record-miss accepts only FactMissEventV1"
          :gate-facts/not-a-miss)
    (with-writer!
     selected
     (fn [(database Any)] (Vec Any)
       (let [(counts AppendCounts)
             (append-entries! database selected [entry])]
         (response-for database selected))))))

(defn record-observation!
  [(selected FactRoute) (entry FactEntry) (miss-id String?)] (Vec Any)
  (if (not= "GatePhaseObservationV1" (factentry-kind entry))
    (fail "record-observation accepts only GatePhaseObservationV1"
          :gate-facts/not-an-observation)
    (with-writer!
     selected
     (fn [(database Any)] (Vec Any)
       (let [(known (Vec FactEntry)) (facts-for database selected)
             (known-links (Vec FallbackLink)) (links-for database selected)
             (prior-entry FactEntry?)
             (entry-with-id known (factentry-id entry))
             (prior-miss FactEntry?)
             (if (some? miss-id) (entry-with-id known miss-id) nil)
             (prior-link FallbackLink?)
             (if (some? miss-id)
               (link-with-miss-id known-links miss-id)
               nil)
             (link FallbackLink?)
             (if (some? miss-id)
               (->FallbackLink miss-id (factentry-id entry))
               nil)]
         (if (and (some? prior-entry) (not (same-entry? prior-entry entry)))
           (fail "observation id has conflicting immutable content"
                 :gate-facts/conflicting-fact)
           nil)
         (if (and (some? miss-id)
                  (or (nil? prior-miss)
                      (not= "FactMissEventV1" (factentry-kind prior-miss))))
           (fail "fallback observation has no prior durable FactMissEventV1"
                 :gate-facts/miss-not-durable)
           nil)
         (if (and (some? prior-link)
                  (not= (factentry-id entry)
                        (fallbacklink-observation-id prior-link)))
           (fail
            "FactMissEventV1 already links to another fallback observation"
            :gate-facts/conflicting-fallback-link)
           nil)
         (cond
           [(nil? miss-id)
            (let [(counts AppendCounts)
                  (append-entries! database selected [entry])]
              nil)]
           [(and (nil? prior-entry) (nil? prior-link))
            (append-propositions!
             database
             [(fact-proposition (factroute-candidate-root selected) entry)
              (fallback-proposition (factroute-candidate-root selected)
                                    (required-link link))])]
           [(and (some? prior-entry) (some? prior-link)) nil]
           [:else
            (fail "observation and fallback link are not one durable result"
                  :gate-facts/partial-fallback-result)])
         (response-for database selected))))))

(defn- requested-link [(value Any)] FallbackLink
  (if (and (vector? value)
           (= 2 (count value))
           (nonempty-string? (nth value 0))
           (nonempty-string? (nth value 1)))
    (->FallbackLink (nth value 0) (nth value 1))
    (fail "finalize miss link must be [miss-id observation-id]"
          :gate-facts/invalid-fallback-link)))

(defn- exact-link-present?
  [(links (Vec FallbackLink)) (wanted FallbackLink)] Bool
  (some?
   (some
    (fn [(link FallbackLink)] Bool
      (and (= (fallbacklink-miss-id wanted)
              (fallbacklink-miss-id link))
           (= (fallbacklink-observation-id wanted)
              (fallbacklink-observation-id link))))
    links)))

(defn finalize!
  [(selected FactRoute)
   (verdict FactEntry)
   (receipt FactEntry)
   (requested-links (Vec FallbackLink))]
  (Vec Any)
  (if (not= "GateCandidateVerdictV1" (factentry-kind verdict))
    (fail "finalize verdict must be GateCandidateVerdictV1"
          :gate-facts/not-a-verdict)
    nil)
  (if (not= "GateMaintenanceReceiptV1" (factentry-kind receipt))
    (fail "finalize receipt must be GateMaintenanceReceiptV1"
          :gate-facts/not-a-receipt)
    nil)
  (with-writer!
   selected
   (fn [(database Any)] (Vec Any)
     (let [(known (Vec FactEntry)) (facts-for database selected)
           (durable-links (Vec FallbackLink)) (links-for database selected)
           (candidate-present Bool)
           (some?
            (some
             (fn [(entry FactEntry)] Bool
               (= "GateCandidateV1" (factentry-kind entry)))
             known))
           (misses (Vec FactEntry))
           (filterv
            (fn [(entry FactEntry)] Bool
              (= "FactMissEventV1" (factentry-kind entry)))
            known)]
       (if candidate-present
         nil
         (fail "finalize requires a durable exact candidate"
               :gate-facts/candidate-root-unresolved))
       (if (not= (count misses) (count requested-links))
         (fail "maintenance receipt does not account for every durable miss"
               :gate-facts/unaccounted-miss)
         nil)
       (doseq [miss misses]
         (if (nil? (link-with-miss-id requested-links (factentry-id miss)))
           (fail "maintenance receipt omits a durable FactMissEventV1"
                 :gate-facts/unaccounted-miss)
           nil))
       (doseq [link requested-links]
         (let [(miss FactEntry?)
               (entry-with-id known (fallbacklink-miss-id link))
               (observation FactEntry?)
               (entry-with-id known (fallbacklink-observation-id link))]
           (if (or (nil? miss)
                   (not= "FactMissEventV1" (factentry-kind miss))
                   (nil? observation)
                   (not= "GatePhaseObservationV1"
                         (factentry-kind observation))
                   (not (exact-link-present? durable-links link)))
             (fail "maintenance receipt names an unproved miss fallback link"
                   :gate-facts/unproved-fallback-link)
             nil)))
       (let [(counts AppendCounts)
             (append-entries! database selected [verdict receipt])]
         (response-for database selected))))))

(defn cold-query! [(selected FactRoute) (expected-ids (Vec String))] (Vec Any)
  (let [(database Any) (cold-open! selected)
        (entries (Vec FactEntry)) (facts-for database selected)
        (candidate-present Bool)
        (some?
         (some
          (fn [(entry FactEntry)] Bool
            (= "GateCandidateV1" (factentry-kind entry)))
          entries))]
    (if candidate-present
      (response-for database selected)
      (fail "exact candidate root was not admitted in the opened Store"
            :gate-facts/candidate-root-unresolved))))

(defn- request-vector [(expected-tag String) (expected-count Int)] (Vec Any)
  (let [(line Any) (read-line)
        (value Any)
        (if (string? line) (store.rt/parse-edn line) nil)]
    (if (and (vector? value)
             (= expected-count (count value))
             (= expected-tag (nth value 0)))
      value
      (fail (str "request must be " expected-tag
                 " with " expected-count " vector fields")
            :gate-facts/invalid-request))))

(defn- route-from-request [(request (Vec Any))] FactRoute
  (if (and (string? (nth request 1))
           (string? (nth request 2))
           (string? (nth request 3)))
    (route (nth request 1) (nth request 2) (nth request 3))
    (fail "request route fields must be strings"
          :gate-facts/invalid-request)))

(defn- entry-from-value [(value Any)] FactEntry
  (if (and (vector? value)
           (= 3 (count value))
           (string? (nth value 0))
           (string? (nth value 1))
           (string? (nth value 2)))
    (fact-entry (nth value 0) (nth value 1) (nth value 2))
    (fail "fact entry must be [id kind canonical-envelope-edn]"
          :gate-facts/invalid-entry)))

(defn- entries-from-value [(value Any)] (Vec FactEntry)
  (if (vector? value)
    (mapv entry-from-value value)
    (fail "fact entries must be a vector" :gate-facts/invalid-entry)))

(defn- strings-from-value [(value Any)] (Vec String)
  (if (and (vector? value)
           (every? string? value))
    value
    (fail "expected fact ids must be a vector of strings"
          :gate-facts/invalid-request)))

(defn dispatch! [(command String)] (Vec Any)
  (cond
    [(= command "import")
     (let [(request (Vec Any))
           (request-vector "store.gate-facts/import-v1" 5)]
       (import-facts! (route-from-request request)
                      (entries-from-value (nth request 4))))]
    [(= command "record-miss")
     (let [(request (Vec Any))
           (request-vector "store.gate-facts/record-miss-v1" 5)]
       (record-miss! (route-from-request request)
                     (entry-from-value (nth request 4))))]
    [(= command "record-observation")
     (let [(request (Vec Any))
           (request-vector "store.gate-facts/record-observation-v1" 6)
           (miss-id Any) (nth request 5)]
       (if (or (nil? miss-id) (string? miss-id))
         (record-observation! (route-from-request request)
                              (entry-from-value (nth request 4))
                              miss-id)
         (fail "record-observation miss id must be a string or nil"
               :gate-facts/invalid-request)))]
    [(= command "finalize")
     (let [(request (Vec Any))
           (request-vector "store.gate-facts/finalize-v1" 7)
           (links Any) (nth request 6)]
       (if (vector? links)
         (finalize! (route-from-request request)
                    (entry-from-value (nth request 4))
                    (entry-from-value (nth request 5))
                    (mapv requested-link links))
         (fail "finalize links must be a vector"
               :gate-facts/invalid-request)))]
    [(= command "cold-query")
     (let [(request (Vec Any))
           (request-vector "store.gate-facts/cold-query-v1" 5)]
       (cold-query! (route-from-request request)
                    (strings-from-value (nth request 4))))]
    [:else
     (fail (str "unknown gate fact command: " command)
           :gate-facts/unknown-command)]))

(defn- error-code [(error Any)] String
  (let [(data Any) (ex-data error)
        (code Any) (or (get data :fram/code) (get data :type))]
    (if (keyword? code) (subs (str code) 1) "unclassified")))

(defn -main [& args] Nil
  (try
    (if (= 1 (count args))
      (println (pr-str (dispatch! (first args))))
      (fail "gate facts expects exactly one command argument"
            :gate-facts/invalid-command-line))
    (catch (error Exception)
      (println
       (pr-str
        ["store.gate-facts/error-v1"
         (error-code error)
         (.getMessage error)]))
      (System/exit 2))))
