#lang beagle/clj
;; Immutable packed checkpoint pages for the JVM Store. STORELOG is the sole
;; semantic authority; this module owns only a source-bound derived projection.
(ns store.packed
  (:require [store.rpc :as rpc]
            [store.types :as t])
  (:import [java.io ByteArrayOutputStream File RandomAccessFile]
           [java.nio ByteBuffer ByteOrder CharBuffer]
           [java.nio.channels FileChannel$MapMode]
           [java.nio.charset CodingErrorAction StandardCharsets]
           [java.nio.file Files StandardCopyOption]
           [java.security MessageDigest]
           [java.util Arrays]))

(def magic String "BEAGLEPACKEDV1")
(def manifest-magic String "BEAGLEPKMANV1")
(def format-version Int 1)
(def page-bytes Int 65536)
(def schema-id String "store/packed-checkpoint-v1+TermStoreDumpV2+TermCodecV1")
(def max-term-bytes Int 1073741824)
(def max-term-nodes Int 1048576)
(def max-term-depth Int 256)
(def digest-bytes Int 32)
(def manifest-suffix String ".manifest")
(def page-suffix String ".pages")
(def checkpoint-retention-count Int 2)

(def atom-offsets-section Int 1)
(def atom-payload-section Int 2)
(def atom-lookup-section Int 3)
(def triple-t1-section Int 4)
(def triple-t2-section Int 5)
(def triple-t3-section Int 6)
(def transaction-sequence-section Int 7)
(def transaction-first-operation-section Int 8)
(def transaction-operation-count-section Int 9)
(def operation-sequence-section Int 10)
(def operation-ordinal-section Int 11)
(def operation-action-section Int 12)
(def operation-triple-section Int 13)
(def withdrawal-target-section Int 14)
(def active-handle-section Int 15)
(def active-offset-section Int 16)
(def active-count-section Int 17)
(def active-run-section Int 18)
(def spo-section Int 19)
(def pos-section Int 20)
(def osp-section Int 21)
(def section-count Int 21)

(defrecord CheckpointSource
  [space-id String
   revision Int
   schema String
   log-valid-bytes Int
   log-prefix-sha256 String])

(defrecord CheckpointManifest
  [path String
   component String
   space-id String
   revision Int
   next-sequence Int
   schema String
   log-valid-bytes Int
   log-prefix-sha256 String
   page-sha256 String
   atom-count Int
   triple-count Int
   transaction-count Int
   operation-count Int
   active-count Int
   active-run-count Int
   mapped-bytes Int])

(defrecord Section
  [id Int
   width Int
   offset Int
   bytes Any])

(defrecord PackedPrefix
  [manifest CheckpointManifest
   buffers Any])

(defn- fail!
  [code Keyword
   message String] Any
  (throw (ex-info message {:type code :store/code code})))

(defn- valid-fingerprint? [value String] Bool
  (some? (re-matches #"[0-9a-f]{64}" value)))

(defn checkpoint-source!
  [space-id String
   revision Int
   log-valid-bytes Int
   log-prefix-sha256 String] CheckpointSource
  (if (and (pos? (count space-id))
           (and (>= revision 0)
                (and (>= log-valid-bytes 0)
                     (valid-fingerprint? log-prefix-sha256))))
    (->CheckpointSource space-id revision schema-id log-valid-bytes
                        log-prefix-sha256)
    (fail! :invalid-packed-source
           "packed Store source requires SpaceId, revision, byte position, and sha256")))

(defn- atom-value! [row t/AtomRow] Any
  (let [kind Keyword (t/atomrow-kind row)]
    (cond
      [(= kind :string) (t/atomrow-string-value row)]
      [(= kind :int) (t/atomrow-int-value row)]
      [(= kind :float) (t/atomrow-float-value row)]
      [(= kind :bool) (t/atomrow-bool-value row)]
      [(= kind :keyword) (t/atomrow-keyword-value row)]
      [(= kind :instant) (t/atomrow-instant-value row)]
      [:else (fail! :invalid-packed-checkpoint
                    "packed Store AtomRow has an unknown kind")])))

(defn- atom-row! [value Any] t/AtomRow
  (cond
    [(string? value) (t/->AtomRow :string value nil nil nil nil nil)]
    [(integer? value) (t/->AtomRow :int nil value nil nil nil nil)]
    [(and (number? value) (not (integer? value)))
     (t/->AtomRow :float nil nil (double value) nil nil nil)]
    [(boolean? value) (t/->AtomRow :bool nil nil nil value nil nil)]
    [(keyword? value) (t/->AtomRow :keyword nil nil nil nil value nil)]
    [(t/instant? value) (t/->AtomRow :instant nil nil nil nil nil value)]
    [:else (fail! :invalid-packed-checkpoint
                  "packed Store atom payload decoded outside Atom")]))

(defn- encode-term [value Any] Any
  (let [out ByteArrayOutputStream (ByteArrayOutputStream.)]
    (rpc/write-term-codec-v1! out value max-term-bytes max-term-nodes
                              max-term-depth)
    (.toByteArray out)))

(defn term-byte-count! [value Any] Int
  (alength (encode-term value)))

(defn- hex [bytes Any] String
  (apply str
         (map (fn [value Any] String
                (format "%02x" (bit-and 255 (int value))))
              bytes)))

(defn- sha256-bytes [bytes Any] Any
  (.digest (MessageDigest/getInstance "SHA-256") bytes))

(defn- sha256-file [path String] String
  (let [digest MessageDigest (MessageDigest/getInstance "SHA-256")
        chunk (Arr I8) (byte-array page-bytes)]
    (with-open [input (RandomAccessFile. path "r")]
      (loop [read-count Int (.read input chunk 0 page-bytes)]
        (if (< read-count 0)
          nil
          (do
            (.update digest chunk 0 read-count)
            (recur (.read input chunk 0 page-bytes))))))
    (hex (.digest digest))))

(defn- hash64 [bytes Any] Int
  (.getLong (doto (ByteBuffer/wrap (sha256-bytes bytes))
              (.order ByteOrder/LITTLE_ENDIAN))))

(defn- align-page [value Int] Int
  (* page-bytes (quot (+ value (dec page-bytes)) page-bytes)))

(defn- checked-i32! [value Int] Int
  (if (and (>= value -2147483648) (<= value 2147483647))
    value
    (fail! :packed-capacity-exceeded
           "packed Store term identifier exceeds signed 32-bit capacity")))

(defn- bytes-buffer [size Int] ByteBuffer
  (doto (ByteBuffer/allocate size) (.order ByteOrder/LITTLE_ENDIAN)))

(defn- buffer-bytes [buffer ByteBuffer] Any
  (let [bytes (Arr I8) (byte-array (.limit buffer))
        view ByteBuffer (.duplicate buffer)]
    (.position view 0)
    (.get view bytes)
    bytes))

(defn- long-column [values Any] Any
  (let [buffer ByteBuffer (bytes-buffer (* 8 (count values)))]
    (doseq [value values] (.putLong buffer value))
    (buffer-bytes buffer)))

(defn- int-column! [values Any] Any
  (let [buffer ByteBuffer (bytes-buffer (* 4 (count values)))]
    (doseq [value values] (.putInt buffer (int (checked-i32! value))))
    (buffer-bytes buffer)))

(defn- action-code! [action Keyword] Int
  (cond
    [(= action t/assert-action) 1]
    [(= action t/retract-action) 2]
    [:else (fail! :invalid-packed-checkpoint
                  "packed Store operation action is invalid")]))

(defn- code-action! [value Int] Keyword
  (cond
    [(= value 1) t/assert-action]
    [(= value 2) t/retract-action]
    [:else (fail! :invalid-packed-checkpoint
                  "packed Store operation action code is invalid")]))

(defn- prefix-count
  [prefix Any
   section Keyword] Int
  (if (nil? prefix)
    0
    (let [manifest CheckpointManifest (packedprefix-manifest prefix)]
      (cond
        [(= section :atoms) (checkpointmanifest-atom-count manifest)]
        [(= section :triples) (checkpointmanifest-triple-count manifest)]
        [(= section :transactions) (checkpointmanifest-transaction-count manifest)]
        [(= section :operations) (checkpointmanifest-operation-count manifest)]
        [:else 0]))))

(declare atom-row-at! triple-row-at! transaction-row-at! operation-row-at!)

(defn- merged-atom-count
  [prefix Any
   tail t/TermStoreDump] Int
  (+ (prefix-count prefix :atoms) (count (t/termstoredump-atoms tail))))

(defn- merged-triple-count
  [prefix Any
   tail t/TermStoreDump] Int
  (+ (prefix-count prefix :triples) (count (t/termstoredump-triples tail))))

(defn- merged-transaction-count
  [prefix Any
   tail t/TermStoreDump] Int
  (+ (prefix-count prefix :transactions)
     (count (t/termstoredump-transactions tail))))

(defn- merged-operation-count
  [prefix Any
   tail t/TermStoreDump] Int
  (+ (prefix-count prefix :operations)
     (count (t/termstoredump-operations tail))))

(defn- merged-atom-at!
  [prefix Any
   tail t/TermStoreDump
   position Int] t/AtomRow
  (let [base Int (prefix-count prefix :atoms)]
    (if (< position base)
      (atom-row-at! prefix position)
      (nth (t/termstoredump-atoms tail) (- position base)))))

(defn- merged-triple-at!
  [prefix Any
   tail t/TermStoreDump
   position Int] t/TripleRow
  (let [base Int (prefix-count prefix :triples)]
    (if (< position base)
      (triple-row-at! prefix position)
      (nth (t/termstoredump-triples tail) (- position base)))))

(defn- merged-transaction-at!
  [prefix Any
   tail t/TermStoreDump
   position Int] t/TransactionRow
  (let [base Int (prefix-count prefix :transactions)]
    (if (< position base)
      (transaction-row-at! prefix position)
      (nth (t/termstoredump-transactions tail) (- position base)))))

(defn- merged-operation-at!
  [prefix Any
   tail t/TermStoreDump
   position Int] t/OperationRow
  (let [base Int (prefix-count prefix :operations)]
    (if (< position base)
      (operation-row-at! prefix position)
      (nth (t/termstoredump-operations tail) (- position base)))))

(defn- atom-sections!
  [prefix Any
   tail t/TermStoreDump] Any
  (let [total Int (merged-atom-count prefix tail)
        offsets (Arr Int) (long-array (+ total 1))
        payload ByteArrayOutputStream (ByteArrayOutputStream.)
        lookups Any (loop [position Int 0
                           entries Any []]
                      (if (>= position total)
                        entries
                        (let [bytes Any (encode-term
                                         (atom-value!
                                          (merged-atom-at! prefix tail position)))]
                          (aset-long offsets position (.size payload))
                          (.write payload bytes)
                          (recur (+ position 1)
                                 (conj entries [(hash64 bytes) position])))))]
    (aset-long offsets total (.size payload))
    (let [lookup-buffer ByteBuffer (bytes-buffer (* total 12))]
      (doseq [entry (sort-by (fn [entry Any] Any [(nth entry 0) (nth entry 1)])
                             lookups)]
        (.putLong lookup-buffer (nth entry 0))
        (.putInt lookup-buffer (int (nth entry 1))))
      {:offsets (long-column offsets)
       :payload (.toByteArray payload)
       :lookup (buffer-bytes lookup-buffer)})))

(defn- triple-columns!
  [prefix Any
   tail t/TermStoreDump] Any
  (let [total Int (merged-triple-count prefix tail)
        t1 (Arr I32) (int-array total)
        t2 (Arr I32) (int-array total)
        t3 (Arr I32) (int-array total)]
    (loop [position Int 0]
      (if (>= position total)
        nil
        (let [row t/TripleRow (merged-triple-at! prefix tail position)]
          (aset-int t1 position (int (checked-i32! (t/triplerow-t1 row))))
          (aset-int t2 position (int (checked-i32! (t/triplerow-t2 row))))
          (aset-int t3 position (int (checked-i32! (t/triplerow-t3 row))))
          (recur (+ position 1)))))
    {:t1 t1 :t2 t2 :t3 t3}))

(defn- history-columns!
  [prefix Any
   tail t/TermStoreDump] Any
  (let [transactions Int (merged-transaction-count prefix tail)
        operations Int (merged-operation-count prefix tail)
        tx-seq (Arr Int) (long-array transactions)
        tx-first (Arr Int) (long-array transactions)
        tx-count (Arr I32) (int-array transactions)
        op-seq (Arr Int) (long-array operations)
        op-ordinal (Arr I32) (int-array operations)
        op-action (Arr I8) (byte-array operations)
        op-triple (Arr I32) (int-array operations)]
    (loop [position Int 0]
      (if (>= position transactions)
        nil
        (let [row t/TransactionRow (merged-transaction-at! prefix tail position)]
          (aset-long tx-seq position (t/transactionrow-sequence row))
          (aset-long tx-first position (t/transactionrow-first-operation row))
          (aset-int tx-count position
                    (int (checked-i32! (t/transactionrow-operation-count row))))
          (recur (+ position 1)))))
    (loop [position Int 0]
      (if (>= position operations)
        nil
        (let [row t/OperationRow (merged-operation-at! prefix tail position)]
          (aset-long op-seq position (t/operationrow-tx-sequence row))
          (aset-int op-ordinal position
                    (int (checked-i32! (t/operationrow-ordinal row))))
          (aset-byte op-action position
                     (byte (action-code! (t/operationrow-action row))))
          (aset-int op-triple position
                    (int (checked-i32! (t/operationrow-triple-handle row))))
          (recur (+ position 1)))))
    {:tx-seq tx-seq :tx-first tx-first :tx-count tx-count
     :op-seq op-seq :op-ordinal op-ordinal :op-action op-action
     :op-triple op-triple}))

(defn- active-columns! [history Any] Any
  (let [op-seq Any (:op-seq history)
        op-action Any (:op-action history)
        op-triple Any (:op-triple history)
        total Int (alength op-action)
        derived Any (loop [position Int 0
                           active Any {}
                           withdrawals Any []]
                      (if (>= position total)
            {:active active :withdrawals withdrawals}
            (let [handle Int (aget op-triple position)
                  positions Any (get active handle [])
                  action Int (bit-and 255 (int (aget op-action position)))]
              (if (= action 1)
                (recur (+ position 1)
                       (assoc active handle (conj positions position))
                       (conj withdrawals -1))
                (if (empty? positions)
                  (recur (+ position 1) active (conj withdrawals -1))
                  (recur (+ position 1)
                         (assoc active handle (pop positions))
                         (conj withdrawals (peek positions))))))))
        entries Any (sort-by first
                             (filter (fn [entry Any] Bool
                                       (pos? (count (second entry))))
                                     (:active derived)))
        handles (Arr I32) (int-array (count entries))
        offsets (Arr Int) (long-array (count entries))
        counts (Arr I32) (int-array (count entries))
        run-count Int (reduce + (map (fn [entry Any] Int
                                      (count (second entry))) entries))
        runs (Arr Int) (long-array run-count)]
    (loop [entry-position Int 0
           run-position Int 0]
      (if (>= entry-position (count entries))
        nil
        (let [entry Any (nth entries entry-position)
              handle Int (first entry)
              positions Any (second entry)]
          (aset-int handles entry-position (int (checked-i32! handle)))
          (aset-long offsets entry-position run-position)
          (aset-int counts entry-position (int (checked-i32! (count positions))))
          (loop [source-position Int 0]
            (if (>= source-position (count positions))
              nil
              (do
                (aset-long runs (+ run-position source-position)
                           (nth positions source-position))
                (recur (+ source-position 1)))))
          (recur (+ entry-position 1) (+ run-position (count positions))))))
    {:withdrawals (long-column (:withdrawals derived))
     :handles handles :offsets offsets :counts counts :runs runs
     :active-count (count entries) :run-count run-count}))

(defn- index-bytes!
  [prefix Any
   tail t/TermStoreDump
   order Keyword] Any
  (let [total Int (merged-triple-count prefix tail)
        entries Any (loop [position Int 0
                           collected Any []]
                      (if (>= position total)
            collected
            (let [row t/TripleRow (merged-triple-at! prefix tail position)
                  a Int (t/triplerow-t1 row)
                  b Int (t/triplerow-t2 row)
                  c Int (t/triplerow-t3 row)
                  key Any (cond
                    [(= order :spo) [a b c position]]
                    [(= order :pos) [b c a position]]
                    [:else [c a b position]])]
              (recur (+ position 1)
                     (conj collected [key position row])))))
        ordered Any (sort-by first entries)
        buffer ByteBuffer (bytes-buffer (* total 16))]
    (doseq [entry ordered]
      (let [position Int (second entry)
            row t/TripleRow (nth entry 2)
            a Int (t/triplerow-t1 row)
            b Int (t/triplerow-t2 row)
            c Int (t/triplerow-t3 row)]
        (cond
          [(= order :spo)
           (do (.putInt buffer (int a)) (.putInt buffer (int b))
               (.putInt buffer (int c)))]
          [(= order :pos)
           (do (.putInt buffer (int b)) (.putInt buffer (int c))
               (.putInt buffer (int a)))]
          [:else
           (do (.putInt buffer (int c)) (.putInt buffer (int a))
               (.putInt buffer (int b)))])
        (.putInt buffer (int position))))
    (buffer-bytes buffer)))

(defn- section
  [id Int
   width Int
   bytes Any] Section
  (->Section id width 0 bytes))

(defn- place-sections [sections Any] Any
  (loop [remaining Any sections
         offset Int page-bytes
         placed Any []]
    (if (empty? remaining)
      placed
      (let [current Section (first remaining)
            aligned Int (align-page offset)
            bytes Any (section-bytes current)]
        (recur (next remaining)
               (+ aligned (alength bytes))
               (conj placed (->Section (section-id current)
                                       (section-width current)
                                       aligned bytes)))))))

(defn- page-header
  [sections Any
   atoms Int
   triples Int
   transactions Int
   operations Int
   next-sequence Int
   active-count Int
   active-run-count Int] Any
  (let [buffer ByteBuffer (bytes-buffer page-bytes)
        magic-bytes Any (.getBytes magic StandardCharsets/UTF_8)]
    (.put buffer magic-bytes)
    (.position buffer 16)
    (.putInt buffer format-version)
    (.putInt buffer page-bytes)
    (.putInt buffer section-count)
    (.putInt buffer 0)
    (.putLong buffer atoms)
    (.putLong buffer triples)
    (.putLong buffer transactions)
    (.putLong buffer operations)
    (.putLong buffer next-sequence)
    (.putLong buffer active-count)
    (.putLong buffer active-run-count)
    (.position buffer 128)
    (doseq [entry sections]
      (.putInt buffer (section-id entry))
      (.putInt buffer (section-width entry))
      (.putLong buffer (section-offset entry))
      (.putLong buffer (alength (section-bytes entry))))
    (buffer-bytes buffer)))

(defn- zero-fill!
  [file RandomAccessFile
   amount Int] Nil
  (let [zeroes (Arr I8) (byte-array page-bytes)]
    (loop [remaining Int amount]
      (if (<= remaining 0)
        nil
        (let [chunk Int (min remaining page-bytes)]
          (.write file zeroes 0 chunk)
          (recur (- remaining chunk)))))))

(defn- write-page-file!
  [path String
   header Any
   sections Any] Int
  (with-open [file (RandomAccessFile. path "rw")]
    (.setLength file 0)
    (.write file header 0 (alength header))
    (loop [remaining Any sections
           position Int page-bytes]
      (if (empty? remaining)
        nil
        (let [entry Section (first remaining)
              offset Int (section-offset entry)
              bytes Any (section-bytes entry)]
          (zero-fill! file (- offset position))
          (.write file bytes 0 (alength bytes))
          (recur (next remaining) (+ offset (alength bytes))))))
    (.force (.getChannel file) true)
    (.length file)))

(defn- write-u8!
  [out Any
   value Int] Nil
  (.write out (int (bit-and 255 value)))
  nil)

(defn- write-u32-le!
  [out Any
   value Int] Nil
  (loop [offset Int 0]
    (if (>= offset 4)
      nil
      (do
        (write-u8! out (unsigned-bit-shift-right value (* offset 8)))
        (recur (+ offset 1))))))

(defn- write-i64-le!
  [out Any
   value Int] Nil
  (loop [offset Int 0]
    (if (>= offset 8)
      nil
      (do
        (write-u8! out (unsigned-bit-shift-right value (* offset 8)))
        (recur (+ offset 1))))))

(defn- strict-utf8 [value String] Any
  (let [encoder Any (doto (.newEncoder StandardCharsets/UTF_8)
                      (.onMalformedInput CodingErrorAction/REPORT)
                      (.onUnmappableCharacter CodingErrorAction/REPORT))
        buffer ByteBuffer (.encode encoder (CharBuffer/wrap value))
        bytes (Arr I8) (byte-array (.remaining buffer))]
    (.get buffer bytes)
    bytes))

(defn- write-text!
  [out Any
   value String] Nil
  (let [bytes Any (strict-utf8 value)]
    (write-u32-le! out (alength bytes))
    (.write out bytes)
    nil))

(declare read-manifest! hex-bytes! prune-checkpoints!)

(defn- manifest-bytes! [manifest CheckpointManifest] Any
  (let [out ByteArrayOutputStream (ByteArrayOutputStream.)]
    (.write out (.getBytes manifest-magic StandardCharsets/UTF_8))
    (loop [position Int (count manifest-magic)]
      (if (>= position 16)
        nil
        (do (write-u8! out 0) (recur (+ position 1)))))
    (write-u32-le! out format-version)
    (write-u32-le! out page-bytes)
    (write-i64-le! out (checkpointmanifest-revision manifest))
    (write-i64-le! out (checkpointmanifest-next-sequence manifest))
    (write-i64-le! out (checkpointmanifest-log-valid-bytes manifest))
    (write-i64-le! out (checkpointmanifest-atom-count manifest))
    (write-i64-le! out (checkpointmanifest-triple-count manifest))
    (write-i64-le! out (checkpointmanifest-transaction-count manifest))
    (write-i64-le! out (checkpointmanifest-operation-count manifest))
    (write-i64-le! out (checkpointmanifest-active-count manifest))
    (write-i64-le! out (checkpointmanifest-active-run-count manifest))
    (write-i64-le! out (checkpointmanifest-mapped-bytes manifest))
    (.write out (hex-bytes! (checkpointmanifest-log-prefix-sha256 manifest)))
    (.write out (hex-bytes! (checkpointmanifest-page-sha256 manifest)))
    (write-text! out (checkpointmanifest-space-id manifest))
    (write-text! out (checkpointmanifest-schema manifest))
    (write-text! out (checkpointmanifest-component manifest))
    (let [body Any (.toByteArray out)]
      (.write out (sha256-bytes body))
      (.toByteArray out))))

(defn- hex-value! [value Int] Int
  (cond
    [(and (>= value 48) (<= value 57)) (- value 48)]
    [(and (>= value 97) (<= value 102)) (+ 10 (- value 97))]
    [:else (fail! :invalid-packed-manifest
                  "packed Store manifest digest is not lowercase hexadecimal")]))

(defn- hex-bytes! [value String] Any
  (if (not (valid-fingerprint? value))
    (fail! :invalid-packed-manifest
           "packed Store manifest digest is invalid")
    (let [bytes (Arr I8) (byte-array digest-bytes)]
      (loop [position Int 0]
        (if (>= position digest-bytes)
          bytes
          (let [left Int (int (.charAt value (* position 2)))
                right Int (int (.charAt value (+ (* position 2) 1)))]
            (aset-byte bytes position
                       (unchecked-byte
                        (+ (* 16 (hex-value! left)) (hex-value! right))))
            (recur (+ position 1))))))))

(defn- atomic-move!
  [source String
   target String] Nil
  (Files/move (.toPath (File. source)) (.toPath (File. target))
              (into-array StandardCopyOption
                          [StandardCopyOption/ATOMIC_MOVE
                           StandardCopyOption/REPLACE_EXISTING]))
  nil)

(defn- write-manifest-last!
  [path String
   manifest CheckpointManifest] Nil
  (let [temporary String (str path ".tmp")
        bytes Any (manifest-bytes! manifest)]
    (with-open [file (RandomAccessFile. temporary "rw")]
      (.setLength file 0)
      (.write file bytes 0 (alength bytes))
      (.force (.getChannel file) true))
    (atomic-move! temporary path)))

(defn- ensure-directory! [path String] Nil
  (Files/createDirectories (.toPath (File. path))
                           (make-array java.nio.file.attribute.FileAttribute 0))
  nil)

(defn write-checkpoint!
  [prefix Any
   tail t/TermStoreDump
   directory String
   source CheckpointSource] CheckpointManifest
  (if (not (= (checkpointsource-space-id source)
              (t/termstoredump-space-id tail)))
    (fail! :packed-space-mismatch
           "packed Store source and tail belong to different spaces")
    nil)
  (if (not (= schema-id (checkpointsource-schema source)))
    (fail! :packed-schema-mismatch
           "packed Store source uses another schema")
    nil)
  (let [atoms Int (merged-atom-count prefix tail)
        triples Int (merged-triple-count prefix tail)
        transactions Int (merged-transaction-count prefix tail)
        operations Int (merged-operation-count prefix tail)]
    (if (or (> atoms 1073741823) (> triples 1073741823))
      (fail! :packed-capacity-exceeded
             "packed Store term table exceeds the 32-bit identifier envelope")
      nil)
    (ensure-directory! directory)
    (let [atom-data Any (atom-sections! prefix tail)
          triple-data Any (triple-columns! prefix tail)
          history Any (history-columns! prefix tail)
          active Any (active-columns! history)
          sections Any (place-sections
           [(section atom-offsets-section 8 (:offsets atom-data))
            (section atom-payload-section 0 (:payload atom-data))
            (section atom-lookup-section 12 (:lookup atom-data))
            (section triple-t1-section 4 (int-column! (:t1 triple-data)))
            (section triple-t2-section 4 (int-column! (:t2 triple-data)))
            (section triple-t3-section 4 (int-column! (:t3 triple-data)))
            (section transaction-sequence-section 8
                     (long-column (:tx-seq history)))
            (section transaction-first-operation-section 8
                     (long-column (:tx-first history)))
            (section transaction-operation-count-section 4
                     (int-column! (:tx-count history)))
            (section operation-sequence-section 8
                     (long-column (:op-seq history)))
            (section operation-ordinal-section 4
                     (int-column! (:op-ordinal history)))
            (section operation-action-section 1 (:op-action history))
            (section operation-triple-section 4
                     (int-column! (:op-triple history)))
            (section withdrawal-target-section 8 (:withdrawals active))
            (section active-handle-section 4
                     (int-column! (:handles active)))
            (section active-offset-section 8
                     (long-column (:offsets active)))
            (section active-count-section 4
                     (int-column! (:counts active)))
            (section active-run-section 8
                     (long-column (:runs active)))
            (section spo-section 16 (index-bytes! prefix tail :spo))
            (section pos-section 16 (index-bytes! prefix tail :pos))
            (section osp-section 16 (index-bytes! prefix tail :osp))])
          header Any (page-header sections atoms triples transactions operations
                                  (t/termstoredump-next-sequence tail)
                                  (:active-count active) (:run-count active))
          revision Int (checkpointsource-revision source)
          stem String (format "checkpoint-%019d" revision)
          temporary String (str directory "/." stem ".pages.tmp")
          mapped-bytes Int (write-page-file! temporary header sections)
          page-sha String (sha256-file temporary)
          component String (str stem "-" (subs page-sha 0 16) page-suffix)
          final-page String (str directory "/" component)
          manifest-path String (str directory "/" stem manifest-suffix)
          manifest CheckpointManifest (->CheckpointManifest
           manifest-path component (checkpointsource-space-id source) revision
           (t/termstoredump-next-sequence tail) schema-id
           (checkpointsource-log-valid-bytes source)
           (checkpointsource-log-prefix-sha256 source) page-sha atoms triples
           transactions operations (:active-count active) (:run-count active)
           mapped-bytes)]
      (atomic-move! temporary final-page)
      (write-manifest-last! manifest-path manifest)
      (prune-checkpoints! directory)
      manifest)))

(defn- ensure-remaining!
  [buffer ByteBuffer
   amount Int
   context String] Nil
  (if (and (>= amount 0) (>= (.remaining buffer) amount))
    nil
    (fail! :invalid-packed-manifest
           (str "packed Store manifest is truncated in " context))))

(defn- read-u32!
  [buffer ByteBuffer
   context String] Int
  (ensure-remaining! buffer 4 context)
  (Integer/toUnsignedLong (.getInt buffer)))

(defn- read-i64!
  [buffer ByteBuffer
   context String] Int
  (ensure-remaining! buffer 8 context)
  (.getLong buffer))

(defn- read-fixed!
  [buffer ByteBuffer
   amount Int
   context String] Any
  (ensure-remaining! buffer amount context)
  (let [bytes (Arr I8) (byte-array amount)]
    (.get buffer bytes)
    bytes))

(defn- read-text!
  [buffer ByteBuffer
   context String] String
  (let [amount Int (read-u32! buffer context)]
    (if (> amount 1048576)
      (fail! :invalid-packed-manifest
             "packed Store manifest text exceeds its bound")
      (let [bytes Any (read-fixed! buffer amount context)
            decoder Any (doto (.newDecoder StandardCharsets/UTF_8)
                          (.onMalformedInput CodingErrorAction/REPORT)
                          (.onUnmappableCharacter CodingErrorAction/REPORT))]
        (str (.decode decoder (ByteBuffer/wrap bytes)))))))

(defn- magic-valid?
  [bytes Any
   expected String] Bool
  (= expected (String. bytes StandardCharsets/UTF_8)))

(defn- manifest-filename-revision! [path String] Int
  (let [name String (.getName (File. path))
        matched Any (re-matches #"checkpoint-([0-9]{19})\.manifest" name)]
    (if (nil? matched)
      (fail! :invalid-packed-manifest
             "packed Store manifest filename is invalid")
      (try
        (Long/parseLong (nth matched 1))
        (catch Throwable _error
          (fail! :invalid-packed-manifest
                 "packed Store manifest filename revision is invalid"))))))

(defn read-manifest! [path String] CheckpointManifest
  (let [filename-revision Int (manifest-filename-revision! path)
        bytes Any (Files/readAllBytes (.toPath (File. path)))
        total Int (alength bytes)]
    (if (< total (+ 160 digest-bytes))
      (fail! :invalid-packed-manifest "packed Store manifest is too short")
      nil)
    (let [body-length Int (- total digest-bytes)
          body Any (Arrays/copyOfRange bytes 0 body-length)
          stored Any (Arrays/copyOfRange bytes body-length total)]
      (if (not (Arrays/equals stored (sha256-bytes body)))
        (fail! :invalid-packed-manifest
               "packed Store manifest checksum does not match")
        nil)
      (let [buffer ByteBuffer (doto (ByteBuffer/wrap body)
                                (.order ByteOrder/LITTLE_ENDIAN))
            magic-bytes Any (read-fixed! buffer (count manifest-magic)
                                         "magic")]
        (if (not (magic-valid? magic-bytes manifest-magic))
          (fail! :invalid-packed-manifest
                 "packed Store manifest magic does not match")
          nil)
        (ensure-remaining! buffer (- 16 (count manifest-magic)) "magic padding")
        (.position buffer 16)
        (let [version Int (read-u32! buffer "version")
              page-size Int (read-u32! buffer "page size")
              revision Int (read-i64! buffer "revision")
              next-sequence Int (read-i64! buffer "next sequence")
              valid-bytes Int (read-i64! buffer "log byte position")
              atoms Int (read-i64! buffer "atom count")
              triples Int (read-i64! buffer "triple count")
              transactions Int (read-i64! buffer "transaction count")
              operations Int (read-i64! buffer "operation count")
              active-count Int (read-i64! buffer "active count")
              active-runs Int (read-i64! buffer "active run count")
              mapped-bytes Int (read-i64! buffer "mapped byte count")
              prefix-sha String (hex (read-fixed! buffer digest-bytes
                                                  "log prefix checksum"))
              page-sha String (hex (read-fixed! buffer digest-bytes
                                                "page checksum"))
              space String (read-text! buffer "SpaceId")
              schema String (read-text! buffer "schema")
              component String (read-text! buffer "component")]
          (if (not (= 0 (.remaining buffer)))
            (fail! :invalid-packed-manifest
                   "packed Store manifest has trailing bytes")
            nil)
          (if (not (= filename-revision revision))
            (fail! :invalid-packed-manifest
                   "packed Store manifest filename revision does not match its body")
            nil)
          (if (not (and (= version format-version)
                        (and (= page-size page-bytes)
                             (and (= schema schema-id)
                                  (and (>= revision 0)
                                       (and (= next-sequence (+ revision 1))
                                            (and (>= valid-bytes 0)
                                                 (and (>= atoms 0)
                                                      (and (>= triples 0)
                                                           (and (>= transactions 0)
                                                                (and (>= operations 0)
                                                                     (and (>= active-count 0)
                                                                          (and (>= active-runs 0)
                                                                               (>= mapped-bytes page-bytes))))))))))))))
            (fail! :invalid-packed-manifest
                   "packed Store manifest fields are inconsistent")
            nil)
          (if (not (and (pos? (count space))
                        (and (valid-fingerprint? prefix-sha)
                             (and (valid-fingerprint? page-sha)
                                  (some? (re-matches #"checkpoint-[0-9]{19}-[0-9a-f]{16}\.pages"
                                                     component))))))
            (fail! :invalid-packed-manifest
                   "packed Store manifest identity is invalid")
            nil)
          (->CheckpointManifest path component space revision next-sequence
                                schema valid-bytes prefix-sha page-sha atoms
                                triples transactions operations active-count
                                active-runs mapped-bytes))))))

(defn candidate-manifests [directory String] Any
  (let [folder File (File. directory)
        files Any (if (.isDirectory folder)
                    (or (.listFiles folder) (make-array File 0))
                    (make-array File 0))]
    (mapv (fn [file File] String (.getPath file))
          (sort-by (fn [file File] String (.getName file))
                   (fn
                     [left Any
                      right Any] Int
                     (compare right left))
                   (filter (fn [file File] Bool
                             (some? (re-matches #"checkpoint-[0-9]{19}\.manifest"
                                                (.getName file))))
                           files)))))

(defn- valid-manifests! [paths Any] Any
  (loop [remaining Any (seq paths)
         valid Any []]
    (if (nil? remaining)
      valid
      (let [manifest Any (try
            (read-manifest! (first remaining))
            (catch Throwable _error nil))]
        (recur (next remaining)
               (if (nil? manifest) valid (conj valid manifest)))))))

(defn- manifest-identities [manifests Any] Any
  (loop [remaining Any (seq manifests)
         paths Any #{}
         components Any #{}]
    (if (nil? remaining)
      {:paths paths :components components}
      (let [manifest CheckpointManifest (first remaining)]
        (recur (next remaining)
               (conj paths (checkpointmanifest-path manifest))
               (conj components (checkpointmanifest-component manifest)))))))

(defn- prune-checkpoints! [directory String] Nil
  (let [folder File (File. directory)
        candidates Any (candidate-manifests directory)
        retained Any (vec (take checkpoint-retention-count
                                (valid-manifests! candidates)))
        identities Any (manifest-identities retained)
        paths Any (:paths identities)
        components Any (:components identities)]
    (doseq [manifest-path candidates]
      (if (not (contains? paths manifest-path))
        (Files/deleteIfExists (.toPath (File. manifest-path)))
        nil))
    (doseq [file (filterv
                  (fn [candidate File] Bool
                    (some? (re-matches
                            #"checkpoint-[0-9]{19}-[0-9a-f]{16}\.pages"
                            (.getName candidate))))
                  (vec (or (.listFiles folder) (make-array File 0))))]
      (if (not (contains? components (.getName file)))
        (Files/deleteIfExists (.toPath file))
        nil))
    nil))

(defn manifest-source! [manifest CheckpointManifest] CheckpointSource
  (checkpoint-source! (checkpointmanifest-space-id manifest)
                      (checkpointmanifest-revision manifest)
                      (checkpointmanifest-log-valid-bytes manifest)
                      (checkpointmanifest-log-prefix-sha256 manifest)))

(defn- buffer
  [prefix PackedPrefix
   id Int] ByteBuffer
  (get (packedprefix-buffers prefix) id))

(defn- section-long
  [prefix PackedPrefix
   id Int
   position Int] Int
  (.getLong (buffer prefix id) (* position 8)))

(defn- section-int
  [prefix PackedPrefix
   id Int
   position Int] Int
  (.getInt (buffer prefix id) (* position 4)))

(defn- section-byte
  [prefix PackedPrefix
   id Int
   position Int] Int
  (bit-and 255 (int (.get (buffer prefix id) position))))

(defn- map-section
  [file String
   offset Int
   length Int] ByteBuffer
  (if (= length 0)
    (bytes-buffer 0)
    (with-open [random (RandomAccessFile. file "r")]
      (let [channel Any (.getChannel random)
            mapped Any (.map channel FileChannel$MapMode/READ_ONLY offset length)]
        (.order mapped ByteOrder/LITTLE_ENDIAN)
        mapped))))

(defn- read-page-table!
  [path String
   manifest CheckpointManifest] Any
  (let [file File (File. path)
        length Int (.length file)]
    (if (not (= length (checkpointmanifest-mapped-bytes manifest)))
      (fail! :invalid-packed-checkpoint
             "packed Store page length does not match its manifest")
      nil)
    (with-open [random (RandomAccessFile. file "r")]
      (let [header (Arr I8) (byte-array page-bytes)]
        (.readFully random header)
        (let [view ByteBuffer (doto (ByteBuffer/wrap header)
                                (.order ByteOrder/LITTLE_ENDIAN))
              stored-magic Any (read-fixed! view (count magic) "page magic")]
          (if (not (magic-valid? stored-magic magic))
            (fail! :invalid-packed-checkpoint
                   "packed Store page magic does not match")
            nil)
          (.position view 16)
          (let [version Int (.getInt view)
                page-size Int (.getInt view)
                count-value Int (.getInt view)
                _reserved Int (.getInt view)
                atoms Int (.getLong view)
                triples Int (.getLong view)
                transactions Int (.getLong view)
                operations Int (.getLong view)
                next-sequence Int (.getLong view)
                active-count Int (.getLong view)
                active-runs Int (.getLong view)]
            (if (not (and (= version format-version)
                          (and (= page-size page-bytes)
                               (and (= count-value section-count)
                                    (and (= atoms (checkpointmanifest-atom-count manifest))
                                         (and (= triples (checkpointmanifest-triple-count manifest))
                                              (and (= transactions (checkpointmanifest-transaction-count manifest))
                                                   (and (= operations (checkpointmanifest-operation-count manifest))
                                                        (and (= next-sequence (checkpointmanifest-next-sequence manifest))
                                                             (and (= active-count (checkpointmanifest-active-count manifest))
                                                                  (= active-runs (checkpointmanifest-active-run-count manifest))))))))))))
              (fail! :invalid-packed-checkpoint
                     "packed Store page header does not match its manifest")
              nil)
            (.position view 128)
            (loop [position Int 0
                   prior-end Int page-bytes
                   table Any {}]
              (if (>= position section-count)
                table
                (let [id Int (.getInt view)
                      width Int (.getInt view)
                      offset Int (.getLong view)
                      section-length Int (.getLong view)
                      end Int (+ offset section-length)]
                  (if (not (and (= id (+ position 1))
                                (and (>= width 0)
                                     (and (= offset (align-page offset))
                                          (and (>= offset (align-page prior-end))
                                               (and (>= section-length 0)
                                                    (<= end length)))))))
                    (fail! :invalid-packed-checkpoint
                           "packed Store page section table is invalid")
                    (recur (+ position 1) end
                           (assoc table id [offset section-length]))))))))))))

(defn- expected-section-length
  [manifest CheckpointManifest
   id Int] Int?
  (let [atoms Int (checkpointmanifest-atom-count manifest)
        triples Int (checkpointmanifest-triple-count manifest)
        transactions Int (checkpointmanifest-transaction-count manifest)
        operations Int (checkpointmanifest-operation-count manifest)
        active Int (checkpointmanifest-active-count manifest)
        runs Int (checkpointmanifest-active-run-count manifest)]
    (cond
      [(= id atom-offsets-section) (* 8 (+ atoms 1))]
      [(= id atom-payload-section) nil]
      [(= id atom-lookup-section) (* 12 atoms)]
      [(or (= id triple-t1-section)
           (or (= id triple-t2-section) (= id triple-t3-section))) (* 4 triples)]
      [(or (= id transaction-sequence-section)
           (= id transaction-first-operation-section)) (* 8 transactions)]
      [(= id transaction-operation-count-section) (* 4 transactions)]
      [(= id operation-sequence-section) (* 8 operations)]
      [(= id operation-ordinal-section) (* 4 operations)]
      [(= id operation-action-section) operations]
      [(= id operation-triple-section) (* 4 operations)]
      [(= id withdrawal-target-section) (* 8 operations)]
      [(= id active-handle-section) (* 4 active)]
      [(= id active-offset-section) (* 8 active)]
      [(= id active-count-section) (* 4 active)]
      [(= id active-run-section) (* 8 runs)]
      [(or (= id spo-section) (or (= id pos-section) (= id osp-section)))
       (* 16 triples)]
      [:else nil])))

(defn- validate-section-lengths!
  [table Any
   manifest CheckpointManifest] Nil
  (loop [id Int 1]
    (if (> id section-count)
      nil
      (let [expected Int? (expected-section-length manifest id)
            entry Any (get table id)
            actual Int (nth entry 1)]
        (if (and (some? expected) (not (= expected actual)))
          (fail! :invalid-packed-checkpoint
                 "packed Store column length is inconsistent")
          (recur (+ id 1)))))))

(defn- validate-source!
  [manifest CheckpointManifest
   source CheckpointSource] Nil
  (cond
    [(not (= (checkpointmanifest-space-id manifest)
             (checkpointsource-space-id source)))
     (fail! :packed-space-mismatch
            "packed Store checkpoint belongs to another SpaceId")]
    [(not (= (checkpointmanifest-revision manifest)
             (checkpointsource-revision source)))
     (fail! :packed-source-mismatch
            "packed Store checkpoint revision does not match STORELOG")]
    [(not (= (checkpointmanifest-schema manifest)
             (checkpointsource-schema source)))
     (fail! :packed-schema-mismatch
            "packed Store checkpoint schema does not match")]
    [(not (and (= (checkpointmanifest-log-valid-bytes manifest)
                  (checkpointsource-log-valid-bytes source))
               (= (checkpointmanifest-log-prefix-sha256 manifest)
                  (checkpointsource-log-prefix-sha256 source))))
     (fail! :packed-source-mismatch
            "packed Store checkpoint does not match the exact STORELOG prefix")]
    [:else nil]))

(defn open-checkpoint!
  [manifest-path String
   source CheckpointSource] PackedPrefix
  (let [manifest CheckpointManifest (read-manifest! manifest-path)]
    (validate-source! manifest source)
    (let [directory Any (.getParentFile (File. manifest-path))
          component String (checkpointmanifest-component manifest)
          page-file String (str directory "/" component)]
      (if (not (.isFile (File. page-file)))
        (fail! :packed-component-missing
               "packed Store manifest component is missing")
        nil)
      (if (not (= (checkpointmanifest-page-sha256 manifest)
                  (sha256-file page-file)))
        (fail! :invalid-packed-checkpoint
               "packed Store page checksum does not match its manifest")
        nil)
      (let [table Any (read-page-table! page-file manifest)]
        (validate-section-lengths! table manifest)
        (let [buffers Any (into {}
                    (map (fn [id Int] Any
                           (let [entry Any (get table id)]
                             [id (map-section page-file (nth entry 0)
                                              (nth entry 1))]))
                         (range 1 (+ section-count 1))))]
          (->PackedPrefix manifest buffers))))))

(defn close-checkpoint! [prefix PackedPrefix] Nil nil)
(defn space-id [prefix PackedPrefix] String
  (checkpointmanifest-space-id (packedprefix-manifest prefix)))
(defn revision [prefix PackedPrefix] Int
  (checkpointmanifest-revision (packedprefix-manifest prefix)))
(defn next-sequence [prefix PackedPrefix] Int
  (checkpointmanifest-next-sequence (packedprefix-manifest prefix)))
(defn atom-count [prefix PackedPrefix] Int
  (checkpointmanifest-atom-count (packedprefix-manifest prefix)))
(defn triple-count [prefix PackedPrefix] Int
  (checkpointmanifest-triple-count (packedprefix-manifest prefix)))
(defn transaction-count [prefix PackedPrefix] Int
  (checkpointmanifest-transaction-count (packedprefix-manifest prefix)))
(defn operation-count [prefix PackedPrefix] Int
  (checkpointmanifest-operation-count (packedprefix-manifest prefix)))
(defn mapped-bytes [prefix PackedPrefix] Int
  (checkpointmanifest-mapped-bytes (packedprefix-manifest prefix)))
(defn manifest-path [prefix PackedPrefix] String
  (checkpointmanifest-path (packedprefix-manifest prefix)))

(defn atom-row-at!
  [prefix PackedPrefix
   position Int] t/AtomRow
  (if (or (< position 0) (>= position (atom-count prefix)))
    (fail! :invalid-packed-position "packed Store atom position is outside the prefix")
    (let [start Int (section-long prefix atom-offsets-section position)
          end Int (section-long prefix atom-offsets-section (+ position 1))
          payload ByteBuffer (buffer prefix atom-payload-section)]
      (if (not (and (>= start 0) (and (>= end start) (<= end (.limit payload)))))
        (fail! :invalid-packed-checkpoint
               "packed Store atom offsets are invalid")
        (let [view ByteBuffer (.duplicate payload)]
          (.position view (int start))
          (.limit view (int end))
          (let [slice ByteBuffer (.slice view)
                decoded t/TermCodecDecoded (rpc/decode-term-codec-v1! slice max-term-bytes max-term-nodes
                                           max-term-depth)
                value Any (t/termcodecdecoded-value decoded)]
            (if (or (not (= 0 (.remaining slice))) (t/triple? value))
              (fail! :invalid-packed-checkpoint
                     "packed Store atom payload is invalid")
              (atom-row! value))))))))

(defn triple-row-at!
  [prefix PackedPrefix
   position Int] t/TripleRow
  (if (or (< position 0) (>= position (triple-count prefix)))
    (fail! :invalid-packed-position "packed Store triple position is outside the prefix")
    (t/->TripleRow
     (section-int prefix triple-t1-section position)
     (section-int prefix triple-t2-section position)
     (section-int prefix triple-t3-section position))))

(defn transaction-row-at!
  [prefix PackedPrefix
   position Int] t/TransactionRow
  (if (or (< position 0) (>= position (transaction-count prefix)))
    (fail! :invalid-packed-position
           "packed Store transaction position is outside the prefix")
    (t/->TransactionRow
     (section-long prefix transaction-sequence-section position)
     (section-long prefix transaction-first-operation-section position)
     (section-int prefix transaction-operation-count-section position))))

(defn operation-row-at!
  [prefix PackedPrefix
   position Int] t/OperationRow
  (if (or (< position 0) (>= position (operation-count prefix)))
    (fail! :invalid-packed-position
           "packed Store operation position is outside the prefix")
    (t/->OperationRow
     (section-long prefix operation-sequence-section position)
     (section-int prefix operation-ordinal-section position)
     (code-action! (section-byte prefix operation-action-section position))
     (section-int prefix operation-triple-section position))))

(defn withdrawal-target-at!
  [prefix PackedPrefix
   position Int] Int
  (if (or (< position 0) (>= position (operation-count prefix)))
    (fail! :invalid-packed-position
           "packed Store withdrawal position is outside the prefix")
    (section-long prefix withdrawal-target-section position)))

(defn- compare-three
  [a1 Int
   a2 Int
   a3 Int
   b1 Int
   b2 Int
   b3 Int] Int
  (cond
    [(< a1 b1) -1]
    [(> a1 b1) 1]
    [(< a2 b2) -1]
    [(> a2 b2) 1]
    [(< a3 b3) -1]
    [(> a3 b3) 1]
    [:else 0]))

(defn find-triple-position
  [prefix PackedPrefix
   t1 Int
   t2 Int
   t3 Int] Int
  (let [index ByteBuffer (buffer prefix spo-section)
        total Int (triple-count prefix)]
    (loop [low Int 0
           high Int (- total 1)]
      (if (> low high)
        -1
        (let [middle Int (quot (+ low high) 2)
              base Int (* middle 16)
              comparison Int (compare-three (.getInt index base)
                             (.getInt index (+ base 4))
                             (.getInt index (+ base 8))
                             t1 t2 t3)]
          (cond
            [(= comparison 0) (.getInt index (+ base 12))]
            [(< comparison 0) (recur (+ middle 1) high)]
            [:else (recur low (- middle 1))]))))))

(defn- compare-index-prefix
  [index ByteBuffer
   position Int
   prefix (Vec Int)] Int
  (let [base Int (* position 16)]
    (loop [offset Int 0]
      (if (>= offset (count prefix))
        0
        (let [actual Int (.getInt index (+ base (* offset 4)))
              wanted Int (nth prefix offset)]
          (cond
            [(< actual wanted) -1]
            [(> actual wanted) 1]
            [:else (recur (+ offset 1))]))))))

(defn- index-prefix-positions
  [prefix-store PackedPrefix
   index-id Int
   wanted (Vec Int)] (Vec Int)
  (let [index ByteBuffer (buffer prefix-store index-id)
        total Int (triple-count prefix-store)
        first-position Int (loop [low Int 0
                                  high Int total]
                             (if (>= low high)
            low
            (let [middle Int (quot (+ low high) 2)]
              (if (< (compare-index-prefix index middle wanted) 0)
                (recur (+ middle 1) high)
                (recur low middle)))))]
    (loop [position Int first-position
           matches (Vec Int) []]
      (if (or (>= position total)
              (not (= 0 (compare-index-prefix index position wanted))))
        matches
        (recur (+ position 1)
               (conj matches (.getInt index (+ (* position 16) 12))))))))

(defn matching-triple-positions
  [prefix PackedPrefix
   t1 Int?
   t2 Int?
   t3 Int?] (Vec Int)
  (cond
    [(and (some? t1) (and (some? t2) (some? t3)))
     (index-prefix-positions prefix spo-section [t1 t2 t3])]
    [(and (some? t1) (some? t2))
     (index-prefix-positions prefix spo-section [t1 t2])]
    [(and (some? t2) (some? t3))
     (index-prefix-positions prefix pos-section [t2 t3])]
    [(and (some? t3) (some? t1))
     (index-prefix-positions prefix osp-section [t3 t1])]
    [(some? t1) (index-prefix-positions prefix spo-section [t1])]
    [(some? t2) (index-prefix-positions prefix pos-section [t2])]
    [(some? t3) (index-prefix-positions prefix osp-section [t3])]
    [:else []]))

(defn- bytes-equal-range?
  [payload ByteBuffer
   start Int
   end Int
   bytes Any] Bool
  (if (not (= (- end start) (alength bytes)))
    false
    (loop [position Int 0]
      (if (>= position (alength bytes))
        true
        (if (= (bit-and 255 (int (.get payload (+ start position))))
               (bit-and 255 (int (aget bytes position))))
          (recur (+ position 1))
          false)))))

(defn find-atom-position
  [prefix PackedPrefix
   value Any] Int
  (let [bytes Any (encode-term value)
        wanted Int (hash64 bytes)
        index ByteBuffer (buffer prefix atom-lookup-section)
        total Int (atom-count prefix)
        first-hit Int (loop [low Int 0
                             high Int (- total 1)
                             found Int -1]
                        (if (> low high)
            found
            (let [middle Int (quot (+ low high) 2)
                  current Int (.getLong index (* middle 12))]
              (cond
                [(< current wanted) (recur (+ middle 1) high found)]
                [(> current wanted) (recur low (- middle 1) found)]
                [:else (recur low (- middle 1) middle)]))))
        payload ByteBuffer (buffer prefix atom-payload-section)]
    (if (< first-hit 0)
      -1
      (loop [lookup-position Int first-hit]
        (if (>= lookup-position total)
          -1
          (let [base Int (* lookup-position 12)
                current Int (.getLong index base)]
            (if (not (= current wanted))
              -1
              (let [position Int (.getInt index (+ base 8))
                    start Int (section-long prefix atom-offsets-section position)
                    end Int (section-long prefix atom-offsets-section (+ position 1))]
                (if (bytes-equal-range? payload start end bytes)
                  position
                  (recur (+ lookup-position 1)))))))))))

(defn- active-entry
  [prefix PackedPrefix
   handle Int] Int
  (let [total Int (checkpointmanifest-active-count
                   (packedprefix-manifest prefix))]
    (loop [low Int 0
           high Int (- total 1)]
      (if (> low high)
        -1
        (let [middle Int (quot (+ low high) 2)
              current Int (section-int prefix active-handle-section middle)]
          (cond
            [(= current handle) middle]
            [(< current handle) (recur (+ middle 1) high)]
            [:else (recur low (- middle 1))]))))))

(defn active-handle-count [prefix PackedPrefix] Int
  (checkpointmanifest-active-count (packedprefix-manifest prefix)))

(defn active-handle-at!
  [prefix PackedPrefix
   position Int] Int
  (if (and (>= position 0) (< position (active-handle-count prefix)))
    (section-int prefix active-handle-section position)
    (fail! :invalid-packed-position
           "packed Store active handle position is out of range")))

(defn active-position-count
  [prefix PackedPrefix
   handle Int] Int
  (let [entry Int (active-entry prefix handle)]
    (if (< entry 0)
      0
      (section-int prefix active-count-section entry))))

(defn active-position-at!
  [prefix PackedPrefix
   handle Int
   position Int] Int
  (let [entry Int (active-entry prefix handle)
        count-value Int (if (< entry 0)
                          0
                          (section-int prefix active-count-section entry))]
    (if (and (>= position 0) (< position count-value))
      (let [offset Int (section-long prefix active-offset-section entry)]
        (section-long prefix active-run-section (+ offset position)))
      (fail! :invalid-packed-position
             "packed Store active operation position is out of range"))))

(defn active-prefix-operation?
  [prefix PackedPrefix
   handle Int
   count-limit Int
   operation-position Int] Bool
  (let [entry Int (active-entry prefix handle)]
    (if (< entry 0)
      false
      (let [offset Int (section-long prefix active-offset-section entry)
            stored-count Int (section-int prefix active-count-section entry)
            count-value Int (min stored-count count-limit)]
        (loop [low Int 0
               high Int (- count-value 1)]
          (if (> low high)
            false
            (let [middle Int (quot (+ low high) 2)
                  current Int (section-long prefix active-run-section
                                            (+ offset middle))]
              (cond
                [(= current operation-position) true]
                [(< current operation-position) (recur (+ middle 1) high)]
                [:else (recur low (- middle 1))]))))))))

(defn active-positions
  [prefix PackedPrefix
   handle Int] (Vec Int)
  (let [entry Int (active-entry prefix handle)]
    (if (< entry 0)
      []
      (let [offset Int (section-long prefix active-offset-section entry)
            count-value Int (section-int prefix active-count-section entry)]
        (loop [position Int 0
               positions (Vec Int) []]
          (if (>= position count-value)
            positions
            (recur (+ position 1)
                   (conj positions
                         (section-long prefix active-run-section
                                       (+ offset position))))))))))

(defn operation-live?
  [prefix PackedPrefix
   handle Int
   operation-position Int] Bool
  (let [entry Int (active-entry prefix handle)]
    (if (< entry 0)
      false
      (let [offset Int (section-long prefix active-offset-section entry)
            count-value Int (section-int prefix active-count-section entry)]
        (loop [low Int 0
               high Int (- count-value 1)]
          (if (> low high)
            false
            (let [middle Int (quot (+ low high) 2)
                  current Int (section-long prefix active-run-section
                                            (+ offset middle))]
              (cond
                [(= current operation-position) true]
                [(< current operation-position) (recur (+ middle 1) high)]
                [:else (recur low (- middle 1))]))))))))
