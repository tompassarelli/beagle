;; Dependencies for Clojure development and validation tools. The shipped server
;; launcher executes only the native artifact. The CLI and MCP stay on Babashka;
;; Cheshire remains available to development checks that load the engine source.
{:paths ["out"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        cheshire/cheshire {:mvn/version "5.13.0"}}}
