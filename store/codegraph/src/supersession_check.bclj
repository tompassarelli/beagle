#lang beagle/clj

;; ============================================================================
;; Falsify "withdrawn (not deleted)": after a rename, show the OLD red
;; assertion and its LIVE crimson successor COEXISTING on the same node, old
;; marked not-live, and the live view excluding it. If this is real, withdrawal
;; relates an exact retraction occurrence to an exact assertion occurrence; if
;; not, "withdrawn" was a euphemism for overwrite.
;;
;; ============================================================================
(ns supersession-check)

(require store.store :as c)

(require store.types :as t)

(require clojure.edn :as edn)

(require clojure.string :as str)

(def space-id String "codegraph")

;; The fact stream's own ids are the store's node terms: the kernel accepts any
;; Atom, so a line becomes a proposition with nothing minted or remapped.
(defn line->operation [(line String)] Any
  (let [trip (edn/read-string line)]
    (c/assert-operation (t/triple (nth trip 0) (nth trip 1) (nth trip 2)))))

(defn propositions-of [(ctx Any) (node Any)] (Vec Any)
  (filterv (fn [(p Any)] Bool (= node (t/triple-t1 p)))
    (c/live-propositions ctx)))

(defn sym? [(ctx Any) (node Any)] Bool
  (pos? (count (filterv (fn [(p Any)] Bool
                          (and (= "kind" (t/triple-t2 p)) (= "symbol" (t/triple-t3 p))))
                 (propositions-of ctx node)))))

(defn first-sym-value-proposition [(ctx Any) (old-name String)] Any
  (let [hits (filterv (fn [(p Any)] Bool
                        (and (= "v" (t/triple-t2 p))
                          (and (= old-name (t/triple-t3 p)) (sym? ctx (t/triple-t1 p)))))
               (c/live-propositions ctx))]
    (if (empty? hits) nil (nth hits 0))))

;; An occurrence coordinate is ((space "tx-sequence" seq) "op-ordinal" ordinal);
;; render it as space/sequence#ordinal so a report line stays one line.
(defn occurrence-label [(occurrence Any)] String
  (let [transaction (t/triple-t1 occurrence)]
    (str (t/triple-t1 transaction) "/" (t/triple-t3 transaction) "#" (t/triple-t3 occurrence))))

(defn proposition-label [(proposition Any)] String
  (str "(" (t/triple-t1 proposition)
    " " (pr-str (t/triple-t2 proposition))
    " " (pr-str (t/triple-t3 proposition)) ")"))

(defn assertion-occurrence-of [(events (Vec Any)) (proposition Any)] Any
  (let [hits (filterv (fn [(e Any)] Bool
                        (and (t/assertion-occurrence? e)
                          (= proposition
                            (t/operationoccurrence-proposition e))))
               events)]
    (if (empty? hits)
      nil
      (t/operationoccurrence-coordinate (nth hits 0)))))

(defn withdrawal-of [(ctx Any) (occurrence Any)] Any
  (let [hits (filterv (fn [(w Any)] Bool
                        (= occurrence
                          (t/operationoccurrence-coordinate
                            (t/withdrawal-assertion w))))
               (c/withdrawals ctx))]
    (if (empty? hits) nil (nth hits 0))))

(defn live-occurrence? [(ctx Any) (occurrence Any)] Bool
  (pos? (count (filterv (fn [(e Any)] Bool
                          (= occurrence
                            (t/operationoccurrence-coordinate e)))
                 (c/live-occurrences ctx)))))

(defn -main [& args] Nil
  (let [(ctx Any) (c/new-term-store space-id)
        (lines (Vec String)) (str/split-lines (slurp "/tmp/trap.edn"))
        (operations (Vec Any)) (mapv (fn [(line String)] Any (line->operation line))
                                (filterv (fn [(line String)] Bool (str/starts-with? line "["))
                                  lines))
        (_load Any) (when (pos? (count operations))
                      (c/commit-boundary!
                       ctx operations
                       (c/commit-metadata "store.codegraph/supersession-load-v1"
                                          "store/CommitOperationV1"
                                          "codegraph-v1")))
        (old-proposition Any) (first-sym-value-proposition ctx "red")
        (node Any) (t/triple-t1 old-proposition)
        (new-proposition Any) (t/triple node "v" "crimson")
        (occurrences-before (Vec Any)) (c/occurrences ctx)
        (old-occurrence Any)
        (assertion-occurrence-of occurrences-before old-proposition)
        (_edit Any) (c/commit-boundary!
                     ctx
                     [(c/retract-operation old-proposition)
                      (c/assert-operation new-proposition)]
                     (c/commit-metadata "store.codegraph/supersession-v1"
                                        "store/CommitOperationV1"
                                        "codegraph-v1"))
        (occurrences (Vec Any)) (c/occurrences ctx)
        (new-occurrence Any) (assertion-occurrence-of occurrences new-proposition)
        (withdrawal Any) (withdrawal-of ctx old-occurrence)]
    (println "node (the symbol node):" node)
    (println)
    (println "OLD value-assertion  at="
      (occurrence-label old-occurrence)
      "  ->"
      (proposition-label old-proposition)
      "  value="
      (pr-str (t/triple-t3 old-proposition))
      "  LIVE?="
      (live-occurrence? ctx old-occurrence))
    (println "NEW value-assertion  at="
      (occurrence-label new-occurrence)
      "  ->"
      (proposition-label new-proposition)
      "  value="
      (pr-str (t/triple-t3 new-proposition))
      "  LIVE?="
      (live-occurrence? ctx new-occurrence))
    (println "WITHDRAWAL           at="
      (occurrence-label
        (t/operationoccurrence-coordinate
          (t/withdrawal-retraction withdrawal)))
      " withdraws="
      (occurrence-label
        (t/operationoccurrence-coordinate
          (t/withdrawal-assertion withdrawal)))
      "  (the retraction occurrence that withdraws the old assertion occurrence)")
    (println)
    (println "same node for old & new?   "
      (= (t/triple-t1 old-proposition) (t/triple-t1 new-proposition)))
    (println "old still retrievable (history preserved)? "
      (some? (assertion-occurrence-of occurrences old-proposition)))
    (println "live view of the node's v-propositions (live-propositions is live-only):"
      (mapv (fn [(p Any)] String (pr-str (t/triple-t3 p)))
        (filterv (fn [(p Any)] Bool (= "v" (t/triple-t2 p)))
          (propositions-of ctx node))))
    (println "=> old red assertion EXISTS, marked not-live; new crimson assertion is live; same node. Withdrawal is real:"
      (and (some? (assertion-occurrence-of occurrences old-proposition))
        (not (live-occurrence? ctx old-occurrence))
        (live-occurrence? ctx new-occurrence)
        (= (t/triple-t1 old-proposition) (t/triple-t1 new-proposition))))))
