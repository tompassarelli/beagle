#lang beagle/clj

;; ============================================================================
;; Turtle #4 — graph-native authoring: a SCOPE-CORRECT rename as a graph edit.
;; ============================================================================
;; Loads two modules' reader-facts into ONE Beagle Store store, then renames a symbol
;; in ONE module by RETRACTING its `v` propositions and asserting the renamed
;; ones (occurrence-native: nothing is overwritten — the old assertions stay in
;; the store's history, marked not-live, linked to the retraction that withdrew
;; them, fully recoverable). The other module's identically-named symbol is
;; untouched. Re-projects each file's (mutated) source. A text `sed` rename
;; would corrupt both files; the graph edit is correct by construction because
;; scope is structural, not lexical.
;;
;;   bb -cp ~/code/store/out -m rename <old> <new> <target-substr> <edn>...
;; ============================================================================
(ns rename)

(require store.store :as c)

(require store.types :as t)

(require clojure.edn :as edn)

(require clojure.string :as str)

(def space-id String "codegraph")

(def value-pred String "v")

(def kind-pred String "kind")

(def symbol-kind String "symbol")

(def binding-heads (Set Any)
  #{"defn" "definline" "def-" "defonce" "defn-" "def"})

;; Node terms are the fact stream's own ids shifted by a per-file offset: the
;; kernel accepts any Atom, so nothing is minted, and the shift keeps two files'
;; ids apart in one store. Emitted ids start at 1, so 0 stays free as
;; field-child/sym-val's "no such child" even at offset 0.
(defn seen-node [(state (Map Keyword Any)) (node Int)] (Map Keyword Any)
  (if (contains? (get state :seen) node)
    state
    (assoc state
      :seen (conj (get state :seen) node)
      :nodes (conj (vec (get state :nodes)) node))))

(defn load-lines [(offset Int) (lines (Vec String))] (Map Keyword Any)
  (reduce (fn [(state (Map Keyword Any)) (line String)] (Map Keyword Any)
            (if (str/starts-with? line "[")
              (let [trip (edn/read-string line)
                    l (+ offset (int (nth trip 0)))
                    p (nth trip 1)
                    o (nth trip 2)
                    node-ref? (integer? o)
                    r (if node-ref? (+ offset (int o)) o)
                    with-l (seen-node state l)
                    with-r (if node-ref? (seen-node with-l r) with-l)]
                (assoc with-r
                  :operations (conj (vec (get with-r :operations))
                                (c/assert-operation (t/triple l p r)))
                  :top (max (int (get with-r :top)) l (if node-ref? (int r) 0))))
              state))
    {:seen #{} :nodes [] :operations [] :top 0}
    lines))

(defn load-edn!
  [(ctx Any)
   (file->nodes (Atom (Map Any Any)))
   (next-offset (Atom Int))
   (path String)]
  String
  (let [(lines (Vec String)) (str/split-lines (slurp path))
        (heads (Vec String)) (filterv (fn [(l String)] Bool (str/starts-with? l "@file")) lines)
        (src String) (subs (nth heads 0) 6)
        (loaded (Map Keyword Any)) (load-lines (deref next-offset) lines)]
    (swap! file->nodes assoc src (vec (get loaded :nodes)))
    (reset! next-offset (inc (int (get loaded :top))))
    (when (pos? (count (vec (get loaded :operations))))
      (c/commit-boundary!
       ctx
       (vec (get loaded :operations))
       (c/commit-metadata "store.codegraph/rename-load-v1"
                          "store/CommitOperationV1"
                          "codegraph-v1")))
    src))

;; A snapshot of the live view, keyed by subject; every read below goes through
;; one. A commit invalidates it, so the caller rebuilds after editing.
(defn live-index [(ctx Any)] (Map Any Any)
  (group-by (fn [(p Any)] Any (t/triple-t1 p)) (c/live-propositions ctx)))

(defn propositions-of [(index (Map Any Any)) (node Any)] (Vec Any)
  (vec (get index node [])))

(defn symbol-leaf? [(index (Map Any Any)) (node Any)] Bool
  (pos? (count (filterv (fn [(p Any)] Bool
                          (and (= kind-pred (t/triple-t2 p)) (= symbol-kind (t/triple-t3 p))))
                 (propositions-of index node)))))

(defn field-child [(index (Map Any Any)) (node Any) (fname String)] Int
  (let [hits (filterv (fn [(p Any)] Bool (= fname (t/triple-t2 p)))
               (propositions-of index node))]
    (if (empty? hits)
      0
      (let [child (t/triple-t3 (nth hits 0))]
        (if (integer? child) (int child) 0)))))

(defn sym-val [(index (Map Any Any)) (node Any)] Any
  (if (and (> (int node) 0) (symbol-leaf? index node))
    (let [hits (filterv (fn [(p Any)] Bool (= value-pred (t/triple-t2 p)))
                 (propositions-of index node))]
      (if (empty? hits) nil (t/triple-t3 (nth hits 0))))
    nil))

(defn binding-name [(index (Map Any Any)) (node Any)] Any
  (let [h (sym-val index (field-child index node "f0"))]
    (if (and (not (nil? h)) (contains? binding-heads h))
      (sym-val index (field-child index node "f1"))
      nil)))

(defn module-bindings
  [(index (Map Any Any))
   (file->nodes (Atom (Map Any Any)))
   (src String)]
  (Set Any)
  (set (filterv (fn [(nm Any)] Bool (not (nil? nm)))
         (mapv (fn [(node Any)] Any (binding-name index node))
           (vec (get (deref file->nodes) src []))))))

;; The rename is a retraction plus an assertion in one transaction: the kernel
;; records the withdrawal link itself, so no "supersedes" predicate is asserted.
(defn rename-operations
  [(index (Map Any Any))
   (new-name String)
   (target-nodes (Set Any))
   (propositions (Vec Any))]
  (Vec Any)
  (vec (mapcat (fn [(p Any)] (Vec Any)
                 (let [node (t/triple-t1 p)]
                   (if (and (contains? target-nodes node) (symbol-leaf? index node))
                     [(c/retract-operation p)
                      (c/assert-operation (t/triple node (t/triple-t2 p) new-name))]
                     [])))
         propositions)))

(defn project-line [(proposition Any)] String
  (let [node (t/triple-t1 proposition)
        p (t/triple-t2 proposition)
        r (t/triple-t3 proposition)]
    (if (integer? r)
      (str "[" node " " (pr-str p) " " r "]\n")
      (str "[" node " " (pr-str p) " " (pr-str r) "]\n"))))

(defn project-file!
  [(index (Map Any Any))
   (file->nodes (Atom (Map Any Any)))
   (src String)
   (out-path String)]
  Nil
  (spit out-path
    (str (str "@file " src "\n")
      (str/join ""
        (mapv (fn [(node Any)] String
                (str/join "" (mapv (fn [(p Any)] String (project-line p))
                               (propositions-of index node))))
          (vec (get (deref file->nodes) src []))))))
  nil)

(defn out-path [(src String)] String
  (let [parts (str/split src (re-pattern "/"))]
    (str "/tmp/mutated-" (nth parts (dec (count parts))) ".edn")))

(defn -main [& args] Nil
  (let [(argv (Vec Any)) (vec args)
        (old-name String) (str (nth argv 0))
        (new-name String) (str (nth argv 1))
        (target-substr String) (str (nth argv 2))
        (edn-files (Vec Any)) (vec (drop 3 argv))
        (ctx Any) (c/new-term-store space-id)
        (file->nodes (Atom (Map Any Any))) (atom {})
        (next-offset (Atom Int)) (atom 0)
        (srcs (Vec String)) (mapv (fn [(p Any)] String
                                   (load-edn! ctx file->nodes next-offset (str p)))
                             edn-files)
        (index (Map Any Any)) (live-index ctx)
        (target-modules (Vec String)) (filterv (fn [(s String)] Bool
                                                (str/includes? s target-substr))
                                       srcs)
        (target-nodes (Set Any)) (set (vec (mapcat (fn [(s String)] (Vec Any)
                                                    (vec (get (deref file->nodes) s [])))
                                            target-modules)))
        (collisions (Vec String)) (filterv (fn [(m String)] Bool
                                            (contains? (module-bindings index file->nodes m)
                                              new-name))
                                   target-modules)]
    (when (pos? (count collisions))
      (let [m (nth collisions 0)]
        (binding [*out* *err*]
          (println (str "REJECTED — `" new-name "` is already a binding in " m ".\n" "  A rename onto an existing binding would shadow/collide; the store refuses the write.\n" "  (Turtle #5 invariant: rename-doesn't-collide. No propositions were mutated.)")))
        (System/exit 3)))
    (let [targets (filterv (fn [(p Any)] Bool
                             (and (= value-pred (t/triple-t2 p)) (= old-name (t/triple-t3 p))))
                    (c/live-propositions ctx))
          operations (rename-operations index new-name target-nodes targets)
          renamed (quot (count operations) 2)
          preserved (count (filterv (fn [(p Any)] Bool
                                      (let [node (t/triple-t1 p)]
                                        (and (not (contains? target-nodes node))
                                          (symbol-leaf? index node))))
                             targets))
          _edit (when (pos? (count operations))
                  (c/commit-boundary!
                   ctx operations
                   (c/commit-metadata "store.codegraph/rename-v1"
                                      "store/CommitOperationV1"
                                      "codegraph-v1")))
          projected (live-index ctx)
          outs (mapv (fn [(s String)] String (out-path s)) srcs)]
      (doseq [i (range (count srcs))]
        (project-file! projected file->nodes (nth srcs i) (nth outs i)))
      (binding [*out* *err*]
        (println "================ TURTLE #4 — graph-native rename ================")
        (println (str "edit: rename symbol `" old-name "` -> `" new-name "` in files matching \"" target-substr "\""))
        (println (str "renamed (target file): " renamed " symbol occurrences"))
        (println (str "preserved (other files, same name, untouched): " preserved " occurrences"))
        (println (str "withdrawn assertions (recoverable, nothing deleted): " renamed))
        (println (str "live propositions in store: " (count (c/live-propositions ctx))))
        (doseq [i (range (count srcs))]
          (println (str "projected -> " (nth outs i) "   <- " (nth srcs i))))))))
