# The seam an external wasm embedder faces, pinned exactly. bin/beagle-store-native-build
# compares every --host wasm-embed link against these lines and dies on any
# difference; --regen-wasm-seams rewrites them and keeps these comments. A new
# line is a new capability demand on every embedder and needs a reason here.
#
# store_host_v1 — the nine host hooks, one per store.h store_host_v1 field.
#
# wasi_snapshot_preview1 — capabilities the Beagle shim reaches that have no
# store_host_v1 field of their own, plus wasi-libc residue:
#   clock_time_get      LIVE. native_host_clock_monotonic_nanoseconds_v0, on
#                       the query dispatch path; refusing it aborts the guest.
#   environ_sizes_get   LIVE. getenv via native_host_environment_lookup_v0;
#   environ_get         wasi-libc _Exit(71)s if the sizes call is refused, so
#                       an embedder answers with an empty environment.
#   fd_write fd_close fd_seek   wasi-libc stdio, linked from the shim's
#                       diagnostics and never reached.
#   proc_exit           abort/_Exit, never reached.
# tests/store_wasm_embed_smoke.sh measures all of this: over the full frame
# matrix the five never-reached imports record zero calls.
store-wasm-embed-seams/v1
export _initialize func
export store_abi_version func
export store_buffer_release func
export store_close func
export store_open func
export store_query func
export store_snapshot func
export store_transact func
export store_wasm_alloc func
export store_wasm_free func
export memory memory
import store_host_v1 allocate (i32 i32) -> (i32)
import store_host_v1 clock_milliseconds (i32 i32) -> (i32)
import store_host_v1 deallocate (i32 i32) -> ()
import store_host_v1 storage_append (i32 i32 i32) -> (i32)
import store_host_v1 storage_close (i32) -> (i32)
import store_host_v1 storage_read (i32 i64 i32 i32) -> (i32)
import store_host_v1 storage_size (i32 i32) -> (i32)
import store_host_v1 storage_sync (i32) -> (i32)
import store_host_v1 storage_truncate (i32 i64) -> (i32)
import wasi_snapshot_preview1 clock_time_get (i32 i64 i32) -> (i32)
import wasi_snapshot_preview1 environ_get (i32 i32) -> (i32)
import wasi_snapshot_preview1 environ_sizes_get (i32 i32) -> (i32)
import wasi_snapshot_preview1 fd_close (i32) -> (i32)
import wasi_snapshot_preview1 fd_seek (i32 i64 i32 i32) -> (i32)
import wasi_snapshot_preview1 fd_write (i32 i32 i32 i32) -> (i32)
import wasi_snapshot_preview1 proc_exit (i32) -> ()
